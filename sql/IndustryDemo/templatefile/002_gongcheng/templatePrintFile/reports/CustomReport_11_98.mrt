  "ReportUnit": "Centimeters",
  "PreviewSettings": 268435455,
  "Dictionary": {
    "Variables": {
      "0": {
        "Value": "Year(Today)",
        "Name": "niandu",
        "DialogInfo": {
          "DateTimeType": "DateAndTime",
          "ItemsInitializationType": "Columns",
          "KeysColumn": "nian.year",
          "ValuesColumn": "nian.year"
        },
        "Alias": "年份",
        "Type": "System.String",
        "RequestFromUser": true,
        "InitBy": "Expression"
      },
      "1": {
        "Name": "projectname",
        "DialogInfo": {
          "DateTimeType": "DateAndTime"
        },
        "Alias": "项目名称",
        "Type": "System.String",
        "RequestFromUser": true
      },
      "2": {
        "Name": "salesorder_no",
        "DialogInfo": {
          "DateTimeType": "DateAndTime"
        },
        "Alias": "合同编号",
        "Type": "System.String",
        "RequestFromUser": true
      },
      "3": {
        "Value": "1",
        "Name": "jishu",
        "DialogInfo": {
          "DateTimeType": "DateAndTime",
          "AllowUserValues": false,
          "Keys": {
            "0": "1",
            "1": "2"
          },
          "Values": {
            "0": "合同额",
            "1": "已收款"
          }
        },
        "Alias": "合同额/已收款切换",
        "Type": "System.Int32",
        "RequestFromUser": true
      }
    },
    "DataSources": {
      "0": {
        "Ident": "StiMySqlSource",
        "Name": "chengben",
        "Alias": "chengben",
        "Columns": {
          "0": {
            "Name": "jine",
            "Index": -1,
            "NameInSource": "jine",
            "Alias": "jine",
            "Type": "System.Decimal"
          },
          "1": {
            "Name": "type",
            "Index": -1,
            "NameInSource": "type",
            "Alias": "type",
            "Type": "System.String"
          }
        },
        "NameInSource": "连接",
        "SqlCommand": "SELECT * from (\r\nSELECT \r\nfeiyong.type,\r\nsum(ifnull(chengben,0)) as jine\r\nfrom ld_salesorder a \r\nLEFT JOIN ld_project b on a.salesorderid=b.salesorderid\r\nLEFT JOIN (SELECT a.projectid,\r\nsum(ifnull(c.rmb_total,0)) as chengben,\r\ncase when b.expensetype='税费' or b.expensetype='税费1' or b.expensetype='税费2' or b.expensetype='抵扣税费' or b.expensetype='抵扣税费2' then '税费'\r\n\t\t when b.expensetype='住宿费' or b.expensetype='餐饮' or b.expensetype='交通' then '差旅费'\r\n\t\t when b.expensetype='资料费' or b.expensetype='材料检测费' or b.expensetype='审计费' or b.expensetype='杂费' then '项目杂费'\r\n     when b.expensetype='管理费' or b.expensetype='管理费1' or b.expensetype='管理费2' then '管理费'\r\n     when b.expensetype='辅料费' or b.expensetype='保温材料' or b.expensetype='工具费' then '辅料费'\r\n     when b.expensetype='吊篮台班费' or b.expensetype='吊篮检测费'  or b.expensetype='脚手架费' then '机械设备费'\r\n\t\t when b.expensetype='材料费' then '材料费'\r\n     when b.expensetype='人工费' then '人工费'    \r\n     when b.expensetype='总包配合费' then '总包配合费'\r\n     when b.expensetype='现场配合费' then '现场配合费'\r\n     when b.expensetype='运费' then '运费'\r\n     when b.expensetype='通讯' or b.expensetype='礼品' or b.expensetype='办公' or b.expensetype='活动' or b.expensetype='其他' \r\nor b.expensetype='进场费' or b.expensetype='业务费'  or b.expensetype='工资' then '其他' end as type \r\nfrom ld_expense a\r\nLEFT JOIN ld_expensedetail b on a.expenseid=b.expenseid\r\nLEFT JOIN ld_expensedetailscf c on b.expensedetailid=c.expensedetailid\r\nLEFT JOIN ld_project d on a.projectid = d.projectid\r\n\r\nwhere  a.approvestatus = '已批准' \r\nGROUP BY a.projectid, type) feiyong on feiyong.projectid=b.projectid\r\n\r\nwhere a.deleted=0 and b.deleted=0\r\nand case when '{niandu}'='全部' then 1=1 else left(salesorder_no,4)  = '{niandu}' end\r\nand b.projectname like '%{projectname}%'\r\nand a.salesorder_no like '%{salesorder_no}%'\r\nand ifnull(feiyong.type,'')<>''\r\nGROUP BY feiyong.type\r\n\r\nunion all \r\n\r\nSELECT \r\n'利润',\r\nsum(case when '{jishu}'=1 then a.total else a.received_amount end - ifnull(totalchengben,0)) as lirun\r\n\r\nfrom ld_salesorder a \r\nLEFT JOIN ld_project b on a.salesorderid=b.salesorderid\r\nLEFT JOIN (SELECT a.projectid,\r\nsum(c.rmb_total) as totalchengben\r\nfrom ld_expense a\r\nLEFT JOIN ld_expensedetail b on a.expenseid=b.expenseid\r\nLEFT JOIN ld_expensedetailscf c on b.expensedetailid=c.expensedetailid\r\nLEFT JOIN ld_project d on a.projectid = d.projectid\r\n\r\nwhere  a.approvestatus = '已批准' \r\nGROUP BY a.projectid ) feiyong on feiyong.projectid=b.projectid\r\n\r\nwhere a.deleted=0 and b.deleted=0\r\nand case when '{niandu}'='全部' then 1=1 else left(salesorder_no,4)  = '{niandu}' end\r\nand b.projectname like '%{projectname}%'\r\nand a.salesorder_no like '%{salesorder_no}%'\r\n) a ORDER BY jine desc\r\n\r\n\r\n"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "nian",
        "Alias": "nian",
        "Columns": {
          "0": {
            "Name": "year",
            "Index": -1,
            "NameInSource": "year",
            "Alias": "year",
            "Type": "System.Object"
          }
        },
        "NameInSource": "连接",
        "SqlCommand": "SELECT '全部' as year\r\n\r\nUNION ALL\r\n\r\nSELECT DISTINCT left(salesorder_no,4)   from ld_salesorder where deleted=0 ORDER BY year desc\r\n\r\n"
      }
    },
