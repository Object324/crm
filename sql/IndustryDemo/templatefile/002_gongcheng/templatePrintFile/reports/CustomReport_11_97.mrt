    "DataSources": {
      "0": {
        "Ident": "StiMySqlSource",
        "Name": "chengben",
        "Alias": "chengben",
        "Columns": {
          "0": {
            "Name": "banzu",
            "Index": -1,
            "NameInSource": "banzu",
            "Alias": "banzu",
            "Type": "System.String"
          },
          "1": {
            "Name": "projectid",
            "Index": -1,
            "NameInSource": "projectid",
            "Alias": "projectid",
            "Type": "System.Int32"
          },
          "2": {
            "Name": "projectname",
            "Index": -1,
            "NameInSource": "projectname",
            "Alias": "projectname",
            "Type": "System.String"
          },
          "3": {
            "Name": "rengongfei",
            "Index": -1,
            "NameInSource": "rengongfei",
            "Alias": "rengongfei",
            "Type": "System.Decimal"
          },
          "4": {
            "Name": "rengongjuesuan",
            "Index": -1,
            "NameInSource": "rengongjuesuan",
            "Alias": "rengongjuesuan",
            "Type": "System.Decimal"
          },
          "5": {
            "Name": "salesorder_no",
            "Index": -1,
            "NameInSource": "salesorder_no",
            "Alias": "salesorder_no",
            "Type": "System.String"
          },
          "6": {
            "Name": "salesorderid",
            "Index": -1,
            "NameInSource": "salesorderid",
            "Alias": "salesorderid",
            "Type": "System.Int32"
          },
          "7": {
            "Name": "yinfu",
            "Index": -1,
            "NameInSource": "yinfu",
            "Alias": "yinfu",
            "Type": "System.Decimal"
          },
          "8": {
            "Name": "yizhifu",
            "Index": -1,
            "NameInSource": "yizhifu",
            "Alias": "yizhifu",
            "Type": "System.Decimal"
          }
        },
        "NameInSource": "连接",
        "Type": "Table",
        "SqlCommand": "SELECT a.salesorderid,\r\na.salesorder_no,\r\nb.projectname,\r\nb.projectid,\r\nifnull(rengongfei,0) as rengongfei,\r\nifnull(rengongjuesuan,0) as rengongjuesuan,\r\ncf_2615 as banzu,\r\nifnull(yizhifu,0) as yizhifu,\r\ncase when rengongjuesuan is null and (ifnull(rengongfei,0)>ifnull(yizhifu,0) ) then ifnull(rengongfei,0) -ifnull(yizhifu,0)\r\nwhen   rengongjuesuan is not null and (ifnull(rengongjuesuan,0) >ifnull(yizhifu,0) ) then ifnull(rengongjuesuan,0) -ifnull(yizhifu,0)\r\nelse 0 end as yinfu \r\n\r\n\r\nfrom ld_salesorder a \r\nLEFT JOIN ld_project b on a.salesorderid=b.salesorderid\r\n\r\nLEFT JOIN(SELECT a.projectid, a.customform01_id, sum(c.sf154) as rengongfei from ld_customform24 a \r\nLEFT JOIN ld_customform24detail b on a.customform24id=b.id\r\nLEFT JOIN ld_customform24detailscf c on b.lineitem_id=c.lineitem_id\r\nwhere a.deleted=0\r\nGROUP BY a.projectid, a.customform01_id) banzurengongfei on banzurengongfei.projectid=b.projectid\r\n\r\nLEFT JOIN(SELECT a.projectid,entitytypeid, sum(c.sf143) as rengongjuesuan from ld_customform25 a\r\nLEFT JOIN ld_customform25detail b on a.customform25id=b.id\r\nLEFT JOIN ld_customform25detailscf c on b.lineitem_id=c.lineitem_id\r\nwhere a.deleted=0\r\nGROUP BY a.projectid,entitytypeid) as rengongjue on rengongjue.projectid=b.projectid and banzurengongfei.customform01_id=rengongjue.entitytypeid\r\n\r\nLEFT JOIN ld_customform01scf e on banzurengongfei.customform01_id=e.customform01id\r\n\r\nLEFT JOIN (SELECT a.projectid,\r\nsum(c.rmb_total) as yizhifu,\r\nb.description\r\nfrom ld_expense a\r\nLEFT JOIN ld_expensedetail b on a.expenseid=b.expenseid\r\nLEFT JOIN ld_expensedetailscf c on b.expensedetailid=c.expensedetailid\r\nLEFT JOIN ld_project d on a.projectid = d.projectid\r\n\r\nwhere  a.approvestatus = '已批准'\r\nGROUP BY a.projectid, b.description) feiyong on feiyong.projectid=b.projectid and feiyong.description=e.cf_2615\r\n\r\nwhere a.deleted=0 and b.deleted=0\r\nand case when '{niandu}'='全部' then 1=1 else left(salesorder_no,4)  = '{niandu}' end\r\nand b.projectname like '%{projectname}%'\r\nand a.salesorder_no like '%{salesorder_no}%'\r\n"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "nian",
        "Alias": "nian",
        "Columns": {
          "0": {
            "Name": "year",
            "Index": -1,
            "NameInSource": "year",
            "Alias": "year",
            "Type": "System.Object"
          }
        },
        "NameInSource": "连接",
        "SqlCommand": "SELECT '全部' as year\r\n\r\nUNION ALL\r\n\r\nSELECT DISTINCT left(salesorder_no,4)   from ld_salesorder where deleted=0 ORDER BY year desc\r\n\r\n"
      }
    },
