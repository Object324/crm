        "DialogInfo": {
          "DateTimeType": "DateAndTime"
        },
        "Alias": "项目名称",
        "Type": "System.String",
        "RequestFromUser": true
      },
      "2": {
        "Name": "salesorder_no",
        "DialogInfo": {
          "DateTimeType": "DateAndTime"
        },
        "Alias": "合同编号",
        "Type": "System.String",
        "RequestFromUser": true
      },
      "3": {
        "Name": "loudong",
        "DialogInfo": {
          "DateTimeType": "DateAndTime"
        },
        "Alias": "楼栋号",
        "Type": "System.String",
        "RequestFromUser": true
      }
    },
    "DataSources": {
      "0": {
        "Ident": "StiMySqlSource",
        "Name": "churuku",
        "Alias": "churuku",
        "Columns": {
          "0": {
            "Name": "gongchengliang",
            "Index": -1,
            "NameInSource": "gongchengliang",
            "Alias": "gongchengliang",
            "Type": "System.Decimal"
          },
          "1": {
            "Name": "loudong",
            "Index": -1,
            "NameInSource": "loudong",
            "Alias": "loudong",
            "Type": "System.String"
          },
          "2": {
            "Name": "projectid",
            "Index": -1,
            "NameInSource": "projectid",
            "Alias": "projectid",
            "Type": "System.Int32"
          },
          "3": {
            "Name": "projectname",
            "Index": -1,
            "NameInSource": "projectname",
            "Alias": "projectname",
            "Type": "System.String"
          },
          "4": {
            "Name": "salesorder_no",
            "Index": -1,
            "NameInSource": "salesorder_no",
            "Alias": "salesorder_no",
            "Type": "System.String"
          },
          "5": {
            "Name": "salesorderid",
            "Index": -1,
            "NameInSource": "salesorderid",
            "Alias": "salesorderid",
            "Type": "System.Int32"
          }
        },
        "NameInSource": "连接",
        "Type": "Table",
        "SqlCommand": "SELECT a.salesorderid,\r\na.salesorder_no,\r\nb.projectname,\r\nb.projectid,\r\nsum(ifnull(sf140,0)) as gongchengliang,\r\nifnull(e.sf139,'') as loudong\r\n\r\nfrom ld_salesorder a \r\nLEFT JOIN ld_project b on a.salesorderid=b.salesorderid\r\nLEFT JOIN ld_customform24 c on b.projectid = c.projectid\r\nLEFT JOIN ld_customform24detail d on c.customform24id=d.id\r\nLEFT JOIN ld_customform24detailscf e on d.lineitem_id=e.lineitem_id\r\n\r\n\r\nwhere a.deleted=0 and b.deleted=0\r\nand case when '{niandu}'='全部' then 1=1 else left(salesorder_no,4)  = '{niandu}' end\r\nand b.projectname like '%{projectname}%'\r\nand a.salesorder_no like '%{salesorder_no}%'\r\nand ifnull(e.sf139,'') like '%{loudong}%'\r\n\r\nGROUP BY b.projectid, sf139"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "nian",
        "Alias": "nian",
        "Columns": {
          "0": {
            "Name": "year",
            "Index": -1,
            "NameInSource": "year",
            "Alias": "year",
            "Type": "System.Object"
          }
        },
        "NameInSource": "连接",
        "SqlCommand": "SELECT '全部' as year\r\n\r\nUNION ALL\r\n\r\nSELECT DISTINCT left(salesorder_no,4)   from ld_salesorder where deleted=0 ORDER BY year desc"
      }
    },
    "Databases": {
