        },
        "NameInSource": "ldcrm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\ta.projectname,\r\n\ta.projectid,\r\n\ta.project_no,\r\n\ta.projectpurchase_total,\r\n\tb.purchaseorderid,\r\n\tb.purchaseorder_no,\r\n\tb.signed_data,\r\n\tb.duedate,\r\n\tifnull(b.total,0) as purchaseorder_total,\r\n\tb.vendorid,\r\n\tb.vendorname,\r\n\tifnull(c.total,0) as jiesuan_total,\r\n\tifnull(d.total,0) as cash_total,\r\n\t(ifnull(c.total,0)-ifnull(d.total,0)) as unjiesuan_total,\r\n\t(ifnull(b.total,0)-ifnull(d.total,0)) as uncash_total,\r\n\tb.productname,\r\n\tb.cf_3967,\r\n\tb.usageunit,\r\n\tb.productid,\r\n\tb.purchase_num,\r\n\tb.purchase_total,\r\n\tb.purchase_price,\r\n\tb.sf4506,\r\n\tb.`comment`,\r\n\tb.start_date,\r\n\tb.end_date,\r\n\tDATEDIFF(b.end_date,b.start_date)as days\r\nFROM\r\n(\r\n\tselect ld_project.projectname,\r\n\tld_project.projectid,\r\n\tld_project.project_no,\r\n\tsum(ld_purchaseorder.total)as projectpurchase_total,\r\n\tld_project.smownerid from ld_project\r\n\tleft join ld_purchaseorder on ld_purchaseorder.projectid=ld_project.projectid\r\n\twhere ld_project.deleted=0 \r\n\tand ld_project.approvestatus<>'已拒绝'\r\n\tand ld_purchaseorder.deleted=0 and ld_purchaseorder.contracttype=\"租赁\"\r\n\tAND ld_project.createdtime between DATE_FORMAT('{start_date}','%Y-%m-%d %H:%i:%s') AND DATE_FORMAT('{end_date}','%Y-%m-%d %H:%i:%s')\r\n\tand (case when '{projectname}'='' then 1=1 else ld_project.projectname like '%{projectname}%' end)\r\n\tgroup by ld_project.projectid\r\n) a\r\nLEFT JOIN (\r\n\tselect  \r\n\tld_project.projectid,\r\n\tld_purchaseorder.purchaseorderid,\r\n\tld_purchaseorder.purchaseorder_no,\r\n\tld_purchaseorder.signed_data,\r\n\tld_purchaseorder.duedate,\r\n\tld_purchaseorder.total,\r\n\tld_purchaseorder.vendorid,\r\n\tld_vendor.vendorname,\r\n\tld_products.productname,\r\n\tld_productcf.cf_3967,\r\n\tld_products.usageunit,\r\n\tld_purchaseorderdetail.productid,\r\n\tsum(ifnull(ld_purchaseorderdetail.quantity,0))as purchase_num,\r\n\tsum(ifnull(ld_purchaseorderdetail.tax_amount,0))as purchase_total,\r\n\tld_purchaseorderdetail.taxprice as purchase_price,\r\n\tld_purchaseorderdetailscf.sf4506,\r\n\tld_purchaseorderdetailscf.sf1622 as start_date,\r\n\tld_purchaseorderdetailscf.sf1828 as end_date,\r\n\tld_purchaseorderdetail.`comment`\r\n\tfrom ld_project \r\n\tleft join ld_purchaseorder on ld_purchaseorder.projectid=ld_project.projectid\r\n\tleft join ld_vendor on ld_vendor.vendorid=ld_purchaseorder.vendorid\r\n\tleft join ld_purchaseorderdetail on ld_purchaseorderdetail.id=ld_purchaseorder.purchaseorderid\r\n\tleft join ld_purchaseorderdetailscf on ld_purchaseorderdetail.lineitem_id=ld_purchaseorderdetailscf.lineitem_id\r\n\tleft join ld_products on ld_purchaseorderdetail.productid=ld_products.productid\r\n\tleft join ld_productcf on ld_products.productid=ld_productcf.productid\r\n\twhere ld_project.deleted=0 and ld_purchaseorder.deleted=0 and ld_purchaseorder.contracttype=\"租赁\"\r\n\tgroup by ld_purchaseorder.purchaseorderid,ld_purchaseorderdetail.productid\r\n) b ON a.projectid = b.projectid\r\n\r\nleft join (\r\n\tselect sum(ld_purchaseinvoice.total) as total,ld_purchaseorder.purchaseorderid\r\n\tfrom ld_purchaseorder\r\n\tleft join  ld_purchaseinvoice\r\n\ton ld_purchaseorder.purchaseorderid=ld_purchaseinvoice.source_list\r\n\tleft join  ld_purchaseinvoicecf\r\n\ton ld_purchaseinvoice.purchaseinvoiceid=ld_purchaseinvoicecf.purchaseinvoiceid\r\n\twhere ld_purchaseorder.deleted=0 and ld_purchaseinvoice.purchaseinvoice_type=\"租赁\" and ld_purchaseinvoice.entitytype=\"PurchaseOrder\" and ld_purchaseinvoicecf.cf_4426=\"结算单\"\r\n\tgroup by ld_purchaseorder.purchaseorderid\r\n)c on a.projectid = c.purchaseorderid\r\nleft join (\r\n\tselect sum(ld_sendcashbill.total) as total,ld_purchaseorder.purchaseorderid\r\n\tfrom ld_purchaseorder\r\n\tleft join  ld_sendcashbill \r\n\ton ld_purchaseorder.purchaseorderid=ld_sendcashbill.source_list\r\n\twhere ld_purchaseorder.deleted=0 and ld_purchaseorder.contracttype=\"租赁\" and ld_sendcashbill.entitytype=\"PurchaseOrder\"\r\n\tgroup by ld_purchaseorder.purchaseorderid\r\n)d on b.purchaseorderid = d.purchaseorderid\r\nINNER JOIN (\r\n\t\tSELECT DISTINCT\r\n\t\t\tuserid \r\n\t\tFROM (\r\n\t\t\tSELECT \r\n\t\t\t\tld_users.id AS userid \r\n\t\t\tFROM ld_users\r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Project' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\tUNION\r\n\t\t\tSELECT \r\n\t\t\t\tviewid AS userid \r\n\t\t\tFROM ld_scoperhigher\r\n\t\t\tWHERE userid='[uuid]' AND modulename ='Project' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename ='Project')\t\t\t\r\n\t\t\tUNION\r\n\t\t\tSELECT DISTINCT \r\n\t\t\t\tld_users2group.userid AS userid \r\n\t\t\tFROM ld_scoperhigher \r\n\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\tAND ld_scoperhigher.modulename ='Project'\r\n\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Project' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\tUNION \r\n\t\t\tSELECT \r\n\t\t\t\tid AS userid \r\n\t\t\tFROM ld_users  \r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\tUNION\r\n\t\t\tSELECT '[uuid]') AS vw_users\r\n\t) AS tmp_users ON tmp_users.userid=a.smownerid"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "list_users",
        "Alias": "list_users",
        "Columns": {
          "0": {
            "Name": "list_order",
            "Index": -1,
            "NameInSource": "list_order",
            "Alias": "list_order",
            "Type": "System.String"
          },
          "1": {
            "Name": "listid",
            "Index": -1,
            "NameInSource": "listid",
            "Alias": "listid",
            "Type": "System.Int32"
          },
          "2": {
            "Name": "listtype",
            "Index": -1,
            "NameInSource": "listtype",
            "Alias": "listtype",
            "Type": "System.Decimal"
          },
          "3": {
            "Name": "listvalue",
            "Index": -1,
            "NameInSource": "listvalue",
            "Alias": "listvalue",
            "Type": "System.String"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT 1 AS listid,'全部' AS listvalue,0 AS list_order,1 AS listtype\r\nUNION\r\nSELECT 2 AS listid, '我负责的' AS listvalue,0 AS list_order,2 AS listtype\r\nUNION (\r\n\tSELECT\r\n\t\ta.groupid+200000 AS listid,\r\n\t\tCONCAT('部门::',IFNULL(a.groupname,'')) AS listvalue,\r\n\t\tGROUP_CONCAT(IFNULL(a.splitsting,'') ORDER BY a.splitsting SEPARATOR '::') AS listorder,\r\n\t\t1 AS listtype\r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\ta.groupid, \r\n\t\t\ta.groupname, \r\n\t\t\tLPAD(substring_index(substring_index(a.splitsting,',',b.seq+1),',',-1),8,'0') AS splitsting\r\n\t\tFROM (\r\n\t\t\tSELECT \r\n\t\t\t\ta.groupid,\r\n\t\t\t\ta.groupname, \r\n\t\t\t\tREPLACE(a.parentgroup,'::',',') AS splitsting \r\n\t\t\tFROM ld_groups a\r\n\t\t\tLEFT JOIN ld_users2group b ON b.groupid=a.groupid\r\n\t\t\tGROUP BY a.groupid\r\n\t\t) a \r\n\t\tLEFT JOIN sequence b ON b.seq < (length(a.splitsting) - length(replace(a.splitsting,',',''))+1)\r\n\t) a\r\n\tGROUP BY a.groupid\r\n)\r\nUNION (\r\n\tSELECT\r\n\t\ta.id+300000 AS listid,\r\n\t\tCONCAT('用户::',IFNULL(a.last_name,''),'(',c.listvalue,')') AS listvalue,\r\n\t\tc.listorder,\r\n\t\t2 AS listtype\r\n\tFROM ld_users a\r\n\tLEFT JOIN ld_users2group b ON b.userid=a.id  \r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\ta.groupid,\r\n\t\t\ta.groupid+200000 AS listid,\r\n\t\t\tCONCAT('部门::',IFNULL(a.groupname,'')) AS listvalue,\r\n\t\t\tGROUP_CONCAT(IFNULL(a.splitsting,'') ORDER BY a.splitsting SEPARATOR '::') AS listorder\r\n\t\tFROM (\r\n\t\t\tSELECT \r\n\t\t\t\ta.groupid, \r\n\t\t\t\ta.groupname, \r\n\t\t\t\tLPAD(substring_index(substring_index(a.splitsting,',',b.seq+1),',',-1),8,'0') AS splitsting\r\n\t\t\tFROM (\r\n\t\t\t\tSELECT \r\n\t\t\t\t\ta.groupid,\r\n\t\t\t\t\ta.groupname, \r\n\t\t\t\t\tREPLACE(a.parentgroup,'::',',') AS splitsting \r\n\t\t\t\tFROM ld_groups a\r\n\t\t\t\tLEFT JOIN ld_users2group b ON b.groupid=a.groupid\r\n\t\t\t\tGROUP BY a.groupid\r\n\t\t\t) a \r\n\t\t\tLEFT JOIN sequence b ON b.seq < (length(a.splitsting) - length(replace(a.splitsting,',',''))+1)\r\n\t\t) a\r\n\t\tGROUP BY a.groupid\r\n\t) c ON c.groupid=b.groupid\r\n\tINNER JOIN (\r\n\t\tSELECT DISTINCT\r\n\t\t\tuserid \r\n\t\tFROM (\r\n\t\t\tSELECT \r\n\t\t\t\tld_users.id AS userid \r\n\t\t\tFROM ld_users\r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Project' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\tUNION\r\n\t\t\tSELECT \r\n\t\t\t\tviewid AS userid \r\n\t\t\tFROM ld_scoperhigher\r\n\t\t\tWHERE userid='[uuid]' AND modulename ='Project' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename ='Project')\t\t\t\r\n\t\t\tUNION\r\n\t\t\tSELECT DISTINCT \r\n\t\t\t\tld_users2group.userid AS userid \r\n\t\t\tFROM ld_scoperhigher \r\n\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\tAND ld_scoperhigher.modulename ='Project'\r\n\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Project' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\tUNION \r\n\t\t\tSELECT \r\n\t\t\t\tid AS userid \r\n\t\t\tFROM ld_users  \r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\tUNION\r\n\t\t\tSELECT '[uuid]') AS vw_users\r\n\t) AS tmp_users ON tmp_users.userid=a.id\r\n\tWHERE a.deleted=0\r\n\t\tAND a.`status`='Active'\r\n)\r\nORDER BY list_order,listtype"
      }
    },
