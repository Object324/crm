          },
          "14": {
            "Name": "salesorderid",
            "Index": -1,
            "NameInSource": "salesorderid",
            "Alias": "salesorderid",
            "Type": "System.Int32"
          },
          "15": {
            "Name": "shuifei",
            "Index": -1,
            "NameInSource": "shuifei",
            "Alias": "shuifei",
            "Type": "System.Decimal"
          },
          "16": {
            "Name": "total",
            "Index": -1,
            "NameInSource": "total",
            "Alias": "total",
            "Type": "System.Decimal"
          },
          "17": {
            "Name": "xianchangfei",
            "Index": -1,
            "NameInSource": "xianchangfei",
            "Alias": "xianchangfei",
            "Type": "System.Decimal"
          },
          "18": {
            "Name": "yunfei",
            "Index": -1,
            "NameInSource": "yunfei",
            "Alias": "yunfei",
            "Type": "System.Decimal"
          },
          "19": {
            "Name": "zafei",
            "Index": -1,
            "NameInSource": "zafei",
            "Alias": "zafei",
            "Type": "System.Decimal"
          },
          "20": {
            "Name": "zongbaofei",
            "Index": -1,
            "NameInSource": "zongbaofei",
            "Alias": "zongbaofei",
            "Type": "System.Decimal"
          },
          "21": {
            "Name": "zongchengben",
            "Index": -1,
            "NameInSource": "zongchengben",
            "Alias": "zongchengben",
            "Type": "System.Decimal"
          }
        },
        "NameInSource": "连接",
        "SqlCommand": "SELECT a.salesorderid,\r\na.salesorder_no,\r\na.total,\r\na.received_amount,\r\na.have_invoicetotal,\r\nb.projectname,\r\nb.projectid,\r\ncailiaofei,\r\nrengongfei,\r\nzongbaofei,\r\nxianchangfei,\r\nyunfei,\r\nshuifei,\r\nchailvfei,\r\nzafei,\r\nguanlifei,\r\nfuliaofei,\r\njixiefei,\r\nqitafei,\r\nzongchengben,\r\n(a.total - ifnull(zongchengben,0)) as maoli,\r\n(a.total - ifnull(zongchengben,0))/a.total as maolilv\r\n\r\n\r\nfrom ld_salesorder a \r\nLEFT JOIN ld_project b on a.salesorderid=b.salesorderid\r\nLEFT JOIN (SELECT a.projectid, sum(c.rmb_total) as cailiaofei\r\nfrom ld_expense a\r\nLEFT JOIN ld_expensedetail b on a.expenseid=b.expenseid\r\nLEFT JOIN ld_expensedetailscf c on b.expensedetailid=c.expensedetailid\r\nwhere  a.approvestatus = '已批准'  and  b.expensetype='材料费' GROUP BY a.projectid ) cailiao on cailiao.projectid=b.projectid\r\n\r\nLEFT JOIN (SELECT a.projectid, sum(c.rmb_total) as rengongfei\r\nfrom ld_expense a\r\nLEFT JOIN ld_expensedetail b on a.expenseid=b.expenseid\r\nLEFT JOIN ld_expensedetailscf c on b.expensedetailid=c.expensedetailid\r\nwhere  a.approvestatus = '已批准'  and  b.expensetype='人工费' GROUP BY a.projectid ) rengong on rengong.projectid=b.projectid\r\n\r\nLEFT JOIN (SELECT a.projectid, sum(c.rmb_total) as zongbaofei\r\nfrom ld_expense a\r\nLEFT JOIN ld_expensedetail b on a.expenseid=b.expenseid\r\nLEFT JOIN ld_expensedetailscf c on b.expensedetailid=c.expensedetailid\r\nwhere  a.approvestatus = '已批准'  and  b.expensetype='总包配合费' GROUP BY a.projectid ) zongbao on zongbao.projectid=b.projectid\r\n\r\nLEFT JOIN (SELECT a.projectid, sum(c.rmb_total) as xianchangfei\r\nfrom ld_expense a\r\nLEFT JOIN ld_expensedetail b on a.expenseid=b.expenseid\r\nLEFT JOIN ld_expensedetailscf c on b.expensedetailid=c.expensedetailid\r\nwhere  a.approvestatus = '已批准'  and  b.expensetype='现场配合费' GROUP BY a.projectid ) xianchang on xianchang.projectid=b.projectid\r\n\r\nLEFT JOIN (SELECT a.projectid, sum(c.rmb_total) as yunfei\r\nfrom ld_expense a\r\nLEFT JOIN ld_expensedetail b on a.expenseid=b.expenseid\r\nLEFT JOIN ld_expensedetailscf c on b.expensedetailid=c.expensedetailid\r\nwhere  a.approvestatus = '已批准'  and  b.expensetype='运费' GROUP BY a.projectid ) yun on yun.projectid=b.projectid\r\n\r\nLEFT JOIN (SELECT a.projectid, sum(c.rmb_total) as shuifei\r\nfrom ld_expense a\r\nLEFT JOIN ld_expensedetail b on a.expenseid=b.expenseid\r\nLEFT JOIN ld_expensedetailscf c on b.expensedetailid=c.expensedetailid\r\nwhere  a.approvestatus = '已批准'  and (b.expensetype='税费' or b.expensetype='税费1' or b.expensetype='税费2' or b.expensetype='抵扣税费' or b.expensetype='抵扣税费2') GROUP BY a.projectid ) shui on shui.projectid=b.projectid\r\n\r\nLEFT JOIN (SELECT a.projectid, sum(c.rmb_total) as chailvfei\r\nfrom ld_expense a\r\nLEFT JOIN ld_expensedetail b on a.expenseid=b.expenseid\r\nLEFT JOIN ld_expensedetailscf c on b.expensedetailid=c.expensedetailid\r\nwhere  a.approvestatus = '已批准'  and  (b.expensetype='住宿费' or b.expensetype='餐饮' or b.expensetype='交通') GROUP BY a.projectid ) chailv on chailv.projectid=b.projectid\r\n\r\nLEFT JOIN (SELECT a.projectid, sum(c.rmb_total) as zafei\r\nfrom ld_expense a\r\nLEFT JOIN ld_expensedetail b on a.expenseid=b.expenseid\r\nLEFT JOIN ld_expensedetailscf c on b.expensedetailid=c.expensedetailid\r\nwhere  a.approvestatus = '已批准'  and  (b.expensetype='资料费' or b.expensetype='材料检测费' or b.expensetype='审计费' or b.expensetype='杂费') GROUP BY a.projectid ) za on za.projectid=b.projectid\r\n\r\nLEFT JOIN (SELECT a.projectid, sum(c.rmb_total) as guanlifei\r\nfrom ld_expense a\r\nLEFT JOIN ld_expensedetail b on a.expenseid=b.expenseid\r\nLEFT JOIN ld_expensedetailscf c on b.expensedetailid=c.expensedetailid\r\nwhere  a.approvestatus = '已批准'  and (b.expensetype='管理费' or b.expensetype='管理费1' or b.expensetype='管理费2') GROUP BY a.projectid ) guanli on guanli.projectid=b.projectid\r\n\r\nLEFT JOIN (SELECT a.projectid, sum(c.rmb_total) as fuliaofei\r\nfrom ld_expense a\r\nLEFT JOIN ld_expensedetail b on a.expenseid=b.expenseid\r\nLEFT JOIN ld_expensedetailscf c on b.expensedetailid=c.expensedetailid\r\nwhere  a.approvestatus = '已批准'  and  (b.expensetype='辅料费' or b.expensetype='保温材料' or b.expensetype='工具费') GROUP BY a.projectid ) fuliao on fuliao.projectid=b.projectid\r\n\r\nLEFT JOIN (SELECT a.projectid, sum(c.rmb_total) as jixiefei\r\nfrom ld_expense a\r\nLEFT JOIN ld_expensedetail b on a.expenseid=b.expenseid\r\nLEFT JOIN ld_expensedetailscf c on b.expensedetailid=c.expensedetailid\r\nwhere  a.approvestatus = '已批准'  and  (b.expensetype='吊篮台班费' or b.expensetype='吊篮检测费'  or b.expensetype='脚手架费')GROUP BY a.projectid ) jixie on jixie.projectid=b.projectid\r\n\r\nLEFT JOIN (SELECT a.projectid, sum(c.rmb_total) as qitafei\r\nfrom ld_expense a\r\nLEFT JOIN ld_expensedetail b on a.expenseid=b.expenseid\r\nLEFT JOIN ld_expensedetailscf c on b.expensedetailid=c.expensedetailid\r\nwhere  a.approvestatus = '已批准'  and  (b.expensetype='通讯' or b.expensetype='礼品' or b.expensetype='办公' or b.expensetype='活动' or b.expensetype='其他' \r\nor b.expensetype='进场费' or b.expensetype='业务费' or b.expensetype='工资' ) GROUP BY a.projectid ) qita on qita.projectid=b.projectid\r\n\r\nLEFT JOIN (SELECT a.projectid, sum(c.rmb_total) as zongchengben\r\nfrom ld_expense a\r\nLEFT JOIN ld_expensedetail b on a.expenseid=b.expenseid\r\nLEFT JOIN ld_expensedetailscf c on b.expensedetailid=c.expensedetailid\r\nwhere  a.approvestatus = '已批准'  GROUP BY a.projectid ) huizong on huizong.projectid=b.projectid\r\n\r\nLEFT JOIN (SELECT projectid, sum(sf140) as zongmianji from ld_customform24 a\r\nLEFT JOIN ld_customform24detail b on a.customform24id = b.id\r\nLEFT JOIN ld_customform24detailscf c on b.lineitem_id = c.lineitem_id\r\nwhere a.deleted=0 GROUP BY a.projectid) as mianji on mianji.projectid=b.projectid\r\n\r\nwhere a.deleted=0 and b.deleted=0\r\nand case when '{niandu}'='全部' then 1=1 else left(salesorder_no,4)  = '{niandu}' end\r\nand b.projectname like '%{projectname}%'\r\nand a.salesorder_no like '%{salesorder_no}%'"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "nian",
        "Alias": "nian",
        "Columns": {
          "0": {
            "Name": "year",
            "Index": -1,
            "NameInSource": "year",
            "Alias": "year",
            "Type": "System.Object"
          }
        },
        "NameInSource": "连接",
        "SqlCommand": "SELECT '全部' as year\r\n\r\nUNION ALL\r\n\r\nSELECT DISTINCT left(salesorder_no,4)   from ld_salesorder where deleted=0 ORDER BY year desc\r\n\r\n"
      },
      "2": {
        "Ident": "StiMySqlSource",
        "Name": "expense",
        "Alias": "expense",
        "Columns": {
          "0": {
            "Name": "Startdate",
            "Index": -1,
            "NameInSource": "Startdate",
            "Alias": "Startdate",
            "Type": "System.DateTime"
          },
          "1": {
            "Name": "description",
            "Index": -1,
            "NameInSource": "description",
            "Alias": "description",
            "Type": "System.String"
          },
          "2": {
            "Name": "enddate",
            "Index": -1,
            "NameInSource": "enddate",
            "Alias": "enddate",
            "Type": "System.DateTime"
          },
          "3": {
            "Name": "expense_no",
            "Index": -1,
            "NameInSource": "expense_no",
            "Alias": "expense_no",
            "Type": "System.String"
          },
          "4": {
            "Name": "expenseid",
            "Index": -1,
            "NameInSource": "expenseid",
            "Alias": "expenseid",
            "Type": "System.Int32"
          },
          "5": {
            "Name": "expensetype",
            "Index": -1,
            "NameInSource": "expensetype",
            "Alias": "expensetype",
            "Type": "System.String"
          },
          "6": {
            "Name": "projectid",
            "Index": -1,
            "NameInSource": "projectid",
            "Alias": "projectid",
            "Type": "System.Int32"
          },
          "7": {
            "Name": "projectname",
            "Index": -1,
            "NameInSource": "projectname",
            "Alias": "projectname",
            "Type": "System.String"
          },
          "8": {
            "Name": "rmb_total",
            "Index": -1,
            "NameInSource": "rmb_total",
            "Alias": "rmb_total",
            "Type": "System.Object"
          },
          "9": {
            "Name": "type",
            "Index": -1,
            "NameInSource": "type",
            "Alias": "type",
            "Type": "System.String"
          }
        },
        "NameInSource": "连接",
        "SqlCommand": "SELECT * from (\r\nSELECT a.projectid,\r\na.expense_no,\r\na.expenseid,\r\nb.Startdate,\r\nb.enddate,\r\nc.rmb_total,\r\nb.expensetype,\r\nd.projectname,\r\nb.description,\r\ncase when b.expensetype='税费' or b.expensetype='税费1' or b.expensetype='税费2' or b.expensetype='抵扣税费' or b.expensetype='抵扣税费2' then '税费'\r\n\t\t when b.expensetype='住宿费' or b.expensetype='餐饮' or b.expensetype='交通' then '差旅费'\r\n\t\t when b.expensetype='资料费' or b.expensetype='材料检测费' or b.expensetype='审计费' or b.expensetype='杂费' then '项目杂费'\r\n     when b.expensetype='管理费' or b.expensetype='管理费1' or b.expensetype='管理费2' then '管理费'\r\n     when b.expensetype='辅料费' or b.expensetype='保温材料' or b.expensetype='工具费' then '辅料费'\r\n     when b.expensetype='吊篮台班费' or b.expensetype='吊篮检测费'  or b.expensetype='脚手架费' then '机械设备费'\r\n\t\t when b.expensetype='材料费' then '材料费'\r\n     when b.expensetype='人工费' then '人工费'    \r\n     when b.expensetype='总包配合费' then '总包配合费'\r\n     when b.expensetype='现场配合费' then '现场配合费'\r\n     when b.expensetype='运费' then '运费'\r\n     when b.expensetype='通讯' or b.expensetype='礼品' or b.expensetype='办公' or b.expensetype='活动' or b.expensetype='其他' \r\nor b.expensetype='进场费' or b.expensetype='业务费'  or b.expensetype='工资' then '其他' end as type \r\nfrom ld_expense a\r\nLEFT JOIN ld_expensedetail b on a.expenseid=b.expenseid\r\nLEFT JOIN ld_expensedetailscf c on b.expensedetailid=c.expensedetailid\r\nLEFT JOIN ld_project d on a.projectid = d.projectid\r\n\r\nwhere  a.approvestatus = '已批准' and a.projectid = '{this[\"projectid\"]}' ) a where type = '{this[\"type\"]}'"
      }
    },
    "Databases": {
      "0": {
        "Ident": "StiMySqlDatabase",
        "Name": "连接",
