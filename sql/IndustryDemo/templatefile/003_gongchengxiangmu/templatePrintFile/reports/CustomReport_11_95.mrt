            "Alias": "projectname",
            "Type": "System.String"
          },
          "10": {
            "Name": "rukuquantity",
            "Index": -1,
            "NameInSource": "rukuquantity",
            "Alias": "rukuquantity",
            "Type": "System.Decimal"
          },
          "11": {
            "Name": "salesorder_no",
            "Index": -1,
            "NameInSource": "salesorder_no",
            "Alias": "salesorder_no",
            "Type": "System.String"
          },
          "12": {
            "Name": "salesorderid",
            "Index": -1,
            "NameInSource": "salesorderid",
            "Alias": "salesorderid",
            "Type": "System.Int32"
          },
          "13": {
            "Name": "totalgongchengliang",
            "Index": -1,
            "NameInSource": "totalgongchengliang",
            "Alias": "totalgongchengliang",
            "Type": "System.Decimal"
          },
          "14": {
            "Name": "xinghao",
            "Index": -1,
            "NameInSource": "xinghao",
            "Alias": "xinghao",
            "Type": "System.String"
          }
        },
        "NameInSource": "连接",
        "Type": "Table",
        "SqlCommand": "SELECT *, \r\nchukuquantity/rukuquantity as chukuzhanbi,\r\ngongchengliang/totalgongchengliang as gongchengliangzhanbi\r\nfrom (\r\nSELECT a.salesorderid,\r\na.salesorder_no,\r\nb.projectname,\r\nb.projectid,\r\nifnull(rukuquantity,0) as rukuquantity,\r\nifnull(chukuquantity,0) as chukuquantity,\r\nifnull(gongchengliang,0) as gongchengliang,\r\nifnull(totalgongchengliang,0) as totalgongchengliang,\r\ncf_2615 as banzu,\r\nproductname,\r\ncf_2708 as pinpai,\r\nproductsheet as xinghao,\r\ncf_2709 as guige\r\n\r\nfrom ld_salesorder a \r\nLEFT JOIN ld_project b on a.salesorderid=b.salesorderid\r\n\r\nLEFT JOIN (select a.projectid, b.productid, sum(b.quantity) as rukuquantity from ld_stock a \r\nLEFT JOIN ld_stockdetail b on a.stock_id=b.id\r\nGROUP BY a.projectid, b.productid) ruku on ruku.projectid=b.projectid\r\n\r\nLEFT JOIN (SELECT a.projectid, a.customform01_id, b.productid, sum(b.quantity) as chukuquantity from ld_outboundorder a\r\nLEFT JOIN ld_outboundorderdetail b on a.out_id=b.id\r\nGROUP BY a.projectid,b.productid, a.customform01_id) chuku on chuku.productid=b.projectid and chuku.productid=ruku.productid\r\n\r\nLEFT JOIN(SELECT a.projectid, a.customform01_id, sum(c.sf140) as gongchengliang from ld_customform24 a \r\nLEFT JOIN ld_customform24detail b on a.customform24id=b.id\r\nLEFT JOIN ld_customform24detailscf c on b.lineitem_id=c.lineitem_id\r\nwhere a.deleted=0\r\nGROUP BY a.projectid, a.customform01_id) banzugongchengliang on banzugongchengliang.customform01_id=chuku.customform01_id\r\n\r\nLEFT JOIN(SELECT a.projectid, sum(c.sf140) as totalgongchengliang from ld_customform24 a \r\nLEFT JOIN ld_customform24detail b on a.customform24id=b.id\r\nLEFT JOIN ld_customform24detailscf c on b.lineitem_id=c.lineitem_id\r\nwhere a.deleted=0\r\nGROUP BY a.projectid ) huizonggongchengliang on huizonggongchengliang.projectid=b.projectid\r\n\r\nLEFT JOIN ld_products c on ruku.productid = c.productid\r\nLEFT JOIN ld_productcf d on c.productid=d.productid\r\nLEFT JOIN ld_customform01scf e on chuku.customform01_id=e.customform01id\r\n\r\n\r\nwhere a.deleted=0 and b.deleted=0\r\nand case when '{niandu}'='全部' then 1=1 else left(salesorder_no,4)  = '{niandu}' end\r\nand b.projectname like '%{projectname}%'\r\nand a.salesorder_no like '%{salesorder_no}%'\r\n) a \r\n"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "nian",
        "Alias": "nian",
        "Columns": {
          "0": {
            "Name": "year",
            "Index": -1,
            "NameInSource": "year",
            "Alias": "year",
            "Type": "System.Object"
          }
        },
        "NameInSource": "连接",
        "Type": "Table",
        "SqlCommand": "SELECT '全部' as year\r\n\r\nUNION ALL\r\n\r\nSELECT DISTINCT left(salesorder_no,4)   from ld_salesorder where deleted=0 ORDER BY year desc"
      }
    },
