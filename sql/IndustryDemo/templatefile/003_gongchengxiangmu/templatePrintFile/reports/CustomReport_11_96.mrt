            "Name": "rengongfeijuesuan",
            "Index": -1,
            "NameInSource": "rengongfeijuesuan",
            "Alias": "rengongfeijuesuan",
            "Type": "System.Object"
          },
          "12": {
            "Name": "salesorder_no",
            "Index": -1,
            "NameInSource": "salesorder_no",
            "Alias": "salesorder_no",
            "Type": "System.String"
          },
          "13": {
            "Name": "salesorderid",
            "Index": -1,
            "NameInSource": "salesorderid",
            "Alias": "salesorderid",
            "Type": "System.Int32"
          },
          "14": {
            "Name": "total",
            "Index": -1,
            "NameInSource": "total",
            "Alias": "total",
            "Type": "System.Object"
          },
          "15": {
            "Name": "yizhifurengong",
            "Index": -1,
            "NameInSource": "yizhifurengong",
            "Alias": "yizhifurengong",
            "Type": "System.Object"
          },
          "16": {
            "Name": "zongyingfu",
            "Index": -1,
            "NameInSource": "zongyingfu",
            "Alias": "zongyingfu",
            "Type": "System.Object"
          }
        },
        "NameInSource": "连接",
        "Type": "Table",
        "SqlCommand": "SELECT a.salesorderid,\r\na.salesorder_no,\r\na.total,\r\n10/100 as lingyongbili,\r\na.total * 10/100 as kelingyong,\r\na.received_amount,\r\ncase when a.total *10/100 < a.received_amount then 0 else  a.total *10/100 - a.received_amount end as haikelingyong,\r\nb.projectname,\r\nb.projectid,\r\nifnull(rengongfei,0)  as rengongfei,\r\nifnull(rengongjuesuan,0)  as rengongfeijuesuan,\r\nifnull(yizhifu, 0) as yizhifurengong,\r\ncase when ifnull(case when rengongjuesuan is null then ifnull(rengongfei,0) else rengongjuesuan end,0) < ifnull(yizhifu, 0)  then 0 else ifnull(case when rengongjuesuan is null then ifnull(rengongfei,0) else rengongjuesuan end,0) - ifnull(yizhifu, 0) end as haiyingfurengong,\r\ncase when ifnull(cailiaoyusuan,0) < ifnull(cailiaoyifu,0) then 0 else ifnull(cailiaoyusuan,0)- ifnull(cailiaoyifu,0) end as cailiaodaifu,\r\nifnull(cailiaoyusuan,0) as cailiaoyusuan,\r\ncase when projectstatus='已完成' then 0 else ifnull(cailiaoyifu,0) end as cailiaoyifu,\r\n\r\ncase when ifnull(case when rengongjuesuan is null then ifnull(rengongfei,0) else rengongjuesuan end,0) < ifnull(yizhifu, 0)  then 0 else ifnull(case when rengongjuesuan is null then ifnull(rengongfei,0) else rengongjuesuan end,0) - ifnull(yizhifu, 0) end  + case when projectstatus='已完成' or (ifnull(cailiaoyusuan,0) < ifnull(cailiaoyifu,0)) then 0 else ifnull(cailiaoyusuan,0)- ifnull(cailiaoyifu,0) end as zongyingfu\r\n\r\n\r\n\r\nfrom ld_salesorder a \r\nLEFT JOIN ld_project b on a.salesorderid=b.salesorderid\r\nLEFT JOIN ld_projectcf c on b.projectid=c.projectid\r\n\r\nLEFT JOIN(SELECT a.projectid, sum(c.sf154) as rengongfei from ld_customform24 a \r\nLEFT JOIN ld_customform24detail b on a.customform24id=b.id\r\nLEFT JOIN ld_customform24detailscf c on b.lineitem_id=c.lineitem_id\r\nwhere a.deleted=0\r\nGROUP BY a.projectid) rengongfeiyusuan on rengongfeiyusuan.projectid=b.projectid\r\n\r\nLEFT JOIN(SELECT a.projectid, sum(c.sf143) as rengongjuesuan from ld_customform25 a\r\nLEFT JOIN ld_customform25detail b on a.customform25id=b.id\r\nLEFT JOIN ld_customform25detailscf c on b.lineitem_id=c.lineitem_id\r\nwhere a.deleted=0\r\nGROUP BY a.projectid) as rengongjue on rengongjue.projectid=b.projectid\r\n\r\nLEFT JOIN (SELECT a.projectid,\r\nsum(c.rmb_total) as yizhifu,\r\nb.description\r\nfrom ld_expense a\r\nLEFT JOIN ld_expensedetail b on a.expenseid=b.expenseid\r\nLEFT JOIN ld_expensedetailscf c on b.expensedetailid=c.expensedetailid\r\nwhere  a.approvestatus = '已批准' and b.expensetype='人工费'\r\nGROUP BY a.projectid) feiyong on feiyong.projectid=b.projectid\r\n\r\nLEFT JOIN (SELECT a.projectid, \r\nsum(quantity * taxprice) as cailiaoyusuan\r\n from ld_purchaseinquiryorder a \r\nLEFT JOIN ld_purchaseinquiryorderdetail b on a.purchaseinquiryorderid=b.id\r\nLEFT JOIN ld_purchaseinquiryorderdetailscf c on b.lineitem_id=c.lineitem_id\r\nGROUP BY a.projectid) cailiao on cailiao.projectid=b.projectid\r\n\r\nLEFT JOIN (SELECT a.projectid, sum(c.rmb_total) as cailiaoyifu\r\nfrom ld_expense a\r\nLEFT JOIN ld_expensedetail b on a.expenseid=b.expenseid\r\nLEFT JOIN ld_expensedetailscf c on b.expensedetailid=c.expensedetailid\r\nwhere  a.approvestatus = '已批准'  and  b.expensetype='材料费' GROUP BY a.projectid ) cailiao2 on cailiao2.projectid=b.projectid\r\n\r\n\r\nwhere a.deleted=0 and b.deleted=0\r\nand case when '{niandu}'='全部' then 1=1 else left(salesorder_no,4)  = '{niandu}' end\r\nand b.projectname like '%{projectname}%'\r\nand a.salesorder_no like '%{salesorder_no}%'"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "nian",
        "Alias": "nian",
        "Columns": {
          "0": {
            "Name": "year",
            "Index": -1,
            "NameInSource": "year",
            "Alias": "year",
            "Type": "System.Object"
          }
        },
        "NameInSource": "连接",
        "SqlCommand": "SELECT '全部' as year\r\n\r\nUNION ALL\r\n\r\nSELECT DISTINCT left(salesorder_no,4)   from ld_salesorder where deleted=0 ORDER BY year desc\r\n\r\n"
      }
    },
