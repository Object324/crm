          "Components": {
            "0": {
              "Ident": "StiText",
              "Name": "Text19",
              "Guid": "54535b39325870016b021124efd094ee",
              "ClientRectangle": "1.8,0,2.6,1",
              "Interaction": {
                "Ident": "StiInteraction"
              },
              "Hyperlink": {
                "Value": "viewdetails.php?id={chengben.salesorderid}"
