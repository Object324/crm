          },
          "10": {
            "Name": "subtotal_tag",
            "Index": -1,
            "NameInSource": "subtotal_tag",
            "Alias": "subtotal_tag",
            "Type": "System.String"
          },
          "11": {
            "Name": "subtotal_tag_show",
            "Index": -1,
            "NameInSource": "subtotal_tag_show",
            "Alias": "subtotal_tag_show",
            "Type": "System.String"
          },
          "12": {
            "Name": "total_jiesuan",
            "Index": -1,
            "NameInSource": "total_jiesuan",
            "Alias": "total_jiesuan",
            "Type": "System.Decimal"
          },
          "13": {
            "Name": "yushou_cashbillid",
            "Index": -1,
            "NameInSource": "yushou_cashbillid",
            "Alias": "yushou_cashbillid",
            "Type": "System.Int32"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\ta.customform12id AS bill_id,\r\n\tDATE_FORMAT(a.createdtime,'%Y-%m') AS subtotal_tag,\r\n\tDATE_FORMAT(a.createdtime,'%c') AS subtotal_tag_show,\r\n\tDATE_FORMAT(a.createdtime,'%Y-%m-%d') AS cz_date,\r\n\tk.accountname AS cz_accountname,\r\n\tCASE\r\n\t\tWHEN d.sequence_no>1 THEN 0\r\n\t\tELSE a.total\r\n\tEND AS cz_amunt,\r\n\tc.sk_date,\r\n\tCASE\r\n\t\tWHEN d.sequence_no>1 THEN 0\r\n\t\tELSE c.sk_amount\r\n\tEND AS sk_amount,\r\n\tc.yushou_cashbillid,\r\n\td.end_accountname,\r\n\td.productname,\r\n\tROUND(d.quantity,0) AS quantity,\r\n\td.total_jiesuan,\r\n\tCASE\r\n\t\tWHEN d.sequence_no>1 THEN 0\r\n\t\tELSE e.bx_amount\r\n\tEND AS bx_amount\r\nFROM ld_customform12 a\r\nLEFT JOIN ld_account k ON k.accountid=a.accountid\r\nLEFT JOIN ld_customform12scf b ON b.customform12id=a.customform12id\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\ta.cashbillid AS yushou_cashbillid,\r\n\t\ta.customform12_id,\r\n\t\ta.Total AS sk_amount,\r\n\t\ta.cashbilldate AS sk_date\r\n\tFROM ld_cashbill a\r\n\tWHERE a.deleted=0\r\n\t\tAND a.customform12_id>0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND a.cashtype='debuction'\r\n) c ON c.customform12_id=a.customform12id\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\tb.cashbill_no,\r\n\t\ta.debuctionid AS yushou_cashbillid,\r\n\t\ta.cashbillid AS shoukuan_cashbillid,\r\n\t\tc.entitytypeid,\r\n\t\ts.salesorder_no,\r\n\t\te.accountname AS end_accountname,\r\n\t\tp.productname,\r\n\t\td.quantity,\r\n\t\ts.total_jiesuan,\r\n\t\td.sequence_no\r\n\tFROM ld_cashbilldebuctiondetail a\r\n\tLEFT JOIN ld_cashbill b ON b.cashbillid=a.cashbillid\r\n\tLEFT JOIN ld_cashbill2paymentplan c ON c.CashBillID=a.cashbillid\r\n\tLEFT JOIN ld_salesorder s ON s.salesorderid=c.entitytypeid\r\n\tLEFT JOIN ld_salesorderdetail d ON d.id=s.salesorderid\r\n\tLEFT JOIN ld_products p ON p.productid=d.productid\r\n\tLEFT JOIN ld_account e ON e.accountid=s.end_accountid\r\n\tWHERE b.deleted=0\r\n\t\tAND b.approvestatus<>'已拒绝'\r\n\tGROUP BY a.debuctionid\r\n) d ON d.yushou_cashbillid=c.yushou_cashbillid\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\tb.entitytypeid,\r\n\t\tSUM(c.rmb_total) AS bx_amount\r\n\tFROM ld_expense a\r\n\tLEFT JOIN ld_expensedetail b ON a.expenseid=b.expenseid\r\n\tLEFT JOIN ld_expensedetailscf c ON c.expensedetailid=b.expensedetailid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND b.entitytype='CustomForm12'\r\n\t\tAND b.entitytypeid>0\r\n\tGROUP BY b.entitytypeid\r\n) e ON e.entitytypeid=a.customform12id\r\nWHERE a.deleted=0\r\n\tAND a.approvestatus<>'已拒绝'\r\n\tAND a.createdtime BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d 00:00:00') AND DATE_FORMAT('{end_date}','%Y-%m-%d 23:59:59')\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN TRIM('{custname}')='' THEN 1=1\r\n\t\t\tELSE LOCATE(TRIM('{custname}'),k.accountname)>0\r\n\t\tEND)\r\nORDER BY a.createdtime"
      }
    },
