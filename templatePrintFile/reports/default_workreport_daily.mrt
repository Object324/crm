-%m-%d'),INTERVAL 1 DAY)) AS L17,\r\n\t\t\tDAY(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','17'),'%Y-%m-%d'),INTERVAL 1 DAY)) AS L18,\r\n\t\t\tDAY(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','18'),'%Y-%m-%d'),INTERVAL 1 DAY)) AS L19,\r\n\t\t\tDAY(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','19'),'%Y-%m-%d'),INTERVAL 1 DAY)) AS L20,\r\n\t\t\t\r\n\t\t\tDAY(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','20'),'%Y-%m-%d'),INTERVAL 1 DAY)) AS L21,\r\n\t\t\tDAY(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','21'),'%Y-%m-%d'),INTERVAL 1 DAY)) AS L22,\r\n\t\t\tDAY(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','22'),'%Y-%m-%d'),INTERVAL 1 DAY)) AS L23,\r\n\t\t\tDAY(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','23'),'%Y-%m-%d'),INTERVAL 1 DAY)) AS L24,\r\n\t\t\tDAY(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','24'),'%Y-%m-%d'),INTERVAL 1 DAY)) AS L25,\r\n\t\t\tDAY(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','25'),'%Y-%m-%d'),INTERVAL 1 DAY)) AS L26,\r\n\t\t\tDAY(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','26'),'%Y-%m-%d'),INTERVAL 1 DAY)) AS L27,\r\n\t\t\tDAY(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','27'),'%Y-%m-%d'),INTERVAL 1 DAY)) AS L28,\r\n\t\t\tDAY(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','28'),'%Y-%m-%d'),INTERVAL 1 DAY)) AS L29,\r\n\t\t\tDAY(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','29'),'%Y-%m-%d'),INTERVAL 1 DAY)) AS L30,\r\n\t\t\tDAY(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','30'),'%Y-%m-%d'),INTERVAL 1 DAY)) AS L31\r\n\t\tFROM ld_users a\r\n\t\tLEFT JOIN (\r\n\t\t\tSELECT \r\n\t\t\t\tworkreportid,\r\n\t\t\t\tsmcreatorid,\r\n\t\t\t\tsendlog_workdate AS reportdate,\r\n\t\t\t\tDATE_FORMAT(createdtime,'%Y-%m-%d') AS adddate\r\n\t\t\tFROM ld_workreport \r\n\t\t\tWHERE type=1 \r\n\t\t\t\tAND YEAR(sendlog_workdate)='{nian}'\r\n\t\t\t\tAND MONTH(sendlog_workdate)='{yue}'\r\n\t\t\tGROUP BY smcreatorid,DAY(sendlog_workdate)\r\n\t\t) b ON a.id=b.smcreatorid\r\n\t\tINNER JOIN (\r\n\t\t\tSELECT DISTINCT\r\n\t\t\t\tuserid \r\n\t\t\tFROM (\r\n\t\t\t\tSELECT \r\n\t\t\t\t\tld_users.id AS userid \r\n\t\t\t\tFROM ld_users\r\n\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='CooperativeWork' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT \r\n\t\t\t\t\tviewid AS userid \r\n\t\t\t\tFROM ld_scoperhigher\r\n\t\t\t\tWHERE userid='[uuid]' AND modulename='CooperativeWork' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename='CooperativeWork')\t\t\t\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT DISTINCT \r\n\t\t\t\t\tld_users2group.userid AS userid \r\n\t\t\t\tFROM ld_scoperhigher \r\n\t\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\t\tAND ld_scoperhigher.modulename='CooperativeWork'\r\n\t\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='CooperativeWork' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\t\tUNION \r\n\t\t\t\tSELECT \r\n\t\t\t\t\tid AS userid \r\n\t\t\t\tFROM ld_users  \r\n\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT '[uuid]') AS vw_users\r\n\t\t) AS tmp_users ON tmp_users.userid=a.id\r\n\t\tINNER JOIN (\r\n\t\t\tSELECT\r\n\t\t\t\ta.userid,\r\n\t\t\t\tb.parentgroup\r\n\t\t\tFROM ld_users2group a\r\n\t\t\tLEFT JOIN ld_groups b ON a.groupid=b.groupid\r\n\t\t\tWHERE (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{bumen}'='' THEN 1=1\r\n\t\t\t\t\tWHEN '{bumen}'>0 AND '{bumen}' NOT LIKE '%,%' THEN a.groupid='{bumen}' OR LOCATE((SELECT CONCAT(parentgroup,'::') FROM ld_groups WHERE groupid='{bumen}'),b.parentgroup) \r\n\t\t\t\t\tELSE FIND_IN_SET(a.groupid,'{bumen}')\r\n\t\t\t\tEND)\r\n\t\t\tGROUP BY a.userid\r\n\t\t) tmp_groups ON tmp_groups.userid=a.id\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.`status`='Active'\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{userid}'='' THEN 1=1\r\n\t\t\t\t\tELSE FIND_IN_SET(a.id,'{userid}')\r\n\t\t\t\tEND)\r\n\t\t) workreport\r\n\tGROUP BY id\r\n) tmp\r\nORDER BY CONVERT(last_name USING GBK)"
      }
    },
