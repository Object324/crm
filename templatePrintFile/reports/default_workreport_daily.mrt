\r\n\tW20,\r\n\tW21,\r\n\tW22,\r\n\tW23,\r\n\tW24,\r\n\tW25,\r\n\tW26,\r\n\tW27,\r\n\tW28,\r\n\tW29,\r\n\tW30,\r\n\tW31,\r\n\tIF(D1>=1,1,0)+IF(D2>=1,1,0)+IF(D3>=1,1,0)+IF(D4>=1,1,0)+IF(D5>=1,1,0)+IF(D6>=1,1,0)+IF(D7>=1,1,0)+IF(D8>=1,1,0)+IF(D9>=1,1,0)+IF(D10>=1,1,0)+IF(D11>=1,1,0)+IF(D12>=1,1,0)+IF(D13>=1,1,0)+IF(D14>=1,1,0)+IF(D15>=1,1,0)+IF(D16>=1,1,0)+IF(D17>=1,1,0)+IF(D18>=1,1,0)+IF(D19>=1,1,0)+IF(D20>=1,1,0)+IF(D21>=1,1,0)+IF(D22>=1,1,0)+IF(D23>=1,1,0)+IF(D24>=1,1,0)+IF(D25>=1,1,0)+IF(D26>=1,1,0)+IF(D27>=1,1,0)+IF(D28>=1,1,0)+IF(D29>=1,1,0)+IF(D30>=1,1,0)+IF(D31>=1,1,0) AS sub_days,\r\n\tCASE\r\n\t\tWHEN DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','1'),'%Y-%m-%d')>DATE_FORMAT(CONCAT(YEAR(CURDATE()),'-',MONTH(CURDATE()),'-','1'),'%Y-%m-%d') THEN 0\r\n\t\tWHEN DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','1'),'%Y-%m-%d')=DATE_FORMAT(CONCAT(YEAR(CURDATE()),'-',MONTH(CURDATE()),'-','1'),'%Y-%m-%d') THEN \r\n\t\t\tDAY(CURDATE())-(IF(D1>=1,1,0)+IF(D2>=1,1,0)+IF(D3>=1,1,0)+IF(D4>=1,1,0)+IF(D5>=1,1,0)+IF(D6>=1,1,0)+IF(D7>=1,1,0)+IF(D8>=1,1,0)+IF(D9>=1,1,0)+IF(D10>=1,1,0)+IF(D11>=1,1,0)+IF(D12>=1,1,0)+IF(D13>=1,1,0)+IF(D14>=1,1,0)+IF(D15>=1,1,0)+IF(D16>=1,1,0)+IF(D17>=1,1,0)+IF(D18>=1,1,0)+IF(D19>=1,1,0)+IF(D20>=1,1,0)+IF(D21>=1,1,0)+IF(D22>=1,1,0)+IF(D23>=1,1,0)+IF(D24>=1,1,0)+IF(D25>=1,1,0)+IF(D26>=1,1,0)+IF(D27>=1,1,0)+IF(D28>=1,1,0)+IF(D29>=1,1,0)+IF(D30>=1,1,0)+IF(D31>=1,1,0))\r\n\t\tELSE\r\n\t\t\tDAY(LAST_DAY(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','1'),'%Y-%m-%d')))-(IF(D1>=1,1,0)+IF(D2>=1,1,0)+IF(D3>=1,1,0)+IF(D4>=1,1,0)+IF(D5>=1,1,0)+IF(D6>=1,1,0)+IF(D7>=1,1,0)+IF(D8>=1,1,0)+IF(D9>=1,1,0)+IF(D10>=1,1,0)+IF(D11>=1,1,0)+IF(D12>=1,1,0)+IF(D13>=1,1,0)+IF(D14>=1,1,0)+IF(D15>=1,1,0)+IF(D16>=1,1,0)+IF(D17>=1,1,0)+IF(D18>=1,1,0)+IF(D19>=1,1,0)+IF(D20>=1,1,0)+IF(D21>=1,1,0)+IF(D22>=1,1,0)+IF(D23>=1,1,0)+IF(D24>=1,1,0)+IF(D25>=1,1,0)+IF(D26>=1,1,0)+IF(D27>=1,1,0)+IF(D28>=1,1,0)+IF(D29>=1,1,0)+IF(D30>=1,1,0)+IF(D31>=1,1,0))\r\n\tEND AS no_days\r\nFROM (\r\n\tSELECT\r\n\t\tid,\r\n\t\tlast_name,\r\n\t\tMAX(D1) AS D1,\r\n\t\tMAX(D2) AS D2,\r\n\t\tMAX(D3) AS D3,\r\n\t\tMAX(D4) AS D4,\r\n\t\tMAX(D5) AS D5,\r\n\t\tMAX(D6) AS D6,\r\n\t\tMAX(D7) AS D7,\r\n\t\tMAX(D8) AS D8,\r\n\t\tMAX(D9) AS D9,\r\n\t\tMAX(D10) AS D10,\r\n\t\tMAX(D11) AS D11,\r\n\t\tMAX(D12) AS D12,\r\n\t\tMAX(D13) AS D13,\r\n\t\tMAX(D14) AS D14,\r\n\t\tMAX(D15) AS D15,\r\n\t\tMAX(D16) AS D16,\r\n\t\tMAX(D17) AS D17,\r\n\t\tMAX(D18) AS D18,\r\n\t\tMAX(D19) AS D19,\r\n\t\tMAX(D20) AS D20,\r\n\t\tMAX(D21) AS D21,\r\n\t\tMAX(D22) AS D22,\r\n\t\tMAX(D23) AS D23,\r\n\t\tMAX(D24) AS D24,\r\n\t\tMAX(D25) AS D25,\r\n\t\tMAX(D26) AS D26,\r\n\t\tMAX(D27) AS D27,\r\n\t\tMAX(D28) AS D28,\r\n\t\tMAX(D29) AS D29,\r\n\t\tMAX(D30) AS D30,\r\n\t\tMAX(D31) AS D31,\r\n\r\n\t\tW1,\r\n\t\tW2,\r\n\t\tW3,\r\n\t\tW4,\r\n\t\tW5,\r\n\t\tW6,\r\n\t\tW7,\r\n\t\tW8,\r\n\t\tW9,\r\n\t\tW10,\r\n\t\tW11,\r\n\t\tW12,\r\n\t\tW13,\r\n\t\tW14,\r\n\t\tW15,\r\n\t\tW16,\r\n\t\tW17,\r\n\t\tW18,\r\n\t\tW19,\r\n\t\tW20,\r\n\t\tW21,\r\n\t\tW22,\r\n\t\tW23,\r\n\t\tW24,\r\n\t\tW25,\r\n\t\tW26,\r\n\t\tW27,\r\n\t\tW28,\r\n\t\tW29,\r\n\t\tW30,\r\n\t\tW31,\r\n\r\n\t\tL1,\r\n\t\tL2,\r\n\t\tL3,\r\n\t\tL4,\r\n\t\tL5,\r\n\t\tL6,\r\n\t\tL7,\r\n\t\tL8,\r\n\t\tL9,\r\n\t\tL10,\r\n\t\tL11,\r\n\t\tL12,\r\n\t\tL13,\r\n\t\tL14,\r\n\t\tL15,\r\n\t\tL16,\r\n\t\tL17,\r\n\t\tL18,\r\n\t\tL19,\r\n\t\tL20,\r\n\t\tL21,\r\n\t\tL22,\r\n\t\tL23,\r\n\t\tL24,\r\n\t\tL25,\r\n\t\tL26,\r\n\t\tL27,\r\n\t\tL28,\r\n\t\tL29,\r\n\t\tL30,\r\n\t\tL31\r\n\r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\ta.id,\r\n\t\t\t(case when left(database(),2)='wx' and right(database(),5)+0>10000 and IFNULL(a.real_name,'')<>'' then a.real_name else a.last_name end )as last_name,\r\n\t\t\tCASE \r\n\t\t\t\tWHEN b.reportdate=DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','1'),'%Y-%m-%d') AND b.reportdate=b.adddate THEN 1 \r\n\t\t\t\tWHEN b.reportdate=DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','1'),'%Y-%m-%d') AND b.reportdate<>b.adddate THEN 2\r\n\t\t\t\tELSE 0 \r\n\t\t\tEND AS D1,\r\n\t\t\tCASE \r\n\t\t\t\tWHEN b.reportdate=DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','1'),'%Y-%m-%d'),INTERVAL 1 DAY) AND b.reportdate=b.adddate THEN 1 \r\n\t\t\t\tWHEN b.reportdate=DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','1'),'%Y-%m-%d'),INTERVAL 1 DAY) AND b.reportdate<>b.adddate THEN 2 \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND AS D2,\r\n\t\t\tCASE \r\n\t\t\t\tWHEN b.reportdate=DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','1'),'%Y-%m-%d'),INTERVAL 2 DAY) AND b.reportdate=b.adddate THEN 1 \r\n\t\t\t\tWHEN b.reportdate=DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','1'),'%Y-%m-%d'),INTERVAL 2 DAY) AND b.reportdate<>b.adddate THEN 2 \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND AS D3,\r\n\t\t\tCASE \r\n\t\t\t\tWHEN b.reportdate=DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','1'),'%Y-%m-%d'),INTERVAL 3 DAY) AND b.reportdate=b.adddate THEN 1 \r\n\t\t\t\tWHEN b.reportdate=DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','1'),'%Y-%m-%d'),INTERVAL 3 DAY) AND b.reportdate<>b.adddate THEN 2 \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND AS D4,\r\n\t\t\tCASE \r\n\t\t\t\tWHEN b.reportdate=DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','1'),'%Y-%m-%d'),INTERVAL 4 DAY) AND b.reportdate=b.adddate THEN 1 \r\n\t\t\t\tWHEN b.reportdate=DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','1'),'%Y-%m-%d'),INTERVAL 4 DAY) AND b.reportdate<>b.adddate THEN 2 \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND AS D5,\r\n\t\t\tCASE \r\n\t\t\t\tWHEN b.reportdate=DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','1'),'%Y-%m-%d'),INTERVAL 5 DAY) AND b.reportdate=b.adddate THEN 1 \r\n\t\t\t\tWHEN b.reportdate=DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','1'),'%Y-%m-%d'),INTERVAL 5 DAY) AND b.reportdate<>b.adddate THEN 2 \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND AS D6,\r\n\t\t\tCASE \r\n\t\t\t\tWHEN b.reportdate=DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','1'),'%Y-%m-%d'),INTERVAL 6 DAY) AND b.reportdate=b.adddate THEN 1 \r\n\t\t\t\tWHEN b.reportdate=DATE_ADD(DATE_FORMAT(CONCAT('{nian}',