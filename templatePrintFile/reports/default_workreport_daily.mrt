        "NameInSource": "ldcrm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\tlast_name,\r\n\tCASE\r\n\t\tWHEN STR_TO_DATE(CONCAT('{nian}','-','{yue}','-','1'),'%Y-%m-%d')<=CURDATE() AND D1=1 THEN '√'\r\n\t\tWHEN STR_TO_DATE(CONCAT('{nian}','-','{yue}','-','1'),'%Y-%m-%d')<=CURDATE() AND D1=0 THEN IF((SELECT SUM(costtime) FROM ld_minusjobbill x LEFT JOIN ld_minusjobbilldetail y ON y.id=x.minusjobbillid WHERE x.deleted=0 AND x.smownerid=tmp.id AND STR_TO_DATE(CONCAT('{nian}','-','{yue}','-','1'),'%Y-%m-%d') BETWEEN DATE_FORMAT(y.starttime,'%Y-%m-%d 00:00:00') AND y.endtime)>=8,'休','×')\r\n\t\tWHEN STR_TO_DATE(CONCAT('{nian}','-','{yue}','-','1'),'%Y-%m-%d')<=CURDATE() AND D1=2 THEN '补'\r\n\t\tELSE ''\r\n\tEND AS D1,\r\n\tCASE\r\n\t\tWHEN DATE_ADD(STR_TO_DATE(CONCAT('{nian}','-','{yue}','-','1'),'%Y-%m-%d'),INTERVAL 1 DAY)<=CURDATE() AND D2=1 THEN '√'\r\n\t\tWHEN DATE_ADD(STR_TO_DATE(CONCAT('{nian}','-','{yue}','-','1'),'%Y-%m-%d'),INTERVAL 1 DAY)<=CURDATE() AND D2=0 THEN IF((SELECT SUM(costtime) FROM ld_minusjobbill x LEFT JOIN ld_minusjobbilldetail y ON y.id=x.minusjobbillid WHERE x.deleted=0 AND x.smownerid=tmp.id AND DATE_ADD(STR_TO_DATE(CONCAT('{nian}','-','{yue}','-','1'),'%Y-%m-%d'),INTERVAL 1 DAY) BETWEEN DATE_FORMAT(y.starttime,'%Y-%m-%d 00:00:00') AND y.endtime)>=8,'休','×')\r\n\t\tWHEN DATE_ADD(STR_TO_DATE(CONCAT('{nian}','-','{yue}','-','1'),'%Y-%m-%d'),INTERVAL 1 DAY)<=CURDATE() AND D2=2 THEN '补'\r\n\t\tELSE ''\r\n\tEND AS D2,\r\n\tCASE\r\n\t\tWHEN DATE_ADD(STR_TO_DATE(CONCAT('{nian}','-','{yue}','-','1'),'%Y-%m-%d'),INTERVAL 2 DAY)<=CURDATE() AND D3=1 THEN '√'\r\n\t\tWHEN DATE_ADD(STR_TO_DATE(CONCAT('{nian}','-','{yue}','-','1'),'%Y-%m-%d'),INTERVAL 2 DAY)<=CURDATE() AND D3=0 THEN IF((SELECT SUM(costtime) FROM ld_minusjobbill x LEFT JOIN ld_minusjobbilldetail y ON y.id=x.minusjobbillid WHERE x.deleted=0 AND x.smownerid=tmp.id AND DATE_ADD(STR_TO_DATE(CONCAT('{nian}','-','{yue}','-','1'),'%Y-%m-%d'),INTERVAL 2 DAY) BETWEEN DATE_FORMAT(y.starttime,'%Y-%m-%d 00:00:00') AND y.endtime)>=8,'休','×')\r\n\t\tWHEN DATE_ADD(STR_TO_DATE(CONCAT('{nian}','-','{yue}','-','1'),'%Y-%m-%d'),INTERVAL 2 DAY)<=CURDATE() AND D3=2 THEN '补'\r\n\t\tELSE ''\r\n\tEND AS D3,\r\n\tCASE\r\n\t\tWHEN DATE_ADD(STR_TO_DATE(CONCAT('{nian}','-','{yue}','-','1'),'%Y-%m-%d'),INTERVAL 3 DAY)<=CURDATE() AND D4=1 THEN '√'\r\n\t\tWHEN DATE_ADD(STR_TO_DATE(CONCAT('{nian}','-','{yue}','-','1'),'%Y-%m-%d'),INTERVAL 3 DAY)<=CURDATE() AND D4=0 THEN IF((SELECT SUM(costtime) FROM ld_minusjobbill x LEFT JOIN ld_minusjobbilldetail y ON y.id=x.minusjobbillid WHERE x.deleted=0 AND x.smownerid=tmp.id AND DATE_ADD(STR_TO_DATE(CONCAT('{nian}','-','{yue}','-','1'),'%Y-%m-%d'),INTERVAL 3 DAY) BETWEEN DATE_FORMAT(y.starttime,'%Y-%m-%d 00:00:00') AND y.endtime)>=8,'休','×')\r\n\t\tWHEN DATE_ADD(STR_TO_DATE(CONCAT('{nian}','-','{yue}','-','1'),'%Y-%m-%d'),INTERVAL 3 DAY)<=CURDATE() AND D4=2 THEN '补'\r\n\t\tELSE ''\r\n\tEND AS D4,\r\n\tCASE\r\n\t\tWHEN DATE_ADD(STR_TO_DATE(CONCAT('{nian}','-','{yue}','-','1'),'%Y-%m-%d'),INTERVAL 4 DAY)<=CURDATE() AND D5=1 THEN '√'\r\n\t\tWHEN DATE_ADD(STR_TO_DATE(CONCAT('{nian}','-','{yue}','-','1'),'%Y-%m-%d'),INTERVAL 4 DAY)<=CURDATE() AND D5=0 THEN IF((SELECT SUM(costtime) FROM ld_minusjobbill x LEFT JOIN ld_minusjobbilldetail y ON y.id=x.minusjobbillid WHERE x.deleted=0 AND x.smownerid=tmp.id AND DATE_ADD(STR_TO_DATE(CONCAT('{nian}','-','{yue}','-','1'),'%Y-%m-%d'),INTERVAL 4 DAY) BETWEEN DATE_FORMAT(y.starttime,'%Y-%m-%d 00:00:00') AND y.endtime)>=8,'休','×')\r\n\t\tWHEN DATE_ADD(STR_TO_DATE(CONCAT('{nian}','-','{yue}','-','1'),'%Y-%m-%d'),INTERVAL 4 DAY)<=CURDATE() AND D5=2 THEN '补'\r\n\t\tELSE ''\r\n\tEND AS D5,\r\n\tCASE\r\n\t\tWHEN DATE_ADD(STR_TO_DATE(CONCAT('{nian}','-','{yue}','-','1'),'%Y-%m-%d'),INTERVAL 5 DAY)<=CURDATE() AND D6=1 THEN '√'\r\n\t\tWHEN DATE_ADD(STR_TO_DATE(CONCAT('{nian}','-','{yue}','-','1'),'%Y-%m-%d'),INTERVAL 5 DAY)<=CURDATE() AND D6=0 THEN IF((SELECT SUM(costtime) FROM ld_minusjobbill x LEFT JOIN ld_minusjobbilldetail y ON y.id=x.minusjobbillid WHERE x