        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\te.projectname,\r\n\tb.purchaseorderid AS id,\r\n\tb.purchaseorder_no,\r\n\tk.vendorname,\r\n\tb.duedate,\r\n\tROUND(b.total/IF(IFNULL(b.conversion_rate,0)=0,1,b.conversion_rate),2) AS total,\r\n\tCASE\r\n\t\tWHEN c.sequence_no=1 THEN ROUND(b.total/IF(IFNULL(b.conversion_rate,0)=0,1,b.conversion_rate),2)\r\n\t\tELSE 0\r\n\tEND AS sum_total,\r\n\tu.last_name,\r\n\tp.productname,\r\n\tROUND(c.tax_amount/IF(IFNULL(b.conversion_rate,0)=0,1,b.conversion_rate),2) AS tax_amount\r\nFROM ld_purchaseorder b\r\nLEFT JOIN ld_purchaseorderdetail c ON c.id=b.purchaseorderid\r\nLEFT JOIN ld_vendor k ON k.vendorid=b.vendorid\r\nLEFT JOIN ld_products p ON p.productid=c.productid\r\nLEFT JOIN ld_users u ON u.id=b.smownerid\r\nLEFT JOIN ld_project e ON e.projectid=b.projectid\r\nWHERE b.deleted=0\r\n\tAND b.approvestatus<>'已拒绝'\r\n\tAND b.contracttype='分包'\r\n\tAND b.projectid>0\r\n\tAND b.projectid='{this[\"id\"]}'\r\nORDER BY b.duedate,b.purchaseorder_no,b.purchaseorderid,c.sequence_no"
