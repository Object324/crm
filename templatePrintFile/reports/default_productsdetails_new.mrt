            "Index": -1,
            "NameInSource": "total_purchaseback",
            "Alias": "total_purchaseback",
            "Type": "System.String"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\ta.projectid AS id,\r\n\ta.projectname,\r\n\ta.accountname,\r\n\ta.project_no,\r\n\ta.total_order,\r\n\ta.total_ordercash,\r\n\ta.total_orderinvoice,\r\n\ta.total_cailiao,\r\n\ta.total_fenbao,\r\n\ta.total_laowu,\r\n\ta.total_zuling,\r\n\ta.total_exec,\r\n\ta.total_comm,\r\n\ta.tax_fee,\r\n\ta.total_purchaseback,\r\n\t(a.total_cost+a.tax_fee)as total_cost,\r\n\t(IFNULL(a.total_order,0)-IFNULL(a.total_cost,0)-IFNULL(a.tax_fee,0)) AS maoli,\r\n\t((IFNULL(a.total_order,0)-IFNULL(a.total_cost,0)-IFNULL(a.tax_fee,0))/(a.total_cost+a.tax_fee)) AS rate,\r\n\t(IFNULL(a.total_ordercash,0)-IFNULL(a.total_cost,0)-IFNULL(a.tax_fee,0)) AS maoli1,\r\n\t((IFNULL(a.total_ordercash,0)-IFNULL(a.total_cost,0)-IFNULL(a.tax_fee,0))/(a.total_cost+a.tax_fee)) AS rate1\r\nFROM (\r\n\tSELECT\r\n\t\ta.projectid,\r\n\t\ta.projectname,\r\n\t\taccount.accountname,\r\n\t\ta.project_no,\r\n\t\tROUND(ifnull(b.total_order,0),2) AS total_order,\r\n\t\tROUND(ifnull(b.total_ordercash,0),2) AS total_ordercash,\r\n\t\tROUND(ifnull(b.total_orderinvoice,0),2) AS total_orderinvoice,\r\n\t\tROUND(ifnull(i.cailiao,0),2) AS total_cailiao,\r\n\t\tROUND(ifnull(i.fenbao,0),2) AS total_fenbao,\r\n\t\tROUND(ifnull(i.laowu,0),2) AS total_laowu,\r\n\t\tROUND(ifnull(i.zuling,0),2) AS total_zuling,\r\n\t\tROUND(IFNULL(d.total_exec,0),2) AS total_exec,\r\n\t\tROUND(IFNULL(j.total_comm,0),2) AS total_comm,\r\n\t\tROUND(IFNULL(k.total_purchaseback,0),2) AS total_purchaseback,\r\n\t\tROUND(IFNULL(ROUND(b.total_order,2),0)*0.01*('{rate}'+0),2) AS tax_fee,\r\n\t\tROUND(IFNULL(i.cailiao,0)+IFNULL(i.fenbao,0)+IFNULL(i.laowu,0)+IFNULL(i.zuling,0)+IFNULL(d.total_exec,0)- IFNULL(k.total_purchaseback,0),2) AS total_cost\r\n\tFROM ld_project a\r\n\tLEFT JOIN ld_account account on account.accountid=a.accountid\r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\tb.projectid AS projectid,\r\n\t\t\tSUM(b.total/IF(IFNULL(b.conversion_rate,0)=0,1,b.conversion_rate)) AS total_order,\r\n\t\t\tSUM(b.received_amount/IF(IFNULL(b.conversion_rate,0)=0,1,b.conversion_rate)) AS total_ordercash,\r\n\t\t\tSUM(b.have_invoicetotal/IF(IFNULL(b.conversion_rate,0)=0,1,b.conversion_rate)) AS total_orderinvoice\r\n\t\tFROM ld_salesorder b\r\n\t\tWHERE b.deleted=0\r\n\t\t\tAND b.approvestatus<>'已驳回'\r\n\t\t\tAND IFNULL(b.sostatus,'')<>'已作废'\r\n\t\t\tAND b.projectid>0\r\n\t\tGROUP BY b.projectid\r\n\t) b ON b.projectid=a.projectid\r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\tSUM(a.total/IF(IFNULL(a.conversion_rate,0)=0,1,a.conversion_rate)) AS total_exec,\r\n\t\t\ta.projectid\r\n\t\tFROM ld_expense a\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus<>'已驳回'\r\n\t\t\tAND a.projectid>0\r\n\t\tGROUP BY a.projectid\r\n\t) d ON d.projectid=a.projectid\r\n\tLEFT JOIN (\r\n\t\tSELECT \r\n\t\t\tprojectid,\r\n\t\t\tsum(case when sendcashbill_type=\"材料\" then total_cost else 0 end) as cailiao,\r\n\t\t\tsum(case when sendcashbill_type=\"分包\" then total_cost else 0 end) as fenbao,\r\n\t\t\tsum(case when sendcashbill_type=\"劳务\" then total_cost else 0 end) as laowu,\r\n\t\t\tsum(case when sendcashbill_type=\"租赁\" then total_cost else 0 end) as zuling\r\n\t\t\tFROM (\r\n\t\t\t\tSELECT\r\n\t\t\t\t\t\ta.projectid,\r\n\t\t\t\t\t\tSUM(a.Total/IF(IFNULL(a.conversion_rate,0)=0,1,a.conversion_rate)) AS total_cost,a.sendcashbill_type\r\n\t\t\t\tFROM ld_sendcashbill a\r\n\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\tAND a.approvestatus<>'已驳回'\r\n\t\t\t\t\tAND a.projectid>0\r\n\t\t\t\tGROUP BY a.projectid,a.sendcashbill_type\r\n\t\t)a \r\n\t\tGROUP BY a.projectid\r\n\t) i on i.projectid = a.projectid\r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\ta.crmid AS projectid,\r\n\t\t\tSUM(commp.amount/IF(IFNULL(comm.conversion_rate,0)=0,1,comm.conversion_rate)) AS total_comm\r\n\t\tFROM ld_crmentityrel a\r\n\t\tINNER JOIN ld_commission2payment commp on commp.entitytypeid=a.relcrmid\r\n\t\tLEFT JOIN ld_commission comm on comm.commission_id=commp.commission_id\r\n\t\tWHERE a.module='Project'\r\n\t\t\tAND a.relmodule='SalesOrder'\r\n\t\t\tAND comm.deleted=0\r\n\t\t\tAND comm.approvestatus<>'已驳回'\r\n\t\t\tAND comm.entitytype='SalesOrder'\r\n\t\tGROUP BY a.crmid\r\n) j on j.projectid = a.projectid \r\nLEFT JOIN (\r\n\tSELECT\r\n\t\tb.projectid AS projectid,\r\n\t\tSUM(c.total /IF (IFNULL(c.conversion_rate, 0) = 0,1,c.conversion_rate)) AS total_purchaseback\r\n\tFROM ld_purchaseorder b\r\n\tINNER JOIN ld_purchaseback c ON c.purchaseorder_id = b.purchaseorderid\r\n\tWHERE b.deleted = 0\r\n\t\tAND b.approvestatus <> '已驳回'  \r\n\t\tGROUP BY b.projectid\r\n) k on k.projectid=a.projectid\r\nWHERE a.deleted=0\r\n\t\tAND projectstatus IN ('调研','开始','进行中','等待答复','搁置')\r\n\t\tAND a.approvestatus<>'已驳回'\r\n) a"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "list_users",
        "Alias": "list_users",
        "Columns": {
          "0": {
            "Name": "list_order",
            "Index": -1,
            "NameInSource": "list_order",
            "Alias": "list_order",
            "Type": "System.String"
          },
          "1": {
            "Name": "listid",
            "Index": -1,
            "NameInSource": "listid",
            "Alias": "listid",
            "Type": "System.Int32"
          },
          "2": {
            "Name": "listtype",
            "Index": -1,
            "NameInSource": "listtype",
            "Alias": "listtype",
            "Type": "System.Int32"
          },
          "3": {
            "Name": "listvalue",
            "Index": -1,
            "NameInSource": "listvalue",
            "Alias": "listvalue",
            "Type": "System.String"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT 1 AS listid,'全部' AS listvalue,0 AS list_order,1 AS listtype\r\nUNION\r\nSELECT 2 AS listid, '我负责的' AS listvalue,0 AS list_order,2 AS listtype\r\nUNION (\r\n\tSELECT\r\n\t\ta.groupid+200000 AS listid,\r\n\t\tCONCAT('部门::',IFNULL(a.groupname,'')) AS listvalue,\r\n\t\tGROUP_CONCAT(IFNULL(a.splitsting,'') ORDER BY a.splitsting SEPARATOR '::') AS listorder,\r\n\t\t1 AS listtype\r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\ta.groupid, \r\n\t\t\ta.groupname, \r\n\t\t\tLPAD(substring_index(substring_index(a.splitsting,',',b.seq+1),',',-1),8,'0') AS splitsting\r\n\t\tFROM (\r\n\t\t\tSELECT \r\n\t\t\t\ta.groupid,\r\n\t\t\t\ta.groupname, \r\n\t\t\t\tREPLACE(a.parentgroup,'::',',') AS splitsting \r\n\t\t\tFROM ld_groups a\r\n\t\t\tLEFT JOIN ld_users2group b ON b.groupid=a.groupid\r\n\t\t\tGROUP BY a.groupid\r\n\t\t) a \r\n\t\tLEFT JOIN sequence b ON b.seq < (length(a.splitsting) - length(replace(a.splitsting,',',''))+1)\r\n\t) a\r\n\tGROUP BY a.groupid\r\n)\r\nUNION (\r\n\tSELECT\r\n\t\ta.id+300000 AS listid,\r\n\t\tCONCAT('用户::',IFNULL(a.last_name,''),'(',c.listvalue,')') AS listvalue,\r\n\t\tc.listorder,\r\n\t\t2 AS listtype\r\n\tFROM ld_users a\r\n\tLEFT JOIN ld_users2group b ON b.userid=a.id  \r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\ta.groupid,\r\n\t\t\ta.groupid+200000 AS listid,\r\n\t\t\tCONCAT('部门::',IFNULL(a.groupname,'')) AS listvalue,\r\n\t\t\tGROUP_CONCAT(IFNULL(a.splitsting,'') ORDER BY a.splitsting SEPARATOR '::') AS listorder\r\n\t\tFROM (\r\n\t\t\tSELECT \r\n\t\t\t\ta.groupid, \r\n\t\t\t\ta.groupname, \r\n\t\t\t\tLPAD(substring_index(substring_index(a.splitsting,',',b.seq+1),',',-1),8,'0') AS splitsting\r\n\t\t\tFROM (\r\n\t\t\t\tSELECT \r\n\t\t\t\t\ta.groupid,\r\n\t\t\t\t\ta.groupname, \r\n\t\t\t\t\tREPLACE(a.parentgroup,'::',',') AS splitsting \r\n\t\t\t\tFROM ld_groups a\r\n\t\t\t\tLEFT JOIN ld_users2group b ON b.groupid=a.groupid\r\n\t\t\t\tGROUP BY a.groupid\r\n\t\t\t) a \r\n\t\t\tLEFT JOIN sequence b ON b.seq < (length(a.splitsting) - length(replace(a.splitsting,',',''))+1)\r\n\t\t) a\r\n\t\tGROUP BY a.groupid\r\n\t) c ON c.groupid=b.groupid\r\n\tINNER JOIN (\r\n\t\tSELECT DISTINCT\r\n\t\t\tuserid \r\n\t\tFROM (\r\n\t\t\tSELECT \r\n\t\t\t\tld_users.id AS userid \r\n\t\t\tFROM ld_users\r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Project' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\tUNION\r\n\t\t\tSELECT \r\n\t\t\t\tviewid AS userid \r\n\t\t\tFROM ld_scoperhigher\r\n\t\t\tWHERE userid='[uuid]' AND modulename ='Project' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename ='Project')\t\t\t\r\n\t\t\tUNION\r\n\t\t\tSELECT DISTINCT \r\n\t\t\t\tld_users2group.userid AS userid \r\n\t\t\tFROM ld_scoperhigher \r\n\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\tAND ld_scoperhigher.modulename ='Project'\r\n\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Project' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\tUNION \r\n\t\t\tSELECT \r\n\t\t\t\tid AS userid \r\n\t\t\tFROM ld_users  \r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\tUNION\r\n\t\t\tSELECT '[uuid]') AS vw_users\r\n\t) AS tmp_users ON tmp_users.userid=a.id\r\n\tWHERE a.deleted=0\r\n\t\tAND a.`status`='Active'\r\n)\r\nORDER BY list_order,listtype"
      },
