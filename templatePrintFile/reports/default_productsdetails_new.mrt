            "Alias": "total_ordercash",
            "Type": "System.Decimal"
          },
          "17": {
            "Name": "total_orderinvoice",
            "Index": -1,
            "NameInSource": "total_orderinvoice",
            "Alias": "total_orderinvoice",
            "Type": "System.Decimal"
          },
          "18": {
            "Name": "total_zuling",
            "Index": -1,
            "NameInSource": "total_zuling",
            "Alias": "total_zuling",
            "Type": "System.String"
          },
          "19": {
