        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\tb.projectid AS projectid,\r\n\tcashbill.cashbill_no,\r\n\tcashbill.cashbill_type,\r\n\taccount.accountname,\r\n\tcashbill.total,\r\n\tu.last_name,\r\n\tcashbill.bankaccountsetid,\r\n\tcashbill.cashtype,\r\n\tcashbill.approvestatus,\r\n\tcashbill.modifiedtime,\r\n\tcashbill.createdtime,\r\n\tb.salesorder_no\r\nFROM ld_salesorder b\r\nleft join ld_cashbill cashbill on cashbill.source_list = b.salesorderid\r\nleft join ld_account account on account.accountid=b.accountid\r\nleft join ld_users u on u.id=cashbill.smownerid\r\nWHERE b.deleted=0\r\n\tAND b.approvestatus<>'已拒绝' \r\n\tAND cashbill.cashbillid>0\r\n\tAND IFNULL(b.sostatus,'')<>'已作废' \r\n\tAND b.projectid>0\r\n\tAND b.projectid = '{this[\"id\"]}'\r\nGROUP BY cashbill.cashbill_no"
      },
