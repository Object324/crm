        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\tb.projectid AS projectid,\r\n\tinvoice.invoice_no,\r\n\taccount.accountname,\r\n\tinvoice.total,\r\n\tu.last_name,\r\n\tinvoice.received_amount,\r\n\tscf.invoicetype,\r\n\tinvoice.approvestatus,\r\n\tinvoice.invoicedate,\r\n\tinvoice.receivable_balance,\r\n\tinvoice.subtotal,\r\n\tinvoice.adjustment,\r\n\tinvoice.discount_amount,\r\n\tb.salesorder_no\r\nFROM ld_salesorder b\r\nleft join ld_invoice invoice on invoice.source_list = b.salesorderid\r\nleft join ld_invoicecf scf on scf.invoiceid = invoice.invoiceid\r\nleft join ld_account account on account.accountid=b.accountid\r\nleft join ld_users u on u.id=invoice.smownerid\r\nWHERE b.deleted=0\r\n\tAND b.approvestatus<>'已拒绝' \r\n\tAND invoice.invoiceid>0\r\n\tAND IFNULL(b.sostatus,'')<>'已作废' \r\n\tAND b.projectid>0\r\n\tAND b.projectid = '{this[\"id\"]}'\r\nGROUP BY invoice.invoice_no"
      }
    },
    "Databases": {
      "0": {
        "Ident": "StiMySqlDatabase",
        "Name": "crm",
        "Alias": "crm",
        "ConnectionStringEncrypted": "40Kby8MKMc1iSaX0a5xqO9XWd2DLWQGk40qhmGIEImbKcHOvyEv79UJBtcDkBWI/3njdCE5MqcVpWu2J5BX2ft/EU8tDCvOZ4B0pgU0d8mPEVtHCyU5LhUVM3axhtPZ70tDNy2cFm9VNS6yt5CA1Z4HeZcLEVZPwbR/l"
      }
    }
  },
