        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\te.projectname,\r\n\tb.salesorderid AS id,\r\n\tb.salesorder_no,\r\n\tk.accountname,\r\n\tb.signed_data,\r\n\tb.duedate,\r\n\tROUND(b.total/IF(IFNULL(b.conversion_rate,0)=0,1,b.conversion_rate),2) AS total,\r\n\tROUND(b.received_amount/IF(IFNULL(b.conversion_rate,0)=0,1,b.conversion_rate),2) AS received_amount,\r\n\tROUND(b.receivable_balance/IF(IFNULL(b.conversion_rate,0)=0,1,b.conversion_rate),2) AS receivable_balance,\r\n\tROUND(b.have_invoicetotal/IF(IFNULL(b.conversion_rate,0)=0,1,b.conversion_rate),2) AS have_invoicetotal,\r\n\tROUND(b.nothave_invoicetotal/IF(IFNULL(b.conversion_rate,0)=0,1,b.conversion_rate),2) AS nothave_invoicetotal,\r\n\tCASE\r\n\t\tWHEN c.sequence_no=1 THEN ROUND(b.total/IF(IFNULL(b.conversion_rate,0)=0,1,b.conversion_rate),2)\r\n\t\tELSE 0\r\n\tEND AS sum_total,\r\n\tCASE\r\n\t\tWHEN c.sequence_no=1 THEN ROUND(b.received_amount/IF(IFNULL(b.conversion_rate,0)=0,1,b.conversion_rate),2)\r\n\t\tELSE 0\r\n\tEND AS sum_cashtotal,\r\n\tCASE\r\n\t\tWHEN c.sequence_no=1 THEN ROUND(b.receivable_balance/IF(IFNULL(b.conversion_rate,0)=0,1,b.conversion_rate),2)\r\n\t\tELSE 0\r\n\tEND AS sum_nocashtotal,\r\n\tCASE\r\n\t\tWHEN c.sequence_no=1 THEN ROUND(b.have_invoicetotal/IF(IFNULL(b.conversion_rate,0)=0,1,b.conversion_rate),2)\r\n\t\tELSE 0\r\n\tEND AS sum_fapiaototal,\r\n\tCASE\r\n\t\tWHEN c.sequence_no=1 THEN ROUND(b.nothave_invoicetotal/IF(IFNULL(b.conversion_rate,0)=0,1,b.conversion_rate),2)\r\n\t\tELSE 0\r\n\tEND AS sum_nofapiaototal,\r\n\tu.last_name,\r\n\tp.productname,\r\n\tROUND(c.tax_amount/IF(IFNULL(b.conversion_rate,0)=0,1,b.conversion_rate),2) AS tax_amount\r\nFROM ld_salesorder b\r\nLEFT JOIN ld_salesorderdetail c ON c.id=b.salesorderid\r\nLEFT JOIN ld_account k ON k.accountid=b.accountid\r\nLEFT JOIN ld_products p ON p.productid=c.productid\r\nLEFT JOIN ld_users u ON u.id=b.smownerid\r\nLEFT JOIN ld_project e ON e.projectid=b.projectid\r\nWHERE b.deleted=0\r\n\tAND b.approvestatus<>'已拒绝'\r\n\tAND IFNULL(b.sostatus,'')<>'已作废'\r\n\tAND b.projectid>0\r\n\tAND b.projectid='{this[\"id\"]}'\r\nORDER BY b.signed_data,b.salesorder_no,b.salesorderid,c.sequence_no"
      },
