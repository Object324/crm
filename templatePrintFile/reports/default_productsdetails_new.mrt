        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\te.projectname,\r\n\ta.expenseid AS id,\r\n\ta.expense_no,\r\n\ta.expensedate,\r\n\tu.last_name,\r\n\ta.total/IF(IFNULL(a.conversion_rate,0)=0,1,a.conversion_rate) AS total_exec,\r\n\tCASE\r\n\t\tWHEN b.expensedetailid=(SELECT MIN(expensedetailid) FROM ld_expensedetail WHERE expenseid=a.expenseid) THEN a.total/IF(IFNULL(a.conversion_rate,0)=0,1,a.conversion_rate)\r\n\t\tELSE 0\r\n\tEND AS sum_totalexec,\r\n\tb.expensetype,\r\n\tb.Startdate,\r\n\tb.enddate,\r\n\tc.rmb_total,\r\n\tb.description\r\nFROM ld_expense a\r\nLEFT JOIN ld_expensedetail b ON b.expenseid=a.expenseid\r\nLEFT JOIN ld_expensedetailscf c ON c.expensedetailid=b.expensedetailid\r\nLEFT JOIN ld_project e ON e.projectid=a.projectid\r\nLEFT JOIN ld_users u ON u.id=a.smownerid\r\nWHERE a.deleted=0\r\n\tAND a.approvestatus<>'已拒绝'\r\n\tAND a.projectid>0\r\n\tAND a.projectid='{this[\"id\"]}'\r\nORDER BY a.expensedate,a.expense_no,a.expenseid"
      },
