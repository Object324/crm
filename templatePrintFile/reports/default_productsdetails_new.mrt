          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\tcomm.commission_id AS id,\r\n\tcomm.commission_no,\r\n\tcomm.expensedate,\r\n\tu.last_name,\r\n\taccount.accountname,\r\n\tcomm.commissiontype,\r\n\tsum(ifnull(commp.amount,0))as amount,\r\n\tcomm.description,\r\n\tsum(ifnull(s.total,0))as total_exec\r\nFROM\r\n\tld_crmentityrel a\r\nINNER JOIN ld_commission2payment commp ON commp.entitytypeid = a.relcrmid\r\nLEFT JOIN ld_commission comm ON comm.commission_id = commp.commission_id\r\n\tleft join ld_users u on u.id=comm.smownerid\r\nleft join ld_account account on account.accountid=comm.accountid\r\nleft join ld_salesorder s on s.salesorderid=commp.entitytypeid\r\nWHERE\r\n\ta.module = 'Project'\r\nAND a.relmodule = 'SalesOrder'\r\nAND comm.deleted = 0\r\nAND comm.approvestatus <> '已拒绝'\r\nAND commp.entitytype = 'SalesOrder'\r\nAND a.crmid = '{this[\"id\"]}'\r\ngroup by comm.commission_id\r\n"
      },
