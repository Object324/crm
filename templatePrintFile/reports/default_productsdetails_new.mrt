            "Type": "System.Decimal"
          },
          "13": {
            "Name": "total_fenbao",
            "Index": -1,
            "NameInSource": "total_fenbao",
            "Alias": "total_fenbao",
            "Type": "System.Decimal"
          },
          "14": {
            "Name": "total_laowu",
            "Index": -1,
            "NameInSource": "total_laowu",
