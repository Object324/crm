    "DataSources": {
      "0": {
        "Ident": "StiMySqlSource",
        "Name": "b",
        "Alias": "b",
        "Columns": {
          "0": {
            "Name": "mytype",
            "Index": -1,
            "NameInSource": "mytype",
            "Alias": "mytype",
            "Type": "System.String"
          },
          "1": {
            "Name": "mytype_value",
            "Index": -1,
            "NameInSource": "mytype_value",
            "Alias": "mytype_value",
            "Type": "System.Int32"
          }
        },
        "NameInSource": "crm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\tmytype,\r\n\tmytype_value\r\nFROM (\r\n\tSELECT\r\n\t\tmytype,\r\n\t\tCOUNT(1) AS mytype_value\r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\ta.accountid,\r\n\t\t\tsubstring_index(substring_index(REPLACE(b.cf_5038,' |##| ',','),',', c.seq+1 ),',',- 1) AS mytype\r\n\t\tFROM ld_account a\r\n\t\tLEFT JOIN ld_accountscf b ON b.accountid=a.accountid\r\n\t\tLEFT JOIN sequence c ON c.seq <(length(REPLACE(b.cf_5038,' |##| ',',')) - length(REPLACE(REPLACE(b.cf_5038,' |##| ',','),',',''))+1) \r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.customform10_id=1090\r\n\t\t\tAND b.cf_5038<>''\r\n\t\t\tAND b.cf_5038 IS NOT NULL\r\n\t) a\r\n\tGROUP BY mytype\r\n) a\r\nLEFT JOIN ld_picklist_values b ON listid=245 AND b.listvalue=a.mytype\r\nORDER BY IFNULL(b.sequence,100),a.mytype\r\n"
      }
    },
    "Databases": {
      "0": {
        "Ident": "StiMySqlDatabase",
