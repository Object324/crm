        "NameInSource": "ldcrm",
        "Type": "Table",
        "SqlCommand": "SELECT  \r\na.sendcashbill_no,   \r\nd.purchaseorder_no,\r\nifnull(d.total,0) as total,\r\nifnull(c.amount,0) as amount,\r\na.approvetime,\r\nifnull(d.pay_balance,0) as pay_balance,\r\n\r\nu.last_name\r\n\r\nfrom ld_sendcashbill a  INNER JOIN ld_sendcashbillscf b on a.sendcashbillid = b.sendcashbillid\r\nLEFT JOIN ld_sendcashbill2payment c on a.sendcashbillid = c.sendcashbillid\r\nLEFT JOIN ld_purchaseorder d on c.entitytypeid = d.purchaseorderid\r\n\r\nLEFT JOIN ld_users u on a.smownerid = u.id\r\n \r\nwhere a.deleted = 0 and a.approvestatus = '已批准' and date(a.approvetime) BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')"
