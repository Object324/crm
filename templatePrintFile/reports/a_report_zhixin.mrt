            "NameInSource": "received_amount",
            "Alias": "received_amount",
            "Type": "System.Object"
          },
          "6": {
            "Name": "salesorder_no",
            "Index": -1,
            "NameInSource": "salesorder_no",
            "Alias": "salesorder_no",
            "Type": "System.String"
          },
          "7": {
            "Name": "total",
