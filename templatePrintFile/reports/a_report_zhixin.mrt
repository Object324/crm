        "NameInSource": "ldcrm",
        "Type": "Table",
        "SqlCommand": "SELECT  \r\na.customform30_no,   \r\ncf_8089 as project_name,\r\ncf_8085 as type,\r\nifnull(a.total,0) as total,\r\na.approvetime as pay_date, \r\ncf_8093 as acc_name, \r\ncf_8091 as description,\r\ncf_8015 as pre_money,\r\nu.last_name\r\n\r\nfrom ld_customform30 a  INNER JOIN ld_customform30scf b on a.customform30id = b.customform30id \r\nLEFT JOIN ld_customform48scf c on a.customform48_id = c.customform48id\r\nLEFT JOIN ld_users u on a.smownerid = u.id\r\n \r\nwhere a.deleted = 0 and   a.approvestatus = '已批准' and date(a.approvetime)  BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\r\n "
      },
