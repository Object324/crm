        "NameInSource": "ldcrm",
        "Type": "Table",
        "SqlCommand": "SELECT  \r\na.customform26_no,   \r\nc.potential_no,\r\ncf_7940 as apply_type,\r\ncf_7842 as project_name,\r\nifnull(a.total,0) as total,\r\ncf_7845 as pre_date,\r\ncf_7852 as cash_name, \r\ncf_7916 as description,\r\nu.last_name\r\n\r\nfrom ld_customform26 a  INNER JOIN ld_customform26scf b on a.customform26id = b.customform26id \r\nLEFT JOIN ld_potential c on a.potentialid = c.potentialid \r\n\r\nLEFT JOIN ld_users u on a.smownerid = u.id\r\n \r\nwhere a.deleted = 0 and ((cf_7940 = '对公付款申请' and date(cf_7845) BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')) or (cf_7940 = '个人费用报销' and a.approvestatus = '已批准' and date(a.approvetime)  BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')))"
