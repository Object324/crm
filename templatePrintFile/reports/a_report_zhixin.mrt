        },
        "NameInSource": "ldcrm",
        "Type": "Table",
        "SqlCommand": "SELECT  \r\nifnull(cashbilltotal,0) as cashbilltotal,\r\nifnull(cashbilltotal_pre,0) as cashbilltotal_pre,\r\nifnull(cash_rentation,0) as cash_rentation,\r\nifnull(cash_rentation_pre,0) as cash_rentation_pre,\r\nifnull(cash_ready,0) as cash_ready,\r\nifnull(cash_ready_pre,0) as cash_ready_pre,\r\nifnull(cash_bid,0) as cash_bid,\r\nifnull(cash_bid_pre,0) as cash_bid_pre,\r\nifnull(cash_other,0) as cash_other,\r\n\r\n\r\n \r\n\t\tifnull(cashbilltotal,0) + ifnull(cash_rentation,0) + ifnull(cash_ready,0) + ifnull(cash_bid,0) + ifnull(cash_other,0) as cash_sub,\r\n\t\t\t\tifnull(cashbilltotal_pre,0) + ifnull(cash_rentation_pre,0) + ifnull(cash_ready_pre,0) + ifnull(cash_bid_pre,0)   as cash_sub_pre,\r\n\t\t\t\t\r\n\t\t\t\tifnull(pay_contract,0) as pay_contract,\r\nifnull(pay_contract_pre,0) as pay_contract_pre,\r\nifnull(pay_project,0) as pay_project,\r\nifnull(pay_project_pre,0) as pay_project_pre,\r\nifnull(pay_rd,0) as pay_rd,\r\nifnull(pay_rd_pre,0) as pay_rd_pre,\r\nifnull(pay_other,0) as pay_other,\r\n\t\t\r\n\t\t \r\n\t\tifnull(pay_project_not1, 0) +  ifnull(pay_project_not2, 0) as pay_project_not,\r\n\t\tifnull(pay_project_not_pre1, 0) +  ifnull(pay_project_not_pre2, 0) as pay_project_not_pre,\r\n\t \r\n\t\tifnull(pay_contract,0) + ifnull(pay_project,0) + ifnull(pay_project_not1, 0) +  ifnull(pay_project_not2, 0)  + ifnull(pay_rd,0) + ifnull(pay_other,0) as pay_sub,\r\n\t\tifnull(pay_contract_pre,0) + ifnull(pay_project_pre,0) + ifnull(pay_project_not_pre1, 0) +  ifnull(pay_project_not_pre2, 0)  + ifnull(pay_rd_pre,0) as pay_sub_pre\r\n\r\nfrom (\r\nSELECT\r\n(SELECT sum(total) from ld_cashbill a \r\nwhere a.deleted = 0 and a.cashbilldate BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')) as cashbilltotal,\r\n\r\n(SELECT sum(receivable_balance) from ld_paymentplan a \r\nwhere a.deleted = 0 and a.plandate BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')) as cashbilltotal_pre,\r\n\r\n(SELECT sum(cf_8037) from ld_customform59 a  INNER JOIN ld_customform59scf b on a.customform59id = b.customform59id\r\nwhere a.deleted = 0 and date(latestpushtime) BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')) as cash_rentation,\r\n\r\n(SELECT sum(cf_8037) from ld_customform59 a  INNER JOIN ld_customform59scf b on a.customform59id = b.customform59id\r\nwhere a.deleted = 0 and date(cf_8041) BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')) as cash_rentation_pre,\r\n\r\n(SELECT sum(cf_8060) from ld_customform62 a  INNER JOIN ld_customform62scf b on a.customform62id = b.customform62id\r\nwhere a.deleted = 0 and date(cf_8059) BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')) as cash_ready,\r\n(SELECT sum(cf_8047) from ld_customform60 a  INNER JOIN ld_customform60scf b on a.customform60id = b.customform60id\r\nwhere a.deleted = 0 and cf_8055 = '备用金申请单' and date(cf_8046) BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')) as cash_ready_pre,\r\n\r\n(SELECT sum(cf_7939) from ld_customform05 a  INNER JOIN ld_customform05scf b on a.customform05id = b.customform05id\r\nwhere a.deleted = 0 and date(latestpushtime) BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')) as cash_bid,\r\n\r\n\r\n(SELECT sum(cf_7939) from ld_customform05 a  INNER JOIN ld_customform05scf b on a.customform05id = b.customform05id\r\nwhere a.deleted = 0 and date(cf_8057) BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')) as cash_bid_pre,\r\n\r\n(SELECT sum(total) from ld_customform182 a  INNER JOIN ld_customform182scf b on a.customform182id = b.customform182id\r\nwhere a.deleted = 0 and date(cf_8063) BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')) as cash_other,\r\n\r\n(SELECT sum(total) from ld_sendcashbill a \r\nwhere a.deleted = 0 and a.approvestatus = '已批准' and date(a.approvetime) BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')) as pay_contract,\r\n\r\n(SELECT sum(pay_balance) from ld_sendpayment a \r\nwhere a.deleted = 0 and date(a.plandate) BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')) as pay_contract_pre,\r\n\r\n(SELECT sum(total) from ld_customform26 a  INNER JOIN ld_customform26scf b on a.customform26id = b.customform26id\r\nwhere a.deleted = 0 and a.approvestatus = '已批准' and date(a.approvetime)  BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')) as pay_project,\r\n\r\n(SELECT sum(total) from ld_customform26 a  INNER JOIN ld_customform26scf b on a.customform26id = b.customform26id\r\nwhere a.deleted = 0 and ((cf_7940 = '对公付款申请' and date(cf_7845) BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')) or (cf_7940 = '个人费用报销' and a.approvestatus = '已批准' and date(a.approvetime)  BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d'))) ) as pay_project_pre,\r\n\r\n(SELECT sum(total) from ld_customform29 a  INNER JOIN ld_customform29scf b on a.customform29id = b.customform29id\r\nwhere a.deleted = 0 and   a.approvestatus = '已批准' and date(a.approvetime)  BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d') ) as pay_project_not1,\r\n(SELECT sum(total) from ld_customform27 a  INNER JOIN ld_customform27scf b on a.customform27id = b.customform27id\r\nwhere a.deleted = 0 and   a.approvestatus = '已批准' and date(a.approvetime)  BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d') ) as pay_project_not2,\r\n\r\n(SELECT sum(total) from ld_customform29 a  INNER JOIN ld_customform29scf b on a.customform29id = b.customform29id\r\nwhere a.deleted = 0  and date(cf_7896)  BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d') ) as pay_project_not_pre1,\r\n(SELECT sum(total) from ld_customform27 a  INNER JOIN ld_customform27scf b on a.customform27id = b.customform27id\r\nwhere a.deleted = 0 and   a.approvestatus = '已批准' and date(a.approvetime)  BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d') ) as pay_project_not_pre2,\r\n\r\n(SELECT sum(total) from ld_customform30 a  INNER JOIN ld_customform30scf b on a.customform30id = b.customform30id\r\nwhere a.deleted = 0 and   a.approvestatus = '已批准' and date(a.approvetime)  BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d') ) as pay_rd,\r\n\r\n(SELECT sum(total) from ld_customform30 a  INNER JOIN ld_customform30scf b on a.customform30id = b.customform30id\r\nwhere a.deleted = 0 and ( ( cf_8085 = '个人费用报销' and   a.approvestatus = '已批准' and date(a.approvetime)  BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d') ) or ( cf_8085 = '对公付款申请'   and date(b.cf_8087)  BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')))) as pay_rd_pre,\r\n\r\n(SELECT sum(total) from ld_customform183 a  INNER JOIN ld_customform183scf b on a.customform183id = b.customform183id\r\nwhere a.deleted = 0 and     date(cf_8065)  BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d') ) as pay_other\r\n) a\r\n"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "data1",
        "Alias": "data1",
        "Columns": {
          "0": {
