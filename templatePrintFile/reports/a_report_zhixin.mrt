            "Alias": "last_name",
            "Type": "System.String"
          },
          "5": {
            "Name": "paymentplan_no",
            "Index": -1,
            "NameInSource": "paymentplan_no",
            "Alias": "paymentplan_no",
            "Type": "System.String"
          },
          "6": {
            "Name": "paymentstatus",
            "Index": -1,
            "NameInSource": "paymentstatus",
            "Alias": "paymentstatus",
            "Type": "System.String"
          },
          "7": {
            "Name": "plandate",
            "Index": -1,
            "NameInSource": "plandate",
            "Alias": "plandate",
            "Type": "System.DateTime"
          },
          "8": {
            "Name": "salesorder_no",
            "Index": -1,
            "NameInSource": "salesorder_no",
            "Alias": "salesorder_no",
            "Type": "System.String"
          }
        },
        "NameInSource": "ldcrm",
        "Type": "Table",
        "SqlCommand": "SELECT  \r\na.paymentplan_no,\r\na.plandate,\r\nifnull(a.actualamount,0) as actualamount,\r\nu.last_name, \r\nifnull(a.receivable_balance,0) as amount, \r\nd.salesorder_no, \r\nifnull(a.amount,0) - ifnull(a.actualamount,0) as  balance_amount,\r\na.paymentstatus,\r\na.description\r\n\r\n from ld_paymentplan a   \r\nLEFT JOIN ld_salesorder d on a.entitytypeid = d.salesorderid\r\nLEFT JOIN ld_users u on a.smownerid = u.id\r\nwhere a.deleted = 0 and a.plandate BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')"
      },
      "3": {
