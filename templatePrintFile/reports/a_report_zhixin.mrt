        "NameInSource": "ldcrm",
        "Type": "Table",
        "SqlCommand": "SELECT  \r\na.customform59_no,\r\nc.potential_no,\r\nifnull(cf_8037,0) as total,\r\ncf_8083 as valid_date,\r\na.latestpushtime,\r\n \r\nu.last_name \r\n\r\nfrom ld_customform59 a  INNER JOIN ld_customform59scf b on a.customform59id = b.customform59id\r\n LEFT JOIN ld_potential c on a.potentialid = c.potentialid\r\nLEFT JOIN ld_users u on a.smownerid = u.id\r\nwhere a.deleted = 0 and date(a.latestpushtime) BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')"
      },
