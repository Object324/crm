        "NameInSource": "ldcrm",
        "Type": "Table",
        "SqlCommand": "SELECT  \r\na.sendpayment_no,   \r\nd.purchaseorder_no,\r\nifnull(d.total,0) as total,\r\nifnull(a.amount,0) as amount,\r\nifnull(a.actualamount,0) as actualamount,\r\nifnull(a.pay_balance,0) as pay_balance,\r\na.plandate,\r\na.cpstatus,\r\na.description,\r\nu.last_name\r\n\r\nfrom ld_sendpayment a  INNER JOIN ld_sendpaymentscf b on a.sendpaymentid = b.sendpaymentid \r\nLEFT JOIN ld_purchaseorder d on a.purchaseorder_id = d.purchaseorderid\r\n\r\nLEFT JOIN ld_users u on a.smownerid = u.id\r\n \r\nwhere a.deleted = 0 and date(a.plandate) BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')"
