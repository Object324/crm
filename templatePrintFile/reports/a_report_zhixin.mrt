            "Alias": "total",
            "Type": "System.Object"
          }
        },
        "NameInSource": "ldcrm",
        "Type": "Table",
        "SqlCommand": "SELECT  \r\na.cashbill_no,\r\na.cashbilldate,\r\nu.last_name, \r\nifnull(b.amount, 0) as amount,\r\nifnull(b.received_amount,0) as received_amount,\r\nd.salesorder_no,\r\nd.total,\r\nd.receivable_balance\r\n\r\n from ld_cashbill a \r\nLEFT JOIN ld_cashbill2paymentplan b on a.cashbillid = b.CashBillID\r\nLEFT JOIN ld_paymentplan c on b.entitytypeid = c.paymentplanid\r\nLEFT JOIN ld_salesorder d on c.entitytypeid = d.salesorderid\r\nLEFT JOIN ld_users u on a.smownerid = u.id\r\nwhere a.deleted = 0 and a.cashbilldate BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')"
      },
      "2": {
        "Ident": "StiMySqlSource",
        "Name": "data2",
        "Alias": "data2",
        "Columns": {
          "0": {
            "Name": "actualamount",
            "Index": -1,
            "NameInSource": "actualamount",
            "Alias": "actualamount",
            "Type": "System.Object"
          },
          "1": {
            "Name": "amount",
            "Index": -1,
            "NameInSource": "amount",
            "Alias": "amount",
            "Type": "System.Object"
          },
          "2": {
            "Name": "balance_amount",
            "Index": -1,
            "NameInSource": "balance_amount",
            "Alias": "balance_amount",
            "Type": "System.Object"
          },
          "3": {
            "Name": "description",
            "Index": -1,
            "NameInSource": "description",
