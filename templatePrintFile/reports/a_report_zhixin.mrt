          }
        },
        "NameInSource": "ldcrm",
        "Type": "Table",
        "SqlCommand": "SELECT  \r\na.customform183_no,    \r\nifnull(a.total,0) as total,\r\ncf_8065 as pay_date,   \r\ncf_8066 as description\r\n\r\nfrom ld_customform183 a  INNER JOIN ld_customform183scf b on a.customform183id = b.customform183id  \r\n \r\n \r\nwhere a.deleted = 0 and     date(cf_8065)  BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\r\n "
      }
