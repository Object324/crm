        "SqlCommand": "SELECT  \r\na.customform29_no,   \r\n'对公付款申请(非项目)' as type,\r\nifnull(a.total,0) as total,\r\na.approvetime as pay_date, \r\ncf_7902 as acc_name, \r\ncf_7915 as description,\r\nu.last_name\r\n\r\nfrom ld_customform29 a  INNER JOIN ld_customform29scf b on a.customform29id = b.customform29id \r\nLEFT JOIN ld_users u on a.smownerid = u.id\r\n \r\nwhere a.deleted = 0 and   a.approvestatus = '已批准' and date(a.approvetime)  BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d') \r\n\r\nunion all \r\n\r\nSELECT  \r\na.customform27_no,   \r\n'个人费用报销(非项目)' as type,\r\nifnull(a.total,0) as total,\r\na.approvetime as pay_date, \r\ncf_7870 as acc_name, \r\ncf_7917 as description,\r\nu.last_name\r\n\r\nfrom ld_customform27 a  INNER JOIN ld_customform27scf b on a.customform27id = b.customform27id \r\nLEFT JOIN ld_users u on a.smownerid = u.id\r\n \r\nwhere a.deleted = 0 and   a.approvestatus = '已批准' and date(a.approvetime)  BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')"
      },
