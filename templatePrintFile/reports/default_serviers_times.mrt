    "DataSources": {
      "0": {
        "Ident": "StiMySqlSource",
        "Name": "list_status",
        "Alias": "list_status",
        "Columns": {
          "0": {
            "Name": "listvalue",
            "Index": -1,
            "NameInSource": "listvalue",
            "Alias": "listvalue",
            "Type": "System.String"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT listvalue FROM ld_picklist_values WHERE listid=(SELECT listid FROM ld_picklist_set WHERE listname='ticketstatus') ORDER BY sequence"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "list_users",
        "Alias": "list_users",
        "Columns": {
          "0": {
            "Name": "id",
            "Index": -1,
            "NameInSource": "id",
            "Alias": "id",
            "Type": "System.Int32"
          },
          "1": {
            "Name": "last_name",
            "Index": -1,
            "NameInSource": "last_name",
            "Alias": "last_name",
            "Type": "System.String"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\ta.id,\r\n\ta.last_name\r\nFROM ld_users a\r\nINNER JOIN (\r\n\tSELECT DISTINCT\r\n\t\tuserid \r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\tld_users.id AS userid \r\n\t\tFROM ld_users\r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='HelpDesk' and scopeauthority=1 AND userid='[uuid]')\r\n\t\tUNION\r\n\t\tSELECT \r\n\t\t\tviewid AS userid \r\n\t\tFROM ld_scoperhigher\r\n\t\tWHERE userid='[uuid]' AND modulename='HelpDesk' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename='HelpDesk')\t\t\t\r\n\t\tUNION\r\n\t\tSELECT DISTINCT \r\n\t\t\tld_users2group.userid AS userid \r\n\t\tFROM ld_scoperhigher \r\n\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\tAND ld_scoperhigher.modulename='HelpDesk'\r\n\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='HelpDesk' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\tUNION \r\n\t\tSELECT \r\n\t\t\tid AS userid \r\n\t\tFROM ld_users  \r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\tUNION\r\n\t\tSELECT '[uuid]') AS vw_users\r\n) AS tmp_users ON tmp_users.userid=a.id\r\nWHERE a.deleted=0\r\n\tAND a.`status`='Active'\r\nORDER BY CONVERT(a.last_name USING gbk)"
      },
      "2": {
        "Ident": "StiMySqlSource",
        "Name": "r",
        "Alias": "r",
        "Columns": {
          "0": {
            "Name": "last_name",
            "Index": -1,
            "NameInSource": "last_name",
            "Alias": "last_name",
            "Type": "System.String"
          },
          "1": {
            "Name": "qty",
            "Index": -1,
            "NameInSource": "qty",
            "Alias": "qty",
            "Type": "System.Int32"
          },
          "2": {
            "Name": "smownerid",
            "Index": -1,
            "NameInSource": "smownerid",
            "Alias": "smownerid",
            "Type": "System.Int32"
          }
        },
        "NameInSource": "ldcrm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\ta.smownerid,\r\n\tu.last_name,\r\n\tCOUNT(ticketid) AS qty\r\nFROM ld_troubletickets a\r\nLEFT JOIN ld_account b ON b.accountid=a.accountid\r\nLEFT JOIN ld_users u ON u.id=a.smownerid\r\nINNER JOIN (\r\n\tSELECT DISTINCT\r\n\t\tuserid \r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\tld_users.id AS userid \r\n\t\tFROM ld_users\r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='HelpDesk' and scopeauthority=1 AND userid='[uuid]')\r\n\t\tUNION\r\n\t\tSELECT \r\n\t\t\tviewid AS userid \r\n\t\tFROM ld_scoperhigher\r\n\t\tWHERE userid='[uuid]' AND modulename='HelpDesk' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename='HelpDesk')\t\t\t\r\n\t\tUNION\r\n\t\tSELECT DISTINCT \r\n\t\t\tld_users2group.userid AS userid \r\n\t\tFROM ld_scoperhigher \r\n\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\tAND ld_scoperhigher.modulename='HelpDesk'\r\n\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='HelpDesk' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\tUNION \r\n\t\tSELECT \r\n\t\t\tid AS userid \r\n\t\tFROM ld_users  \r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\tUNION\r\n\t\tSELECT '[uuid]') AS vw_users\r\n) AS tmp_users ON tmp_users.userid=a.smownerid\r\nWHERE a.deleted=0\r\n\tAND a.approvestatus<>'已拒绝'\r\n\tAND a.accountid>0\r\n\tAND u.`status`='Active'\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_field WHERE tabid=13 AND presence=1 AND columnname='hopetime') THEN 1=1\r\n\t\t\tWHEN '{start_date}'='' AND '{end_date}'='' THEN 1=1\r\n\t\t\tWHEN '{start_date}'='' AND '{end_date}'<>'' THEN DATE_FORMAT(a.hopetime,'%Y-%m-%d')<=DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\t\t\tWHEN '{start_date}'<>'' AND '{end_date}'='' THEN DATE_FORMAT(a.hopetime,'%Y-%m-%d')>=DATE_FORMAT('{start_date}','%Y-%m-%d')\r\n\t\t\tELSE DATE_FORMAT(a.hopetime,'%Y-%m-%d') BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\t\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_field WHERE tabid=13 AND presence=1 AND columnname='realtime') THEN 1=1\r\n\t\t\tWHEN '{startdate}'='' AND '{enddate}'='' THEN 1=1\r\n\t\t\tWHEN '{startdate}'='' AND '{enddate}'<>'' THEN DATE_FORMAT(a.realtime,'%Y-%m-%d')<=DATE_FORMAT('{enddate}','%Y-%m-%d')\r\n\t\t\tWHEN '{startdate}'<>'' AND '{enddate}'='' THEN DATE_FORMAT(a.realtime,'%Y-%m-%d')>=DATE_FORMAT('{startdate}','%Y-%m-%d')\r\n\t\t\tELSE DATE_FORMAT(a.realtime,'%Y-%m-%d') BETWEEN DATE_FORMAT('{startdate}','%Y-%m-%d') AND DATE_FORMAT('{enddate}','%Y-%m-%d')\r\n\t\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{accname}'='' THEN 1=1\r\n\t\t\tELSE LOCATE('{accname}',b.accountname)>0\r\n\t\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{is_approved}'='true' THEN a.approvestatus='已批准'\r\n\t\t\tELSE 1=1\r\n\t\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{dostatus}'='' OR '{dostatus}'=(SELECT GROUP_CONCAT(listvalue) FROM ld_picklist_values WHERE listid=(SELECT listid FROM ld_picklist_set WHERE listname='ticketstatus') ORDER BY sequence) THEN 1=1\r\n\t\t\tELSE FIND_IN_SET(a.`status`,'{dostatus}')\r\n\t\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{userid}'='' THEN 1=1\r\n\t\t\tELSE FIND_IN_SET(a.smownerid,'{userid}')\r\n\t\tEND)\r\nGROUP BY a.smownerid\r\nORDER BY qty DESC,CONVERT(u.last_name USING GBK)"
      }
    },
    "Databases": {
      "0": {
        "Ident": "StiMySqlDatabase",
        "Name": "ldcrm",
        "Alias": "ldcrm",
        "ConnectionStringEncrypted": "9Gx168ZcS1nhR9Wl6iV1n8JsaWBhT1mFQhWxkOkl9i/CYNfKTV1ClEZ4uYhjXK17gshxYMhtut1AReWN6oz1KtVgc+NWBdN1YkmsgOo9NEbJxHNIRlyp+UZbqLw="
      }
    }
  },
