        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\tbillid,\r\n\tbillno,\r\n\tcorpname,\r\n\tbilldate,\r\n\ttotal,\r\n\tCASE\r\n\t\tWHEN '{type}' IN (1,2) AND '{this[\"querytype\"]}'='this' THEN CONCAT('本年 - ',IFNULL(remark,''),' - 签约次数详情')\r\n\t\tWHEN '{type}' IN (1,2) AND '{this[\"querytype\"]}'='last' THEN CONCAT('去年 - ',IFNULL(remark,''),' - 签约次数详情')\r\n\t\tWHEN '{type}' IN (3,4,5) AND '{this[\"querytype\"]}'='this' THEN CONCAT('本季度 - ',IFNULL(remark,''),' - 签约次数详情')\r\n\t\tWHEN '{type}' IN (3,4,5) AND '{this[\"querytype\"]}'='last' THEN CONCAT('上季度 - ',IFNULL(remark,''),' - 签约次数详情')\r\n\t\tWHEN '{type}' IN (6,7) AND '{this[\"querytype\"]}'='this' THEN CONCAT('本月 - ',IFNULL(remark,''),' - 签约次数详情')\r\n\t\tWHEN '{type}' IN (6,7) AND '{this[\"querytype\"]}'='last' THEN CONCAT('上月 - ',IFNULL(remark,''),' - 签约次数详情')\r\n\t\tWHEN '{type}' IN (8) AND '{this[\"querytype\"]}'='this' THEN CONCAT('本周 - ',IFNULL(remark,''),' - 签约次数详情')\r\n\t\tWHEN '{type}' IN (8) AND '{this[\"querytype\"]}'='last' THEN CONCAT('上周 - ',IFNULL(remark,''),' - 签约次数详情')\r\n\tEND AS lab1\r\nFROM (\r\n\tSELECT \r\n\t\tb.salesorderid AS billid,\r\n\t\tb.salesorder_no AS billno,\r\n\t\tk.accountname AS corpname,\r\n\t\ta.date AS billdate,\r\n\t\tCASE\r\n\t\t\tWHEN '{type}'=1 THEN CONCAT(QUARTER(a.date),'季度')\r\n\t\t\tWHEN '{type}'=2 THEN DATE_FORMAT(a.date,'%m月')\r\n\t\t\tWHEN '{type}'=3 THEN concat('第',month(a.date)-month(concat(year(DATE_FORMAT('{start_date}','%Y-%m-%d')),'-',elt(quarter(DATE_FORMAT('{start_date}','%Y-%m-%d')),1,4,7,10),'-',1))+1,'月')\r\n\t\t\tWHEN '{type}'=4 THEN concat('第',week(a.date)-week(concat(year(DATE_FORMAT('{start_date}','%Y-%m-%d')),'-',elt(quarter(DATE_FORMAT('{start_date}','%Y-%m-%d')),1,4,7,10),'-',1))+1,'周')\r\n\t\t\tWHEN '{type}'=5 THEN concat('第',DATEDIFF(a.date,date(concat(year(DATE_FORMAT('{start_date}','%Y-%m-%d')),'-',elt(quarter(DATE_FORMAT('{start_date}','%Y-%m-%d')),1,4,7,10),'-',1)))+1,'天')\r\n\t\t\tWHEN '{type}'=6 THEN concat('第',week(a.date)-week(date_add(DATE_FORMAT('{start_date}','%Y-%m-%d'), interval - day(DATE_FORMAT('{start_date}','%Y-%m-%d')) + 1 day))+1,'周')\r\n\t\t\tWHEN '{type}'=7 THEN concat('第',day(a.date)-day(date_add(DATE_FORMAT('{start_date}','%Y-%m-%d'), interval - day(DATE_FORMAT('{start_date}','%Y-%m-%d')) + 1 day))+1,'天')\r\n\t\t\tWHEN '{type}'=8 THEN concat('第',day(a.date)-day(date_sub(date(DATE_FORMAT('{start_date}','%Y-%m-%d')),INTERVAL weekday(DATE_FORMAT('{start_date}','%Y-%m-%d'))+1 day))+1,'天')\r\n\t\tEND AS remark,\t\r\n\t\tROUND(IFNULL(b.Total,0)/IFNULL(b.conversion_rate,1),2) AS total\r\n\tFROM tmp_date a\r\n\tINNER JOIN (\r\n\t\tSELECT\r\n\t\t\tsalesorderid,\r\n\t\t\tsalesorder_no,\r\n\t\t\taccountid,\r\n\t\t\tsigned_data,\r\n\t\t\ttotal,\r\n\t\t\tconversion_rate,\r\n\t\t\tsmownerid\r\n\t\tFROM ld_salesorder\r\n\t\tWHERE deleted=0\r\n\t\t\tAND approvestatus<>'已拒绝'\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{approve}'='true' THEN approvestatus='已批准'\r\n\t\t\t\t\tELSE 1=1\r\n\t\t\t\tEND)\r\n\t\tUNION ALL\r\n\t\tSELECT\r\n\t\t\tservicecontractsid,\r\n\t\t\tcontract_no,\r\n\t\t\taccountid,\r\n\t\t\tdue_date,\r\n\t\t\ttotal,\r\n\t\t\tconversion_rate,\r\n\t\t\tsmownerid\r\n\t\tFROM ld_servicecontracts\r\n\t\tWHERE deleted=0\r\n\t\t\tAND approvestatus<>'已拒绝'\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{approve}'='true' THEN approvestatus='已批准'\r\n\t\t\t\t\tELSE 1=1\r\n\t\t\t\tEND)\r\n\t) b on a.date=b.signed_data\r\n\tLEFT JOIN ld_account k ON k.accountid=b.accountid\r\n\tINNER JOIN (\r\n\t\tSELECT DISTINCT\r\n\t\t\tuserid \r\n\t\tFROM (\r\n\t\t\tSELECT \r\n\t\t\t\tld_users.id AS userid \r\n\t\t\tFROM ld_users\r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='SalesOrder' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\tUNION\r\n\t\t\tSELECT \r\n\t\t\t\tviewid AS userid \r\n\t\t\tFROM ld_scoperhigher\r\n\t\t\tWHERE userid='[uuid]' AND modulename='SalesOrder' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename='SalesOrder')\t\t\t\r\n\t\t\tUNION\r\n\t\t\tSELECT DISTINCT \r\n\t\t\t\tld_users2group.userid AS userid \r\n\t\t\tFROM ld_scoperhigher \r\n\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\tAND ld_scoperhigher.modulename='SalesOrder'\r\n\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='SalesOrder' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\tUNION \r\n\t\t\tSELECT \r\n\t\t\t\tid AS userid \r\n\t\t\tFROM ld_users  \r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\tUNION\r\n\t\t\tSELECT '[uuid]') AS vw_users\r\n\t) AS tmp_users ON tmp_users.userid=b.smownerid\r\n\tWHERE 1=1\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{userid}'='' THEN 1=1\r\n\t\t\t\tELSE FIND_IN_SET(b.smownerid,'{userid}')\r\n\t\t\tEND)\r\n\t\tAND (\r\n\t\t\t\tCASE \r\n\t\t\t\t\tWHEN '{type}' IN (1,2) AND '{this[\"querytype\"]}'='this' THEN YEAR(a.date)=YEAR(DATE_FORMAT('{start_date}','%Y-%m-%d'))\r\n\t\t\t\t\tWHEN '{type}' IN (1,2) AND '{this[\"querytype\"]}'='last' THEN YEAR(a.date)=YEAR(DATE_FORMAT('{start_date}','%Y-%m-%d'))-1\r\n\t\t\t\t\tWHEN '{type}' IN (3,4,5) AND '{this[\"querytype\"]}'='this' THEN \r\n\t\t\t\t\t\ta.date BETWEEN DATE(CONCAT(YEAR(DATE_FORMAT('{start_date}','%Y-%m-%d')),'-',elt(quarter(DATE_FORMAT('{start_date}','%Y-%m-%d')),1,4,7,10),'-',1))\r\n\t\t\t\t\t\t\t\t\t\t\tAND LAST_DAY(MAKEDATE(EXTRACT(YEAR FROM DATE_FORMAT('{start_date}','%Y-%m-%d')),1) + interval QUARTER(DATE_FORMAT('{start_date}','%Y-%m-%d'))*3-1 month)\r\n\t\t\t\t\tWHEN '{type}' IN (3,4,5) AND '{this[\"querytype\"]}'='last' THEN \t\r\n\t\t\t\t\t\ta.date BETWEEN DATE_SUB(DATE(CONCAT(YEAR(DATE_FORMAT('{start_date}','%Y-%m-%d')),'-',elt(quarter(DATE_FORMAT('{start_date}','%Y-%m-%d')),1,4,7,10),'-',1)),INTERVAL 3 MONTH)\r\n\t\t\t\t\t\t\t\t\t\t\tAND LAST_DAY(DATE_SUB(MAKEDATE(EXTRACT(YEAR FROM DATE_FORMAT('{start_date}','%Y-%m-%d')),1) + interval QUARTER(DATE_FORMAT('{start_date}','%Y-%m-%d'))*3-1 MONTH,INTERVAL 3 MONTH))\r\n\t\t\t\t\tWHEN '{type}' IN (6,7)  AND '{this[\"querytype\"]}'='this' THEN\r\n\t\t\t\t\t\ta.date between date_add(DATE_FORMAT('{start_date}','%Y-%m-%d'), interval - day(DATE_FORMAT('{start_date}','%Y-%m-%d')) + 1 day)\r\n\t\t\t\t\t\t\t\t\t\tand last_day(DATE_FORMAT('{start_date}','%Y-%m-%d'))\r\n\t\t\t\t\tWHEN '{type}' IN (6,7)  AND '{this[\"querytype\"]}'='last' THEN\r\n\t\t\t\t\t\ta.date between DATE_SUB(date_add(DATE_FORMAT('{start_date}','%Y-%m-%d'), interval - day(DATE_FORMAT('{start_date}','%Y-%m-%d')) + 1 day),INTERVAL 1 MONTH)\r\n\t\t\t\t\t\t\t\t\t\tAND date_add(DATE_FORMAT('{start_date}','%Y-%m-%d'), interval - day(DATE_FORMAT('{start_date}','%Y-%m-%d')) day)\r\n\t\t\t\t\tWHEN '{type}'=8 AND '{this[\"querytype\"]}'='this' THEN \r\n\t\t\t\t\t\ta.date between date_sub(date(DATE_FORMAT('{start_date}','%Y-%m-%d')),INTERVAL weekday(DATE_FORMAT('{start_date}','%Y-%m-%d'))+1 day)\r\n\t\t\t\t\t\t\t\t\t\tand date_sub(date(DATE_FORMAT('{start_date}','%Y-%m-%d')),INTERVAL weekday(DATE_FORMAT('{start_date}','%Y-%m-%d'))-5 day)\r\n\t\t\t\t\tWHEN '{type}'=8 AND '{this[\"querytype\"]}'='last' THEN \r\n\t\t\t\t\t\ta.date between date_sub(date(DATE_FORMAT('{start_date}','%Y-%m-%d')),INTERVAL weekday(DATE_FORMAT('{start_date}','%Y-%m-%d'))-6 day)\r\n\t\t\t\t\t\t\t\t\t\tand date_sub(date(DATE_FORMAT('{start_date}','%Y-%m-%d')),INTERVAL weekday(DATE_FORMAT('{start_date}','%Y-%m-%d'))-12 day)\r\n\t\t\t\tEND)\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN TRIM('{custname}')='' THEN 1=1\r\n\t\t\t\t\tELSE LOCATE(TRIM('{custname}'),k.accountname)>0\r\n\t\t\t\tEND) \r\n) a \r\nWHERE remark='{this[\"remark\"]}'\r\nORDER BY billdate,billid"
      }
