    "DataSources": {
      "0": {
        "Ident": "StiMySqlSource",
        "Name": "users",
        "Alias": "users",
        "Columns": {
          "0": {
            "Name": "id",
            "Index": -1,
            "NameInSource": "id",
            "Alias": "id",
            "Type": "System.Int32"
          },
          "1": {
            "Name": "last_name",
            "Index": -1,
            "NameInSource": "last_name",
            "Alias": "last_name",
            "Type": "System.String"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\ta.id,\r\n\ta.last_name\r\nFROM ld_users a\r\nINNER JOIN (\r\n\tSELECT DISTINCT\r\n\t\tuserid \r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\tld_users.id AS userid \r\n\t\tFROM ld_users\r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename IN ('SalesOrder','ServiceContracts') and scopeauthority=1 AND userid='[uuid]')\r\n\t\tUNION\r\n\t\tSELECT \r\n\t\t\tviewid AS userid \r\n\t\tFROM ld_scoperhigher\r\n\t\tWHERE userid='[uuid]' AND modulename IN ('SalesOrder','ServiceContracts') AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename IN ('SalesOrder','ServiceContracts'))\t\t\t\r\n\t\tUNION\r\n\t\tSELECT DISTINCT \r\n\t\t\tld_users2group.userid AS userid \r\n\t\tFROM ld_scoperhigher \r\n\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\tAND ld_scoperhigher.modulename IN ('SalesOrder','ServiceContracts')\r\n\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename IN ('SalesOrder','ServiceContracts') AND scopeauthority=3 AND userid='[uuid]')\r\n\t\tUNION \r\n\t\tSELECT \r\n\t\t\tid AS userid \r\n\t\tFROM ld_users  \r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\tUNION\r\n\t\tSELECT '[uuid]') AS vw_users\r\n) as tmp_users ON tmp_users.userid=a.id\r\norder by CONVERT(a.last_name USING gbk)"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "report",
        "Alias": "report",
        "Columns": {
          "0": {
            "Name": "date",
            "Index": -1,
            "NameInSource": "date",
            "Alias": "date",
            "Type": "System.DateTime"
          },
          "1": {
            "Name": "remark",
            "Index": -1,
            "NameInSource": "remark",
            "Alias": "remark",
            "Type": "System.String"
          },
          "2": {
            "Name": "tips",
            "Index": -1,
            "NameInSource": "tips",
            "Alias": "tips",
            "Type": "System.String"
          },
          "3": {
            "Name": "tips_bef",
            "Index": -1,
            "NameInSource": "tips_bef",
            "Alias": "tips_bef",
            "Type": "System.String"
          },
          "4": {
            "Name": "tongbi",
            "Index": -1,
            "NameInSource": "tongbi",
            "Alias": "tongbi",
            "Type": "System.String"
          },
          "5": {
            "Name": "total",
            "Index": -1,
            "NameInSource": "total",
            "Alias": "total",
            "Type": "System.Object"
          },
          "6": {
            "Name": "total_bef",
            "Index": -1,
            "NameInSource": "total_bef",
            "Alias": "total_bef",
            "Type": "System.Object"
          }
        },
        "NameInSource": "ldcrm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\ta.date,\r\n\ta.remark,\r\n\ta.total,\r\n\tIFNULL(b.total_bef,0) as total_bef,\r\n\tCASE\r\n\t\tWHEN ifnull(b.total_bef,0)=0 THEN '--'\r\n\t\tWHEN IFNULL(total,0)-IFNULL(b.total_bef,0)=0 THEN '100%'\r\n\t\tELSE CONCAT(format((total-IFNULL(b.total_bef,0))*100/total_bef,2),'%')\r\n\tEND AS tongbi,\r\n\tCONCAT(IFNULL(FORMAT(a.total,0),'0'),'次') AS tips,\r\n\tCONCAT(IFNULL(FORMAT(ifnull(b.total_bef,0),0),'0'),'次') AS tips_bef\r\nFROM (\r\n\tSELECT\r\n\t\ta.date,\r\n\t\tremark,\r\n\t\tSUM(total) as total\r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\ta.date,\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{type}'=1 THEN CONCAT(QUARTER(a.date),'季度')\r\n\t\t\t\tWHEN '{type}'=2 THEN DATE_FORMAT(a.date,'%m月')\r\n\t\t\t\tWHEN '{type}'=3 THEN concat('第',month(a.date)-month(concat(year(DATE_FORMAT('{start_date}','%Y-%m-%d')),'-',elt(quarter(DATE_FORMAT('{start_date}','%Y-%m-%d')),1,4,7,10),'-',1))+1,'月')\r\n\t\t\t\tWHEN '{type}'=4 THEN concat('第',week(a.date)-week(concat(year(DATE_FORMAT('{start_date}','%Y-%m-%d')),'-',elt(quarter(DATE_FORMAT('{start_date}','%Y-%m-%d')),1,4,7,10),'-',1))+1,'周')\r\n\t\t\t\tWHEN '{type}'=5 THEN concat('第',DATEDIFF(a.date,date(concat(year(DATE_FORMAT('{start_date}','%Y-%m-%d')),'-',elt(quarter(DATE_FORMAT('{start_date}','%Y-%m-%d')),1,4,7,10),'-',1)))+1,'天')\r\n\t\t\t\tWHEN '{type}'=6 THEN concat('第',week(a.date)-week(date_add(DATE_FORMAT('{start_date}','%Y-%m-%d'), interval - day(DATE_FORMAT('{start_date}','%Y-%m-%d')) + 1 day))+1,'周')\r\n\t\t\t\tWHEN '{type}'=7 THEN concat('第',day(a.date)-day(date_add(DATE_FORMAT('{start_date}','%Y-%m-%d'), interval - day(DATE_FORMAT('{start_date}','%Y-%m-%d')) + 1 day))+1,'天')\r\n\t\t\t\tWHEN '{type}'=8 THEN concat('第',day(a.date)-day(date_sub(date(DATE_FORMAT('{start_date}','%Y-%m-%d')),INTERVAL weekday(DATE_FORMAT('{start_date}','%Y-%m-%d'))+1 day))+1,'天')\r\n\t\t\tEND AS remark,\t\r\n\t\t\tCASE\r\n\t\t\t\tWHEN b.salesorderid>0 THEN 1\r\n\t\t\t\tELSE 0\r\n\t\t\tEND AS Total\r\n\t\tFROM tmp_date a\r\n\t\tLEFT JOIN (\r\n\t\t\tSELECT\r\n\t\t\t\ta.salesorderid,\r\n\t\t\t\ta.signed_data,\r\n\t\t\t\ta.total,\r\n\t\t\t\ta.conversion_rate,\r\n\t\t\t\ta.smownerid\r\n\t\t\tFROM ld_salesorder a\r\n\t\t\tLEFT JOIN ld_account k ON k.accountid=a.accountid\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{approve}'='true' THEN a.approvestatus='已批准'\r\n\t\t\t\t\t\tELSE 1=1\r\n\t\t\t\t\tEND)\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN TRIM('{custname}')='' THEN 1=1\r\n\t\t\t\t\t\tELSE LOCATE(TRIM('{custname}'),k.accountname)>0\r\n\t\t\t\t\tEND) \r\n\t\t\tUNION ALL\r\n\t\t\tSELECT\r\n\t\t\t\ta.servicecontractsid,\r\n\t\t\t\ta.due_date,\r\n\t\t\t\ta.total,\r\n\t\t\t\ta.conversion_rate,\r\n\t\t\t\ta.smownerid\r\n\t\t\tFROM ld_servicecontracts a\r\n\t\t\tLEFT JOIN ld_account k ON k.accountid=a.accountid\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{approve}'='true' THEN a.approvestatus='已批准'\r\n\t\t\t\t\t\tELSE 1=1\r\n\t\t\t\t\tEND)\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN TRIM('{custname}')='' THEN 1=1\r\n\t\t\t\t\t\tELSE LOCATE(TRIM('{custname}'),k.accountname)>0\r\n\t\t\t\t\tEND) \r\n\t\t) b on a.date=b.signed_data\r\n\t\tINNER JOIN (\r\n\t\t\tSELECT DISTINCT\r\n\t\t\t\tuserid \r\n\t\t\tFROM (\r\n\t\t\t\tSELECT \r\n\t\t\t\t\tld_users.id AS userid \r\n\t\t\t\tFROM ld_users\r\n\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename IN ('SalesOrder','ServiceContracts') and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT \r\n\t\t\t\t\tviewid AS userid \r\n\t\t\t\tFROM ld_scoperhigher\r\n\t\t\t\tWHERE userid='[uuid]' AND modulename IN ('SalesOrder','ServiceContracts') AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename IN ('SalesOrder','ServiceContracts'))\t\t\t\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT DISTINCT \r\n\t\t\t\t\tld_users2group.userid AS userid \r\n\t\t\t\tFROM ld_scoperhigher \r\n\t\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\t\tAND ld_scoperhigher.modulename IN ('SalesOrder','ServiceContracts')\r\n\t\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename IN ('SalesOrder','ServiceContracts') AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\t\tUNION \r\n\t\t\t\tSELECT \r\n\t\t\t\t\tid AS userid \r\n\t\t\t\tFROM ld_users  \r\n\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT '[uuid]') AS vw_users\r\n\t\t) AS tmp_users ON tmp_users.userid=b.smownerid\r\n\t\tWHERE 1=1\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{userid}'='' THEN 1=1\r\n\t\t\t\t\tELSE FIND_IN_SET(b.smownerid,'{userid}') OR b.smownerid IS NULL\r\n\t\t\t\tEND)\r\n\t\t\tAND (\r\n\t\t\t\t\tCASE \r\n\t\t\t\t\t\tWHEN '{type}' IN (1,2) THEN YEAR(a.date)=YEAR(DATE_FORMAT('{start_date}','%Y-%m-%d'))\r\n\t\t\t\t\t\tWHEN '{type}' IN (3,4,5) THEN \r\n\t\t\t\t\t\t\ta.date BETWEEN date(concat(YEAR(DATE_FORMAT('{start_date}','%Y-%m-%d')),'-',elt(QUARTER(DATE_FORMAT('{start_date}','%Y-%m-%d')),1,4,7,10),'-',1))\r\n\t\t\t\t\t\t\t\t\t\t\tAND LAST_DAY(MAKEDATE(EXTRACT(YEAR FROM DATE_FORMAT('{start_date}','%Y-%m-%d')),1) + INTERVAL QUARTER(DATE_FORMAT('{start_date}','%Y-%m-%d'))*3-1 month)\r\n\t\t\t\t\t\tWHEN '{type}' IN (6,7) THEN\r\n\t\t\t\t\t\t\ta.date BETWEEN date_add(DATE_FORMAT('{start_date}','%Y-%m-%d'), INTERVAL - DAY(DATE_FORMAT('{start_date}','%Y-%m-%d')) + 1 DAY)\r\n\t\t\t\t\t\t\t\t\t\t\tAND last_day(DATE_FORMAT('{start_date}','%Y-%m-%d'))\r\n\t\t\t\t\t\tWHEN '{type}'=8 THEN \r\n\t\t\t\t\t\t\ta.date between date_sub(date(DATE_FORMAT('{start_date}','%Y-%m-%d')),INTERVAL weekday(DATE_FORMAT('{start_date}','%Y-%m-%d'))+1 DAY)\r\n\t\t\t\t\t\t\t\t\t\t\tAND date_sub(date(DATE_FORMAT('{start_date}','%Y-%m-%d')),INTERVAL weekday(DATE_FORMAT('{start_date}','%Y-%m-%d'))-5 DAY)\r\n\t\t\t\t\tEND)\r\n\t\t) a\r\n\tGROUP BY remark) a\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\ta.date,\r\n\t\tremark,\r\n\t\tsum(total) AS total_bef\r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\ta.date,\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{type}'=1 THEN CONCAT(QUARTER(a.date),'季度')\r\n\t\t\t\tWHEN '{type}'=2 THEN DATE_FORMAT(a.date,'%m月')\r\n\t\t\t\tWHEN '{type}'=3 THEN concat('第',month(a.date)-month(date_sub(concat(year(DATE_FORMAT('{start_date}','%Y-%m-%d')),'-',elt(quarter(DATE_FORMAT('{start_date}','%Y-%m-%d')),1,4,7,10),'-',1),interval 3 month))+1,'月')\r\n\t\t\t\tWHEN '{type}'=4 THEN concat('第',week(a.date)-week(date_sub(concat(year(DATE_FORMAT('{start_date}','%Y-%m-%d')),'-',elt(quarter(DATE_FORMAT('{start_date}','%Y-%m-%d')),1,4,7,10),'-',1),interval 3 month))+1,'周')\r\n\t\t\t\tWHEN '{type}'=5 THEN concat('第',DATEDIFF(a.date,date_sub(concat(year(DATE_FORMAT('{start_date}','%Y-%m-%d')),'-',elt(quarter(DATE_FORMAT('{start_date}','%Y-%m-%d')),1,4,7,10),'-',1),interval 3 month))+1,'天')\r\n\t\t\t\tWHEN '{type}'=6 THEN concat('第',week(a.date)-week(date_sub(date_add(DATE_FORMAT('{start_date}','%Y-%m-%d'), interval - day(DATE_FORMAT('{start_date}','%Y-%m-%d')) + 1 day),interval 1 month))+1,'周')\r\n\t\t\t\tWHEN '{type}'=7 THEN concat('第',day(a.date)-day(date_sub(date_add(DATE_FORMAT('{start_date}','%Y-%m-%d'), interval - day(DATE_FORMAT('{start_date}','%Y-%m-%d')) + 1 day),interval 1 month))+1,'天')\r\n\t\t\t\tWHEN '{type}'=8 THEN concat('第',day(a.date)-day(date_sub(date(DATE_FORMAT('{start_date}','%Y-%m-%d')),INTERVAL weekday(DATE_FORMAT('{start_date}','%Y-%m-%d'))+8 day))+1,'天')\r\n\t\t\tEND AS remark,\t\r\n\t\t\tCASE\r\n\t\t\t\tWHEN b.salesorderid>0 THEN 1\r\n\t\t\t\tELSE 0\r\n\t\t\tEND AS Total\r\n\t\tFROM tmp_date a\r\n\t\tLEFT JOIN (\r\n\t\t\tSELECT\r\n\t\t\t\ta.salesorderid,\r\n\t\t\t\ta.signed_data,\r\n\t\t\t\ta.total,\r\n\t\t\t\ta.conversion_rate,\r\n\t\t\t\ta.smownerid\r\n\t\t\tFROM ld_salesorder a\r\n\t\t\tLEFT JOIN ld_account k ON k.accountid=a.accountid\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{approve}'='true' THEN a.approvestatus='已批准'\r\n\t\t\t\t\t\tELSE 1=1\r\n\t\t\t\t\tEND)\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN TRIM('{custname}')='' THEN 1=1\r\n\t\t\t\t\t\tELSE LOCATE(TRIM('{custname}'),k.accountname)>0\r\n\t\t\t\t\tEND) \r\n\t\t\tUNION ALL\r\n\t\t\tSELECT\r\n\t\t\t\ta.servicecontractsid,\r\n\t\t\t\ta.due_date,\r\n\t\t\t\ta.total,\r\n\t\t\t\ta.conversion_rate,\r\n\t\t\t\ta.smownerid\r\n\t\t\tFROM ld_servicecontracts a\r\n\t\t\tLEFT JOIN ld_account k ON k.accountid=a.accountid\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{approve}'='true' THEN a.approvestatus='已批准'\r\n\t\t\t\t\t\tELSE 1=1\r\n\t\t\t\t\tEND)\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN TRIM('{custname}')='' THEN 1=1\r\n\t\t\t\t\t\tELSE LOCATE(TRIM('{custname}'),k.accountname)>0\r\n\t\t\t\t\tEND) \r\n\t\t) b on a.date=b.signed_data\r\n\t\tINNER JOIN (\r\n\t\t\tSELECT DISTINCT\r\n\t\t\t\tuserid \r\n\t\t\tFROM (\r\n\t\t\t\tSELECT \r\n\t\t\t\t\tld_users.id AS userid \r\n\t\t\t\tFROM ld_users\r\n\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename IN ('SalesOrder','ServiceContracts') and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT \r\n\t\t\t\t\tviewid AS userid \r\n\t\t\t\tFROM ld_scoperhigher\r\n\t\t\t\tWHERE userid='[uuid]' AND modulename IN ('SalesOrder','ServiceContracts') AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename IN ('SalesOrder','ServiceContracts'))\t\t\t\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT DISTINCT \r\n\t\t\t\t\tld_users2group.userid AS userid \r\n\t\t\t\tFROM ld_scoperhigher \r\n\t\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\t\tAND ld_scoperhigher.modulename IN ('SalesOrder','ServiceContracts')\r\n\t\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename IN ('SalesOrder','ServiceContracts') AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\t\tUNION \r\n\t\t\t\tSELECT \r\n\t\t\t\t\tid AS userid \r\n\t\t\t\tFROM ld_users  \r\n\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT '[uuid]') AS vw_users\r\n\t\t) AS tmp_users ON tmp_users.userid=b.smownerid\r\n\t\tWHERE 1=1\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{userid}'='' THEN 1=1\r\n\t\t\t\t\tELSE FIND_IN_SET(b.smownerid,'{userid}') OR b.smownerid IS NULL\r\n\t\t\t\tEND)\r\n\t\t\tAND (\r\n\t\t\t\tCASE \r\n\t\t\t\t\tWHEN '{type}' IN (1,2) THEN YEAR(a.date)=YEAR(DATE_FORMAT('{start_date}','%Y-%m-%d'))-1\r\n\t\t\t\t\tWHEN '{type}' IN (3,4,5) THEN \r\n\t\t\t\t\t\ta.date BETWEEN date_sub(concat(YEAR(DATE_FORMAT('{start_date}','%Y-%m-%d')),'-',elt(quarter(DATE_FORMAT('{start_date}','%Y-%m-%d')),1,4,7,10),'-',1),interval 3 month)\r\n\t\t\t\t\t\t\t\t\t\tAND LAST_DAY(MAKEDATE(EXTRACT(YEAR FROM DATE_FORMAT('{start_date}','%Y-%m-%d')),1) + interval QUARTER(DATE_FORMAT('{start_date}','%Y-%m-%d'))*3-4 month)\r\n\t\t\t\t\tWHEN '{type}' IN (6,7) THEN\r\n\t\t\t\t\t\ta.date BETWEEN date_sub(date_add(DATE_FORMAT('{start_date}','%Y-%m-%d'), INTERVAL - day(DATE_FORMAT('{start_date}','%Y-%m-%d')) + 1 day),interval 1 month)\r\n\t\t\t\t\t\t\t\t\t\tAND date_sub(last_day(DATE_FORMAT('{start_date}','%Y-%m-%d')),INTERVAL 1 month)\r\n\t\t\t\t\tWHEN '{type}'=8 THEN \r\n\t\t\t\t\t\ta.date BETWEEN date_sub(date(DATE_FORMAT('{start_date}','%Y-%m-%d')),INTERVAL weekday(DATE_FORMAT('{start_date}','%Y-%m-%d'))+8 day)\r\n\t\t\t\t\t\t\t\t\t\tAND date_sub(date(DATE_FORMAT('{start_date}','%Y-%m-%d')),INTERVAL weekday(DATE_FORMAT('{start_date}','%Y-%m-%d'))+2 day)\r\n\t\t\t\tEND)\r\n\t\t) a\r\n\tGROUP BY remark) b on a.remark=b.remark\r\nORDER BY a.date"
      },
