            "NameInSource": "10_huancaiyouge",
            "Alias": "10_huancaiyouge",
            "Type": "System.String"
          },
          "10": {
            "Name": "11_kongqi",
            "Index": -1,
            "NameInSource": "11_kongqi",
            "Alias": "11_kongqi",
            "Type": "System.String"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\tDATE_FORMAT(a.startdate,'%y/%c月') AS 01_qufen,\r\n\tc.projectname AS 02_chepai,\r\n\tIFNULL(b.cf_2970,'') AS 03_baoyangfee,\r\n\tIFNULL(b.cf_2971,'') AS 04_yanghufee,\r\n\tIFNULL(b.cf_2972,'') AS 05_jiyoufee,\r\n\tIFNULL(b.cf_2973,'') AS 06_huanjiyou,\r\n\tIFNULL(b.cf_2974,'') AS 07_huanjiyouge,\r\n\tIFNULL(b.cf_2975,'') AS 08_dahuangyou,\r\n\tIFNULL(b.cf_2976,'') AS 09_silunbaoyang,\r\n\tIFNULL(b.cf_2977,'') AS 10_huancaiyouge,\r\n\tIFNULL(b.cf_2978,'') AS 11_kongqi\r\nFROM ld_projecttask a\r\nLEFT JOIN ld_projecttaskcf b ON b.projecttaskid=a.projecttaskid\r\nLEFT JOIN ld_project c ON c.projectid=a.projectid\r\nWHERE a.deleted=0\r\n\tAND a.projectid>0\r\n\tAND a.projecttaskstatus='保养'\r\n\tAND a.startdate BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN TRIM('{chepai}')='' THEN 1=1\r\n\t\t\tELSE LOCATE(TRIM('{chepai}'),c.projectname)>0\r\n\t\tEND) \r\nORDER BY c.projectname,a.startdate"
      },
      "3": {
        "Ident": "StiMySqlSource",
        "Name": "d",
        "Alias": "d",
        "Columns": {
          "0": {
            "Name": "chart_type",
            "Index": -1,
            "NameInSource": "chart_type",
            "Alias": "chart_type",
            "Type": "System.String"
          },
          "1": {
            "Name": "chart_value1",
            "Index": -1,
            "NameInSource": "chart_value1",
            "Alias": "chart_value1",
            "Type": "System.Decimal"
          },
          "2": {
            "Name": "chart_value2",
            "Index": -1,
            "NameInSource": "chart_value2",
            "Alias": "chart_value2",
            "Type": "System.Decimal"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\tc.projectname AS chart_type,\r\n\tSUM(IFNULL(b.cf_2971,0)) AS chart_value1,\r\n\tSUM(IFNULL(b.cf_2972,0)) AS chart_value2\r\nFROM ld_projecttask a\r\nLEFT JOIN ld_projecttaskcf b ON b.projecttaskid=a.projecttaskid\r\nLEFT JOIN ld_project c ON c.projectid=a.projectid\r\nWHERE a.deleted=0\r\n\tAND a.projectid>0\r\n\tAND a.projecttaskstatus='保养'\r\n\tAND a.startdate BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN TRIM('{chepai}')='' THEN 1=1\r\n\t\t\tELSE LOCATE(TRIM('{chepai}'),c.projectname)>0\r\n\t\tEND) \r\nGROUP BY a.projectid\r\nORDER BY c.projectname"
      }
    },
