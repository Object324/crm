          },
          "5": {
            "Name": "06_weixiudetail",
            "Index": -1,
            "NameInSource": "06_weixiudetail",
            "Alias": "06_weixiudetail",
            "Type": "System.String"
          },
          "6": {
            "Name": "07_weixiufee",
            "Index": -1,
            "NameInSource": "07_weixiufee",
            "Alias": "07_weixiufee",
            "Type": "System.Decimal"
          },
          "7": {
            "Name": "08_stopday",
            "Index": -1,
            "NameInSource": "08_stopday",
            "Alias": "08_stopday",
            "Type": "System.String"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\tDATE_FORMAT(a.startdate,'%y/%c月') AS 01_qufen,\r\n\tc.projectname AS 02_chepai,\r\n\tDAY(a.startdate) AS 03_fashengdate,\r\n\ta.projecttasktype AS 04_guzhangtype,\r\n\tDATE_FORMAT(a.actualenddate,'%Y-%c-%e') AS 05_weixiudate,\r\n\ta.workcontent AS 06_weixiudetail,\r\n\tROUND(b.cf_2969,0) AS 07_weixiufee,\r\n\tb.cf_2968 AS 08_stopday\r\nFROM ld_projecttask a\r\nLEFT JOIN ld_projecttaskcf b ON b.projecttaskid=a.projecttaskid\r\nLEFT JOIN ld_project c ON c.projectid=a.projectid\r\nWHERE a.deleted=0\r\n\tAND a.projectid>0\r\n\tAND a.projecttaskstatus='维修'\r\n\tAND a.startdate BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN TRIM('{chepai}')='' THEN 1=1\r\n\t\t\tELSE LOCATE(TRIM('{chepai}'),c.projectname)>0\r\n\t\tEND) \r\nORDER BY c.projectname,a.actualenddate"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "b",
        "Alias": "b",
        "Columns": {
          "0": {
            "Name": "chart_value1",
            "Index": -1,
            "NameInSource": "chart_value1",
            "Alias": "chart_value1",
            "Type": "System.Int32"
          },
          "1": {
            "Name": "chart_value2",
            "Index": -1,
            "NameInSource": "chart_value2",
            "Alias": "chart_value2",
            "Type": "System.Decimal"
          },
          "2": {
            "Name": "chart_value3",
            "Index": -1,
            "NameInSource": "chart_value3",
            "Alias": "chart_value3",
            "Type": "System.Decimal"
          },
          "3": {
            "Name": "chatrt_type",
            "Index": -1,
            "NameInSource": "chatrt_type",
            "Alias": "chatrt_type",
            "Type": "System.String"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\tc.projectname AS chatrt_type,\r\n\tCOUNT(a.projectid) AS chart_value1,\r\n\tSUM(ROUND(b.cf_2969,0)) AS chart_value2,\r\n\tSUM(b.cf_2968) AS chart_value3\r\nFROM ld_projecttask a\r\nLEFT JOIN ld_projecttaskcf b ON b.projecttaskid=a.projecttaskid\r\nLEFT JOIN ld_project c ON c.projectid=a.projectid\r\nWHERE a.deleted=0\r\n\tAND a.projectid>0\r\n\tAND a.projecttaskstatus='维修'\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN TRIM('{chepai}')='' THEN 1=1\r\n\t\t\tELSE LOCATE(TRIM('{chepai}'),c.projectname)>0\r\n\t\tEND)\r\nGROUP BY a.projectid\r\nORDER BY c.projectname"
      },
      "2": {
