        "NameInSource": "ldcrm ",
        "SqlCommand": "SELECT\r\n\tb.*,\r\n\tCASE \r\n\t\tWHEN '{yue}'=1 THEN b.m01 \r\n\t\tWHEN '{yue}'=2 THEN b.m02\r\n\t\tWHEN '{yue}'=3 THEN b.m03\r\n\t\tWHEN '{yue}'=4 THEN b.m04\r\n\t\tWHEN '{yue}'=5 THEN b.m05\r\n\t\tWHEN '{yue}'=6 THEN b.m06\r\n\t\tWHEN '{yue}'=7 THEN b.m07\r\n\t\tWHEN '{yue}'=8 THEN b.m08\r\n\t\tWHEN '{yue}'=9 THEN b.m09\r\n\t\tWHEN '{yue}'=10 THEN b.m10\r\n\t\tWHEN '{yue}'=11 THEN b.m11\r\n\t\tWHEN '{yue}'=12 THEN b.m12\r\n\tEND AS m00\r\nFROM sequence a\r\nCROSS JOIN (\r\n\tSELECT\r\n\t\tROUND(SUM(m01*0.0001),2) AS m01,\r\n\t\tROUND(SUM(m02*0.0001),2) AS m02,\r\n\t\tROUND(SUM(m03*0.0001),2) AS m03,\r\n\t\tROUND(SUM(m01*0.0001),2)+ROUND(SUM(m02*0.0001),2)+ROUND(SUM(m03*0.0001),2) AS Q1,\r\n\r\n\t\tROUND(SUM(m04*0.0001),2) AS m04,\r\n\t\tROUND(SUM(m05*0.0001),2) AS m05,\r\n\t\tROUND(SUM(m06*0.0001),2) AS m06,\r\n\t\tROUND(SUM(m04*0.0001),2)+ROUND(SUM(m05*0.0001),2)+ROUND(SUM(m06*0.0001),2) AS Q2,\r\n\r\n\t\tROUND(SUM(m07*0.0001),2) AS m07,\r\n\t\tROUND(SUM(m08*0.0001),2) AS m08,\r\n\t\tROUND(SUM(m09*0.0001),2) AS m09,\r\n\t\tROUND(SUM(m07*0.0001),2)+ROUND(SUM(m08*0.0001),2)+ROUND(SUM(m09*0.0001),2) AS Q3,\r\n\r\n\t\tROUND(SUM(m10*0.0001),2) AS m10,\r\n\t\tROUND(SUM(m11*0.0001),2) AS m11,\r\n\t\tROUND(SUM(m12*0.0001),2) AS m12,\r\n\t\tROUND(SUM(m10*0.0001),2)+ROUND(SUM(m11*0.0001),2)+ROUND(SUM(m12*0.0001),2) AS Q4,\r\n\r\n\t\tROUND(SUM(m01*0.0001),2)+ROUND(SUM(m02*0.0001),2)+ROUND(SUM(m03*0.0001),2)\r\n\t\t+ROUND(SUM(m04*0.0001),2)+ROUND(SUM(m05*0.0001),2)+ROUND(SUM(m06*0.0001),2)\r\n\t\t+ROUND(SUM(m07*0.0001),2)+ROUND(SUM(m08*0.0001),2)+ROUND(SUM(m09*0.0001),2)\r\n\t\t+ROUND(SUM(m10*0.0001),2)+ROUND(SUM(m11*0.0001),2)+ROUND(SUM(m12*0.0001),2) AS total\r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.createdtime)=1 AND b.cf_4809=0 THEN a.total \r\n\t\t\t\tWHEN MONTH(a.createdtime)=1 AND b.cf_4809=1 THEN a.total*0.01*IFNULL(b.cf_4816,0) \r\n\t\t\t\tELSE 0\r\n\t\t\tEND) AS m01,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.createdtime)=2 AND b.cf_4809=0 THEN a.total \r\n\t\t\t\tWHEN MONTH(a.createdtime)=2 AND b.cf_4809=1 THEN a.total*0.01*IFNULL(b.cf_4816,0) \r\n\t\t\t\tELSE 0\r\n\t\t\tEND) AS m02,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.createdtime)=3 AND b.cf_4809=0 THEN a.total \r\n\t\t\t\tWHEN MONTH(a.createdtime)=3 AND b.cf_4809=1 THEN a.total*0.01*IFNULL(b.cf_4816,0) \r\n\t\t\t\tELSE 0\r\n\t\t\tEND) AS m03,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.createdtime)=4 AND b.cf_4809=0 THEN a.total \r\n\t\t\t\tWHEN MONTH(a.createdtime)=4 AND b.cf_4809=1 THEN a.total*0.01*IFNULL(b.cf_4816,0) \r\n\t\t\t\tELSE 0\r\n\t\t\tEND) AS m04,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.createdtime)=5 AND b.cf_4809=0 THEN a.total \r\n\t\t\t\tWHEN MONTH(a.createdtime)=5 AND b.cf_4809=1 THEN a.total*0.01*IFNULL(b.cf_4816,0) \r\n\t\t\t\tELSE 0\r\n\t\t\tEND) AS m05,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.createdtime)=6 AND b.cf_4809=0 THEN a.total \r\n\t\t\t\tWHEN MONTH(a.createdtime)=6 AND b.cf_4809=1 THEN a.total*0.01*IFNULL(b.cf_4816,0) \r\n\t\t\t\tELSE 0\r\n\t\t\tEND) AS m06,\r\n\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.createdtime)=7 AND b.cf_4809=0 THEN a.total \r\n\t\t\t\tWHEN MONTH(a.createdtime)=7 AND b.cf_4809=1 THEN a.total*0.01*IFNULL(b.cf_4816,0) \r\n\t\t\t\tELSE 0\r\n\t\t\tEND) AS m07,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.createdtime)=8 AND b.cf_4809=0 THEN a.total \r\n\t\t\t\tWHEN MONTH(a.createdtime)=8 AND b.cf_4809=1 THEN a.total*0.01*IFNULL(b.cf_4816,0) \r\n\t\t\t\tELSE 0\r\n\t\t\tEND) AS m08,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.createdtime)=9 AND b.cf_4809=0 THEN a.total \r\n\t\t\t\tWHEN MONTH(a.createdtime)=9 AND b.cf_4809=1 THEN a.total*0.01*IFNULL(b.cf_4816,0) \r\n\t\t\t\tELSE 0\r\n\t\t\tEND) AS m09,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.createdtime)=10 AND b.cf_4809=0 THEN a.total \r\n\t\t\t\tWHEN MONTH(a.createdtime)=10 AND b.cf_4809=1 THEN a.total*0.01*IFNULL(b.cf_4816,0) \r\n\t\t\t\tELSE 0\r\n\t\t\tEND) AS m10,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.createdtime)=11 AND b.cf_4809=0 THEN a.total \r\n\t\t\t\tWHEN MONTH(a.createdtime)=11 AND b.cf_4809=1 THEN a.total*0.01*IFNULL(b.cf_4816,0) \r\n\t\t\t\tELSE 0\r\n\t\t\tEND) AS m11,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.createdtime)=12 AND b.cf_4809=0 THEN a.total \r\n\t\t\t\tWHEN MONTH(a.createdtime)=12 AND b.cf_4809=1 THEN a.total*0.01*IFNULL(b.cf_4816,0) \r\n\t\t\t\tELSE 0\r\n\t\t\tEND) AS m12\r\n\t\tFROM ld_salesorder a\r\n\t\tLEFT JOIN ld_salesordercf b ON b.salesorderid=a.salesorderid\r\n\t\tINNER JOIN (\r\n\t\t\tSELECT\r\n\t\t\t\ta.id\r\n\t\t\tFROM ld_users a\r\n\t\t\tLEFT JOIN ld_users2group b ON b.userid=a.id\r\n\t\t\tLEFT JOIN ld_groups c ON c.groupid=b.groupid\r\n\t\t\tLEFT JOIN ld_groups d ON d.groupid=c.parentid\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.userlevel IN ('销售经理','分公司经理','分公司副经理','办事处经理','大区经理','大区副经理')\r\n\t\t\t\tAND c.parentgroup LIKE '1::2::7::%' \r\n\t\t\t\tAND d.parentgroup LIKE '1::2::7::%'\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{fanwei}'='' THEN 1=1 \r\n\t\t\t\t\t\tWHEN '{fangshi}'=3 THEN FIND_IN_SET(a.id,'{fanwei}')\r\n\t\t\t\t\t\tWHEN '{fangshi}'=2 THEN FIND_IN_SET(c.groupid,'{fanwei}')\r\n\t\t\t\t\t\tWHEN '{fangshi}'=1 THEN FIND_IN_SET(d.groupid,'{fanwei}')\r\n\t\t\t\t\tEND)\r\n\t\t\tGROUP BY a.id\r\n\t\t) c ON c.id=a.smownerid\r\n\t\tINNER JOIN (\r\n\t\t\tSELECT DISTINCT\r\n\t\t\t\tuserid \r\n\t\t\tFROM (\r\n\t\t\t\tSELECT \r\n\t\t\t\t\tld_users.id AS userid \r\n\t\t\t\tFROM ld_users\r\n\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='SalesOrder' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT \r\n\t\t\t\t\tviewid AS userid \r\n\t\t\t\tFROM ld_scoperhigher\r\n\t\t\t\tWHERE userid='[uuid]' AND modulename ='SalesOrder' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename ='SalesOrder')\t\t\t\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT DISTINCT \r\n\t\t\t\t\tld_users2group.userid AS userid \r\n\t\t\t\tFROM ld_scoperhigher \r\n\t\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\t\tAND ld_scoperhigher.modulename ='SalesOrder'\r\n\t\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='SalesOrder' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\t\tUNION \r\n\t\t\t\tSELECT \r\n\t\t\t\t\tid AS userid \r\n\t\t\t\tFROM ld_users  \r\n\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT '[uuid]') AS vw_users\r\n\t\t) AS tmp_users ON tmp_users.userid=c.id\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus='已批准'\r\n\t\t\tAND YEAR(a.createdtime)='{nian}'-1\r\n\t\t\tAND a.smownerid>0\r\n\t\tUNION ALL\r\n\t\tSELECT\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.createdtime)=1 THEN a.total*0.01*IFNULL(b.cf_4811,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS m01,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.createdtime)=2 THEN a.total*0.01*IFNULL(b.cf_4811,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS m02,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.createdtime)=3 THEN a.total*0.01*IFNULL(b.cf_4811,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS m03,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.createdtime)=4 THEN a.total*0.01*IFNULL(b.cf_4811,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS m04,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.createdtime)=5 THEN a.total*0.01*IFNULL(b.cf_4811,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS m05,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.createdtime)=6 THEN a.total*0.01*IFNULL(b.cf_4811,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS m06,\r\n\r\n\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.createdtime)=7 THEN a.total*0.01*IFNULL(b.cf_4811,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS m07,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.createdtime)=8 THEN a.total*0.01*IFNULL(b.cf_4811,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS m08,\r\n