\t\t\t\tWHEN MONTH(a.shengxiao_time)=3 THEN a.total*0.01*IFNULL(b.cf_4811,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS m03,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.shengxiao_time)=4 THEN a.total*0.01*IFNULL(b.cf_4811,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS m04,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.shengxiao_time)=5 THEN a.total*0.01*IFNULL(b.cf_4811,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS m05,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.shengxiao_time)=6 THEN a.total*0.01*IFNULL(b.cf_4811,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS m06,\r\n\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.shengxiao_time)=7 THEN a.total*0.01*IFNULL(b.cf_4811,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS m07,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.shengxiao_time)=8 THEN a.total*0.01*IFNULL(b.cf_4811,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS m08,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.shengxiao_time)=9 THEN a.total*0.01*IFNULL(b.cf_4811,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS m09,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.shengxiao_time)=10 THEN a.total*0.01*IFNULL(b.cf_4811,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS m10,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.shengxiao_time)=11 THEN a.total*0.01*IFNULL(b.cf_4811,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS m11,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.shengxiao_time)=12 THEN a.total*0.01*IFNULL(b.cf_4811,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS m12\r\n\t\tFROM ld_salesorder a\r\n\t\tLEFT JOIN ld_salesordercf b ON b.salesorderid=a.salesorderid\r\n\t\tLEFT JOIN ld_groups c ON c.groupid=a.department\r\n\t\tLEFT JOIN ld_groups d ON d.groupid=c.parentid\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus='已批准'\r\n\t\t\tAND a.sostatus='已生效'\r\n\t\t\tAND YEAR(a.shengxiao_time)='{nian}'\r\n\t\t\tAND b.cf_4809=1\r\n\t\t\tAND a.department>0\r\n\t\t\tAND IFNULL(b.cf_4989,0)=0\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{fangshi}'=3 THEN 1=0\r\n\t\t\t\t\tWHEN '{fangshi}'=1 AND '{fanwei}'='' THEN d.groupid IN (SELECT f.groupid FROM ld_groups f LEFT JOIN ld_picklist_values e ON e.listid=107 AND e.listvalue=f.groupname WHERE f.parentgroup like '1::2::7::%' AND depth=3 GROUP BY f.groupid)\r\n\t\t\t\t\tWHEN '{fangshi}'=1 THEN FIND_IN_SET(d.groupid,'{fanwei}')\r\n\t\t\t\t\tWHEN '{fangshi}'=2 AND '{fanwei}'='' THEN 1=1 \r\n\t\t\t\t\tWHEN '{fangshi}'=2 THEN FIND_IN_SET(c.groupid,'{fanwei}')\r\n\t\t\t\tEND)\r\n\t\tUNION ALL\r\n\t\tSELECT\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.shengxiao_time)=1 THEN a.total*0.01*IFNULL(b.cf_4813,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS m01,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.shengxiao_time)=2 THEN a.total*0.01*IFNULL(b.cf_4813,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS m02,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.shengxiao_time)=3 THEN a.total*0.01*IFNULL(b.cf_4813,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS m03,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.shengxiao_time)=4 THEN a.total*0.01*IFNULL(b.cf_4813,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS m04,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.shengxiao_time)=5 THEN a.total*0.01*IFNULL(b.cf_4813,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS m05,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.shengxiao_time)=6 THEN a.total*0.01*IFNULL(b.cf_4813,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS m06,\r\n\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.shengxiao_time)=7 THEN a.total*0.01*IFNULL(b.cf_4813,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS m07,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.shengxiao_time)=8 THEN a.total*0.01*IFNULL(b.cf_4813,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS m08,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.shengxiao_time)=9 THEN a.total*0.01*IFNULL(b.cf_4813,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS m09,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.shengxiao_time)=10 THEN a.total*0.01*IFNULL(b.cf_4813,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS m10,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.shengxiao_time)=11 THEN a.total*0.01*IFNULL(b.cf_4813,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS m11,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.shengxiao_time)=12 THEN a.total*0.01*IFNULL(b.cf_4813,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS m12\r\n\t\tFROM ld_salesorder a\r\n\t\tLEFT JOIN ld_salesordercf b ON b.salesorderid=a.salesorderid\r\n\t\tLEFT JOIN ld_groups c ON c.groupid=a.department1\r\n\t\tLEFT JOIN ld_groups d ON d.groupid=c.parentid\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus='已批准'\r\n\t\t\tAND a.sostatus='已生效'\r\n\t\t\tAND YEAR(a.shengxiao_time)='{nian}'\r\n\t\t\tAND b.cf_4809=1\r\n\t\t\tAND a.department1>0\r\n\t\t\tAND IFNULL(b.cf_4990,0)=0\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{fangshi}'=3 THEN 1=0\r\n\t\t\t\t\tWHEN '{fangshi}'=1 AND '{fanwei}'='' THEN d.groupid IN (SELECT f.groupid FROM ld_groups f LEFT JOIN ld_picklist_values e ON e.listid=107 AND e.listvalue=f.groupname WHERE f.parentgroup like '1::2::7::%' AND depth=3 GROUP BY f.groupid)\r\n\t\t\t\t\tWHEN '{fangshi}'=1 THEN FIND_IN_SET(d.groupid,'{fanwei}')\r\n\t\t\t\t\tWHEN '{fangshi}'=2 AND '{fanwei}'='' THEN 1=1 \r\n\t\t\t\t\tWHEN '{fangshi}'=2 THEN FIND_IN_SET(c.groupid,'{fanwei}')\r\n\t\t\t\tEND)\r\n\t\tUNION ALL\r\n\t\tSELECT\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.shengxiao_time)=1 THEN a.total*0.01*IFNULL(b.cf_4815,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS m01,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.shengxiao_time)=2 THEN a.total*0.01*IFNULL(b.cf_4815,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS m02,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.shengxiao_time)=3 THEN a.total*0.01*IFNULL(b.cf_4815,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS m03,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.shengxiao_time)=4 THEN a.total*0.01*IFNULL(b.cf_4815,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS m04,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.shengxiao_time)=5 THEN a.total*0.01*IFNULL(b.cf_4815,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS m05,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.shengxiao_time)=6 THEN a.total*0.01*IFNULL(b.cf_4815,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS m06,\r\n\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.shengxiao_time)=7 THEN a.total*0.01*IFNULL(b.cf_4815,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS m07,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.shengxiao_time)=8 THEN a.total*0.01*IFNULL(b.cf_4815,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS m08,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.shengxiao_time)=9 THEN a.total*0.01*IFNULL(b.cf_4815,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS m09,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.shengxiao_time)=10 THEN a.total*0.01*IFNULL(b.cf_4815,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS m10,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.shengxiao_time)=11 THEN a.total*0.01*IFNULL(b.cf_4815,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS m11,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN MONTH(a.shengxiao_time)=12 THEN a.total*0.01*IFNULL(b.cf_4815,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS m12\r\n\t\tFROM ld_salesorder a\r\n\t\tLEFT JOIN ld_salesordercf b ON b.salesorderid=a.salesorderid\r\n\t\tLEFT JOIN ld_groups c ON c.groupid=a.department2\r\n\t\tLEFT JOIN ld_groups d ON d.groupid=c.parentid\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus='已批准'\r\n\t\t\tAND a.sostatus='已生效'\r\n\t\t\tAND YEAR(a.shengxiao_time)='{nian}'\r\n\t\t\tAND b.cf_4809=1\r\n\t\t\tAND a.department2>0\r\n\t\t\tAND IFNULL(b.cf_4991,0)=0\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{fangshi}'=3 THEN 1=0\r\n\t\t\t\t\tWHEN '{fangshi}'=1 AND '{fanwei}'='' THEN d.groupid IN (SELECT f.groupid FROM ld_groups f LEFT JOIN ld_picklist_values e ON e.listid=107 AND e.listvalue=f.groupname WHERE f.parentgroup like '1::2::7::%' AND depth=3 GROUP BY f.groupid)\r\n\t\t\t\t\tWHEN '{fangshi}'=1 THEN FIND_IN_SET(d.groupid,'{fanwei}')\r\n\t\t\t\t\tWHEN '{fangshi}'=2 AND '{fanwei}'='' THEN 1=1 \r\n\t\t\t\t\tWHEN '{fangshi}'=2 THEN FIND_IN_SET(c.groupid,'{fanwei}')\r\n\t\t\t\tEND)\r\n\t\t\t\t\r\n\t) a\r\n) b\r\nWHERE seq=1"
