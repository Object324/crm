        "NameInSource": "ldcrm ",
        "SqlCommand": "SELECT\r\n\tROUND(SUM(m01*0.0001),2) AS m01,\r\n\tROUND(SUM(m02*0.0001),2) AS m02,\r\n\tROUND(SUM(m03*0.0001),2) AS m03,\r\n\tROUND(SUM(m01*0.0001),2)+ROUND(SUM(m02*0.0001),2)+ROUND(SUM(m03*0.0001),2) AS Q1,\r\n\r\n\tROUND(SUM(m04*0.0001),2) AS m04,\r\n\tROUND(SUM(m05*0.0001),2) AS m05,\r\n\tROUND(SUM(m06*0.0001),2) AS m06,\r\n\tROUND(SUM(m04*0.0001),2)+ROUND(SUM(m05*0.0001),2)+ROUND(SUM(m06*0.0001),2) AS Q2,\r\n\r\n\tROUND(SUM(m07*0.0001),2) AS m07,\r\n\tROUND(SUM(m08*0.0001),2) AS m08,\r\n\tROUND(SUM(m09*0.0001),2) AS m09,\r\n\tROUND(SUM(m07*0.0001),2)+ROUND(SUM(m08*0.0001),2)+ROUND(SUM(m09*0.0001),2) AS Q3,\r\n\r\n\tROUND(SUM(m10*0.0001),2) AS m10,\r\n\tROUND(SUM(m11*0.0001),2) AS m11,\r\n\tROUND(SUM(m12*0.0001),2) AS m12,\r\n\tROUND(SUM(m10*0.0001),2)+ROUND(SUM(m11*0.0001),2)+ROUND(SUM(m12*0.0001),2) AS Q4,\r\n\r\n\tROUND(SUM(m01*0.0001),2)+ROUND(SUM(m02*0.0001),2)+ROUND(SUM(m03*0.0001),2)\r\n\t+ROUND(SUM(m04*0.0001),2)+ROUND(SUM(m05*0.0001),2)+ROUND(SUM(m06*0.0001),2)\r\n\t+ROUND(SUM(m07*0.0001),2)+ROUND(SUM(m08*0.0001),2)+ROUND(SUM(m09*0.0001),2)\r\n\t+ROUND(SUM(m10*0.0001),2)+ROUND(SUM(m11*0.0001),2)+ROUND(SUM(m12*0.0001),2) AS total\r\nFROM sequence a\r\nCROSS JOIN (\r\n\tSELECT\r\n\t\tSUM(CASE WHEN a.targetmouth=1 THEN a.paymentamount ELSE 0 END) AS m01,\r\n\t\tSUM(CASE WHEN a.targetmouth=2 THEN a.paymentamount ELSE 0 END) AS m02,\r\n\t\tSUM(CASE WHEN a.targetmouth=3 THEN a.paymentamount ELSE 0 END) AS m03,\r\n\t\tSUM(CASE WHEN a.targetmouth=4 THEN a.paymentamount ELSE 0 END) AS m04,\r\n\t\tSUM(CASE WHEN a.targetmouth=5 THEN a.paymentamount ELSE 0 END) AS m05,\r\n\t\tSUM(CASE WHEN a.targetmouth=6 THEN a.paymentamount ELSE 0 END) AS m06,\r\n\r\n\t\tSUM(CASE WHEN a.targetmouth=7 THEN a.paymentamount ELSE 0 END) AS m07,\r\n\t\tSUM(CASE WHEN a.targetmouth=8 THEN a.paymentamount ELSE 0 END) AS m08,\r\n\t\tSUM(CASE WHEN a.targetmouth=9 THEN a.paymentamount ELSE 0 END) AS m09,\r\n\t\tSUM(CASE WHEN a.targetmouth=10 THEN a.paymentamount ELSE 0 END) AS m10,\r\n\t\tSUM(CASE WHEN a.targetmouth=11 THEN a.paymentamount ELSE 0 END) AS m11,\r\n\t\tSUM(CASE WHEN a.targetmouth=12 THEN a.paymentamount ELSE 0 END) AS m12\r\n\tFROM ld_salestarget a\r\n\tINNER JOIN (\r\n\t\tSELECT\r\n\t\t\ta.id\r\n\t\tFROM ld_users a\r\n\t\tLEFT JOIN ld_users2group b ON b.userid=a.id\r\n\t\tLEFT JOIN ld_groups c ON c.groupid=b.groupid\r\n\t\tLEFT JOIN ld_groups d ON d.groupid=c.parentid\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.userlevel IN ('销售经理','分公司经理','分公司副经理','办事处经理','大区经理','大区副经理')\r\n\t\t\tAND c.parentgroup LIKE '1::2::7::%' \r\n\t\t\tAND d.parentgroup LIKE '1::2::7::%'\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{fanwei}'='' THEN 1=1 \r\n\t\t\t\t\tWHEN '{fangshi}'=3 THEN FIND_IN_SET(a.id,'{fanwei}')\r\n\t\t\t\t\tWHEN '{fangshi}'=2 THEN FIND_IN_SET(c.groupid,'{fanwei}')\r\n\t\t\t\t\tWHEN '{fangshi}'=1 THEN FIND_IN_SET(d.groupid,'{fanwei}')\r\n\t\t\t\tEND)\r\n\t\tGROUP BY a.id\r\n\t) b ON b.id=a.userid\r\n\tINNER JOIN (\r\n\t\tSELECT DISTINCT\r\n\t\t\tuserid \r\n\t\tFROM (\r\n\t\t\tSELECT \r\n\t\t\t\tld_users.id AS userid \r\n\t\t\tFROM ld_users\r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='CashBill' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\tUNION\r\n\t\t\tSELECT \r\n\t\t\t\tviewid AS userid \r\n\t\t\tFROM ld_scoperhigher\r\n\t\t\tWHERE userid='[uuid]' AND modulename ='CashBill' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename ='CashBill')\t\t\t\r\n\t\t\tUNION\r\n\t\t\tSELECT DISTINCT \r\n\t\t\t\tld_users2group.userid AS userid \r\n\t\t\tFROM ld_scoperhigher \r\n\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\tAND ld_scoperhigher.modulename ='CashBill'\r\n\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='CashBill' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\tUNION \r\n\t\t\tSELECT \r\n\t\t\t\tid AS userid \r\n\t\t\tFROM ld_users  \r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\tUNION\r\n\t\t\tSELECT '[uuid]') AS vw_users\r\n\t) AS tmp_users ON tmp_users.userid=a.userid\r\n\tWHERE a.targetyear='{nian}'\r\n) b\r\nWHERE a.seq=1"
