        "NameInSource": "ldcrm",
        "Type": "Table",
        "SqlCommand": "select a.cashbilldate,\r\n\ta.cashbillid,\r\n\ta.accountid,c.accountname,\r\n\tround(a.subtotal,2)as total\r\n\tfrom ld_cashbill a inner join (select cashbillid from ld_cashbilldebuctiondetail group by cashbillid) b on a.cashbillid=b.cashbillid\r\n\tleft join ld_account c on a.accountid=c.accountid\r\n\twhere a.deleted=0  \r\n\tAND a.accountid='{this[\"id\"]}'\r\n\tAND a.accountid>0\r\n\tand a.cashtype!='debuction' \r\n\tAND IF(a.checkoutstatus='已审核','0','1') <> (IF('{approve}'='true','1','0.001'))\r\n\torder by cashbilldate desc "
      }
    },
