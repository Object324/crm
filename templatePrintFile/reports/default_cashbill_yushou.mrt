    "DataSources": {
      "0": {
        "Ident": "StiMySqlSource",
        "Name": "users",
        "Alias": "users",
        "Columns": {
          "0": {
            "Name": "id",
            "Index": -1,
            "NameInSource": "id",
            "Alias": "id",
            "Type": "System.Int32"
          },
          "1": {
            "Name": "last_name",
            "Index": -1,
            "NameInSource": "last_name",
            "Alias": "last_name",
            "Type": "System.String"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\ta.id,\r\n\ta.last_name\r\nFROM ld_users a\r\nINNER JOIN (\r\n\tSELECT DISTINCT\r\n\t\tuserid \r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\tld_users.id as userid \r\n\t\tFROM ld_users\r\n\t\tWHERE EXISTS(select 1 from ld_setscoperhigher where modulename='CashBill' and scopeauthority=1 and userid='[uuid]')\r\n\t\tUNION\r\n\t\tselect \r\n\t\t\tviewid as userid \r\n\t\tfrom ld_scoperhigher\r\n\t\twhere userid='[uuid]' and modulename='CashBill' and EXISTS(select 1 from ld_setscoperhigher where userid='[uuid]' and scopeauthority=2 and modulename='CashBill')\t\t\t\r\n\t\tUNION\r\n\t\tselect DISTINCT \r\n\t\t\tld_users2group.userid as userid \r\n\t\tfrom ld_scoperhigher \r\n\t\tINNER JOIN ld_groups on ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\tINNER JOIN ld_users2group on ld_users2group.groupid=ld_groups.groupid\r\n\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\tand ld_scoperhigher.modulename='CashBill'\r\n\t\t\tand ld_scoperhigher.scopeauthority=3 \r\n\t\t\tand EXISTS(select 1 from ld_setscoperhigher where modulename='CashBill' and scopeauthority=3 and userid='[uuid]')\r\n\t\tUNION \r\n\t\tselect \r\n\t\t\tid as userid \r\n\t\tfrom ld_users  \r\n\t\twhere exists(select 1 from ld_users where id='[uuid]' and is_admin='on')\r\n\t\tUNION\r\n\t\tselect '[uuid]')as vw_users\r\n) as tmp_users ON tmp_users.userid=a.id\r\norder by CONVERT(a.last_name USING gbk)"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "yushou",
        "Alias": "yushou",
        "Columns": {
          "0": {
            "Name": "accountid",
            "Index": -1,
            "NameInSource": "accountid",
            "Alias": "accountid",
            "Type": "System.Int32"
          },
          "1": {
            "Name": "accountname",
            "Index": -1,
            "NameInSource": "accountname",
            "Alias": "accountname",
            "Type": "System.String"
          },
          "2": {
            "Name": "cashbilldate",
            "Index": -1,
            "NameInSource": "cashbilldate",
            "Alias": "cashbilldate",
            "Type": "System.DateTime"
          },
          "3": {
            "Name": "cashbilldate1",
            "Index": -1,
            "NameInSource": "cashbilldate1",
            "Alias": "cashbilldate1",
            "Type": "System.DateTime"
          },
          "4": {
            "Name": "total",
            "Index": -1,
            "NameInSource": "total",
            "Alias": "total",
            "Type": "System.Decimal"
          },
          "5": {
            "Name": "total_rem",
            "Index": -1,
            "NameInSource": "total_rem",
            "Alias": "total_rem",
            "Type": "System.Decimal"
          },
          "6": {
            "Name": "total_used",
            "Index": -1,
            "NameInSource": "total_used",
            "Alias": "total_used",
            "Type": "System.Decimal"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\ta.accountid,\r\n\tc.accountname,\r\n\ta.cashbilldate as cashbilldate1,\r\n\ta.total,\r\n\t\r\n\td.cashbilldate,\r\n\ta.Total-ifnull(d.total_used,0)as total_rem,\r\n\td.total_used\r\nFROM (\r\n\tSELECT \r\n\t\ta.accountid,\r\n\t\ta.cashbilldate,\r\n\t\tsum(round(a.total/a.conversion_rate,2)) as total\r\n\tFROM (select * from ld_cashbill order by cashbilldate desc) a\r\n\tWHERE a.deleted=0\r\n\t\tAND a.accountid>0\r\n\t\tAND a.cashtype='debuction'\r\n\t\tAND IF(a.checkoutstatus='已审核','0','1') <> (IF('{approve}'='true','1','0.001'))\r\n\tGROUP BY a.accountid) a\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\taccountid,\r\n\t\tsum(round(amount,2)) total_rem\r\n\tFROM (\r\n\t\tselect accountid,round(debuctionbalanceamount/conversion_rate,2) as amount \r\n\t\tfrom  \r\n\t\tld_cashbill \r\n\t\t) a\r\n\tGROUP BY accountid) b on b.accountid=a.accountid\r\nleft join (\r\n\tselect min(a.cashbilldate)as cashbilldate,\r\n\ta.cashbillid,\r\n\ta.accountid,\r\n\tsum(round(a.subtotal,2))as total_used\r\n\tfrom ld_cashbill a inner join (select cashbillid from ld_cashbilldebuctiondetail group by cashbillid) b on a.cashbillid=b.cashbillid\r\n\twhere a.deleted=0  \r\n\tAND a.accountid>0\r\n\tand a.cashtype!='debuction' \r\n\tAND IF(a.checkoutstatus='已审核','0','1') <> (IF('{approve}'='true','1','0.001'))\r\n\tgroup by a.accountid\r\n)d on d.accountid=a.accountid\r\nLEFT JOIN ld_account c on c.accountid=a.accountid\r\nWHERE \r\n\tc.accountname like '%{custname}%'\r\n\t\t\t\t\tand (CASE\r\n\t\t\t\t\tWHEN '{userid}'='' THEN \r\n\t\t\t\t\t\tFIND_IN_SET(CASE WHEN c.smownerid is NULL THEN 1 ELSE c.smownerid END,(\r\n\t\t\t\t\t\t\tSELECT\r\n\t\t\t\t\t\t\t\tGROUP_CONCAT(userid)\r\n\t\t\t\t\t\t\tFROM (\r\n\t\t\t\t\t\t\t\tSELECT DISTINCT\r\n\t\t\t\t\t\t\t\t\tuserid \r\n\t\t\t\t\t\t\t\tFROM (\r\n\t\t\t\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\t\t\t\tld_users.id as userid \r\n\t\t\t\t\t\t\t\t\tFROM ld_users\r\n\t\t\t\t\t\t\t\t\tWHERE EXISTS(select 1 from ld_setscoperhigher where modulename='CashBill' and scopeauthority=1 and userid='[uuid]')\r\n\t\t\t\t\t\t\t\t\tUNION\r\n\t\t\t\t\t\t\t\t\tselect \r\n\t\t\t\t\t\t\t\t\t\tviewid as userid \r\n\t\t\t\t\t\t\t\t\tfrom ld_scoperhigher\r\n\t\t\t\t\t\t\t\t\twhere userid='[uuid]' and modulename='CashBill' and EXISTS(select 1 from ld_setscoperhigher where userid='[uuid]' and scopeauthority=2 and modulename='CashBill')\t\t\t\r\n\t\t\t\t\t\t\t\t\tUNION\r\n\t\t\t\t\t\t\t\t\tselect DISTINCT \r\n\t\t\t\t\t\t\t\t\t\tld_users2group.userid as userid \r\n\t\t\t\t\t\t\t\t\tfrom ld_scoperhigher \r\n\t\t\t\t\t\t\t\t\tINNER JOIN ld_groups on ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\t\t\t\t\t\t\tINNER JOIN ld_users2group on ld_users2group.groupid=ld_groups.groupid\r\n\t\t\t\t\t\t\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\t\t\t\t\t\t\tand ld_scoperhigher.modulename='CashBill'\r\n\t\t\t\t\t\t\t\t\t\tand ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\t\t\t\t\t\t\tand EXISTS(select 1 from ld_setscoperhigher where modulename='CashBill' and scopeauthority=3 and userid='[uuid]')\r\n\t\t\t\t\t\t\t\t\tUNION \r\n\t\t\t\t\t\t\t\t\tselect \r\n\t\t\t\t\t\t\t\t\t\tid as userid \r\n\t\t\t\t\t\t\t\t\tfrom ld_users  \r\n\t\t\t\t\t\t\t\t\twhere exists(select 1 from ld_users where id='[uuid]' and is_admin='on')\r\n\t\t\t\t\t\t\t\t\tUNION\r\n\t\t\t\t\t\t\t\t\tselect '[uuid]')as vw_users\r\n\t\t\t\t\t\t\t) as tmp_users))\r\n\t\t\t\t\tELSE FIND_IN_SET(CASE WHEN c.smownerid is NULL THEN 1 ELSE c.smownerid END,'{userid}')\r\n\t\t\t\tEND)"
      },
