        "NameInSource": "ldcrm",
        "Type": "Table",
        "SqlCommand": "SELECT \r\n\ta.accountid,\r\n\tb.accountname,\r\n\ta.cashbilldate,\r\n\tround(a.total/a.conversion_rate,2) as Total\r\nFROM (select * from ld_cashbill order by cashbilldate desc) a\r\nLEFT JOIN ld_account b ON b.accountid=a.accountid\r\nWHERE a.deleted=0\r\n\tAND a.accountid>0\r\n\tAND a.cashtype='debuction'\r\n\tAND IF(a.checkoutstatus='已审核','0','1') <> (IF('{approve}'='true','1','0.001'))\r\n\tAND a.accountid='{this[\"id\"]}'"
      },
