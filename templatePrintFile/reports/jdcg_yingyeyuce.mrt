          },
          "7": {
            "Name": "sales_stage",
            "Index": -1,
            "NameInSource": "sales_stage",
            "Alias": "sales_stage",
            "Type": "System.String"
          }
        },
        "NameInSource": "ldcrm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\ta.sales_stage,\r\n\tCOUNT(1) AS chubei_qty,\r\n\tSUM(amount_chubei)*0.0001 AS chubei_amount,\r\n\tSUM(Q1_amount)*0.0001 AS Q1_amount,\r\n\tSUM(Q2_amount)*0.0001 AS Q2_amount,\r\n\tSUM(Q3_amount)*0.0001 AS Q3_amount,\r\n\tSUM(Q4_amount)*0.0001 AS Q4_amount,\r\n\tSUM(Q1_amount)*0.0001+SUM(Q2_amount)*0.0001+SUM(Q3_amount)*0.0001+SUM(Q4_amount)*0.0001 AS all_amount\r\nFROM (\r\n\tSELECT\r\n\t\ta.potentialid,\r\n\t\ta.sales_stage,\r\n\t\ta.amount AS amount_chubei,\r\n\t\tCASE\r\n\t\t\tWHEN QUARTER(a.closingdate)=1 AND a.sales_stage='线索阶段' THEN a.amount*2.5*0.01\r\n\t\t\tWHEN QUARTER(a.closingdate)=1 AND a.sales_stage='商机阶段' THEN a.amount*25*0.01\r\n\t\t\tWHEN QUARTER(a.closingdate)=1 AND a.sales_stage='立项阶段' THEN a.amount*50*0.01\r\n\t\t\tWHEN QUARTER(a.closingdate)=1 AND a.sales_stage='商务谈判' THEN a.amount*80*0.01\r\n\t\t\tWHEN QUARTER(a.closingdate)=1 AND a.sales_stage='合同签订' THEN a.amount*100*0.01\r\n\t\t\tELSE 0\r\n\t\tEND AS Q1_amount,\r\n\t\tCASE\r\n\t\t\tWHEN QUARTER(a.closingdate)=2 AND a.sales_stage='线索阶段' THEN a.amount*2.5*0.01\r\n\t\t\tWHEN QUARTER(a.closingdate)=2 AND a.sales_stage='商机阶段' THEN a.amount*25*0.01\r\n\t\t\tWHEN QUARTER(a.closingdate)=2 AND a.sales_stage='立项阶段' THEN a.amount*50*0.01\r\n\t\t\tWHEN QUARTER(a.closingdate)=2 AND a.sales_stage='商务谈判' THEN a.amount*80*0.01\r\n\t\t\tWHEN QUARTER(a.closingdate)=2 AND a.sales_stage='合同签订' THEN a.amount*100*0.01\r\n\t\t\tELSE 0\r\n\t\tEND AS Q2_amount,\r\n\t\tCASE\r\n\t\t\tWHEN QUARTER(a.closingdate)=3 AND a.sales_stage='线索阶段' THEN a.amount*2.5*0.01\r\n\t\t\tWHEN QUARTER(a.closingdate)=3 AND a.sales_stage='商机阶段' THEN a.amount*25*0.01\r\n\t\t\tWHEN QUARTER(a.closingdate)=3 AND a.sales_stage='立项阶段' THEN a.amount*50*0.01\r\n\t\t\tWHEN QUARTER(a.closingdate)=3 AND a.sales_stage='商务谈判' THEN a.amount*80*0.01\r\n\t\t\tWHEN QUARTER(a.closingdate)=3 AND a.sales_stage='合同签订' THEN a.amount*100*0.01\r\n\t\t\tELSE 0\r\n\t\tEND AS Q3_amount,\r\n\t\tCASE\r\n\t\t\tWHEN QUARTER(a.closingdate)=4 AND a.sales_stage='线索阶段' THEN a.amount*2.5*0.01\r\n\t\t\tWHEN QUARTER(a.closingdate)=4 AND a.sales_stage='商机阶段' THEN a.amount*25*0.01\r\n\t\t\tWHEN QUARTER(a.closingdate)=4 AND a.sales_stage='立项阶段' THEN a.amount*50*0.01\r\n\t\t\tWHEN QUARTER(a.closingdate)=4 AND a.sales_stage='商务谈判' THEN a.amount*80*0.01\r\n\t\t\tWHEN QUARTER(a.closingdate)=4 AND a.sales_stage='合同签订' THEN a.amount*100*0.01\r\n\t\t\tELSE 0\r\n\t\tEND AS Q4_amount\r\n\tFROM ld_potential a\r\n\tLEFT JOIN ld_potentialscf b ON b.potentialid=a.potentialid\r\n\tLEFT JOIN ld_users u ON u.id=a.smownerid\r\n\tINNER JOIN ld_users2group e ON e.userid=u.id\r\n\tINNER JOIN ld_groups f ON f.groupid=e.groupid\r\n\tINNER JOIN (\r\n\t\tSELECT DISTINCT\r\n\t\t\tuserid \r\n\t\tFROM (\r\n\t\t\tSELECT \r\n\t\t\t\tld_users.id AS userid \r\n\t\t\tFROM ld_users\r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Potentials' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\tUNION\r\n\t\t\tSELECT \r\n\t\t\t\tviewid AS userid \r\n\t\t\tFROM ld_scoperhigher\r\n\t\t\tWHERE userid='[uuid]' AND modulename ='Potentials' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename ='Potentials')\t\t\t\r\n\t\t\tUNION\r\n\t\t\tSELECT DISTINCT \r\n\t\t\t\tld_users2group.userid AS userid \r\n\t\t\tFROM ld_scoperhigher \r\n\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\tAND ld_scoperhigher.modulename ='Potentials'\r\n\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Potentials' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\tUNION \r\n\t\t\tSELECT \r\n\t\t\t\tid AS userid \r\n\t\t\tFROM ld_users  \r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\tUNION\r\n\t\t\tSELECT '[uuid]') AS vw_users\r\n\t) AS tmp_users ON tmp_users.userid=a.smownerid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND IFNULL(a.sales_stage,'')<>''\r\n\t\tAND IFNULL(a.sales_stage,'')<>'交付阶段' \r\n\t\tAND IFNULL(a.sales_stage,'')<>'交付完成' \r\n\t\tAND IFNULL(a.sales_stage,'')<>'项目关闭'\r\n\t\tAND (f.groupid=2 OR f.parentgroup LIKE '1::2::%')\r\n\t\tAND u.profileid IN (64,65)\r\n\t\tAND a.closingdate BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d 00:00:00') AND DATE_FORMAT('{end_date}','%Y-%m-%d 23:59:59')\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN TRIM('{chanpinxian}')='' OR '{chanpinxian}'=(SELECT GROUP_CONCAT(listvalue ORDER BY sequence) FROM ld_picklist_values WHERE listid=130) THEN 1=1\r\n\t\t\t\tELSE FIND_IN_SET(b.cf_3677,'{chanpinxian}')\r\n\t\t\tEND) \r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{weidu}'=1 AND TRIM('{ziweidu}')='' THEN a.smownerid IN (SELECT DISTINCT a.userid FROM ld_users2group a LEFT JOIN ld_groups b ON b.groupid=a.groupid WHERE (b.groupid=2 OR b.parentgroup LIKE '%1::2::%'))\r\n\t\t\t\tWHEN '{weidu}'=1 THEN FIND_IN_SET(a.smownerid,'{ziweidu}') AND a.smownerid IN (SELECT DISTINCT a.userid FROM ld_users2group a LEFT JOIN ld_groups b ON b.groupid=a.groupid WHERE (b.groupid=2 OR b.parentgroup LIKE '%1::2::%'))\r\n\r\n\t\t\t\tWHEN '{weidu}'=2 AND TRIM('{ziweidu}')='' THEN u.user_pianqu IN ('山东区','北京区','河南区','西南区','青岛金东','应急安全产品线')\r\n\t\t\t\tWHEN '{weidu}'=2 THEN FIND_IN_SET(u.user_pianqu,'{ziweidu}')\r\n\r\n\t\t\t\tWHEN '{weidu}'=3 AND TRIM('{ziweidu}')='' THEN u.user_daqu IN ('东部大区','南部大区','西部大区','北部大区','青岛金东','应急安全产品线')\r\n\t\t\t\tWHEN '{weidu}'=3 THEN FIND_IN_SET(u.user_daqu,'{ziweidu}')\r\n\r\n\t\t\t\tELSE 1=1\r\n\t\t\tEND) \r\n\tGROUP BY a.potentialid\r\n\tUNION\r\n\tSELECT\r\n\t\ta.potentialid,\r\n\t\ta.sales_stage,\r\n\t\ta.amount AS amount_chubei,\r\n\t\tCASE\r\n\t\t\tWHEN QUARTER(a.closingdate)=1 AND a.sales_stage='线索阶段' THEN a.amount*2.5*0.01\r\n\t\t\tWHEN QUARTER(a.closingdate)=1 AND a.sales_stage='商机阶段' THEN a.amount*25*0.01\r\n\t\t\tWHEN QUARTER(a.closingdate)=1 AND a.sales_stage='立项阶段' THEN a.amount*50*0.01\r\n\t\t\tWHEN QUARTER(a.closingdate)=1 AND a.sales_stage='商务谈判' THEN a.amount*80*0.01\r\n\t\t\tWHEN QUARTER(a.closingdate)=1 AND a.sales_stage='合同签订' THEN a.amount*100*0.01\r\n\t\t\tELSE 0\r\n\t\tEND AS Q1_amount,\r\n\t\tCASE\r\n\t\t\tWHEN QUARTER(a.closingdate)=2 AND a.sales_stage='线索阶段' THEN a.amount*2.5*0.01\r\n\t\t\tWHEN QUARTER(a.closingdate)=2 AND a.sales_stage='商机阶段' THEN a.amount*25*0.01\r\n\t\t\tWHEN QUARTER(a.closingdate)=2 AND a.sales_stage='立项阶段' THEN a.amount*50*0.01\r\n\t\t\tWHEN QUARTER(a.closingdate)=2 AND a.sales_stage='商务谈判' THEN a.amount*80*0.01\r\n\t\t\tWHEN QUARTER(a.closingdate)=2 AND a.sales_stage='合同签订' THEN a.amount*100*0.01\r\n\t\t\tELSE 0\r\n\t\tEND AS Q2_amount,\r\n\t\tCASE\r\n\t\t\tWHEN QUARTER(a.closingdate)=3 AND a.sales_stage='线索阶段' THEN a.amount*2.5*0.01\r\n\t\t\tWHEN QUARTER(a.closingdate)=3 AND a.sales_stage='商机阶段' THEN a.amount*25*0.01\r\n\t\t\tWHEN QUARTER(a.closingdate)=3 AND a.sales_stage='立项阶段' THEN a.amount*50*0.01\r\n\t\t\tWHEN QUARTER(a.closingdate)=3 AND a.sales_stage='商务谈判' THEN a.amount*80*0.01\r\n\t\t\tWHEN QUARTER(a.closingdate)=3 AND a.sales_stage='合同签订' THEN a.amount*100*0.01\r\n\t\t\tELSE 0\r\n\t\tEND AS Q3_amount,\r\n\t\tCASE\r\n\t\t\tWHEN QUARTER(a.closingdate)=4 AND a.sales_stage='线索阶段' THEN a.amount*2.5*0.01\r\n\t\t\tWHEN QUARTER(a.closingdate)=4 AND a.sales_stage='商机阶段' THEN a.amount*25*0.01\r\n\t\t\tWHEN QUARTER(a.closingdate)=4 AND a.sales_stage='立项阶段' THEN a.amount*50*0.01\r\n\t\t\tWHEN QUARTER(a.closingdate)=4 AND a.sales_stage='商务谈判' THEN a.amount*80*0.01\r\n\t\t\tWHEN QUARTER(a.closingdate)=4 AND a.sales_stage='合同签订' THEN a.amount*100*0.01\r\n\t\t\tELSE 0\r\n\t\tEND AS Q4_amount\r\n\tFROM ld_potential a\r\n\tLEFT JOIN ld_potentialscf b ON b.potentialid=a.potentialid\r\n\tLEFT JOIN ld_users u ON u.id=a.smownerid\r\n\tINNER JOIN ld_users2group e ON e.userid=u.id\r\n\tINNER JOIN ld_groups f ON f.groupid=e.groupid\r\n\tINNER JOIN ld_tabshare s ON s.crmid=a.potentialid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND IFNULL(a.sales_stage,'')<>''\r\n\t\tAND IFNULL(a.sales_stage,'')<>'交付阶段' \r\n\t\tAND IFNULL(a.sales_stage,'')<>'交付完成' \r\n\t\tAND IFNULL(a.sales_stage,'')<>'项目关闭'\r\n\t\tAND (f.groupid=2 OR f.parentgroup LIKE '1::2::%')\r\n\t\tAND u.profileid IN (64,65)\r\n\t\tAND a.closingdate BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d 00:00:00') AND DATE_FORMAT('{end_date}','%Y-%m-%d 23:59:59')\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN TRIM('{chanpinxian}')='' OR '{chanpinxian}'=(SELECT GROUP_CONCAT(listvalue ORDER BY sequence) FROM ld_picklist_values WHERE listid=130) THEN 1=1\r\n\t\t\t\tELSE FIND_IN_SET(b.cf_3677,'{chanpinxian}')\r\n\t\t\tEND) \r\n\tGROUP BY a.potentialid\r\n) a\r\nLEFT JOIN ld_picklist_values b ON b.listid=64 AND b.listvalue=a.sales_stage\r\nGROUP BY a.sales_stage\r\nORDER BY b.sequence"
      },
