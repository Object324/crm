            "NameInSource": "chubei_amount",
            "Alias": "chubei_amount",
            "Type": "System.Decimal"
          },
          "6": {
            "Name": "chubei_qty",
            "Index": -1,
            "NameInSource": "chubei_qty",
            "Alias": "chubei_qty",
