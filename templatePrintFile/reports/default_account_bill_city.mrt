    <DataSources count="7" isList="true">
      <label isKey="true" Ref="3" type="Stimulsoft.Report.Dictionary.StiMySqlSource">
        <Alias>label</Alias>
        <Columns count="8" isList="true">
          <value>report_title,System.String</value>
          <value>accountname,System.String</value>
          <value>bill_state,System.String</value>
          <value>createdtime,System.String</value>
          <value>modifiedtime,System.String</value>
          <value>nolinkdays,System.String</value>
          <value>accounttype,System.String</value>
          <value>smownerid,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1"/>
        <Name>label</Name>
        <NameInSource>ldcrm</NameInSource>
        <Parameters count="0" isList="true"/>
        <SqlCommand>select 
report_title,
accountname,
bill_state,
createdtime,
modifiedtime,
nolinkdays,
accounttype,
smownerid
from (
			select 
			1 as id,
			b.fieldlabel as report_title
			from ld_field a
			LEFT JOIN ld_tranlabel b on b.trantable='ld_field' and b.languagetype='zh' and b.Relateid=a.fieldid
			where a.tabid=6 and a.columnname='bill_city'
			LIMIT 1) a
LEFT JOIN (
select 
1 as id,
b.fieldlabel as accountname
from ld_field a
LEFT JOIN ld_tranlabel b on b.trantable='ld_field' and b.languagetype='zh' and b.Relateid=a.fieldid
where a.tabid=6 and a.columnname='accountname'
LIMIT 1) b on a.id=b.id
LEFT JOIN (
select 
1 as id,
b.fieldlabel as bill_state
from ld_field a
LEFT JOIN ld_tranlabel b on b.trantable='ld_field' and b.languagetype='zh' and b.Relateid=a.fieldid
where a.tabid=6 and a.columnname='bill_state'
LIMIT 1) c on a.id=c.id
LEFT JOIN (
select 
1 as id,
b.fieldlabel as createdtime
from ld_field a
LEFT JOIN ld_tranlabel b on b.trantable='ld_field' and b.languagetype='zh' and b.Relateid=a.fieldid
where a.tabid=6 and a.columnname='createdtime'
LIMIT 1) d on a.id=d.id
LEFT JOIN (
select 
1 as id,
b.fieldlabel as modifiedtime
from ld_field a
LEFT JOIN ld_tranlabel b on b.trantable='ld_field' and b.languagetype='zh' and b.Relateid=a.fieldid
where a.tabid=6 and a.columnname='modifiedtime'
LIMIT 1) e on a.id=e.id
LEFT JOIN (
select 
1 as id,
b.fieldlabel as nolinkdays
from ld_field a
LEFT JOIN ld_tranlabel b on b.trantable='ld_field' and b.languagetype='zh' and b.Relateid=a.fieldid
where a.tabid=6 and a.columnname='nolinkdays'
LIMIT 1) f on a.id=f.id
LEFT JOIN (
select 
1 as id,
b.fieldlabel as smownerid
from ld_field a
LEFT JOIN ld_tranlabel b on b.trantable='ld_field' and b.languagetype='zh' and b.Relateid=a.fieldid
where a.tabid=6 and a.columnname='smownerid'
LIMIT 1) g on a.id=g.id
LEFT JOIN (
select 
1 as id,
b.fieldlabel as accounttype
from ld_field a
LEFT JOIN ld_tranlabel b on b.trantable='ld_field' and b.languagetype='zh' and b.Relateid=a.fieldid
where a.tabid=6 and a.columnname='account_type'
LIMIT 1) h on a.id=h.id</SqlCommand>
      </label>
      <Period isKey="true" Ref="4" type="Stimulsoft.Report.Dictionary.StiMySqlSource">
        <Alias>Period</Alias>
        <Columns count="1" isList="true">
          <value>Period,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1"/>
        <Name>Period</Name>
        <NameInSource>ldcrm</NameInSource>
        <Parameters count="0" isList="true"/>
        <SqlCommand>SELECT '全部' as Period
UNION 
select'本年' 
UNION 
select'本月'
UNION 
select'本周'
UNION 
select'今天'
UNION 
select'去年'
UNION 
select'去年' 
UNION 
select'上月'
UNION 
select'上周'
UNION 
select'昨天'</SqlCommand>
      </Period>
      <state isKey="true" Ref="5" type="Stimulsoft.Report.Dictionary.StiMySqlSource">
        <Alias>state</Alias>
        <Columns count="1" isList="true">
          <value>bill_state,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1"/>
        <Name>state</Name>
        <NameInSource>ldcrm</NameInSource>
        <Parameters count="0" isList="true"/>
        <SqlCommand>SELECT NULL AS bill_state
UNION
SELECT 
	b.listvalue
FROM ld_picklist_set a
LEFT JOIN ld_picklist_values b ON a.listid=b.listid
WHERE a.listname='bill_state'
	AND a.relatetable='ld_field'</SqlCommand>
      </state>
      <users isKey="true" Ref="6" type="Stimulsoft.Report.Dictionary.StiMySqlSource">
        <Alias>users</Alias>
        <Columns count="2" isList="true">
          <value>id,System.Int32</value>
          <value>last_name,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1"/>
        <Name>users</Name>
        <NameInSource>ldcrm</NameInSource>
        <Parameters count="0" isList="true"/>
        <SqlCommand>SELECT
	a.id,
	a.last_name
FROM ld_users a
INNER JOIN (
	SELECT DISTINCT
		userid 
	FROM (
		SELECT 
			ld_users.id as userid 
		FROM ld_users
		WHERE EXISTS(select 1 from ld_setscoperhigher where modulename='Accounts' and scopeauthority=1 and userid='[uuid]')
		UNION
		select 
			viewid as userid 
		from ld_scoperhigher
		where userid='[uuid]' and modulename='Accounts' and EXISTS(select 1 from ld_setscoperhigher where userid='[uuid]' and scopeauthority=2 and modulename='Accounts')			
		UNION
		select DISTINCT 
			ld_users2group.userid as userid 
		from ld_scoperhigher 
		INNER JOIN ld_groups on ld_groups.groupid=ld_scoperhigher.viewid
		INNER JOIN ld_users2group on ld_users2group.groupid=ld_groups.groupid
		WHERE ld_scoperhigher.userid='[uuid]' 
			and ld_scoperhigher.modulename='Accounts'
			and ld_scoperhigher.scopeauthority=3 
			and EXISTS(select 1 from ld_setscoperhigher where modulename='Accounts' and scopeauthority=3 and userid='[uuid]')
		UNION 
		select 
			id as userid 
		from ld_users  
		where exists(select 1 from ld_users where id='[uuid]' and is_admin='on')
		UNION
		select '[uuid]')as vw_users
) as tmp_users ON tmp_users.userid=a.id
order by CONVERT(a.last_name USING gbk)</SqlCommand>
      </users>
      <report isKey="true" Ref="7" type="Stimulsoft.Report.Dictionary.StiMySqlSource">
        <Alias>report</Alias>
        <Columns count="3" isList="true">
          <value>argument_column,System.String</value>
          <value>value_column,System.Int32</value>
          <value>tip,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1"/>
        <Name>report</Name>
        <NameInSource>ldcrm</NameInSource>
        <Parameters count="0" isList="true"/>
        <SqlCommand>select
argument_column,
value_column,
concat(argument_column,' ,   ',value_column,' ,   ',round(value_column*100/(
		select
		count(1) as value_column
		from ld_account a
		LEFT JOIN ld_users b on a.smownerid=b.id
		where a.deleted=0
			and (CASE
					WHEN '{userid}'='' THEN 
						FIND_IN_SET(CASE WHEN a.smownerid is NULL THEN 1 ELSE a.smownerid END,(
							SELECT
								GROUP_CONCAT(userid)
							FROM (
								SELECT DISTINCT
									userid 
								FROM (
									SELECT 
										ld_users.id as userid 
									FROM ld_users
									WHERE EXISTS(select 1 from ld_setscoperhigher where modulename='Accounts' and scopeauthority=1 and userid='[uuid]')
									UNION
									select 
										viewid as userid 
									from ld_scoperhigher
									where userid='[uuid]' and modulename='Accounts' and EXISTS(select 1 from ld_setscoperhigher where userid='[uuid]' and scopeauthority=2 and modulename='Accounts')			
									UNION
									select DISTINCT 
										ld_users2group.userid as userid 
									from ld_scoperhigher 
									INNER JOIN ld_groups on ld_groups.groupid=ld_scoperhigher.viewid
									INNER JOIN ld_users2group on ld_users2group.groupid=ld_groups.groupid
									WHERE ld_scoperhigher.userid='[uuid]' 
										and ld_scoperhigher.modulename='Accounts'
										and ld_scoperhigher.scopeauthority=3 
										and EXISTS(select 1 from ld_setscoperhigher where modulename='Accounts' and scopeauthority=3 and userid='[uuid]')
									UNION 
									select 
										id as userid 
									from ld_users  
									where exists(select 1 from ld_users where id='[uuid]' and is_admin='on')
									UNION
									select '[uuid]')as vw_users
							) as tmp_users))
					ELSE FIND_IN_SET(CASE WHEN a.smownerid is NULL THEN 1 ELSE a.smownerid END,'{userid}')
				END)
			and CONCAT('全部',
					'/',CASE WHEN YEAR(a.createdtime)=YEAR(CURDATE()) THEN '本年' ELSE '' END,
					'/',CASE WHEN YEAR(a.createdtime)=YEAR(CURDATE())-1 THEN '去年' ELSE '' END,
					'/',CASE WHEN YEAR(a.createdtime)=YEAR(CURDATE()) AND MONTH(a.createdtime)=MONTH(CURDATE()) THEN '本月' ELSE '' END,
					'/',CASE WHEN YEAR(a.createdtime)=YEAR(CURDATE()) AND MONTH(a.createdtime)=MONTH(CURDATE())-1 THEN '上月' ELSE '' END,
					'/',CASE WHEN YEAR(a.createdtime)=YEAR(CURDATE()) AND WEEK(a.createdtime)=WEEK(CURDATE()) THEN '本周' ELSE '' END,
					'/',CASE WHEN YEAR(a.createdtime)=YEAR(CURDATE()) AND WEEK(a.createdtime)=WEEK(CURDATE())-1 THEN '上周' ELSE '' END,
					'/',CASE WHEN DATE_FORMAT(a.createdtime,'%Y-%m-%d')=DATE_FORMAT(CURDATE(),'%Y-%m-%d') THEN '今天' ELSE '' END,
					'/',CASE WHEN DATE_FORMAT(a.createdtime,'%Y-%m-%d')=DATE_FORMAT(DATE_SUB(CURDATE(),INTERVAL 1 day),'%Y-%m-%d') THEN '昨天' ELSE '' END) like '%{createdtime}%'
			and CONCAT('全部',
					'/',CASE WHEN YEAR(a.modifiedtime)=YEAR(CURDATE()) THEN '本年' ELSE '' END,
					'/',CASE WHEN YEAR(a.modifiedtime)=YEAR(CURDATE())-1 THEN '去年' ELSE '' END,
					'/',CASE WHEN YEAR(a.modifiedtime)=YEAR(CURDATE()) AND MONTH(a.modifiedtime)=MONTH(CURDATE()) THEN '本月' ELSE '' END,
					'/',CASE WHEN YEAR(a.modifiedtime)=YEAR(CURDATE()) AND MONTH(a.modifiedtime)=MONTH(CURDATE())-1 THEN '上月' ELSE '' END,
					'/',CASE WHEN YEAR(a.modifiedtime)=YEAR(CURDATE()) AND WEEK(a.modifiedtime)=WEEK(CURDATE()) THEN '本周' ELSE '' END,
					'/',CASE WHEN YEAR(a.modifiedtime)=YEAR(CURDATE()) AND WEEK(a.modifiedtime)=WEEK(CURDATE())-1 THEN '上周' ELSE '' END,
					'/',CASE WHEN DATE_FORMAT(a.modifiedtime,'%Y-%m-%d')=DATE_FORMAT(CURDATE(),'%Y-%m-%d') THEN '今天' ELSE '' END,
					'/',CASE WHEN DATE_FORMAT(a.modifiedtime,'%Y-%m-%d')=DATE_FORMAT(DATE_SUB(CURDATE(),INTERVAL 1 day),'%Y-%m-%d') THEN '昨天' ELSE '' END) like '%{modifiedtime}%'
			and a.nolinkdays&gt;={nolinkdays_from}
			and a.nolinkdays&lt;=if({nolinkdays_to}=0,36000000,{nolinkdays_to})),2),'%') as tip
from (
select
CASE
	WHEN a.bill_city is NULL or a.bill_city='' or a.bill_city='--无--' THEN '空' 
	ELSE a.bill_city 
END as argument_column,
count(1) as value_column
from ld_account a
LEFT JOIN ld_users b on a.smownerid=b.id
where a.deleted=0
	and (CASE
					WHEN '{userid}'='' THEN 
						FIND_IN_SET(CASE WHEN a.smownerid is NULL THEN 1 ELSE a.smownerid END,(
							SELECT
								GROUP_CONCAT(userid)
							FROM (
								SELECT DISTINCT
									userid 
								FROM (
									SELECT 
										ld_users.id as userid 
									FROM ld_users
									WHERE EXISTS(select 1 from ld_setscoperhigher where modulename='Accounts' and scopeauthority=1 and userid='[uuid]')
									UNION
									select 
										viewid as userid 
									from ld_scoperhigher
									where userid='[uuid]' and modulename='Accounts' and EXISTS(select 1 from ld_setscoperhigher where userid='[uuid]' and scopeauthority=2 and modulename='Accounts')			
									UNION
									select DISTINCT 
										ld_users2group.userid as userid 
									from ld_scoperhigher 
									INNER JOIN ld_groups on ld_groups.groupid=ld_scoperhigher.viewid
									INNER JOIN ld_users2group on ld_users2group.groupid=ld_groups.groupid
									WHERE ld_scoperhigher.userid='[uuid]' 
										and ld_scoperhigher.modulename='Accounts'
										and ld_scoperhigher.scopeauthority=3 
										and EXISTS(select 1 from ld_setscoperhigher where modulename='Accounts' and scopeauthority=3 and userid='[uuid]')
									UNION 
									select 
										id as userid 
									from ld_users  
									where exists(select 1 from ld_users where id='[uuid]' and is_admin='on')
									UNION
									select '[uuid]')as vw_users
							) as tmp_users))
					ELSE FIND_IN_SET(CASE WHEN a.smownerid is NULL THEN 1 ELSE a.smownerid END,'{userid}')
				END)
	and CONCAT('全部',
				'/',CASE WHEN YEAR(a.createdtime)=YEAR(CURDATE()) THEN '本年' ELSE '' END,
				'/',CASE WHEN YEAR(a.createdtime)=YEAR(CURDATE())-1 THEN '去年' ELSE '' END,
				'/',CASE WHEN YEAR(a.createdtime)=YEAR(CURDATE()) AND MONTH(a.createdtime)=MONTH(CURDATE()) THEN '本月' ELSE '' END,
				'/',CASE WHEN YEAR(a.createdtime)=YEAR(CURDATE()) AND MONTH(a.createdtime)=MONTH(CURDATE())-1 THEN '上月' ELSE '' END,
				'/',CASE WHEN YEAR(a.createdtime)=YEAR(CURDATE()) AND WEEK(a.createdtime)=WEEK(CURDATE()) THEN '本周' ELSE '' END,
				'/',CASE WHEN YEAR(a.createdtime)=YEAR(CURDATE()) AND WEEK(a.createdtime)=WEEK(CURDATE())-1 THEN '上周' ELSE '' END,
				'/',CASE WHEN DATE_FORMAT(a.createdtime,'%Y-%m-%d')=DATE_FORMAT(CURDATE(),'%Y-%m-%d') THEN '今天' ELSE '' END,
				'/',CASE WHEN DATE_FORMAT(a.createdtime,'%Y-%m-%d')=DATE_FORMAT(DATE_SUB(CURDATE(),INTERVAL 1 day),'%Y-%m-%d') THEN '昨天' ELSE '' END) like '%{createdtime}%'
	and CONCAT('全部',
			'/',CASE WHEN YEAR(a.modifiedtime)=YEAR(CURDATE()) THEN '本年' ELSE '' END,
			'/',CASE WHEN YEAR(a.modifiedtime)=YEAR(CURDATE())-1 THEN '去年' ELSE '' END,
			'/',CASE WHEN YEAR(a.modifiedtime)=YEAR(CURDATE()) AND MONTH(a.modifiedtime)=MONTH(CURDATE()) THEN '本月' ELSE '' END,
			'/',CASE WHEN YEAR(a.modifiedtime)=YEAR(CURDATE()) AND MONTH(a.modifiedtime)=MONTH(CURDATE())-1 THEN '上月' ELSE '' END,
			'/',CASE WHEN YEAR(a.modifiedtime)=YEAR(CURDATE()) AND WEEK(a.modifiedtime)=WEEK(CURDATE()) THEN '本周' ELSE '' END,
			'/',CASE WHEN YEAR(a.modifiedtime)=YEAR(CURDATE()) AND WEEK(a.modifiedtime)=WEEK(CURDATE())-1 THEN '上周' ELSE '' END,
			'/',CASE WHEN DATE_FORMAT(a.modifiedtime,'%Y-%m-%d')=DATE_FORMAT(CURDATE(),'%Y-%m-%d') THEN '今天' ELSE '' END,
			'/',CASE WHEN DATE_FORMAT(a.modifiedtime,'%Y-%m-%d')=DATE_FORMAT(DATE_SUB(CURDATE(),INTERVAL 1 day),'%Y-%m-%d') THEN '昨天' ELSE '' END) like '%{modifiedtime}%'
	and IFNULL(a.nolinkdays,0)&gt;={nolinkdays_from}
	and IFNULL(a.nolinkdays,0)&lt;=if({nolinkdays_to}=0,36000000,{nolinkdays_to})
GROUP BY argument_column) T</SqlCommand>
      </report>
      <details isKey="true" Ref="8" type="Stimulsoft.Report.Dictionary.StiMySqlSource">
        <Alias>details</Alias>
        <Columns count="8" isList="true">
          <value>argument_column,System.String</value>
          <value>accountname,System.String</value>
          <value>account_type,System.String</value>
          <value>nolinkdays,System.Int32</value>
          <value>last_name,System.String</value>
          <value>createdtime,System.DateTime</value>
          <value>modifiedtime,System.DateTime</value>
          <value>accountid,System.Int32</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1"/>
        <Name>details</Name>
        <NameInSource>ldcrm</NameInSource>
        <Parameters count="0" isList="true"/>
        <SqlCommand>select
CASE
	WHEN a.bill_city is NULL or a.bill_city='' or a.bill_city='--无--' THEN '空' 
	ELSE a.bill_city 
END as argument_column,
a.accountname,
a.account_type,
a.nolinkdays,
b.last_name,
a.createdtime,
a.modifiedtime,
a.accountid
from ld_account a
LEFT JOIN ld_users b on a.smownerid=b.id
where a.deleted=0
	and FIND_IN_SET(CASE WHEN a.smownerid is NULL THEN 1 ELSE a.smownerid END,'{userid}')
	and CONCAT('全部',
				'/',CASE WHEN YEAR(a.createdtime)=YEAR(CURDATE()) THEN '本年' ELSE '' END,
				'/',CASE WHEN YEAR(a.createdtime)=YEAR(CURDATE())-1 THEN '去年' ELSE '' END,
				'/',CASE WHEN YEAR(a.createdtime)=YEAR(CURDATE()) AND MONTH(a.createdtime)=MONTH(CURDATE()) THEN '本月' ELSE '' END,
				'/',CASE WHEN YEAR(a.createdtime)=YEAR(CURDATE()) AND MONTH(a.createdtime)=MONTH(CURDATE())-1 THEN '上月' ELSE '' END,
				'/',CASE WHEN YEAR(a.createdtime)=YEAR(CURDATE()) AND WEEK(a.createdtime)=WEEK(CURDATE()) THEN '本周' ELSE '' END,
				'/',CASE WHEN YEAR(a.createdtime)=YEAR(CURDATE()) AND WEEK(a.createdtime)=WEEK(CURDATE())-1 THEN '上周' ELSE '' END,
				'/',CASE WHEN DATE_FORMAT(a.createdtime,'%Y-%m-%d')=DATE_FORMAT(CURDATE(),'%Y-%m-%d') THEN '今天' ELSE '' END,
				'/',CASE WHEN DATE_FORMAT(a.createdtime,'%Y-%m-%d')=DATE_FORMAT(DATE_SUB(CURDATE(),INTERVAL 1 day),'%Y-%m-%d') THEN '昨天' ELSE '' END) like '%{createdtime}%'
	and CONCAT('全部',
			'/',CASE WHEN YEAR(a.modifiedtime)=YEAR(CURDATE()) THEN '本年' ELSE '' END,
			'/',CASE WHEN YEAR(a.modifiedtime)=YEAR(CURDATE())-1 THEN '去年' ELSE '' END,
			'/',CASE WHEN YEAR(a.modifiedtime)=YEAR(CURDATE()) AND MONTH(a.modifiedtime)=MONTH(CURDATE()) THEN '本月' ELSE '' END,
			'/',CASE WHEN YEAR(a.modifiedtime)=YEAR(CURDATE()) AND MONTH(a.modifiedtime)=MONTH(CURDATE())-1 THEN '上月' ELSE '' END,
			'/',CASE WHEN YEAR(a.modifiedtime)=YEAR(CURDATE()) AND WEEK(a.modifiedtime)=WEEK(CURDATE()) THEN '本周' ELSE '' END,
			'/',CASE WHEN YEAR(a.modifiedtime)=YEAR(CURDATE()) AND WEEK(a.modifiedtime)=WEEK(CURDATE())-1 THEN '上周' ELSE '' END,
			'/',CASE WHEN DATE_FORMAT(a.modifiedtime,'%Y-%m-%d')=DATE_FORMAT(CURDATE(),'%Y-%m-%d') THEN '今天' ELSE '' END,
			'/',CASE WHEN DATE_FORMAT(a.modifiedtime,'%Y-%m-%d')=DATE_FORMAT(DATE_SUB(CURDATE(),INTERVAL 1 day),'%Y-%m-%d') THEN '昨天' ELSE '' END) like '%{modifiedtime}%'
	and IFNULL(a.nolinkdays,0)&gt;={nolinkdays_from}
	and IFNULL(a.nolinkdays,0)&lt;=if({nolinkdays_to}=0,36000000,{nolinkdays_to})
	and (CASE WHEN a.bill_city is NULL or a.bill_city='' or a.bill_city='--无--' THEN '空' ELSE a.bill_city END)='{this["argument_column"]}'</SqlCommand>
      </details>
      <details2 isKey="true" Ref="9" type="Stimulsoft.Report.Dictionary.StiMySqlSource">
