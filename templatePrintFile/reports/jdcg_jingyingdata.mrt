u.id=c.lin_users_id\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\tAND c.lin_users_id>0\r\n\t\t\tAND b.cf_5276 IN ('{nian}','{nian}'-1)\r\n\t) a\r\n\tWHERE 1=1\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(a.mb_yue,'{date_value}')\r\n\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(a.mb_ji,'{date_value}')\r\n\t\t\tEND)\r\n\tGROUP BY a.lin_users_id,mb_type,mb_nian\r\n) m ON m.lin_users_id=a.id AND m.mb_type=b.listvalue\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\t'合同额' AS wc_type,\r\n\t\ta.smownerid,\r\n\t\tCASE\r\n\t\t\tWHEN '{weidu}'=1 AND u.profileid=65 AND u.id NOT IN (28,31) THEN\r\n\t\t\t\t(\r\n\t\t\t\t\tSELECT\r\n\t\t\t\t\t\tSUM(x.total)*0.0001 AS wc_total\r\n\t\t\t\t\tFROM ld_servicecontracts x\r\n\t\t\t\t\tLEFT JOIN ld_users y ON y.id=x.smownerid\r\n\t\t\t\t\tWHERE x.deleted=0\r\n\t\t\t\t\t\tAND x.approvestatus='已批准'\r\n\t\t\t\t\t\tAND YEAR(x.createdtime)='{nian}'\r\n\t\t\t\t\t\tAND y.groupid=u.groupid\r\n\t\t\t\t\t\tAND y.profileid IN (64,65)\r\n\t\t\t\t\t\tAND (\r\n\t\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(MONTH(x.createdtime),'{date_value}')\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(QUARTER(x.createdtime),'{date_value}')\r\n\t\t\t\t\t\t\tEND)\r\n\t\t\t\t)\r\n\t\t\tELSE SUM(CASE WHEN YEAR(a.createdtime)='{nian}' THEN a.total ELSE 0 END)\r\n\t\tEND AS wc_total,\r\n\t\t\r\n\t\tCASE\r\n\t\t\tWHEN '{weidu}'=1 AND u.profileid=65 AND u.id NOT IN (28,31) THEN\r\n\t\t\t\t(\r\n\t\t\t\t\tSELECT\r\n\t\t\t\t\t\tSUM(x.total)*0.0001 AS wc_total\r\n\t\t\t\t\tFROM ld_servicecontracts x\r\n\t\t\t\t\tLEFT JOIN ld_users y ON y.id=x.smownerid\r\n\t\t\t\t\tWHERE x.deleted=0\r\n\t\t\t\t\t\tAND x.approvestatus='已批准'\r\n\t\t\t\t\t\tAND YEAR(x.createdtime)='{nian}'-1\r\n\t\t\t\t\t\tAND y.groupid=u.groupid\r\n\t\t\t\t\t\tAND y.profileid IN (64,65)\r\n\t\t\t\t\t\tAND (\r\n\t\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(MONTH(x.createdtime),'{date_value}')\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(QUARTER(x.createdtime),'{date_value}')\r\n\t\t\t\t\t\t\tEND)\r\n\t\t\t\t)\r\n\t\t\tELSE SUM(CASE WHEN YEAR(a.createdtime)='{nian}'-1 THEN a.total ELSE 0 END)\r\n\t\tEND AS wc_total_last\r\n\tFROM ld_servicecontracts a\r\n\tLEFT JOIN ld_users u ON u.id=a.smownerid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND YEAR(a.createdtime) IN ('{nian}','{nian}'-1)\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(MONTH(a.createdtime),'{date_value}')\r\n\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(QUARTER(a.createdtime),'{date_value}')\r\n\t\t\tEND)\r\n\tGROUP BY a.smownerid\r\n\tUNION\r\n\tSELECT\r\n\t\t'回款额' AS wc_type,\r\n\t\ta.smownerid,\r\n\t\tCASE\r\n\t\t\tWHEN '{weidu}'=1 AND u.profileid=65 AND u.id NOT IN (28,31) THEN\r\n\t\t\t\t(\r\n\t\t\t\t\tSELECT\r\n\t\t\t\t\t\tSUM(x.total)*0.0001 AS wc_total\r\n\t\t\t\t\tFROM ld_cashbill x\r\n\t\t\t\t\tLEFT JOIN ld_users y ON y.id=x.smownerid\r\n\t\t\t\t\tWHERE x.deleted=0\r\n\t\t\t\t\t\tAND x.approvestatus<>'已拒绝'\r\n\t\t\t\t\t\tAND YEAR(x.createdtime)='{nian}'\r\n\t\t\t\t\t\tAND y.groupid=u.gr