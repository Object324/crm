=1\r\n\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(MONTH(a.cashbilldate),'{date_value}')\r\n\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(QUARTER(a.cashbilldate),'{date_value}')\r\n\t\t\tEND)\r\n\tGROUP BY a.smownerid\r\n\tUNION\r\n\tSELECT\r\n\t\t'客户拜访量' AS wc_type,\r\n\t\ta.smownerid,\r\n\r\n\t\tCASE\r\n\t\t\tWHEN '{weidu}'=1 AND u.profileid=65 AND u.id NOT IN (28,31) THEN\r\n\t\t\t\t(\r\n\t\t\t\t\tSELECT\r\n\t\t\t\t\t\tCOUNT(1) AS wc_total\r\n\t\t\t\t\tFROM ld_contactrecords x\r\n\t\t\t\t\tLEFT JOIN ld_users y ON y.id=x.smownerid\r\n\t\t\t\t\tWHERE x.deleted=0\r\n\t\t\t\t\t\tAND x.approvestatus<>'已拒绝'\r\n\t\t\t\t\t\tAND YEAR(x.contactdate)='{nian}'\r\n\t\t\t\t\t\tAND y.groupid=u.groupid\r\n\t\t\t\t\t\tAND y.profileid IN (64,65)\r\n\t\t\t\t\t\tAND (\r\n\t\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(MONTH(x.contactdate),'{date_value}')\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(QUARTER(x.contactdate),'{date_value}')\r\n\t\t\t\t\t\t\tEND)\r\n\t\t\t\t)\r\n\t\t\tELSE SUM(CASE WHEN YEAR(a.contactdate)='{nian}' THEN 1 ELSE 0 END)\r\n\t\tEND AS wc_total,\r\n\t\t\r\n\t\tCASE\r\n\t\t\tWHEN '{weidu}'=1 AND u.profileid=65 AND u.id NOT IN (28,31) THEN\r\n\t\t\t\t(\r\n\t\t\t\t\tSELECT\r\n\t\t\t\t\t\tCOUNT(1) AS wc_total\r\n\t\t\t\t\tFROM ld_contactrecords x\r\n\t\t\t\t\tLEFT JOIN ld_users y ON y.id=x.smownerid\r\n\t\t\t\t\tWHERE x.deleted=0\r\n\t\t\t\t\t\tAND x.approvestatus<>'已拒绝'\r\n\t\t\t\t\t\tAND YEAR(x.contactdate)='{nian}'-1\r\n\t\t\t\t\t\tAND y.groupid=u.groupid\r\n\t\t\t\t\t\tAND y.profileid IN (64,65)\r\n\t\t\t\t\t\tAND (\r\n\t\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\t\tWHEN '{da