n) AS changedon\r\n\t\t\t\t\t\tFROM ld_modtracker_basic a\r\n\t\t\t\t\t\tLEFT JOIN ld_modtracker_detail b ON b.id=a.id\r\n\t\t\t\t\t\tWHERE b.fieldname='cf_3410'\r\n\t\t\t\t\t\t\tAND a.module='Accounts'\r\n\t\t\t\t\t\t\tAND b.postvalue='渠道客户'\r\n\t\t\t\t\t\t\tAND a.changedon>'1900-01-01'\r\n\t\t\t\t\t\tGROUP BY a.crmid\r\n\t\t\t\t\t) w ON w.crmid=x.accountid\r\n\t\t\t\t\tLEFT JOIN ld_users y ON y.id=x.smownerid\r\n\t\t\t\t\tWHERE x.deleted=0\r\n\t\t\t\t\t\tAND x.approvestatus<>'已拒绝'\r\n\t\t\t\t\t\tAND YEAR(w.changedon)='{nian}'-1\r\n\t\t\t\t\t\tAND y.groupid=u.groupid\r\n\t\t\t\t\t\tAND y.profileid IN (64,65)\r\n\t\t\t\t\t\tAND (\r\n\t\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(MONTH(c.changedon),'{date_value}')\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(QUARTER(c.changedon),'{date_value}')\r\n\t\t\t\t\t\t\tEND)\r\n\t\t\t\t)\r\n\t\t\tELSE SUM(CASE WHEN YEAR(c.changedon)='{nian}'-1 THEN 1 ELSE 0 END)\r\n\t\tEND AS wc_total_last\r\n\tFROM ld_account a\r\n\tLEFT JOIN ld_accountscf b ON b.accountid=a.accountid\r\n\tINNER JOIN (\r\n\t\tSELECT \r\n\t\t\ta.crmid,\r\n\t\t\tMAX(changedon) AS changedon\r\n\t\tFROM ld_modtracker_basic a\r\n\t\tLEFT JOIN ld_modtracker_detail b ON b.id=a.id\r\n\t\tWHERE b.fieldname='cf_3410'\r\n\t\t\tAND a.module='Accounts'\r\n\t\t\tAND b.postvalue='渠道客户'\r\n\t\t\tAND a.changedon>'1900-01-01'\r\n\t\tGROUP BY a.crmid\r\n\t) c ON c.crmid=a.accountid\r\n\tLEFT JOIN ld_users u ON u.id=a.smownerid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND b.cf_3410='渠道客户'\r\n\t\tAND YEAR(c.changedon) IN ('{nian}','{nian}'-1)\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(MONTH(c.changedon),'{date_value}')\r\n\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(QUARTER(c.changedon),'{date_value}')\r\n\t\t\tEND)\r\n\tGROUP BY a.smownerid\r\n) w ON w.smownerid=a.id AND w.wc_type=b.listvalue\r\nWHERE 1=1\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{chanpinxian}'='' OR '{chanpinxian}'=(SELECT GROUP_CONCAT(listvalue ORDER BY sequence) FROM ld_picklist_values WHERE listid=130) THEN 1=1\r\n\t\t\t\tELSE FIND_IN_SET(a.user_chanpinxian, '{chanpinxian}')\r\n\t\t\tEND)\r\n) a\r\nWHERE 1=1\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN TRIM('{mbtype}')='' THEN mb_type IN ('合同额','回款额','客户拜访量')\r\n\t\t\tELSE FIND_IN_SET(mb_type,'{mbtype}')\r\n\t\tEND) \r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{weidu}'=1 AND TRIM('{ziweidu}')='' THEN a.id IN (SELECT DISTINCT a.userid FROM ld_users2group a LEFT JOIN ld_groups b ON b.groupid=a.groupid WHERE (b.groupid=2 OR b.parentgroup LIKE '%1::2::%'))\r\n\t\t\tWHEN '{weidu}'=1 THEN FIND_IN_SET(a.id,'{ziweidu}') AND a.id IN (SELECT DISTINCT a.userid FROM ld_users2group a LEFT JOIN ld_groups b ON b.groupid=a.groupid WHERE (b.groupid=2 OR b.parentgroup LIKE '%1::2::%'))\r\n\r\n\t\t\tWHEN '{weidu}'=2 AND TRIM('{ziweidu}')='' THEN weidu_type IN ('山东区','北京区','河南区','西南区','青岛金东','应急安全产品线')\r\n\t\t\tWHEN '{weidu}'=2 THEN FIND_IN_SET(weidu_type,'{ziweidu}')\r\n\r\n\t\t\tWHEN '{weidu}'=3 AND TRIM('{ziweidu}')='' THEN weidu_type IN ('东部大区','南部大区','西部大区','北部大区','青岛金东','应急安全产品线')\r\n\t\t\tWHEN '{weidu}'=3 THEN FIND_IN_SET(weidu_type,'{ziweidu}')\r\n\r\n\t\t\tELSE 1=1\r\n\t\tEND) \r\nGROUP BY weidu_type,mb_type\r\nORDER BY tagid,CONVERT(weidu_type USING GBK),mb_typeseq,mb_type"
