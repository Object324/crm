          },
          "3": {
            "Name": "huikuan_target",
            "Index": -1,
            "NameInSource": "huikuan_target",
            "Alias": "huikuan_target",
            "Type": "System.Decimal"
          },
          "4": {
            "Name": "qianyue_done",
            "Index": -1,
            "NameInSource": "qianyue_done",
            "Alias": "qianyue_done",
            "Type": "System.Decimal"
          },
          "5": {
            "Name": "qianyue_qty",
            "Index": -1,
            "NameInSource": "qianyue_qty",
            "Alias": "qianyue_qty",
            "Type": "System.Decimal"
          },
          "6": {
            "Name": "qianyue_target",
            "Index": -1,
            "NameInSource": "qianyue_target",
            "Alias": "qianyue_target",
            "Type": "System.Decimal"
          }
        },
        "NameInSource": "连接",
        "SqlCommand": "SELECT\r\n\t(\r\n\t\tSELECT\r\n\t\t\tSUM(contractamount)\r\n\t\tFROM ld_salestarget\r\n\t\tWHERE targetyear=YEAR(NOW())\r\n\t\t\tAND targetmouth=MONTH(NOW())\r\n\t) AS qianyue_target,\r\n\t(\r\n\t\tSELECT\r\n\t\t\tSUM(total)\r\n\t\tFROM (\r\n\t\t\tSELECT\r\n\t\t\t\tSUM(ROUND(a.total/IFNULL(a.conversion_rate,1),2)) AS total\r\n\t\t\tFROM ld_salesorder a\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND IFNULL(a.sostatus,'')<>'已作废'\r\n\t\t\t\tAND a.signed_data BETWEEN DATE_ADD(CURDATE(),INTERVAL -DAY(CURDATE())+1 DAY) AND LAST_DAY(CURDATE())\r\n\t\t\tUNION ALL\r\n\t\t\tSELECT\r\n\t\t\t\tSUM(ROUND(a.total/IFNULL(a.conversion_rate,1),2)) AS total\r\n\t\t\tFROM ld_servicecontracts a\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND IFNULL(a.contract_status,'')<>'已作废'\r\n\t\t\t\tAND a.due_date BETWEEN DATE_ADD(CURDATE(),INTERVAL -DAY(CURDATE())+1 DAY) AND LAST_DAY(CURDATE()) \r\n\t\t) a\r\n\t) AS qianyue_done,\r\n\t(\r\n\t\tSELECT\r\n\t\t\tSUM(qty)\r\n\t\tFROM (\r\n\t\t\tSELECT\r\n\t\t\t\tCOUNT(a.salesorderid) AS qty\r\n\t\t\tFROM ld_salesorder a\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND IFNULL(a.sostatus,'')<>'已作废'\r\n\t\t\t\tAND a.signed_data BETWEEN DATE_ADD(CURDATE(),INTERVAL -DAY(CURDATE())+1 DAY) AND LAST_DAY(CURDATE())\r\n\t\t\tUNION ALL\r\n\t\t\tSELECT\r\n\t\t\t\tCOUNT(a.servicecontractsid) AS qty\r\n\t\t\tFROM ld_servicecontracts a\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND IFNULL(a.contract_status,'')<>'已作废'\r\n\t\t\t\tAND a.due_date BETWEEN DATE_ADD(CURDATE(),INTERVAL -DAY(CURDATE())+1 DAY) AND LAST_DAY(CURDATE()) \r\n\t\t) a\r\n\t) AS qianyue_qty,\r\n\t(\r\n\t\t\tSELECT\r\n\t\t\t\tSUM(paymentamount)\r\n\t\t\tFROM ld_salestarget\r\n\t\t\tWHERE targetyear=YEAR(NOW())\r\n\t\t\t\tAND targetmouth=MONTH(NOW())\r\n\t\t) AS huikuan_target,\r\n\t\t(\r\n\t\t\tSELECT\r\n\t\t\t\tSUM(ROUND(a.total/IFNULL(a.conversion_rate,1),2))\r\n\t\t\tFROM ld_cashbill a\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND a.cashbilldate BETWEEN DATE_ADD(CURDATE(),INTERVAL -DAY(CURDATE())+1 DAY) AND LAST_DAY(CURDATE())\r\n\t\t) AS huikuan__done,\r\n\t\t(\r\n\t\t\tSELECT\r\n\t\t\t\tCOUNT(a.accountid)\r\n\t\t\tFROM ld_account a\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND a.createdtime BETWEEN DATE_ADD(CURDATE(),INTERVAL -DAY(CURDATE())+1 DAY) AND DATE_ADD(LAST_DAY(CURDATE()),INTERVAL 1 DAY)\r\n\t\t) AS add_kehu,\r\n\t\t(\r\n\t\t\tSELECT\r\n\t\t\t\tCOUNT(a.contactrecordID)\r\n\t\t\tFROM ld_contactrecords a\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND a.contactdate BETWEEN DATE_ADD(CURDATE(),INTERVAL -DAY(CURDATE())+1 DAY) AND DATE_ADD(LAST_DAY(CURDATE()),INTERVAL 1 DAY)\r\n\t\t) AS add_lianxi\r\n"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "c",
        "Alias": "c",
        "Columns": {
          "0": {
            "Name": "dash_type",
            "Index": -1,
            "NameInSource": "dash_type",
            "Alias": "dash_type",
            "Type": "System.String"
          },
          "1": {
            "Name": "huikuan",
            "Index": -1,
            "NameInSource": "huikuan",
            "Alias": "huikuan",
            "Type": "System.Decimal"
          },
          "2": {
            "Name": "qianyue",
            "Index": -1,
            "NameInSource": "qianyue",
            "Alias": "qianyue",
            "Type": "System.Decimal"
          }
        },
        "NameInSource": "连接",
        "SqlCommand": "SELECT\r\n\tdash_type,\r\n\tCASE\r\n\t\tWHEN dash_type='未完成' AND qianyue<0 THEN 0\r\n\t\tELSE qianyue\r\n\tEND AS qianyue,\r\n\tCASE\r\n\t\tWHEN dash_type='未完成' AND huikuan<0 THEN 0\r\n\t\tELSE huikuan\r\n\tEND AS huikuan\r\nFROM (\r\n\tSELECT\r\n\t\t'完成' AS dash_type,\r\n\t\t(\r\n\t\t\tSELECT\r\n\t\t\t\tSUM(total)\r\n\t\t\tFROM (\r\n\t\t\t\tSELECT\r\n\t\t\t\t\tSUM(ROUND(a.total/IFNULL(a.conversion_rate,1),2)) AS total\r\n\t\t\t\tFROM ld_salesorder a\r\n\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\t\tAND IFNULL(a.sostatus,'')<>'已作废'\r\n\t\t\t\t\tAND a.signed_data BETWEEN DATE_ADD(CURDATE(),INTERVAL -DAY(CURDATE())+1 DAY) AND LAST_DAY(CURDATE())\r\n\t\t\t\tUNION ALL\r\n\t\t\t\tSELECT\r\n\t\t\t\t\tSUM(ROUND(a.total/IFNULL(a.conversion_rate,1),2)) AS total\r\n\t\t\t\tFROM ld_servicecontracts a\r\n\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\t\tAND IFNULL(a.contract_status,'')<>'已作废'\r\n\t\t\t\t\tAND a.due_date BETWEEN DATE_ADD(CURDATE(),INTERVAL -DAY(CURDATE())+1 DAY) AND LAST_DAY(CURDATE()) \r\n\t\t\t) a\r\n\t\t) AS qianyue,\r\n\t\t(\r\n\t\t\tSELECT\r\n\t\t\t\tSUM(ROUND(a.total/IFNULL(a.conversion_rate,1),2))\r\n\t\t\tFROM ld_cashbill a\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND a.cashbilldate BETWEEN DATE_ADD(CURDATE(),INTERVAL -DAY(CURDATE())+1 DAY) AND LAST_DAY(CURDATE())\r\n\t\t) AS huikuan\r\n\tUNION ALL\r\n\tSELECT\r\n\t\t'未完成' AS dash_type,\r\n\t\t(\r\n\t\t\tSELECT\r\n\t\t\t\tSUM(qianyue) AS qianyue\r\n\t\t\tFROM (\r\n\t\t\t\tSELECT\r\n\t\t\t\t\tSUM(contractamount) AS qianyue\r\n\t\t\t\tFROM ld_salestarget\r\n\t\t\t\tWHERE targetyear=YEAR(NOW())\r\n\t\t\t\t\tAND targetmouth=MONTH(NOW())\r\n\t\t\t\tUNION ALL\r\n\t\t\t\tSELECT\r\n\t\t\t\t\t-SUM(total)\r\n\t\t\t\tFROM (\r\n\t\t\t\t\tSELECT\r\n\t\t\t\t\t\tSUM(ROUND(a.total/IFNULL(a.conversion_rate,1),2)) AS total\r\n\t\t\t\t\tFROM ld_salesorder a\r\n\t\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\t\t\tAND IFNULL(a.sostatus,'')<>'已作废'\r\n\t\t\t\t\t\tAND a.signed_data BETWEEN DATE_ADD(CURDATE(),INTERVAL -DAY(CURDATE())+1 DAY) AND LAST_DAY(CURDATE())\r\n\t\t\t\t\tUNION ALL\r\n\t\t\t\t\tSELECT\r\n\t\t\t\t\t\tSUM(ROUND(a.total/IFNULL(a.conversion_rate,1),2)) AS total\r\n\t\t\t\t\tFROM ld_servicecontracts a\r\n\t\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\t\t\tAND IFNULL(a.contract_status,'')<>'已作废'\r\n\t\t\t\t\t\tAND a.due_date BETWEEN DATE_ADD(CURDATE(),INTERVAL -DAY(CURDATE())+1 DAY) AND LAST_DAY(CURDATE()) \r\n\t\t\t\t) a\r\n\t\t\t) a\r\n\t\t),\r\n\t\t(\r\n\t\t\tSELECT\r\n\t\t\t\tSUM(huikuan) AS huikuan\r\n\t\t\tFROM (\r\n\t\t\t\tSELECT\r\n\t\t\t\t\tSUM(paymentamount) AS huikuan\r\n\t\t\t\tFROM ld_salestarget\r\n\t\t\t\tWHERE targetyear=YEAR(NOW())\r\n\t\t\t\t\tAND targetmouth=MONTH(NOW())\r\n\t\t\t\tUNION ALL\r\n\t\t\t\tSELECT\r\n\t\t\t\t\t-SUM(ROUND(a.total/IFNULL(a.conversion_rate,1),2))\r\n\t\t\t\tFROM ld_cashbill a\r\n\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\t\tAND a.cashbilldate BETWEEN DATE_ADD(CURDATE(),INTERVAL -DAY(CURDATE())+1 DAY) AND LAST_DAY(CURDATE())\r\n\t\t\t) a\r\n\t\t)\r\n) tmp"
      },
      "2": {
        "Ident": "StiMySqlSource",
        "Name": "b",
        "Alias": "b",
        "Key": "a4116862c1b892cc0620a6cd76818cb3",
        "Columns": {
          "0": {
            "Name": "last_name",
            "Index": -1,
            "NameInSource": "last_name",
            "Alias": "last_name",
            "Type": "System.String"
          },
          "1": {
            "Name": "total_xiaoshou",
            "Index": -1,
            "NameInSource": "total_xiaoshou",
            "Alias": "total_xiaoshou",
            "Type": "System.Object"
          }
        },
        "NameInSource": "连接",
        "SqlCommand": "SELECT\r\n\tu.last_name,\r\n\tSUM(a.total) AS total_xiaoshou\r\nFROM (\r\n\tSELECT\r\n\t\ta.smownerid,\r\n\t\tSUM(ROUND(a.total/IFNULL(a.conversion_rate,1),2)) AS total\r\n\tFROM ld_salesorder a\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND IFNULL(a.sostatus,'')<>'已作废'\r\n\t\tAND a.signed_data BETWEEN DATE_ADD(CURDATE(),INTERVAL -DAY(CURDATE())+1 DAY) AND LAST_DAY(CURDATE())\r\n\tGROUP BY a.smownerid\r\n\tUNION ALL\r\n\tSELECT\r\n\t\ta.smownerid,\r\n\t\tSUM(ROUND(a.total/IFNULL(a.conversion_rate,1),2)) AS total\r\n\tFROM ld_servicecontracts a\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND IFNULL(a.contract_status,'')<>'已作废'\r\n\t\tAND a.due_date BETWEEN DATE_ADD(CURDATE(),INTERVAL -DAY(CURDATE())+1 DAY) AND LAST_DAY(CURDATE()) \r\n\tGROUP BY a.smownerid\r\n) a\r\nLEFT JOIN ld_users u ON u.id=a.smownerid\r\nGROUP BY a.smownerid\r\nORDER BY total_xiaoshou DESC LIMIT 5"
      },
      "3": {
        "Ident": "StiMySqlSource",
        "Name": "d",
        "Alias": "d",
        "Columns": {
          "0": {
            "Name": "amount",
            "Index": -1,
            "NameInSource": "amount",
            "Alias": "amount",
            "Type": "System.Object"
          },
          "1": {
            "Name": "qty",
            "Index": -1,
            "NameInSource": "qty",
            "Alias": "qty",
            "Type": "System.Int32"
          },
          "2": {
            "Name": "sales_stage",
            "Index": -1,
            "NameInSource": "sales_stage",
            "Alias": "sales_stage",
            "Type": "System.String"
          }
        },
        "NameInSource": "连接",
        "SqlCommand": "SELECT\r\n\ta.sales_stage,\r\n\tCOUNT(a.potentialid) AS qty,\r\n\tROUND(SUM(a.amount/IFNULL(a.conversion_rate,1))*0.0001,2) AS amount\r\nFROM ld_potential a\r\nLEFT JOIN (\r\n\tSELECT \r\n\t\tb.listvalue,\r\n\t\tb.sequence \r\n\tFROM ld_picklist_set a \r\n\tLEFT JOIN ld_picklist_values b ON a.listid=b.listid \r\n\tWHERE a.listname='sales_stage'\r\n) b ON b.listvalue=a.sales_stage\r\nWHERE a.deleted=0\r\n\tAND a.approvestatus<>'已拒绝'\r\n\tAND IFNULL(a.sales_stage,'')<>''\r\n\tAND a.closingdate BETWEEN DATE_ADD(CURDATE(),INTERVAL -DAY(CURDATE())+1 DAY) AND LAST_DAY(CURDATE())\r\nGROUP BY a.sales_stage\r\nORDER BY b.sequence"
      }
    },
