          },
          "1": {
            "Name": "add_lianxi",
            "Index": -1,
            "NameInSource": "add_lianxi",
            "Alias": "add_lianxi",
            "Type": "System.Decimal"
          },
          "2": {
            "Name": "huikuan__done",
            "Index": -1,
            "NameInSource": "huikuan__done",
            "Alias": "huikuan__done",
