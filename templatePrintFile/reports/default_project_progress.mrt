        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\ta.projecttaskid AS keyid,\r\n\ta.argumnt,\r\n\ta.progress,\r\n\ta.startdate,\r\n\ta.enddate,\r\n\ta.tips AS mytips,\r\n\tb.color,\r\n\ta.seq\r\nFROM (\r\n\tSELECT\r\n\t\ta.projectid,\r\n\t\ta.projecttaskid,\r\n\t\ta.argumnt,\r\n\t\ta.progress,\r\n\t\ta.startdate,\r\n\t\ta.enddate,\r\n\t\ta.tips,\r\n\t\t(@i:=@i+1) AS seq\r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\ta.projectid,\r\n\t\t\ta.projecttaskid,\r\n\t\t\tb.projectname,\r\n\t\t\ta.projecttaskname,\r\n\t\t\ta.projecttaskprogress AS progress,\r\n\t\t\tDATE_FORMAT(a.startdate,'%Y-%m-%d 00:00:00') AS startdate,\r\n\t\t\tDATE_FORMAT(a.enddate,'%Y-%m-%d 23:59:59') AS enddate,\r\n\t\t\tCONCAT('『',IFNULL(b.projectname,''),'』-『',IFNULL(a.projecttaskname,''),'』') AS argumnt,\r\n\t\t\tCONCAT('『',IFNULL(b.projectname,''),'』-『',IFNULL(a.projecttaskname,''),'』',CHAR(13),\r\n\t\t\t\t'开始：',IFNULL(a.startdate,''),CHAR(13),\r\n\t\t\t\t'结束：',IFNULL(a.enddate,''),CHAR(13),\r\n\t\t\t\t'进度：',IFNULL(a.projecttaskprogress,'')\r\n\t\t\t\t) AS tips\r\n\t\tFROM ld_projecttask a\r\n\t\tLEFT JOIN ld_project b ON b.projectid=a.projectid\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{xm_name}'='' THEN \r\n\t\t\t\t\t\ta.projectid=(\r\n\t\t\t\t\t\t\tSELECT\r\n\t\t\t\t\t\t\t\ta.projectid\r\n\t\t\t\t\t\t\tFROM ld_projecttask a\r\n\t\t\t\t\t\t\tINNER JOIN ld_project b ON b.projectid=a.projectid\r\n\t\t\t\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\t\t\t\tAND b.deleted=0\r\n\t\t\t\t\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\t\t\t\t\tAND b.approvestatus<>'已拒绝'\r\n\t\t\t\t\t\t\tORDER BY CONVERT(b.projectname USING GBK),a.startdate,a.enddate,a.projecttaskid\r\n\t\t\t\t\t\t\tLIMIT 1)\r\n\t\t\t\t\tELSE a.projectid='{xm_name}'\r\n\t\t\t\tEND)\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{jh_name}'='' THEN 1=1\r\n\t\t\t\t\tELSE FIND_IN_SET(a.projecttaskid,'{jh_name}')\r\n\t\t\t\tEND)\r\n\t) a,(SELECT @i:=0) b\r\n\tORDER BY a.projectid,a.projecttaskid\r\n) a\r\nLEFT JOIN ld_usercolor b ON b.id=a.seq\r\nORDER BY a.seq DESC"
      },
