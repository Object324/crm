          "3": {
            "Name": "xmname",
            "Index": -1,
            "NameInSource": "xmname",
            "Alias": "xmname",
            "Type": "System.String"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\ta.projectid AS xmid,\r\n\tb.projectname AS xmname,\r\n\ta.projecttaskid AS xmjh_id,\r\n\ta.projecttaskname AS xmjh_name\r\nFROM ld_projecttask a\r\nINNER JOIN ld_project b ON b.projectid=a.projectid\r\nWHERE a.deleted=0\r\n\tAND b.deleted=0\r\n\tAND a.approvestatus<>'已拒绝'\r\n\tAND b.approvestatus<>'已拒绝'\r\nORDER BY CONVERT(b.projectname USING GBK),a.startdate,a.enddate,a.projecttaskid"
      }
    },
