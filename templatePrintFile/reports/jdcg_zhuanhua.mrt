            "Type": "System.Decimal"
          }
        },
        "NameInSource": "ldcrm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\tCASE\r\n\t\tWHEN a.qichushangji_qty>0 THEN IFNULL(a.zhongbiao_qty,0)/a.qichushangji_qty\r\n\tEND AS sj_to_zb,\r\n\tCASE\r\n\t\tWHEN a.qichulixiang_qty>0 THEN IFNULL(a.zhongbiao_qty,0)/a.qichulixiang_qty\r\n\tEND AS lxto_zb,\r\n\tCASE\r\n\t\tWHEN a.qichushangwu_qty>0 THEN IFNULL(a.zhongbiao_qty,0)/a.qichushangwu_qty\r\n\tEND AS sw_to_zb\r\nFROM (\r\n\tSELECT\r\n\t\t(\r\n\t\t\tSELECT\r\n\t\t\t\tCOUNT(DISTINCT potentialid)\r\n\t\t\tFROM (\r\n\t\t\t\tSELECT\r\n\t\t\t\t\ta.potentialid\r\n\t\t\t\tFROM ld_potential a\r\n\t\t\t\tINNER JOIN (\r\n\t\t\t\t\tSELECT DISTINCT\r\n\t\t\t\t\t\tuserid \r\n\t\t\t\t\tFROM (\r\n\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\tld_users.id AS userid \r\n\t\t\t\t\t\tFROM ld_users\r\n\t\t\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Potentials' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\t\t\t\tUNION\r\n\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\tviewid AS userid \r\n\t\t\t\t\t\tFROM ld_scoperhigher\r\n\t\t\t\t\t\tWHERE userid='[uuid]' AND modulename ='Potentials' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename ='Potentials')\t\t\t\r\n\t\t\t\t\t\tUNION\r\n\t\t\t\t\t\tSELECT DISTINCT \r\n\t\t\t\t\t\t\tld_users2group.userid AS userid \r\n\t\t\t\t\t\tFROM ld_scoperhigher \r\n\t\t\t\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\t\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\t\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\t\t\t\tAND ld_scoperhigher.modulename ='Potentials'\r\n\t\t\t\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Potentials' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\t\t\t\tUNION \r\n\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\tid AS userid \r\n\t\t\t\t\t\tFROM ld_users  \r\n\t\t\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\t\t\t\tUNION\r\n\t\t\t\t\t\tSELECT '[uuid]') AS vw_users\r\n\t\t\t\t) AS tmp_users ON tmp_users.userid=a.smownerid\r\n\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\tAND a.sales_stage='商机阶段'\r\n\t\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\t\tAND a.createdtime<DATE_FORMAT('{start_date}','%Y-%m-%d 00:00:00')\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT\r\n\t\t\t\t\ta.potentialid\r\n\t\t\t\tFROM ld_potential a\r\n\t\t\t\tINNER JOIN ld_tabshare s ON s.crmid=a.potentialid\r\n\t\t\t\tWHERE s.viewuserid='[uuid]'\r\n\t\t\t\t\tAND a.deleted=0\r\n\t\t\t\t\tAND a.sales_stage='商机阶段'\r\n\t\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\t\tAND a.createdtime<DATE_FORMAT('{start_date}','%Y-%m-%d 00:00:00')\r\n\t\t\t) a\r\n\t\t) AS qichushangji_qty,\r\n\t\t(\r\n\t\t\tSELECT\r\n\t\t\t\tCOUNT(DISTINCT potentialid)\r\n\t\t\tFROM (\r\n\t\t\t\tSELECT\r\n\t\t\t\t\ta.potentialid\r\n\t\t\t\tFROM ld_potential a\r\n\t\t\t\tINNER JOIN (\r\n\t\t\t\t\tSELECT DISTINCT\r\n\t\t\t\t\t\tuserid \r\n\t\t\t\t\tFROM (\r\n\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\tld_users.id AS userid \r\n\t\t\t\t\t\tFROM ld_users\r\n\t\t\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Potentials' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\t\t\t\tUNION\r\n\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\tviewid AS userid \r\n\t\t\t\t\t\tFROM ld_scoperhigher\r\n\t\t\t\t\t\tWHERE userid='[uuid]' AND modulename ='Potentials' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename ='Potentials')\t\t\t\r\n\t\t\t\t\t\tUNION\r\n\t\t\t\t\t\tSELECT DISTINCT \r\n\t\t\t\t\t\t\tld_users2group.userid AS userid \r\n\t\t\t\t\t\tFROM ld_scoperhigher \r\n\t\t\t\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\t\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\t\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\t\t\t\tAND ld_scoperhigher.modulename ='Potentials'\r\n\t\t\t\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Potentials' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\t\t\t\tUNION \r\n\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\tid AS userid \r\n\t\t\t\t\t\tFROM ld_users  \r\n\t\t\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\t\t\t\tUNION\r\n\t\t\t\t\t\tSELECT '[uuid]') AS vw_users\r\n\t\t\t\t) AS tmp_users ON tmp_users.userid=a.smownerid\r\n\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\tAND a.sales_stage='立项阶段'\r\n\t\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\t\tAND a.createdtime<DATE_FORMAT('{start_date}','%Y-%m-%d 00:00:00')\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT\r\n\t\t\t\t\ta.potentialid\r\n\t\t\t\tFROM ld_potential a\r\n\t\t\t\tINNER JOIN ld_tabshare s ON s.crmid=a.potentialid\r\n\t\t\t\tWHERE s.viewuserid='[uuid]'\r\n\t\t\t\t\tAND a.deleted=0\r\n\t\t\t\t\tAND a.sales_stage='立项阶段'\r\n\t\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\t\tAND a.createdtime<DATE_FORMAT('{start_date}','%Y-%m-%d 00:00:00')\r\n\t\t\t) a\r\n\t\t) AS qichulixiang_qty,\r\n\t\t(\r\n\t\t\tSELECT\r\n\t\t\t\tCOUNT(DISTINCT potentialid)\r\n\t\t\tFROM (\r\n\t\t\t\tSELECT\r\n\t\t\t\t\ta.potentialid\r\n\t\t\t\tFROM ld_potential a\r\n\t\t\t\tINNER JOIN (\r\n\t\t\t\t\tSELECT DISTINCT\r\n\t\t\t\t\t\tuserid \r\n\t\t\t\t\tFROM (\r\n\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\tld_users.id AS userid \r\n\t\t\t\t\t\tFROM ld_users\r\n\t\t\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Potentials' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\t\t\t\tUNION\r\n\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\tviewid AS userid \r\n\t\t\t\t\t\tFROM ld_scoperhigher\r\n\t\t\t\t\t\tWHERE userid='[uuid]' AND modulename ='Potentials' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename ='Potentials')\t\t\t\r\n\t\t\t\t\t\tUNION\r\n\t\t\t\t\t\tSELECT DISTINCT \r\n\t\t\t\t\t\t\tld_users2group.userid AS userid \r\n\t\t\t\t\t\tFROM ld_scoperhigher \r\n\t\t\t\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\t\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\t\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\t\t\t\tAND ld_scoperhigher.modulename ='Potentials'\r\n\t\t\t\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Potentials' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\t\t\t\tUNION \r\n\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\tid AS userid \r\n\t\t\t\t\t\tFROM ld_users  \r\n\t\t\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\t\t\t\tUNION\r\n\t\t\t\t\t\tSELECT '[uuid]') AS vw_users\r\n\t\t\t\t) AS tmp_users ON tmp_users.userid=a.smownerid\r\n\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\tAND a.sales_stage='商务谈判'\r\n\t\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\t\tAND a.createdtime<DATE_FORMAT('{start_date}','%Y-%m-%d 00:00:00')\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT\r\n\t\t\t\t\ta.potentialid\r\n\t\t\t\tFROM ld_potential a\r\n\t\t\t\tINNER JOIN ld_tabshare s ON s.crmid=a.potentialid\r\n\t\t\t\tWHERE s.viewuserid='[uuid]'\r\n\t\t\t\t\tAND a.deleted=0\r\n\t\t\t\t\tAND a.sales_stage='商务谈判'\r\n\t\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\t\tAND a.createdtime<DATE_FORMAT('{start_date}','%Y-%m-%d 00:00:00')\r\n\t\t\t) a\r\n\t\t) AS qichushangwu_qty,\r\n\t(\r\n\t\tSELECT\r\n\t\t\tCOUNT(DISTINCT potentialid)\r\n\t\tFROM (\r\n\t\t\tSELECT\r\n\t\t\t\tc.potentialid\r\n\t\t\tFROM ld_customform50 a\r\n\t\t\tLEFT JOIN ld_customform50scf b ON b.customform50id=a.customform50id\r\n\t\t\tLEFT JOIN ld_potential c ON c.potentialid=a.potentialid\r\n\t\t\tINNER JOIN (\r\n\t\t\t\tSELECT DISTINCT\r\n\t\t\t\t\tuserid \r\n\t\t\t\tFROM (\r\n\t\t\t\t\tSELECT \r\n\t\t\t\t\t\tld_users.id AS userid \r\n\t\t\t\t\tFROM ld_users\r\n\t\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Potentials' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\t\t\tUNION\r\n\t\t\t\t\tSELECT \r\n\t\t\t\t\t\tviewid AS userid \r\n\t\t\t\t\tFROM ld_scoperhigher\r\n\t\t\t\t\tWHERE userid='[uuid]' AND modulename ='Potentials' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename ='Potentials')\t\t\t\r\n\t\t\t\t\tUNION\r\n\t\t\t\t\tSELECT DISTINCT \r\n\t\t\t\t\t\tld_users2group.userid AS userid \r\n\t\t\t\t\tFROM ld_scoperhigher \r\n\t\t\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\t\t\tAND ld_scoperhigher.modulename ='Potentials'\r\n\t\t\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Potentials' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\t\t\tUNION \r\n\t\t\t\t\tSELECT \r\n\t\t\t\t\t\tid AS userid \r\n\t\t\t\t\tFROM ld_users  \r\n\t\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\t\t\tUNION\r\n\t\t\t\t\tSELECT '[uuid]') AS vw_users\r\n\t\t\t) AS tmp_users ON tmp_users.userid=a.smownerid\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND c.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND c.approvestatus<>'已拒绝'\r\n\t\t\t\tAND b.cf_4927='方案中标-转交付阶段'\r\n\t\t\t\tAND b.cf_4929 BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\t\t\tUNION\r\n\t\t\tSELECT\r\n\t\t\t\tc.potentialid\r\n\t\t\tFROM ld_customform50 a\r\n\t\t\tLEFT JOIN ld_customform50scf b ON b.customform50id=a.customform50id\r\n\t\t\tLEFT JOIN ld_potential c ON c.potentialid=a.potentialid\r\n\t\t\tINNER JOIN ld_tabshare s ON s.crmid=a.potentialid\r\n\t\t\tWHERE s.viewuserid='[uuid]'\r\n\t\t\t\tAND a.deleted=0\r\n\t\t\t\tAND c.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND c.approvestatus<>'已拒绝'\r\n\t\t\t\tAND b.cf_4927='方案中标-转交付阶段'\r\n\t\t\t\tAND b.cf_4929 BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\t\t) a\r\n\t) AS zhongbiao_qty\r\n) a"
      }
    },
