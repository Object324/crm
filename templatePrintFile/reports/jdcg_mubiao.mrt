          "3": {
            "Name": "mb_rate_last",
            "Index": -1,
            "NameInSource": "mb_rate_last",
            "Alias": "mb_rate_last",
            "Type": "System.Decimal"
          },
          "4": {
            "Name": "mb_type",
            "Index": -1,
