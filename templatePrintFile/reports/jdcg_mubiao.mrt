='{nian}' THEN a.total ELSE 0 END)\r\n\t\tEND AS wc_total,\r\n\t\t\r\n\t\tCASE\r\n\t\t\tWHEN '{weidu}'=1 AND u.userlevel IN ('区域负责人') THEN\r\n\t\t\t\t(\r\n\t\t\t\t\tSELECT\r\n\t\t\t\t\t\tSUM(x.total)*0.0001 AS wc_total\r\n\t\t\t\t\tFROM ld_cashbill x\r\n\t\t\t\t\tLEFT JOIN ld_users y ON y.id=x.smownerid\r\n\t\t\t\t\tWHERE x.deleted=0\r\n\t\t\t\t\t\tAND x.approvestatus<>'已拒绝'\r\n\t\t\t\t\t\tAND YEAR(x.createdtime)='{nian}'-1\r\n\t\t\t\t\t\tAND y.groupid=u.groupid\r\n\t\t\t\t\t\tAND y.userlevel IN ('客户经理','区域负责人')\r\n\t\t\t\t\t\tAND (\r\n\t\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(MONTH(x.cashbilldate),'{date_value}')\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(QUARTER(x.cashbilldate),'{date_value}')\r\n\t\t\t\t\t\t\tEND)\r\n\t\t\t\t)\r\n\t\t\tELSE SUM(CASE WHEN YEAR(a.cashbilldate)='{nian}'-1 THEN a.total ELSE 0 END)\r\n\t\tEND AS wc_total_last\r\n\tFROM ld_cashbill a\r\n\tLEFT JOIN ld_cashbillscf b ON b.cashbillid=a.cashbillid\r\n\tLEFT JOIN ld_users u ON u.id=a.smownerid\r\n\tLEFT JOIN ld_users v ON v.last_name=b.cf_5856\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND YEAR(a.cashbilldate) IN ('{nian}','{nian}'-1)\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(MONTH(a.cashbilldate),'{date_value}')\r\n\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(QUARTER(a.cashbilldate),'{date_value}')\r\n\t\t\tEND)\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{yewu_type}'='' THEN b.cf_5855 IN (SELECT listvalue FROM ld_picklist_values WHERE listid=130)\r\n\t\t\t\tELSE FIND_IN_SET(b.cf_5855,'{yewu_type}')\r\n\t\t\tEND)\r\n\tGROUP BY (CASE WHEN '{weidu}'=5 THEN v.id ELSE a.smownerid END)\r\n\tUNION\r\n\tSELECT\r\n\t\t'线索' AS wc_type,\r\n\t\ta.smownerid,\r\n\r\n\t\tCASE\r\n\t\t\tWHEN '{weidu}'=1 AND u.userlevel IN ('区域负责人') THEN\r\n\t\t\t\t(\r\n\t\t\t\t\tSELECT\r\n\t\t\t\t\t\tCOUNT(1) AS wc_total\r\n\t\t\t\t\tFROM ld_customform53 x\r\n\t\t\t\t\tLEFT JOIN ld_users y ON y.id=x.smownerid\r\n\t\t\t\t\tWHERE x.deleted=0\r\n\t\t\t\t\t\tAND x.approvestatus<>'已拒绝'\r\n\t\t\t\t\t\tAND YEAR(x.createdtime)='{nian}'\r\n\t\t\t\t\t\tAND y.groupid=u.groupid\r\n\t\t\t\t\t\tAND y.userlevel IN ('客户经理','区域负责人')\r\n\t\t\t\t\t\tAND (\r\n\t\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(MONTH(x.createdtime),'{date_value}')\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(QUARTER(x.createdtime),'{date_value}')\r\n\t\t\t\t\t\t\tEND)\r\n\t\t\t\t)\r\n\t\t\tELSE SUM(CASE WHEN YEAR(a.createdtime)='{nian}' THEN 1 ELSE 0 END)\r\n\t\tEND AS wc_total,\r\n\t\t\r\n\t\tCASE\r\n\t\t\tWHEN '{weidu}'=1 AND u.userlevel IN ('区域负责人') THEN\r\n\t\t\t\t(\r\n\t\t\t\t\tSELECT\r\n\t\t\t\t\t\tCOUNT(1) AS wc_total\r\n\t\t\t\t\tFROM ld_customform53 x\r\n\t\t\t\t\tLEFT JOIN ld_users y ON y.id=x.smownerid\r\n\t\t\t\t\tWHERE x.deleted=0\r\n\t\t\t\t\t\tAND x.approvestatus<>'已拒绝'\r\n\t\t\t\t\t\tAND YEAR(x.createdtime)='{nian}'-1\r\n\t\t\t\t\t\tAND y.groupid=u.groupid\r\n\t\t\t\t\t\tAND y.userlevel IN ('客户经理','区域负责人')\r\n\t\t\t\t\t\tAND (\r\n\t\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(MONTH(x.createdtime),'{date_value}')\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')='' THE