 ON u.id=c.lin_users_id\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\tAND c.lin_users_id>0\r\n\t\t\tAND b.cf_5276 IN ('{nian}','{nian}'-1)\r\n\t\tUNION\r\n\t\tSELECT\r\n\t\t\tc.lin_users_id,\r\n\t\t\tb.cf_5276 AS mb_nian,\r\n\t\t\t8 AS mb_yue,\r\n\t\t\t3 AS mb_ji,\r\n\t\t\tb.cf_5277 AS mb_type,\r\n\t\t\tCASE WHEN b.cf_5276='{nian}' THEN d.sf291 ELSE 0 END AS mb_amount,\r\n\t\t\tCASE WHEN b.cf_5276='{nian}'-1 THEN d.sf291 ELSE 0 END AS mb_amount_last,\r\n\t\t\tCASE WHEN b.cf_5276='{nian}' AND u.userlevel NOT IN ('区域负责人') THEN d.sf291 ELSE 0 END AS mb_amount2,\r\n\t\t\tCASE WHEN b.cf_5276='{nian}'-1 AND u.userlevel NOT IN ('区域负责人') THEN d.sf291 ELSE 0 END AS mb_amount_last2\r\n\t\tFROM ld_customform22 a\r\n\t\tLEFT JOIN ld_customform22scf b ON b.customform22id=a.customform22id\r\n\t\tLEFT JOIN ld_customform22detail c ON c.id=a.customform22id\r\n\t\tLEFT JOIN ld_customform22detailscf d ON d.lineitem_id=c.lineitem_id\r\n\t\tLEFT JOIN ld_users u ON u.id=c.lin_users_id\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\tAND c.lin_users_id>0\r\n\t\t\tAND b.cf_5276 IN ('{nian}','{nian}'-1)\r\n\t\tUNION\r\n\t\tSELECT\r\n\t\t\tc.lin_users_id,\r\n\t\t\tb.cf_5276 AS mb_nian,\r\n\t\t\t9 AS mb_yue,\r\n\t\t\t3 AS mb_ji,\r\n\t\t\tb.cf_5277 AS mb_type,\r\n\t\t\tCASE WHEN b.cf_5276='{nian}' THEN d.sf292 ELSE 0 END AS mb_amount,\r\n\t\t\tCASE WHEN b.cf_5276='{nian}'-1 THEN d.sf292 ELSE 0 END AS mb_amount_last,\r\n\t\t\tCASE WHEN b.cf_5276='{nian}' AND u.userlevel NOT IN ('区域负责人') THEN d.sf292 ELSE 0 END AS mb_amount2,\r\n\t\t\tCASE WHEN b.cf_5276='{nian}'-1 AND u.userlevel NOT IN ('区域负责人') THEN d.sf292 ELSE 0 END AS mb_amount_last2\r\n\t\tFROM ld_customform22 a\r\n\t\tLEFT JOIN ld_customform22scf b ON b.customform22id=a.customform22id\r\n\t\tLEFT JOIN ld_customform22detail c ON c.id=a.customform22id\r\n\t\tLEFT JOIN ld_customform22detailscf d ON d.lineitem_id=c.lineitem_id\r\n\t\tLEFT JOIN ld_users u ON u.id=c.lin_users_id\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\tAND c.lin_users_id>0\r\n\t\t\tAND b.cf_5276 IN ('{nian}','{nian}'-1)\r\n\t\tUNION\r\n\t\tSELECT\r\n\t\t\tc.lin_users_id,\r\n\t\t\tb.cf_5276 AS mb_nian,\r\n\t\t\t10 AS mb_yue,\r\n\t\t\t4 AS mb_ji,\r\n\t\t\tb.cf_5277 AS mb_type,\r\n\t\t\tCASE WHEN b.cf_5276='{nian}' THEN d.sf293 ELSE 0 END AS mb_amount,\r\n\t\t\tCASE WHEN b.cf_5276='{nian}'-1 THEN d.sf293 ELSE 0 END AS mb_amount_last,\r\n\t\t\tCASE WHEN b.cf_5276='{nian}' AND u.userlevel NOT IN ('区域负责人') THEN d.sf293 ELSE 0 END AS mb_amount2,\r\n\t\t\tCASE WHEN b.cf_5276='{nian}'-1 AND u.userlevel NOT IN ('区域负责人') THEN d.sf293 ELSE 0 END AS mb_amount_last2\r\n\t\tFROM ld_customform22 a\r\n\t\tLEFT JOIN ld_customform22scf b ON b.customform22id=a.customform22id\r\n\t\tLEFT JOIN ld_customform22detail c ON c.id=a.customform22id\r\n\t\tLEFT JOIN ld_customform22detailscf d ON d.lineitem_id=c.lineitem_id\r\n\t\tLEFT JOIN ld_users u ON u.id=c.lin_users_id\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\tAND c.lin_users_id>0\r\n\t\t\tAND b.cf_5276 IN ('{nian}','{nian}'-1)\r\n\t\tUNION\r\n\t\tSELECT\r\n\t\t\tc.lin_users_id,\r\n\t\t\tb.cf_5276 AS mb_nian,\r\n\t\t\t11 AS mb_yue,\r\n\t\t\t4 AS mb_ji,\r\n\t\t\tb.cf_5277 AS mb_type,\r\n\t\t\tCASE WHEN b.cf_5276='{nian}' THEN d.sf294 ELSE 0 END AS mb_amount,\r\n\t\t\tCASE WHEN b.cf_5276='{nian}'-1 THEN d.sf294 ELSE 0 END AS mb_amount_last,\r\n\t\t\tCASE WHEN b.cf_5276='{nian}' AND u.userlevel NOT IN ('区域负责人') THEN d.sf294 ELSE 0 END AS mb_amount2,\r\n\t\t\tCASE WHEN b.cf_5276='{nian}'-1 AND u.userlevel NOT IN ('区域负责人') THEN d.sf294 ELSE 0 END AS mb_amount_last2\r\n\t\tFROM ld_customform22 a\r\n\t\tLEFT JOIN ld_customform22scf b ON b.customform22id=a.customform22id\r\n\t\tLEFT JOIN ld_customform22detail c ON c.id=a.customform22id\r\n\t\tLEFT JOIN ld_customform22detailscf d ON d.lineitem_id=c.lineitem_id\r\n\t\tLEFT JOIN ld_users u ON u.id=c.lin_users_id\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\tAND c.lin_users_id>0\r\n\t\t\tAND b.cf_5276 IN ('{nian}','{nian}'-1)\r\n\t\tUNION\r\n\t\tSELECT\r\n\t\t\tc.lin_users_id,\r\n\t\t\tb.cf_5276 AS mb_nian,\r\n\t\t\t12 AS mb_yue,\r\n\t\t\t4 AS mb_ji,\r\n\t\t\tb.cf_5277 AS mb_type,\r\n\t\t\tCASE WHEN b.cf_5276='{nian}' THEN d.sf295 ELSE 0 END AS mb_amount,\r\n\t\t\tCASE WHEN b.cf_5276='{nian}'-1 THEN d.sf295 ELSE 0 END AS mb_amount_last,\r\n\t\t\tCASE WHEN b.cf_5276='{nian}' AND u.userlevel NOT IN ('区域负责人') THEN d.sf295 ELSE 0 END AS mb_amount2,\r\n\t\t\tCASE WHEN b.cf_5276='{nian}'-1 AND u.userlevel NOT IN ('区域负责人') THEN d.sf295 ELSE 0 END AS mb_amount_last2\r\n\t\tFROM ld_customform22 a\r\n\t\tLEFT JOIN ld_customform22scf b ON b.customform22id=a.customform22id\r\n\t\tLEFT JOIN ld_customform22detail c ON c.id=a.customform22id\r\n\t\tLEFT JOIN ld_customform22detailscf d ON d.lineitem_id=c.lineitem_id\r\n\t\tLEFT JOIN ld_users u ON u.id=c.lin_users_id\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\tAND c.lin_users_id>0\r\n\t\t\tAND b.cf_5276 IN ('{nian}','{nian}'-1)\r\n\t) a\r\n\tWHERE 1=1\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(a.mb_yue,'{date_value}')\r\n\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(a.mb_ji,'{date_value}')\r\n\t\t\tEND)\r\n\tGROUP BY a.lin_users_id,mb_type,mb_nian\r\n) m ON m.lin_users_id=a.id AND m.mb_type=b.listvalue\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\t'合同额' AS wc_type,\r\n\t\t(CASE WHEN '{weidu}'=5 THEN v.id ELSE a.smownerid END) AS smownerid,\r\n\t\tCASE\r\n\t\t\tWHEN '{weidu}'=1 AND u.userlevel IN ('区域负责人') THEN\r\n\t\t\t\t(\r\n\t\t\t\t\tSELECT\r\n\t\t\t\t\t\tSUM(x.total)*0.0001 AS wc_total\r\n\t\t\t\t\tFROM ld_servicecontracts x\r\n\t\t\t\t\tLEFT JOIN ld_users y ON y.id=x.smownerid\r\n\t\t\t\t\tWHERE x.deleted=0\r\n\t\t\t\t\t\tAND x.approvestatus='已批准'\r\n\t\t\t\t\t\tAND YEAR(x.createdtime)='{nian}'\r\n\t\t\t\t\t\tAND y.groupid=u.groupid\r\n\t\t\t\t\t\tAND y.userlevel IN ('客户经理','区域负责人')\r\n\t\t\t\t\t\tAND (\r\n\t\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(MONTH(x.createdtime),'{date_value}')\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(QUARTER(x.createdtime),'{date_value}')\r\n\t\t\t\t\t\t\tEND)\r\n\t\t\t\t)\r\n\t\t\tELSE SUM(CASE WHEN YEAR(a.createdtime)='{nian}' THEN a.total ELSE 0 END)\r\n\t\tEND AS wc_total,\r\n\t\t\r\n\t\tCASE\r\n\t\t\tWHEN '{weidu}'=1 AND u.userlevel IN ('区域负责人') THEN\r\n\t\t\t\t(\r\n\t\t\t\t\tSELECT\r\n\t\t\t\t\t\tSUM(x.total)*0.0001 AS wc_total\r\n\t\t\t\t\tFROM ld_servicecontracts x\r\n\t\t\t\t\tLEFT JOIN ld_users y ON y.id=x.smownerid\r\n\t\t\t\t\tWHERE x.deleted=0\r\n\t\t\t\t\t\tAND x.approvestatus='已批准'\r\n\t\t\t\t\t\tAND YEAR(x.createdtime)='{nian}'-1\r\n\t\t\t\t\t\tAND y.groupid=u.groupid\r\n\t\t\t\t\t\tAND y.userlevel IN ('客户经理','区域负责人')\r\n\t\t\t\t\t\tAND (\r\n\t\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(MONTH(x.createdtime),'{date_value}')\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(QUARTER(x.createdtime),'{date_value}')\r\n\t\t\t\t\t\t\tEND)\r\n\t\t\t\t)\r\n\t\t\tELSE SUM(CASE WHEN YEAR(a.createdtime)='{nian}'-1 THEN a.total ELSE 0 END)\r\n\t\tEND AS wc_total_last\r\n\tFROM ld_servicecontracts a\r\n\tLEFT JOIN ld_servicecontractscf b ON b.servicecontractsid=a.servicecontractsid\r\n\tLEFT JOIN ld_users u ON u.id=a.smownerid\r\n\tLEFT