        },
        "NameInSource": "ldcrm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\tCASE\r\n\t\tWHEN '{weidu}' IN (1,5,8) THEN id\r\n\t\tELSE weidu_type\r\n\tEND AS tagid,\r\n\tweidu_descp,\r\n\tweidu_type,\r\n\tmb_type,\r\n\tmb_type_show,\r\n\tCASE\r\n\t\tWHEN '{weidu}' IN (1,5,8) THEN SUM(mb_amount)\r\n\t\tELSE SUM(mb_amount)-SUM(mb_amount2)\r\n\tEND mb_amount,\r\n\tCASE\r\n\t\tWHEN '{weidu}' IN (1,5,8) THEN SUM(mb_amount_last)\r\n\t\tELSE SUM(mb_amount_last)-SUM(mb_amount_last2)\r\n\tEND mb_amount_last,\r\n\tSUM(wc_total) AS wc_total,\r\n\tSUM(wc_total_last) AS wc_total_last,\r\n\tCASE\r\n\t\tWHEN (CASE WHEN '{weidu}' IN (1,5,8) THEN SUM(mb_amount) ELSE SUM(mb_amount)-SUM(mb_amount2) END)>0 THEN \r\n\t\t\tSUM(wc_total)/(CASE WHEN '{weidu}'=1 THEN SUM(mb_amount) ELSE SUM(mb_amount)-SUM(mb_amount2) END)\r\n\t\tELSE NULL\r\n\tEND AS mb_rate,\r\n\tCASE\r\n\t\tWHEN (CASE WHEN '{weidu}' IN (1,5,8) THEN SUM(mb_amount_last) ELSE SUM(mb_amount_last)-SUM(mb_amount_last2) END)>0 THEN \r\n\t\t\tSUM(wc_total_last)/(CASE WHEN '{weidu}' IN (1,5,8) THEN SUM(mb_amount_last) ELSE SUM(mb_amount_last)-SUM(mb_amount_last2) END)\r\n\t\tELSE NULL\r\n\tEND AS mb_rate_last\r\nFROM (\r\nSELECT\r\n\ta.userlevel,\r\n\ta.user_daqu,\r\n\ta.user_pianqu,\r\n\ta.user_chanpinxian,\r\n\ta.id,\r\n\tb.sequence AS mb_typeseq,\r\n\tCASE\r\n\t\tWHEN '{weidu}'=1 THEN '客户经理'\r\n\t\tWHEN '{weidu}'=2 THEN '片区'\r\n\t\tWHEN '{weidu}'=3 THEN '大区'\r\n\t\tWHEN '{weidu}'=4 THEN '公司整体'\r\n\t\tWHEN '{weidu}'=5 THEN '解决方案经理'\r\n\t\tWHEN '{weidu}'=7 THEN '产品线'\r\n\t\tWHEN '{weidu}'=8 THEN '青岛金东'\r\n\t\tELSE ''\r\n\tEND AS weidu_descp,\r\n\tCASE\r\n\t\tWHEN '{weidu}'=1 THEN a.last_name\r\n\t\tWHEN '{weidu}'=2 THEN a.user_pianqu\r\n\t\tWHEN '{weidu}'=3 THEN a.user_daqu\r\n\t\tWHEN '{weidu}'=4 THEN '公司整体'\r\n\t\tWHEN '{weidu}'=5 THEN a.last_name \r\n\t\tWHEN '{weidu}'=7 THEN \r\n\t\t\t(\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN LOCATE(14,a.groupid)>0 THEN '体验馆-山东金东'\r\n\t\t\t\t\tWHEN LOCATE(15,a.groupid)>0 THEN '应急安全-山东金东'\r\n\t\t\t\t\tWHEN LOCATE(13,a.groupid)>0 THEN '文旅文博-山东金东'\r\n\t\t\t\t\tWHEN a.last_name IN ('李树彬','宋志鹏') AND ('{ziweidu}'='' OR '{ziweidu}' LIKE '%体验馆-青岛金东%') THEN '体验馆-青岛金东'\r\n\t\t\t\t\tWHEN a.last_name IN ('李树彬','宋志鹏') AND ('{ziweidu}'='' OR '{ziweidu}' LIKE '%应急安全-青岛金东%') THEN '应急安全-青岛金东'\r\n\t\t\t\t\tWHEN a.last_name IN ('李树彬','宋志鹏') AND ('{ziweidu}'='' OR '{ziweidu}' LIKE '%文旅文博-青岛金东%') THEN '文旅文博-青岛金东'\r\n\t\t\t\t\tELSE ''\r\n\t\t\t\tEND)\r\n\t\tWHEN '{weidu}'=8 THEN a.last_name \r\n\t\tELSE ''\r\n\tEND AS weidu_type,\r\n\tb.listvalue AS mb_type,\r\n\tCASE\r\n\t\tWHEN b.listvalue IN ('合同额','回款额','收入','立项') THEN '万元'\r\n\t\tWHEN b.listvalue IN ('客户拜访量') THEN '次'\r\n\t\tELSE '个'\r\n\tEND AS mb_type_show,\r\n\tCASE\r\n\t\tWHEN b.listvalue IN ('合同额','回款额','收入','立项') THEN IFNULL(m.mb_amount,0)*0.0001\r\n\t\tELSE IFNULL(m.mb_amount,0)\r\n\tEND AS mb_amount,\r\n\tCASE\r\n\t\tWHEN b.listvalue IN ('合同额','回款额','收入','立项') THEN IFNULL(m.mb_amount2,0)*0.0001\r\n\t\tELSE IFNULL(m.mb_amount2,0)\r\n\tEND AS mb_amount2,\r\n\tCASE\r\n\t\tWHEN b.listvalue IN ('合同额','回款额','收入','立项') THEN IFNULL(m.mb_amount_last,0)*0.0001\r\n\t\tELSE IFNULL(m.mb_amount_last,0)\r\n\tEND AS mb_amount_last,\r\n\tCASE\r\n\t\tWHEN b.listvalue IN ('合同额','回款额','收入','立项') THEN IFNULL(m.mb_amount_last2,0)*0.0001\r\n\t\tELSE IFNULL(m.mb_amount_last2,0)\r\n\tEND AS mb_amount_last2,\r\n\tCASE\r\n\t\tWHEN b.listvalue IN ('合同额','回款额','收入','立项') THEN IFNULL(w.wc_total,0)*0.0001\r\n\t\tELSE IFNULL(w.wc_total,0)\r\n\tEND AS wc_total,\r\n\tCASE\r\n\t\tWHEN b.listvalue IN ('合同额','回款额','收入','立项') THEN IFNULL(w.wc_total_last,0)*0.0001\r\n\t\tELSE IFNULL(w.wc_total_last,0)\r\n\tEND AS wc_total_last\r\nFROM ld_users a\r\nINNER JOIN (\r\n\tSELECT DISTINCT\r\n\t\tuserid \r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\tld_users.id AS userid \r\n\t\tFROM ld_users\r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='CustomForm22' and scopeauthority=1 AND userid='[uuid]')\r\n\t\tUNION\r\n\t\tSELECT \r\n\t\t\tviewid AS userid \r\n\t\tFROM ld_scoperhigher\r\n\t\tWHERE userid='[uuid]' AND modulename ='CustomForm22' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename ='CustomForm22')\t\t\t\r\n\t\tUNION\r\n\t\tSELECT DISTINCT \r\n\t\t\tld_users2group.userid AS userid \r\n\t\tFROM ld_scoperhigher \r\n\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\tAND ld_scoperhigher.modulename ='CustomForm22'\r\n\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='CustomForm22' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\tUNION \r\n\t\tSELECT \r\n\t\t\tid AS userid \r\n\t\tFROM ld_users  \r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\tUNION\r\n\t\tSELECT '[uuid]') AS vw_users\r\n) AS tmp_users ON tmp_users.userid=a.id\r\nCROSS JOIN (SELECT listvalue,sequence FROM ld_picklist_values WHERE listid=242 AND listvalue IN ('合同额','回款额','收入','立项','商机','线索')) b\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\tlin_users_id,\r\n\t\tmb_type,\r\n\t\tSUM(mb_amount) AS mb_amount,\r\n\t\tSUM(mb_amount_last) AS mb_amount_last,\r\n\t\tSUM(mb_amount2) AS mb_amount2,\r\n\t\tSUM(mb_amount_last2) AS mb_amount_last2\r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\tc.lin_users_id,\r\n\t\t\tb.cf_5276 AS mb_nian,\r\n\t\t\t1 AS mb_yue,\r\n\t\t\t1 AS mb_ji,\r\n\t\t\tb.cf_5277 AS mb_type,\r\n\t\t\tCASE WHEN b.cf_5276='{nian}' THEN d.sf284 ELSE 0 END AS mb_amount,\r\n\t\t\tCASE WHEN b.cf_5276='{nian}'-1 THEN d.sf284 ELSE 0 END AS mb_amount_last,\r\n\t\t\tCASE WHEN b.cf_5276='{nian}' AND u.userlevel NOT IN ('区域负责人') THEN d.sf284 ELSE 0 END AS mb_amount2,\r\n\t\t\tCASE WHEN b.cf_5276='{nian}'-1 AND u.userlevel NOT IN ('区域负责人') THEN d.sf284 ELSE 0 END AS mb_amount_last2\r\n\t\tFROM ld_customform22 a\r\n\t\tLEFT JOIN ld_customform22scf b ON b.customform22id=a.customform22id\r\n\t\tLEFT JOIN ld_customform22detail c ON c.id=a.customform22id\r\n\t\tLEFT JOIN ld_customform22detailscf d ON d.lineitem_id=c.lineitem_id\r\n\t\tLEFT JOIN ld_users u ON u.id=c.lin_users_id\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\tAND c.lin_users_id>0\r\n\t\t\tAND b.cf_5276 IN ('{nian}','{nian}'-1)\r\n\t\tUNION\r\n\t\tSELECT\r\n\t\t\tc.lin_users_id,\r\n\t\t\tb.cf_5276 AS mb_nian,\r\n\t\t\t2 AS mb_yue,\r\n\t\t\t1 AS mb_ji,\r\n\t\t\tb.cf_5277 AS mb_type,\r\n\t\t\tCASE WHEN b.cf_5276='{nian}' THEN d.sf285 ELSE 0 END AS mb_amount,\r\n\t\t\tCASE WHEN b.cf_5276='{nian}'-1 THEN d.sf285 ELSE 0 END AS mb_amount_last,\r\n\t\t\tCASE WHEN b.cf_5276='{nian}' AND u.userlevel NOT IN ('区域负责人') THEN d.sf285 ELSE 0 END AS mb_amount2,\r\n\t\t\tCASE WHEN b.cf_5276='{nian}'-1 AND u.userlevel NOT IN ('区域负责人') THEN d.sf285 ELSE 0 END AS mb_amount_last2\r\n\t\tFROM ld_customform22 a\r\n\t\tLEFT JOIN ld_customform22scf b ON b.customform22id=a.customform22id\r\n\t\tLEFT JOIN ld_customform22detail c ON c.id=a.customform22id\r\n\t\tLEFT JOIN ld_customform22detailscf d ON d.lineitem_id=c.lineitem_id\r\n\t\tLEFT JOIN ld_users u ON u.id=c.lin_users_id\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\tAND c.lin_users_id>0\r\n\t\t\tAND b.cf_5276 IN ('{nian}','{nian}'-1)\r\n\t\tUNION\r\n\t\tSELECT\r\n\t\t\tc.lin_users_id,\r\n\t\t\tb.cf_5276 AS mb_nian,\r\n\t\t\t3 AS mb_yue,\r\n\t\t\t1 AS mb_ji,\r\n\t\t\tb.cf_5277 AS mb_type,\r\n\t\t\tCASE WHEN b.cf_5276='{nian}' THEN d.sf286 ELSE 0 END AS mb_amount,\r\n\t\t\tCASE WHEN b.cf_5276='{nian}'-1 THEN d.sf286 ELSE 0 END AS mb_amount_last,\r\n\t\t\tCASE WHEN b.cf_5276='{nian}' AND u.userlevel NOT IN ('区域负责人') THEN d.sf286 ELSE 0 END AS mb_amount2,\r\n\t\t\tCASE WHEN b.cf_5276='{nian}'-1 AND u.userlevel NOT IN ('区域负责人') THEN d.sf286 ELSE 0 END AS mb_amount_last2\r\n\t\tFROM ld_customform22 a\r\n\t\tLEFT JOIN ld_customform22scf b ON b.customform22id=a.customform22id\r\n\t\tLEFT JOIN ld_customform22detail c ON c.id=a.customform22id\r\n\t\tLEFT JOIN ld_customform22detailscf d ON d.lineitem_id=c.lineitem_id\r\n\t\tLEFT JOIN ld_users u ON u.id=c.lin_users_id\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\tAND c.lin_users_id>0\r\n\t\t\tAND b.cf_5276 IN ('{nian}','{nian}'-1)\r\n\t\tUNION\r\n\t\tSELECT\r\n\t\t\tc.lin_users_id,\r\n\t\t\tb.cf_5276 AS mb_nian,\r\n\t\t\t4 AS mb_yue,\r\n\t\t\t2 AS mb_ji,\r\n\t\t\tb.cf_5277 AS mb_type,\r\n\t\t\tCASE WHEN b.cf_5276='{nian}' THEN d.sf287 ELSE 0 END AS mb_amount,\r\n\t\t\tCASE WHEN b.cf_5276='{nian}'-1 THEN d.sf287 ELSE 0 END AS mb_amount_last,\r\n\t\t\tCASE WHEN b.cf_5276='{nian}' AND u.userlevel NOT IN ('区域负责人') THEN d.sf287 ELSE 0 END AS mb_amount2,\r\n\t\t\tCASE WHEN b.cf_5276='{nian}'-1 AND u.userlevel NOT IN ('区域负责人') THEN d.sf287 ELSE 0 END AS mb_amount_last2\r\n\t\tFROM ld_customform22 a\r\n\t\tLEFT JOIN ld_customform22scf b ON b.customform22id=a.customform22id\r\n\t\tLEFT JOIN ld_customform22detail c ON c.id=a.customform22id\r\n\t\tLEFT JOIN ld_customform22detailscf d ON d.lineitem_id=c.lineitem_id\r\n\t\tLEFT JOIN ld_users u ON u.id=c.lin_users_id\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\tAND c.lin_users_id>0\r\n\t\t\tAND b.cf_5276 IN ('{nian}','{nian}'-1)\r\n\t\tUNION\r\n\t\tSELECT\r\n\t\t\tc.lin_users_id,\r\n\t\t\tb.cf_5276 AS mb_nian,\r\n\t\t\t5 AS mb_yue,\r\n\t\t\t2 AS mb_ji,\r\n\t\t\tb.cf_5277 AS mb_type,\r\n\t\t\tCASE WHEN b.cf_5276='{nian}' THEN d.sf288 ELSE 0 END AS mb_amount,\r\n\t\t\tCASE WHEN b.cf_5276='{nian}'-1 THEN d.sf288 ELSE 0 END AS mb_amount_last,\r\n\t\t\tCASE WHEN b.cf_5276='{nian}' AND u.userlevel NOT IN ('区域负责人') THEN d.sf288 ELSE 0 END AS mb_amount2,\r\n\t\t\tCASE WHEN b.cf_5276='{nian}'-1 AND u.userlevel NOT IN ('区域负责人') THEN d.sf288 ELSE 0 END AS mb_amount_last2\r\n\t\tFROM ld_customform22 a\r\n\t\tLEFT JOIN ld_customform22scf b ON b.customform22id=a.customform22id\r\n\t\tLEFT JOIN ld_customform22detail c ON c.id=a.customform22id\r\n\t\tLEFT JOIN ld_customform22detailscf d ON d.lineitem_