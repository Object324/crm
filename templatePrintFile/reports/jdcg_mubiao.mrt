            "Type": "System.String"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\tlist_key,\r\n\tlist_key2,\r\n\tlist_value,\r\n\tlist_value2\r\nFROM (\r\n\tSELECT\r\n\t\t1 AS list_key,\r\n\t\t'客户经理/市场专员' AS list_value,\r\n\t\ta.id AS list_key2,\r\n\t\ta.last_name AS list_value2\r\n\tFROM ld_users a\r\n\tWHERE a.deleted=0\r\n\t\tAND a.userlevel IN ('客户经理','区域负责人')\r\n\tUNION\r\n\tSELECT\r\n\t\t2 AS list_key,\r\n\t\t'片区' AS list_value,\r\n\t\ta.user_pianqu AS list_key2,\r\n\t\ta.user_pianqu AS list_value2\r\n\tFROM ld_users a\r\n\tWHERE a.deleted=0\r\n\t\tAND a.user_pianqu IN ('山东区','北京区','河南区','西南区','青岛金东')\r\n\tGROUP BY a.user_pianqu\r\n\tUNION\r\n\tSELECT\r\n\t\t3 AS list_key,\r\n\t\t'大区' AS list_value,\r\n\t\ta.user_daqu AS list_key2,\r\n\t\ta.user_daqu AS list_value2\r\n\tFROM ld_users a\r\n\tWHERE a.deleted=0\r\n\t\tAND a.user_daqu IN ('东部大区','南部大区','西部大区','北部大区','青岛金东')\r\n\tGROUP BY a.user_daqu\r\n\tUNION\r\n\tSELECT \r\n\t\t4 AS list_key,\r\n\t\t'公司整体' AS list_value,\r\n\t\t'公司整体' AS list_key2,\r\n\t\t'公司整体' AS list_value2\r\n\tUNION\r\n\tSELECT\r\n\t\t5 AS list_key,\r\n\t\t'解决方案经理' AS list_value,\r\n\t\ta.id AS list_key2,\r\n\t\ta.last_name AS list_value2\r\n\tFROM ld_users a\r\n\tWHERE a.deleted=0\r\n\t\tAND a.userlevel IN ('解决方案经理','产品线负责人')\r\n\tUNION\r\n\tSELECT 7 AS list_key,'产品线' AS list_value,1 AS list_key2,'体验馆-山东金东' AS list_value2\r\n\tUNION \r\n\tSELECT 7 AS list_key,'产品线' AS list_value,2 AS list_key2,'应急安全-山东金东' AS list_value2\r\n\tUNION \r\n\tSELECT 7 AS list_key,'产品线' AS list_value,3 AS list_key2,'文旅文博-山东金东' AS list_value2\r\n\tUNION \r\n\tSELECT 7 AS list_key,'产品线' AS list_value,4 AS list_key2,'体验馆-青岛金东' AS list_value2\r\n\tUNION \r\n\tSELECT 7 AS list_key,'产品线' AS list_value,5 AS list_key2,'应急安全-青岛金东' AS list_value2\r\n\tUNION \r\n\tSELECT 7 AS list_key,'产品线' AS list_value,6 AS list_key2,'文旅文博-青岛金东' AS list_value2\r\n\tUNION\r\n\tSELECT \r\n\t\t8 AS list_key,\r\n\t\t'青岛金东' AS list_value,\r\n\t\ta.id AS list_key2,\r\n\t\ta.last_name AS list_value2\r\n\tFROM ld_users a\r\n\tWHERE a.last_name IN ('李树彬','宋志鹏')\r\n) a\r\nORDER BY FIELD(a.list_key,4,2,3,1,5,6,7,8),\r\n\t(CASE \r\n\t\tWHEN list_key IN (1,5,8) THEN CONVERT(a.list_value2 USING GBK) \r\n\t\tWHEN list_key=2 THEN FIELD(a.list_value2,'山东区','北京区','河南区','西南区','青岛金东')\r\n\t\tWHEN list_key=3 THEN FIELD(a.list_value2,'东部大区','南部大区','西部大区','北部大区','青岛金东')\r\n\t\tWHEN list_key=6 THEN FIELD(a.list_value2,'文旅文博','体验馆','应急安全','运营类','多媒体解决方案','数字内容','其他')\r\n\t\tWHEN list_key=7 THEN a.list_key2\r\n\tEND)"
      },
