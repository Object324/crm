t\t11 AS yue,\r\n\t\t\td.sf383 AS amount\r\n\t\tFROM ld_customform21 a\r\n\t\tLEFT JOIN ld_customform21scf b ON b.customform21id=a.customform21id\r\n\t\tLEFT JOIN ld_customform21detail c ON c.id=a.customform21id\r\n\t\tLEFT JOIN ld_customform21detailscf d ON d.lineitem_id=c.lineitem_id\r\n\t\tLEFT JOIN ld_users u ON u.id=a.smownerid\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\tAND a.approvestatus='已批准'\r\n\t\t\tAND b.cf_5857 IN ('{nian}','{nian}'-1)\r\n\t\tUNION\r\n\t\tSELECT\r\n\t\t\t'收入' AS wc_type,\r\n\t\t\ta.smownerid,\r\n\t\t\tb.cf_5857 AS nian,\r\n\t\t\t12 AS yue,\r\n\t\t\td.sf384 AS amount\r\n\t\tFROM ld_customform21 a\r\n\t\tLEFT JOIN ld_customform21scf b ON b.customform21id=a.customform21id\r\n\t\tLEFT JOIN ld_customform21detail c ON c.id=a.customform21id\r\n\t\tLEFT JOIN ld_customform21detailscf d ON d.lineitem_id=c.lineitem_id\r\n\t\tLEFT JOIN ld_users u ON u.id=a.smownerid\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\tAND a.approvestatus='已批准'\r\n\t\t\tAND b.cf_5857 IN ('{nian}','{nian}'-1)\r\n\t) a\r\n\tWHERE 1=1\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(yue,'{date_value}')\r\n\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(yue,'{date_value}')\r\n\t\t\tEND)\r\n\tGROUP BY smownerid\r\n) w ON w.smownerid=a.id AND w.wc_type=b.listvalue\r\nWHERE 1=1\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{weidu}' IN (1,2,3,4) THEN a.userlevel IN ('客户经理','区域负责人')\r\n\t\t\tWHEN '{weidu}' IN (5) THEN a.userlevel IN ('解决方案经理','产品线负责人')\r\n\t\t\tWHEN '{weidu}' IN (8) THEN a.last_name IN ('李树彬','宋志鹏')\r\n\t\t\tELSE 1=1\r\n\t\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{weidu}'=1 AND TRIM('{ziweidu}')='' THEN 1=1\r\n\t\t\tWHEN '{weidu}'=1 AND TRIM('{ziweidu}')<>'' THEN FIND_IN_SET(a.id,'{ziweidu}')\r\n\t\t\t\r\n\t\t\tWHEN '{weidu}'=2 AND TRIM('{ziweidu}')='' THEN a.user_pianqu IN ('山东区','北京区','河南区','西南区','青岛金东')\r\n\t\t\tWHEN '{weidu}'=2 THEN FIND_IN_SET(a.user_pianqu,'{ziweidu}')\r\n\r\n\t\t\tWHEN '{weidu}'=3 AND TRIM('{ziweidu}')='' THEN a.user_daqu IN ('东部大区','南部大区','西部大区','北部大区','青岛金东')\r\n\t\t\tWHEN '{weidu}'=3 THEN FIND_IN_SET(a.user_daqu,'{ziweidu}')\r\n\t\t\tELSE 1=1\r\n\t\tEND) \r\n) a\r\nWHERE 1=1\r\n\tAND weidu_type<>''\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN TRIM('{mub_type}')='' THEN mb_type IN ('合同额','回款额')\r\n\t\t\tELSE FIND_IN_SET(mb_type,'{mub_type}')\r\n\t\tEND)\r\nGROUP BY weidu_type,mb_type"
      },
