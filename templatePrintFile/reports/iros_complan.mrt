        },
        "NameInSource": "crm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\ta.smownerid,\r\n\tu.last_name,\r\n\tb.seq,\r\n\tCASE WHEN d.seq>0 THEN 1 ELSE 0 END AS dingdan_cnt,\r\n\tCASE WHEN c.seq>0 THEN 1 ELSE 0 END AS genjin_cnt,\r\n\tCONCAT('签单『',d.accountname,'』') AS dingdan_info,\r\n\tCONCAT('跟进『',c.accountname,'』') AS genjin_info,\r\n\tIFNULL(e.cnt_jihua,0) AS dingdan_injihua,\r\n\tIFNULL(e.cnt_total,0)-IFNULL(e.cnt_jihua,0) AS dingdan_outjihua,\r\n\tCASE\r\n\t\tWHEN b.seq=1 THEN IFNULL(e.cnt_total,0)\r\n\t\tELSE 0\r\n\tEND AS dingdan_cnt_total,\r\n\tIFNULL(f.cnt_jihua,0) AS genjin_injihua,\r\n\tIFNULL(f.cnt_total,0)-IFNULL(f.cnt_jihua,0) AS genjin_outjihua,\r\n\tCASE\r\n\t\tWHEN b.seq=1 THEN IFNULL(f.cnt_total,0)\r\n\t\tELSE 0\r\n\tEND AS genjin_cnt_total,\r\n\te.dingdankehu_injihua AS tips1,\r\n\te.dingdankehu_outjihua AS tips2,\r\n\tf.genjinkehu_injihua AS tips3,\r\n\tf.genjinkehu_outjihua AS tips4\r\nFROM (\r\n\tSELECT\r\n\t\ta.smownerid,\r\n\t\tMAX(IFNULL(b.cnt,1)) AS max_cnt\r\n\tFROM (\r\n\t\tSELECT DISTINCT\r\n\t\t\ta.smownerid\r\n\t\tFROM ld_customform25 a\r\n\t\tLEFT JOIN ld_customform25scf b ON b.customform25id=a.customform25id\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\tAND b.cf_4924 BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\t\tUNION \r\n\t\tSELECT DISTINCT\r\n\t\t\ta.smownerid\r\n\t\tFROM ld_salesorder a\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\tAND a.signed_data BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{just_jihua}'='true' THEN 1=0\r\n\t\t\t\t\tELSE 1=1\r\n\t\t\t\tEND)\r\n\t\tUNION \r\n\t\tSELECT DISTINCT\r\n\t\t\ta.smownerid\r\n\t\tFROM ld_contactrecords a\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\tAND a.contactdate BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d 00:00:00') AND DATE_FORMAT('{end_date}','%Y-%m-%d 23:59:59')\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{just_jihua}'='true' THEN 1=0\r\n\t\t\t\t\tELSE 1=1\r\n\t\t\t\tEND)\r\n\t) a\r\n\tLEFT JOIN (\r\n\t\tSELECT \r\n\t\t\ta.smownerid,\r\n\t\t\tCOUNT(1) AS cnt\r\n\t\tFROM ld_customform25 a\r\n\t\tLEFT JOIN ld_customform25scf b ON b.customform25id=a.customform25id\r\n\t\tLEFT JOIN ld_customform25detail c ON c.id=a.customform25id\r\n\t\tLEFT JOIN ld_customform25detailscf d ON d.lineitem_id=c.lineitem_id\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\tAND b.cf_4924 BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\t\t\tAND d.sf298 IN ('跟进','签单')\r\n\t\t\tAND c.line_accounts_id>0\r\n\t\tGROUP BY a.smownerid,d.sf298\r\n\t) b ON b.smownerid=a.smownerid\r\n\tGROUP BY a.smownerid\r\n) a\r\nCROSS JOIN sequence b ON b.seq>0 AND b.seq<=a.max_cnt\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\ta.smownerid,\r\n\t\ta.accountname,\r\n\t\ta.line_accounts_id AS accountid,\r\n\t\t(@i:=@i+1) AS seq\r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\ta.smownerid,\r\n\t\t\tc.line_accounts_id,\r\n\t\t\tk.accountname\r\n\t\tFROM ld_customform25 a\r\n\t\tLEFT JOIN ld_customform25scf b ON b.customform25id=a.customform25id\r\n\t\tLEFT JOIN ld_customform25detail c ON c.id=a.customform25id\r\n\t\tLEFT JOIN ld_customform25detailscf d ON d.lineitem_id=c.lineitem_id\r\n\t\tLEFT JOIN ld_account k ON k.accountid=c.line_accounts_id\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\tAND b.cf_4924 BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\t\t\tAND d.sf298='跟进'\r\n\t\t\tAND c.line_accounts_id>0\r\n\t\tGROUP BY a.smownerid,c.line_accounts_id\r\n\t) a,(SELECT @i:=0) b \r\n) c ON c.smownerid=a.smownerid AND c.seq=b.seq\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\ta.smownerid,\r\n\t\ta.line_accounts_id AS accountid,\r\n\t\ta.accountname,\r\n\t\t(@j:=@j+1) AS seq\r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\ta.smownerid,\r\n\t\t\tc.line_accounts_id,\r\n\t\t\tk.accountname\r\n\t\tFROM ld_customform25 a\r\n\t\tLEFT JOIN ld_customform25scf b ON b.customform25id=a.customform25id\r\n\t\tLEFT JOIN ld_customform25detail c ON c.id=a.customform25id\r\n\t\tLEFT JOIN ld_customform25detailscf d ON d.lineitem_id=c.lineitem_id\r\n\t\tLEFT JOIN ld_account k ON k.accountid=c.line_accounts_id\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\tAND b.cf_4924 BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\t\t\tAND d.sf298='签单'\r\n\t\t\tAND c.line_accounts_id>0\r\n\t\tGROUP BY a.smownerid,c.line_accounts_id\r\n\t) a,(SELECT @j:=0) b \r\n) d ON d.smownerid=a.smownerid AND d.seq=b.seq\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\ta.smownerid,\r\n\t\tSUM(cnt_total) AS cnt_total,\r\n\t\tSUM(cnt_jihua) AS cnt_jihua,\r\n\t\tGROUP_CONCAT(CONCAT('计划内签单『',dingdankehu_injihua,'』') SEPARATOR '\\r\\n') AS dingdankehu_injihua,\r\n\t\tGROUP_CONCAT(CONCAT('计划外签单『',dingdankehu_injihua,'』') SEPARATOR '\\r\\n') AS dingdankehu_outjihua\r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\ta.smownerid,\r\n\t\t\t1 AS cnt_total,\r\n\t\t\tCASE WHEN b.line_accounts_id>0 THEN 1 ELSE 0 END AS cnt_jihua,\r\n\t\t\tCASE WHEN b.line_accounts_id>0 THEN b.accountname ELSE NULL END AS dingdankehu_injihua,\r\n\t\t\tCASE WHEN IFNULL(b.line_accounts_id,0)=0 THEN c.accountname ELSE NULL END AS dingdankehu_outjihua\r\n\t\tFROM ld_salesorder a\r\n\t\tLEFT JOIN (\r\n\t\t\t\tSELECT \r\n\t\t\t\t\ta.smownerid,\r\n\t\t\t\t\tc.line_accounts_id,\r\n\t\t\t\t\te.accountname\r\n\t\t\t\tFROM ld_customform25 a\r\n\t\t\t\tLEFT JOIN ld_customform25scf b ON b.customform25id=a.customform25id\r\n\t\t\t\tLEFT JOIN ld_customform25detail c ON c.id=a.customform25id\r\n\t\t\t\tLEFT JOIN ld_customform25detailscf d ON d.lineitem_id=c.lineitem_id\r\n\t\t\t\tLEFT JOIN ld_account e ON e.accountid=c.line_accounts_id\r\n\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\t\tAND b.cf_4924 BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\t\t\t\t\tAND d.sf298='签单'\r\n\t\t\t\t\tAND c.line_accounts_id>0\r\n\t\t\t\tGROUP BY a.smownerid,c.line_accounts_id\r\n\t\t) b ON b.smownerid=a.smownerid AND b.line_accounts_id=a.accountid\r\n\t\tLEFT JOIN ld_account c ON c.accountid=a.accountid\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\tAND a.accountid>0\r\n\t\t\tAND a.signed_data BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\t\tGROUP BY a.smownerid,a.accountid\r\n\t) a\r\n\tGROUP BY a.smownerid\r\n) e ON e.smownerid=a.smownerid\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\ta.smownerid,\r\n\t\tSUM(cnt_total) AS cnt_total,\r\n\t\tSUM(cnt_jihua) AS cnt_jihua,\r\n\t\tGROUP_CONCAT(CONCAT('计划内跟进『',genjinkehu_injihua,'』') SEPARATOR '\\r\\n') AS genjinkehu_injihua,\r\n\t\tGROUP_CONCAT(CONCAT('计划外跟进『',genjinkehu_outjihua,'』') SEPARATOR '\\r\\n') AS genjinkehu_outjihua\r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\ta.smownerid,\r\n\t\t\t1 AS cnt_total,\r\n\t\t\tCASE WHEN b.line_accounts_id>0 THEN 1 ELSE 0 END AS cnt_jihua,\r\n\t\t\tCASE WHEN b.line_accounts_id>0 THEN b.accountname ELSE NULL END AS genjinkehu_injihua,\r\n\t\t\tCASE WHEN IFNULL(b.line_accounts_id,0)=0 THEN c.accountname ELSE NULL END AS genjinkehu_outjihua\r\n\t\tFROM ld_contactrecords a\r\n\t\tLEFT JOIN (\r\n\t\t\t\tSELECT \r\n\t\t\t\t\ta.smownerid,\r\n\t\t\t\t\tc.line_accounts_id,\r\n\t\t\t\t\te.accountname\r\n\t\t\t\tFROM ld_customform25 a\r\n\t\t\t\tLEFT JOIN ld_customform25scf b ON b.customform25id=a.customform25id\r\n\t\t\t\tLEFT JOIN ld_customform25detail c ON c.id=a.customform25id\r\n\t\t\t\tLEFT JOIN ld_customform25detailscf d ON d.lineitem_id=c.lineitem_id\r\n\t\t\t\tLEFT JOIN ld_account e ON e.accountid=c.line_accounts_id\r\n\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\t\tAND b.cf_4924 BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\t\t\t\t\tAND d.sf298='签单'\r\n\t\t\t\t\tAND c.line_accounts_id>0\r\n\t\t\t\tGROUP BY a.smownerid,c.line_accounts_id\r\n\t\t) b ON b.smownerid=a.smownerid AND b.line_accounts_id=a.accountid\r\n\t\tLEFT JOIN ld_account c ON c.accountid=a.accountid\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\tAND a.accountid>0\r\n\t\t\tAND a.contactdate BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d 00:00:00') AND DATE_FORMAT('{end_date}','%Y-%m-%d 23:59:59')\r\n\t\tGROUP BY a.smownerid,a.accountid\r\n\t) a\r\n\tGROUP BY a.smownerid\r\n) f ON f.smownerid=a.smownerid\r\nLEFT JOIN ld_users u ON u.id=a.smownerid\r\nINNER JOIN (\r\n\tSELECT DISTINCT\r\n\t\tuserid \r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\tld_users.id AS userid \r\n\t\tFROM ld_users\r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='CustomForm25' and scopeauthority=1 AND userid='[uuid]')\r\n\t\tUNION\r\n\t\tSELECT \r\n\t\t\tviewid AS userid \r\n\t\tFROM ld_scoperhigher\r\n\t\tWHERE userid='[uuid]' AND modulename ='CustomForm25' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename ='CustomForm25')\t\t\t\r\n\t\tUNION\r\n\t\tSELECT DISTINCT \r\n\t\t\tld_users2group.userid AS userid \r\n\t\tFROM ld_scoperhigher \r\n\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\tAND ld_scoperhigher.modulename ='CustomForm25'\r\n\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='CustomForm25' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\tUNION \r\n\t\tSELECT \r\n\t\t\tid AS userid \r\n\t\tFROM ld_users  \r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\tUNION\r\n\t\tSELECT '[uuid]') AS vw_users\r\n) AS tmp_users ON tmp_users.userid=a.smownerid\r\nWHERE 1=1\r\n\tAND(\r\n\t\tCASE\r\n\t\t\tWHEN FIND_IN_SET(1,'{data_range}') OR '{data_range}'='' THEN 1=1\r\n\t\t\tWHEN FIND_IN_SET(2,'{data_range}') THEN a.smownerid='[uuid]'\r\n\t\t\tELSE \r\n\t\t\t\t\t\ta.smownerid IN (\r\n\t\t\t\t\t\t\t\tSELECT\r\n\t\t\t\t\t\t\t\t\ta.userid\r\n\t\t\t\t\t\t\t\tFROM ld_users2group a\r\n\t\t\t\t\t\t\t\tINNER JOIN (\r\n\t\t\t\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\t\t\t\tsubstring_index(substring_index(a.splitsting,',',b.seq+1),',',-1)-200000 AS groupid\r\n\t\t\t\t\t\t\t\t\tFROM (SELECT '{data_range}' AS splitsting) a \r\n\t\t\t\t\t\t\t\t\tLEFT JOIN sequence b ON b.seq < (length(a.splitsting) - length(replace(a.splitsting,',',''))+1) \r\n\t\t\t\t\t\t\t\t\tWHERE substring_index(substring_index(a.splitsting,',',b.seq+1),',',-1) BETWEEN 200000 AND 300000\r\n\t\t\t\t\t\t\t\t) b ON b.groupid=a.groupid\r\n\t\t\t\t\t\t\t\tGROUP BY a.userid\r\n\t\t\t\t\t\t\t\tUNION \r\n\t\t\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\t\t\tsubstring_index(substring_index(a.splitsting,',',b.seq+1),',',-1)-300000 AS groupid\r\n\t\t\t\t\t\t\t\tFROM (SELECT '{data_range}' AS splitsting) a \r\n\t\t\t\t\t\t\t\tLEFT JOIN sequence b ON b.seq < (length(a.splitsting) - length(replace(a.splitsting,',',''))+1) \r\n\t\t\t\t\t\t\t\tWHERE substring_index(substring_index(a.splitsting,',',b.seq+1),',',-1)>300000\r\n\t\t\t\t\t\t)\r\n\t\tEND)\r\nORDER BY CONVERT(u.last_name USING GBK),b.seq"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "list_users",
        "Alias": "list_users",
        "Columns": {
          "0": {
            "Name": "list_order",
            "Index": -1,
            "NameInSource": "list_order",
            "Alias": "list_order",
            "Type": "System.String"
          },
          "1": {
            "Name": "listid",
            "Index": -1,
            "NameInSource": "listid",
            "Alias": "listid",
            "Type": "System.Int32"
          },
          "2": {
            "Name": "listtype",
            "Index": -1,
            "NameInSource": "listtype",
            "Alias": "listtype",
            "Type": "System.Int32"
          },
          "3": {
            "Name": "listvalue",
            "Index": -1,
            "NameInSource": "listvalue",
            "Alias": "listvalue",
            "Type": "System.String"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT 1 AS listid,'全部' AS listvalue,0 AS list_order,1 AS listtype\r\nUNION\r\nSELECT 2 AS listid, '我负责的' AS listvalue,0 AS list_order,2 AS listtype\r\nUNION (\r\n\tSELECT\r\n\t\ta.groupid+200000 AS listid,\r\n\t\tCONCAT('部门::',IFNULL(a.groupname,'')) AS listvalue,\r\n\t\tGROUP_CONCAT(IFNULL(a.splitsting,'') ORDER BY a.splitsting SEPARATOR '::') AS listorder,\r\n\t\t1 AS listtype\r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\ta.groupid, \r\n\t\t\ta.groupname, \r\n\t\t\tLPAD(substring_index(substring_index(a.splitsting,',',b.seq+1),',',-1),8,'0') AS splitsting\r\n\t\tFROM (\r\n\t\t\tSELECT \r\n\t\t\t\ta.groupid,\r\n\t\t\t\ta.groupname, \r\n\t\t\t\tREPLACE(a.parentgroup,'::',',') AS splitsting \r\n\t\t\tFROM ld_groups a\r\n\t\t\tLEFT JOIN ld_users2group b ON b.groupid=a.groupid\r\n\t\t\tGROUP BY a.groupid\r\n\t\t) a \r\n\t\tLEFT JOIN sequence b ON b.seq < (length(a.splitsting) - length(replace(a.splitsting,',',''))+1)\r\n\t) a\r\n\tGROUP BY a.groupid\r\n)\r\nUNION (\r\n\tSELECT\r\n\t\ta.id+300000 AS listid,\r\n\t\tCONCAT('用户::',IFNULL(a.last_name,''),'(',c.listvalue,')') AS listvalue,\r\n\t\tc.listorder,\r\n\t\t2 AS listtype\r\n\tFROM ld_users a\r\n\tLEFT JOIN ld_users2group b ON b.userid=a.id  \r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\ta.groupid,\r\n\t\t\ta.groupid+200000 AS listid,\r\n\t\t\tCONCAT('部门::',IFNULL(a.groupname,'')) AS listvalue,\r\n\t\t\tGROUP_CONCAT(IFNULL(a.splitsting,'') ORDER BY a.splitsting SEPARATOR '::') AS listorder\r\n\t\tFROM (\r\n\t\t\tSELECT \r\n\t\t\t\ta.groupid, \r\n\t\t\t\ta.groupname, \r\n\t\t\t\tLPAD(substring_index(substring_index(a.splitsting,',',b.seq+1),',',-1),8,'0') AS splitsting\r\n\t\t\tFROM (\r\n\t\t\t\tSELECT \r\n\t\t\t\t\ta.groupid,\r\n\t\t\t\t\ta.groupname, \r\n\t\t\t\t\tREPLACE(a.parentgroup,'::',',') AS splitsting \r\n\t\t\t\tFROM ld_groups a\r\n\t\t\t\tLEFT JOIN ld_users2group b ON b.groupid=a.groupid\r\n\t\t\t\tGROUP BY a.groupid\r\n\t\t\t) a \r\n\t\t\tLEFT JOIN sequence b ON b.seq < (length(a.splitsting) - length(replace(a.splitsting,',',''))+1)\r\n\t\t) a\r\n\t\tGROUP BY a.groupid\r\n\t) c ON c.groupid=b.groupid\r\n\tINNER JOIN (\r\n\t\tSELECT DISTINCT\r\n\t\t\tuserid \r\n\t\tFROM (\r\n\t\t\tSELECT \r\n\t\t\t\tld_users.id AS userid \r\n\t\t\tFROM ld_users\r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='CustomForm25' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\tUNION\r\n\t\t\tSELECT \r\n\t\t\t\tviewid AS userid \r\n\t\t\tFROM ld_scoperhigher\r\n\t\t\tWHERE userid='[uuid]' AND modulename ='CustomForm25' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename ='CustomForm25')\t\t\t\r\n\t\t\tUNION\r\n\t\t\tSELECT DISTINCT \r\n\t\t\t\tld_users2group.userid AS userid \r\n\t\t\tFROM ld_scoperhigher \r\n\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\tAND ld_scoperhigher.modulename ='CustomForm25'\r\n\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='CustomForm25' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\tUNION \r\n\t\t\tSELECT \r\n\t\t\t\tid AS userid \r\n\t\t\tFROM ld_users  \r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\tUNION\r\n\t\t\tSELECT '[uuid]') AS vw_users\r\n\t) AS tmp_users ON tmp_users.userid=a.id\r\n\tWHERE a.deleted=0\r\n\t\tAND a.`status`='Active'\r\n)\r\nORDER BY list_order,listtype"
      },
      "2": {
        "Ident": "StiMySqlSource",
        "Name": "list_date",
        "Alias": "list_date",
        "Columns": {
          "0": {
            "Name": "enddate",
            "Index": -1,
            "NameInSource": "enddate",
            "Alias": "enddate",
            "Type": "System.String"
          },
          "1": {
            "Name": "listid",
            "Index": -1,
            "NameInSource": "listid",
            "Alias": "listid",
            "Type": "System.Int32"
          },
          "2": {
            "Name": "listvalue",
            "Index": -1,
            "NameInSource": "listvalue",
