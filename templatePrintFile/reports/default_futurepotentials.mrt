AY(L16) = 1 THEN\r\n\t\t\t'星期二'\r\n\t\tWHEN WEEKDAY(L16) = 2 THEN\r\n\t\t\t'星期三'\r\n\t\tWHEN WEEKDAY(L16) = 3 THEN\r\n\t\t\t'星期四'\r\n\t\tWHEN WEEKDAY(L16) = 4 THEN\r\n\t\t\t'星期五'\r\n\t\tWHEN WEEKDAY(L16) = 5 THEN\r\n\t\t\t'星期六'\r\n\t\tEND AS W16,\r\nCASE\r\n\t\tWHEN WEEKDAY(L17) = 6 THEN\r\n\t\t\t'星期天'\r\n\t\tWHEN WEEKDAY(L17) = 0 THEN\r\n\t\t\t'星期一'\r\n\t\tWHEN WEEKDAY(L17) = 1 THEN\r\n\t\t\t'星期二'\r\n\t\tWHEN WEEKDAY(L17) = 2 THEN\r\n\t\t\t'星期三'\r\n\t\tWHEN WEEKDAY(L17) = 3 THEN\r\n\t\t\t'星期四'\r\n\t\tWHEN WEEKDAY(L17) = 4 THEN\r\n\t\t\t'星期五'\r\n\t\tWHEN WEEKDAY(L17) = 5 THEN\r\n\t\t\t'星期六'\r\n\t\tEND AS W17 from (\r\nSELECT\r\n\t(CURDATE() + INTERVAL 0 DAY) AS L0,\r\n\t(CURDATE() + INTERVAL 1 DAY) AS L1,\r\n\t(CURDATE() + INTERVAL 2 DAY) AS L2,\r\n\t(CURDATE() + INTERVAL 3 DAY) AS L3,\r\n\t(CURDATE() + INTERVAL 4 DAY) AS L4,\r\n\t(CURDATE() + INTERVAL 5 DAY) AS L5,\r\n\t(CURDATE() + INTERVAL 6 DAY) AS L6,\r\n\t(CURDATE() + INTERVAL 7 DAY) AS L7,\r\n\t(CURDATE() + INTERVAL 8 DAY) AS L8,\r\n\t(CURDATE() + INTERVAL 9 DAY) AS L9,\r\n\t(CURDATE() + INTERVAL 10 DAY) AS L10,\r\n\t(CURDATE() + INTERVAL 11 DAY) AS L11,\r\n\t(CURDATE() + INTERVAL 12 DAY) AS L12,\r\n\t(CURDATE() + INTERVAL 13 DAY) AS L13,\r\n\t(CURDATE() + INTERVAL 14 DAY) AS L14,\r\n\t(CURDATE() + INTERVAL 15 DAY) AS L15,\r\n\t(CURDATE() + INTERVAL 16 DAY) AS L16,\r\n\t(CURDATE() + INTERVAL 17 DAY) AS L17\r\n)a \r\n\t"
