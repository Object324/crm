        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\tb.fieldlabel\r\nFROM\r\n\tld_field a\r\nLEFT JOIN ld_tranlabel b ON a.fieldid = b.Relateid\r\nWHERE\r\n\ttablename = \"ld_potential\"\r\nAND \r\n\tcolumnname = \"potentialname\"\r\n\r\nAND trantable = \"ld_field\"\r\nAND languagetype = \"zh\""
      }
