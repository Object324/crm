        "NameInSource": "crm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\t'{type}' + 0 AS bbtype,\r\n\td0.potentialid AS d0_id,\r\n\td0.potential_no AS d0_no,\r\n\tIF(IFNULL(d0.potentialname,'')='',d0.potential_no,d0.potentialname) AS d0_name,\r\n\td0.amount AS d0_amount,\r\n\td0.last_name AS d0_lastname,\r\n\td0.groupname AS d0_groupname,\r\n\r\n\td1.potentialid AS d1_id,\r\n\td1.potential_no AS d1_no,\r\n\tIF(IFNULL(d1.potentialname,'')='',d1.potential_no,d1.potentialname) AS d1_name,\r\n\td1.amount AS d1_amount,\r\n\td1.last_name AS d1_lastname,\r\n\td1.groupname AS d1_groupname,\r\n\r\n\td2.potentialid AS d2_id,\r\n\td2.potential_no AS d2_no,\r\n\tIF(IFNULL(d2.potentialname,'')='',d2.potential_no,d2.potentialname) AS d2_name,\r\n\td2.amount AS d2_amount,\r\n\td2.last_name AS d2_lastname,\r\n\td2.groupname AS d2_groupname,\r\n\r\n\td3.potentialid AS d3_id,\r\n\td3.potential_no AS d3_no,\r\n\tIF(IFNULL(d3.potentialname,'')='',d3.potential_no,d3.potentialname) AS d3_name,\r\n\td3.amount AS d3_amount,\r\n\td3.last_name AS d3_lastname,\r\n\td3.groupname AS d3_groupname,\r\n\r\n\td4.potentialid AS d4_id,\r\n\td4.potential_no AS d4_no,\r\n\tIF(IFNULL(d4.potentialname,'')='',d4.potential_no,d4.potentialname) AS d4_name,\r\n\td4.amount AS d4_amount,\r\n\td4.last_name AS d4_lastname,\r\n\td4.groupname AS d4_groupname,\r\n\r\n\td5.potentialid AS d5_id,\r\n\td5.potential_no AS d5_no,\r\n\tIF(IFNULL(d5.potentialname,'')='',d5.potential_no,d5.potentialname) AS d5_name,\r\n\td5.amount AS d5_amount,\r\n\td5.last_name AS d5_lastname,\r\n\td5.groupname AS d5_groupname,\r\n\r\n\td6.potentialid AS d6_id,\r\n\td6.potential_no AS d6_no,\r\n\tIF(IFNULL(d6.potentialname,'')='',d6.potential_no,d6.potentialname) AS d6_name,\r\n\td6.amount AS d6_amount,\r\n\td6.last_name AS d6_lastname,\r\n\td6.groupname AS d6_groupname,\r\n\r\n\td7.potentialid AS d7_id,\r\n\td7.potential_no AS d7_no,\r\n\tIF(IFNULL(d7.potentialname,'')='',d7.potential_no,d7.potentialname) AS d7_name,\r\n\td7.amount AS d7_amount,\r\n\td7.last_name AS d7_lastname,\r\n\td7.groupname AS d7_groupname,\r\n\r\n\td8.potentialid AS d8_id,\r\n\td8.potential_no AS d8_no,\r\n\tIF(IFNULL(d8.potentialname,'')='',d8.potential_no,d8.potentialname) AS d8_name,\r\n\td8.amount AS d8_amount,\r\n\td8.last_name AS d8_lastname,\r\n\td8.groupname AS d8_groupname,\r\n\r\n\td9.potentialid AS d9_id,\r\n\td9.potential_no AS d9_no,\r\n\tIF(IFNULL(d9.potentialname,'')='',d9.potential_no,d9.potentialname) AS d9_name,\r\n\td9.amount AS d9_amount,\r\n\td9.last_name AS d9_lastname,\r\n\td9.groupname AS d9_groupname,\r\n\r\n\td10.potentialid AS d10_id,\r\n\td10.potential_no AS d10_no,\r\n\tIF(IFNULL(d10.potentialname,'')='',d10.potential_no,d10.potentialname) AS d10_name,\r\n\td10.amount AS d10_amount,\r\n\td10.last_name AS d10_lastname,\r\n\td10.groupname AS d10_groupname,\r\n\r\n\td11.potentialid AS d11_id,\r\n\td11.potential_no AS d11_no,\r\n\tIF(IFNULL(d11.potentialname,'')='',d11.potential_no,d11.potentialname) AS d11_name,\r\n\td11.amount AS d11_amount,\r\n\td11.last_name AS d11_lastname,\r\n\td11.groupname AS d11_groupname,\r\n\r\n\td12.potentialid AS d12_id,\r\n\td12.potential_no AS d12_no,\r\n\tIF(IFNULL(d12.potentialname,'')='',d12.potential_no,d12.potentialname) AS d12_name,\r\n\td12.amount AS d12_amount,\r\n\td12.last_name AS d12_lastname,\r\n\td12.groupname AS d12_groupname,\r\n\r\n\td13.potentialid AS d13_id,\r\n\td13.potential_no AS d13_no,\r\n\tIF(IFNULL(d13.potentialname,'')='',d13.potential_no,d13.potentialname) AS d13_name,\r\n\td13.amount AS d13_amount,\r\n\td13.last_name AS d13_lastname,\r\n\td13.groupname AS d13_groupname,\r\n\r\n\td14.potentialid AS d14_id,\r\n\td14.potential_no AS d14_no,\r\n\tIF(IFNULL(d14.potentialname,'')='',d14.potential_no,d14.potentialname) AS d14_name,\r\n\td14.amount AS d14_amount,\r\n\td14.last_name AS d14_lastname,\r\n\td14.groupname AS d14_groupname,\r\n\r\n\td15.potentialid AS d15_id,\r\n\td15.potential_no AS d15_no,\r\n\tIF(IFNULL(d15.potentialname,'')='',d15.potential_no,d15.potentialname) AS d15_name,\r\n\td15.amount AS d15_amount,\r\n\td15.last_name AS d15_lastname,\r\n\td15.groupname AS d15_groupname,\r\n\r\n\td16.potentialid AS d16_id,\r\n\td16.potential_no AS d16_no,\r\n\tIF(IFNULL(d16.potentialname,'')='',d16.potential_no,d16.potentialname) AS d16_name,\r\n\td16.amount AS d16_amount,\r\n\td16.last_name AS d16_lastname,\r\n\td16.groupname AS d16_groupname,\r\n\r\n\td17.potentialid AS d17_id,\r\n\td17.potential_no AS d17_no,\r\n\tIF(IFNULL(d17.potentialname,'')='',d17.potential_no,d17.potentialname) AS d17_name,\r\n\td17.amount AS d17_amount,\r\n\td17.last_name AS d17_lastname,\r\n\td17.groupname AS d17_groupname\r\nFROM sequence a\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\t(@i0 :=@i0 + 1) AS seq,\r\n\t\ta.potentialid,\r\n\t\ta.potential_no,\r\n\t\ta.potentialname,\r\n\t\ta.amount,\r\n\t\ta.last_name,\r\n\t\ta.groupname,\r\n\t\tCASE WHEN IFNULL(a.groupname,'')='' THEN a.last_name ELSE CONCAT(a.last_name,'(',a.groupname,')') END AS yewuyuan\r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\ta.potentialid,\r\n\t\t\ta.potential_no,\r\n\t\t\ta.potentialname,\r\n\t\t\tFORMAT(IFNULL(a.amount,0),2) AS amount,\r\n\t\t\tb.last_name,\r\n\t\t\tGROUP_CONCAT(DISTINCT d.groupname) AS groupname,\r\n\t\t\ta.deleted,\r\n\t\t\ta.approvestatus,\r\n\t\t\ta.smownerid,\r\n\t\t\ta.closingdate\r\n\t\tFROM ld_potential a\r\n\t\tLEFT JOIN ld_users b ON b.id=a.smownerid\r\n\t\tLEFT JOIN ld_users2group c ON c.userid=a.smownerid\r\n\t\tLEFT JOIN ld_groups d ON d.groupid=c.groupid\r\n\t\tGROUP BY a.potentialid\r\n\t) a,(SELECT @i0 := 0) b\r\n\tWHERE a.deleted = 0\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{isapproved}' = 'true' THEN a.approvestatus = '已批准'\r\n\t\t\tELSE a.approvestatus <> '已拒绝'\r\n\t\t\tEND\r\n\t)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN FIND_IN_SET(1, '{data_range}') OR '{data_range}' = '' THEN 1 = 1\r\n\t\t\tELSE FIND_IN_SET(a.smownerid,'{data_range}')\r\n\t\t\tEND\r\n\t)\r\n\tAND a.closingdate = DATE_ADD('{mydate}', INTERVAL 0 DAY)\r\n\tORDER BY a.potentialid\r\n) d0 ON d0.seq = a.seq\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\t(@i1 :=@i1 + 1) AS seq,\r\n\t\ta.potentialid,\r\n\t\ta.potential_no,\r\n\t\ta.potentialname,\r\n\t\tFORMAT(IFNULL(a.amount,0),2) AS amount,\r\n\t\ta.last_name,\r\n\t\ta.groupname,\r\n\t\tCASE WHEN IFNULL(a.groupname,'')='' THEN a.last_name ELSE CONCAT(a.last_name,'(',a.groupname,')') END AS yewuyuan\r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\ta.potentialid,\r\n\t\t\ta.potential_no,\r\n\t\t\ta.potentialname,\r\n\t\t\ta.amount,\r\n\t\t\tb.last_name,\r\n\t\t\tGROUP_CONCAT(DISTINCT d.groupname) AS groupname,\r\n\t\t\ta.deleted,\r\n\t\t\ta.approvestatus,\r\n\t\t\ta.smownerid,\r\n\t\t\ta.closingdate\r\n\t\tFROM ld_potential a\r\n\t\tLEFT JOIN ld_users b ON b.id=a.smownerid\r\n\t\tLEFT JOIN ld_users2group c ON c.userid=a.smownerid\r\n\t\tLEFT JOIN ld_groups d ON d.groupid=c.groupid\r\n\t\tGROUP BY a.potentialid\r\n\t) a,(SELECT @i1 := 0) b\r\n\tWHERE a.deleted = 0\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{isapproved}' = 'true' THEN a.approvestatus = '已批准'\r\n\t\t\tELSE a.approvestatus <> '已拒绝'\r\n\t\t\tEND\r\n\t)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN FIND_IN_SET(1, '{data_range}') OR '{data_range}' = '' THEN 1 = 1\r\n\t\t\tELSE FIND_IN_SET(a.smownerid,'{data_range}')\r\n\t\t\tEND\r\n\t)\r\n\tAND a.closingdate = DATE_ADD('{mydate}', INTERVAL 1 DAY)\r\n\tORDER BY a.potentialid\r\n) d1 ON d1.seq = a.seq\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\t(@i2 :=@i2 + 1) AS seq,\r\n\t\ta.potentialid,\r\n\t\ta.potential_no,\r\n\t\ta.potentialname,\r\n\t\tFORMAT(IFNULL(a.amount,0),2) AS amount,\r\n\t\ta.last_name,\r\n\t\ta.groupname,\r\n\t\tCASE WHEN IFNULL(a.groupname,'')='' THEN a.last_name ELSE CONCAT(a.last_name,'(',a.groupname,')') END AS yewuyuan\r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\ta.potentialid,\r\n\t\t\ta.potential_no,\r\n\t\t\ta.potentialname,\r\n\t\t\ta.amount,\r\n\t\t\tb.last_name,\r\n\t\t\tGROUP_CONCAT(DISTINCT d.groupname) AS groupname,\r\n\t\t\ta.deleted,\r\n\t\t\ta.approvestatus,\r\n\t\t\ta.smownerid,\r\n\t\t\ta.closingdate\r\n\t\tFROM ld_potential a\r\n\t\tLEFT JOIN ld_users 