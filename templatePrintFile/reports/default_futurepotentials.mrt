        "SqlCommand": "\r\nselect *,\r\nCASE\r\n\t\tWHEN WEEKDAY(L0) = 6 THEN\r\n\t\t\t'星期天'\r\n\t\tWHEN WEEKDAY(L0) = 0 THEN\r\n\t\t\t'星期一'\r\n\t\tWHEN WEEKDAY(L0) = 1 THEN\r\n\t\t\t'星期二'\r\n\t\tWHEN WEEKDAY(L0) = 2 THEN\r\n\t\t\t'星期三'\r\n\t\tWHEN WEEKDAY(L0) = 3 THEN\r\n\t\t\t'星期四'\r\n\t\tWHEN WEEKDAY(L0) = 4 THEN\r\n\t\t\t'星期五'\r\n\t\tWHEN WEEKDAY(L0) = 5 THEN\r\n\t\t\t'星期六'\r\n\t\tEND AS W0,\r\nCASE\r\n\t\tWHEN WEEKDAY(L1) = 6 THEN\r\n\t\t\t'星期天'\r\n\t\tWHEN WEEKDAY(L1) = 0 THEN\r\n\t\t\t'星期一'\r\n\t\tWHEN WEEKDAY(L1) = 1 THEN\r\n\t\t\t'星期二'\r\n\t\tWHEN WEEKDAY(L1) = 2 THEN\r\n\t\t\t'星期三'\r\n\t\tWHEN WEEKDAY(L1) = 3 THEN\r\n\t\t\t'星期四'\r\n\t\tWHEN WEEKDAY(L1) = 4 THEN\r\n\t\t\t'星期五'\r\n\t\tWHEN WEEKDAY(L1) = 5 THEN\r\n\t\t\t'星期六'\r\n\t\tEND AS W1,\r\nCASE\r\n\t\tWHEN WEEKDAY(L2) = 6 THEN\r\n\t\t\t'星期天'\r\n\t\tWHEN WEEKDAY(L2) = 0 THEN\r\n\t\t\t'星期一'\r\n\t\tWHEN WEEKDAY(L2) = 1 THEN\r\n\t\t\t'星期二'\r\n\t\tWHEN WEEKDAY(L2) = 2 THEN\r\n\t\t\t'星期三'\r\n\t\tWHEN WEEKDAY(L2) = 3 THEN\r\n\t\t\t'星期四'\r\n\t\tWHEN WEEKDAY(L2) = 4 THEN\r\n\t\t\t'星期五'\r\n\t\tWHEN WEEKDAY(L2) = 5 THEN\r\n\t\t\t'星期六'\r\n\t\tEND AS W2,\r\nCASE\r\n\t\tWHEN WEEKDAY(L3) = 6 THEN\r\n\t\t\t'星期天'\r\n\t\tWHEN WEEKDAY(L3) = 0 THEN\r\n\t\t\t'星期一'\r\n\t\tWHEN WEEKDAY(L3) = 1 THEN\r\n\t\t\t'星期二'\r\n\t\tWHEN WEEKDAY(L3) = 2 THEN\r\n\t\t\t'星期三'\r\n\t\tWHEN WEEKDAY(L3) = 3 THEN\r\n\t\t\t'星期四'\r\n\t\tWHEN WEEKDAY(L3) = 4 THEN\r\n\t\t\t'星期五'\r\n\t\tWHEN WEEKDAY(L3) = 5 THEN\r\n\t\t\t'星期六'\r\n\t\tEND AS W3,\r\nCASE\r\n\t\tWHEN WEEKDAY(L4) = 6 THEN\r\n\t\t\t'星期天'\r\n\t\tWHEN WEEKDAY(L4) = 0 THEN\r\n\t\t\t'星期一'\r\n\t\tWHEN WEEKDAY(L4) = 1 THEN\r\n\t\t\t'星期二'\r\n\t\tWHEN WEEKDAY(L4) = 2 THEN\r\n\t\t\t'星期三'\r\n\t\tWHEN WEEKDAY(L4) = 3 THEN\r\n\t\t\t'星期四'\r\n\t\tWHEN WEEKDAY(L4) = 4 THEN\r\n\t\t\t'星期五'\r\n\t\tWHEN WEEKDAY(L4) = 5 THEN\r\n\t\t\t'星期六'\r\n\t\tEND AS W4,\r\nCASE\r\n\t\tWHEN WEEKDAY(L5) = 6 THEN\r\n\t\t\t'星期天'\r\n\t\tWHEN WEEKDAY(L5) = 0 THEN\r\n\t\t\t'星期一'\r\n\t\tWHEN WEEKDAY(L5) = 1 THEN\r\n\t\t\t'星期二'\r