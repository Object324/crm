FROM ld_users WHERE `status`='Active'</SqlCommand>
      </users>
      <report isKey="true" Ref="4" type="Stimulsoft.Report.Dictionary.StiMySqlSource">
        <Alias>report</Alias>
        <Columns isList="true" count="14">
          <value>salesorderid,System.Int32</value>
          <value>salesorder_no,System.String</value>
          <value>signed_data,System.DateTime</value>
          <value>accountname,System.String</value>
          <value>productname,System.String</value>
          <value>productsheet,System.String</value>
          <value>stockpresence,System.String</value>
          <value>smownerid,System.Int32</value>
          <value>last_name,System.String</value>
          <value>quantity,System.Decimal</value>
          <value>haveoutproductcount,System.Decimal</value>
          <value>balanceoutproductcount,System.Decimal</value>
          <value>balancepurchasecount,System.Decimal</value>
          <value>comment,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1"/>
        <Name>report</Name>
        <NameInSource>ldcrm</NameInSource>
        <Parameters isList="true" count="0"/>
        <SqlCommand>SELECT
	a.salesorderid,
	a.salesorder_no,
	a.signed_data,
	c.accountname,
	d.productname,
	d.productsheet,
	a.stockpresence,
	a.smownerid,
	e.last_name,
	b.quantity,
	b.haveoutproductcount,
	b.balanceoutproductcount,
	b.balancepurchasecount,
	b.`comment`
FROM ld_salesorder a
LEFT JOIN ld_inventoryproductrel b ON a.salesorderid=b.id
LEFT JOIN ld_account c ON c.accountid=a.accountid
LEFT JOIN ld_products d ON d.productid=b.productid
LEFT JOIN ld_users e ON e.id=a.smownerid
WHERE a.deleted=0
	AND a.approvestatus&lt;&gt;'已拒绝'
	AND signed_data BETWEEN STR_TO_DATE('{start_date}','%m/%d/%Y') AND STR_TO_DATE('{end_date}','%m/%d/%Y')
	AND LOCATE(TRIM('{custname}'),c.accountname)&gt;0
	AND LOCATE(TRIM('{orderno}'),a.salesorder_no)&gt;0
	AND (
		CASE
			WHEN '{ckzt}'='全部' THEN 1=1
			ELSE a.stockpresence='{ckzt}'
		END)
	AND (
		CASE
			WHEN '{userid}'='' THEN 1=1
			ELSE FIND_IN_SET(a.smownerid,'{userid}')
		END)</SqlCommand>
      </report>
      <purchase_data isKey="true" Ref="5" type="Stimulsoft.Report.Dictionary.StiMySqlSource">
        <Alias>purchase_data</Alias>
        <Columns isList="true" count="1">
          <value>json_products,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1"/>
        <Name>purchase_data</Name>
        <NameInSource>ldcrm</NameInSource>
        <Parameters isList="true" count="0"/>
        <SqlCommand>SELECT
	CONCAT('[',GROUP_CONCAT(CONCAT((select symbol from tmp_symbol where id=1),'"productid":',b.productid,',"quantity":',REPLACE(b.balanceoutproductcount,',',''),',"lineitem_id":',b.lineitem_id,',"entitytype":','"SalesOrder"',(select symbol from tmp_symbol where id=2))),']') AS json_products
FROM ld_salesorder a
LEFT JOIN ld_inventoryproductrel b ON a.salesorderid=b.id
LEFT JOIN ld_account c ON c.accountid=a.accountid
LEFT JOIN ld_products d ON d.productid=b.productid
LEFT JOIN ld_users e ON e.id=a.smownerid
WHERE a.deleted=0
	AND a.approvestatus&lt;&gt;'已拒绝'
	AND b.balanceoutproductcount&gt;0
	AND signed_data BETWEEN STR_TO_DATE('11/01/2017 00:00:00 AM','%m/%d/%Y') AND STR_TO_DATE('11/27/2017 00:00:00 AM','%m/%d/%Y')
	AND LOCATE(TRIM(''),c.accountname)&gt;0
	AND LOCATE(TRIM(''),a.salesorder_no)&gt;0
	AND (
		CASE
			WHEN '全部'='全部' THEN 1=1
			ELSE a.stockpresence='全部'
		END)
	AND (
		CASE
			WHEN ''='' THEN 1=1
			ELSE FIND_IN_SET(a.smownerid,'')
		END)</SqlCommand>
      </purchase_data>
    </DataSources>
