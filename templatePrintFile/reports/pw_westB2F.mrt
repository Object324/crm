        "SqlCommand": "SELECT\r\n\tCASE\r\n\t\tWHEN '{color_type}'=1 THEN 'https://xx.dongmaoguoji.cn/crm/templatePrintFile/reports/pw_color1.png'\r\n\t\tELSE 'https://xx.dongmaoguoji.cn/crm/templatePrintFile/reports/pw_color2.png'\r\n\tEND AS color_tip\r\n"
