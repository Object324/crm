  "Dictionary": {
    "DataSources": {
      "0": {
        "Ident": "StiMySqlSource",
        "Name": "b",
        "Alias": "b",
        "Columns": {
          "0": {
            "Name": "chart_type",
            "Index": -1,
            "NameInSource": "chart_type",
            "Alias": "chart_type",
            "Type": "System.String"
          },
          "1": {
            "Name": "chart_value",
            "Index": -1,
            "NameInSource": "chart_value",
            "Alias": "chart_value",
            "Type": "System.Decimal"
          },
          "2": {
            "Name": "potentialname",
            "Index": -1,
            "NameInSource": "potentialname",
            "Alias": "potentialname",
            "Type": "System.String"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\t(\r\n\t\tSELECT \r\n\t\t\tb.potentialname b\r\n\t\tFROM ld_potential b\r\n\t\tLEFT JOIN ld_customform52 a ON b.potentialid=a.potentialid \r\n\t\tWHERE (a.customform52id='[related_ldcrmid]' OR b.potentialid ='[related_ldcrmid]')\r\n\t\tLIMIT 1\r\n\t) AS potentialname,\r\n\tchart_type,\r\n\tchart_value\r\nFROM (\r\nSELECT \r\n\t1 AS seq,\r\n\t'痛点和需求' AS chart_type,\r\n\tIFNULL((\r\n\t\tSELECT \r\n\t\t\tCASE\r\n\t\t\t\tWHEN b.cf_5256='猜测评估者的需求' THEN 9\r\n\t\t\t\tWHEN b.cf_5256='评估者承认需求' THEN 8\r\n\t\t\t\tWHEN b.cf_5256='评估者承认痛的表现' THEN 7\r\n\t\t\t\tWHEN b.cf_5256='评估者承认痛' THEN 6\r\n\t\t\t\tWHEN b.cf_5256='评估者认可书面记录的痛' THEN 5\r\n\r\n\t\t\t\tWHEN b.cf_5256='猜测决策支持者的需求' THEN 4\r\n\t\t\t\tWHEN b.cf_5256='决策支持者承认需求' THEN 3\r\n\t\t\t\tWHEN b.cf_5256='决策支持者承认痛的表现' THEN 2\r\n\t\t\t\tWHEN b.cf_5256='决策支持者承认痛' THEN 1\r\n\t\t\t\tWHEN b.cf_5256='决策支持者认可书面记录的痛' THEN 0.1\r\n\t\t\t\tELSE 10\r\n\t\t\tEND\r\n\t\tFROM ld_customform57 a \r\n\t\tLEFT JOIN ld_customform57scf b ON b.customform57id=a.customform57id \r\n\t\tWHERE a.deleted=0 \r\n\t\t\tAND approvestatus<>'已拒绝' \r\n\t\t\tAND (a.potentialid=(SELECT potentialid FROM ld_customform52 WHERE customform52id='[related_ldcrmid]') OR a.potentialid='[related_ldcrmid]')\r\n\t\tORDER BY a.customform57id DESC \r\n\t\tLIMIT 1\r\n\t\t),10) AS chart_value\r\nUNION\r\nSELECT\r\n\t2 AS seq,\r\n\t'解决方案构想' AS chart_type,\r\n\tIFNULL((\r\n\t\tSELECT \r\n\t\t\tCASE\r\n\t\t\t\tWHEN b.cf_5259='为评估者构建产品式构想' THEN 9\r\n\t\t\t\tWHEN b.cf_5259='为评估者构建情景式构想' THEN 8\r\n\t\t\t\tWHEN b.cf_5259='为评估者构建差异化构想' THEN 9\r\n\t\t\t\tWHEN b.cf_5259='差异化概念方案汇报给评估者' THEN 6\r\n\t\t\t\tWHEN b.cf_5259='评估者认可解决方案' THEN 5\r\n\r\n\t\t\t\tWHEN b.cf_5259='为决策支持者构建及汇报概念方案' THEN 4\r\n\t\t\t\tWHEN b.cf_5259='决策支持者认可解决方案' THEN 3\r\n\t\t\t\tWHEN b.cf_5259='为KDM构建及汇报设计方案' THEN 5\r\n\t\t\t\tWHEN b.cf_5259='KDM初步认可设计方案' THEN 1\r\n\t\t\t\tWHEN b.cf_5259='KDM认可设计方案' THEN 0.1\r\n\t\t\t\tELSE 10\r\n\t\t\tEND\r\n\t\tFROM ld_customform57 a \r\n\t\tLEFT JOIN ld_customform57scf b ON b.customform57id=a.customform57id \r\n\t\tWHERE a.deleted=0 \r\n\t\t\tAND approvestatus<>'已拒绝' \r\n\t\t\tAND (a.potentialid=(SELECT potentialid FROM ld_customform52 WHERE customform52id='[related_ldcrmid]') OR a.potentialid='[related_ldcrmid]')\r\n\t\tORDER BY a.customform57id DESC \r\n\t\tLIMIT 1\r\n\t\t),10) AS chart_value\r\nUNION\r\nSELECT\r\n\t3 AS seq,\r\n\t'实现客户价值' AS chart_type,\r\n\tIFNULL((\r\n\t\tSELECT \r\n\t\t\tCASE\r\n\t\t\t\tWHEN b.cf_5258='构想呈现了对客户的价值分析' THEN 9\r\n\t\t\t\tWHEN b.cf_5258='客户同意研究构想的价值分析' THEN 8\r\n\t\t\t\tWHEN b.cf_5258='呈现了解决痛点的价值' THEN 7\r\n\t\t\t\tWHEN b.cf_5258='呈现了概念方案的价值' THEN 6\r\n\t\t\t\tWHEN b.cf_5258='客户认可可能的价值' THEN 5\r\n\r\n\t\t\t\tWHEN b.cf_5258='方案价值包括更多的受益人' THEN 4\r\n\t\t\t\tWHEN b.cf_5258='我方推动客户方案价值分析' THEN 3\r\n\t\t\t\tWHEN b.cf_5258='客户推动方案价值分析' THEN 2\r\n\t\t\t\tWHEN b.cf_5258='与客户共同进行方案价值分析' THEN 1\r\n\t\t\t\tWHEN b.cf_5258='解决方案价值满足决策标准' THEN 0.1\r\n\t\t\t\tELSE 10\r\n\t\t\tEND\r\n\t\tFROM ld_customform57 a \r\n\t\tLEFT JOIN ld_customform57scf b ON b.customform57id=a.customform57id \r\n\t\tWHERE a.deleted=0 \r\n\t\t\tAND approvestatus<>'已拒绝' \r\n\t\t\tAND (a.potentialid=(SELECT potentialid FROM ld_customform52 WHERE customform52id='[related_ldcrmid]') OR a.potentialid='[related_ldcrmid]')\r\n\t\tORDER BY a.customform57id DESC \r\n\t\tLIMIT 1\r\n\t\t),10) AS chart_value\r\nUNION\r\nSELECT\r\n\t4 AS seq,\r\n\t'过程控制' AS chart_type,\r\n\tIFNULL((\r\n\t\tSELECT \r\n\t\t\tCASE\r\n\t\t\t\tWHEN b.cf_5260='发送了拜访备忘录' THEN 9\r\n\t\t\t\tWHEN b.cf_5260='客户认可/反馈备忘录' THEN 8\r\n\t\t\t\tWHEN b.cf_5260='提交评估者的汇报成果记录' THEN 7\r\n\t\t\t\tWHEN b.cf_5260='评估者向上提交汇报成果记录' THEN 6\r\n\t\t\t\tWHEN b.cf_5260='决策支持者认可汇报记录' THEN 5\r\n\r\n\t\t\t\tWHEN b.cf_5260='决策支持者向上提交汇报成果' THEN 4\r\n\t\t\t\tWHEN b.cf_5260='提交与客户的协同推动计划' THEN 3\r\n\t\t\t\tWHEN b.cf_5260='客户认可/反馈协同推动计划' THEN 2\r\n\t\t\t\tWHEN b.cf_5260='推进与客户的协同计划' THEN 1\r\n\t\t\t\tWHEN b.cf_5260='完成与客户的协同推动计划' THEN 0.1\r\n\t\t\t\tELSE 10\r\n\t\t\tEND\r\n\t\tFROM ld_customform57 a \r\n\t\tLEFT JOIN ld_customform57scf b ON b.customform57id=a.customform57id \r\n\t\tWHERE a.deleted=0 \r\n\t\t\tAND approvestatus<>'已拒绝' \r\n\t\t\tAND (a.potentialid=(SELECT potentialid FROM ld_customform52 WHERE customform52id='[related_ldcrmid]') OR a.potentialid='[related_ldcrmid]')\r\n\t\tORDER BY a.customform57id DESC \r\n\t\tLIMIT 1\r\n\t\t),10) AS chart_value\r\nUNION\r\nSELECT\r\n\t5 AS seq,\r\n\t'影响力和关系' AS chart_type,\r\n\tIFNULL((\r\n\t\tSELECT \r\n\t\t\tCASE\r\n\t\t\t\tWHEN b.cf_5257='评估者说明了决策流程' THEN 9\r\n\t\t\t\tWHEN b.cf_5257='找到可能的决策支持者' THEN 8\r\n\t\t\t\tWHEN b.cf_5257='评估人帮助与决策支持者建立联系' THEN 7\r\n\t\t\t\tWHEN b.cf_5257='接触到决策支持者' THEN 6\r\n\t\t\t\tWHEN b.cf_5257='采购和决策流程已确定' THEN 5\r\n\r\n\t\t\t\tWHEN b.cf_5257='决策支持者同意进一步探索' THEN 4\r\n\t\t\t\tWHEN b.cf_5257='决策支持者同意协同推动计划' THEN 3\r\n\t\t\t\tWHEN b.cf_5257='决策支持者同意设计方案' THEN 2\r\n\t\t\t\tWHEN b.cf_5257='决策支持者口头批准' THEN 1\r\n\t\t\t\tWHEN b.cf_5257='KDM批准' THEN 0.1\r\n\t\t\t\tELSE 10\r\n\t\t\tEND\r\n\t\tFROM ld_customform57 a \r\n\t\tLEFT JOIN ld_customform57scf b ON b.customform57id=a.customform57id \r\n\t\tWHERE a.deleted=0 \r\n\t\t\tAND a.approvestatus<>'已拒绝' \r\n\t\t\tAND (a.potentialid=(SELECT potentialid FROM ld_customform52 WHERE customform52id='[related_ldcrmid]') OR a.potentialid='[related_ldcrmid]')\r\n\t\tORDER BY a.customform57id DESC \r\n\t\tLIMIT 1\r\n\t\t),10) AS chart_value\r\n) a\r\nORDER BY seq"
      }
    },
