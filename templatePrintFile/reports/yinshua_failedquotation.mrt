    },
    "DataSources": {
      "0": {
        "Ident": "StiMySqlSource",
        "Name": "list_user",
        "Alias": "list_user",
        "Columns": {
          "0": {
            "Name": "listid",
            "Index": -1,
            "NameInSource": "listid",
            "Alias": "listid",
            "Type": "System.Int32"
          },
          "1": {
            "Name": "listvalue",
            "Index": -1,
            "NameInSource": "listvalue",
            "Alias": "listvalue",
            "Type": "System.String"
          }
        },
        "NameInSource": "yinshua",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\ta.smownerid AS listid,\r\n\tb.last_name AS listvalue\r\nFROM (\r\n\tSELECT\r\n\t\ta.smownerid\r\n\tFROM ld_quotes a\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\tGROUP BY a.smownerid\r\n) a\r\nLEFT JOIN ld_users b ON a.smownerid=b.id\r\nORDER BY CONVERT(b.last_name USING GBK)"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "T",
        "Alias": "T",
        "Columns": {
          "0": {
            "Name": "argument",
            "Index": -1,
            "NameInSource": "argument",
            "Alias": "argument",
            "Type": "System.String"
          },
          "1": {
            "Name": "qty",
            "Index": -1,
            "NameInSource": "qty",
            "Alias": "qty",
            "Type": "System.Int32"
          },
          "2": {
            "Name": "tips",
            "Index": -1,
            "NameInSource": "tips",
            "Alias": "tips",
            "Type": "System.String"
          }
        },
        "NameInSource": "yinshua",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\ta.argument,\r\n\ta.qty,\r\n\tCONCAT(a.argument,'\r\n',SPACE(CHAR_LENGTH(a.argument)-2),ROUND(a.qty*100/a.total_qty),'%') AS tips\r\nFROM (\r\n\tSELECT\r\n\t\tb.cf_2973 AS argument,\r\n\t\tCOUNT(a.quoteid) AS qty,\r\n\t\t(SELECT COUNT(a.quoteid) FROM ld_quotes a LEFT JOIN ld_quotescf b ON b.quoteid=a.quoteid WHERE a.deleted=0 AND IFNULL(b.cf_2973,'')<>'') AS total_qty\r\n\tFROM ld_quotes a\r\n\tLEFT JOIN ld_quotescf b ON b.quoteid=a.quoteid\r\n\tINNER JOIN (\r\n\t\tSELECT\r\n\t\t\ta.smownerid AS listid,\r\n\t\t\tb.last_name AS listvalue\r\n\t\tFROM (\r\n\t\t\tSELECT\r\n\t\t\t\ta.smownerid\r\n\t\t\tFROM ld_quotes a\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND a.createdtime BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d 00:00:00') AND DATE_FORMAT('{end_date}','%Y-%m-%d 23:59:59')\r\n\t\t\tGROUP BY a.smownerid\r\n\t\t) a\r\n\t\tLEFT JOIN ld_users b ON a.smownerid=b.id\r\n\t) u ON u.listid=a.smownerid\r\n\tWHERE a.deleted=0\r\n\t\tAND IFNULL(b.cf_2973,'')<>''\r\n\t\tAND a.createdtime BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d 00:00:00') AND DATE_FORMAT('{end_date}','%Y-%m-%d 23:59:59')\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{smowner}'='' THEN 1=1\r\n\t\t\t\tELSE FIND_IN_SET(smownerid,'{smowner}')\t\r\n\t\t\tEND)\r\n\tGROUP BY b.cf_2973\r\n) a\r\nLEFT JOIN (SELECT listvalue,sequence FROM ld_picklist_values WHERE listid=135) b ON a.argument=b.listvalue\r\nORDER BY IFNULL(b.sequence,1000)"
      },
      "2": {
        "Ident": "StiMySqlSource",
        "Name": "d",
        "Alias": "d",
        "Columns": {
          "0": {
            "Name": "quoteid",
            "Index": -1,
            "NameInSource": "quoteid",
            "Alias": "quoteid",
            "Type": "System.Int32"
          },
          "1": {
            "Name": "quote_no",
            "Index": -1,
            "NameInSource": "quote_no",
            "Alias": "quote_no",
            "Type": "System.String"
          },
          "2": {
            "Name": "quotestage",
            "Index": -1,
            "NameInSource": "quotestage",
            "Alias": "quotestage",
            "Type": "System.String"
          },
          "3": {
            "Name": "validtill",
            "Index": -1,
            "NameInSource": "validtill",
            "Alias": "validtill",
            "Type": "System.DateTime"
          },
          "4": {
            "Name": "accountid",
            "Index": -1,
            "NameInSource": "accountid",
            "Alias": "accountid",
            "Type": "System.Int32"
          },
          "5": {
            "Name": "accountname",
            "Index": -1,
            "NameInSource": "accountname",
            "Alias": "accountname",
            "Type": "System.String"
          },
          "6": {
            "Name": "last_name",
            "Index": -1,
            "NameInSource": "last_name",
            "Alias": "last_name",
            "Type": "System.String"
          }
        },
        "NameInSource": "yinshua",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\ta.quoteid,\r\n\ta.quote_no,\r\n\ta.quotestage,\r\n\ta.validtill,\r\n\ta.accountid,\r\n\tc.accountname,\r\n\tu.last_name\r\nFROM ld_quotes a\r\nLEFT JOIN ld_quotescf b ON b.quoteid=a.quoteid\r\nLEFT JOIN ld_account c ON c.accountid=a.accountid\r\nINNER JOIN (\r\n\tSELECT\r\n\t\ta.smownerid AS listid,\r\n\t\tb.last_name\r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\ta.smownerid\r\n\t\tFROM ld_quotes a\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\tAND a.createdtime BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d 00:00:00') AND DATE_FORMAT('{end_date}','%Y-%m-%d 23:59:59')\r\n\t\tGROUP BY a.smownerid\r\n\t) a\r\n\tLEFT JOIN ld_users b ON a.smownerid=b.id\r\n) u ON u.listid=a.smownerid\r\nWHERE a.deleted=0\r\n\tAND a.createdtime BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d 00:00:00') AND DATE_FORMAT('{end_date}','%Y-%m-%d 23:59:59')\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{smowner}'='' THEN 1=1\r\n\t\t\tELSE FIND_IN_SET(a.smownerid,'{smowner}')\r\n\t\tEND)\r\n\tAND b.cf_2973='{this[\"SeriesArgument\"]}'"
      }
    },
