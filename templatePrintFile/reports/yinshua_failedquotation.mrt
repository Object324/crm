      },
      "2": {
        "Value": "1",
        "Name": "smowner",
        "DialogInfo": {
          "ItemsInitializationType": "Columns",
          "KeysColumn": "list_user.listid",
          "ValuesColumn": "list_user.listvalue",
          "AllowUserValues": false
        },
