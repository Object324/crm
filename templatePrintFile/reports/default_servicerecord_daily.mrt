ORMAT(CONCAT('{nian}','-','{yue}','-','2'),'%Y-%m-%d'),INTERVAL 1 DAY)) AS L3,\r\n\t\t\tDAY(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','3'),'%Y-%m-%d'),INTERVAL 1 DAY)) AS L4,\r\n\t\t\tDAY(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','4'),'%Y-%m-%d'),INTERVAL 1 DAY)) AS L5,\r\n\t\t\tDAY(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','5'),'%Y-%m-%d'),INTERVAL 1 DAY)) AS L6,\r\n\t\t\tDAY(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','6'),'%Y-%m-%d'),INTERVAL 1 DAY)) AS L7,\r\n\t\t\tDAY(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','7'),'%Y-%m-%d'),INTERVAL 1 DAY)) AS L8,\r\n\t\t\tDAY(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','8'),'%Y-%m-%d'),INTERVAL 1 DAY)) AS L9,\r\n\t\t\tDAY(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','9'),'%Y-%m-%d'),INTERVAL 1 DAY)) AS L10,\r\n\t\t\t\r\n\t\t\tDAY(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','10'),'%Y-%m-%d'),INTERVAL 1 DAY)) AS L11,\r\n\t\t\tDAY(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','11'),'%Y-%m-%d'),INTERVAL 1 DAY)) AS L12,\r\n\t\t\tDAY(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','12'),'%Y-%m-%d'),INTERVAL 1 DAY)) AS L13,\r\n\t\t\tDAY(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','13'),'%Y-%m-%d'),INTERVAL 1 DAY)) AS L14,\r\n\t\t\tDAY(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','14'),'%Y-%m-%d'),INTERVAL 1 DAY)) AS L15,\r\n\t\t\tDAY(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','15'),'%Y-%m-%d'),INTERVAL 1 DAY)) AS L16,\r\n\t\t\tDAY(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','16'),'%Y-%m-%d'),INTERVAL 1 DAY)) AS L17,\r\n\t\t\tDAY(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','17'),'%Y-%m-%d'),INTERVAL 1 DAY)) AS L18,\r\n\t\t\tDAY(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','18'),'%Y-%m-%d'),INTERVAL 1 DAY)) AS L19,\r\n\t\t\tDAY(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','19'),'%Y-%m-%d'),INTERVAL 1 DAY)) AS L20,\r\n\t\t\t\r\n\t\t\tDAY(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','20'),'%Y-%m-%d'),INTERVAL 1 DAY)) AS L21,\r\n\t\t\tDAY(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','21'),'%Y-%m-%d'),INTERVAL 1 DAY)) AS L22,\r\n\t\t\tDAY(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','22'),'%Y-%m-%d'),INTERVAL 1 DAY)) AS L23,\r\n\t\t\tDAY(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','23'),'%Y-%m-%d'),INTERVAL 1 DAY)) AS L24,\r\n\t\t\tDAY(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','24'),'%Y-%m-%d'),INTERVAL 1 DAY)) AS L25,\r\n\t\t\tDAY(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','25'),'%Y-%m-%d'),INTERVAL 1 DAY)) AS L26,\r\n\t\t\tDAY(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','26'),'%Y-%m-%d'),INTERVAL 1 DAY)) AS L27,\r\n\t\t\tDAY(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','27'),'%Y-%m-%d'),INTERVAL 1 DAY)) AS L28,\r\n\t\t\tDAY(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','28'),'%Y-%m-%d'),INTERVAL 1 DAY)) AS L29,\r\n\t\t\tDAY(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','29'),'%Y-%m-%d'),INTERVAL 1 DAY)) AS L30,\r\n\t\t\tDAY(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','30'),'%Y-%m-%d'),INTERVAL 1 DAY)) AS L31\r\n\t\tFROM ld_users a\r\n\t\tLEFT JOIN (\r\nselect sum(nums)as nums ,smcreatorid,type,adddate from \t(\r\nselect nums ,smcreatorid,type,adddate from \t\r\n\t\t(SELECT \r\n\t\t\t\tcount(contactrecordID) as nums,\r\n\t\t\t\tsmcreatorid,\r\n\t\t\t\t'跟进记录' as type,\r\n\t\t\t\tDATE_FORMAT(createdtime,'%Y-%m-%d') AS adddate\r\n\t\t\tFROM ld_contactrecords \r\n\t\t\tINNER JOIN (\r\n\t\t\tSELECT DISTINCT\r\n\t\t\t\tuserid \r\n\t\t\tFROM (\r\n\t\t\t\tSELECT \r\n\t\t\t\t\tld_users.id AS userid \r\n\t\t\t\tFROM ld_users\r\n\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='ContactRecords' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT \r\n\t\t\t\t\tviewid AS userid \r\n\t\t\t\tFROM ld_scoperhigher\r\n\t\t\t\tWHERE userid='[uuid]' AND modulename='ContactRecords' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename='ContactRecords')\t\t\t\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT DISTINCT \r\n\t\t\t\t\tld_users2group.userid AS userid \r\n\t\t\t\tFROM ld_scoperhigher \r\n\t\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\t\tAND ld_scoperhigher.modulename='ContactRecords'\r\n\t\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='ContactRecords' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\t\tUNION \r\n\t\t\t\tSELECT \r\n\t\t\t\t\tid AS userid \r\n\t\t\t\tFROM ld_users  \r\n\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT '[uuid]') AS vw_users\r\n\t\t) AS tmp_users ON tmp_users.userid=ld_contactrecords.smcreatorid\r\n\t\t\tWHERE deleted=0 and YEAR(createdtime)='{nian}'\r\n\t\t\t\tAND MONTH(createdtime)='{yue}'\r\n\t\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{onlyapproved}'='true' THEN ld_contactrecords.approvestatus='已批准'\r\n\t\t\t\tELSE 1=1\r\n\t\t\tEND)\r\n\t\t\tAND (\r\n\t\t\t CASE\r\n\t\t\t\tWHEN '{weidu}'='' THEN 1=1\r\n\t\t\t\tWHEN '{weidu}'='跟进记录' THEN 1=1\r\n\t\t\t\tWHEN '{weidu}'='全部' THEN 1=1\r\n\t\t\t\tELSE 1=2\r\n\t\t\t END) \r\n\t\t\tGROUP BY smcreatorid,DAY(createdtime)\r\n\r\n\r\n)  a   union all(\r\n\r\n\r\nSELECT \r\n\tcount(ticketid) as nums,\r\n\tsmcreatorid,\r\n\t'客户服务单' as type,\r\n\tDATE_FORMAT(createdtime,'%Y-%m-%d') AS adddate\r\nFROM ld_troubletickets \r\nINNER JOIN (\r\n\t\t\tSELECT DISTINCT\r\n\t\t\t\tuserid \r\n\t\t\tFROM (\r\n\t\t\t\tSELECT \r\n\t\t\t\t\tld_users.id AS userid \r\n\t\t\t\tFROM ld_users\r\n\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='HelpDesk' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT \r\n\t\t\t\t\tviewid AS userid \r\n\t\t\t\tFROM ld_scoperhigher\r\n\t\t\t\tWHERE userid='[uuid]' AND modulename='HelpDesk' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename='HelpDesk')\t\t\t\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT DISTINCT \r\n\t\t\t\t\tld_users2group.userid AS userid \r\n\t\t\t\tFROM ld_scoperhigher \r\n\t\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\t\tAND ld_scoperhigher.modulename='HelpDesk'\r\n\t\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='HelpDesk' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\t\tUNION \r\n\t\t\t\tSELECT \r\n\t\t\t\t\tid AS userid \r\n\t\t\t\tFROM ld_users  \r\n\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT '[uuid]') AS vw_users\r\n\t\t) AS tmp_users ON tmp_users.userid=ld_troubletickets.smcreatorid\r\nWHERE deleted=0 and YEAR(createdtime)='{nian}'\r\nAND MONTH(createdtime)='{yue}'\r\nAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{onlyapproved}'='true' THEN ld_troubletickets.approvestatus='已批准'\r\n\t\t\t\tELSE 1=1\r\n\t\t\tEND)\r\nAND (\r\n   CASE\r\n    WHEN '{weidu}'='' THEN 1=1\r\n    WHEN '{weidu}'='全部' THEN 1=1\r\n    WHEN '{weidu}'='客户服务单' THEN 1=1\r\n    ELSE 1=2\r\n   END) \r\nGROUP BY smcreatorid,DAY(createdtime)\r\n)\r\n)a \r\ngroup by a.smcreatorid,a.adddate\r\n\t\t) b ON a.id=b.smcreatorid\r\n\t\t\r\n\t\tINNER JOIN (\r\n\t\t\tSELECT\r\n\t\t\t\ta.userid\r\n\t\t\tFROM ld_users2group a\r\n\t\t\tLEFT JOIN ld_groups b ON a.groupid=b.groupid\r\n\t\t\tWHERE (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{bumen}'='' THEN 1=1\r\n\t\t\t\t\tELSE\tFIND_IN_SET(a.groupid,'{bumen}')\r\n\t\t\t\tEND)\r\n\t\t\tGROUP BY a.userid\r\n\t\t) tmp_groups ON tmp_groups.userid=a.id\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.`status`='Active'\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{userid}'='' THEN 1=1\r\n\t\t\t\t\tELSE FIND_IN_SET(a.id,'{userid}')\r\n\t\t\t\tEND)\r\n\t\t) workreport\r\n\tGROUP BY id\r\n) tmp\r\n\r\nORDER BY CONVERT(last_name USING GBK)"
      }
    },
