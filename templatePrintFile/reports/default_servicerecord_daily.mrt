        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\tlast_name,\r\n\tD1,\r\n\tD2,\r\n\tD3,\r\n\tD4,\r\n\tD5,\r\n\tD6,\r\nD7,\r\n\tD8,\r\n\tD9,\r\n\tD10,\r\nD11,\r\n\t D12,\r\n\tD13,\r\n\tD14,\r\n\tD15,\r\n\tD16,\r\n\tD17,\r\n\tD18,\r\n\tD19,\r\n\r\n D20,\r\n\r\n\tD21,\r\n\tD22,\r\n\t D23,\r\n\t D24,\r\n\t D25,\r\n\t D26,\r\n D27,\r\n\tD28,\r\n\t CASE\r\n\t\tWHEN MONTH(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','28'),'%Y-%m-%d'),INTERVAL 1 DAY))='{yue}' THEN D29\r\n\t\tELSE ''\r\n\tEND AS D29,\r\n\tCASE\r\n\t\tWHEN MONTH(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','29'),'%Y-%m-%d'),INTERVAL 1 DAY))='{yue}' THEN D30\r\n\t\tELSE ''\r\n\tEND AS D30,\r\n\tCASE\r\n\t\tWHEN MONTH(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','30'),'%Y-%m-%d'),INTERVAL 1 DAY))='{yue}' THEN D31\r\n\t\tELSE ''\r\n\tEND AS D31,\r\n\r\n\tL1,\r\n\tL2,\r\n\tL3,\r\n\tL4,\r\n\tL5,\r\n\tL6,\r\n\tL7,\r\n\tL8,\r\n\tL9,\r\n\tL10,\r\n\tL11,\r\n\tL12,\r\n\tL13,\r\n\tL14,\r\n\tL15,\r\n\tL16,\r\n\tL17,\r\n\tL18,\r\n\tL19,\r\n\tL20,\r\n\tL21,\r\n\tL22,\r\n\tL23,\r\n\tL24,\r\n\tL25,\r\n\tL26,\r\n\tL27,\r\n\tL28,\r\n\tCASE\r\n\t\tWHEN MONTH(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','28'),'%Y-%m-%d'),INTERVAL 1 DAY))='{yue}' THEN L29\r\n\t\tELSE ''\r\n\tEND AS L29,\r\n\tCASE\r\n\t\tWHEN MONTH(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','29'),'%Y-%m-%d'),INTERVAL 1 DAY))='{yue}' THEN L30\r\n\t\tELSE ''\r\n\tEND AS L30,\r\n\tCASE\r\n\t\tWHEN MONTH(DATE_ADD(DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','30'),'%Y-%m-%d'),INTERVAL 1 DAY))='{yue}' THEN L31\r\n\t\tELSE ''\r\n\tEND AS L31,\r\n\r\n\tW1,\r\n\tW2,\r\n\tW3,\r\n\tW4,\r\n\tW5,\r\n\tW6,\r\n\tW7,\r\n\tW8,\r\n\tW9,\r\n\tW10,\r\n\tW11,\r\n\tW12,\r\n\tW13,\r\n\tW14,\r\n\tW15,\r\n\tW16,\r\n\tW17,\r\n\tW18,\r\n\tW19,\r\n\tW20,\r\n\tW21,\r\n\tW22,\r\n\tW23,\r\n\tW24,\r\n\tW25,\r\n\tW26,\r\n\tW27,\r\n\tW28,\r\n\tW29,\r\n\tW30,\r\n\tW31,\r\n\tIF(D1>=1 AND w1<5,1,0)\r\n\t+IF(D2>=1 AND w2<5,1,0)\r\n\t+IF(D3>=1 AND w3<5,1,0)\r\n\t+IF(D4>=1 AND w4<5,1,0)\r\n\t+IF(D5>=1 AND w5<5,1,0)\r\n\t+IF(D6>=1 AND w6<5,1,0)\r\n\t+IF(D7>=1 AND w7<5,1,0)\r\n\t+IF(D8>=1 AND w8<5,1,0)\r\n\t+IF(D9>=1 AND w9<5,1,0)\r\n\t+IF(D10>=1 AND w10<5,1,0)\r\n\t\r\n\t+IF(D11>=1 AND w11<5,1,0)\r\n\t+IF(D12>=1 AND w12<5,1,0)\r\n\t+IF(D13>=1 AND w13<5,1,0)\r\n\t+IF(D14>=1 AND w14<5,1,0)\r\n\t+IF(D15>=1 AND w15<5,1,0)\r\n\t+IF(D16>=1 AND w16<5,1,0)\r\n\t+IF(D17>=1 AND w17<5,1,0)\r\n\t+IF(D18>=1 AND w18<5,1,0)\r\n\t+IF(D19>=1 AND w19<5,1,0)\r\n\t+IF(D20>=1 AND w20<5,1,0)\r\n\t\r\n\t+IF(D21>=1 AND w21<5,1,0)\r\n\t+IF(D22>=1 AND w22<5,1,0)\r\n\t+IF(D23>=1 AND w23<5,1,0)\r\n\t+IF(D24>=1 AND w24<5,1,0)\r\n\t+IF(D25>=1 AND w25<5,1,0)\r\n\t+IF(D26>=1 AND w26<5,1,0)\r\n\t+IF(D27>=1 AND w27<5,1,0)\r\n\t+IF(D28>=1 AND w28<5,1,0)\r\n\t+IF(D29>=1 AND w29<5,1,0)\r\n\t+IF(D30>=1 AND w30<5,1,0)\r\n\t\r\n\t+IF(D31>=1 AND w31<5,1,0) AS sub_days,\r\n\tCASE\r\n\t\tWHEN DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','1'),'%Y-%m-%d')>DATE_FORMAT(CONCAT(YEAR(CURDATE()),'-',MONTH(CURDATE()),'-','1'),'%Y-%m-%d') THEN 0\r\n\t\tWHEN DATE_FORMAT(CONCAT('{nian}','-','{yue}','-','1'),'%Y-%m-%d')=DATE_FORMAT(CONCAT(YEAR(CURDATE()),'-',MONTH(CURDATE()),'-','1'),'%Y-%m-%d') THEN \r\n\t\t\tIF(D1<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L1))<5 AND L1<=DAY(CURDATE()),1,0)\r\n\t\t\t+IF(D2<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L2))<5 AND L2<=DAY(CURDATE()),1,0)\r\n\t\t\t+IF(D3<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L3))<5 AND L3<=DAY(CURDATE()),1,0)\r\n\t\t\t+IF(D4<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L4))<5 AND L4<=DAY(CURDATE()),1,0)\r\n\t\t\t+IF(D5<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L5))<5 AND L5<=DAY(CURDATE()),1,0)\r\n\t\t\t\r\n\t\t\t+IF(D6<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L6))<5 AND L6<=DAY(CURDATE()),1,0)\r\n\t\t\t+IF(D7<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L7))<5 AND L7<=DAY(CURDATE()),1,0)\r\n\t\t\t+IF(D8<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L8))<5 AND L8<=DAY(CURDATE()),1,0)\r\n\t\t\t+IF(D9<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L9))<5 AND L9<=DAY(CURDATE()),1,0)\r\n\t\t\t+IF(D10<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L10))<5 AND L10<=DAY(CURDATE()),1,0)\r\n\t\t\t\r\n\t\t\t+IF(D11<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L11))<5 AND L11<=DAY(CURDATE()),1,0)\r\n\t\t\t+IF(D12<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L12))<5 AND L12<=DAY(CURDATE()),1,0)\r\n\t\t\t+IF(D13<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L13))<5 AND L13<=DAY(CURDATE()),1,0)\r\n\t\t\t+IF(D14<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L14))<5 AND L14<=DAY(CURDATE()),1,0)\r\n\t\t\t+IF(D15<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L15))<5 AND L15<=DAY(CURDATE()),1,0)\r\n\t\t\t\r\n\t\t\t+IF(D16<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L16))<5 AND L16<=DAY(CURDATE()),1,0)\r\n\t\t\t+IF(D17<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L17))<5 AND L17<=DAY(CURDATE()),1,0)\r\n\t\t\t+IF(D18<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L18))<5 AND L18<=DAY(CURDATE()),1,0)\r\n\t\t\t+IF(D19<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L19))<5 AND L19<=DAY(CURDATE()),1,0)\r\n\t\t\t+IF(D20<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L20))<5 AND L20<=DAY(CURDATE()),1,0)\r\n\t\t\t\r\n\t\t\t+IF(D21<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L21))<5 AND L21<=DAY(CURDATE()),1,0)\r\n\t\t\t+IF(D22<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L22))<5 AND L22<=DAY(CURDATE()),1,0)\r\n\t\t\t+IF(D23<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L23))<5 AND L23<=DAY(CURDATE()),1,0)\r\n\t\t\t+IF(D24<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L24))<5 AND L24<=DAY(CURDATE()),1,0)\r\n\t\t\t+IF(D25<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L25))<5 AND L25<=DAY(CURDATE()),1,0)\r\n\t\t\t\r\n\t\t\t+IF(D26<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L26))<5 AND L26<=DAY(CURDATE()),1,0)\r\n\t\t\t+IF(D27<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L27))<5 AND L27<=DAY(CURDATE()),1,0)\r\n\t\t\t+IF(D28<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L28))<5 AND L28<=DAY(CURDATE()),1,0)\r\n\t\t\t+IF(D29<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L29))<5 AND L29<=DAY(CURDATE()),1,0)\r\n\t\t\t+IF(D30<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L30))<5 AND L30<=DAY(CURDATE()),1,0)\r\n\t\t\t\r\n\t\t\t+IF(D31<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L31))<5 AND L31<=DAY(CURDATE()),1,0)\r\n\t\tELSE\r\n\t\t\tIF(D1<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L1))<5,1,0)\r\n\t\t\t+IF(D2<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L2))<5,1,0)\r\n\t\t\t+IF(D3<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L3))<5,1,0)\r\n\t\t\t+IF(D4<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L4))<5,1,0)\r\n\t\t\t+IF(D5<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L5))<5,1,0)\r\n\t\t\t\r\n\t\t\t+IF(D6<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L6))<5,1,0)\r\n\t\t\t+IF(D7<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L7))<5,1,0)\r\n\t\t\t+IF(D8<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L8))<5,1,0)\r\n\t\t\t+IF(D9<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L9))<5,1,0)\r\n\t\t\t+IF(D10<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L10))<5,1,0)\r\n\t\t\t\r\n\t\t\t+IF(D11<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L11))<5,1,0)\r\n\t\t\t+IF(D12<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L12))<5,1,0)\r\n\t\t\t+IF(D13<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L13))<5,1,0)\r\n\t\t\t+IF(D14<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L14))<5,1,0)\r\n\t\t\t+IF(D15<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L15))<5,1,0)\r\n\t\t\t\r\n\t\t\t+IF(D16<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L16))<5,1,0)\r\n\t\t\t+IF(D17<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L17))<5,1,0)\r\n\t\t\t+IF(D18<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L18))<5,1,0)\r\n\t\t\t+IF(D19<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L19))<5,1,0)\r\n\t\t\t+IF(D20<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L20))<5,1,0)\r\n\t\t\t\r\n\t\t\t+IF(D21<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L21))<5,1,0)\r\n\t\t\t+IF(D22<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L22))<5,1,0)\r\n\t\t\t+IF(D23<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L23))<5,1,0)\r\n\t\t\t+IF(D24<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L24))<5,1,0)\r\n\t\t\t+IF(D25<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L25))<5,1,0)\r\n\t\t\t\r\n\t\t\t+IF(D26<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L26))<5,1,0)\r\n\t\t\t+IF(D27<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L27))<5,1,0)\r\n\t\t\t+IF(D28<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L28))<5,1,0)\r\n\t\t\t+IF(D29<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L29))<5 AND L29>1,1,0)\r\n\t\t\t+IF(D30<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L30))<5 AND L30>1,1,0)\r\n\t\t\t\r\n\t\t\t+IF(D31<1 AND WEEKDAY(CONCAT('{nian}','-','{yue}','-',L31))<5 AND L31>1,1,0)\r\n\tEND AS no_days\r\nFROM (\r\n\tSELECT\r\n\t\tid,\r\n\t\tlast_name,\r\n\t\tMAX(D1) AS D1,\r\n\t\tMAX(D2) AS D2,\r\n\t\tMAX(D3) AS D3,\r\n\t\tMAX(D4) AS D4,\r\n\t\tMAX(D5) AS D5,\r\n\t\tMAX(D6) AS D6,\r\n\t\tMAX(D7) AS D7,\r\n\t\tMAX(D8) AS D8,\r\n\t\tMAX(D9) AS D9,\r\n\t\tMAX(D10) AS D10,\r\n\t\tMAX(D11) AS D11,\r\n\t\tMAX(D12) AS D12,\r\n\t\tMAX(D13) AS D13,\r\n\t\tMAX(D14) AS D14,\r\n\t\tMAX(D15) AS D15,\r\n\t\tMAX(D16) AS D16,\r\n\t\tMAX(D17) AS D17,\r\n\t\tMAX(D18) AS D18,\r\n\t\tMAX(D19) AS D19,\r\n\t\tMAX(D20) AS D20,\r\n\t\tMAX(D21) AS D21,\r\n\t\tMAX(D22) AS D22,\r\n\t\tMAX(D23) AS D23,\r\n\t\tMAX(D24) AS D24,\r\n\t\tMAX(D25) AS D25,\r\n\t\tMAX(D26) AS D26,\r\n\t\tMAX(D27) AS D27,\r\n\t\tMAX(D28) AS D28,\r\n\t\tMAX(D29) AS D29,\r\n\t\tMAX(D30) AS D30,\r\n\t\tMAX(D31) AS D31,\r\n\r\n\t\tW1,\r\n\t\tW2,\r\n\t\tW3,\r\n\t\tW4,\r\n\t\tW5,\r\n\t\tW6,\r\n\t\tW7,\r\n\t\tW8,\r\n\t\tW9,\r\n\t\tW10,\r\n\t\tW11,\r\n\t\tW12,\r\n\t\tW13,\r\n\t\tW14,\r\n\t\tW15,\r\n\t\tW16,\r\n\t\tW17,\r\n\t\tW18,\r\n\t\tW19,\r\n\t\tW20,\r\n\t\tW21,\r\n\t\tW22,\r\n\t\tW23,\r\n\t\tW24,\r\n\t\tW25,\r\n\t\tW26,\r\n\t\tW27,\r\n\t\tW28,\r\n\t\tW29,\r\n\t\tW30,\r\n\t\tW31,\r\n\r\n\t\tL1,\r\n\t\tL2,\r\n\t\tL3,\r\n\t\tL4,\r\n\t\tL5,\r\n\t\tL6,\r\n\