        "NameInSource": "ldcrm ",
        "SqlCommand": "SELECT\r\nlistvalue\r\nfrom ld_picklist_set \r\nleft join ld_picklist_values on ld_picklist_set.listid=ld_picklist_values.listid\r\nwhere listname='cf_4708';"
      }
