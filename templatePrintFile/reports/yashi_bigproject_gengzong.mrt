        "NameInSource": "ldcrm ",
        "Type": "Table",
        "SqlCommand": "select* from(\r\nSELECT\r\n\t\t1 AS list_key,\r\n\t\t'销售区域' AS list_value,\r\n\t\tf.groupid AS list_key2,\r\n\t\tf.groupname AS list_value2\r\n\tFROM ld_groups f \r\n\tWHERE f.parentgroup like '1::2::7::%' and depth=3\r\nunion all \r\nSELECT\r\n\t\t2 AS list_key,\r\n\t\t'销售分支' AS list_value,\r\n\t\tf.groupid AS list_key2,\r\n\t\tf.groupname AS list_value2\r\n\tFROM ld_groups f \r\n\tWHERE f.parentgroup like '1::2::7::%' and depth=4\r\nunion all \r\nSELECT\r\n\t\t3 AS list_key,\r\n\t\t'销售经理' AS list_value,\r\n\t\ta.id AS list_key2,\r\n\t\ta.last_name AS list_value2\r\n\tFROM ld_users a\r\n\tINNER JOIN ld_users2group e ON e.userid=a.id\r\n\tINNER JOIN ld_groups f ON f.groupid=e.groupid\r\n\tWHERE a.deleted=0\t\r\n\tand FIND_IN_SET(f.groupname,(SELECT \r\n\t\t\tgroup_concat(REPLACE(REPLACE(REPLACE(a.targetvalues,'\"',''),'[',''),']','')) \r\n\t\tFROM ld_picklist_dependency a\r\n\t\tLEFT JOIN ld_picklist_values c ON c.listid=107 AND c.listvalue=a.sourcevalue\r\n\t\tWHERE a.tabid=6\r\n\t\t\tAND a.sourcefield='cf_4402'\r\n\t\t\tAND a.targetfield='cf_4404'))\r\n\tand f.parentgroup like '1::2::7::%'\r\n\tgroup by a.id\r\n)a \r\nORDER BY a.list_key\r\n\r\n\r\n\r\n\r\n\t\t "
      },
