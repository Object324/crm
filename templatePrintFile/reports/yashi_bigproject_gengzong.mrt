        "NameInSource": "ldcrm ",
        "Type": "Table",
        "SqlCommand": "SELECT \r\ncf_4412 as SalesArea, \r\ncf_4413 as SalesBranch, \r\npotential_no, \r\npotentialname, \r\ncf_4741 as Designer, \r\nREPLACE(cf_4708,'|##|',',') as Productype,\r\ncf_4432 as jianchen,\r\nld_potential.accountid,\r\naccountname,\r\nld_potential.smownerid,\r\nu.last_name,\r\ncf_4449 as Stage,\r\nsales_stage,\r\nclosingdate,\r\nld_potential.nolinkdays,\r\npdetail.quantity,\r\npdetail.producttypes,\r\n(ld_potential.total/10000) as tax_amount,\r\nifnull(record.count_record,0)as count_record\r\nfrom ld_potential \r\nLEFT JOIN ld_potentialscf ON ld_potential.potentialid=ld_potentialscf.potentialid\r\nLEFT JOIN ld_account ON ld_account.accountid=ld_potential.accountid\r\nLEFT JOIN ld_users u ON u.id=ld_potential.smownerid\r\nleft join ld_users2group u2g on u2g.userid=u.id\r\nleft join ld_groups g on g.groupid=u2g.groupid\r\nleft join ld_groups g2 on g2.groupid=g.parentid\r\nINNER JOIN (\r\n\t\tSELECT DISTINCT\r\n\t\t\tuserid \r\n\t\tFROM (\r\n\t\t\tSELECT \r\n\t\t\t\tld_users.id AS userid \r\n\t\t\tFROM ld_users\r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Potentials' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\tUNION\r\n\t\t\tSELECT \r\n\t\t\t\tviewid AS userid \r\n\t\t\tFROM ld_scoperhigher\r\n\t\t\tWHERE userid='[uuid]' AND modulename ='Potentials' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename ='Potentials')\t\t\t\r\n\t\t\tUNION\r\n\t\t\tSELECT DISTINCT \r\n\t\t\t\tld_users2group.userid AS userid \r\n\t\t\tFROM ld_scoperhigher \r\n\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\tAND ld_scoperhigher.modulename ='Potentials'\r\n\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Potentials' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\tUNION \r\n\t\t\tSELECT \r\n\t\t\t\tid AS userid \r\n\t\t\tFROM ld_users  \r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\tUNION\r\n\t\t\tSELECT '[uuid]') AS vw_users\r\n\t) AS tmp_users ON tmp_users.userid=u.id \r\nleft join (\r\n\tselect \r\n\tGROUP_CONCAT(ifnull(ld_productcf.cf_4835,'')) as producttypes,\r\n\tsum(ifnull(ld_potentialsdetail.quantity,0)) as quantity,ld_potential.potentialid\r\n\tfrom ld_potentialsdetail\r\n\tleft join ld_productcf on ld_productcf.productid=ld_potentialsdetail.productid\r\n\tleft join ld_potential on ld_potential.potentialid=ld_potentialsdetail.id\r\n\twhere ld_potential.deleted=0\r\n\tgroup by ld_potentialsdetail.id\r\n)pdetail on pdetail.potentialid=ld_potential.potentialid\r\nleft join (\r\n\tselect \r\n\t\tCOUNT(DISTINCT contactrecordid)as count_record,\r\n\t\tpotentialid\r\n\tfrom ld_contactrecords\r\n\twhere deleted=0 and potentialid>0\r\n\tgroup by potentialid\r\n)record on record.potentialid=ld_potential.potentialid \r\nwhere ld_potential.deleted=0\r\nand  g.parentgroup like '1::2::7::%' and g2.parentgroup like '1::2::7::%'\r\n\tand FIND_IN_SET(g.groupname,(SELECT \r\n\t\t\tgroup_concat(REPLACE(REPLACE(REPLACE(a.targetvalues,'\"',''),'[',''),']',''),',',a.sourcevalue) \r\n\t\tFROM ld_picklist_dependency a\r\n\t\tLEFT JOIN ld_picklist_values c ON c.listid=107 AND c.listvalue=a.sourcevalue\r\n\t\tWHERE a.tabid=6\r\n\t\t\tAND a.sourcefield='cf_4402'\r\n\t\t\tAND a.targetfield='cf_4404'))\r\n\tand FIND_IN_SET(u.userlevel,'销售经理,分公司经理,分公司副经理,办事处经理,大区经理,大区副经理')\r\n\tand (\r\n\t\tcase when '{weidu}'=3 and '{ziweidu}'!='' then FIND_IN_SET(u.id ,'{ziweidu}')\r\n\t\twhen '{weidu}'=3 and '{ziweidu}'='' then 1=1\r\n\t\twhen '{weidu}'=2 and '{ziweidu}'!=''  then FIND_IN_SET( g.groupid ,'{ziweidu}') and g.depth=4\r\n\t\twhen '{weidu}'=2 and '{ziweidu}'=''  then g.depth=4\r\n\t\twhen '{weidu}'=1 and '{ziweidu}'!=''  then FIND_IN_SET( g.parentid ,'{ziweidu}') \r\n\t\twhen '{weidu}'=1 and '{ziweidu}'=''  then 1=1\r\n\t\telse 1=1\r\n\t\tend \r\n\t) \r\nand (case when '{amount_start}'=0 then 1=1 else ld_potential.total>='{amount_start}'end )\r\nand (case when '{amount_end}'=0 then 1=1 else ld_potential.total<'{amount_end}'end )\r\nand ld_potential.closingdate >= DATE_FORMAT(CONCAT('{start_date}'),'%Y-%m-%d')\r\nand ld_potential.closingdate <= DATE_FORMAT(CONCAT('{end_date}'),'%Y-%m-%d')\r\nand ld_potential.sales_stage!='已丢单' and ld_potential.sales_stage!='已发货'\r\nand (case when '{product_type}'!='' then cf_4708  REGEXP REPLACE('[[:<:]]{product_type}[[:>:]]',',','|') else 1=1 end)"
      },
      "3": {
        "Ident": "StiMySqlSource",
        "Name": "Data2",
        "Alias": "Data2",
        "Key": "6d48e86c34704ca4ab76801925002353",
        "Columns": {
          "0": {
            "Name": "descrip",
            "Index": -1,
            "NameInSource": "descrip",
            "Alias": "descrip",
            "Type": "System.String"
          },
          "1": {
            "Name": "ordernum",
            "Index": -1,
            "NameInSource": "ordernum",
            "Alias": "ordernum",
            "Type": "System.Int32"
          },
          "2": {
            "Name": "rate",
            "Index": -1,
            "NameInSource": "rate",
            "Alias": "rate",
            "Type": "System.Decimal"
          },
          "3": {
            "Name": "sales_stage",
            "Index": -1,
            "NameInSource": "sales_stage",
            "Alias": "sales_stage",
            "Type": "System.String"
          },
          "4": {
            "Name": "total",
            "Index": -1,
            "NameInSource": "total",
            "Alias": "total",
            "Type": "System.Decimal"
          }
        },
        "NameInSource": "ldcrm ",
        "Type": "Table",
        "SqlCommand": "\r\nselect \r\n\ta.ordernum,\r\n\ta.descrip,\r\n\ta .listvalue as sales_stage,\r\n\tb.total/10000 as total,\r\n\t(case when c.total=0 then 0 else (b.total/c.total) end )as rate\r\nfrom (\r\n\tselect \r\n\t\tlistvalue,'a'as totalkey,\r\n\t\t(\r\n\t\t\tcase when listvalue='100%热度' then 1\r\n\t\t\twhen listvalue='90%热度' then 2\r\n\t\t\twhen listvalue='80%热度' then 3\r\n\t\t\twhen listvalue='70%热度' then 4\r\n\t\t\twhen listvalue='60%热度' then 5\r\n\t\t\twhen listvalue='50%热度' then 6\r\n\t\t\twhen listvalue='40%热度' then 7\r\n\t\t\twhen listvalue='30%热度' then 8\r\n\t\t\twhen listvalue='20%热度' then 9\r\n\t\t\tend\r\n\t\t)as ordernum,\r\n\t\t(\r\n\t\t\tcase when listvalue='100%热度' then '已签订合同并肯定能付定金'\r\n\t\t\twhen listvalue='90%热度' then '已经签订合同，未付定金'\r\n\t\t\twhen listvalue='80%热度' then '已经中标，进入商务技术谈判阶段'\r\n\t\t\twhen listvalue='70%热度' then '预中标或甲方决策层已确认选用雅士产品'\r\n\t\t\twhen listvalue='60%热度' then '进入筛选后的三家中'\r\n\t\t\twhen listvalue='50%热度' then '按照雅士有利机型设计，已深入跟踪，有资格投标入围'\r\n\t\t\twhen listvalue='40%热度' then '明确了解设计方案，已做初步方案、报价'\r\n\t\t\twhen listvalue='30%热度' then '了解项目的具体情况，已经初步接触甲方决策层，已初步设备选型'\r\n\t\t\twhen listvalue='20%热度' then '只了解到项目信息，具体项目情况不是很了解'\r\n\t\t\tend \r\n\t\t)as descrip\r\n\tfrom ld_picklist_set left join ld_picklist_values on  ld_picklist_set.listid=ld_picklist_values.listid\r\n\twhere ld_picklist_set.listname='sales_stage'\r\n\tand listvalue!='已丢单' and listvalue!='已发货'\r\n)a left join (\r\n\tselect \r\n\t\tsum(total)as total,\r\n\t\tsales_stage\r\n\tfrom ld_potential \r\n\tLEFT JOIN ld_potentialscf ON ld_potential.potentialid=ld_potentialscf.potentialid\r\n\tLEFT JOIN ld_users u ON u.id=ld_potential.smownerid\r\n\tleft join ld_users2group u2g on u2g.userid=u.id\r\n\tleft join ld_groups g on g.groupid=u2g.groupid\r\n\tleft join ld_groups g2 on g2.groupid=g.parentid\r\n\tINNER JOIN (\r\n\t\tSELECT DISTINCT\r\n\t\t\tuserid \r\n\t\tFROM (\r\n\t\t\tSELECT \r\n\t\t\t\tld_users.id AS userid \r\n\t\t\tFROM ld_users\r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Potentials' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\tUNION\r\n\t\t\tSELECT \r\n\t\t\t\tviewid AS userid \r\n\t\t\tFROM ld_scoperhigher\r\n\t\t\tWHERE userid='[uuid]' AND modulename ='Potentials' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename ='Potentials')\t\t\t\r\n\t\t\tUNION\r\n\t\t\tSELECT DISTINCT \r\n\t\t\t\tld_users2group.userid AS userid \r\n\t\t\tFROM ld_scoperhigher \r\n\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\tAND ld_scoperhigher.modulename ='Potentials'\r\n\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Potentials' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\tUNION \r\n\t\t\tSELECT \r\n\t\t\t\tid AS userid \r\n\t\t\tFROM ld_users  \r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\tUNION\r\n\t\t\tSELECT '[uuid]') AS vw_users\r\n\t) AS tmp_users ON tmp_users.userid=u.id \r\n\twhere ld_potential.deleted=0\r\n\tand  g.parentgroup like '1::2::7::%' and g2.parentgroup like '1::2::7::%'\r\n\tand FIND_IN_SET(g.groupname,(SELECT \r\n\t\t\tgroup_concat(REPLACE(REPLACE(REPLACE(a.targetvalues,'\"',''),'[',''),']',''),',',a.sourcevalue) \r\n\t\tFROM ld_picklist_dependency a\r\n\t\tLEFT JOIN ld_picklist_values c ON c.listid=107 AND c.listvalue=a.sourcevalue\r\n\t\tWHERE a.tabid=6\r\n\t\t\tAND a.sourcefield='cf_4402'\r\n\t\t\tAND a.targetfield='cf_4404'))\r\n\tand FIND_IN_SET(u.userlevel,'销售经理,分公司经理,分公司副经理,办事处经理,大区经理,大区副经理')\r\n\tand (\r\n\t\tcase when '{weidu}'=3 and '{ziweidu}'!='' then FIND_IN_SET(u.id ,'{ziweidu}')\r\n\t\twhen '{weidu}'=3 and '{ziweidu}'='' then 1=1\r\n\t\twhen '{weidu}'=2 and '{ziweidu}'!=''  then FIND_IN_SET( g.groupid ,'{ziweidu}') and g.depth=4\r\n\t\twhen '{weidu}'=2 and '{ziweidu}'=''  then g.depth=4\r\n\t\twhen '{weidu}'=1 and '{ziweidu}'!=''  then FIND_IN_SET( g.parentid ,'{ziweidu}') \r\n\t\twhen '{weidu}'=1 and '{ziweidu}'=''  then 1=1\r\n\t\telse 1=1\r\n\t\tend \r\n\t) \r\nand (case when '{amount_start}'=0 then 1=1 else ld_potential.total>='{amount_start}'end )\r\nand (case when '{amount_end}'=0 then 1=1 else ld_potential.total<'{amount_end}'end )\r\nand ld_potential.closingdate >= DATE_FORMAT(CONCAT('{start_date}'),'%Y-%m-%d')\r\nand ld_potential.closingdate <= DATE_FORMAT(CONCAT('{end_date}'),'%Y-%m-%d')\r\nand (case when '{product_type}'!='' then cf_4708  REGEXP REPLACE('[[:<:]]{product_type}[[:>:]]',',','|') else 1=1 end)\r\n\tgroup by sales_stage\r\n)b on a.listvalue=b.sales_stage\r\nleft join (\r\n\tselect\r\n\tsum(total)as total ,'a'as totalkey\r\n\tfrom ld_potential \r\n\tLEFT JOIN ld_potentialscf ON ld_potential.potentialid=ld_potentialscf.potentialid\r\n\tLEFT JOIN ld_users u ON u.id=ld_potential.smownerid\r\n\tleft join ld_users2group u2g on u2g.userid=u.id\r\n\tleft join ld_groups g on g.groupid=u2g.groupid\r\n\tleft join ld_groups g2 on g2.groupid=g.parentid\r\n\tINNER JOIN (\r\n\t\tSELECT DISTINCT\r\n\t\t\tuserid \r\n\t\tFROM (\r\n\t\t\tSELECT \r\n\t\t\t\tld_users.id AS userid \r\n\t\t\tFROM ld_users\r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Potentials' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\tUNION\r\n\t\t\tSELECT \r\n\t\t\t\tviewid AS userid \r\n\t\t\tFROM ld_scoperhigher\r\n\t\t\tWHERE userid='[uuid]' AND modulename ='Potentials' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename ='Potentials')\t\t\t\r\n\t\t\tUNION\r\n\t\t\tSELECT DISTINCT \r\n\t\t\t\tld_users2group.userid AS userid \r\n\t\t\tFROM ld_scoperhigher \r\n\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\tAND ld_scoperhigher.modulename ='Potentials'\r\n\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Potentials' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\tUNION \r\n\t\t\tSELECT \r\n\t\t\t\tid AS userid \r\n\t\t\tFROM ld_users  \r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\tUNION\r\n\t\t\tSELECT '[uuid]') AS vw_users\r\n\t) AS tmp_users ON tmp_users.userid=u.id \r\n\twhere ld_potential.deleted=0\r\n\tand  g.parentgroup like '1::2::7::%' and g2.parentgroup like '1::2::7::%'\r\n\tand FIND_IN_SET(g.groupname,(SELECT \r\n\t\t\tgroup_concat(REPLACE(REPLACE(REPLACE(a.targetvalues,'\"',''),'[',''),']',''),',',a.sourcevalue) \r\n\t\tFROM ld_picklist_dependency a\r\n\t\tLEFT JOIN ld_picklist_values c ON c.listid=107 AND c.listvalue=a.sourcevalue\r\n\t\tWHERE a.tabid=6\r\n\t\t\tAND a.sourcefield='cf_4402'\r\n\t\t\tAND a.targetfield='cf_4404'))\r\n\tand FIND_IN_SET(u.userlevel,'销售经理,分公司经理,分公司副经理,办事处经理,大区经理,大区副经理')\r\n\tand (\r\n\t\tcase when '{weidu}'=3 and '{ziweidu}'!='' then FIND_IN_SET(u.id ,'{ziweidu}')\r\n\t\twhen '{weidu}'=3 and '{ziweidu}'='' then 1=1\r\n\t\twhen '{weidu}'=2 and '{ziweidu}'!=''  then FIND_IN_SET( g.groupid ,'{ziweidu}') and g.depth=4\r\n\t\twhen '{weidu}'=2 and '{ziweidu}'=''  then g.depth=4\r\n\t\twhen '{weidu}'=1 and '{ziweidu}'!=''  then FIND_IN_SET( g.parentid ,'{ziweidu}') \r\n\t\twhen '{weidu}'=1 and '{ziweidu}'=''  then 1=1\r\n\t\telse 1=1\r\n\t\tend \r\n\t) \r\nand (case when '{amount_start}'=0 then 1=1 else ld_potential.total>='{amount_start}'end )\r\nand (case when '{amount_end}'=0 then 1=1 else ld_potential.total<'{amount_end}'end )\r\nand ld_potential.closingdate >= DATE_FORMAT(CONCAT('{start_date}'),'%Y-%m-%d')\r\nand ld_potential.closingdate <= DATE_FORMAT(CONCAT('{end_date}'),'%Y-%m-%d')\r\nand (case when '{product_type}'!='' then cf_4708  REGEXP REPLACE('[[:<:]]{product_type}[[:>:]]',',','|') else 1=1 end)\r\n)c on c.totalkey=a.totalkey\r\norder by a.ordernum asc "
      },
      "4": {
