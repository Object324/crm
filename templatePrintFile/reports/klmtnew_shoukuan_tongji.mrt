        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\ta.cashbillid AS orderid,\r\n\ta.cashbill_no AS orderno,\r\n\tg.potentialname AS ccfno,\r\n\th.accountname,\r\n\ts.Accountname AS zhanghu,\r\n\te.salesorder_no,\r\n\te.signed_data,\r\n\tf.cf_2327 AS qianyuefang,\r\n\tf.cf_2323 AS ordertype,\r\n\tROUND(c.amount/IFNULL(a.conversion_rate,1),2) AS total,\r\n\ta.smownerid,\r\n\tu1.last_name AS smowner,\r\n\tf.cf_2395 AS quyu,\r\n\tf.cf_2321 AS term,\r\n\ta.description,\r\n\ta.cashbilldate,\r\n\ta.paymentmethod\r\nFROM ld_cashbill a\r\nLEFT JOIN ld_cashbillscf b ON a.cashbillid=b.cashbillid\r\nLEFT JOIN ld_cashbill2paymentplan c ON c.CashBillID=a.cashbillid\r\nLEFT JOIN ld_bankaccountset s ON s.Bankaccountsetid=a.bankaccountsetid\r\nLEFT JOIN\tld_salesorder e ON e.salesorderid=c.entitytypeid\r\nLEFT JOIN ld_salesordercf f ON f.salesorderid=e.salesorderid\r\nLEFT JOIN ld_potential g ON g.potentialid=a.potentialid\r\nLEFT JOIN ld_account h ON h.accountid=a.accountid\r\nLEFT JOIN ld_users u1 ON u1.id=a.smownerid\r\nINNER JOIN (\r\n\tSELECT DISTINCT\r\n\t\tuserid \r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\tld_users.id AS userid \r\n\t\tFROM ld_users\r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='CashBill' and scopeauthority=1 AND userid='[uuid]')\r\n\t\tUNION\r\n\t\tSELECT \r\n\t\t\tviewid AS userid \r\n\t\tFROM ld_scoperhigher\r\n\t\tWHERE userid='[uuid]' AND modulename='CashBill' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename='CashBill')\t\t\t\r\n\t\tUNION\r\n\t\tSELECT DISTINCT \r\n\t\t\tld_users2group.userid AS userid \r\n\t\tFROM ld_scoperhigher \r\n\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\tAND ld_scoperhigher.modulename='CashBill'\r\n\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='CashBill' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\tUNION \r\n\t\tSELECT \r\n\t\t\tid AS userid \r\n\t\tFROM ld_users  \r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\tUNION\r\n\t\tSELECT '[uuid]') AS vw_users\r\n) AS list_user ON list_user.userid=a.smownerid\r\nWHERE a.deleted=0\r\n\tAND a.approvestatus<>'已拒绝'\r\n\tAND a.cashbilldate BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{ordernum}'='' THEN 1=1\r\n\t\t\tELSE LOCATE(TRIM('{ordernum}'),g.potentialname)>0\r\n\t\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{custname}'='' THEN 1=1\r\n\t\t\tELSE LOCATE(TRIM('{custname}'),h.accountname)>0\r\n\t\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{userid}'='' THEN 1=1\r\n\t\t\tELSE FIND_IN_SET(a.smownerid,'{userid}')\r\n\t\tEND)\r\nORDER BY a.cashbilldate,a.createdtime"
      }
    },
