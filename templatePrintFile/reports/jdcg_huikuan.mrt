          },
          "8": {
            "Name": "weidu_descp",
            "Index": -1,
            "NameInSource": "weidu_descp",
            "Alias": "weidu_descp",
            "Type": "System.String"
          },
          "9": {
            "Name": "weidu_type",
            "Index": -1,
            "NameInSource": "weidu_type",
            "Alias": "weidu_type",
            "Type": "System.String"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\tid,\r\n\tweidu_descp,\r\n\tweidu_type,\r\n\tpotentialid,\r\n\tpotentialname,\r\n\tPeriodtime,\r\n\tamount,\r\n\tactualamount,\r\n\tactualdate,\r\n\tsk_rate\r\nFROM (\r\nSELECT\r\n\ta.smownerid AS id,\r\n\ta.servicecontractsid,\r\n\ta.potentialid,\r\n\ta.createdtime,\r\n\tCASE\r\n\t\tWHEN '{weidu}'=1 THEN '客户经理'\r\n\t\tWHEN '{weidu}'=2 THEN '片区'\r\n\t\tWHEN '{weidu}'=3 THEN '大区'\r\n\t\tELSE '公司整体'\r\n\tEND AS weidu_descp,\r\n\tCASE\r\n\t\tWHEN '{weidu}'=1 THEN u.last_name\r\n\t\tWHEN '{weidu}'=2 THEN u.user_pianqu\r\n\t\tWHEN '{weidu}'=3 THEN u.user_daqu\r\n\t\tELSE '公司整体'\r\n\tEND AS weidu_type,\r\n\tc.potentialname,\r\n\td.Periodtime,\r\n\td.amount,\r\n\td.actualamount,\r\n\td.actualdate,\r\n\tCASE\r\n\t\tWHEN d.amount>0 THEN d.actualamount/d.amount\r\n\t\tELSE NULL\r\n\tEND AS sk_rate,\r\n\te.sequence,\r\n\td.createdtime AS planaddtime\r\nFROM ld_servicecontracts a\r\nLEFT JOIN ld_potential c ON c.potentialid=a.potentialid\r\nLEFT JOIN ld_users u ON u.id=a.smownerid\r\nLEFT JOIN ld_paymentplan d ON d.entitytypeid=a.servicecontractsid AND d.deleted=0\r\nLEFT JOIN (SELECT listvalue,sequence FROM ld_picklist_values WHERE listid=43) e ON e.listvalue=d.Periodtime\r\nINNER JOIN ld_users2group e ON e.userid=u.id\r\nINNER JOIN ld_groups f ON f.groupid=e.groupid\r\nINNER JOIN (\r\n\tSELECT DISTINCT\r\n\t\tuserid \r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\tld_users.id AS userid \r\n\t\tFROM ld_users\r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='ServiceContracts' and scopeauthority=1 AND userid='[uuid]')\r\n\t\tUNION\r\n\t\tSELECT \r\n\t\t\tviewid AS userid \r\n\t\tFROM ld_scoperhigher\r\n\t\tWHERE userid='[uuid]' AND modulename ='ServiceContracts' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename ='ServiceContracts')\t\t\t\r\n\t\tUNION\r\n\t\tSELECT DISTINCT \r\n\t\t\tld_users2group.userid AS userid \r\n\t\tFROM ld_scoperhigher \r\n\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\tAND ld_scoperhigher.modulename ='ServiceContracts'\r\n\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='ServiceContracts' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\tUNION \r\n\t\tSELECT \r\n\t\t\tid AS userid \r\n\t\tFROM ld_users  \r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\tUNION\r\n\t\tSELECT '[uuid]') AS vw_users\r\n) AS tmp_users ON tmp_users.userid=a.smownerid\r\nWHERE a.deleted=0\r\n\tAND a.approvestatus<>'已拒绝'\r\n\tAND YEAR(a.createdtime)='{nian}'\r\n\tAND (f.groupid=2 OR f.parentgroup LIKE '1::2::%')\r\n\tAND u.profileid IN (64,65)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(MONTH(a.createdtime),'{date_value}')\r\n\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(QUARTER(a.createdtime),'{date_value}')\r\n\t\tEND)\r\n) a\r\nWHERE 1=1\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{weidu}'=1 AND TRIM('{ziweidu}')='' THEN 1=1\r\n\t\t\tWHEN '{weidu}'=1 AND TRIM('{ziweidu}')<>'' THEN FIND_IN_SET(a.id,'{ziweidu}')\r\n\t\t\r\n\t\t\tWHEN '{weidu}'=2 AND TRIM('{ziweidu}')='' THEN weidu_type IN ('山东区','北京区','河南区','西南区','青岛金东','应急安全产品线')\r\n\t\t\tWHEN '{weidu}'=2 THEN FIND_IN_SET(weidu_type,'{ziweidu}')\r\n\r\n\t\t\tWHEN '{weidu}'=3 AND TRIM('{ziweidu}')='' THEN weidu_type IN ('东部大区','南部大区','西部大区','北部大区','青岛金东','应急安全产品线')\r\n\t\t\tWHEN '{weidu}'=3 THEN FIND_IN_SET(weidu_type,'{ziweidu}')\r\n\t\t\t\r\n\t\t\tELSE 1=1\r\n\t\tEND) \r\nORDER BY (\r\n\tCASE \r\n\t\tWHEN '{weidu}'=1 THEN id\r\n\t\tWHEN '{weidu}'=2 THEN FIELD(weidu_type,'山东区','北京区','河南区','西南区','青岛金东','应急安全产品线')\r\n\t\tWHEN '{weidu}'=3 THEN FIELD(weidu_type,'东部大区','南部大区','西部大区','北部大区','青岛金东','应急安全产品线')\r\n\t\tELSE weidu_type\r\n\tEND),a.potentialid,a.createdtime,a.sequence,a.planaddtime"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "list_weidu",
        "Alias": "list_weidu",
        "Columns": {
          "0": {
            "Name": "list_key",
            "Index": -1,
            "NameInSource": "list_key",
            "Alias": "list_key",
            "Type": "System.Int32"
          },
          "1": {
            "Name": "list_key2",
            "Index": -1,
            "NameInSource": "list_key2",
            "Alias": "list_key2",
            "Type": "System.String"
          },
          "2": {
            "Name": "list_value",
            "Index": -1,
            "NameInSource": "list_value",
            "Alias": "list_value",
            "Type": "System.String"
          },
          "3": {
            "Name": "list_value2",
            "Index": -1,
            "NameInSource": "list_value2",
            "Alias": "list_value2",
            "Type": "System.String"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\tlist_key,\r\n\tlist_key2,\r\n\tlist_value,\r\n\tlist_value2\r\nFROM (\r\n\tSELECT\r\n\t\t1 AS list_key,\r\n\t\t'客户经理/市场专员' AS list_value,\r\n\t\ta.id AS list_key2,\r\n\t\ta.last_name AS list_value2\r\n\tFROM ld_users a\r\n\tWHERE a.deleted=0\r\n\t\tAND a.id IN (SELECT DISTINCT a.userid FROM ld_users2group a LEFT JOIN ld_groups b ON b.groupid=a.groupid WHERE (b.groupid=2 OR b.parentgroup LIKE '%1::2::%')) \r\n\tUNION\r\n\tSELECT\r\n\t\t2 AS list_key,\r\n\t\t'片区' AS list_value,\r\n\t\ta.user_pianqu AS list_key2,\r\n\t\ta.user_pianqu AS list_value2\r\n\tFROM ld_users a\r\n\tWHERE a.user_pianqu IN ('山东区','北京区','河南区','西南区','青岛金东','应急安全产品线')\r\n\tGROUP BY a.user_pianqu\r\n\tUNION\r\n\tSELECT\r\n\t\t3 AS list_key,\r\n\t\t'大区' AS list_value,\r\n\t\ta.user_daqu AS list_key2,\r\n\t\ta.user_daqu AS list_value2\r\n\tFROM ld_users a\r\n\tWHERE a.user_daqu IN ('东部大区','南部大区','西部大区','北部大区','青岛金东','应急安全产品线')\r\n\tGROUP BY a.user_daqu\r\n\tUNION\r\n\tSELECT \r\n\t\t4 AS list_key,\r\n\t\t'公司整体' AS list_value,\r\n\t\t'公司整体' AS list_key2,\r\n\t\t'公司整体' AS list_value2\r\n) a\r\nORDER BY a.list_key,\r\n\t(CASE \r\n\t\tWHEN list_key=1 THEN CONVERT(a.list_value2 USING GBK) \r\n\t\tWHEN list_key=2 THEN FIELD(a.list_value2,'山东区','北京区','河南区','西南区','青岛金东','应急安全产品线')\r\n\t\tWHEN list_key=3 THEN FIELD(a.list_value2,'东部大区','南部大区','西部大区','北部大区','青岛金东','应急安全产品线')\r\n\tEND)"
      },
      "2": {
        "Ident": "StiMySqlSource",
        "Name": "list_chanpinxian",
