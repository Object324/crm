            "Alias": "list_value",
            "Type": "System.Int32"
          }
        },
        "NameInSource": "ldcrm",
        "Type": "Table",
        "SqlCommand": "SELECT YEAR(NOW()) AS list_value\r\nUNION\r\nSELECT YEAR(NOW())-1 AS list_value\r\nUNION\r\nSELECT YEAR(NOW())-2 AS list_value\r\nUNION\r\nSELECT YEAR(NOW())-3 AS list_value\r\nUNION\r\nSELECT YEAR(NOW())-3 AS list_value"
      }
    },
