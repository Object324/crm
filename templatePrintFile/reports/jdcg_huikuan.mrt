      },
      "3": {
        "Ident": "StiMySqlSource",
        "Name": "list_date",
        "Alias": "list_date",
        "Columns": {
          "0": {
            "Name": "list_key",
            "Index": -1,
            "NameInSource": "list_key",
            "Alias": "list_key",
            "Type": "System.String"
          },
          "1": {
            "Name": "list_value",
            "Index": -1,
            "NameInSource": "list_value",
            "Alias": "list_value",
            "Type": "System.Int32"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT '月度' AS list_key,seq AS list_value FROM sequence WHERE seq BETWEEN 1 AND 12\r\nUNION ALL\r\nSELECT '季度' AS list_key,seq AS list_value FROM sequence WHERE seq BETWEEN 1 AND 4"
      },
      "4": {
        "Ident": "StiMySqlSource",
        "Name": "list_nian",
