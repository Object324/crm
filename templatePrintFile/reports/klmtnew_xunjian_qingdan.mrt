          },
          "15": {
            "Name": "smowner",
            "Index": -1,
            "NameInSource": "smowner",
            "Alias": "smowner",
            "Type": "System.String"
          },
          "16": {
            "Name": "productname",
            "Index": -1,
            "NameInSource": "productname",
            "Alias": "productname",
            "Type": "System.String"
          },
          "17": {
            "Name": "product_no",
            "Index": -1,
            "NameInSource": "product_no",
            "Alias": "product_no",
            "Type": "System.String"
          },
          "18": {
            "Name": "productsheet",
            "Index": -1,
            "NameInSource": "productsheet",
            "Alias": "productsheet",
            "Type": "System.String"
          },
          "19": {
            "Name": "quantity",
            "Index": -1,
            "NameInSource": "quantity",
            "Alias": "quantity",
            "Type": "System.Object"
          },
          "20": {
            "Name": "usageunit",
            "Index": -1,
            "NameInSource": "usageunit",
            "Alias": "usageunit",
            "Type": "System.String"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\ta.servicecontractsid AS orderid,\r\n\ta.maintenance_type,\r\n\ts.cf_2327 AS qianyuefang,\r\n\tc.potentialname AS ccf_no,\r\n\td.accountname,\r\n\ta.description,\r\n\td.bill_street,\r\n\te.lastname,\r\n\te.pphone,\r\n\te.mobile,\r\n\ta.maintenance_startdate,\r\n\ta.maintenance_enddate,\r\n\tb.cf_2350 AS days,\r\n\tDATE_ADD(a.maintenance_startdate,INTERVAL CEIL(DATEDIFF(CURDATE(),a.maintenance_startdate)/b.cf_2350)*b.cf_2350 DAY) AS next_xunjian_date,\r\n\ta.contract_no,\r\n\tf.last_name AS smowner,\r\n\th.productname,\r\n\th.product_no,\r\n\th.productsheet,\r\n\tg.quantity,\r\n\th.usageunit\r\nFROM ld_servicecontracts a\r\nLEFT JOIN ld_servicecontractscf b ON a.servicecontractsid=b.servicecontractsid\r\nLEFT JOIN ld_salesordercf s ON s.salesorderid=a.salesorderid\r\nLEFT JOIN ld_potential c ON c.potentialid=a.potentialid\r\nLEFT JOIN ld_account d ON d.accountid=a.accountid\r\nLEFT JOIN ld_contactdetails e ON e.contactid=c.contactid\r\nLEFT JOIN ld_users f ON f.id=a.smownerid\r\nLEFT JOIN ld_servicecontractsdetail g ON g.id=a.servicecontractsid\r\nLEFT JOIN ld_products h ON h.productid=g.productid\r\nINNER JOIN (\r\n\tSELECT DISTINCT\r\n\t\tuserid \r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\tld_users.id AS userid \r\n\t\tFROM ld_users\r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='ServiceContracts' and scopeauthority=1 AND userid='[uuid]')\r\n\t\tUNION\r\n\t\tSELECT \r\n\t\t\tviewid AS userid \r\n\t\tFROM ld_scoperhigher\r\n\t\tWHERE userid='[uuid]' AND modulename='ServiceContracts' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename='ServiceContracts')\t\t\t\r\n\t\tUNION\r\n\t\tSELECT DISTINCT \r\n\t\t\tld_users2group.userid AS userid \r\n\t\tFROM ld_scoperhigher \r\n\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\tAND ld_scoperhigher.modulename='ServiceContracts'\r\n\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='ServiceContracts' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\tUNION \r\n\t\tSELECT \r\n\t\t\tid AS userid \r\n\t\tFROM ld_users  \r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\tUNION\r\n\t\tSELECT '[uuid]') AS vw_users\r\n) AS list_user ON list_user.userid=a.smownerid\r\nWHERE a.deleted=0\r\n\tAND a.approvestatus<>'已拒绝'\r\n\tAND IFNULL(b.cf_2381,'')<>'作废单据'\r\n\tAND CURDATE() BETWEEN a.maintenance_startdate AND a.maintenance_enddate\r\n\tAND DATE_ADD(a.maintenance_startdate,INTERVAL CEIL(DATEDIFF(CURDATE(),a.maintenance_startdate)/b.cf_2350)*b.cf_2350 DAY)<=a.maintenance_enddate\r\n\tAND DATE_ADD(a.maintenance_startdate,INTERVAL CEIL(DATEDIFF(CURDATE(),a.maintenance_startdate)/b.cf_2350)*b.cf_2350 DAY) BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{ordernum}'='' THEN 1=1\r\n\t\t\tELSE LOCATE(TRIM('{ordernum}'),c.potentialname)>0\r\n\t\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{custname}'='' THEN 1=1\r\n\t\t\tELSE LOCATE(TRIM('{custname}'),d.accountname)>0\r\n\t\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{userid}'='' THEN 1=1\r\n\t\t\tELSE FIND_IN_SET(a.smownerid,'{userid}')\r\n\t\tEND)\r\nORDER BY DATE_ADD(a.maintenance_startdate,INTERVAL CEIL(DATEDIFF(CURDATE(),a.maintenance_startdate)/b.cf_2350)*b.cf_2350 DAY),a.createdtime,a.servicecontractsid,g.sequence_no"
      }
    },
