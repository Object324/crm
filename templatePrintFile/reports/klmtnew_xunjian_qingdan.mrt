            "Type": "System.DateTime"
          },
          "12": {
            "Name": "days",
            "Index": -1,
            "NameInSource": "days",
            "Alias": "days",
            "Type": "System.Object"
          },
          "13": {
            "Name": "next_xunjian_date",
            "Index": -1,
            "NameInSource": "next_xunjian_date",
