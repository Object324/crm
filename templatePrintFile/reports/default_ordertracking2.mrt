          },
          "13": {
            "Name": "receivable_balance",
            "Index": -1,
            "NameInSource": "receivable_balance",
            "Alias": "receivable_balance",
            "Type": "System.Object"
          },
          "14": {
            "Name": "received_amount",
            "Index": -1,
            "NameInSource": "received_amount",
