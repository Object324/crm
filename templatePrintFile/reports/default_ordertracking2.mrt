          "18": {
            "Name": "total_rmb",
            "Index": -1,
            "NameInSource": "total_rmb",
            "Alias": "total_rmb",
            "Type": "System.Object"
          },
          "19": {
            "Name": "total_show",
            "Index": -1,
            "NameInSource": "total_show",
            "Alias": "total_show",
            "Type": "System.String"
          },
          "20": {
            "Name": "yongjin_total",
            "Index": -1,
            "NameInSource": "yongjin_total",
            "Alias": "yongjin_total",
            "Type": "System.Object"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\ta.orderid,\r\n\ta.smownerid,\r\n\tu.last_name,\r\n\td.groupname,\r\n\ta.signed_data,\r\n\tt.fieldlabel AS billtype,\r\n\ta.order_no,\r\n\ta.stockpresence,\r\n\tk.accountname,\r\n\ta.accountid,\r\n\tCONCAT(a.currency_symbol,ROUND(a.total,2)) AS total_show,\r\n\tROUND(a.total_rmb,2) AS total_rmb,\r\n\tROUND(a.received_amount,2) AS received_amount,\r\n\tROUND(a.receivable_balance,2) AS receivable_balance,\r\n\tROUND(a.have_invoicetotal,2) AS have_invoicetotal,\r\n\tROUND(a.nothave_invoicetotal,2) AS nothave_invoicetotal,\r\n\tROUND(IFNULL(b.total,0),2) AS yongjin_total,\r\n\tROUND(IFNULL(c.total,0),2) AS feiyong_total,\r\n\tROUND(a.productcost,2) AS cost_total,\r\n\tROUND(a.total_rmb,2)-ROUND(IFNULL(b.total,0),2)-ROUND(IFNULL(c.total,0),2)-ROUND(a.productcost,2) AS maoli_total,\r\n\tCASE\r\n\t\tWHEN ROUND(a.total_rmb,2)=0 THEN 1\r\n\t\tELSE (ROUND(a.total_rmb,2)-ROUND(IFNULL(b.total,0),2)-ROUND(IFNULL(c.total,0),2)-ROUND(a.productcost,2))/ROUND(a.total_rmb,2)\r\n\tEND AS maolilv\r\nFROM (\r\n\tSELECT\r\n\t\ta.salesorderid AS orderid,\r\n\t\ta.salesorder_no AS order_no,\r\n\t\ta.stockpresence,\r\n\t\ta.signed_data,\r\n\t\ta.duedate,\r\n\t\ta.createdtime,\r\n\t\ta.`subject` AS zhuti,\r\n\t\ta.accountid,\r\n\t\ta.sostatus,\r\n\t\ta.total,\r\n\t\ta.total/IF(IFNULL(a.conversion_rate,0)=0,1,a.conversion_rate) AS total_rmb,\r\n\t\ta.received_amount/IF(IFNULL(a.conversion_rate,0)=0,1,a.conversion_rate) AS received_amount,\r\n\t\ta.receivable_balance/IF(IFNULL(a.conversion_rate,0)=0,1,a.conversion_rate) AS receivable_balance,\r\n\t\ta.have_invoicetotal/IF(IFNULL(a.conversion_rate,0)=0,1,a.conversion_rate) AS have_invoicetotal,\r\n\t\ta.nothave_invoicetotal/IF(IFNULL(a.conversion_rate,0)=0,1,a.conversion_rate) AS nothave_invoicetotal,\r\n\t\ta.currency_symbol,\r\n\t\ta.currency_id,\r\n\t\ta.conversion_rate,\r\n\t\ta.deleted,\r\n\t\ta.approvestatus,\r\n\t\ta.smcreatorid AS smownerid,\r\n\t\t22 AS ordertype,\r\n\t\tCASE\r\n\t\t\tWHEN b.productcost=0 OR b.productcost IS NULL THEN\r\n\t\t\t\tSUM(IFNULL(c.costprice, 0)*b.quantity)\r\n\t\t\tWHEN b.productcost>0 AND EXISTS (SELECT 1 FROM ld_version WHERE trade='puyoung' AND account='lingdang') THEN\r\n\t\t\t\tSUM(b.productcost/IF(IFNULL(a.conversion_rate,0)=0,1,a.conversion_rate))    \r\n\t\t\tELSE\r\n\t\t\t\tSUM(b.productcost*b.quantity/IF(IFNULL(a.conversion_rate,0)=0,1,a.conversion_rate))\r\n\t\tEND AS productcost\r\n\tFROM ld_salesorder a\r\n\tLEFT JOIN ld_salesorderdetail b ON b.id=a.salesorderid\r\n\tLEFT JOIN ld_products c ON c.productid=b.productid\r\n\tINNER JOIN (\r\n\t\tSELECT DISTINCT\r\n\t\t\tuserid \r\n\t\tFROM (\r\n\t\t\tSELECT \r\n\t\t\t\tld_users.id AS userid \r\n\t\t\tFROM ld_users\r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='SalesOrder' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\tUNION\r\n\t\t\tSELECT \r\n\t\t\t\tviewid AS userid \r\n\t\t\tFROM ld_scoperhigher\r\n\t\t\tWHERE userid='[uuid]' AND modulename='SalesOrder' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename='SalesOrder')\t\t\t\r\n\t\t\tUNION\r\n\t\t\tSELECT DISTINCT \r\n\t\t\t\tld_users2group.userid AS userid \r\n\t\t\tFROM ld_scoperhigher \r\n\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\tAND ld_scoperhigher.modulename='SalesOrder'\r\n\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='SalesOrder' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\tUNION \r\n\t\t\tSELECT \r\n\t\t\t\tid AS userid \r\n\t\t\tFROM ld_users  \r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\tUNION\r\n\t\t\tSELECT '[uuid]') AS vw_users\r\n\t) AS tmp_users ON tmp_users.userid=a.smownerid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND IFNULL(a.sostatus,'')<>'已作废'\r\n\t\tAND a.signed_data BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{billtype}' IN (0,22) THEN 1=1\r\n\t\t\t\tELSE 0=1\r\n\t\t\tEND)\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{shenpi}'='true' THEN a.approvestatus='已批准'\r\n\t\t\t\tELSE 1=1\r\n\t\t\tEND)\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{yingshou}'='true' THEN a.receivable_balance>0\r\n\t\t\t\tELSE 1=1\r\n\t\t\tEND)\r\n\tGROUP BY a.salesorderid\r\n\tUNION ALL\r\n\tSELECT\r\n\t\ta.servicecontractsid,\r\n\t\ta.contract_no,\r\n\t\ta.stockpresence,\r\n\t\ta.due_date AS signed_data,\r\n\t\ta.due_date AS duedate,\r\n\t\ta.createdtime,\r\n\t\ta.`subject`,\r\n\t\ta.accountid,\r\n\t\ta.contract_status,\r\n\t\ta.total,\r\n\t\ta.total/IF(IFNULL(a.conversion_rate,0)=0,1,a.conversion_rate) AS total_rmb,\r\n\t\ta.received_amount/IF(IFNULL(a.conversion_rate,0)=0,1,a.conversion_rate),\r\n\t\ta.receivable_balance/IF(IFNULL(a.conversion_rate,0)=0,1,a.conversion_rate),\r\n\t\ta.have_invoicetotal/IF(IFNULL(a.conversion_rate,0)=0,1,a.conversion_rate),\r\n\t\ta.nothave_invoicetotal/IF(IFNULL(a.conversion_rate,0)=0,1,a.conversion_rate),\r\n\t\ta.currency_symbol,\r\n\t\ta.currency_id,\r\n\t\ta.conversion_rate,\r\n\t\ta.deleted,\r\n\t\ta.approvestatus,\r\n\t\ta.smcreatorid AS smownerid,\r\n\t\t37 AS ordertype,\r\n\t\tCASE\r\n\t\t\tWHEN b.productcost=0 OR b.productcost IS NULL THEN\r\n\t\t\t\tSUM(IFNULL(c.costprice, 0)*b.quantity)\r\n\t\t\tWHEN b.productcost>0 AND EXISTS (SELECT 1 FROM ld_version WHERE trade='puyoung' AND account='lingdang') THEN\r\n\t\t\t\tSUM(b.productcost/IF(IFNULL(a.conversion_rate,0)=0,1,a.conversion_rate))    \r\n\t\t\tELSE\r\n\t\t\t\tSUM(b.productcost*b.quantity/IF(IFNULL(a.conversion_rate,0)=0,1,a.conversion_rate))\r\n\t\tEND AS productcost\r\n\tFROM ld_servicecontracts a\r\n\tLEFT JOIN ld_servicecontractsdetail b ON b.id=a.servicecontractsid\r\n\tLEFT JOIN ld_products c ON c.productid=b.productid\r\n\tINNER JOIN (\r\n\t\tSELECT DISTINCT\r\n\t\t\tuserid \r\n\t\tFROM (\r\n\t\t\tSELECT \r\n\t\t\t\tld_users.id AS userid \r\n\t\t\tFROM ld_users\r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='ServiceContracts' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\tUNION\r\n\t\t\tSELECT \r\n\t\t\t\tviewid AS userid \r\n\t\t\tFROM ld_scoperhigher\r\n\t\t\tWHERE userid='[uuid]' AND modulename='ServiceContracts' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename='ServiceContracts')\t\t\t\r\n\t\t\tUNION\r\n\t\t\tSELECT DISTINCT \r\n\t\t\t\tld_users2group.userid AS userid \r\n\t\t\tFROM ld_scoperhigher \r\n\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\tAND ld_scoperhigher.modulename='ServiceContracts'\r\n\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='ServiceContracts' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\tUNION \r\n\t\t\tSELECT \r\n\t\t\t\tid AS userid \r\n\t\t\tFROM ld_users  \r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\tUNION\r\n\t\t\tSELECT '[uuid]') AS vw_users\r\n\t) AS tmp_users ON tmp_users.userid=a.smownerid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND IFNULL(a.contract_status,'')<>'已作废'\r\n\t\tAND a.due_date BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{billtype}' IN (0,37) THEN 1=1\r\n\t\t\t\tELSE 0=1\r\n\t\t\tEND)\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{shenpi}'='true' THEN a.approvestatus='已批准'\r\n\t\t\t\tELSE 1=1\r\n\t\t\tEND)\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{yingshou}'='true' THEN a.receivable_balance>0\r\n\t\t\t\tELSE 1=1\r\n\t\t\tEND)\r\n\tGROUP BY a.servicecontractsid\r\n) a\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\tSUM(b.amount/IF(IFNULL(a.conversion_rate,0)=0,1,a.conversion_rate)) AS total,\r\n\t\tb.entitytypeid\r\n\tFROM ld_commission a\r\n\tLEFT JOIN ld_commission2payment b ON a.commission_id = b.commission_id\r\n\tWHERE a.deleted = 0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND b.entitytypeid>0\r\n\tGROUP BY b.entitytypeid\r\n) AS b ON b.entitytypeid = a.orderid\r\nLEFT JOIN (\r\n\tSELECT \r\n\t\tb.entitytypeid,\r\n\t\tSUM(c.rmb_total) AS total\r\n\tFROM ld_expense a\r\n\tLEFT JOIN ld_expensedetail b ON b.expenseid=a.expenseid\r\n\tLEFT JOIN ld_expensedetailscf c  ON c.expensedetailid=b.expensedetailid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND b.entitytypeid>0\r\n\tGROUP BY b.entitytypeid\r\n) AS c ON c.entitytypeid=a.orderid\r\nLEFT JOIN (\r\n\tSELECT \r\n\t\tGROUP_CONCAT(ld_groups.groupname) AS groupname,ld_users2group.userid \r\n\tFROM ld_users2group\r\n\tLEFT JOIN ld_groups ON ld_groups.groupid = ld_users2group.groupid\r\n\tGROUP BY ld_users2group.userid\r\n) AS d ON d.userid = a.smownerid\r\nLEFT JOIN ld_users u ON u.id = a.smownerid\r\nLEFT JOIN ld_account k ON k.accountid=a.accountid\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\ttabid,\r\n\t\tfieldlabel\r\n\tFROM ld_tranlabel\r\n\tWHERE tabid IN (22,37)\r\n\t\tAND trantable='ld_tab'\r\n\t\tAND languagetype='zh'\r\n) t ON t.tabid=a.ordertype\r\nWHERE 1=1\r\n\tAND(\r\n\t\tCASE\r\n\t\t\tWHEN FIND_IN_SET(1,'{data_range}') OR '{data_range}'='' THEN 1=1\r\n\t\t\tWHEN FIND_IN_SET(2,'{data_range}') THEN a.smownerid='[uuid]'\r\n\t\t\tELSE \r\n\t\t\t\t\t\ta.smownerid IN (\r\n\t\t\t\t\t\t\t\tSELECT\r\n\t\t\t\t\t\t\t\t\ta.userid\r\n\t\t\t\t\t\t\t\tFROM ld_users2group a\r\n\t\t\t\t\t\t\t\tINNER JOIN (\r\n\t\t\t\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\t\t\t\tsubstring_index(substring_index(a.splitsting,',',b.seq+1),',',-1)-200000 AS groupid\r\n\t\t\t\t\t\t\t\t\tFROM (SELECT '{data_range}' AS splitsting) a \r\n\t\t\t\t\t\t\t\t\tLEFT JOIN sequence b ON b.seq < (length(a.splitsting) - length(replace(a.splitsting,',',''))+1) \r\n\t\t\t\t\t\t\t\t\tWHERE substring_index(substring_index(a.splitsting,',',b.seq+1),',',-1) BETWEEN 200000 AND 300000\r\n\t\t\t\t\t\t\t\t) b ON b.groupid=a.groupid\r\n\t\t\t\t\t\t\t\tGROUP BY a.userid\r\n\t\t\t\t\t\t\t\tUNION \r\n\t\t\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\t\t\tsubstring_index(substring_index(a.splitsting,',',b.seq+1),',',-1)-300000 AS groupid\r\n\t\t\t\t\t\t\t\tFROM (SELECT '{data_range}' AS splitsting) a \r\n\t\t\t\t\t\t\t\tLEFT JOIN sequence b ON b.seq < (length(a.splitsting) - length(replace(a.splitsting,',',''))+1) \r\n\t\t\t\t\t\t\t\tWHERE substring_index(substring_index(a.splitsting,',',b.seq+1),',',-1)>300000\r\n\t\t\t\t\t\t)\r\n\t\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN TRIM('{custname}')='' THEN 1=1\r\n\t\t\tELSE LOCATE(TRIM('{custname}'),k.accountname)>0\r\n\t\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN TRIM('{ordernum}')='' THEN 1=1\r\n\t\t\tELSE LOCATE(TRIM('{ordernum}'),a.order_no)>0\r\n\t\tEND)\r\nORDER BY CONVERT(u.last_name USING GBK),a.smownerid,a.signed_data DESC,a.ordertype"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "list_user",
        "Alias": "list_user",
        "Columns": {
          "0": {
            "Name": "listid",
            "Index": -1,
            "NameInSource": "listid",
            "Alias": "listid",
            "Type": "System.Int32"
          },
          "1": {
            "Name": "listvalue",
            "Index": -1,
            "NameInSource": "listvalue",
            "Alias": "listvalue",
            "Type": "System.String"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT 1 AS listid,'全部' AS listvalue\r\nUNION\r\nSELECT 2, '我负责的'\r\nUNION\r\n(SELECT\r\n\ta.groupid+200000,\r\n\tCONCAT('部门::',IFNULL(a.groupname,''))\r\nFROM (\r\n\tSELECT \r\n\t\ta.groupid, \r\n\t\ta.groupname, \r\n\t\tLPAD(substring_index(substring_index(a.splitsting,',',b.seq+1),',',-1),8,'0') AS splitsting\r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\ta.groupid,\r\n\t\t\ta.groupname, \r\n\t\t\tREPLACE(a.parentgroup,'::',',') AS splitsting \r\n\t\tFROM ld_groups a\r\n\t\tLEFT JOIN ld_users2group b ON b.groupid=a.groupid\r\n\t\tGROUP BY a.groupid\r\n\t) a \r\n\tLEFT JOIN sequence b ON b.seq < (length(a.splitsting) - length(replace(a.splitsting,',',''))+1)\r\n) a\r\nGROUP BY a.groupid\r\nORDER BY GROUP_CONCAT(IFNULL(a.splitsting,'') ORDER BY a.splitsting SEPARATOR '::'))\r\nUNION \r\n(SELECT\r\n\ta.id+300000,\r\n\tCONCAT('用户::',IFNULL(a.last_name,''))\r\nFROM ld_users a\r\nINNER JOIN (\r\n\tSELECT DISTINCT\r\n\t\tuserid \r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\tld_users.id AS userid \r\n\t\tFROM ld_users\r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename IN ('SalesOrder','ServiceContracts') and scopeauthority=1 AND userid='[uuid]')\r\n\t\tUNION\r\n\t\tSELECT \r\n\t\t\tviewid AS userid \r\n\t\tFROM ld_scoperhigher\r\n\t\tWHERE userid='[uuid]' AND modulename IN ('SalesOrder','ServiceContracts') AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename IN ('SalesOrder','ServiceContracts'))\t\t\t\r\n\t\tUNION\r\n\t\tSELECT DISTINCT \r\n\t\t\tld_users2group.userid AS userid \r\n\t\tFROM ld_scoperhigher \r\n\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\tAND ld_scoperhigher.modulename IN ('SalesOrder','ServiceContracts')\r\n\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename IN ('SalesOrder','ServiceContracts') AND scopeauthority=3 AND userid='[uuid]')\r\n\t\tUNION \r\n\t\tSELECT \r\n\t\t\tid AS userid \r\n\t\tFROM ld_users  \r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\tUNION\r\n\t\tSELECT '[uuid]') AS vw_users\r\n) AS tmp_users ON tmp_users.userid=a.id\r\nWHERE a.deleted=0\r\n\tAND a.`status`='Active'\r\nORDER BY CONVERT(a.last_name USING gbk))"
      },
      "2": {
        "Ident": "StiMySqlSource",
        "Name": "list_billtype",
        "Alias": "list_billtype",
        "Columns": {
          "0": {
            "Name": "listid",
            "Index": -1,
            "NameInSource": "listid",
            "Alias": "listid",
            "Type": "System.Int32"
          },
          "1": {
            "Name": "listvalue",
            "Index": -1,
            "NameInSource": "listvalue",
            "Alias": "listvalue",
            "Type": "System.String"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT 0 AS listid,'全部' AS listvalue\r\nUNION\r\nSELECT\r\n\ta.tabid,\r\n\tb.fieldlabel\r\nFROM ld_tab a\r\nLEFT JOIN ld_tranlabel b ON a.tabid=b.tabid AND b.trantable='ld_tab' AND b.languagetype='zh'\r\nWHERE a.tabid IN (22,37)\r\nGROUP BY tabid"
      }
    },
