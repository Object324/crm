        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\ta.productid,\r\n\ta.productname,\r\n\ta.productgroup_name,\r\n\ta.version1,\r\n\ta.qty1,\r\n\ta.price1,\r\n\ta.zhekou1,\r\n\ta.version2,\r\n\ta.qty2,\r\n\ta.price2,\r\n\ta.zhekou2,\r\n\ta.changetype,\r\n\tCASE \r\n\t\tWHEN a.changetype='变更' AND IFNULL(a.qty1,0)<>IFNULL(a.qty2,0) THEN 1\r\n\t\tELSE 0 \r\n\tEND AS is_qtychange,\r\n\tCASE \r\n\t\tWHEN a.changetype='变更' AND IFNULL(a.price1,0)<>IFNULL(a.price2,0) THEN 1\r\n\t\tELSE 0 \r\n\tEND AS is_pricechange,\r\n\tCASE \r\n\t\tWHEN a.changetype='变更' AND IFNULL(a.zhekou1,0)<>IFNULL(a.zhekou2,0) THEN 1\r\n\t\tELSE 0 \r\n\tEND AS is_zhekouchange\r\nFROM (\t\r\n\tSELECT\r\n\t\ta.productid,\r\n\t\ta.productname,\r\n\t\ta.productgroup_name,\r\n\t\tb.quote_version AS version1,\r\n\t\tb.quantity AS qty1,\r\n\t\tb.standardprice AS price1,\r\n\t\tb.discount_percent AS zhekou1,\r\n\t\tc.quote_version AS version2,\r\n\t\tc.quantity AS qty2,\r\n\t\tc.standardprice AS price2,\r\n\t\tc.discount_percent AS zhekou2,\r\n\t\tCASE\r\n\t\t\tWHEN b.productid>0 AND IFNULL(c.productid,0)=0 THEN '新增'\r\n\t\t\tWHEN c.productid>0 AND IFNULL(b.b.productid,0)=0 THEN '删除'\r\n\t\t\tWHEN b.productid=c.productid AND b.quantity=c.quantity AND b.standardprice=c.standardprice AND b.discount_percent=c.discount_percent THEN '不变'\r\n\t\t\tELSE '变更'\r\n\t\tEND AS changetype,\r\n\t\ta.seq\r\n\tFROM (\t\r\n\t\tSELECT\r\n\t\t\tb.productid,\r\n\t\t\tc.productname,\r\n\t\t\tc.productgroup_name,\r\n\t\t\tSUM(b.sequence_no) AS seq\r\n\t\tFROM (\r\n\t\t\tSELECT\r\n\t\t\t\ta.quoteid,\r\n\t\t\t\ta.quote_version\r\n\t\t\tFROM ld_quotes a\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND a.potentialid=(SELECT potentialid FROM ld_quotes WHERE quoteid='[related_ldcrmid]')\r\n\t\t\tORDER BY a.quote_version DESC,a.quoteid DESC LIMIT 2\r\n\t\t) a\r\n\t\tLEFT JOIN ld_quotesdetail b ON b.id=a.quoteid\r\n\t\tLEFT JOIN ld_products c ON c.productid=b.productid\r\n\t\tGROUP BY b.productid\r\n\t) a\r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\ta.quote_version,\r\n\t\t\tb.productid,\r\n\t\t\tb.quantity,\r\n\t\t\tb.standardprice,\r\n\t\t\tb.discount_percent\r\n\t\tFROM ld_quotes a\r\n\t\tLEFT JOIN ld_quotesdetail b ON b.id=a.quoteid\r\n\t\tWHERE a.quoteid=(\r\n\t\t\t\tSELECT \r\n\t\t\t\t\tquoteid \r\n\t\t\t\tFROM ld_quotes\r\n\t\t\t\tWHERE deleted=0\r\n\t\t\t\t\tAND approvestatus<>'已拒绝'\r\n\t\t\t\t\tAND potentialid=(SELECT potentialid FROM ld_quotes WHERE quoteid='[related_ldcrmid]')\r\n\t\t\t\tORDER BY quote_version DESC,quoteid DESC LIMIT 1\r\n\t\t\t)\r\n\t) b ON b.productid=a.productid\r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\ta.quote_version,\r\n\t\t\tb.productid,\r\n\t\t\tb.quantity,\r\n\t\t\tb.standardprice,\r\n\t\t\tb.discount_percent\r\n\t\tFROM ld_quotes a\r\n\t\tLEFT JOIN ld_quotesdetail b ON b.id=a.quoteid\r\n\t\tWHERE a.quoteid=(\r\n\t\t\t\tSELECT \r\n\t\t\t\t\tquoteid \r\n\t\t\t\tFROM ld_quotes\r\n\t\t\t\tWHERE deleted=0\r\n\t\t\t\t\tAND approvestatus<>'已拒绝'\r\n\t\t\t\t\tAND potentialid=(SELECT potentialid FROM ld_quotes WHERE quoteid='[related_ldcrmid]')\r\n\t\t\t\tORDER BY quote_version DESC,quoteid DESC LIMIT 1,1\r\n\t\t\t)\r\n\t) c ON c.productid=a.productid\r\n\tWHERE (CASE WHEN b.productid=c.productid AND b.quantity=c.quantity AND b.standardprice=c.standardprice AND b.discount_percent=c.discount_percent THEN '不变' ELSE '改变' END)='改变'\r\n) a\r\nORDER BY a.productgroup_name,a.seq"
      }
    },
