            "Alias": "total_fenbao",
            "Type": "System.Decimal"
          },
          "11": {
            "Name": "total_order",
            "Index": -1,
            "NameInSource": "total_order",
            "Alias": "total_order",
            "Type": "System.Decimal"
          },
          "12": {
            "Name": "total_ordercash",
            "Index": -1,
            "NameInSource": "total_ordercash",
            "Alias": "total_ordercash",
            "Type": "System.Decimal"
          },
          "13": {
            "Name": "total_orderinvoice",
            "Index": -1,
            "NameInSource": "total_orderinvoice",
            "Alias": "total_orderinvoice",
            "Type": "System.Decimal"
          }
        },
        "NameInSource": "crm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\ta.projectid AS id,\r\n\ta.projectname,\r\n\ta.project_no,\r\n\ta.total_order,\r\n\ta.total_ordercash,\r\n\ta.total_orderinvoice,\r\n\ta.total_cailiao,\r\n\ta.total_fenbao,\r\n\ta.total_exec,\r\n\ta.total_comm,\r\n\ta.tax_fee,\r\n\ta.total_cost,\r\n\tIFNULL(a.total_order,0)-IFNULL(a.total_cost,0) AS maoli,\r\n\t(IFNULL(a.total_order,0)-IFNULL(a.total_cost,0))/a.total_cost AS rate\r\nFROM (\r\n\tSELECT\r\n\t\ta.projectid,\r\n\t\ta.projectname,\r\n\t\ta.project_no,\r\n\t\tROUND(b.total_order,2) AS total_order,\r\n\t\tROUND(b.total_ordercash,2) AS total_ordercash,\r\n\t\tROUND(b.total_ordercash,2) AS total_orderinvoice,\r\n\t\tROUND(c.total_cailiao,2) AS total_cailiao,\r\n\t\tROUND(c.total_fenbao,2) AS total_fenbao,\r\n\t\tROUND(d.total_exec,2) AS total_exec,\r\n\t\tROUND(e.total_comm,2) AS total_comm,\r\n\t\tROUND(IFNULL(ROUND(b.total_order,2),0)*0.01*('{rate}'+0),2) AS tax_fee,\r\n\t\tCASE\r\n\t\t\tWHEN '{costtype}'='1' THEN ROUND(f.total_cost,2)\r\n\t\t\tWHEN '{costtype}'='2' THEN ROUND(g.total_cost,2)\r\n\t\t\tELSE ROUND(h.total_cost,2)\r\n\t\tEND AS total_cost\r\n\tFROM ld_project a\r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\ta.crmid AS projectid,\r\n\t\t\tSUM(b.total/IF(IFNULL(b.conversion_rate,0)=0,1,b.conversion_rate)) AS total_order,\r\n\t\t\tSUM(b.received_amount/IF(IFNULL(b.conversion_rate,0)=0,1,b.conversion_rate)) AS total_ordercash,\r\n\t\t\tSUM(b.have_invoicetotal/IF(IFNULL(b.conversion_rate,0)=0,1,b.conversion_rate)) AS total_orderinvoice\r\n\t\tFROM ld_crmentityrel a\r\n\t\tINNER JOIN ld_salesorder b ON b.salesorderid=a.relcrmid\r\n\t\tWHERE a.module='Project'\r\n\t\t\tAND a.relmodule='SalesOrder'\r\n\t\t\tAND b.deleted=0\r\n\t\t\tAND b.approvestatus<>'已拒绝'\r\n\t\t\tAND IFNULL(b.sostatus,'')<>'已作废'\r\n\t\tGROUP BY a.crmid\r\n\t) b ON b.projectid=a.projectid\r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\ta.crmid AS projectid,\r\n\t\t\tSUM(CASE WHEN b.contracttype='材料采购' THEN b.total/IF(IFNULL(b.conversion_rate,0)=0,1,b.conversion_rate) ELSE 0 END) AS total_cailiao,\r\n\t\t\tSUM(CASE WHEN b.contracttype='分包合同' THEN b.total/IF(IFNULL(b.conversion_rate,0)=0,1,b.conversion_rate) ELSE 0 END) AS total_fenbao\r\n\t\tFROM ld_crmentityrel a\r\n\t\tINNER JOIN ld_purchaseorder b ON b.purchaseorderid=a.relcrmid\r\n\t\tWHERE a.module='Project'\r\n\t\t\tAND a.relmodule='PurchaseOrder'\r\n\t\t\tAND b.deleted=0\r\n\t\t\tAND b.approvestatus<>'已拒绝'\r\n\t\tGROUP BY a.crmid\r\n\t) c ON c.projectid=a.projectid\r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\tSUM(a.total/IF(IFNULL(a.conversion_rate,0)=0,1,a.conversion_rate)) AS total_exec,\r\n\t\t\ta.projectid\r\n\t\tFROM ld_expense a\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\tAND a.projectid>0\r\n\t\tGROUP BY a.projectid\r\n\t) d ON d.projectid=a.projectid\r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\tSUM(a.total/IF(IFNULL(a.conversion_rate,0)=0,1,a.conversion_rate)) AS total_comm,\r\n\t\t\ta.projectid\r\n\t\tFROM ld_commission a\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\tAND a.projectid>0\r\n\t\tGROUP BY a.projectid\r\n\t) e ON e.projectid=a.projectid\r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\ta.crmid AS projectid,\r\n\t\t\tSUM(c.total_cost) AS total_cost\r\n\t\tFROM ld_crmentityrel a\r\n\t\tINNER JOIN ld_purchaseorder b ON b.purchaseorderid=a.relcrmid\r\n\t\tINNER JOIN (\r\n\t\t\tSELECT\r\n\t\t\t\tb.entitytypeid,\r\n\t\t\t\tSUM(b.tax_amount/IF(IFNULL(a.conversion_rate,0)=0,1,a.conversion_rate)) AS total_cost\r\n\t\t\tFROM ld_purchaseinvoice a\r\n\t\t\tLEFT JOIN ld_purchaseinvoicecf c ON c.purchaseinvoiceid=a.purchaseinvoiceid\r\n\t\t\tLEFT JOIN ld_purchaseinvoicedetail b ON b.id=a.purchaseinvoiceid\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND b.entitytypeid>0\r\n\t\t\t\tAND a.purchaseinvoice_type='材料采购发票'\r\n\t\t\t\tAND c.cf_4445='发票'\r\n\t\t\tGROUP BY b.entitytypeid\r\n\t\t) c ON c.entitytypeid=a.relcrmid\r\n\t\tWHERE a.module='Project'\r\n\t\t\tAND a.relmodule='PurchaseOrder'\r\n\t\t\tAND b.deleted=0\r\n\t\t\tAND b.approvestatus<>'已拒绝'\r\n\t\tGROUP BY a.crmid\r\n\t) f ON f.projectid=a.projectid\r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\ta.crmid AS projectid,\r\n\t\t\tSUM(c.total_cost) AS total_cost\r\n\t\tFROM ld_crmentityrel a\r\n\t\tINNER JOIN ld_purchaseorder b ON b.purchaseorderid=a.relcrmid\r\n\t\tINNER JOIN (\r\n\t\t\tSELECT\r\n\t\t\t\tb.entitytypeid,\r\n\t\t\t\tSUM(b.pay_amount/IF(IFNULL(a.conversion_rate,0)=0,1,a.conversion_rate)) AS total_cost\r\n\t\t\tFROM ld_sendcashbill a\r\n\t\t\tLEFT JOIN ld_sendcashbill2payment b ON b.sendcashbillid=a.sendcashbillid\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND b.entitytypeid>0\r\n\t\t\t\tAND a.sendcashbill_type='材料采购付款'\r\n\t\t\tGROUP BY b.entitytypeid\r\n\t\t) c ON c.entitytypeid=a.relcrmid\r\n\t\tWHERE a.module='Project'\r\n\t\t\tAND a.relmodule='PurchaseOrder'\r\n\t\t\tAND b.deleted=0\r\n\t\t\tAND b.approvestatus<>'已拒绝'\r\n\t\tGROUP BY a.crmid\r\n\t) g ON g.projectid=a.projectid\r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\ta.projectid,\r\n\t\t\tSUM(b.tax_amount/IF(IFNULL(a.conversion_rate,0)=0,1,a.conversion_rate)) AS total_cost\r\n\t\tFROM ld_outboundorder a \r\n\t\tLEFT JOIN ld_outboundorderdetail b ON b.id=a.out_id\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tGROUP BY a.projectid\r\n\t) h ON h.projectid=a.projectid\r\n\tINNER JOIN (\r\n\t\tSELECT DISTINCT\r\n\t\t\tuserid \r\n\t\tFROM (\r\n\t\t\tSELECT \r\n\t\t\t\tld_users.id AS userid \r\n\t\t\tFROM ld_users\r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Project' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\tUNION\r\n\t\t\tSELECT \r\n\t\t\t\tviewid AS userid \r\n\t\t\tFROM ld_scoperhigher\r\n\t\t\tWHERE userid='[uuid]' AND modulename ='Project' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename ='Project')\t\t\t\r\n\t\t\tUNION\r\n\t\t\tSELECT DISTINCT \r\n\t\t\t\tld_users2group.userid AS userid \r\n\t\t\tFROM ld_scoperhigher \r\n\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\tAND ld_scoperhigher.modulename ='Project'\r\n\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Project' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\tUNION \r\n\t\t\tSELECT \r\n\t\t\t\tid AS userid \r\n\t\t\tFROM ld_users  \r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\tUNION\r\n\t\t\tSELECT '[uuid]') AS vw_users\r\n\t) AS tmp_users ON tmp_users.userid=a.smownerid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND a.createdtime BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d %H:%i:%s') AND DATE_FORMAT('{end_date}','%Y-%m-%d %H:%i:%s')\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN TRIM('{xmname}')='' THEN 1=1\r\n\t\t\t\tELSE LOCATE(TRIM('{xmname}'),a.projectname)>0\r\n\t\t\tEND) \r\n\t\tAND(\r\n\t\t\tCASE\r\n\t\t\t\tWHEN FIND_IN_SET(1,'{data_range}') OR '{data_range}'='' THEN 1=1\r\n\t\t\t\tWHEN FIND_IN_SET(2,'{data_range}') THEN a.smownerid='[uuid]'\r\n\t\t\t\tELSE \r\n\t\t\t\t\t\t\ta.smownerid IN (\r\n\t\t\t\t\t\t\t\t\tSELECT\r\n\t\t\t\t\t\t\t\t\t\ta.userid\r\n\t\t\t\t\t\t\t\t\tFROM ld_users2group a\r\n\t\t\t\t\t\t\t\t\tINNER JOIN (\r\n\t\t\t\t\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\t\t\t\t\tsubstring_index(substring_index(a.splitsting,',',b.seq+1),',',-1)-200000 AS groupid\r\n\t\t\t\t\t\t\t\t\t\tFROM (SELECT '{data_range}' AS splitsting) a \r\n\t\t\t\t\t\t\t\t\t\tLEFT JOIN sequence b ON b.seq < (length(a.splitsting) - length(replace(a.splitsting,',',''))+1) \r\n\t\t\t\t\t\t\t\t\t\tWHERE substring_index(substring_index(a.splitsting,',',b.seq+1),',',-1) BETWEEN 200000 AND 300000\r\n\t\t\t\t\t\t\t\t\t) b ON b.groupid=a.groupid\r\n\t\t\t\t\t\t\t\t\tGROUP BY a.userid\r\n\t\t\t\t\t\t\t\t\tUNION \r\n\t\t\t\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\t\t\t\tsubstring_index(substring_index(a.splitsting,',',b.seq+1),',',-1)-300000 AS groupid\r\n\t\t\t\t\t\t\t\t\tFROM (SELECT '{data_range}' AS splitsting) a \r\n\t\t\t\t\t\t\t\t\tLEFT JOIN sequence b ON b.seq < (length(a.splitsting) - length(replace(a.splitsting,',',''))+1) \r\n\t\t\t\t\t\t\t\t\tWHERE substring_index(substring_index(a.splitsting,',',b.seq+1),',',-1)>300000\r\n\t\t\t\t\t\t\t)\r\n\t\t\tEND)\r\n) a"
      },
