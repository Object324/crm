          },
          "6": {
            "Name": "total_cailiao",
            "Index": -1,
            "NameInSource": "total_cailiao",
            "Alias": "total_cailiao",
            "Type": "System.Decimal"
          },
          "7": {
            "Name": "total_comm",
            "Index": -1,
