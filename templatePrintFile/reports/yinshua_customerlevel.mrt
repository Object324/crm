    "DataSources": {
      "0": {
        "Ident": "StiMySqlSource",
        "Name": "t8",
        "Alias": "t8",
        "Columns": {
          "0": {
            "Name": "billid",
            "Index": -1,
            "NameInSource": "billid",
            "Alias": "billid",
            "Type": "System.Int32"
          },
          "1": {
            "Name": "billname",
            "Index": -1,
            "NameInSource": "billname",
            "Alias": "billname",
            "Type": "System.String"
          },
          "2": {
            "Name": "billno",
            "Index": -1,
            "NameInSource": "billno",
            "Alias": "billno",
            "Type": "System.String"
          },
          "3": {
            "Name": "kehulevel",
            "Index": -1,
            "NameInSource": "kehulevel",
            "Alias": "kehulevel",
            "Type": "System.String"
          }
        },
        "NameInSource": "yinshua",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\tLEFT('{this[\"SeriesTag\"]}',2) AS kehulevel,\r\n\taccountid AS billid,\r\n\taccountname AS billname,\r\n\taccount_no AS billno\r\nFROM ld_account \r\nWHERE deleted=0 \r\n\tAND cf_2963=LEFT('{this[\"SeriesTag\"]}',2)\r\n\tAND smownerid=RIGHT('{this[\"SeriesTag\"]}',CHAR_LENGTH('{this[\"SeriesTag\"]}')-3)"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "list_user",
        "Alias": "list_user",
        "Columns": {
          "0": {
            "Name": "listid",
            "Index": -1,
            "NameInSource": "listid",
            "Alias": "listid",
            "Type": "System.Int32"
          },
          "1": {
            "Name": "listvalue",
            "Index": -1,
            "NameInSource": "listvalue",
            "Alias": "listvalue",
            "Type": "System.String"
          }
        },
        "NameInSource": "yinshua",
        "SqlCommand": "SELECT\r\n\ta.smownerid AS listid,\r\n\tb.last_name AS listvalue\r\nFROM (\r\n\tSELECT\r\n\t\ta.smownerid\r\n\tFROM ld_account a\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\tGROUP BY a.smownerid\r\n) a\r\nLEFT JOIN ld_users b ON a.smownerid=b.id\r\nORDER BY CONVERT(b.last_name USING GBK)"
      },
      "2": {
        "Ident": "StiMySqlSource",
        "Name": "T",
        "Alias": "T",
        "Columns": {
          "0": {
            "Name": "argument",
            "Index": -1,
            "NameInSource": "argument",
            "Alias": "argument",
            "Type": "System.String"
          },
          "1": {
            "Name": "mytip_1",
            "Index": -1,
            "NameInSource": "mytip_1",
            "Alias": "mytip_1",
            "Type": "System.String"
          },
          "2": {
            "Name": "mytip_2",
            "Index": -1,
            "NameInSource": "mytip_2",
            "Alias": "mytip_2",
            "Type": "System.String"
          },
          "3": {
            "Name": "mytip_3",
            "Index": -1,
            "NameInSource": "mytip_3",
            "Alias": "mytip_3",
            "Type": "System.String"
          },
          "4": {
            "Name": "mytip_4",
            "Index": -1,
            "NameInSource": "mytip_4",
            "Alias": "mytip_4",
            "Type": "System.String"
          },
          "5": {
            "Name": "mytip_5",
            "Index": -1,
            "NameInSource": "mytip_5",
            "Alias": "mytip_5",
            "Type": "System.String"
          },
          "6": {
            "Name": "qty_1",
            "Index": -1,
            "NameInSource": "qty_1",
            "Alias": "qty_1",
            "Type": "System.Int32"
          },
          "7": {
            "Name": "qty_2",
            "Index": -1,
            "NameInSource": "qty_2",
            "Alias": "qty_2",
            "Type": "System.Int32"
          },
          "8": {
            "Name": "qty_3",
            "Index": -1,
            "NameInSource": "qty_3",
            "Alias": "qty_3",
            "Type": "System.Int32"
          },
          "9": {
            "Name": "qty_4",
            "Index": -1,
            "NameInSource": "qty_4",
            "Alias": "qty_4",
            "Type": "System.Int32"
          },
          "10": {
            "Name": "qty_5",
            "Index": -1,
            "NameInSource": "qty_5",
            "Alias": "qty_5",
            "Type": "System.Int32"
          },
          "11": {
            "Name": "smownerid",
            "Index": -1,
            "NameInSource": "smownerid",
            "Alias": "smownerid",
            "Type": "System.Int32"
          },
          "12": {
            "Name": "tag_1",
            "Index": -1,
            "NameInSource": "tag_1",
            "Alias": "tag_1",
            "Type": "System.String"
          },
          "13": {
            "Name": "tag_2",
            "Index": -1,
            "NameInSource": "tag_2",
            "Alias": "tag_2",
            "Type": "System.String"
          },
          "14": {
            "Name": "tag_3",
            "Index": -1,
            "NameInSource": "tag_3",
            "Alias": "tag_3",
            "Type": "System.String"
          },
          "15": {
            "Name": "tag_4",
            "Index": -1,
            "NameInSource": "tag_4",
            "Alias": "tag_4",
            "Type": "System.String"
          },
          "16": {
            "Name": "tag_5",
            "Index": -1,
            "NameInSource": "tag_5",
            "Alias": "tag_5",
            "Type": "System.String"
          }
        },
        "NameInSource": "yinshua",
        "SqlCommand": "SELECT\r\n\ta.smownerid,\r\n\tb.last_name AS argument,\r\n\tIFNULL(c.qty,0) AS qty_1,\r\n\tIFNULL(d.qty,0) AS qty_2,\r\n\tIFNULL(e.qty,0) AS qty_3,\r\n\tIFNULL(f.qty,0) AS qty_4,\r\n\tIFNULL(g.qty,0) AS qty_5,\r\n\tCONCAT('1级-',a.smownerid) AS tag_1,\r\n\tCONCAT('2级-',a.smownerid) AS tag_2,\r\n\tCONCAT('3级-',a.smownerid) AS tag_3,\r\n\tCONCAT('4级-',a.smownerid) AS tag_4,\r\n\tCONCAT('5级-',a.smownerid) AS tag_5,\r\n\tCONCAT('1级 - ',IFNULL(c.qty,0),'个') AS mytip_1,\r\n\tCONCAT('2级 - ',IFNULL(d.qty,0),'个') AS mytip_2,\r\n\tCONCAT('3级 - ',IFNULL(e.qty,0),'个') AS mytip_3,\r\n\tCONCAT('4级 - ',IFNULL(f.qty,0),'个') AS mytip_4,\r\n\tCONCAT('5级 - ',IFNULL(g.qty,0),'个') AS mytip_5\r\nFROM (SELECT smownerid FROM ld_account WHERE deleted=0 GROUP BY smownerid) a\r\nLEFT JOIN ld_users b ON b.id=a.smownerid\r\nLEFT JOIN (\r\n\tSELECT \r\n\t\tsmownerid,\r\n\t\tCOUNT(accountid) AS qty\r\n\tFROM ld_account \r\n\tWHERE deleted=0 \r\n\t\tAND cf_2963='1级' \r\n\tGROUP BY smownerid\r\n) c ON c.smownerid=a.smownerid\r\nLEFT JOIN (\r\n\tSELECT \r\n\t\tsmownerid,\r\n\t\tCOUNT(accountid) AS qty\r\n\tFROM ld_account \r\n\tWHERE deleted=0 \r\n\t\tAND cf_2963='2级' \r\n\tGROUP BY smownerid\r\n) d ON d.smownerid=a.smownerid\r\nLEFT JOIN (\r\n\tSELECT \r\n\t\tsmownerid,\r\n\t\tCOUNT(accountid) AS qty\r\n\tFROM ld_account \r\n\tWHERE deleted=0 \r\n\t\tAND cf_2963='3级' \r\n\tGROUP BY smownerid\r\n) e ON e.smownerid=a.smownerid\r\nLEFT JOIN (\r\n\tSELECT \r\n\t\tsmownerid,\r\n\t\tCOUNT(accountid) AS qty\r\n\tFROM ld_account \r\n\tWHERE deleted=0 \r\n\t\tAND cf_2963='4级' \r\n\tGROUP BY smownerid\r\n) f ON f.smownerid=a.smownerid\r\nLEFT JOIN (\r\n\tSELECT \r\n\t\tsmownerid,\r\n\t\tCOUNT(accountid) AS qty\r\n\tFROM ld_account \r\n\tWHERE deleted=0 \r\n\t\tAND cf_2963='5级' \r\n\tGROUP BY smownerid\r\n) g ON g.smownerid=a.smownerid\r\nINNER JOIN (\r\n\tSELECT\r\n\t\ta.smownerid\r\n\tFROM ld_account a\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\tGROUP BY a.smownerid\r\n) v ON v.smownerid=a.smownerid\r\nWHERE b.status='Active'\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{smowner}'='' THEN 1=1\r\n\t\t\tELSE FIND_IN_SET(a.smownerid,'{smowner}')\r\n\t\tEND)"
      }
    },
    "Databases": {
      "0": {
