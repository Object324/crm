            "Name": "start_port",
            "Index": -1,
            "NameInSource": "start_port",
            "Alias": "start_port",
            "Type": "System.String"
          }
        },
        "NameInSource": "crm",
        "Type": "Table",
        "SqlCommand": "SELECT \r\n\ta.start_port,\r\n\ta.end_port,\r\n\ta.masterorder_receiver,\r\n\ta.masterorder_receiveraddress,\r\n\ta.flight_no,\r\n\tDATE_FORMAT(a.flight_date,'%m月%d日') AS flight_date,\r\n\tCASE\r\n\t\tWHEN a.due_date>'0000-00-00' THEN DATE_FORMAT(a.due_date,'%m月%d日')\r\n\t\tELSE ''\r\n\tEND AS due_date,\r\n\ta.description,\r\n\tGROUP_CONCAT(CASE WHEN d.sf169='' THEN NULL ELSE d.sf169 END SEPARATOR '/') AS hlv_no,\r\n\tGROUP_CONCAT(CASE WHEN c.remark='' THEN NULL ELSE c.remark END SEPARATOR '/') AS remark,\r\n\ta.masterorder_receiver AS shou_name,\r\n\ta.masterorder_receiveraddress AS shou_dizhi,\r\n\ta.masterorder_shipper AS fa_name,\r\n\ta.masterorder_shipperaddress AS fa_dizhi\r\nFROM ld_customform24 a\r\nLEFT JOIN ld_account b ON b.accountid=a.accountid\r\nLEFT JOIN ld_customform24detail c ON c.id=a.customform24id\r\nLEFT JOIN ld_customform24detailscf d ON d.lineitem_id=c.lineitem_id\r\nWHERE a.customform24id='[related_ldcrmid]'"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "b",
        "Alias": "b",
        "Columns": {
          "0": {
            "Name": "chargeweight",
            "Index": -1,
            "NameInSource": "chargeweight",
            "Alias": "chargeweight",
            "Type": "System.Object"
          },
          "1": {
            "Name": "chicun",
            "Index": -1,
            "NameInSource": "chicun",
            "Alias": "chicun",
            "Type": "System.String"
          },
          "2": {
            "Name": "jianshu",
            "Index": -1,
            "NameInSource": "jianshu",
            "Alias": "jianshu",
            "Type": "System.Int32"
          },
          "3": {
            "Name": "maozhong",
            "Index": -1,
            "NameInSource": "maozhong",
            "Alias": "maozhong",
            "Type": "System.Object"
          },
          "4": {
            "Name": "pname",
            "Index": -1,
            "NameInSource": "pname",
            "Alias": "pname",
            "Type": "System.String"
          }
        },
        "NameInSource": "crm",
        "Type": "Table",
        "SqlCommand": "SELECT \r\n\tb.sf171 AS jianshu,\r\n\tb.sf173 AS maozhong,\r\n\tb.sf174 AS chargeweight,\r\n\tb.sf175 AS chicun,\r\n\tCONCAT(b.sf170,' * ',b.sf171) AS pname\r\nFROM ld_customform24detail a\r\nLEFT JOIN ld_customform24detailscf b ON b.lineitem_id=a.lineitem_id\r\nWHERE a.id='[related_ldcrmid]'"
      }
    },
