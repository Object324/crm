            "Index": -1,
            "NameInSource": "shou_dizhi",
            "Alias": "shou_dizhi",
            "Type": "System.String"
          },
          "12": {
            "Name": "shou_name",
            "Index": -1,
            "NameInSource": "shou_name",
            "Alias": "shou_name",
            "Type": "System.String"
          },
