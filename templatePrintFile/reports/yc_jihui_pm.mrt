        "NameInSource": "crm",
        "SqlCommand": "SELECT \r\n\tCONCAT('S4量产项目 总数：',RPAD(s4_qty,4,' '),'，关闭：',RPAD(s4_guanbi,4,' '),'，其中EOL：',RPAD(s4_eol,4,' '),'，非EOL：',\r\n\t\tRPAD(s4_guanbi-s4_eol,4,' '),'；',SPACE(4),'活跃：',s4_qty-s4_guanbi,'，其中量产：',s4_liangchan,'，未量产：',s4_qty-s4_guanbi-s4_liangchan\r\n\t) AS tips_s4,\r\n\tCONCAT('S1销售线索 总数：',RPAD(s1_qty,4,' '),'，关闭：',RPAD(s1_guanbi,4,' '),'，活跃：',RPAD(s1_qty-s1_guanbi,4,' '))  AS tips_s1,\r\n\tCONCAT('S2销售机会 总数：',RPAD(s2_qty,4,' '),'，关闭：',RPAD(s2_guanbi,4,' '),'，活跃：',RPAD(s2_qty-s2_guanbi,4,' '))  AS tips_s2,\r\n\tCONCAT('S3立项项目 总数：',RPAD(s3_qty,4,' '),'，关闭：',RPAD(s3_guanbi,4,' '),'，活跃：',RPAD(s3_qty-s3_guanbi,4,' '))  AS tips_s3\r\nFROM (\r\nSELECT \r\n\t(\r\n\t\tSELECT \r\n\t\t\tCOUNT(1)\r\n\t\tFROm ld_customform21 a\r\n\t\tLEFT JOIN ld_customform21scf b ON b.customform21id=a.customform21id\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN EXISTS (SELECT 1 FROM ld_users WHERE id='[uuid]' AND userlevel IN ('管理员','总经理','副总经理','总监')) THEN 1=1\r\n\t\t\t\t\tWHEN EXISTS (SELECT 1 FROM ld_users WHERE id='[uuid]' AND userlevel IN ('普通成员')) THEN \r\n\t\t\t\t\t\ta.smownerid='[uuid]' OR '[uuid]' IN (SELECT viewuserid FROM ld_tabshare WHERE crmid=a.customform21id)\r\n\t\t\t\t\tWHEN EXISTS (SELECT 1 FROM ld_users WHERE id='[uuid]' AND userlevel IN ('部门经理')) THEN\r\n\t\t\t\t\t\ta.smownerid IN (SELECT userid FROM ld_users2group WHERE groupid IN (SELECT groupid FROM ld_users2group WHERE userid='[uuid]'))\t\t\r\n\t\t\t\t\t\t\tOR '[uuid]' IN (SELECT viewuserid FROM ld_tabshare WHERE crmid=a.customform21id)\r\n\t\t\t\t\tELSE 0=1\r\n\t\t\t\tEND)\r\n\t) AS s4_qty,\r\n\t(\r\n\t\tSELECT \r\n\t\t\tCOUNT(1)\r\n\t\tFROm ld_customform21 a\r\n\t\tLEFT JOIN ld_customform21scf b ON b.customform21id=a.customform21id\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND b.cf_2968='是'\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN EXISTS (SELECT 1 FROM ld_users WHERE id='[uuid]' AND userlevel IN ('管理员','总经理','副总经理','总监')) THEN 1=1\r\n\t\t\t\t\tWHEN EXISTS (SELECT 1 FROM ld_users WHERE id='[uuid]' AND userlevel IN ('普通成员')) THEN \r\n\t\t\t\t\t\ta.smownerid='[uuid]' OR '[uuid]' IN (SELECT viewuserid FROM ld_tabshare WHERE crmid=a.customform21id)\r\n\t\t\t\t\tWHEN EXISTS (SELECT 1 FROM ld_users WHERE id='[uuid]' AND userlevel IN ('部门经理')) THEN\r\n\t\t\t\t\t\ta.smownerid IN (SELECT userid FROM ld_users2group WHERE groupid IN (SELECT groupid FROM ld_users2group WHERE userid='[uuid]'))\t\t\r\n\t\t\t\t\t\t\tOR '[uuid]' IN (SELECT viewuserid FROM ld_tabshare WHERE crmid=a.customform21id)\r\n\t\t\t\t\tELSE 0=1\r\n\t\t\t\tEND)\r\n\t) AS s4_guanbi,\r\n\t(\r\n\t\tSELECT \r\n\t\t\tCOUNT(1)\r\n\t\tFROm ld_customform21 a\r\n\t\tLEFT JOIN ld_customform21scf b ON b.customform21id=a.customform21id\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND b.cf_2968='是'\r\n\t\t\tAND b.cf_3457='EOL'\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN EXISTS (SELECT 1 FROM ld_users WHERE id='[uuid]' AND userlevel IN ('管理员','总经理','副总经理','总监')) THEN 1=1\r\n\t\t\t\t\tWHEN EXISTS (SELECT 1 FROM ld_users WHERE id='[uuid]' AND userlevel IN ('普通成员')) THEN \r\n\t\t\t\t\t\ta.smownerid='[uuid]' OR '[uuid]' IN (SELECT viewuserid FROM ld_tabshare WHERE crmid=a.customform21id)\r\n\t\t\t\t\tWHEN EXISTS (SELECT 1 FROM ld_users WHERE id='[uuid]' AND userlevel IN ('部门经理')) THEN\r\n\t\t\t\t\t\ta.smownerid IN (SELECT userid FROM ld_users2group WHERE groupid IN (SELECT groupid FROM ld_users2group WHERE userid='[uuid]'))\t\t\r\n\t\t\t\t\t\t\tOR '[uuid]' IN (SELECT viewuserid FROM ld_tabshare WHERE crmid=a.customform21id)\r\n\t\t\t\t\tELSE 0=1\r\n\t\t\t\tEND)\r\n\t) AS s4_eol,\r\n\t(\r\n\t\tSELECT \r\n\t\t\tCOUNT(1)\r\n\t\tFROm ld_customform21 a\r\n\t\tLEFT JOIN ld_customform21scf b ON b.customform21id=a.customform21id\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND b.cf_3457='S4'\r\n\t\t\tAND b.cf_2968='否'\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN EXISTS (SELECT 1 FROM ld_users WHERE id='[uuid]' AND userlevel IN ('管理员','总经理','副总经理','总监')) THEN 1=1\r\n\t\t\t\t\tWHEN EXISTS (SELECT 1 FROM ld_users WHERE id='[uuid]' AND userlevel IN ('普通成员')) THEN \r\n\t\t\t\t\t\ta.smownerid='[uuid]' OR '[uuid]' IN (SELECT viewuserid FROM ld_tabshare WHERE crmid=a.customform21id)\r\n\t\t\t\t\tWHEN EXISTS (SELECT 1 FROM ld_users WHERE id='[uuid]' AND userlevel IN ('部门经理')) THEN\r\n\t\t\t\t\t\ta.smownerid IN (SELECT userid FROM ld_users2group WHERE groupid IN (SELECT groupid FROM ld_users2group WHERE userid='[uuid]'))\t\t\r\n\t\t\t\t\t\t\tOR '[uuid]' IN (SELECT viewuserid FROM ld_tabshare WHERE crmid=a.customform21id)\r\n\t\t\t\t\tELSE 0=1\r\n\t\t\t\tEND)\r\n\t) AS s4_liangchan,\r\n\t(\r\n\t\tSELECT \r\n\t\t\tCOUNT(1)\r\n\t\tFROm ld_leads a\r\n\t\tLEFT JOIN ld_leadscf b ON b.leadsid=a.leadsid\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN EXISTS (SELECT 1 FROM ld_users WHERE id='[uuid]' AND userlevel IN ('管理员','总经理','副总经理','总监')) THEN 1=1\r\n\t\t\t\t\tWHEN EXISTS (SELECT 1 FROM ld_users WHERE id='[uuid]' AND userlevel IN ('普通成员')) THEN \r\n\t\t\t\t\t\ta.smownerid='[uuid]' OR '[uuid]' IN (SELECT viewuserid FROM ld_tabshare WHERE crmid=a.leadsid)\r\n\t\t\t\t\tWHEN EXISTS (SELECT 1 FROM ld_users WHERE id='[uuid]' AND userlevel IN ('部门经理')) THEN\r\n\t\t\t\t\t\ta.smownerid IN (SELECT userid FROM ld_users2group WHERE groupid IN (SELECT groupid FROM ld_users2group WHERE userid='[uuid]'))\t\t\r\n\t\t\t\t\t\t\tOR '[uuid]' IN (SELECT viewuserid FROM ld_tabshare WHERE crmid=a.leadsid)\r\n\t\t\t\t\tELSE 0=1\r\n\t\t\t\tEND)\r\n\t) AS s1_qty,\r\n\t(\r\n\t\tSELECT \r\n\t\t\tCOUNT(1)\r\n\t\tFROm ld_leads a\r\n\t\tLEFT JOIN ld_leadscf b ON b.leadsid=a.leadsid\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND b.cf_2995='是'\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN EXISTS (SELECT 1 FROM ld_users WHERE id='[uuid]' AND userlevel IN ('管理员','总经理','副总经理','总监')) THEN 1=1\r\n\t\t\t\t\tWHEN EXISTS (SELECT 1 FROM ld_users WHERE id='[uuid]' AND userlevel IN ('普通成员')) THEN \r\n\t\t\t\t\t\ta.smownerid='[uuid]' OR '[uuid]' IN (SELECT viewuserid FROM ld_tabshare WHERE crmid=a.leadsid)\r\n\t\t\t\t\tWHEN EXISTS (SELECT 1 FROM ld_users WHERE id='[uuid]' AND userlevel IN ('部门经理')) THEN\r\n\t\t\t\t\t\ta.smownerid IN (SELECT userid FROM ld_users2group WHERE groupid IN (SELECT groupid FROM ld_users2group WHERE userid='[uuid]'))\t\t\r\n\t\t\t\t\t\t\tOR '[uuid]' IN (SELECT viewuserid FROM ld_tabshare WHERE crmid=a.leadsid)\r\n\t\t\t\t\tELSE 0=1\r\n\t\t\t\tEND)\r\n\t) AS s1_guanbi,\r\n\t(\r\n\t\tSELECT \r\n\t\t\tCOUNT(1)\r\n\t\tFROm ld_potential a\r\n\t\tLEFT JOIN ld_potentialscf b ON b.potentialid=a.potentialid\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN EXISTS (SELECT 1 FROM ld_users WHERE id='[uuid]' AND userlevel IN ('管理员','总经理','副总经理','总监')) THEN 1=1\r\n\t\t\t\t\tWHEN EXISTS (SELECT 1 FROM ld_users WHERE id='[uuid]' AND userlevel IN ('普通成员')) THEN \r\n\t\t\t\t\t\ta.smownerid='[uuid]' OR '[uuid]' IN (SELECT viewuserid FROM ld_tabshare WHERE crmid=a.potentialid)\r\n\t\t\t\t\tWHEN EXISTS (SELECT 1 FROM ld_users WHERE id='[uuid]' AND userlevel IN ('部门经理')) THEN\r\n\t\t\t\t\t\ta.smownerid IN (SELECT userid FROM ld_users2group WHERE groupid IN (SELECT groupid FROM ld_users2group WHERE userid='[uuid]'))\t\t\r\n\t\t\t\t\t\t\tOR '[uuid]' IN (SELECT viewuserid FROM ld_tabshare WHERE crmid=a.potentialid)\r\n\t\t\t\t\tELSE 0=1\r\n\t\t\t\tEND)\r\n\t) AS s2_qty,\r\n\t(\r\n\t\tSELECT \r\n\t\t\tCOUNT(1)\r\n\t\tFROm ld_potential a\r\n\t\tLEFT JOIN ld_potentialscf b ON b.potentialid=a.potentialid\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND b.cf_3340='是'\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN EXISTS (SELECT 1 FROM ld_users WHERE id='[uuid]' AND userlevel IN ('管理员','总经理','副总经理','总监')) THEN 1=1\r\n\t\t\t\t\tWHEN EXISTS (SELECT 1 FROM ld_users WHERE id='[uuid]' AND userlevel IN ('普通成员')) THEN \r\n\t\t\t\t\t\ta.smownerid='[uuid]' OR '[uuid]' IN (SELECT viewuserid FROM ld_tabshare WHERE crmid=a.potentialid)\r\n\t\t\t\t\tWHEN EXISTS (SELECT 1 FROM ld_users WHERE id='[uuid]' AND userlevel IN ('部门经理')) THEN\r\n\t\t\t\t\t\ta.smownerid IN (SELECT userid FROM ld_users2group WHERE groupid IN (SELECT groupid FROM ld_users2group WHERE userid='[uuid]'))\t\t\r\n\t\t\t\t\t\t\tOR '[uuid]' IN (SELECT viewuserid FROM ld_tabshare WHERE crmid=a.potentialid)\r\n\t\t\t\t\tELSE 0=1\r\n\t\t\t\tEND)\r\n\t) AS s2_guanbi,\r\n\t(\r\n\t\tSELECT \r\n\t\t\tCOUNT(1)\r\n\t\tFROm ld_customform22 a\r\n\t\tLEFT JOIN ld_customform22scf b ON b.customform22id=a.customform22id\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN EXISTS (SELECT 1 FROM ld_users WHERE id='[uuid]' AND userlevel IN ('管理员','总经理','副总经理','总监')) THEN 1=1\r\n\t\t\t\t\tWHEN EXISTS (SELECT 1 FROM ld_users WHERE id='[uuid]' AND userlevel IN ('普通成员')) THEN \r\n\t\t\t\t\t\ta.smownerid='[uuid]' OR '[uuid]' IN (SELECT viewuserid FROM ld_tabshare WHERE crmid=a.customform22id)\r\n\t\t\t\t\tWHEN EXISTS (SELECT 1 FROM ld_users WHERE id='[uuid]' AND userlevel IN ('部门经理')) THEN\r\n\t\t\t\t\t\ta.smownerid IN (SELECT userid FROM ld_users2group WHERE groupid IN (SELECT groupid FROM ld_users2group WHERE userid='[uuid]'))\t\t\r\n\t\t\t\t\t\t\tOR '[uuid]' IN (SELECT viewuserid FROM ld_tabshare WHERE crmid=a.customform22id)\r\n\t\t\t\t\tELSE 0=1\r\n\t\t\t\tEND)\r\n\t) AS s3_qty,\r\n\t(\r\n\t\tSELECT \r\n\t\t\tCOUNT(1)\r\n\t\tFROm ld_customform22 a\r\n\t\tLEFT JOIN ld_customform22scf b ON b.customform22id=a.customform22id\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND b.cf_3077='是'\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN EXISTS (SELECT 1 FROM ld_users WHERE id='[uuid]' AND userlevel IN ('管理员','总经理','副总经理','总监')) THEN 1=1\r\n\t\t\t\t\tWHEN EXISTS (SELECT 1 FROM ld_users WHERE id='[uuid]' AND userlevel IN ('普通成员')) THEN \r\n\t\t\t\t\t\ta.smownerid='[uuid]' OR '[uuid]' IN (SELECT viewuserid FROM ld_tabshare WHERE crmid=a.customform22id)\r\n\t\t\t\t\tWHEN EXISTS (SELECT 1 FROM ld_users WHERE id='[uuid]' AND userlevel IN ('部门经理')) THEN\r\n\t\t\t\t\t\ta.smownerid IN (SELECT userid FROM ld_users2group WHERE groupid IN (SELECT groupid FROM ld_users2group WHERE userid='[uuid]'))\t\t\r\n\t\t\t\t\t\t\tOR '[uuid]' IN (SELECT viewuserid FROM ld_tabshare WHERE crmid=a.customform22id)\r\n\t\t\t\t\tELSE 0=1\r\n\t\t\t\tEND)\r\n\t) AS s3_guanbi\r\n) t"
