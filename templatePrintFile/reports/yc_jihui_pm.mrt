        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\tDATE_FORMAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 11 MONTH),'%b-%y') AS la01,\r\n\tDATE_FORMAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 10 MONTH),'%b-%y') AS la02,\r\n\tDATE_FORMAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 9 MONTH),'%b-%y') AS la03,\r\n\tDATE_FORMAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 8 MONTH),'%b-%y') AS la04,\r\n\tDATE_FORMAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 7 MONTH),'%b-%y') AS la05,\r\n\tDATE_FORMAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 6 MONTH),'%b-%y') AS la06,\r\n\tDATE_FORMAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 5 MONTH),'%b-%y') AS la07,\r\n\tDATE_FORMAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 4 MONTH),'%b-%y') AS la08,\r\n\tDATE_FORMAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 3 MONTH),'%b-%y') AS la09,\r\n\tDATE_FORMAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 2 MONTH),'%b-%y') AS la10,\r\n\tDATE_FORMAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 1 MONTH),'%b-%y') AS la11,\r\n\tDATE_FORMAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 0 MONTH),'%b-%y') AS la12,\r\n\r\n\tDATE_FORMAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 11 MONTH),'%y年%c月') AS lb01,\r\n\tDATE_FORMAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 10 MONTH),'%y年%c月') AS lb02,\r\n\tDATE_FORMAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 9 MONTH),'%y年%c月') AS lb03,\r\n\tDATE_FORMAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 8 MONTH),'%y年%c月') AS lb04,\r\n\tDATE_FORMAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 7 MONTH),'%y年%c月') AS lb05,\r\n\tDATE_FORMAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 6 MONTH),'%y年%c月') AS lb06,\r\n\tDATE_FORMAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 5 MONTH),'%y年%c月') AS lb07,\r\n\tDATE_FORMAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 4 MONTH),'%y年%c月') AS lb08,\r\n\tDATE_FORMAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 3 MONTH),'%y年%c月') AS lb09,\r\n\tDATE_FORMAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 2 MONTH),'%y年%c月') AS lb10,\r\n\tDATE_FORMAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 1 MONTH),'%y年%c月') AS lb11,\r\n\tDATE_FORMAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 0 MONTH),'%y年%c月') AS lb12,\r\n\r\n\tCASE \r\n\t\tWHEN EXISTS (SELECT 1 FROM ld_customform03 WHERE deleted=0 AND YEAR(yuce_date)='{nian}' AND MONTH(yuce_date)='{yue}') THEN\r\n\t\t\tDATE_FORMAT(DATE_ADD(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 1 MONTH),'%b-%y') \r\n\t\tELSE \r\n\t\t\tDATE_FORMAT(DATE_ADD(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 0 MONTH),'%b-%y')\r\n\tEND AS lc01,\r\n\tCASE \r\n\t\tWHEN EXISTS (SELECT 1 FROM ld_customform03 WHERE deleted=0 AND YEAR(yuce_date)='{nian}' AND MONTH(yuce_date)='{yue}') THEN\r\n\t\t\tDATE_FORMAT(DATE_ADD(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 2 MONTH),'%b-%y') \r\n\t\tELSE \r\n\t\t\tDATE_FORMAT(DATE_ADD(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 1 MONTH),'%b-%y')\r\n\tEND AS lc02,\r\n\tCASE \r\n\t\tWHEN EXISTS (SELECT 1 FROM ld_customform03 WHERE deleted=0 AND YEAR(yuce_date)='{nian}' AND MONTH(yuce_date)='{yue}') THEN\r\n\t\t\tDATE_FORMAT(DATE_ADD(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 3 MONTH),'%b-%y') \r\n\t\tELSE \r\n\t\t\tDATE_FORMAT(DATE_ADD(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 2 MONTH),'%b-%y')\r\n\tEND AS lc03,\r\n\tCASE \r\n\t\tWHEN EXISTS (SELECT 1 FROM ld_customform03 WHERE deleted=0 AND YEAR(yuce_date)='{nian}' AND MONTH(yuce_date)='{yue}') THEN\r\n\t\t\tDATE_FORMAT(DATE_ADD(CONCAT('{nian}',