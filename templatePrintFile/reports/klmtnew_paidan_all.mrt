            "Type": "System.DateTime"
          },
          "11": {
            "Name": "shiji_arrive_time",
            "Index": -1,
            "NameInSource": "shiji_arrive_time",
            "Alias": "shiji_arrive_time",
            "Type": "System.DateTime"
          },
          "12": {
            "Name": "shiji_donetime",
            "Index": -1,
            "NameInSource": "shiji_donetime",
            "Alias": "shiji_donetime",
            "Type": "System.DateTime"
          }
        },
        "NameInSource": "ldcrm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\ta.ticketid AS orderid,\r\n\tc.potentialname AS ccf_no,\r\n\tu.last_name AS servicer,\r\n\ta.smownerid,\r\n\td.accountname,\r\n\td.bill_street,\r\n\tc.createdtime AS ccf_createdtime,\r\n\tb.cf_2391 AS waichu_type,\r\n\ta.hopetime AS xiwang_arrive_time,\r\n\ta.finishtime AS yuji_done_time,\r\n\ta.sendtime AS paidan_time,\r\n\tCASE\r\n\t\tWHEN b.cf_2391='调试' THEN ts.debug_startdate\r\n\t\tELSE wx.arrive_time\r\n\tEND AS shiji_arrive_time,\r\n\tCASE\r\n\t\tWHEN b.cf_2391='调试' THEN ts.debug_enddate\r\n\t\tELSE wx.finishtime\r\n\tEND AS shiji_donetime\r\nFROM ld_troubletickets a\r\nLEFT JOIN ld_ticketcf b ON a.ticketid=b.ticketid\r\nLEFT JOIN ld_potential c ON c.potentialid=a.potentialid\r\nLEFT JOIN ld_account d ON d.accountid=a.accountid\r\nLEFT JOIN ld_users u ON u.id=a.smownerid\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\ta.potentialid,\r\n\t\tMAX(b.realtime) AS arrive_time,\r\n\t\tMAX(b.finishtime) AS finishtime\r\n\tFROM ld_outboundorder a\r\n\tLEFT JOIN ld_outboundordercf b ON a.out_id=b.out_id\r\n\tWHERE a.deleted=0\r\n\t\tAND a.potentialid>0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND IFNULL(b.cf_2376,'')<>'作废单据'\r\n\tGROUP BY potentialid\r\n) wx ON wx.potentialid=a.potentialid\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\ta.potentialid,\r\n\t\ta.debug_startdate,\r\n\t\ta.debug_enddate\r\n\tFROM ld_contactrecords a\r\n\tLEFT JOIN ld_contactrecordscf b ON b.contactrecordid=a.contactrecordID\r\n\tWHERE a.deleted=0\r\n\t\tAND a.potentialid>0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND IFNULL(b.cf_2377,'')<>'作废单据'\r\n\tGROUP BY potentialid\r\n) ts ON ts.potentialid=a.potentialid\r\nINNER JOIN (\r\n\tSELECT DISTINCT\r\n\t\tuserid \r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\tld_users.id AS userid \r\n\t\tFROM ld_users\r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='HelpDesk' and scopeauthority=1 AND userid='[uuid]')\r\n\t\tUNION\r\n\t\tSELECT \r\n\t\t\tviewid AS userid \r\n\t\tFROM ld_scoperhigher\r\n\t\tWHERE userid='[uuid]' AND modulename='HelpDesk' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename='HelpDesk')\t\t\t\r\n\t\tUNION\r\n\t\tSELECT DISTINCT \r\n\t\t\tld_users2group.userid AS userid \r\n\t\tFROM ld_scoperhigher \r\n\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\tAND ld_scoperhigher.modulename='HelpDesk'\r\n\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='HelpDesk' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\tUNION \r\n\t\tSELECT \r\n\t\t\tid AS userid \r\n\t\tFROM ld_users  \r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\tUNION\r\n\t\tSELECT '[uuid]') AS vw_users\r\n) AS list_user ON list_user.userid=a.smownerid\r\nWHERE a.deleted=0\r\n\tAND a.approvestatus<>'已拒绝'\r\n\tAND IFNULL(b.cf_2373,'')<>'作废单据'\r\n\tAND IFNULL(a.sendtime,a.createdtime) BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d 00:00:00') AND DATE_FORMAT('{end_date}','%Y-%m-%d 23:59:59')\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{userid}'='' THEN 1=1\r\n\t\t\tELSE FIND_IN_SET(a.smownerid,'{userid}')\r\n\t\tEND)\r\nORDER BY CONVERT(u.last_name USING GBK),a.sendtime,a.createdtime"
      }
    },
