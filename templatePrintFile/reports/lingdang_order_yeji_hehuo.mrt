        "Type": "Table",
        "SqlCommand": "CALL lingdang_yeji_hehuo('{shijian}','{start_date}','{end_date}','{custname}','{data_range}','{include_chong}','{just_approved}','{yeji_type}','[uuid]')"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "list_users",
        "Alias": "list_users",
        "Columns": {
          "0": {
            "Name": "list_order",
            "Index": -1,
            "NameInSource": "list_order",
            "Alias": "list_order",
            "Type": "System.String"
          },
          "1": {
            "Name": "listid",
            "Index": -1,
            "NameInSource": "listid",
            "Alias": "listid",
            "Type": "System.Int32"
          },
          "2": {
            "Name": "listtype",
            "Index": -1,
            "NameInSource": "listtype",
            "Alias": "listtype",
            "Type": "System.Decimal"
          },
          "3": {
            "Name": "listvalue",
            "Index": -1,
            "NameInSource": "listvalue",
            "Alias": "listvalue",
            "Type": "System.String"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT 1 AS listid,'全部' AS listvalue,0 AS list_order,1 AS listtype\r\nUNION\r\nSELECT 2 AS listid, '我负责的' AS listvalue,0 AS list_order,2 AS listtype\r\nUNION (\r\n\tSELECT\r\n\t\ta.groupid+200000 AS listid,\r\n\t\tCONCAT('部门::',IFNULL(a.groupname,'')) AS listvalue,\r\n\t\tGROUP_CONCAT(IFNULL(a.splitsting,'') ORDER BY a.splitsting SEPARATOR '::') AS listorder,\r\n\t\t1 AS listtype\r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\ta.groupid, \r\n\t\t\ta.groupname, \r\n\t\t\tLPAD(substring_index(substring_index(a.splitsting,',',b.seq+1),',',-1),8,'0') AS splitsting\r\n\t\tFROM (\r\n\t\t\tSELECT \r\n\t\t\t\ta.groupid,\r\n\t\t\t\ta.groupname, \r\n\t\t\t\tREPLACE(a.parentgroup,'::',',') AS splitsting \r\n\t\t\tFROM ld_groups a\r\n\t\t\tLEFT JOIN ld_users2group b ON b.groupid=a.groupid\r\n\t\t\tGROUP BY a.groupid\r\n\t\t) a \r\n\t\tLEFT JOIN sequence b ON b.seq < (length(a.splitsting) - length(replace(a.splitsting,',',''))+1)\r\n\t) a\r\n\tGROUP BY a.groupid\r\n)\r\nUNION (\r\n\tSELECT\r\n\t\ta.id+300000 AS listid,\r\n\t\tCONCAT('用户::',IFNULL(a.last_name,''),'(',c.listvalue,')') AS listvalue,\r\n\t\tc.listorder,\r\n\t\t2 AS listtype\r\n\tFROM ld_users a\r\n\tLEFT JOIN ld_users2group b ON b.userid=a.id  \r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\ta.groupid,\r\n\t\t\ta.groupid+200000 AS listid,\r\n\t\t\tCONCAT('部门::',IFNULL(a.groupname,'')) AS listvalue,\r\n\t\t\tGROUP_CONCAT(IFNULL(a.splitsting,'') ORDER BY a.splitsting SEPARATOR '::') AS listorder\r\n\t\tFROM (\r\n\t\t\tSELECT \r\n\t\t\t\ta.groupid, \r\n\t\t\t\ta.groupname, \r\n\t\t\t\tLPAD(substring_index(substring_index(a.splitsting,',',b.seq+1),',',-1),8,'0') AS splitsting\r\n\t\t\tFROM (\r\n\t\t\t\tSELECT \r\n\t\t\t\t\ta.groupid,\r\n\t\t\t\t\ta.groupname, \r\n\t\t\t\t\tREPLACE(a.parentgroup,'::',',') AS splitsting \r\n\t\t\t\tFROM ld_groups a\r\n\t\t\t\tLEFT JOIN ld_users2group b ON b.groupid=a.groupid\r\n\t\t\t\tGROUP BY a.groupid\r\n\t\t\t) a \r\n\t\t\tLEFT JOIN sequence b ON b.seq < (length(a.splitsting) - length(replace(a.splitsting,',',''))+1)\r\n\t\t) a\r\n\t\tGROUP BY a.groupid\r\n\t) c ON c.groupid=b.groupid\r\n\tINNER JOIN (\r\n\t\tSELECT DISTINCT\r\n\t\t\tuserid \r\n\t\tFROM (\r\n\t\t\tSELECT \r\n\t\t\t\tld_users.id AS userid \r\n\t\t\tFROM ld_users\r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='CashBill' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\tUNION\r\n\t\t\tSELECT \r\n\t\t\t\tviewid AS userid \r\n\t\t\tFROM ld_scoperhigher\r\n\t\t\tWHERE userid='[uuid]' AND modulename ='CashBill' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename ='CashBill')\t\t\t\r\n\t\t\tUNION\r\n\t\t\tSELECT DISTINCT \r\n\t\t\t\tld_users2group.userid AS userid \r\n\t\t\tFROM ld_scoperhigher \r\n\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\tAND ld_scoperhigher.modulename ='CashBill'\r\n\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='CashBill' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\tUNION \r\n\t\t\tSELECT \r\n\t\t\t\tid AS userid \r\n\t\t\tFROM ld_users  \r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\tUNION\r\n\t\t\tSELECT '[uuid]') AS vw_users\r\n\t) AS tmp_users ON tmp_users.userid=a.id\r\n\tWHERE a.deleted=0\r\n\t\tAND a.`status`='Active'\r\n)\r\nORDER BY list_order,listtype"
      },
      "2": {
        "Ident": "StiMySqlSource",
        "Name": "list_date",
        "Alias": "list_date",
        "Columns": {
          "0": {
            "Name": "enddate",
            "Index": -1,
            "NameInSource": "enddate",
            "Alias": "enddate",
            "Type": "System.String"
          },
          "1": {
            "Name": "listid",
            "Index": -1,
            "NameInSource": "listid",
            "Alias": "listid",
            "Type": "System.Int32"
          },
          "2": {
            "Name": "listvalue",
            "Index": -1,
            "NameInSource": "listvalue",
            "Alias": "listvalue",
            "Type": "System.String"
          },
          "3": {
            "Name": "startdate",
            "Index": -1,
            "NameInSource": "startdate",
            "Alias": "startdate",
            "Type": "System.String"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\t1 AS listid,\r\n\t'今日' AS listvalue,\r\n\tCURDATE() AS startdate,\r\n\tCURDATE() AS enddate\r\nUNION\r\nSELECT\r\n\t2 AS listid,\r\n\t'昨日' AS listvalue,\r\n\tDATE_SUB(CURDATE(),INTERVAL 1 DAY) AS startdate,\r\n\tDATE_SUB(CURDATE(),INTERVAL 1 DAY) AS enddate\r\nUNION\r\nSELECT\r\n\t3 AS listid,\r\n\t'本周' AS listvalue,\r\n\tDATE_SUB(CURDATE(),INTERVAL WEEKDAY(CURDATE()) DAY) AS startdate,\r\n\tDATE_SUB(CURDATE(),INTERVAL WEEKDAY(CURDATE())-6 DAY) AS enddate\r\nUNION\r\nSELECT\r\n\t4 AS listid,\r\n\t'上周' AS listvalue,\r\n\tDATE_SUB(CURDATE(),INTERVAL WEEKDAY(CURDATE())+7 DAY) AS startdate,\r\n\tDATE_SUB(CURDATE(),INTERVAL WEEKDAY(CURDATE())-6+7 DAY) AS enddate\r\nUNION\r\nSELECT\r\n\t5 AS listid,\r\n\t'本月' AS listvalue,\r\n\tDATE_SUB(CURDATE(),INTERVAL DAY(CURDATE())-1 DAY) AS startdate,\r\n\tLAST_DAY(DATE_SUB(CURDATE(),INTERVAL DAY(CURDATE())-1 DAY)) AS enddate\r\nUNION\r\nSELECT\r\n\t6 AS listid,\r\n\t'上月' AS listvalue,\r\n\tDATE_SUB(DATE_SUB(CURDATE(),INTERVAL DAY(CURDATE())-1 DAY),INTERVAL 1 MONTH) AS startdate,\r\n\tLAST_DAY(DATE_SUB(CURDATE(),INTERVAL DAY(CURDATE()) DAY)) AS enddate\r\nUNION\r\nSELECT\r\n\t7 AS listid,\r\n\t'本季度' AS listvalue,\r\n\tDATE_ADD(CONCAT(YEAR(CURDATE()),'-01-01'),INTERVAL QUARTER(CURDATE())*3-3 MONTH) AS startdate,\r\n\t LAST_DAY(DATE_ADD(CONCAT(YEAR(CURDATE()),'-01-01'),INTERVAL QUARTER(CURDATE())*3-3+2 MONTH)) AS enddate\r\nUNION\r\nSELECT\r\n\t8 AS listid,\r\n\t'上季度' AS listvalue,\r\n\tDATE_ADD(CONCAT(YEAR(CURDATE()),'-01-01'),INTERVAL QUARTER(CURDATE())*3-6 MONTH) AS startdate,\r\n\t LAST_DAY(DATE_ADD(CONCAT(YEAR(CURDATE()),'-01-01'),INTERVAL QUARTER(CURDATE())*3-6+2 MONTH)) AS enddate\r\nUNION\r\nSELECT\r\n\t9 AS listid,\r\n\t'本年' AS listvalue,\r\n\tCONCAT(YEAR(CURDATE()),'-01-01') AS startdate,\r\n\tCONCAT(YEAR(CURDATE()),'-12-31') AS enddate\r\nUNION\r\nSELECT\r\n\t10 AS listid,\r\n\t'去年' AS listvalue,\r\n\tCONCAT(YEAR(CURDATE())-1,'-01-01') AS startdate,\r\n\tCONCAT(YEAR(CURDATE())-1,'-12-31') AS enddate\r\nUNION\r\nSELECT\r\n\t11 AS listid,\r\n\t'自定义' AS listvalue,\r\n\tCURDATE() AS startdate,\r\n\tCURDATE() AS enddate"
      }
    },
