            "Alias": "vendor_no",
            "Type": "System.String"
          },
          "18": {
            "Name": "wcpd_date",
            "Index": -1,
            "NameInSource": "wcpd_date",
            "Alias": "wcpd_date",
            "Type": "System.DateTime"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\td.vendor_no,\r\n\tc.productcategory,\r\n\tf.big_area,\r\n\te.potentialname as potential_no,\r\n\tf.unit_module,\r\n\tc.productname,\r\n\ta.debug_startdate,\r\n\ta.debug_enddate,\r\n\tu.last_name,\r\n\tg.accountname,\r\n\tg.bill_street,\r\na.description,\r\n\th.lastname AS lianxiren,\r\n\th.mobile,\r\n\t\r\n\tc.fist_servicedate,\r\n\tb.sendtime AS wcpd_date,\r\n\ta.createdtime AS ts_billdate,\r\n\tROUND(DATEDIFF(a.debug_enddate,i.createdtime),0) AS MTTR,\r\n\tROUND(DATEDIFF(i.createdtime,e.createdtime),0) AS ETTR\r\nFROM ld_contactrecords a\r\nLEFT JOIN ld_contactrecordscf b ON a.contactrecordID=b.contactrecordid\r\nLEFT JOIN ld_products c ON c.productid=a.product_id\r\nLEFT JOIN ld_vendor d ON d.vendorid=c.vendorid\r\nLEFT JOIN ld_potential e ON e.potentialid=a.potentialid AND e.deleted=0 AND e.approvestatus<>'已拒绝'\r\nLEFT JOIN ld_potentialscf f ON f.potentialid=e.potentialid AND IFNULL(f.cf_2372,'')<>'已作废'\r\nLEFT JOIN ld_users u ON u.id=a.smcreatorid\r\nLEFT JOIN ld_account g ON g.accountid=c.realaccountid\r\nLEFT JOIN ld_contactdetails h ON h.contactid=a.contactid\r\nLEFT JOIN ld_troubletickets i ON i.ticketid=a.troubleticketid AND i.deleted=0 AND i.approvestatus<>'已拒绝'\r\nLEFT JOIN ld_ticketcf j ON j.ticketid=i.ticketid AND IFNULL(j.cf_2373,'')<>'已作废'\r\n\r\nWHERE a.deleted=0\r\n\tAND a.approvestatus<>'已拒绝'\r\n\tAND a.debug_startdate BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\tAND a.debug_enddate BETWEEN DATE_FORMAT('{startdate}','%Y-%m-%d') AND DATE_FORMAT('{enddate}','%Y-%m-%d')\r\n\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{itemtype}'='' THEN 1=1\r\n\t\t\t\tELSE FIND_IN_SET(c.productcategory,'{itemtype}')\r\n\t\t\tEND)\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{quyu}'='' THEN 1=1\r\n\t\t\t\tELSE FIND_IN_SET(f.big_area,'{quyu}')\r\n\t\t\tEND)\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{vendor_no}'='' THEN 1=1\r\n\t\t\t\tELSE FIND_IN_SET(d.vendor_no,'{vendor_no}')\r\n\t\t\tEND)\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{userid}'='' THEN 1=1\r\n\t\t\t\tELSE FIND_IN_SET(a.smcreatorid,'{userid}')\r\n\t\t\tEND)"
      }
    },
