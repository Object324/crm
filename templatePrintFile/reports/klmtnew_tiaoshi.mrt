            "NameInSource": "ts_billdate",
            "Alias": "ts_billdate",
            "Type": "System.DateTime"
          },
          "16": {
            "Name": "unit_module",
            "Index": -1,
            "NameInSource": "unit_module",
            "Alias": "unit_module",
            "Type": "System.String"
          },
          "17": {
