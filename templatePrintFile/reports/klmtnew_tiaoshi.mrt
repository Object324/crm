            "9": {
              "Ident": "StiText",
              "Name": "Text49",
              "Guid": "710db473f6faa0f9d6ec52d4a4ec8b7a",
              "ClientRectangle": "47.6,0,1.8,1.2",
              "Interaction": {
                "Ident": "StiInteraction"
