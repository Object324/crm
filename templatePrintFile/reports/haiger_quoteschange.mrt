        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\t(SELECT\r\n\t\ta.quote_version\r\n\tFROM ld_quotes a\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND a.potentialid=(SELECT potentialid FROM ld_quotes WHERE quoteid='[related_ldcrmid]')\r\n\tORDER BY a.quote_version+0 DESC,a.quoteid DESC LIMIT 1) AS L1,\r\n\t(SELECT\r\n\t\ta.quote_version\r\n\tFROM ld_quotes a\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND a.potentialid=(SELECT potentialid FROM ld_quotes WHERE quoteid='[related_ldcrmid]')\r\n\tORDER BY a.quote_version+0 DESC,a.quoteid DESC LIMIT 1,1) AS L2"
      },
