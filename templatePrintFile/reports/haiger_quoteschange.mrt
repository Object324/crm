        "NameInSource": "crm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\tCASE\r\n\t\tWHEN b.profilename IN ('销售人员','办事处经理','销售助理','大区经理','TSE') THEN 1\r\n\t\tELSE 2\r\n\tEND AS info_type\r\nFROM ld_users a\r\nLEFT JOIN ld_profile b ON b.profileid=a.profileid\r\nWHERE a.id='[uuid]'"
      }
    },
