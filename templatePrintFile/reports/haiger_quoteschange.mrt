            "Type": "System.String"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\ta.productgroup_name AS chanpinzu,\r\n\tt1.zhekou,\r\n\tt1.amount,\r\n\tt1.gcm,\r\n\tt1.spe,\r\n\tt2.zhekou AS zhekou_02,\r\n\tt2.amount AS amount_02,\r\n\tt2.gcm AS gcm_02,\r\n\tt2.spe AS spe_02\r\nFROM (\r\n\tSELECT\r\n\t\tproductgroup_name,\r\n\t\t1 AS seqtype\r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\tIFNULL(c.productgroup_name,'') AS productgroup_name \r\n\t\tFROM (\r\n\t\t\tSELECT\r\n\t\t\t\ta.quoteid,\r\n\t\t\t\ta.quote_version\r\n\t\t\tFROM ld_quotes a\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND a.potentialid=(SELECT potentialid FROM ld_quotes WHERE quoteid='[related_ldcrmid]')\r\n\t\t\tORDER BY a.quote_version+0 DESC,a.quoteid DESC LIMIT 2\r\n\t\t) a\r\n\t\tLEFT JOIN ld_quotesdetail b ON b.id=a.quoteid\r\n\t\tLEFT JOIN ld_products c ON c.productid=b.productid\r\n\t) a\r\n\tGROUP BY productgroup_name\r\n\tUNION \r\n\tSELECT '整单',2\r\n) a\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\tproductgroup_name AS chanpinzu,\r\n\t\tIFNULL(CONCAT(FORMAT(100-SUM(tax_amount)*100/SUM(quantity*IFNULL(standardprice,0)),2),'%'),'') AS zhekou,\r\n\t\tIFNULL(FORMAT(SUM(tax_amount),2),'') AS amount,\r\n\t\tIFNULL(CONCAT(FORMAT((1-SUM(gcm*quantity)/SUM(tax_amount))*100,2),'%'),'') AS gcm,\r\n\t\tIFNULL(CONCAT(FORMAT((SUM((CASE WHEN avge_price=0 THEN 0 ELSE taxprice END)*quantity)/SUM(quantity*IFNULL(avge_price,0))-1)*100,2),'%'),'') AS spe\r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\ta.quantity,\r\n\t\t\tIFNULL(b.productgroup_name,'') AS productgroup_name,\r\n\t\t\ta.tax_amount,\r\n\t\t\ta.taxprice,\r\n\t\t\tb.gcm_cost AS gcm,\r\n\t\t\tIFNULL(standardprice,0) AS standardprice,\r\n\t\t\tIFNULL(a.avgeprice,0) AS avge_price\r\n\t\tFROM ld_quotesdetail a\r\n\t\tLEFT JOIN ld_products b On b.productid=a.productid\r\n\t\tLEFT JOIN ld_quotes q ON q.quoteid=a.id\r\n\t\tWHERE a.id=(\r\n\t\t\t\tSELECT \r\n\t\t\t\t\tquoteid \r\n\t\t\t\tFROM ld_quotes\r\n\t\t\t\tWHERE deleted=0\r\n\t\t\t\t\tAND approvestatus<>'已拒绝'\r\n\t\t\t\t\tAND potentialid=(SELECT potentialid FROM ld_quotes WHERE quoteid='[related_ldcrmid]')\r\n\t\t\t\tORDER BY quote_version+0 DESC,quoteid DESC LIMIT 1\r\n\t\t\t)\r\n\t) t\r\n\tGROUP BY productgroup_name\r\n\tUNION\r\n\tSELECT\r\n\t\t'整单',\r\n\t\tIFNULL(CONCAT(FORMAT(100-SUM(tax_amount)*100/SUM(quantity*IFNULL(standardprice,0)),2),'%'),''),\r\n\t\tIFNULL(FORMAT(SUM(tax_amount),2),''),\r\n\t\tIFNULL(CONCAT(FORMAT((1-SUM(gcm*quantity)/SUM(tax_amount))*100,2),'%'),''),\r\n\t\tIFNULL(CONCAT(FORMAT((SUM((CASE WHEN avge_price=0 THEN 0 ELSE taxprice END)*quantity)/SUM(quantity*IFNULL(avge_price,0))-1)*100,2),'%'),'')\r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\ta.quantity,\r\n\t\t\tIFNULL(b.productgroup_name,'') AS productgroup_name,\r\n\t\t\ta.tax_amount,\r\n\t\t\ta.taxprice,\r\n\t\t\tb.gcm_cost AS gcm,\r\n\t\t\tIFNULL(standardprice,0) AS standardprice,\r\n\t\t\tIFNULL(a.avgeprice,0) AS avge_price\r\n\t\tFROM ld_quotesdetail a\r\n\t\tLEFT JOIN ld_products b On b.productid=a.productid\r\n\t\tLEFT JOIN ld_quotes q ON q.quoteid=a.id\r\n\t\tWHERE a.id=(\r\n\t\t\t\tSELECT \r\n\t\t\t\t\tquoteid \r\n\t\t\t\tFROM ld_quotes\r\n\t\t\t\tWHERE deleted=0\r\n\t\t\t\t\tAND approvestatus<>'已拒绝'\r\n\t\t\t\t\tAND potentialid=(SELECT potentialid FROM ld_quotes WHERE quoteid='[related_ldcrmid]')\r\n\t\t\t\tORDER BY quote_version+0 DESC,quoteid DESC LIMIT 1\r\n\t\t\t)\r\n\t) t\r\n) t1 ON t1.chanpinzu=a.productgroup_name\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\tproductgroup_name AS chanpinzu,\r\n\t\tIFNULL(CONCAT(FORMAT(100-SUM(tax_amount)*100/SUM(quantity*IFNULL(standardprice,0)),2),'%'),'') AS zhekou,\r\n\t\tIFNULL(FORMAT(SUM(tax_amount),2),'') AS amount,\r\n\t\tIFNULL(CONCAT(FORMAT((1-SUM(gcm*quantity)/SUM(tax_amount))*100,2),'%'),'') AS gcm,\r\n\t\tIFNULL(CONCAT(FORMAT((SUM((CASE WHEN avge_price=0 THEN 0 ELSE taxprice END)*quantity)/SUM(quantity*IFNULL(avge_price,0))-1)*100,2),'%'),'') AS spe\r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\ta.quantity,\r\n\t\t\tIFNULL(b.productgroup_name,'') AS productgroup_name,\r\n\t\t\ta.tax_amount,\r\n\t\t\ta.taxprice,\r\n\t\t\tb.gcm_cost AS gcm,\r\n\t\t\tIFNULL(standardprice,0) AS standardprice,\r\n\t\t\tIFNULL(a.avgeprice,0) AS avge_price\r\n\t\tFROM ld_quotesdetail a\r\n\t\tLEFT JOIN ld_products b ON b.productid=a.productid\r\n\t\tLEFT JOIN ld_quotes q ON q.quoteid=a.id\r\n\t\tWHERE a.id=(\r\n\t\t\t\tSELECT \r\n\t\t\t\t\tquoteid \r\n\t\t\t\tFROM ld_quotes\r\n\t\t\t\tWHERE deleted=0\r\n\t\t\t\t\tAND approvestatus<>'已拒绝'\r\n\t\t\t\t\tAND potentialid=(SELECT potentialid FROM ld_quotes WHERE quoteid='[related_ldcrmid]')\r\n\t\t\t\tORDER BY quote_version+0 DESC,quoteid DESC LIMIT 1,1\r\n\t\t\t)\r\n\t) t\r\n\tGROUP BY productgroup_name\r\n\tUNION\r\n\tSELECT\r\n\t\t'整单',\r\n\t\tIFNULL(CONCAT(FORMAT(100-SUM(tax_amount)*100/SUM(quantity*IFNULL(standardprice,0)),2),'%'),''),\r\n\t\tIFNULL(FORMAT(SUM(tax_amount),2),''),\r\n\t\tIFNULL(CONCAT(FORMAT((1-SUM(gcm*quantity)/SUM(tax_amount))*100,2),'%'),''),\r\n\t\tIFNULL(CONCAT(FORMAT((SUM((CASE WHEN avge_price=0 THEN 0 ELSE taxprice END)*quantity)/SUM(quantity*IFNULL(avge_price,0))-1)*100,2),'%'),'')\r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\ta.quantity,\r\n\t\t\tIFNULL(b.productgroup_name,'') AS productgroup_name,\r\n\t\t\ta.tax_amount,\r\n\t\t\ta.taxprice,\r\n\t\t\tb.gcm_cost AS gcm,\r\n\t\t\tIFNULL(standardprice,0) AS standardprice,\r\n\t\t\tIFNULL(a.avgeprice,0) AS avge_price\r\n\t\tFROM ld_quotesdetail a\r\n\t\tLEFT JOIN ld_products b On b.productid=a.productid\r\n\t\tLEFT JOIN ld_quotes q ON q.quoteid=a.id\r\n\t\tWHERE a.id=(\r\n\t\t\t\tSELECT \r\n\t\t\t\t\tquoteid \r\n\t\t\t\tFROM ld_quotes\r\n\t\t\t\tWHERE deleted=0\r\n\t\t\t\t\tAND approvestatus<>'已拒绝'\r\n\t\t\t\t\tAND potentialid=(SELECT potentialid FROM ld_quotes WHERE quoteid='[related_ldcrmid]')\r\n\t\t\t\tORDER BY quote_version+0 DESC,quoteid DESC LIMIT 1,1\r\n\t\t\t)\r\n\t) t\r\n) t2 ON t2.chanpinzu=a.productgroup_name\r\nWHERE 1=1\r\nORDER BY seqtype,a.productgroup_name"
      },
      "3": {
        "Ident": "StiMySqlSource",
        "Name": "e",
        "Alias": "e",
        "Columns": {
