          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\ta.quoteid,\r\n\ta.quote_version,\r\n\tc.productname,\r\n\tc.product_no,\r\n\tb.quantity,\r\n\tb.taxprice,\r\n\tb.discount_percent,\r\n\tb.gcm,\r\n\tb.spe,\r\n\tb.tax_amount,\r\n\tb.description\r\nFROM ld_quotes a\r\nLEFT JOIN ld_quotesdetail b ON b.id=a.quoteid\r\nLEFT JOIN ld_products c On c.productid=b.productid\r\nWHERE a.deleted=0\r\n\tAND a.approvestatus<>'已拒绝'\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_quotes WHERE quoteid='[related_ldcrmid]' AND potentialid>0) THEN\r\n\t\t\t\ta.potentialid=(SELECT potentialid FROM ld_quotes WHERE quoteid='[related_ldcrmid]')\r\n\t\t\tELSE a.quoteid='[related_ldcrmid]'\r\n\t\tEND)\r\nORDER BY a.quote_version+0 DESC,a.quoteid,b.sequence_no"
      },
      "2": {
        "Ident": "StiMySqlSource",
        "Name": "d",
        "Alias": "d",
        "Columns": {
          "0": {
