        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\ta.quotetype,\r\n\tb.potential_no,\r\n\ta.quote_version,\r\n\tc.cf_2918 AS xiangmu,\r\n\tc.cf_2919 AS hangye,\r\n\ta.sales_area AS quyu,\r\n\tc.cf_2920 AS chengshi,\r\n\ta.banshichu AS banshichu,\r\n\tc.cf_2916 AS jindu,\r\n\tc.cf_2923 AS genzhong_no,\r\n\tv.last_name AS genzhong_ren,\r\n\ta.validfrom,\r\n\ta.validtill,\r\n\tc.cf_2927 AS jxs_no,\r\n\tk.accountname,\r\n\tc.cf_2928 AS shejiyuan,\r\n\tc.cf_2929 AS fazhanshang,\r\n\tc.cf_2930 AS panchang,\r\n\tc.cf_2936 AS KA,\r\n\tc.cf_2934 AS tuzhi,\r\n\tc.cf_2935 AS shangturen,\r\n\tc.cf_2932 AS jungong_date,\r\n\tc.cf_2931 AS zhucenianyue,\r\n\ta.stock_date AS jinhuo_date\r\nFROM ld_quotes a\r\nLEFT JOIN ld_potential b ON b.potentialid=a.potentialid\r\nLEFT JOIN ld_quotescf c ON c.quoteid=a.quoteid\r\nLEFT JOIN ld_account k ON k.accountid=a.accountid\r\nLEFT JOIN ld_users v ON v.id=c.cf_2924\r\nWHERE a.deleted=0\r\n\tAND a.approvestatus<>'已拒绝'\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_quotes WHERE quoteid='[related_ldcrmid]' AND potentialid>0) THEN\r\n\t\t\t\ta.potentialid=(SELECT potentialid FROM ld_quotes WHERE quoteid='[related_ldcrmid]')\r\n\t\t\tELSE a.quoteid='[related_ldcrmid]'\r\n\t\tEND)\r\nORDER BY quote_version+0 DESC LIMIT 1"
      },
