            "Type": "System.String"
          },
          "5": {
            "Name": "smownerid",
            "Index": -1,
            "NameInSource": "smownerid",
            "Alias": "smownerid",
            "Type": "System.Int32"
          },
          "6": {
            "Name": "tips",
            "Index": -1,
            "NameInSource": "tips",
            "Alias": "tips",
            "Type": "System.String"
          },
          "7": {
            "Name": "total",
            "Index": -1,
            "NameInSource": "total",
