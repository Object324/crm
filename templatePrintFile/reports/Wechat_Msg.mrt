          }
        },
        "NameInSource": "ldcrm",
        "Type": "Table",
        "SqlCommand": "select\r\nwechat.title,\r\nsubstring_index(substring_index(content,'\"',6),'\"',-1) as msg1,\r\ncase when substring_index(substring_index(content,'\"',16),'\"',-1) ='color' then '' else substring_index(substring_index(content,'\"',16),'\"',-1) end as msg2,\r\nwechat.modulename,\r\nwechat.record,\r\nwechat.createdtime,\r\nwechat.sendtime,\r\nsubstring_index(substring_index(sendmessage,'\"',6),'\"',-1) as sendmessage,\r\ncase when wechat.sendstatus='success' then '成功' else '失败' end as sendstatus,\r\nwechat.userfrom,\r\ntrans.fieldlabel,\r\nwechatuser.last_name\r\nfrom ld_weixin_msg wechat\r\nleft join(\r\n\tselect \r\n\ttab.name,\r\n\ttab.tabid,\r\n\ttrans.fieldlabel\r\n\tfrom ld_tab tab\r\n\tleft join ld_tranlabel trans on tab.tabid=trans.tabid\r\n\twhere trantable='ld_tab' and languagetype='zh'\r\n)trans on wechat.modulename=trans.name\r\nLEFT JOIN (\r\nSELECT wechatuser.wechatuserid,ld_users.last_name from ld_users \r\nLEFT JOIN ld_wechatuser wechatuser on wechatuser.userid = ld_users.id AND wechatuser.userfromvalue = 'CRMminiprogram'\r\n) wechatuser ON wechatuser.wechatuserid = wechat.wechatuserid\r\nwhere DATE_FORMAT(wechat.sendtime,'%Y-%m-%d')>=DATE_FORMAT('{start_time}','%Y-%m-%d')\r\nand DATE_FORMAT(wechat.sendtime,'%Y-%m-%d')<=DATE_FORMAT('{end_time}','%Y-%m-%d')\r\nand (case when '{mokuai}'='' then 1=1 else find_in_set(trans.fieldlabel,'{mokuai}') end)\r\nand (case when '{title}'='' then 1=1 else wechat.title LIKE '%{title}%' end)\r\norder by wechat.sendtime desc\r\n"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "modules",
        "Alias": "modules",
        "Columns": {
          "0": {
            "Name": "fieldlabel",
            "Index": -1,
            "NameInSource": "fieldlabel",
            "Alias": "fieldlabel",
            "Type": "System.String"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "select \r\ntrans.fieldlabel\r\nfrom ld_tab tab\r\nleft join ld_tranlabel trans on tab.tabid=trans.tabid\r\nwhere trantable='ld_tab' and languagetype='zh'"
      }
    },
