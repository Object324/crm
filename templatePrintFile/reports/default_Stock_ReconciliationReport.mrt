            "Type": "System.String"
          },
          "25": {
            "Name": "ware_stock_no",
            "Index": -1,
            "NameInSource": "ware_stock_no",
            "Alias": "ware_stock_no",
            "Type": "System.String"
          },
          "26": {
            "Name": "weiqinghanshuijine",
            "Index": -1,
            "NameInSource": "weiqinghanshuijine",
            "Alias": "weiqinghanshuijine",
            "Type": "System.Decimal"
          }
        },
        "NameInSource": "Connection1",
        "Type": "Table",
        "SqlCommand": "SELECT \r\n\ti.id,\r\n\tst.ware_stock_no, \r\n\tst.stock_id,\r\n\tst.presence,\r\n\ti.sequence_no,\r\n\tCASE\r\n\t\tWHEN t1.balancepurchasecount>0 THEN '未清'\r\n\t\tELSE '已清'\r\n\tEND as hangzhuangtai,\r\n\tw.`name`,\r\n\tst.createdate, \r\n\tst.vendorid,\r\n\ta.vendor_no, \r\n\ta.vendorname, \r\n\tp.product_no, \r\n\tp.productname,\r\n\tp.productsheet, \r\n\tp.usageunit,  \r\n\tt2.order_no,\r\n\tt2.last_name, \r\n\ti.entitytype, \r\n\ti.entitytypeid, \r\n\tIFNULL(t1.havepurchasecount,0) AS havepurchasecount,\r\n\tIFNULL(t1.balancepurchasecount,0) AS balancepurchasecount,\r\n\tround((i.listprice / st.conversion_rate),2) as listprice,\r\n\tround((i.taxprice / st.conversion_rate),2) as taxprice,\r\n\tround((i.list_amount / st.conversion_rate),2) as list_amount,\r\n\tround((i.tax_total / st.conversion_rate),2) as tax_total,\r\n\tround((i.taxprice / st.conversion_rate),2)*t1.balancepurchasecount as weiqinghanshuijine,\r\n\ti.`comment`\r\nFROM ld_stock st\r\nLEFT JOIN ld_warehouse w on w.id=st.wareid \r\nLEFT JOIN ld_stockdetail i ON i.id=st.stock_id\r\nLEFT JOIN ld_vendor a ON a.vendorid = st.vendorid \r\nLEFT JOIN ld_products p ON p.productid = i.productid \r\nLEFT JOIN ld_purchaseorderdetail t1 ON t1.id=i.entitytypeid and t1.productid=i.productid \r\nLEFT JOIN ( \r\n\tSELECT \r\n\t\tpurchaseorderid AS id,\r\n\t\tpurchaseorder_no AS order_no,\r\n\t\tsmownerid,ld_users.last_name \r\n\tFROM ld_purchaseorder\r\n\tLEFT JOIN ld_users ON ld_users.id = ld_purchaseorder.smownerid\r\n\tUNION ALL \r\n\tSELECT purchaseinvoiceid,purchaseinvoice_no,smownerid,ld_users.last_name from ld_purchaseinvoice\r\n\tLEFT JOIN ld_users ON ld_users.id = ld_purchaseinvoice.smownerid \r\n) t2 ON t2.id=i.entitytypeid\r\nINNER JOIN (\r\n\tSELECT DISTINCT\r\n\t\tuserid \r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\tld_users.id as userid \r\n\t\tFROM ld_users\r\n\t\tWHERE EXISTS(select 1 from ld_setscoperhigher where modulename='Stock' and scopeauthority=1 and userid='[uuid]')\r\n\t\tUNION\r\n\t\tselect \r\n\t\t\tviewid as userid \r\n\t\tfrom ld_scoperhigher\r\n\t\twhere userid='[uuid]' and modulename='Stock' and EXISTS(select 1 from ld_setscoperhigher where userid='[uuid]' and scopeauthority=2 and modulename='Stock')\t\t\t\r\n\t\tUNION\r\n\t\tselect DISTINCT \r\n\t\t\tld_users2group.userid as userid \r\n\t\tfrom ld_scoperhigher \r\n\t\tINNER JOIN ld_groups on ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\tINNER JOIN ld_users2group on ld_users2group.groupid=ld_groups.groupid\r\n\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\tand ld_scoperhigher.modulename='Stock'\r\n\t\t\tand ld_scoperhigher.scopeauthority=3 \r\n\t\t\tand EXISTS(select 1 from ld_setscoperhigher where modulename='Stock' and scopeauthority=3 and userid='[uuid]')\r\n\t\tUNION \r\n\t\tselect \r\n\t\t\tid as userid \r\n\t\tfrom ld_users  \r\n\t\twhere exists(select 1 from ld_users where id='[uuid]' and is_admin='on')\r\n\t\tUNION\r\n\t\tselect '[uuid]')as vw_users\r\n) AS tmp_users ON tmp_users.userid=st.smownerid\r\nWHERE st.deleted=0\r\n\tAND st.approvestatus<>'已拒绝'\r\n\tAND st.createdate BETWEEN DATE_FORMAT('{outback_start_date}','%Y-%m-%d') AND DATE_FORMAT('{outback_end_date}','%Y-%m-%d') \r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{userid}'='' THEN 1=1\r\n\t\t\tELSE FIND_IN_SET(CASE WHEN st.smownerid IS NULL THEN 1 ELSE st.smownerid END,'{userid}')\r\n\t\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{approve}'='true' THEN st.approvestatus<>'已批准'\r\n\t\t\tELSE 1=1\r\n\t\tEND)\r\n\tAND(\r\n\t\tCASE \r\n\t\t\tWHEN '{wareName}' !='' THEN w.name like'%{wareName}%' \r\n\t\t\tELSE 1=1 \r\n\t\tEND)\r\n\tAND(\r\n\t\tCASE \r\n\t\t\tWHEN '{productno}' !='' THEN p.product_no like'%{productno}%' \r\n\t\t\tELSE 1=1 \r\n\t\tEND)\r\n\tAND(\r\n\t\tCASE \r\n\t\t\tWHEN '{productssheet}' !='' THEN p.productsheet like'%{productssheet}%' \r\n\t\t\tELSE 1=1\r\n\t\tEND)\r\n\tAND(\r\n\t\tCASE \r\n\t\t\tWHEN '{productsName}' !='' THEN p.productname like'%{productsName}%' \r\n\t\t\tELSE 1=1\r\n\t\tEND)\r\n\tAND (\r\n\t\tCASE \r\n\t\t\tWHEN '{VendorsName}' !='' THEN a.vendorname like'%{VendorsName}%' \r\n\t\t\tELSE 1=1\r\n\t\tEND)\r\n\tAND (\r\n\t\tCASE \r\n\t\t\tWHEN '{StockNo}' !='' THEN st.ware_stock_no like'%{StockNo}%' \r\n\t\t\tELSE (1=1) \r\n\t\tEND)\r\nORDER BY st.createdate,st.ware_stock_no,st.stock_id,i.sequence_no"
      }
    },
