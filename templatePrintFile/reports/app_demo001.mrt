        "Columns": {
          "0": {
            "Name": "qianyue_done",
            "Index": -1,
            "NameInSource": "qianyue_done",
            "Alias": "qianyue_done",
            "Type": "System.Decimal"
          },
          "1": {
            "Name": "qianyue_target",
            "Index": -1,
            "NameInSource": "qianyue_target",
            "Alias": "qianyue_target",
            "Type": "System.Decimal"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT \r\n\t(\r\n\t\tSELECT\r\n\t\t\tSUM(contractamount)\r\n\t\tFROM ld_salestarget a\r\n\t\tWHERE a.targetyear=YEAR(NOW())\r\n\t\t\tAND a.targetmouth=MONTH(NOW())\r\n\t) AS qianyue_target,\r\n\t(\r\n\t\tSELECT\r\n\t\tSUM(ROUND(a.total/IFNULL(a.conversion_rate,1),2)) AS total\r\n\tFROM ld_salesorder a\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t) AS qianyue_done"
      }
    },
