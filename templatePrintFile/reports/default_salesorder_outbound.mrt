        "NameInSource": "liver",
        "SqlCommand": "SELECT\r\n\tld_outboundorder.out_id,\r\n\tld_outboundorder.out_no,\r\n\tld_account.accountname,\r\n\tld_warehouse.`name`,\r\n\tld_outboundorder.outdate,\r\n\tld_outboundorder.presence,\r\n\tld_users.last_name,\r\n\tld_outboundorder.remark,\r\n\tld_products.productname,\r\n\tld_inventoryproductrel.quantity,\r\n\tld_inventoryproductrel.tax_amount,\r\n\tld_inventoryproductrelscf.sf4\r\nFROM ld_outboundorderdetail ld_inventoryproductrel\r\nLEFT JOIN ld_outboundorderdetailscf ld_inventoryproductrelscf ON ld_inventoryproductrelscf.lineitem_id = ld_inventoryproductrel.lineitem_id\r\nLEFT JOIN ld_outboundorder ON ld_inventoryproductrel.id = ld_outboundorder.out_id\r\nLEFT JOIN ld_outboundordercf ON ld_outboundordercf.out_id = ld_outboundorder.out_id\r\nLEFT JOIN ld_account ON ld_account.accountid = ld_outboundorder.accountid\r\nLEFT JOIN ld_products ON ld_products.productid = ld_inventoryproductrel.productid\r\nLEFT JOIN ld_warehouse ON ld_warehouse.id = ld_outboundorder.wareid\r\nLEFT JOIN ld_users ON ld_users.id = ld_outboundorder.smownerid\r\nWHERE ld_outboundorder.deleted=0\r\n\tAND ld_inventoryproductrel.id IN (\r\n\t\t\tSELECT \r\n\t\t\t\ta.out_id \r\n\t\t\tFROM ld_outboundorder a\r\n\t\t\tLEFT JOIN ld_outboundorderdetail b ON a.out_id=b.id \r\n\t\t\tWHERE b.entitytypeid='{this[\"salesorderid\"]}'\r\n\t\t)"
      },
