        "NameInSource": "liver",
        "SqlCommand": "SELECT\r\n\ta.out_id,\r\n\ta.outdate,\r\n\ta.out_no,\r\n\ta.accountid,\r\n\tp.productname,\r\n\tb.productid,\r\n\tb.quantity,\r\n\tb.tax_amount/c.conversion_rate as tax_amount,\r\n\tu.last_name,\r\n\tld_account.accountname\r\nFROM ld_outboundorder a\r\nLEFT JOIN ld_outboundorderdetail b ON a.out_id = b.id\r\nLEFT JOIN ld_salesorder c ON c.salesorderid = b.entitytypeid\r\nLEFT JOIN ld_products p ON p.productid = b.productid\r\nLEFT JOIN ld_users u ON u.id = a.smownerid\r\nLEFT JOIN ld_account ON a.accountid = ld_account.accountid\r\nWHERE a.deleted = 0\r\n\tAND b.entitytypeid ='{this[\"salesorder_id\"]}'\r\n\tAND b.productid ='{this[\"productid\"]}'"
      },
