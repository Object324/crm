        },
        "NameInSource": "liver",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\t*,\r\n\tCASE \r\n\t\tWHEN minno=1 THEN\treceived_amount\r\n\t\tELSE 0\r\n\tEND AS received_amount_total,\r\n\tCASE \r\n\t\tWHEN minno=1 THEN\torder_total\r\n\t\tELSE 0\r\n\tEND AS total,\r\n\tCASE \r\n\t\tWHEN minno=1 THEN\r\n\t\t\tIFNULL((SELECT\r\n\t\t\t\t\t\tsum(total) as total\r\n\t\t\t\t\tFROM(\r\n\t\t\t\t\t\tSELECT DISTINCT\r\n\t\t\t\t\t\t\ta.out_id,\r\n\t\t\t\t\t\t\tb.entitytypeid,\r\n\t\t\t\t\t\t\tround(a.total/ifnull(a.conversion_rate,1),2) as total\r\n\t\t\t\t\t\tFROM ld_outboundorder a\r\n\t\t\t\t\t\tLEFT JOIN ld_outboundorderdetail b on a.out_id=b.id\r\n\t\t\t\t\t\tLEFT JOIN ld_salesorder s ON s.salesorderid=b.entitytypeid\r\n\t\t\t\t\t\tWHERE a.deleted=0 ) t where t.entitytypeid=a.salesorderid),0)\r\n\t\tELSE 0\r\n\tEND AS out_total,\r\n\tCASE \r\n\t\tWHEN minno=1 THEN\r\n\t\t\tIFNULL(order_total,0)-IFNULL((SELECT\r\n\t\t\t\t\t\tsum(total) as total\r\n\t\t\t\t\tFROM(\r\n\t\t\t\t\t\tSELECT DISTINCT\r\n\t\t\t\t\t\t\ta.out_id,\r\n\t\t\t\t\t\t\tb.entitytypeid,\r\n\t\t\t\t\t\t\tround(a.total/ifnull(a.conversion_rate,1),2) as total\r\n\t\t\t\t\t\tFROM ld_outboundorder a\r\n\t\t\t\t\t\tLEFT JOIN ld_outboundorderdetail b on a.out_id=b.id\r\n\t\t\t\t\t\tLEFT JOIN ld_salesorder s on s.salesorderid=b.entitytypeid\r\n\t\t\t\t\t\tWHERE a.deleted=0 ) t where t.entitytypeid=a.salesorderid),0)\r\n\t\tELSE 0\r\n\tEND AS jieyu\r\nFROM (\r\n\tSELECT\r\n\t\te.last_name,\r\n\t\tlower(getPY(e.last_name)) pyname,\r\n\t\ta.signed_data,\r\n\t\ta.salesorderid,\r\n\t\ta.received_amount,\r\n\t\tb.minno,\r\n\t\ta.conversion_rate,\r\n\t\ta.smownerid,\r\n\t\tb.taxprice,\r\n\t\t((b.taxprice / a.conversion_rate) * sum(b.quantity)) as hanshuiheji,\r\n\t\ta.salesorder_no,\r\n\t\ta.deleted,\r\n\t\ta.sostatus,\r\n\t\ta.accountid,\r\n\t\td.accountname,\r\n\t\ta.total/ifnull(a.conversion_rate,1) order_total,\r\n\t\tb.productid,\r\n\t\tc.product_no,\r\n\t\tc.productname,\r\n\t\tsum(b.quantity) as order_qty,\r\n\t\tsum(round(ifnull(b.tax_amount,0)/ifnull(a.conversion_rate,1),2)) as order_amount,\r\n\t\tifnull(b.haveoutproductcount,0) as haveoutproductcount,\r\n\t\tifnull(b.balanceoutproductcount,0) as balanceoutproductcount\r\n\tFROM ld_salesorder a\r\n\tLEFT JOIN (\r\n\t\tSELECT \r\n\t\t\t*,\r\n\t\t\tCASE\r\n\t\t\t\tWHEN lineitem_id=(SELECT min(lineitem_id) from ld_salesorderdetail where id=a.id) THEN 1\r\n\t\t\t\tELSE 2\r\n\t\t\tEND as minno\r\n\t\tFROM ld_salesorderdetail a ORDER BY lineitem_id\r\n\t) b on a.salesorderid=b.id\r\n\tLEFT JOIN ld_products c on c.productid=b.productid\r\n\tLEFT JOIN ld_account d on d.accountid=a.accountid\r\n\tLEFT JOIN ld_users e on e.id=a.smownerid\r\n\tWHERE a.deleted=0\r\n\t\tAND IFNULL(a.sostatus,'')<>'已作废'\r\n\tGROUP BY a.salesorderid,b.productid\r\n\tORDER BY a.salesorderid,b.lineitem_id\r\n) a\r\nWHERE a.deleted=0 \r\n\tAND IFNULL(a.sostatus,'')<>'已作废' \r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{Trim(salesorderNo)}'='' THEN 1=1\r\n\t\t\tELSE  a.salesorder_no like '%{Trim(salesorderNo)}%'\r\n\t\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{Trim(accountName)}'='' THEN 1=1\r\n\t\t\tELSE  a.accountname like '%{Trim(accountName)}%'\r\n\t\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{Trim(productName)}'='' THEN 1=1\r\n\t\t\tELSE  a.productname like '%{Trim(productName)}%'\r\n\t\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{Trim(productsNo)}'='' THEN 1=1\r\n\t\t\tELSE  a.product_no like '%{Trim(productsNo)}%'\r\n\t\tEND)\r\n\tAND a.signed_data BETWEEN DATE_FORMAT('{begin_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{userid}'='' THEN \r\n\t\t\t\tFIND_IN_SET(CASE WHEN a.smownerid is NULL THEN 1 ELSE a.smownerid END,(\r\n\t\t\t\t\tSELECT\r\n\t\t\t\t\t\tGROUP_CONCAT(userid)\r\n\t\t\t\t\tFROM (\r\n\t\t\t\t\t\tSELECT DISTINCT\r\n\t\t\t\t\t\t\tuserid \r\n\t\t\t\t\t\tFROM (\r\n\t\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\t\tld_users.id AS userid \r\n\t\t\t\t\t\t\tFROM ld_users\r\n\t\t\t\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='SalesOrder' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\t\t\t\t\tUNION\r\n\t\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\t\tviewid AS userid \r\n\t\t\t\t\t\t\tFROM ld_scoperhigher\r\n\t\t\t\t\t\t\tWHERE userid='[uuid]' AND modulename='SalesOrder' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename='SalesOrder')\t\t\t\r\n\t\t\t\t\t\t\tUNION\r\n\t\t\t\t\t\t\tSELECT DISTINCT \r\n\t\t\t\t\t\t\t\tld_users2group.userid AS userid \r\n\t\t\t\t\t\t\tFROM ld_scoperhigher \r\n\t\t\t\t\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\t\t\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\t\t\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\t\t\t\t\tAND ld_scoperhigher.modulename='SalesOrder'\r\n\t\t\t\t\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\t\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='SalesOrder' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\t\t\t\t\tUNION \r\n\t\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\t\tid AS userid \r\n\t\t\t\t\t\t\tFROM ld_users  \r\n\t\t\t\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\t\t\t\t\tUNION\r\n\t\t\t\t\t\t\tSELECT '[uuid]') AS vw_users\r\n\t\t\t\t\t\t) AS tmp_users\r\n\t\t\t\t\t)\r\n\t\t\t\t)\r\n\t\t\tELSE FIND_IN_SET(CASE WHEN a.smownerid is NULL THEN 1 ELSE a.smownerid END,'{userid}')\r\n\t\tEND)"
      }
    },
