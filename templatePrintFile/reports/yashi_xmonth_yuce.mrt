        "NameInSource": "ldcrm ",
        "SqlCommand": "SELECT \r\n\t* \r\nFROM (\r\n\tSELECT\r\n\t\t1 AS list_key,\r\n\t\t'销售区域' AS list_value,\r\n\t\tf.groupid AS list_key2,\r\n\t\tf.groupname AS list_value2,\r\n\t\te.sequence\r\n\tFROM ld_groups f \r\n\tLEFT JOIN ld_picklist_values e ON e.listid=107 AND e.listvalue=f.groupname\r\n\tINNER JOIN (\r\n\t\tSELECT\r\n\t\t\tb.parentgroup\r\n\t\tFROM ld_users2group a\r\n\t\tLEFT JOIN ld_groups b ON b.groupid=a.groupid\r\n\t\tLEFT JOIN ld_users u ON u.id=a.userid\r\n\t\tINNER JOIN (\r\n\t\t\tSELECT DISTINCT\r\n\t\t\t\tuserid\r\n\t\t\tFROM (\r\n\t\t\t\tSELECT\r\n\t\t\t\t\t ld_users.id AS userid\r\n\t\t\t\tFROM ld_users\r\n\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename IN ('SalesOrder','CashBill') and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT\r\n\t\t\t\t\t viewid AS userid\r\n\t\t\t\tFROM ld_scoperhigher\r\n\t\t\t\tWHERE userid='[uuid]' AND modulename IN ('SalesOrder','CashBill') AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename IN ('SalesOrder','CashBill'))\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT DISTINCT\r\n\t\t\t\t\t ld_users2group.userid AS userid\r\n\t\t\t\tFROM ld_scoperhigher\r\n\t\t\t\t\t\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\t\t\t\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\t\tWHERE ld_scoperhigher.userid='[uuid]'\r\n\t\t\t\t AND ld_scoperhigher.modulename IN ('SalesOrder','CashBill')\r\n\t\t\t\t AND ld_scoperhigher.scopeauthority=3\r\n\t\t\t\t AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename IN ('SalesOrder','CashBill') AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT\r\n\t\t\t\t\t id AS userid\r\n\t\t\t\tFROM ld_users\r\n\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT '[uuid]') AS vw_users\r\n\t\t) AS tmp_users ON tmp_users.userid=u.id\r\n\t\tWHERE 1=1\r\n\t\t\tAND u.userlevel IN ('销售经理','分公司经理','分公司副经理','办事处经理','大区经理','大区副经理')\r\n\t\t\tAND b.parentgroup like '1::2::7::%'\r\n\t\tGROUP BY b.groupid\r\n\t) c ON LOCATE(f.parentgroup,c.parentgroup)>0\r\n\tWHERE f.parentgroup like '1::2::7::%' \r\n\t\tAND depth=3\r\n\tUNION ALL \r\n\tSELECT\r\n\t\t2 AS list_key,\r\n\t\t'销售分支' AS list_value,\r\n\t\tf.groupid AS list_key2,\r\n\t\tf.groupname AS list_value2,\r\n\t\te.sequence\r\n\tFROM ld_groups f \r\n\tLEFT JOIN ld_picklist_values e ON e.listid=108 AND e.listvalue=f.groupname\r\n\tINNER JOIN (\r\n\t\tSELECT\r\n\t\t\tb.parentgroup\r\n\t\tFROM ld_users2group a\r\n\t\tLEFT JOIN ld_groups b ON b.groupid=a.groupid\r\n\t\tLEFT JOIN ld_users u ON u.id=a.userid\r\n\t\tINNER JOIN (\r\n\t\t\tSELECT DISTINCT\r\n\t\t\t\tuserid\r\n\t\t\tFROM (\r\n\t\t\t\tSELECT\r\n\t\t\t\t\t ld_users.id AS userid\r\n\t\t\t\tFROM ld_users\r\n\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename IN ('SalesOrder','CashBill') and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT\r\n\t\t\t\t\t viewid AS userid\r\n\t\t\t\tFROM ld_scoperhigher\r\n\t\t\t\tWHERE userid='[uuid]' AND modulename IN ('SalesOrder','CashBill') AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename IN ('SalesOrder','CashBill'))\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT DISTINCT\r\n\t\t\t\t\t ld_users2group.userid AS userid\r\n\t\t\t\tFROM ld_scoperhigher\r\n\t\t\t\t\t\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\t\t\t\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\t\tWHERE ld_scoperhigher.userid='[uuid]'\r\n\t\t\t\t AND ld_scoperhigher.modulename IN ('SalesOrder','CashBill')\r\n\t\t\t\t AND ld_scoperhigher.scopeauthority=3\r\n\t\t\t\t AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename IN ('SalesOrder','CashBill') AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT\r\n\t\t\t\t\t id AS userid\r\n\t\t\t\tFROM ld_users\r\n\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT '[uuid]') AS vw_users\r\n\t\t) AS tmp_users ON tmp_users.userid=u.id\r\n\t\tWHERE 1=1\r\n\t\t\tAND u.userlevel IN ('销售经理','分公司经理','分公司副经理','办事处经理','大区经理','大区副经理')\r\n\t\t\tAND b.parentgroup like '1::2::7::%'\r\n\t\tGROUP BY b.groupid\r\n\t) c ON LOCATE(f.parentgroup,c.parentgroup)>0\r\n\tWHERE f.parentgroup like '1::2::7::%' \r\n\t\tAND depth=4\r\n\tUNION ALL \r\n\tSELECT\r\n\t\t3 AS list_key,\r\n\t\t'销售经理' AS list_value,\r\n\t\ta.id AS list_key2,\r\n\t\ta.last_name AS list_value2,\r\n\t\tid AS sequence\r\n\tFROM ld_users a\r\n\tINNER JOIN ld_users2group e ON e.userid=a.id\r\n\tINNER JOIN ld_groups f ON f.groupid=e.groupid\r\n\tINNER JOIN (\r\n\t\tSELECT DISTINCT\r\n\t\t\tuserid\r\n\t\tFROM (\r\n\t\t\tSELECT\r\n\t\t\t\t ld_users.id AS userid\r\n\t\t\tFROM ld_users\r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename IN ('SalesOrder','CashBill') and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\tUNION\r\n\t\t\tSELECT\r\n\t\t\t\t viewid AS userid\r\n\t\t\tFROM ld_scoperhigher\r\n\t\t\tWHERE userid='[uuid]' AND modulename IN ('SalesOrder','CashBill') AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename IN ('SalesOrder','CashBill'))\r\n\t\t\tUNION\r\n\t\t\tSELECT DISTINCT\r\n\t\t\t\t ld_users2group.userid AS userid\r\n\t\t\tFROM ld_scoperhigher\r\n\t\t\t\t\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\t\t\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\tWHERE ld_scoperhigher.userid='[uuid]'\r\n\t\t\t AND ld_scoperhigher.modulename IN ('SalesOrder','CashBill')\r\n\t\t\t AND ld_scoperhigher.scopeauthority=3\r\n\t\t\t AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename IN ('SalesOrder','CashBill') AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\tUNION\r\n\t\t\tSELECT\r\n\t\t\t\t id AS userid\r\n\t\t\tFROM ld_users\r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\tUNION\r\n\t\t\tSELECT '[uuid]') AS vw_users\r\n\t) AS tmp_users ON tmp_users.userid=a.id\r\n\tWHERE a.deleted=0\t\r\n\t\tAND a.userlevel IN ('销售经理','分公司经理','分公司副经理','办事处经理','大区经理','大区副经理')\r\n\t\tAND f.parentgroup like '1::2::7::%'\r\n\t\tAND FIND_IN_SET(f.groupname,(\r\n\t\t\tSELECT \r\n\t\t\t\tgroup_concat(REPLACE(REPLACE(REPLACE(a.targetvalues,'\"',''),'[',''),']','')) \r\n\t\t\tFROM ld_picklist_dependency a\r\n\t\t\tLEFT JOIN ld_picklist_values c ON c.listid=107 AND c.listvalue=a.sourcevalue\r\n\t\t\tWHERE a.tabid=6\r\n\t\t\t\tAND a.sourcefield='cf_4402'\r\n\t\t\t\tAND a.targetfield='cf_4404'\r\n\t\t\t)\r\n\t\t)\r\n\tGROUP BY a.id\r\n)a \r\nORDER BY a.list_key,(CASE WHEN list_key<3 THEN sequence ELSE CONVERT(list_value2 USING GBK) END)"
      },
      "10": {
        "Ident": "StiMySqlSource",
