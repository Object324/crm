        },
        "NameInSource": "ldcrm ",
        "SqlCommand": "SELECT\r\n\tCASE WHEN a.status='Active' THEN a.last_name ELSE CONCAT(a.last_name,'(离职)') END AS show_weidu,\r\n\ta.status,\r\n\tm.ys_bef*0.0001 AS ys_bef,\r\n\tm.ys_cur*0.0001 AS ys_cur,\r\n\tm.ys_all*0.0001 AS ys_all,\r\n\r\n\t(IFNULL(h.ht_bef_yx,0)+IFNULL(i.ht_bef_yx,0))*0.0001 AS ht_bef_yx,\r\n\t(IFNULL(h.ht_bef,0)+IFNULL(i.ht_bef,0))*0.0001 AS ht_bef,\r\n\t(IFNULL(h.ht_bef_tong,0)+IFNULL(i.ht_bef_tong,0))*0.0001 AS ht_bef_tong,\r\n\r\n\tSUM(IFNULL(j.total,0))*0.0001 AS ht_cur_yuce,\r\n\tSUM((IFNULL(h.ht_cur_tong,0)+IFNULL(i.ht_cur_tong,0)))*0.0001 AS ht_cur_tong,\r\n\r\n\tSUM((IFNULL(h.ht_bef_yx,0)+IFNULL(i.ht_bef_yx,0)))*0.0001+SUM(IFNULL(j.total,0))*0.0001 AS ht_all_yx,\r\n\t(IFNULL(h.ht_bef_tong,0)+IFNULL(i.ht_bef_tong,0))*0.0001+SUM((IFNULL(h.ht_cur_tong,0)+IFNULL(i.ht_cur_tong,0)))*0.0001 AS ht_all_tong\r\nFROM ld_users a\r\nLEFT JOIN ld_users2group b ON b.userid=a.id\r\nLEFT JOIN ld_groups c ON c.groupid=b.groupid\r\nLEFT JOIN ld_groups d ON d.groupid=c.parentid\r\nLEFT JOIN ld_picklist_values e ON e.listid=107 AND e.listvalue=d.groupname\r\nLEFT JOIN ld_picklist_values f ON f.listid=108 AND e.listvalue=c.groupname\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\tuserid,\r\n\t\tSUM(CASE WHEN targetmouth<'{yue}' THEN contractamount ELSE 0 END) AS ys_bef,\r\n\t\tSUM(CASE WHEN targetmouth='{yue}' THEN contractamount ELSE 0 END) AS ys_cur,\r\n\t\tSUM(contractamount) ys_all\r\n\tFROM ld_salestarget\r\n\tWHERE targetyear='{nian}'\r\n\t\tAND targetmouth<='{yue}'\r\n\tGROUP BY userid\r\n) m ON m.userid=a.id\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\ta.smownerid,\r\n\t\tSUM(CASE \r\n\t\t\tWHEN YEAR(a.shengxiao_time)='{nian}' AND MONTH(a.shengxiao_time)<'{yue}' AND b.cf_4809=0 AND a.sostatus='已生效' THEN a.total \r\n\t\t\tWHEN YEAR(a.shengxiao_time)='{nian}' AND MONTH(a.shengxiao_time)<'{yue}' AND b.cf_4809=1 AND a.sostatus='已生效' THEN a.total*0.01*IFNULL(b.cf_4816,0) \r\n\t\t\tELSE 0 \r\n\t\tEND) AS ht_bef_yx,\r\n\t\tSUM(CASE \r\n\t\t\tWHEN YEAR(a.createdtime)='{nian}' AND MONTH(a.createdtime)<'{yue}' AND b.cf_4809=0 THEN a.total \r\n\t\t\tWHEN YEAR(a.createdtime)='{nian}' AND MONTH(a.createdtime)<'{yue}' AND b.cf_4809=1 THEN a.total*0.01*IFNULL(b.cf_4816,0) \r\n\t\t\tELSE 0 \r\n\t\tEND) AS ht_bef,\r\n\t\tSUM(CASE \r\n\t\t\tWHEN YEAR(a.createdtime)='{nian}'-1 AND MONTH(a.createdtime)<'{yue}' AND b.cf_4809=0 THEN a.total \r\n\t\t\tWHEN YEAR(a.createdtime)='{nian}'-1 AND MONTH(a.createdtime)<'{yue}' AND b.cf_4809=1 THEN a.total*0.01*IFNULL(b.cf_4816,0) \r\n\t\t\tELSE 0 \r\n\t\tEND) AS ht_bef_tong,\r\n\r\n\t\tSUM(CASE \r\n\t\t\tWHEN YEAR(a.createdtime)='{nian}'-1 AND MONTH(a.createdtime)='{yue}' AND b.cf_4809=0 THEN a.total \r\n\t\t\tWHEN YEAR(a.createdtime)='{nian}'-1 AND MONTH(a.createdtime)='{yue}' AND b.cf_4809=1 THEN a.total*0.01*IFNULL(b.cf_4816,0) \r\n\t\t\tELSE 0 \r\n\t\tEND) AS ht_cur_tong\r\n\tFROM ld_salesorder a\r\n\tLEFT JOIN ld_salesordercf b ON b.salesorderid=a.salesorderid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus='已批准'\r\n\t\tAND (YEAR(a.createdtime) IN ('{nian}','{nian}'-1) OR YEAR(a.shengxiao_time) IN ('{nian}','{nian}'-1))\r\n\t\tAND a.smownerid>0\r\n\tGROUP BY a.smownerid\r\n) h ON h.smownerid=a.id\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\tb.cf_4989 AS yidi_ownerid,\r\n\t\tSUM(CASE \r\n\t\t\tWHEN YEAR(a.shengxiao_time)='{nian}' AND MONTH(a.shengxiao_time)<'{yue}' AND a.sostatus='已生效' THEN a.total*0.01*IFNULL(b.cf_4811,0) \r\n\t\t\tELSE 0 \r\n\t\tEND) AS ht_bef_yx,\r\n\t\tSUM(CASE \r\n\t\t\tWHEN YEAR(a.createdtime)='{nian}' AND MONTH(a.createdtime)<'{yue}' THEN a.total*0.01*IFNULL(b.cf_4811,0) \r\n\t\t\tELSE 0 \r\n\t\tEND) AS ht_bef,\r\n\t\tSUM(CASE \r\n\t\t\tWHEN YEAR(a.createdtime)='{nian}'-1 AND MONTH(a.createdtime)<'{yue}' THEN a.total*0.01*IFNULL(b.cf_4811,0) \r\n\t\t\tELSE 0 \r\n\t\tEND) AS ht_bef_tong,\r\n\r\n\t\tSUM(CASE \r\n\t\t\tWHEN YEAR(a.createdtime)='{nian}'-1 AND MONTH(a.createdtime)='{yue}' THEN a.total*0.01*IFNULL(b.cf_4811,0) \r\n\t\t\tELSE 0 \r\n\t\tEND) AS ht_cur_tong\r\n\tFROM ld_salesorder a\r\n\tLEFT JOIN ld_salesordercf b ON b.salesorderid=a.salesorderid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus='已批准'\r\n\t\tAND (YEAR(a.createdtime) IN ('{nian}','{nian}'-1) OR YEAR(a.shengxiao_time) IN ('{nian}','{nian}'-1))\r\n\t\tAND b.cf_4809=1\r\n\t\tAND b.cf_4989>0\r\n\tGROUP BY b.cf_4989\r\n\tUNION ALL\r\n\tSELECT\r\n\t\tb.cf_4990 AS yidi_ownerid,\r\n\t\tSUM(CASE \r\n\t\t\tWHEN YEAR(a.shengxiao_time)='{nian}' AND MONTH(a.shengxiao_time)<'{yue}' AND a.sostatus='已生效' THEN a.total*0.01*IFNULL(b.cf_4813,0) \r\n\t\t\tELSE 0 \r\n\t\tEND) AS ht_bef_yx,\r\n\t\tSUM(CASE \r\n\t\t\tWHEN YEAR(a.createdtime)='{nian}' AND MONTH(a.createdtime)<'{yue}' THEN a.total*0.01*IFNULL(b.cf_4813,0) \r\n\t\t\tELSE 0 \r\n\t\tEND) AS ht_bef,\r\n\t\tSUM(CASE \r\n\t\t\tWHEN YEAR(a.createdtime)='{nian}'-1 AND MONTH(a.createdtime)<'{yue}' THEN a.total*0.01*IFNULL(b.cf_4813,0) \r\n\t\t\tELSE 0 \r\n\t\tEND) AS ht_bef_tong,\r\n\r\n\t\tSUM(CASE \r\n\t\t\tWHEN YEAR(a.createdtime)='{nian}'-1 AND MONTH(a.createdtime)='{yue}' THEN a.total*0.01*IFNULL(b.cf_4813,0) \r\n\t\t\tELSE 0 \r\n\t\tEND) AS ht_cur_tong\r\n\tFROM ld_salesorder a\r\n\tLEFT JOIN ld_salesordercf b ON b.salesorderid=a.salesorderid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus='已批准'\r\n\t\tAND (YEAR(a.createdtime) IN ('{nian}','{nian}'-1) OR YEAR(a.shengxiao_time) IN ('{nian}','{nian}'-1))\r\n\t\tAND b.cf_4809=1\r\n\t\tAND b.cf_4990>0\r\n\tGROUP BY b.cf_4990\r\n\tUNION ALL\r\n\tSELECT\r\n\t\tb.cf_4991 AS yidi_ownerid,\r\n\t\tSUM(CASE \r\n\t\t\tWHEN YEAR(a.shengxiao_time)='{nian}' AND MONTH(a.shengxiao_time)<'{yue}' AND a.sostatus='已生效' THEN a.total*0.01*IFNULL(b.cf_4815,0) \r\n\t\t\tELSE 0 \r\n\t\tEND) AS ht_bef_yx,\r\n\t\tSUM(CASE \r\n\t\t\tWHEN YEAR(a.createdtime)='{nian}' AND MONTH(a.createdtime)<'{yue}' THEN a.total*0.01*IFNULL(b.cf_4815,0) \r\n\t\t\tELSE 0 \r\n\t\tEND) AS ht_bef,\r\n\t\tSUM(CASE \r\n\t\t\tWHEN YEAR(a.createdtime)='{nian}'-1 AND MONTH(a.createdtime)<'{yue}' THEN a.total*0.01*IFNULL(b.cf_4815,0) \r\n\t\t\tELSE 0 \r\n\t\tEND) AS ht_bef_tong,\r\n\r\n\t\tSUM(CASE \r\n\t\t\tWHEN YEAR(a.createdtime)='{nian}'-1 AND MONTH(a.createdtime)='{yue}' THEN a.total*0.01*IFNULL(b.cf_4815,0) \r\n\t\t\tELSE 0 \r\n\t\tEND) AS ht_cur_tong\r\n\tFROM ld_salesorder a\r\n\tLEFT JOIN ld_salesordercf b ON b.salesorderid=a.salesorderid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus='已批准'\r\n\t\tAND (YEAR(a.createdtime) IN ('{nian}','{nian}'-1) OR YEAR(a.shengxiao_time) IN ('{nian}','{nian}'-1))\r\n\t\tAND b.cf_4809=1\r\n\t\tAND b.cf_4991>0\r\n\tGROUP BY b.cf_4991\r\n) i ON i.yidi_ownerid=a.id\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\ta.smownerid,\r\n\t\tSUM(a.total) AS total\r\n\tFROM ld_potential a\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND YEAR(a.closingdate)='{nian}'\r\n\t\tAND MONTH(a.closingdate)='{yue}'\r\n\tGROUP BY a.smownerid\r\n) j ON j.smownerid=a.id\r\nINNER JOIN (\r\n\tSELECT DISTINCT\r\n\t\tuserid\r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\t ld_users.id AS userid\r\n\t\tFROM ld_users\r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='SalesOrder' and scopeauthority=1 AND userid='[uuid]')\r\n\t\tUNION\r\n\t\tSELECT\r\n\t\t\t viewid AS userid\r\n\t\tFROM ld_scoperhigher\r\n\t\tWHERE userid='[uuid]' AND modulename ='SalesOrder' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename ='SalesOrder')\r\n\t\tUNION\r\n\t\tSELECT DISTINCT\r\n\t\t\t ld_users2group.userid AS userid\r\n\t\tFROM ld_scoperhigher\r\n\t\t\t\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\t\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\tWHERE ld_scoperhigher.userid='[uuid]'\r\n\t\t AND ld_scoperhigher.modulename ='SalesOrder'\r\n\t\t AND ld_scoperhigher.scopeauthority=3\r\n\t\t AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='SalesOrder' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\tUNION\r\n\t\tSELECT\r\n\t\t\t id AS userid\r\n\t\tFROM ld_users\r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\tUNION\r\n\t\tSELECT '[uuid]') AS vw_users\r\n) AS tmp_users ON tmp_users.userid=a.id\r\nWHERE a.deleted=0\r\n\tAND c.parentgroup LIKE '1::2::7::%' \r\n\tAND d.parentgroup LIKE '1::2::7::%'\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{fangshi}'=3 THEN 1=1 \r\n\t\t\tELSE 1=0\r\n\t\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{fanwei}'='' THEN 1=1 \r\n\t\t\tELSE FIND_IN_SET(a.id,'{fanwei}')\r\n\t\tEND)\r\nGROUP BY a.id\r\nORDER BY e.sequence,f.sequence,CONVERT(a.last_name USING GBK)"
      },
