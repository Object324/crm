          "7": {
            "Name": "ht_bef_yx",
            "Index": -1,
            "NameInSource": "ht_bef_yx",
            "Alias": "ht_bef_yx",
            "Type": "System.Decimal"
          },
          "8": {
            "Name": "ht_cur_tong",
            "Index": -1,
            "NameInSource": "ht_cur_tong",
            "Alias": "ht_cur_tong",
            "Type": "System.Decimal"
          },
          "9": {
            "Name": "ht_cur_yuce",
            "Index": -1,
            "NameInSource": "ht_cur_yuce",
            "Alias": "ht_cur_yuce",
            "Type": "System.Decimal"
          },
          "10": {
            "Name": "show_weidu",
            "Index": -1,
            "NameInSource": "show_weidu",
            "Alias": "show_weidu",
            "Type": "System.String"
          },
          "11": {
            "Name": "ys_all",
            "Index": -1,
            "NameInSource": "ys_all",
            "Alias": "ys_all",
            "Type": "System.Decimal"
          },
          "12": {
            "Name": "ys_bef",
            "Index": -1,
            "NameInSource": "ys_bef",
            "Alias": "ys_bef",
            "Type": "System.Decimal"
          },
          "13": {
            "Name": "ys_cur",
            "Index": -1,
            "NameInSource": "ys_cur",
            "Alias": "ys_cur",
            "Type": "System.Decimal"
          }
        },
        "NameInSource": "ldcrm ",
        "SqlCommand": "SELECT\r\n\ta.daqu_id,\r\n\ta.daqu_name,\r\n\ta.groupid,\r\n\ta.show_weidu,\r\n\ta.ys_bef,\r\n\ta.ys_cur,\r\n\ta.ys_all,\r\n\r\n\tIFNULL(a.ht_bef_yx,0)+IFNULL(b.ht_bef_yx,0) AS ht_bef_yx,\r\n\tIFNULL(a.ht_bef,0)+IFNULL(b.ht_bef,0) AS ht_bef,\r\n\tIFNULL(a.ht_bef_tong,0)+IFNULL(b.ht_bef_tong,0) AS ht_bef_tong,\r\n\r\n\tIFNULL(a.ht_cur_yuce,0) AS ht_cur_yuce,\r\n\tIFNULL(a.ht_cur_tong,0)+IFNULL(b.ht_cur_tong,0) AS ht_cur_tong,\r\n\r\n\tIFNULL(a.ht_all_yx,0)+IFNULL(b.ht_all_yx,0) AS ht_all_yx,\r\n\tIFNULL(a.ht_bef_tong,0)+IFNULL(b.ht_bef_tong,0)+IFNULL(a.ht_cur_tong,0)+IFNULL(b.ht_cur_tong,0) AS ht_all_tong\r\nFROM (\r\n\tSELECT\r\n\t\td.groupid AS daqu_id,\r\n\t\td.groupname AS daqu_name,\r\n\t\tc.groupid,\r\n\t\tc.groupname AS show_weidu,\r\n\t\tSUM(m.ys_bef)*0.0001 AS ys_bef,\r\n\t\tSUM(m.ys_cur)*0.0001 AS ys_cur,\r\n\t\tSUM(m.ys_all)*0.0001 AS ys_all,\r\n\r\n\t\tSUM((IFNULL(h.ht_bef_yx,0)+IFNULL(i.ht_bef_yx,0)))*0.0001 AS ht_bef_yx,\r\n\t\tSUM((IFNULL(h.ht_bef,0)+IFNULL(i.ht_bef,0)))*0.0001 AS ht_bef,\r\n\t\tSUM((IFNULL(h.ht_bef_tong,0)+IFNULL(i.ht_bef_tong,0)))*0.0001 AS ht_bef_tong,\r\n\r\n\t\tSUM(IFNULL(j.amount,0))*0.0001 AS ht_cur_yuce,\r\n\t\tSUM((IFNULL(h.ht_cur_tong,0)+IFNULL(i.ht_cur_tong,0)))*0.0001 AS ht_cur_tong,\r\n\r\n\t\tSUM((IFNULL(h.ht_bef_yx,0)+IFNULL(i.ht_bef_yx,0)))*0.0001 AS ht_all_yx,\r\n\t\te.sequence AS seq1,\r\n\t\tf.sequence AS seq2\r\n\tFROM ld_users a\r\n\tLEFT JOIN ld_users2group b ON b.userid=a.id\r\n\tLEFT JOIN ld_groups c ON c.groupid=b.groupid\r\n\tLEFT JOIN ld_groups d ON d.groupid=c.parentid\r\n\tLEFT JOIN ld_picklist_values e ON e.listid=107 AND e.listvalue=d.groupname\r\n\tLEFT JOIN ld_picklist_values f ON f.listid=108 AND e.listvalue=c.groupname\r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\tuserid,\r\n\t\t\tSUM(CASE WHEN targetmouth<'{yue}' THEN paymentamount ELSE 0 END) AS ys_bef,\r\n\t\t\tSUM(CASE WHEN targetmouth='{yue}' THEN paymentamount ELSE 0 END) AS ys_cur,\r\n\t\t\tSUM(paymentamount) ys_all\r\n\t\tFROM ld_salestarget\r\n\t\tWHERE targetyear='{nian}'\r\n\t\t\tAND targetmouth<='{yue}'\r\n\t\tGROUP BY userid\r\n\t) m ON m.userid=a.id\r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\ta.smownerid,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN YEAR(a.createdtime)='{nian}' AND MONTH(a.createdtime)<'{yue}' AND b.cf_4817+0=0 THEN a.subtotal \r\n\t\t\t\tWHEN YEAR(a.createdtime)='{nian}' AND MONTH(a.createdtime)<'{yue}' AND b.cf_4817=1 THEN a.subtotal*0.01*IFNULL(b.cf_4818,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS ht_bef_yx,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN YEAR(a.createdtime)='{nian}' AND MONTH(a.createdtime)<'{yue}' AND b.cf_4817+0=0 THEN a.subtotal \r\n\t\t\t\tWHEN YEAR(a.createdtime)='{nian}' AND MONTH(a.createdtime)<'{yue}' AND b.cf_4817=1 THEN a.subtotal*0.01*IFNULL(b.cf_4818,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS ht_bef,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN YEAR(a.createdtime)='{nian}'-1 AND MONTH(a.createdtime)<'{yue}' AND b.cf_4817+0=0 THEN a.subtotal \r\n\t\t\t\tWHEN YEAR(a.createdtime)='{nian}'-1 AND MONTH(a.createdtime)<'{yue}' AND b.cf_4817=1 THEN a.subtotal*0.01*IFNULL(b.cf_4818,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS ht_bef_tong,\r\n\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN YEAR(a.createdtime)='{nian}'-1 AND MONTH(a.createdtime)='{yue}' AND b.cf_4817+0=0 THEN a.subtotal \r\n\t\t\t\tWHEN YEAR(a.createdtime)='{nian}'-1 AND MONTH(a.createdtime)='{yue}' AND b.cf_4817=1 THEN a.subtotal*0.01*IFNULL(b.cf_4818,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS ht_cur_tong\r\n\t\tFROM ld_cashbill a\r\n\t\tLEFT JOIN ld_cashbillscf b ON b.cashbillid=a.cashbillid\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus='已批准'\r\n\t\t\tAND a.cashtype='cashbill'\r\n\t\t\tAND YEAR(a.createdtime) IN ('{nian}','{nian}'-1)\r\n\t\t\tAND a.smownerid>0\r\n\t\tGROUP BY a.smownerid\r\n\t) h ON h.smownerid=a.id\r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\tb.cf_4992 AS yidi_ownerid,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN YEAR(a.createdtime)='{nian}' AND MONTH(a.createdtime)<'{yue}' THEN a.subtotal*0.01*IFNULL(b.cf_4820,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS ht_bef_yx,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN YEAR(a.createdtime)='{nian}' AND MONTH(a.createdtime)<'{yue}' THEN a.subtotal*0.01*IFNULL(b.cf_4820,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS ht_bef,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN YEAR(a.createdtime)='{nian}'-1 AND MONTH(a.createdtime)<'{yue}' THEN a.subtotal*0.01*IFNULL(b.cf_4820,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS ht_bef_tong,\r\n\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN YEAR(a.createdtime)='{nian}'-1 AND MONTH(a.createdtime)='{yue}' THEN a.subtotal*0.01*IFNULL(b.cf_4820,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS ht_cur_tong\r\n\t\tFROM ld_cashbill a\r\n\t\tLEFT JOIN ld_cashbillscf b ON b.cashbillid=a.cashbillid\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus='已批准'\r\n\t\t\tAND a.cashtype='cashbill'\r\n\t\t\tAND YEAR(a.createdtime) IN ('{nian}','{nian}'-1)\r\n\t\t\tAND b.cf_4817=1\r\n\t\t\tAND b.cf_4992>0\r\n\t\tGROUP BY b.cf_4992\r\n\t\tUNION ALL\r\n\t\tSELECT\r\n\t\t\tb.cf_4993 AS yidi_ownerid,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN YEAR(a.createdtime)='{nian}' AND MONTH(a.createdtime)<'{yue}' THEN a.subtotal*0.01*IFNULL(b.cf_4822,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS ht_bef_yx,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN YEAR(a.createdtime)='{nian}' AND MONTH(a.createdtime)<'{yue}' THEN a.subtotal*0.01*IFNULL(b.cf_4822,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS ht_bef,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN YEAR(a.createdtime)='{nian}'-1 AND MONTH(a.createdtime)<'{yue}' THEN a.subtotal*0.01*IFNULL(b.cf_4822,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS ht_bef_tong,\r\n\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN YEAR(a.createdtime)='{nian}'-1 AND MONTH(a.createdtime)='{yue}' THEN a.subtotal*0.01*IFNULL(b.cf_4822,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS ht_cur_tong\r\n\t\tFROM ld_cashbill a\r\n\t\tLEFT JOIN ld_cashbillscf b ON b.cashbillid=a.cashbillid\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus='已批准'\r\n\t\t\tAND a.cashtype='cashbill'\r\n\t\t\tAND YEAR(a.createdtime) IN ('{nian}','{nian}'-1)\r\n\t\t\tAND b.cf_4817=1\r\n\t\t\tAND b.cf_4993>0\r\n\t\tGROUP BY b.cf_4993\r\n\t\tUNION ALL\r\n\t\tSELECT\r\n\t\t\tb.cf_4994 AS yidi_ownerid,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN YEAR(a.createdtime)='{nian}' AND MONTH(a.createdtime)<'{yue}' THEN a.subtotal*0.01*IFNULL(b.cf_4824,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS ht_bef_yx,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN YEAR(a.createdtime)='{nian}' AND MONTH(a.createdtime)<'{yue}' THEN a.subtotal*0.01*IFNULL(b.cf_4824,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS ht_bef,\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN YEAR(a.createdtime)='{nian}'-1 AND MONTH(a.createdtime)<'{yue}' THEN a.subtotal*0.01*IFNULL(b.cf_4824,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS ht_bef_tong,\r\n\r\n\t\t\tSUM(CASE \r\n\t\t\t\tWHEN YEAR(a.createdtime)='{nian}'-1 AND MONTH(a.createdtime)='{yue}' THEN a.subtotal*0.01*IFNULL(b.cf_4824,0) \r\n\t\t\t\tELSE 0 \r\n\t\t\tEND) AS ht_cur_tong\r\n\t\tFROM ld_cashbill a\r\n\t\tLEFT JOIN ld_cashbillscf b ON b.cashbillid=a.cashbillid\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus='已批准'\r\n\t\t\tAND a.cashtype='cashbill'\r\n\t\t\tAND YEAR(a.createdtime) IN ('{nian}','{nian}'-1)\r\n\t\t\tAND b.cf_4817=1\r\n\t\t\tAND b.cf_4994>0\r\n\t\tGROUP BY b.cf_4994\r\n\t) i ON i.yidi_ownerid=a.id\r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\ta.smownerid,\r\n\t\t\tSUM(a.amount) AS amount\r\n\t\tFROM ld_paymentplan a\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\tAND YEAR(a.plandate)='{nian}'\r\n\t\t\tAND MONTH(a.plandate)='{yue}'\r\n\t\tGROUP BY a.smownerid\r\n\t) j ON j.smownerid=a.id\r\n\tINNER JOIN (\r\n\t\tSELECT DISTINCT\r\n\t\t\tuserid\r\n\t\tFROM (\r\n\t\t\tSELECT\r\n\t\t\t\t ld_users.id AS userid\r\n\t\t\tFROM ld_users\r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='CashBill' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\tUNION\r\n\t\t\tSELECT\r\n\t\t\t\t viewid AS userid\r\n\t\t\tFROM ld_scoperhigher\r\n\t\t\tWHERE userid='[uuid]' AND modulename ='CashBill' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename ='CashBill')\r\n\t\t\tUNION\r\n\t\t\tSELECT DISTINCT\r\n\t\t\t\t ld_users2group.userid AS userid\r\n\t\t\tFROM ld_scoperhigher\r\n\t\t\t\t\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\t\t\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\tWHERE ld_scoperhigher.userid='[uuid]'\r\n\t\t\t AND ld_scoperhigher.modulename ='CashBill'\r\n\t\t\t AND ld_scoperhigher.scopeauthority=3\r\n\t\t\t AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='CashBill' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\tUNION\r\n\t\t\tSELECT\r\n\t\t\t\t id AS userid\r\n\t\t\tFROM ld_users\r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\tUNION\r\n\t\t\tSELECT '[uuid]') AS vw_users\r\n\t) AS tmp_users ON tmp_users.userid=a.id\r\n\tWHERE a.deleted=0\r\n\t\tAND c.parentgroup LIKE '1::2::7::%' \r\n\t\tAND d.parentgroup LIKE '1::2::7::%'\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{fanwei}'='' THEN 1=1 \r\n\t\t\t\tELSE FIND_IN_SET(d.groupid,'{fanwei}')\r\n\t\t\tEND)\r\n\tGROUP BY c.groupid\r\n) a\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\ta.yidi_groupid,\r\n\t\tSUM(a.ht_bef_yx)*0.0001 AS ht_bef_yx,\r\n\t\tSUM(a.ht_bef)*0.0001 AS ht_bef,\r\n\t\tSUM(a.ht_bef_tong)*0.0001 AS ht_bef_tong,\r\n\r\n\t\tSUM(a.ht_cur_tong)*0.0001 AS ht_cur_tong,\r\n\r\n\t\tSUM(a.ht_bef_yx)*0.0001 AS ht_all_yx\r\n\tFROM (\r\n\tSELECT\r\n\t\ta.department AS yidi_groupid,\r\n\t\tSUM(CASE \r\n\t\t\tWHEN YEAR(a.createdtime)='{nian}' AND MONTH(a.createdtime)<'{yue}' THEN a.subtotal*0.01*IFNULL(b.cf_4820,0) \r\n\t\t\tELSE 0 \r\n\t\tEND) AS ht_bef_yx,\r\n\t\tSUM(CASE \r\n\t\t\tWHEN YEAR(a.createdtime)='{nian}' AND MONTH(a.createdtime)<'{yue}' THEN a.subtotal*0.01*IFNULL(b.cf_4820,0) \r\n\t\t\tELSE 0 \r\n\t\tEND) AS ht_bef,\r\n\t\tSUM(CASE \r\n\t\t\tWHEN YEAR(a.createdtime)='{nian}'-1 AND MONTH(a.createdtime)<'{yue}' THEN a.subtotal*0.01*IFNULL(b.cf_4820,0) \r\n\t\t\tELSE 0 \r\n\t\tEND) AS ht_bef_tong,\r\n\r\n\t\tSUM(CASE \r\n\t\t\tWHEN YEAR(a.createdtime)='{nian}'-1 AND MONTH(a.createdtime)='{yue}' THEN a.subtotal*0.01*IFNULL(b.cf_4820,0) \r\n\t\t\tELSE 0 \r\n\t\tEND) AS ht_cur_tong\r\n\tFROM ld_cashbill a\r\n\tLEFT JOIN ld_cashbillscf b ON b.cashbillid=a.cashbillid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus='已批准'\r\n\t\tAND a.cashtype='cashbill'\r\n\t\tAND YEAR(a.createdtime) IN ('{nian}','{nian}'-1)\r\n\t\tAND b.cf_4817=1\r\n\t\tAND a.department>0\r\n\t\tAND IFNULL(b.cf_4992,0)=0\r\n\tGROUP BY a.department\r\n\tUNION ALL\r\n\tSELECT\r\n\t\ta.department1 AS yidi_groupid,\r\n\t\tSUM(CASE \r\n\t\t\tWHEN YEAR(a.createdtime)='{nian}' AND MONTH(a.createdtime)<'{yue}' THEN a.subtotal*0.01*IFNULL(b.cf_4822,0) \r\n\t\t\tELSE 0 \r\n\t\tEND) AS ht_bef_yx,\r\n\t\tSUM(CASE \r\n\t\t\tWHEN YEAR(a.createdtime)='{nian}' AND MONTH(a.createdtime)<'{yue}' THEN a.subtotal*0.01*IFNULL(b.cf_4822,0) \r\n\t\t\tELSE 0 \r\n\t\tEND) AS ht_bef,\r\n\t\tSUM(CASE \r\n\t\t\tWHEN YEAR(a.createdtime)='{nian}'-1 AND MONTH(a.createdtime)<'{yue}' THEN a.subtotal*0.01*IFNULL(b.cf_4822,0) \r\n\t\t\tELSE 0 \r\n\t\tEND) AS ht_bef_tong,\r\n\r\n\t\tSUM(CASE \r\n\t\t\tWHEN YEAR(a.createdtime)='{nian}'-1 AND MONTH(a.createdtime)='{yue}' THEN a.subtotal*0.01*IFNULL(b.cf_4822,0) \r\n\t\t\tELSE 0 \r\n\t\tEND) AS ht_cur_tong\r\n\tFROM ld_cashbill a\r\n\tLEFT JOIN ld_cashbillscf b ON b.cashbillid=a.cashbillid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus='已批准'\r\n\t\tAND a.cashtype='cashbill'\r\n\t\tAND YEAR(a.createdtime) IN ('{nian}','{nian}'-1)\r\n\t\tAND b.cf_4817=1\r\n\t\tAND a.department1>0\r\n\t\tAND IFNULL(b.cf_4993,0)=0\r\n\tGROUP BY a.department1\r\n\tUNION ALL\r\n\tSELECT\r\n\t\ta.department2 AS yidi_groupid,\r\n\t\tSUM(CASE \r\n\t\t\tWHEN YEAR(a.createdtime)='{nian}' AND MONTH(a.createdtime)<'{yue}' THEN a.subtotal*0.01*IFNULL(b.cf_4824,0) \r\n\t\t\tELSE 0 \r\n\t\tEND) AS ht_bef_yx,\r\n\t\tSUM(CASE \r\n\t\t\tWHEN YEAR(a.createdtime)='{nian}' AND MONTH(a.createdtime)<'{yue}' THEN a.subtotal*0.01*IFNULL(b.cf_4824,0) \r\n\t\t\tELSE 0 \r\n\t\tEND) AS ht_bef,\r\n\t\tSUM(CASE \r\n\t\t\tWHEN YEAR(a.createdtime)='{nian}'-1 AND MONTH(a.createdtime)<'{yue}' THEN a.subtotal*0.01*IFNULL(b.cf_4824,0) \r\n\t\t\tELSE 0 \r\n\t\tEND) AS ht_bef_tong,\r\n\r\n\t\tSUM(CASE \r\n\t\t\tWHEN YEAR(a.createdtime)='{nian}'-1 AND MONTH(a.createdtime)='{yue}' THEN a.subtotal*0.01*IFNULL(b.cf_4824,0) \r\n\t\t\tELSE 0 \r\n\t\tEND) AS ht_cur_tong\r\n\tFROM ld_cashbill a\r\n\tLEFT JOIN ld_cashbillscf b ON b.cashbillid=a.cashbillid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus='已批准'\r\n\t\tAND a.cashtype='cashbill'\r\n\t\tAND YEAR(a.createdtime) IN ('{nian}','{nian}'-1)\r\n\t\tAND b.cf_4817=1\r\n\t\tAND a.department2>0\r\n\t\tAND IFNULL(b.cf_4994,0)=0\r\n\tGROUP BY a.department2\r\n\t) a\r\n\tGROUP BY a.yidi_groupid\r\n) b ON b.yidi_groupid=a.groupid\r\nWHERE 1=1\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{fangshi}'=1 THEN 1=1 \r\n\t\t\tELSE 1=0\r\n\t\tEND)\r\nORDER BY a.seq1,a.seq2"
      },
      "6": {
        "Ident": "StiMySqlSource",
        "Name": "d",
        "Alias": "d",
        "Columns": {
          "0": {
