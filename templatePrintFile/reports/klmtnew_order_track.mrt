        "NameInSource": "ldcrm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\ta.salesorderid AS orderid,\r\n\ta.signed_data,\r\n\tb.cf_2327 AS qianyuefang,\r\n\ta.salesorder_no AS orderno,\r\n\tc.potentialname AS ccfno,\r\n\td.accountname,\r\n\tb.cf_2323 AS ordertype,\r\n\ta.order_startdate,\r\n\ta.order_enddate,\r\n\tROUND(a.total/IFNULL(a.conversion_rate,1),2) AS total,\r\n\tROUND(IFNULL(m.total,0),2) AS received_amount,\r\n\tROUND(IFNULL(n.total,0),2) AS have_invoicetotal,\r\n\tROUND(a.total/IFNULL(a.conversion_rate,1),2)-ROUND(IFNULL(m.total,0),2) AS receivable_balance,\r\n\tROUND(a.total/IFNULL(a.conversion_rate,1),2)-ROUND(IFNULL(n.total,0),2) AS nothave_invoicetotal,\r\n\tu1.last_name AS smowner,\r\n\ta.smownerid,\r\n\tu2.last_name AS smbiller,\r\n\tb.cf_2395 AS quyu,\r\n\tb.cf_2321 AS term,\r\n\ta.description,\r\n\tn.invoicedetail,\r\n\tm.cashdetail\r\nFROM ld_salesorder a\r\nLEFT JOIN ld_salesordercf b ON b.salesorderid=a.salesorderid\r\nLEFT JOIN ld_potential c ON c.potentialid=a.potentialid\r\nLEFT JOIN ld_account d ON d.accountid=a.accountid\r\nLEFT JOIN ld_users u1 ON u1.id=a.smownerid\r\nLEFT JOIN ld_users u2 ON u2.id=a.smcreatorid\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\tc.entitytypeid,\r\n\t\tSUM(c.amount) AS total,\r\n\t\tGROUP_CONCAT(CONCAT(a.cashbilldate,'  ',FORMAT(IFNULL(c.amount,0),2)) SEPARATOR '\r\n') AS cashdetail\r\n\tFROM ld_cashbill a\r\n\tLEFT JOIN ld_cashbillscf b ON a.cashbillid=b.cashbillid\r\n\tLEFT JOIN ld_cashbill2paymentplan c ON c.CashBillID=a.cashbillid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND c.entitytype='SalesOrder'\r\n\t\tAND c.entitytypeid>0\r\n\tGROUP BY c.entitytypeid\r\n) m ON m.entitytypeid=a.salesorderid\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\tc.entitytypeid,\r\n\t\tSUM(c.tax_amount) AS total,\r\nGROUP_CONCAT(CONCAT(a.invoicedate,'  ',FORMAT(IFNULL(c.tax_amount,0),2)) SEPARATOR '\r\n') AS invoicedetail\r\n\tFROM ld_invoice a\r\n\tLEFT JOIN ld_invoicecf b ON a.invoiceid=b.invoiceid\r\n\tLEFT JOIN ld_invoicedetail c ON c.id=a.invoiceid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND c.entitytype='SalesOrder'\r\n\t\tAND c.entitytypeid>0\r\n\tGROUP BY c.entitytypeid\r\n) n ON n.entitytypeid=a.salesorderid\r\nINNER JOIN (\r\n\tSELECT DISTINCT\r\n\t\tuserid \r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\tld_users.id AS userid \r\n\t\tFROM ld_users\r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='SalesOrder' and scopeauthority=1 AND userid='[uuid]')\r\n\t\tUNION\r\n\t\tSELECT \r\n\t\t\tviewid AS userid \r\n\t\tFROM ld_scoperhigher\r\n\t\tWHERE userid='[uuid]' AND modulename='SalesOrder' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename='SalesOrder')\t\t\t\r\n\t\tUNION\r\n\t\tSELECT DISTINCT \r\n\t\t\tld_users2group.userid AS userid \r\n\t\tFROM ld_scoperhigher \r\n\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\tAND ld_scoperhigher.modulename='SalesOrder'\r\n\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='SalesOrder' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\tUNION \r\n\t\tSELECT \r\n\t\t\tid AS userid \r\n\t\tFROM ld_users  \r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\tUNION\r\n\t\tSELECT '[uuid]') AS vw_users\r\n) AS list_user ON list_user.userid=a.smownerid\r\nWHERE a.deleted=0\r\n\tAND a.approvestatus<>'已拒绝'\r\n\tAND IFNULL(b.cf_2380,'')<>'作废单据'\r\n\tAND a.signed_data BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{ccfnum}'='' THEN 1=1\r\n\t\t\tELSE LOCATE(TRIM('{ccfnum}'),c.potentialname)>0\r\n\t\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{custname}'='' THEN 1=1\r\n\t\t\tELSE LOCATE(TRIM('{custname}'),d.accountname)>0\r\n\t\tEND)\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{quyu}'='' OR '{quyu}'=(SELECT GROUP_CONCAT(listvalue) FROM ld_picklist_values WHERE listid=123 ORDER BY sequence) THEN 1=1\r\n\t\t\t\tELSE FIND_IN_SET(b.cf_2395,'{quyu}')\r\n\t\t\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{userid}'='' THEN 1=1\r\n\t\t\tELSE FIND_IN_SET(a.smownerid,'{userid}')\r\n\t\tEND)\r\nORDER BY CONVERT(u1.last_name USING GBK),a.signed_data,a.createdtime"
      },
      "3": {
        "Ident": "StiMySqlSource",
        "Name": "r",
        "Alias": "r",
        "Columns": {
          "0": {
            "Name": "billdate",
            "Index": -1,
            "NameInSource": "billdate",
            "Alias": "billdate",
            "Type": "System.DateTime"
          },
          "1": {
            "Name": "total",
            "Index": -1,
            "NameInSource": "total",
            "Alias": "total",
            "Type": "System.Object"
          }
        },
        "NameInSource": "ldcrm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\tbilldate,\r\n\ttotal\r\nFROM (\r\n\tSELECT\r\n\t\t'收款' AS type,\r\n\t\ta.cashbilldate AS billdate,\r\n\t\tc.amount AS total,\r\n\t\ta.createdtime\r\n\tFROM ld_cashbill a\r\n\tLEFT JOIN ld_cashbillscf b ON a.cashbillid=b.cashbillid\r\n\tLEFT JOIN ld_cashbill2paymentplan c ON c.CashBillID=a.cashbillid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND c.entitytype='SalesOrder'\r\n\t\tAND c.entitytypeid='{this[\"id\"]}'\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{this[\"clicktype\"]}'='1' THEN 1=1\r\n\t\t\t\tELSE 1=0\r\n\t\t\tEND)\r\n\tUNION ALL\r\n\tSELECT\r\n\t\t'开票' AS type,\r\n\t\ta.invoicedate,\r\n\t\tc.tax_amount AS total,\r\n\t\ta.createdtime\r\n\tFROM ld_invoice a\r\n\tLEFT JOIN ld_invoicecf b ON a.invoiceid=b.invoiceid\r\n\tLEFT JOIN ld_invoicedetail c ON c.id=a.invoiceid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND c.entitytype='SalesOrder'\r\n\t\tAND c.entitytypeid='{this[\"id\"]}'\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{this[\"clicktype\"]}'='2' THEN 1=1\r\n\t\t\t\tELSE 1=0\r\n\t\t\tEND)\r\n) a\r\nORDER BY billdate,createdtime"
      }
    },
    "Databases": {
