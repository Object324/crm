    <DataSources isList="true" count="4">
      <date isKey="true" type="Stimulsoft.Report.Dictionary.StiMySqlSource" Ref="3">
        <Alias>date</Alias>
        <Columns isList="true" count="2">
          <value>startdate,System.String</value>
          <value>enddate,System.DateTime</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1"/>
        <Name>date</Name>
        <NameInSource>ldcrm</NameInSource>
        <Parameters isList="true" count="0"/>
        <SqlCommand>SELECT
	CASE
		WHEN '{type}'=1 THEN concat(date_format(LAST_DAY(MAKEDATE(EXTRACT(YEAR FROM STR_TO_DATE(replace('{start_date}','/','.'),GET_FORMAT(DATE,'USA'))),1) + interval QUARTER(STR_TO_DATE(replace('{start_date}','/','.'),GET_FORMAT(DATE,'USA')))*3-3 month),'%Y-%m-'),'01')
		WHEN '{type}'=2 THEN concat(date_format(LAST_DAY(STR_TO_DATE(replace('{start_date}','/','.'),GET_FORMAT(DATE,'USA'))),'%Y-%m-'),'01') 
		WHEN '{type}'=3 THEN date_sub(STR_TO_DATE(replace('{start_date}','/','.'),GET_FORMAT(DATE,'USA')),INTERVAL WEEKDAY(STR_TO_DATE(replace('{start_date}','/','.'),GET_FORMAT(DATE,'USA'))) DAY)
		WHEN '{type}'=4 THEN STR_TO_DATE(replace('{start_date}','/','.'),GET_FORMAT(DATE,'USA'))
	END as startdate,
	CASE
		WHEN '{type}'=1 THEN LAST_DAY(MAKEDATE(EXTRACT(YEAR FROM STR_TO_DATE(replace('{end_date}','/','.'),GET_FORMAT(DATE,'USA'))),1) + interval QUARTER(STR_TO_DATE(replace('{end_date}','/','.'),GET_FORMAT(DATE,'USA')))*3-1 month)
		WHEN '{type}'=2 THEN LAST_DAY(STR_TO_DATE(replace('{end_date}','/','.'),GET_FORMAT(DATE,'USA'))) 
		WHEN '{type}'=3 THEN date_sub(STR_TO_DATE(replace('{end_date}','/','.'),GET_FORMAT(DATE,'USA')),INTERVAL WEEKDAY(STR_TO_DATE(replace('{end_date}','/','.'),GET_FORMAT(DATE,'USA'))) -6 DAY)
		WHEN '{type}'=4 THEN STR_TO_DATE(replace('{end_date}','/','.'),GET_FORMAT(DATE,'USA'))
	END as enddate</SqlCommand>
      </date>
      <cash isKey="true" type="Stimulsoft.Report.Dictionary.StiMySqlSource" Ref="4">
        <Alias>cash</Alias>
        <Columns isList="true" count="7">
          <value>date,System.DateTime</value>
          <value>remark,System.String</value>
          <value>total,System.Decimal</value>
          <value>total_bef,System.Decimal</value>
          <value>huanbi,System.String</value>
          <value>tips,System.String</value>
          <value>tips_bef,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1"/>
        <Name>cash</Name>
        <NameInSource>ldcrm</NameInSource>
        <Parameters isList="true" count="0"/>
        <SqlCommand>SELECT
	*,
	CASE
		WHEN total_bef=0 THEN '--'
		ELSE concat(format((total-total_bef)*100/total_bef,2),'%')
	END AS huanbi,
	format(total,2) as tips,
	format(total_bef,2) as tips_bef
FROM (
	SELECT
		t.date,
		t.remark,
		t.total,
		IFNULL((SELECT
				Total
			FROM (
				SELECT
					date,
					remark,
					sum(total) as total
				FROM (
					SELECT
						a.date as date,
						CASE
							WHEN '{type}'=1 THEN CONCAT(year(a.date),'年Q',quarter(a.date))
							WHEN '{type}'=2 THEN CONCAT(year(a.date),'年',DATE_FORMAT(a.date,'%m'),'月')
							WHEN '{type}'=3 THEN CONCAT(year(a.date),'年',WEEK(a.date),'周')
							WHEN '{type}'=4 THEN signed_data
						END AS remark,	
						round(ifnull(b.Total,0)/ifnull(b.conversion_rate,1),2) as total
					FROM tmp_date a
					LEFT JOIN ld_salesorder b on a.date=b.signed_data
					WHERE ifnull(b.deleted,0)=0
						and (
							CASE
								WHEN '{userid}'='' THEN 
									FIND_IN_SET(CASE WHEN b.smownerid is NULL THEN 1 ELSE b.smownerid END,(
										SELECT
											GROUP_CONCAT(userid)
										FROM (
											SELECT DISTINCT
												userid 
											FROM (
												SELECT 
													ld_users.id as userid 
												FROM ld_users
												WHERE EXISTS(select 1 from ld_setscoperhigher where modulename='SalesOrder' and scopeauthority=1 and userid='[uuid]')
												UNION
												select 
													viewid as userid 
												from ld_scoperhigher
												where userid='[uuid]' and modulename='SalesOrder' and EXISTS(select 1 from ld_setscoperhigher where userid='[uuid]' and scopeauthority=2 and modulename='SalesOrder')			
												UNION
												select DISTINCT 
													ld_users2group.userid as userid 
												from ld_scoperhigher 
												INNER JOIN ld_groups on ld_groups.groupid=ld_scoperhigher.viewid
												INNER JOIN ld_users2group on ld_users2group.groupid=ld_groups.groupid
												WHERE ld_scoperhigher.userid='[uuid]' 
													and ld_scoperhigher.modulename='SalesOrder'
													and ld_scoperhigher.scopeauthority=3 
													and EXISTS(select 1 from ld_setscoperhigher where modulename='SalesOrder' and scopeauthority=3 and userid='[uuid]')
												UNION 
												select 
													id as userid 
												from ld_users  
												where exists(select 1 from ld_users where id='[uuid]' and is_admin='on')
												UNION
												select '[uuid]')as vw_users
										) as tmp_users))
								ELSE FIND_IN_SET(CASE WHEN b.smownerid is NULL THEN 1 ELSE b.smownerid END,'{userid}')
							END)
						and IF(b.approvestatus='已批准','0','1') &lt;&gt; (IF('{approve}'='true','1','0.001'))
AND b.sostatus != '已作废'
						and (
							CASE
								WHEN '{type}'=1 THEN 
									a.date BETWEEN concat(date_format(LAST_DAY(MAKEDATE(EXTRACT(YEAR FROM STR_TO_DATE(replace('{start_date}','/','.'),GET_FORMAT(DATE,'USA'))),1) + interval QUARTER(STR_TO_DATE(replace('{start_date}','/','.'),GET_FORMAT(DATE,'USA')))*3-3 month),'%Y-%m-'),'01')
										AND LAST_DAY(MAKEDATE(EXTRACT(YEAR FROM STR_TO_DATE(replace('{end_date}','/','.'),GET_FORMAT(DATE,'USA'))),1) + interval QUARTER(STR_TO_DATE(replace('{end_date}','/','.'),GET_FORMAT(DATE,'USA')))*3-1 month)
								WHEN '{type}'=2 THEN a.date BETWEEN concat(date_format(LAST_DAY(STR_TO_DATE(replace('{start_date}','/','.'),GET_FORMAT(DATE,'USA'))),'%Y-%m-'),'01') AND LAST_DAY(STR_TO_DATE(replace('{end_date}','/','.'),GET_FORMAT(DATE,'USA')))
								WHEN '{type}'=3 THEN a.date BETWEEN date_sub(STR_TO_DATE(replace('{start_date}','/','.'),GET_FORMAT(DATE,'USA')),INTERVAL WEEKDAY(STR_TO_DATE(replace('{start_date}','/','.'),GET_FORMAT(DATE,'USA'))) DAY) AND date_sub(STR_TO_DATE(replace('{end_date}','/','.'),GET_FORMAT(DATE,'USA')),INTERVAL WEEKDAY(STR_TO_DATE(replace('{end_date}','/','.'),GET_FORMAT(DATE,'USA'))) -6 DAY)
								WHEN '{type}'=4 THEN a.date BETWEEN STR_TO_DATE(replace('{start_date}','/','.'),GET_FORMAT(DATE,'USA')) AND STR_TO_DATE(replace('{end_date}','/','.'),GET_FORMAT(DATE,'USA'))
							END)
						ORDER BY date) a
				GROUP BY remark) a 
			WHERE date&lt;t.date
			ORDER BY date desc limit 1),0) as total_bef
	FROM (
		SELECT
			date,
			remark,
			sum(total) as total
		FROM (
			SELECT
				a.date as date,
				CASE
					WHEN '{type}'=1 THEN CONCAT(year(a.date),'年Q',quarter(a.date))
					WHEN '{type}'=2 THEN CONCAT(year(a.date),'年',DATE_FORMAT(a.date,'%m'),'月')
					WHEN '{type}'=3 THEN CONCAT(year(a.date),'年',WEEK(a.date),'周')
					WHEN '{type}'=4 THEN signed_data
				END AS remark,	
				round(ifnull(b.Total,0)/ifnull(b.conversion_rate,1),2) as total
			FROM tmp_date a
			LEFT JOIN ld_salesorder b on a.date=b.signed_data
			WHERE ifnull(b.deleted,0)=0
						and (
							CASE
								WHEN '{userid}'='' THEN 
									FIND_IN_SET(CASE WHEN b.smownerid is NULL THEN 1 ELSE b.smownerid END,(
										SELECT
											GROUP_CONCAT(userid)
										FROM (
											SELECT DISTINCT
												userid 
											FROM (
												SELECT 
													ld_users.id as userid 
												FROM ld_users
												WHERE EXISTS(select 1 from ld_setscoperhigher where modulename='SalesOrder' and scopeauthority=1 and userid='[uuid]')
												UNION
												select 
													viewid as userid 
												from ld_scoperhigher
												where userid='[uuid]' and modulename='SalesOrder' and EXISTS(select 1 from ld_setscoperhigher where userid='[uuid]' and scopeauthority=2 and modulename='SalesOrder')			
												UNION
												select DISTINCT 
													ld_users2group.userid as userid 
												from ld_scoperhigher 
												INNER JOIN ld_groups on ld_groups.groupid=ld_scoperhigher.viewid
												INNER JOIN ld_users2group on ld_users2group.groupid=ld_groups.groupid
												WHERE ld_scoperhigher.userid='[uuid]' 
													and ld_scoperhigher.modulename='SalesOrder'
													and ld_scoperhigher.scopeauthority=3 
													and EXISTS(select 1 from ld_setscoperhigher where modulename='SalesOrder' and scopeauthority=3 and userid='[uuid]')
												UNION 
												select 
													id as userid 
												from ld_users  
												where exists(select 1 from ld_users where id='[uuid]' and is_admin='on')
												UNION
												select '[uuid]')as vw_users
										) as tmp_users))
							ELSE FIND_IN_SET(CASE WHEN b.smownerid is NULL THEN 1 ELSE b.smownerid END,'{userid}')
							END)
					and IF(b.approvestatus='已批准','0','1') &lt;&gt; (IF('{approve}'='true','1','0.001'))
AND b.sostatus != '已作废'
					and (
						CASE
							WHEN '{type}'=1 THEN 
								a.date BETWEEN concat(date_format(LAST_DAY(MAKEDATE(EXTRACT(YEAR FROM STR_TO_DATE(replace('{start_date}','/','.'),GET_FORMAT(DATE,'USA'))),1) + interval QUARTER(STR_TO_DATE(replace('{start_date}','/','.'),GET_FORMAT(DATE,'USA')))*3-3 month),'%Y-%m-'),'01')
									AND LAST_DAY(MAKEDATE(EXTRACT(YEAR FROM STR_TO_DATE(replace('{end_date}','/','.'),GET_FORMAT(DATE,'USA'))),1) + interval QUARTER(STR_TO_DATE(replace('{end_date}','/','.'),GET_FORMAT(DATE,'USA')))*3-1 month)
							WHEN '{type}'=2 THEN a.date BETWEEN concat(date_format(LAST_DAY(STR_TO_DATE(replace('{start_date}','/','.'),GET_FORMAT(DATE,'USA'))),'%Y-%m-'),'01') AND LAST_DAY(STR_TO_DATE(replace('{end_date}','/','.'),GET_FORMAT(DATE,'USA')))
							WHEN '{type}'=3 THEN a.date BETWEEN date_sub(STR_TO_DATE(replace('{start_date}','/','.'),GET_FORMAT(DATE,'USA')),INTERVAL WEEKDAY(STR_TO_DATE(replace('{start_date}','/','.'),GET_FORMAT(DATE,'USA'))) DAY) AND date_sub(STR_TO_DATE(replace('{end_date}','/','.'),GET_FORMAT(DATE,'USA')),INTERVAL WEEKDAY(STR_TO_DATE(replace('{end_date}','/','.'),GET_FORMAT(DATE,'USA'))) -6 DAY)
							WHEN '{type}'=4 THEN a.date BETWEEN STR_TO_DATE(replace('{start_date}','/','.'),GET_FORMAT(DATE,'USA')) AND STR_TO_DATE(replace('{end_date}','/','.'),GET_FORMAT(DATE,'USA'))
						END)
			ORDER BY a.date) a
		GROUP BY remark) t
	ORDER BY date) a</SqlCommand>
      </cash>
      <user isKey="true" type="Stimulsoft.Report.Dictionary.StiMySqlSource" Ref="5">
        <Alias>user</Alias>
        <Columns isList="true" count="2">
          <value>id,System.Int32</value>
          <value>last_name,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1"/>
        <Name>user</Name>
        <NameInSource>ldcrm</NameInSource>
        <Parameters isList="true" count="0"/>
        <SqlCommand>SELECT
	a.id,
	a.last_name
FROM ld_users a
INNER JOIN (
	SELECT DISTINCT
		userid 
	FROM (
		SELECT 
			ld_users.id as userid 
		FROM ld_users
		WHERE EXISTS(select 1 from ld_setscoperhigher where modulename='CashBill' and scopeauthority=1 and userid='[uuid]')
		UNION
		select 
			viewid as userid 
		from ld_scoperhigher
		where userid='[uuid]' and modulename='CashBill' and EXISTS(select 1 from ld_setscoperhigher where userid='[uuid]' and scopeauthority=2 and modulename='CashBill')			
		UNION
		select DISTINCT 
			ld_users2group.userid as userid 
		from ld_scoperhigher 
		INNER JOIN ld_groups on ld_groups.groupid=ld_scoperhigher.viewid
		INNER JOIN ld_users2group on ld_users2group.groupid=ld_groups.groupid
		WHERE ld_scoperhigher.userid='[uuid]' 
			and ld_scoperhigher.modulename='CashBill'
			and ld_scoperhigher.scopeauthority=3 
			and EXISTS(select 1 from ld_setscoperhigher where modulename='CashBill' and scopeauthority=3 and userid='[uuid]')
		UNION 
		select 
			id as userid 
		from ld_users  
		where exists(select 1 from ld_users where id='[uuid]' and is_admin='on')
		UNION
		select '[uuid]')as vw_users
) as tmp_users ON tmp_users.userid=a.id
order by CONVERT(a.last_name USING gbk)</SqlCommand>
      </user>
      <detail isKey="true" type="Stimulsoft.Report.Dictionary.StiMySqlSource" Ref="6">
        <Alias>detail</Alias>
        <Columns isList="true" count="3">
          <value>date,System.DateTime</value>
          <value>remark,System.String</value>
          <value>total,System.Decimal</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1"/>
        <Name>detail</Name>
        <NameInSource>ldcrm</NameInSource>
        <Parameters isList="true" count="0"/>
        <SqlCommand>SELECT
	*
FROM (
	SELECT 
				a.date,
						CASE
							WHEN '{type}'=1 THEN CONCAT(year(a.date),'年Q',quarter(a.date))
							WHEN '{type}'=2 THEN CONCAT(year(a.date),'年',DATE_FORMAT(a.date,'%m'),'月')
							WHEN '{type}'=3 THEN CONCAT(year(a.date),'年',WEEK(a.date),'周')
							WHEN '{type}'=4 THEN signed_data
						END AS remark,	
				sum(round(ifnull(b.Total,0)/ifnull(b.conversion_rate,1),2)) as total
			FROM tmp_date a
			LEFT JOIN ld_salesorder b on a.date=b.signed_data
			WHERE ifnull(b.deleted,0)=0
				and (
					CASE
						WHEN '{userid}'='' THEN 
							FIND_IN_SET(CASE WHEN b.smownerid is NULL THEN 1 ELSE b.smownerid END,(
								SELECT
									GROUP_CONCAT(userid)
								FROM (
									SELECT DISTINCT
										userid 
									FROM (
										SELECT 
											ld_users.id as userid 
										FROM ld_users
										WHERE EXISTS(select 1 from ld_setscoperhigher where modulename='SalesOrder' and scopeauthority=1 and userid='[uuid]')
										UNION
										select 
											viewid as userid 
										from ld_scoperhigher
										where userid='[uuid]' and modulename='SalesOrder' and EXISTS(select 1 from ld_setscoperhigher where userid='[uuid]' and scopeauthority=2 and modulename='SalesOrder')			
										UNION
										select DISTINCT 
											ld_users2group.userid as userid 
										from ld_scoperhigher 
										INNER JOIN ld_groups on ld_groups.groupid=ld_scoperhigher.viewid
										INNER JOIN ld_users2group on ld_users2group.groupid=ld_groups.groupid
										WHERE ld_scoperhigher.userid='[uuid]' 
											and ld_scoperhigher.modulename='SalesOrder'
											and ld_scoperhigher.scopeauthority=3 
											and EXISTS(select 1 from ld_setscoperhigher where modulename='SalesOrder' and scopeauthority=3 and userid='[uuid]')
										UNION 
										select 
											id as userid 
										from ld_users  
										where exists(select 1 from ld_users where id='[uuid]' and is_admin='on')
										UNION
										select '[uuid]')as vw_users
								) as tmp_users))
						ELSE FIND_IN_SET(CASE WHEN b.smownerid is NULL THEN 1 ELSE b.smownerid END,'{userid}')
					END)
				and IF(b.approvestatus='已批准','0','1') &lt;&gt; (IF('{approve}'='true','1','0.001'))
				and b.sostatus !='已作废' 
				and (CASE
							WHEN '{type}'=1 THEN CONCAT(year(a.date),'年Q',quarter(a.date))
							WHEN '{type}'=2 THEN CONCAT(year(a.date),'年',DATE_FORMAT(a.date,'%m'),'月')
							WHEN '{type}'=3 THEN CONCAT(year(a.date),'年',WEEK(a.date),'周')
							WHEN '{type}'=4 THEN signed_data
						END ) group by a.date
	) a where remark='{this["remark"]}'</SqlCommand>
      </detail>
