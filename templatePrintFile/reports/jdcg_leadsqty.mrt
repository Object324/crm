            "Type": "System.Decimal"
          },
          "10": {
            "Name": "xiansuo_this_wuxiao",
            "Index": -1,
            "NameInSource": "xiansuo_this_wuxiao",
            "Alias": "xiansuo_this_wuxiao",
            "Type": "System.Decimal"
          }
        },
        "NameInSource": "crm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\tchart_type,\r\n\tSUM(xiansuo_this_re) AS xiansuo_this_re,\r\n\tSUM(xiansuo_this_wen) AS xiansuo_this_wen,\r\n\tSUM(xiansuo_this_leng) AS xiansuo_this_leng,\r\n\tSUM(xiansuo_this_wuxiao) AS xiansuo_this_wuxiao,\r\n\tSUM(xiansuo_all_re) AS xiansuo_all_re,\r\n\tSUM(xiansuo_all_wen) AS xiansuo_all_wen,\r\n\tSUM(xiansuo_all_leng) AS xiansuo_all_leng,\r\n\tSUM(xiansuo_all_wuxiao) AS xiansuo_all_wuxiao,\r\n\tSUM(xiansuo_this_re)+SUM(xiansuo_this_wen)+SUM(xiansuo_this_leng)+SUM(xiansuo_this_wuxiao) AS this_total,\r\n\tSUM(xiansuo_all_re)+SUM(xiansuo_all_wen)+SUM(xiansuo_all_leng)+SUM(xiansuo_all_wuxiao) AS all_total\r\nFROM (\r\n\tSELECT\r\n\t\ta.chart_type,\r\n\t\tSUM(a.xiansuo_this_re) AS xiansuo_this_re,\r\n\t\tSUM(a.xiansuo_this_wen) AS xiansuo_this_wen,\r\n\t\tSUM(a.xiansuo_this_leng) AS xiansuo_this_leng,\r\n\t\tSUM(a.xiansuo_this_wuxiao) AS xiansuo_this_wuxiao,\r\n\t\t0 AS xiansuo_all_re,\r\n\t\t0 AS xiansuo_all_wen,\r\n\t\t0 AS xiansuo_all_leng,\r\n\t\t0 AS xiansuo_all_wuxiao\r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{weidu}'=1 THEN u.last_name\r\n\t\t\t\tWHEN '{weidu}'=2 THEN u.user_pianqu\r\n\t\t\t\tWHEN '{weidu}'=3 THEN u.user_daqu\r\n\t\t\t\tWHEN '{weidu}'=5 THEN b.cf_3935\r\n\t\t\t\tELSE '公司整体'\r\n\t\t\tEND AS chart_type,\r\n\t\t\tCASE WHEN b.cf_3955='热线索' THEN 1 ELSE 0 END AS xiansuo_this_re,\r\n\t\t\tCASE WHEN b.cf_3955='温线索' THEN 1 ELSE 0 END AS xiansuo_this_wen,\r\n\t\t\tCASE WHEN b.cf_3955='冷线索' THEN 1 ELSE 0 END AS xiansuo_this_leng,\r\n\t\t\tCASE WHEN b.cf_3955='无效线索' THEN 1 ELSE 0 END AS xiansuo_this_wuxiao\r\n\t\tFROM (\r\n\t\t\tSELECT\r\n\t\t\t\ta.*\r\n\t\t\tFROM ld_customform53 a\r\n\t\t\tLEFT JOIN ld_customform53scf b ON b.customform53id=a.customform53id\r\n\t\t\tINNER JOIN (\r\n\t\t\t\tSELECT DISTINCT\r\n\t\t\t\t\tuserid \r\n\t\t\t\tFROM (\r\n\t\t\t\t\tSELECT \r\n\t\t\t\t\t\tld_users.id AS userid \r\n\t\t\t\t\tFROM ld_users\r\n\t\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='CustomForm53' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\t\t\tUNION\r\n\t\t\t\t\tSELECT \r\n\t\t\t\t\t\tviewid AS userid \r\n\t\t\t\t\tFROM ld_scoperhigher\r\n\t\t\t\t\tWHERE userid='[uuid]' AND modulename ='CustomForm53' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename ='CustomForm53')\t\t\t\r\n\t\t\t\t\tUNION\r\n\t\t\t\t\tSELECT DISTINCT \r\n\t\t\t\t\t\tld_users2group.userid AS userid \r\n\t\t\t\t\tFROM ld_scoperhigher \r\n\t\t\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\t\t\tAND ld_scoperhigher.modulename ='CustomForm53'\r\n\t\t\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='CustomForm53' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\t\t\tUNION \r\n\t\t\t\t\tSELECT \r\n\t\t\t\t\t\tid AS userid \r\n\t\t\t\t\tFROM ld_users  \r\n\t\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\t\t\tUNION\r\n\t\t\t\t\tSELECT '[uuid]') AS vw_users\r\n\t\t\t) AS tmp_users ON tmp_users.userid=a.smownerid\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND b.cf_3955 IN ('热线索','温线索','冷线索','无效线索')\r\n\t\t\t\tAND a.createdtime BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d 00:00:00') AND DATE_FORMAT('{end_date}','%Y-%m-%d 23:59:59')\r\n\t\t\tUNION\r\n\t\t\tSELECT\r\n\t\t\t\ta.*\r\n\t\t\tFROM ld_customform53 a\r\n\t\t\tLEFT JOIN ld_customform53scf b ON b.customform53id=a.customform53id\r\n\t\t\tINNER JOIN ld_tabshare s ON s.crmid=a.customform53id\r\n\t\t\tWHERE s.viewuserid='[uuid]'\r\n\t\t\t\tAND a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND b.cf_3955 IN ('热线索','温线索','冷线索','无效线索')\r\n\t\t\t\tAND a.createdtime BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d 00:00:00') AND DATE_FORMAT('{end_date}','%Y-%m-%d 23:59:59')\r\n\t\t) a\r\n\t\tLEFT JOIN ld_customform53scf b ON b.customform53id=a.customform53id\r\n\t\tLEFT JOIN ld_users u ON u.id=a.smownerid\r\n\t\tINNER JOIN ld_users2group e ON e.userid=u.id\r\n\t\tINNER JOIN ld_groups f ON f.groupid=e.groupid\r\n\t\tINNER JOIN (\r\n\t\t\tSELECT DISTINCT\r\n\t\t\t\tuserid \r\n\t\t\tFROM (\r\n\t\t\t\tSELECT \r\n\t\t\t\t\tld_users.id AS userid \r\n\t\t\t\tFROM ld_users\r\n\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='CustomForm53' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT \r\n\t\t\t\t\tviewid AS userid \r\n\t\t\t\tFROM ld_scoperhigher\r\n\t\t\t\tWHERE userid='[uuid]' AND modulename ='CustomForm53' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename ='CustomForm53')\t\t\t\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT DISTINCT \r\n\t\t\t\t\tld_users2group.userid AS userid \r\n\t\t\t\tFROM ld_scoperhigher \r\n\t\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\t\tAND ld_scoperhigher.modulename ='CustomForm53'\r\n\t\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='CustomForm53' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\t\tUNION \r\n\t\t\t\tSELECT \r\n\t\t\t\t\tid AS userid \r\n\t\t\t\tFROM ld_users  \r\n\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT '[uuid]') AS vw_users\r\n\t\t) AS tmp_users ON tmp_users.userid=a.smownerid\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus='已批准'\r\n\t\t\tAND (f.groupid=2 OR f.parentgroup LIKE '1::2::%')\r\n\t\t\tAND u.profileid IN (64,65)\r\n\t\t\tAND b.cf_3955 IN ('热线索','温线索','冷线索','无效线索')\r\n\t\t\tAND a.createdtime BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d 00:00:00') AND DATE_FORMAT('{end_date}','%Y-%m-%d 23:59:59')\r\n\t) a\r\n\tWHERE IFNULL(a.chart_type,'')<>''\r\n\tGROUP BY a.chart_type\r\n\tUNION ALL\r\n\tSELECT\r\n\t\ta.chart_type,\r\n\t\t0 AS xiansuo_this_re,\r\n\t\t0 AS xiansuo_this_wen,\r\n\t\t0 AS xiansuo_this_leng,\r\n\t\t0 AS xiansuo_this_wuxiao,\r\n\t\tSUM(a.xiansuo_all_re) AS xiansuo_all_re,\r\n\t\tSUM(a.xiansuo_all_wen) AS xiansuo_all_wen,\r\n\t\tSUM(a.xiansuo_all_leng) AS xiansuo_all_leng,\r\n\t\tSUM(a.xiansuo_all_wuxiao) AS xiansuo_all_wuxiao\r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{weidu}'=1 THEN u.last_name\r\n\t\t\t\tWHEN '{weidu}'=2 THEN u.user_pianqu\r\n\t\t\t\tWHEN '{weidu}'=3 THEN u.user_daqu\r\n\t\t\t\tWHEN '{weidu}'=5 THEN b.cf_3935\r\n\t\t\t\tELSE '公司整体'\r\n\t\t\tEND AS chart_type,\r\n\t\t\tCASE WHEN b.cf_3955='热线索' THEN 1 ELSE 0 END AS xiansuo_all_re,\r\n\t\t\tCASE WHEN b.cf_3955='温线索' THEN 1 ELSE 0 END AS xiansuo_all_wen,\r\n\t\t\tCASE WHEN b.cf_3955='冷线索' THEN 1 ELSE 0 END AS xiansuo_all_leng,\r\n\t\t\tCASE WHEN b.cf_3955='无效线索' THEN 1 ELSE 0 END AS xiansuo_all_wuxiao\r\n\t\tFROM ld_customform53 a\r\n\t\tLEFT JOIN ld_customform53scf b ON b.customform53id=a.customform53id\r\n\t\tLEFT JOIN ld_users u ON u.id=a.smownerid\r\n\t\tINNER JOIN ld_users2group e ON e.userid=u.id\r\n\t\tINNER JOIN ld_groups f ON f.groupid=e.groupid\r\n\t\tINNER JOIN (\r\n\t\t\tSELECT DISTINCT\r\n\t\t\t\tuserid \r\n\t\t\tFROM (\r\n\t\t\t\tSELECT \r\n\t\t\t\t\tld_users.id AS userid \r\n\t\t\t\tFROM ld_users\r\n\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='CustomForm53' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT \r\n\t\t\t\t\tviewid AS userid \r\n\t\t\t\tFROM ld_scoperhigher\r\n\t\t\t\tWHERE userid='[uuid]' AND modulename ='CustomForm53' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename ='CustomForm53')\t\t\t\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT DISTINCT \r\n\t\t\t\t\tld_users2group.userid AS userid \r\n\t\t\t\tFROM ld_scoperhigher \r\n\t\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\t\tAND ld_scoperhigher.modulename ='CustomForm53'\r\n\t\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='CustomForm53' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\t\tUNION \r\n\t\t\t\tSELECT \r\n\t\t\t\t\tid AS userid \r\n\t\t\t\tFROM ld_users  \r\n\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT '[uuid]') AS vw_users\r\n\t\t) AS tmp_users ON tmp_users.userid=a.smownerid\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus='已批准'\r\n\t\t\tAND (f.groupid=2 OR f.parentgroup LIKE '1::2::%')\r\n\t\t\tAND u.profileid IN (64,65)\r\n\t\t\tAND b.cf_3955 IN ('热线索','温线索','冷线索','无效线索')\r\n\t) a\r\n\tWHERE IFNULL(a.chart_type,'')<>''\r\n\tGROUP BY a.chart_type\r\n) t\r\nGROUP BY chart_type\r\nORDER BY (CASE WHEN '{weidu}'=5 THEN FIELD(chart_type,'文旅科技','体验馆','应急安全','运营类','文旅规划类','多媒体解决方案','数字内容','其他') ELSE CONVERT(chart_type USING GBK) END)"
      },
      "2": {
        "Ident": "StiMySqlSource",
        "Name": "c",
        "Alias": "c",
        "Columns": {
          "0": {
            "Name": "chart_type",
            "Index": -1,
            "NameInSource": "chart_type",
            "Alias": "chart_type",
            "Type": "System.String"
          },
          "1": {
            "Name": "chart_value",
            "Index": -1,
            "NameInSource": "chart_value",
            "Alias": "chart_value",
            "Type": "System.Int32"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\tchart_type,\r\n\tCOUNT(1) chart_value\r\nFROM (\r\nSELECT \r\n\tCASE\r\n\t\tWHEN '{weidu}'=1 THEN u.last_name\r\n\t\tWHEN '{weidu}'=2 THEN u.user_pianqu\r\n\t\tWHEN '{weidu}'=3 THEN u.user_daqu\r\n\t\tWHEN '{weidu}'=5 THEN b.cf_3935\r\n\t\tELSE '公司整体'\r\n\tEND AS chart_type\r\nFROM ld_customform53 a\r\nLEFT JOIN ld_customform53scf b ON b.customform53id=a.customform53id\r\nLEFT JOIN ld_users u ON u.id=a.smownerid\r\nINNER JOIN ld_users2group e ON e.userid=u.id\r\nINNER JOIN ld_groups f ON f.groupid=e.groupid\r\nINNER JOIN (\r\n\tSELECT DISTINCT\r\n\t\tuserid \r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\tld_users.id AS userid \r\n\t\tFROM ld_users\r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='CustomForm53' and scopeauthority=1 AND userid='[uuid]')\r\n\t\tUNION\r\n\t\tSELECT \r\n\t\t\tviewid AS userid \r\n\t\tFROM ld_scoperhigher\r\n\t\tWHERE userid='[uuid]' AND modulename ='CustomForm53' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename ='CustomForm53')\t\t\t\r\n\t\tUNION\r\n\t\tSELECT DISTINCT \r\n\t\t\tld_users2group.userid AS userid \r\n\t\tFROM ld_scoperhigher \r\n\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\tAND ld_scoperhigher.modulename ='CustomForm53'\r\n\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='CustomForm53' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\tUNION \r\n\t\tSELECT \r\n\t\t\tid AS userid \r\n\t\tFROM ld_users  \r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\tUNION\r\n\t\tSELECT '[uuid]') AS vw_users\r\n) AS tmp_users ON tmp_users.userid=a.smownerid\r\nWHERE a.deleted=0\r\n\tAND a.approvestatus='已批准'\r\n\tAND (f.groupid=2 OR f.parentgroup LIKE '1::2::%')\r\n\tAND u.profileid IN (64,65)\r\n\tAND b.cf_3955 IN ('热线索','温线索','冷线索','无效线索')\r\n\tAND a.createdtime BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d 00:00:00') AND DATE_FORMAT('{end_date}','%Y-%m-%d 23:59:59')\r\n) a\r\nWHERE IFNULL(chart_type,'')<>''\r\nGROUP BY chart_type"
      },
      "3": {
        "Ident": "StiMySqlSource",
        "Name": "d",
        "Alias": "d",
        "Columns": {
          "0": {
            "Name": "chart_type",
