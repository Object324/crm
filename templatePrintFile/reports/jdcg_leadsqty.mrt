          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT \r\n\tCASE\r\n\t\tWHEN '{weidu}'=1 THEN '客户经理/市场专员'\r\n\t\tWHEN '{weidu}'=2 THEN '片区'\r\n\t\tWHEN '{weidu}'=3 THEN '大区'\r\n\t\tWHEN '{weidu}'=4 THEN '公司整体'\r\n\t\tELSE '产品线'\r\n\tEND AS chart_type"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "b",
        "Alias": "b",
        "Columns": {
