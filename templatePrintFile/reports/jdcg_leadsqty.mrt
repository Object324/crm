          },
          "4": {
            "Name": "xiansuo_all_re",
            "Index": -1,
            "NameInSource": "xiansuo_all_re",
            "Alias": "xiansuo_all_re",
            "Type": "System.Decimal"
          },
          "5": {
            "Name": "xiansuo_all_wen",
            "Index": -1,
            "NameInSource": "xiansuo_all_wen",
            "Alias": "xiansuo_all_wen",
            "Type": "System.Decimal"
          },
          "6": {
            "Name": "xiansuo_all_wuxiao",
            "Index": -1,
            "NameInSource": "xiansuo_all_wuxiao",
            "Alias": "xiansuo_all_wuxiao",
