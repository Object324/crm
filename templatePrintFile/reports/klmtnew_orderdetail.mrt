          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\ta.orderid,\r\n\ta.orderno,\r\n\ta.signed_data,\r\n\ta.qianyuefang,\r\n\ta.ccfno,\r\n\ta.accountname,\r\n\ta.ordertype,\r\n\ta.order_startdate,\r\n\ta.order_enddate,\r\n\ta.total,\r\n\ta.smowner,\r\n\tb.groupname,\r\n\ta.smbiller,\r\n\ta.createdtime,\r\n\ta.quyu,\r\n\ta.term,\r\n\ta.description,\r\n\td.productname,\r\n\td.product_no,\r\n\td.productsheet,\r\n\tc.quantity,\r\n  c.comment,\r\n  c.tax_amount\r\nFROM (\r\n\tSELECT\r\n\t\ta.salesorderid AS orderid,\r\n\t\ta.signed_data,\r\n\t\tb.cf_2327 AS qianyuefang,\r\n\t\ta.salesorder_no AS orderno,\r\n\t\tc.potentialname AS ccfno,\r\n\t\td.accountname,\r\n\t\tb.cf_2323 AS ordertype,\r\n\t\ta.order_startdate,\r\n\t\ta.order_enddate,\r\n\t\tROUND(a.total/IFNULL(a.conversion_rate,1),2) AS total,\r\n\t\tu1.last_name AS smowner,\r\n\t\ta.smownerid,\r\n\t\tu2.last_name AS smbiller,\r\n\t\ta.createdtime,\r\n\t\tb.cf_2395 AS quyu,\r\n\t\tb.cf_2321 AS term,\r\n\t\ta.description\r\n\tFROM ld_salesorder a\r\n\tLEFT JOIN ld_salesordercf b ON b.salesorderid=a.salesorderid\r\n\tLEFT JOIN ld_potential c ON c.potentialid=a.potentialid\r\n\tLEFT JOIN ld_account d ON d.accountid=a.accountid\r\n\tLEFT JOIN ld_users u1 ON u1.id=a.smownerid\r\n\tLEFT JOIN ld_users u2 ON u2.id=a.smcreatorid\r\n\tINNER JOIN (\r\n\t\tSELECT DISTINCT\r\n\t\t\tuserid \r\n\t\tFROM (\r\n\t\t\tSELECT \r\n\t\t\t\tld_users.id AS userid \r\n\t\t\tFROM ld_users\r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='SalesOrder' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\tUNION\r\n\t\t\tSELECT \r\n\t\t\t\tviewid AS userid \r\n\t\t\tFROM ld_scoperhigher\r\n\t\t\tWHERE userid='[uuid]' AND modulename='SalesOrder' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename='SalesOrder')\t\t\t\r\n\t\t\tUNION\r\n\t\t\tSELECT DISTINCT \r\n\t\t\t\tld_users2group.userid AS userid \r\n\t\t\tFROM ld_scoperhigher \r\n\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\tAND ld_scoperhigher.modulename='SalesOrder'\r\n\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='SalesOrder' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\tUNION \r\n\t\t\tSELECT \r\n\t\t\t\tid AS userid \r\n\t\t\tFROM ld_users  \r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\tUNION\r\n\t\t\tSELECT '[uuid]') AS vw_users\r\n\t) AS list_user ON list_user.userid=u1.id\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND IFNULL(b.cf_2380,'')<>'作废单据'\r\n\t\tAND a.signed_data\r\n\r\n\r\nBETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\r\n\r\n\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{ccfnum}'='' THEN 1=1\r\n\t\t\t\tELSE LOCATE(TRIM('{ccfnum}'),c.potentialname)>0\r\n\t\t\tEND)\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{custname}'='' THEN 1=1\r\n\t\t\t\tELSE LOCATE(TRIM('{custname}'),d.accountname)>0\r\n\t\t\tEND)\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{ordertype}' IN ('全部','销售合同') THEN 1=1\r\n\t\t\t\tELSE 1=0\r\n\t\t\tEND)\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{userid}'='' THEN 1=1\r\n\t\t\t\tELSE FIND_IN_SET(a.smownerid,'{userid}')\r\n\t\t\tEND)\r\n\tUNION ALL\r\n\tSELECT\r\n\t\ta.servicecontractsid AS orderid,\r\n\t\ta.due_date,\r\n\t\ts.cf_2327 AS qianyuefang,\r\n\t\ta.contract_no AS orderno,\r\n\t\tc.potentialname AS ccfno,\r\n\t\td.accountname,\r\n\t\tb.cf_2326 AS ordertype,\r\n\t\ta.maintenance_startdate AS order_startdate,\r\n\t\ta.maintenance_enddate AS order_enddate,\r\n\t\tROUND(a.total/IFNULL(a.conversion_rate,1),2) AS total,\r\n\t\tu1.last_name AS smowner,\r\n\t\ta.smownerid,\r\n\t\tu2.last_name AS smbiller,\r\n\t\ta.createdtime,\r\n\t\ts.cf_2395 AS quyu,\r\n\t\t'' AS term,\r\n\t\ta.description\r\n\tFROM ld_servicecontracts a\r\n\tLEFT JOIN ld_servicecontractscf b ON b.servicecontractsid=a.servicecontractsid\r\n\tLEFT JOIN ld_potential c ON c.potentialid=a.potentialid\r\n\tLEFT JOIN ld_account d ON d.accountid=a.accountid\r\n\tLEFT JOIN ld_users u1 ON u1.id=a.smownerid\r\n\tLEFT JOIN ld_users u2 ON u2.id=a.smcreatorid\r\n\tLEFT JOIN ld_salesordercf s ON s.salesorderid=a.salesorderid\r\n\tINNER JOIN (\r\n\t\tSELECT DISTINCT\r\n\t\t\tuserid \r\n\t\tFROM (\r\n\t\t\tSELECT \r\n\t\t\t\tld_users.id AS userid \r\n\t\t\tFROM ld_users\r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='SalesOrder' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\tUNION\r\n\t\t\tSELECT \r\n\t\t\t\tviewid AS userid \r\n\t\t\tFROM ld_scoperhigher\r\n\t\t\tWHERE userid='[uuid]' AND modulename='SalesOrder' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename='SalesOrder')\t\t\t\r\n\t\t\tUNION\r\n\t\t\tSELECT DISTINCT \r\n\t\t\t\tld_users2group.userid AS userid \r\n\t\t\tFROM ld_scoperhigher \r\n\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\tAND ld_scoperhigher.modulename='SalesOrder'\r\n\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='SalesOrder' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\tUNION \r\n\t\t\tSELECT \r\n\t\t\t\tid AS userid \r\n\t\t\tFROM ld_users  \r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\tUNION\r\n\t\t\tSELECT '[uuid]') AS vw_users\r\n\t) AS list_user ON list_user.userid=a.smownerid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND IFNULL(b.cf_2381,'')<>'作废单据'\r\n\t\tAND a.due_date  BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{ccfnum}'='' THEN 1=1\r\n\t\t\t\tELSE LOCATE(TRIM('{ccfnum}'),c.potentialname)>0\r\n\t\t\tEND)\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{custname}'='' THEN 1=1\r\n\t\t\t\tELSE LOCATE(TRIM('{custname}'),d.accountname)>0\r\n\t\t\tEND)\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{ordertype}' IN ('全部','服务合同') THEN 1=1\r\n\t\t\t\tELSE 0=1\r\n\t\t\tEND)\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{maintenancetype}' IN ('','全部') THEN 1=1\r\n\t\t\t\tELSE LOCATE(TRIM('{maintenancetype}'),a.maintenance_type)>0\r\n\t\t\tEND)\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{userid}'='' THEN 1=1\r\n\t\t\t\tELSE FIND_IN_SET(a.smownerid,'{userid}')\r\n\t\t\tEND)\r\n) a\r\nLEFT JOIN (\r\n\tSELECT \r\n\t\ta.userid,\r\n\t\tGROUP_CONCAT(b.groupname SEPARATOR '/') AS groupname\r\n\tFROM ld_users2group a \r\n\tLEFT JOIN ld_groups b ON a.groupid=b.groupid \r\n\tGROUP BY a.userid\r\n) b ON a.smownerid=b.userid\r\nLEFT JOIN ld_servicecontractsdetail c ON c.id=a.orderid\r\nLEFT JOIN ld_products d ON d.productid=c.productid\r\nORDER BY a.createdtime,a.orderid,c.sequence_no"
      }
    },
