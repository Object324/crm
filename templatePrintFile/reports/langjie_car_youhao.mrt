          },
          "14": {
            "Name": "14_avgyouhao",
            "Index": -1,
            "NameInSource": "14_avgyouhao",
            "Alias": "14_avgyouhao",
            "Type": "System.Decimal"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\t00_date,\r\n\t01_chepai,\r\n\t02_cheling,\r\n\t03_jiayoudate,\r\n\t04_jiayouri,\r\n\t05_jiayouqi,\r\n\t06_lichengbiao,\r\n\t07_jiayouqty,\r\n\t08_jiayouamount,\r\n\t09_youjia,\r\n\t10_cur_runkm,\r\n\t11_total_qty,\r\n\t12_total_amount,\r\n\t13_curyouhao,\r\n\t14_avgyouhao\r\nFROM (\r\n\tSELECT\r\n\t\ta.projectid,\r\n\t\ta.projectprogressid,\r\n\t\ta.cur_runkm,\r\n\t\ta.startdate AS 00_date,\r\n\t\tc.projectname AS 01_chepai,\r\n\t\tTIMESTAMPDIFF(MONTH,IFNULL(f.startdate,STR_TO_DATE(CONCAT(d.cf_2954,'.1'),'%Y.%c.%e')),a.startdate) AS 02_cheling,\r\n\t\tDATE_FORMAT(a.startdate,'%Y%m%d') AS 03_jiayoudate,\r\n\t\tDATE_FORMAT(a.startdate,'%Y%m') AS 04_jiayouri,\r\n\t\tDATE_FORMAT(a.startdate,'%e') AS 05_jiayouqi,\r\n\t\ta.timecost AS 06_lichengbiao,\r\n\t\ta.jy_qty AS 07_jiayouqty,\r\n\t\ta.jy_amount AS 08_jiayouamount,\r\n\t\ta.jy_price AS 09_youjia,\r\n\t\tCASE\r\n\t\t\tWHEN a.cur_runkm=-1 THEN \r\n\t\t\t\tROUND(a.jy_qty/(SELECT jy_qty/cur_runkm FROM ld_projectprogress WHERE projectid=a.projectid AND deleted=0 \r\n\t\t\t\t\tAND approvestatus<>'已拒绝' AND cur_runkm<>-1 ORDER BY startdate,projectprogressid LIMIT 1),2)\r\n\t\t\tELSE a.cur_runkm\r\n\t\tEND AS 10_cur_runkm,\r\n\t\ta.total_qty AS 11_total_qty,\r\n\t\ta.total_amount AS 12_total_amount,\r\n\t\tCASE\r\n\t\t\tWHEN a.cur_runkm=-1 THEN \r\n\t\t\t\tROUND(a.jy_qty/ROUND(a.jy_qty/(SELECT jy_qty/cur_runkm FROM ld_projectprogress WHERE projectid=a.projectid AND deleted=0 \r\n\t\t\t\t\tAND approvestatus<>'已拒绝' AND cur_runkm<>-1 ORDER BY startdate,projectprogressid LIMIT 1),2),2)\r\n\t\t\tELSE ROUND(a.jy_qty/a.cur_runkm,2)\r\n\t\tEND AS 13_curyouhao,\r\n\t\tCASE\r\n\t\t\tWHEN cur_runkm=-1 THEN\r\n\t\t\t\tROUND((SELECT total_qty FROM ld_projectprogress WHERE projectid=a.projectid AND deleted=0 AND approvestatus<>'已拒绝' AND cur_runkm<>-1 ORDER BY startdate,projectprogressid LIMIT 1)/(\r\n\t\t\t\t\t(SELECT timecost FROM ld_projectprogress WHERE projectid=a.projectid AND deleted=0 AND approvestatus<>'已拒绝' AND cur_runkm<>-1 ORDER BY startdate,projectprogressid LIMIT 1)\r\n\t\t\t\t\t\t-(SELECT timecost FROM ld_projectprogress WHERE projectid=a.projectid AND deleted=0 AND approvestatus<>'已拒绝' AND cur_runkm=-1 LIMIT 1)),2)\r\n\t\t\tELSE \r\n\t\t\t\tROUND(a.total_qty/(a.timecost - IFNULL((SELECT timecost FROM ld_projectprogress WHERE projectid=a.projectid AND deleted=0 AND approvestatus<>'已拒绝' AND cur_runkm=-1 LIMIT 1),0)),2)\r\n\t\tEND AS 14_avgyouhao\r\n\tFROM ld_projectprogress a\r\n\tLEFT JOIN ld_projectprogresscf b ON b.projectprogressid=a.projectprogressid\r\n\tLEFT JOIN ld_project c ON c.projectid=a.projectid AND c.deleted=0\r\n\tLEFT JOIN ld_projectcf d ON d.projectid=c.projectid\r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\tprojectid,\r\n\t\t\tDATE_SUB(MIN(startdate),INTERVAL DAY(MIN(startdate))-1 DAY) AS startdate\r\n\t\tFROM ld_projectprogress a\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\tAND a.projectid>0\r\n\t\tGROUP BY projectid\r\n\t) f ON f.projectid=a.projectid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN TRIM('{chepai}')='' THEN 1=1\r\n\t\t\t\tELSE LOCATE(TRIM('{chepai}'),c.projectname)>0\r\n\t\t\tEND) \r\n) t\r\nWHERE 00_date BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\nORDER BY projectid,00_date,projectprogressid"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "b",
