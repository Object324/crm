            "Type": "System.Decimal"
          },
          "12": {
            "Name": "EB231_curavg",
            "Index": -1,
            "NameInSource": "EB231_curavg",
            "Alias": "EB231_curavg",
            "Type": "System.Decimal"
          },
          "13": {
            "Name": "L63G9_allavg",
            "Index": -1,
            "NameInSource": "L63G9_allavg",
            "Alias": "L63G9_allavg",
            "Type": "System.Decimal"
          },
          "14": {
            "Name": "L63G9_curavg",
            "Index": -1,
            "NameInSource": "L63G9_curavg",
            "Alias": "L63G9_curavg",
            "Type": "System.Decimal"
          },
          "15": {
            "Name": "Y0890_allavg",
            "Index": -1,
            "NameInSource": "Y0890_allavg",
            "Alias": "Y0890_allavg",
            "Type": "System.Decimal"
          },
          "16": {
            "Name": "Y0890_curavg",
            "Index": -1,
            "NameInSource": "Y0890_curavg",
            "Alias": "Y0890_curavg",
            "Type": "System.Decimal"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\t02_cheling,\r\n\tSUM(CASE WHEN 01_chepai='4Q9D5' AND (TRIM('{chepai}')='' OR LOCATE(TRIM('{chepai}'),01_chepai)>0) THEN avg_allyouhao ELSE 0 END) AS 4Q9D5_allavg,\r\n\tSUM(CASE WHEN 01_chepai='4Q9D5' AND (TRIM('{chepai}')='' OR LOCATE(TRIM('{chepai}'),01_chepai)>0) THEN avg_curyouhao ELSE 0 END) AS 4Q9D5_curavg,\r\n\tSUM(CASE WHEN 01_chepai='8V3M0' AND (TRIM('{chepai}')='' OR LOCATE(TRIM('{chepai}'),01_chepai)>0) THEN avg_allyouhao ELSE 0 END) AS 8V3M0_allavg,\r\n\tSUM(CASE WHEN 01_chepai='8V3M0' AND (TRIM('{chepai}')='' OR LOCATE(TRIM('{chepai}'),01_chepai)>0) THEN avg_curyouhao ELSE 0 END) AS 8V3M0_curavg,\r\n\tSUM(CASE WHEN 01_chepai='AV972' AND (TRIM('{chepai}')='' OR LOCATE(TRIM('{chepai}'),01_chepai)>0) THEN avg_allyouhao ELSE 0 END) AS AV972_allavg,\r\n\tSUM(CASE WHEN 01_chepai='AV972' AND (TRIM('{chepai}')='' OR LOCATE(TRIM('{chepai}'),01_chepai)>0) THEN avg_curyouhao ELSE 0 END) AS AV972_curavg,\r\n\tSUM(CASE WHEN 01_chepai='DV699' AND (TRIM('{chepai}')='' OR LOCATE(TRIM('{chepai}'),01_chepai)>0) THEN avg_allyouhao ELSE 0 END) AS DV699_allavg,\r\n\tSUM(CASE WHEN 01_chepai='DV699' AND (TRIM('{chepai}')='' OR LOCATE(TRIM('{chepai}'),01_chepai)>0) THEN avg_curyouhao ELSE 0 END) AS DV699_curavg,\r\n\tSUM(CASE WHEN 01_chepai='EB231' AND (TRIM('{chepai}')='' OR LOCATE(TRIM('{chepai}'),01_chepai)>0) THEN avg_allyouhao ELSE 0 END) AS EB231_allavg,\r\n\tSUM(CASE WHEN 01_chepai='EB231' AND (TRIM('{chepai}')='' OR LOCATE(TRIM('{chepai}'),01_chepai)>0) THEN avg_curyouhao ELSE 0 END) AS EB231_curavg,\r\n\tSUM(CASE WHEN 01_chepai='L63G9' AND (TRIM('{chepai}')='' OR LOCATE(TRIM('{chepai}'),01_chepai)>0) THEN avg_allyouhao ELSE 0 END) AS L63G9_allavg,\r\n\tSUM(CASE WHEN 01_chepai='L63G9' AND (TRIM('{chepai}')='' OR LOCATE(TRIM('{chepai}'),01_chepai)>0) THEN avg_curyouhao ELSE 0 END) AS L63G9_curavg,\r\n\tSUM(CASE WHEN 01_chepai='Y0890' AND (TRIM('{chepai}')='' OR LOCATE(TRIM('{chepai}'),01_chepai)>0) THEN avg_allyouhao ELSE 0 END) AS Y0890_allavg,\r\n\tSUM(CASE WHEN 01_chepai='Y0890' AND (TRIM('{chepai}')='' OR LOCATE(TRIM('{chepai}'),01_chepai)>0) THEN avg_curyouhao ELSE 0 END) AS Y0890_curavg,\r\n\tSUM(CASE WHEN 01_chepai='3S6S0' AND (TRIM('{chepai}')='' OR LOCATE(TRIM('{chepai}'),01_chepai)>0) THEN avg_allyouhao ELSE 0 END) AS 3S6S0_allavg,\r\n\tSUM(CASE WHEN 01_chepai='3S6S0' AND (TRIM('{chepai}')='' OR LOCATE(TRIM('{chepai}'),01_chepai)>0) THEN avg_curyouhao ELSE 0 END) AS 3S6S0_curavg\r\nFROM (\r\n\tSELECT\r\n\t\t01_chepai,\r\n\t\t02_cheling,\r\n\t\tROUND(AVG(13_curyouhao),2) AS avg_curyouhao,\r\n\t\tROUND(AVG(14_avgyouhao),2) AS avg_allyouhao\r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\ta.projectid,\r\n\t\t\tc.projectname AS 01_chepai,\r\n\t\t\tTIMESTAMPDIFF(MONTH,IFNULL(f.startdate,STR_TO_DATE(CONCAT(d.cf_2954,'.1'),'%Y.%c.%e')),a.startdate) AS 02_cheling,\r\n\t\t\tCASE\r\n\t\t\t\tWHEN a.cur_runkm=-1 THEN \r\n\t\t\t\t\tROUND(a.jy_qty/ROUND(a.jy_qty/(SELECT jy_qty/cur_runkm FROM ld_projectprogress WHERE projectid=a.projectid AND deleted=0 \r\n\t\t\t\t\t\tAND approvestatus<>'已拒绝' AND cur_runkm<>-1 ORDER BY startdate,projectprogressid LIMIT 1),2),2)\r\n\t\t\t\tELSE ROUND(a.jy_qty/a.cur_runkm,2)\r\n\t\t\tEND AS 13_curyouhao,\r\n\t\t\tCASE\r\n\t\t\t\tWHEN cur_runkm=-1 THEN\r\n\t\t\t\t\tROUND((SELECT total_qty FROM ld_projectprogress WHERE projectid=a.projectid AND deleted=0 AND approvestatus<>'已拒绝' AND cur_runkm<>-1 ORDER BY startdate,projectprogressid LIMIT 1)/(\r\n\t\t\t\t\t\t(SELECT timecost FROM ld_projectprogress WHERE projectid=a.projectid AND deleted=0 AND approvestatus<>'已拒绝' AND cur_runkm<>-1 ORDER BY startdate,projectprogressid LIMIT 1)\r\n\t\t\t\t\t\t\t-(SELECT timecost FROM ld_projectprogress WHERE projectid=a.projectid AND deleted=0 AND approvestatus<>'已拒绝' AND cur_runkm=-1 LIMIT 1)),2)\r\n\t\t\t\tELSE \r\n\t\t\t\t\tROUND(a.total_qty/(a.timecost - IFNULL((SELECT timecost FROM ld_projectprogress WHERE projectid=a.projectid AND deleted=0 AND approvestatus<>'已拒绝' AND cur_runkm=-1 LIMIT 1),0)),2)\r\n\t\t\tEND AS 14_avgyouhao\r\n\t\tFROM ld_projectprogress a\r\n\t\tLEFT JOIN ld_projectprogresscf b ON b.projectprogressid=a.projectprogressid\r\n\t\tLEFT JOIN ld_project c ON c.projectid=a.projectid AND c.deleted=0\r\n\t\tLEFT JOIN ld_projectcf d ON d.projectid=c.projectid\r\n\t\tLEFT JOIN (\r\n\t\t\tSELECT\r\n\t\t\t\tprojectid,\r\n\t\t\t\tDATE_SUB(MIN(startdate),INTERVAL DAY(MIN(startdate))-1 DAY) AS startdate\r\n\t\t\tFROM ld_projectprogress a\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND a.projectid>0\r\n\t\t\tGROUP BY projectid\r\n\t\t) f ON f.projectid=a.projectid\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t) t\r\n\tGROUP BY projectid,02_cheling\r\n) tmp\r\nGROUP BY 02_cheling"
      }
    },
