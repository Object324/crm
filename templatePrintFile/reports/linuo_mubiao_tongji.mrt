            "Index": -1,
            "NameInSource": "listvalue",
            "Alias": "listvalue",
            "Type": "System.Int32"
          }
        },
        "NameInSource": "ldcrm ",
        "SqlCommand": "SELECT\r\n\tlistvalue\r\nFROM (\r\n\tSELECT YEAR(NOW()) AS listvalue\r\n\tUNION\r\n\tSELECT YEAR(NOW())-1 AS listvalue\r\n\tUNION\r\n\tSELECT YEAR(NOW())-2 AS listvalue\r\n\tUNION\r\n\tSELECT YEAR(NOW())-3 AS listvalue\r\n\tUNION\r\n\tSELECT YEAR(NOW())-4 AS listvalue\r\n) a\r\nWHERE listvalue>=2022\r\nORDER BY listvalue DESC"
      },
