        },
        "NameInSource": "ldcrm ",
        "SqlCommand": "SELECT\r\n\ta.cpx,\r\n\ta.last_name,\r\n\ta.groupname,\r\n\ta.mb_fhamount,\r\n\ta.mb_fhqty,\r\n\ta.mb_hkamount,\r\n\r\n\tROUND(b.fh_qty*0.0001,4) AS fh_qty,\r\n\tROUND(b.fh_amount*0.0001,4) AS fh_amount,\r\n\tROUND(b1.fh_qty*0.0001,4) AS fh_qty_y,\r\n\tROUND(b1.fh_amount*0.0001,4) AS fh_amount_y,\r\n\tROUND(c.sk_amount*0.0001,4) AS sk_amount,\r\n\tROUND(c1.sk_amount*0.0001,4) AS sk_amount_y,\r\n\tCASE\r\n\t\tWHEN IFNULL(a.mb_fhqty,0)=0 THEN NULL\r\n\t\tELSE ROUND(ROUND(IFNULL(b.fh_qty,0)*0.0001,4)/IFNULL(a.mb_fhqty,0),4)\r\n\tEND AS fh_qty_rate,\r\n\tCASE\r\n\t\tWHEN IFNULL(a.mb_fhamount,0)=0 THEN NULL\r\n\t\tELSE ROUND(ROUND(IFNULL(b.fh_amount,0)*0.0001,4)/IFNULL(a.mb_fhamount,0),4)\r\n\tEND AS fh_amount_rate,\r\n\tCASE\r\n\t\tWHEN IFNULL(a.mb_hkamount,0)=0 THEN NULL\r\n\t\tELSE ROUND(ROUND(IFNULL(c.sk_amount,0)*0.0001,4)/IFNULL(a.mb_hkamount,0),4)\r\n\tEND AS sk_amount_rate\r\nFROM (\r\n\tSELECT\r\n\t\ta.cpx,\r\n\t\ta.lin_users_id,\r\n\t\tu.last_name,\r\n\t\tg.groupname,\r\n\t\tSUM(a.mb_fhamount) AS mb_fhamount,\r\n\t\tSUM(a.mb_fhqty) AS mb_fhqty,\r\n\t\tSUM(a.mb_hkamount) AS mb_hkamount,\r\n\t\tb.sequence\r\n\tFROM vw_linuo_mubiao a\r\n\tLEFT JOIN ld_picklist_values b ON b.listid=129 AND b.listvalue=a.cpx\r\n\tLEFT JOIN ld_users u ON u.id=a.lin_users_id\r\n\tLEFT JOIN ld_groups g ON g.groupid=u.groupid\r\n\tWHERE 1=1\r\n\t\tAND a.syb='{shiyebu}'\r\n\t\tAND STR_TO_DATE(CONCAT(a.nian,'-',a.yue,'-01'),'%Y-%m-%d') BETWEEN STR_TO_DATE(CONCAT('{start_nian}','-','{start_yue}','-01'),'%Y-%m-%d') AND LAST_DAY(STR_TO_DATE(CONCAT('{end_nian}','-','{end_yue}','-01'),'%Y-%m-%d'))\r\n\tGROUP BY a.cpx,a.lin_users_id\r\n) a\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\tp.cf_4430 AS cpx,\r\n\t\ta.smownerid,\r\n\t\tSUM(c.quantity) AS fh_qty,\r\n\t\tSUM(d.sf2291) AS fh_amount\r\n\tFROM ld_outboundorder a\r\n\tLEFT JOIN ld_outboundorderdetail c ON c.id=a.out_id\r\n\tLEFT JOIN ld_outboundorderdetailscf d ON d.lineitem_id=c.lineitem_id\r\n\tLEFT JOIN ld_productcf p ON p.productid=c.productid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND a.outdate BETWEEN STR_TO_DATE(CONCAT('{start_nian}','-','{start_yue}','-01'),'%Y-%m-%d') AND LAST_DAY(STR_TO_DATE(CONCAT('{end_nian}','-','{end_yue}','-01'),'%Y-%m-%d')) \r\n\t\tAND IFNULL(p.cf_4430,'')<>''\r\n\tGROUP BY p.cf_4430,a.smownerid\r\n) b ON b.smownerid=a.lin_users_id AND b.cpx=a.cpx\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\tp.cf_4430 AS cpx,\r\n\t\ta.smownerid,\r\n\t\tSUM(c.quantity) AS fh_qty,\r\n\t\tSUM(d.sf2291) AS fh_amount\r\n\tFROM ld_outboundorder a\r\n\tLEFT JOIN ld_outboundorderdetail c ON c.id=a.out_id\r\n\tLEFT JOIN ld_outboundorderdetailscf d ON d.lineitem_id=c.lineitem_id\r\n\tLEFT JOIN ld_productcf p ON p.productid=c.productid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND a.outdate=DATE_SUB(CURDATE(),INTERVAL 1 DAY) \r\n\t\tAND IFNULL(p.cf_4430,'')<>''\r\n\tGROUP BY p.cf_4430,a.smownerid\r\n) b1 ON b1.smownerid=a.lin_users_id AND b1.cpx=a.cpx\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\ta.smownerid,\r\n\t\tb.cf_4563 AS cpx,\r\n\t\tSUM(a.cf_4414) AS sk_amount\r\n\tFROM ld_cashbill a\r\n\tLEFT JOIN ld_cashbillscf b ON b.cashbillid=a.cashbillid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND a.cashbilldate BETWEEN STR_TO_DATE(CONCAT('{start_nian}','-','{start_yue}','-01'),'%Y-%m-%d') AND LAST_DAY(STR_TO_DATE(CONCAT('{end_nian}','-','{end_yue}','-01'),'%Y-%m-%d')) \r\n\tGROUP BY a.smownerid,b.cf_4563\r\n) c ON c.smownerid=a.lin_users_id AND c.cpx=a.cpx\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\ta.smownerid,\r\n\t\tb.cf_4563 AS cpx,\r\n\t\tSUM(a.cf_4414) AS sk_amount\r\n\tFROM ld_cashbill a\r\n\tLEFT JOIN ld_cashbillscf b ON b.cashbillid=a.cashbillid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND a.cashbilldate=DATE_SUB(CURDATE(),INTERVAL 1 DAY) \r\n\tGROUP BY a.smownerid,b.cf_4563\r\n) c1 ON c1.smownerid=a.lin_users_id AND c1.cpx=a.cpx\r\nORDER BY a.sequence,CONVERT(a.last_name USING GBK)"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "list_syb",
        "Alias": "list_syb",
        "Key": "e1a8703c9ba343348f37c81f29094c42",
        "Columns": {
