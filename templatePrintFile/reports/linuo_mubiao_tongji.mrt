          "9": {
            "Name": "mb_fhamount",
            "Index": -1,
            "NameInSource": "mb_fhamount",
            "Alias": "mb_fhamount",
            "Type": "System.Decimal"
          },
          "10": {
            "Name": "mb_fhqty",
            "Index": -1,
            "NameInSource": "mb_fhqty",
            "Alias": "mb_fhqty",
            "Type": "System.Decimal"
          },
          "11": {
            "Name": "mb_hkamount",
            "Index": -1,
            "NameInSource": "mb_hkamount",
            "Alias": "mb_hkamount",
            "Type": "System.Decimal"
          },
          "12": {
            "Name": "sk_amount",
