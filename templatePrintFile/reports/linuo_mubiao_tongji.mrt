            "NameInSource": "sk_amount",
            "Alias": "sk_amount",
            "Type": "System.Decimal"
          },
          "13": {
            "Name": "sk_amount_rate",
            "Index": -1,
            "NameInSource": "sk_amount_rate",
            "Alias": "sk_amount_rate",
