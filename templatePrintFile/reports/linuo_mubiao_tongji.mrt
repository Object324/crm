        },
        "NameInSource": "ldcrm ",
        "SqlCommand": "SELECT\r\n\tlistid,\r\n\tlistvalue\r\nFROM ld_picklist_values\r\nWHERE listid=128\r\nORDER BY sequence"
      },
      "2": {
        "Ident": "StiMySqlSource",
        "Name": "list_nian",
