    "DataSources": {
      "0": {
        "Ident": "StiMySqlSource",
        "Name": "b",
        "Alias": "b",
        "Columns": {
          "0": {
            "Name": "amount_mb",
            "Index": -1,
            "NameInSource": "amount_mb",
            "Alias": "amount_mb",
