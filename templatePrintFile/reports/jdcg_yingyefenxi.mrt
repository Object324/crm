          },
          "1": {
            "Name": "amount_yuce",
            "Index": -1,
            "NameInSource": "amount_yuce",
            "Alias": "amount_yuce",
            "Type": "System.Decimal"
          },
          "2": {
            "Name": "mubiao_desp",
            "Index": -1,
            "NameInSource": "mubiao_desp",
            "Alias": "mubiao_desp",
            "Type": "System.String"
          },
          "3": {
            "Name": "mubiao_type",
            "Index": -1,
            "NameInSource": "mubiao_type",
            "Alias": "mubiao_type",
            "Type": "System.String"
          },
          "4": {
            "Name": "rate",
            "Index": -1,
            "NameInSource": "rate",
            "Alias": "rate",
            "Type": "System.Decimal"
          }
        },
        "NameInSource": "ldcrm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\tmubiao_desp,\r\n\tCASE\r\n\t\tWHEN '{weidu}'=2 THEN CONCAT(mubiao_type,'  (负责人：',IFNULL((SELECT last_name FROM ld_users WHERE deleted=0 AND userlevel='区域负责人' AND user_pianqu=t.mubiao_type LIMIT 1),''),')')\r\n\t\tELSE mubiao_type\r\n\tEND AS mubiao_type,\r\n\tamount_yuce,\r\n\tamount_mb,\r\n\trate\r\nFROM (\r\nSELECT\r\n\tCASE\r\n\t\tWHEN '{weidu}'=1 THEN '客户经理'\r\n\t\tWHEN '{weidu}'=2 THEN '片区'\r\n\t\tWHEN '{weidu}'=3 THEN '大区'\r\n\t\tELSE '公司整体'\r\n\tEND AS mubiao_desp,\r\n\tmubiao_type,\r\n\tSUM(amount_yuce) AS amount_yuce,\r\n\tSUM(amount_mb) AS amount_mb,\r\n\tCASE\r\n\t\tWHEN IFNULL(SUM(amount_mb),0)=0 THEN 1\r\n\t\tELSE SUM(amount_yuce)/SUM(amount_mb)\r\n\tEND AS rate\r\nFROM (\r\n\tSELECT\r\n\t\ta.id,\r\n\t\tCASE\r\n\t\t\tWHEN '{weidu}'=1 THEN a.last_name\r\n\t\t\tWHEN '{weidu}'=2 THEN a.user_pianqu\r\n\t\t\tWHEN '{weidu}'=3 THEN a.user_daqu\r\n\t\t\tELSE '公司整体'\r\n\t\tEND AS mubiao_type,\r\n\t\tb.amount_yuce,\r\n\t\tc.amount_mb\r\n\tFROM ld_users a\r\n\tINNER JOIN ld_users2group e ON e.userid=a.id\r\n\tINNER JOIN ld_groups f ON f.groupid=e.groupid\r\n\tINNER JOIN (\r\n\t\tSELECT DISTINCT\r\n\t\t\tuserid \r\n\t\tFROM (\r\n\t\t\tSELECT \r\n\t\t\t\tld_users.id AS userid \r\n\t\t\tFROM ld_users\r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Potentials' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\tUNION\r\n\t\t\tSELECT \r\n\t\t\t\tviewid AS userid \r\n\t\t\tFROM ld_scoperhigher\r\n\t\t\tWHERE userid='[uuid]' AND modulename ='Potentials' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename ='Potentials')\t\t\t\r\n\t\t\tUNION\r\n\t\t\tSELECT DISTINCT \r\n\t\t\t\tld_users2group.userid AS userid \r\n\t\t\tFROM ld_scoperhigher \r\n\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\tAND ld_scoperhigher.modulename ='Potentials'\r\n\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Potentials' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\tUNION \r\n\t\t\tSELECT \r\n\t\t\t\tid AS userid \r\n\t\t\tFROM ld_users  \r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\tUNION\r\n\t\t\tSELECT '[uuid]') AS vw_users\r\n\t) AS tmp_users ON tmp_users.userid=a.id\r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\ta.smownerid,\r\n\t\t\tSUM(CASE\r\n\t\t\t\tWHEN a.sales_stage='线索阶段' THEN a.amount*2.5*0.01\r\n\t\t\t\tWHEN a.sales_stage='商机阶段' THEN a.amount*25*0.01\r\n\t\t\t\tWHEN a.sales_stage='立项阶段' THEN a.amount*50*0.01\r\n\t\t\t\tWHEN a.sales_stage='商务谈判' THEN a.amount*80*0.01\r\n\t\t\t\tWHEN a.sales_stage='合同签订' THEN a.amount*100*0.01\r\n\t\t\t\tELSE 0\r\n\t\t\tEND) AS amount_yuce\r\n\t\tFROM ld_potential a\r\n\t\tLEFT JOIN ld_potentialscf b ON b.potentialid=a.potentialid\r\n\t\tLEFT JOIN ld_users u ON u.id=a.smownerid\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\tAND IFNULL(a.sales_stage,'')<>'项目关闭'\r\n\t\t\tAND YEAR(a.createdtime)='{nian}'\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{yue}'='' THEN 1=1\r\n\t\t\t\t\tELSE FIND_IN_SET(MONTH(a.createdtime),'{yue}')\r\n\t\t\t\tEND)\r\n\t\tGROUP BY a.smownerid\r\n\t) b ON b.smownerid=a.id\r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\tlin_users_id,\r\n\t\t\tSUM(amount_mb) AS amount_mb\r\n\t\tFROM (\r\n\t\t\tSELECT\r\n\t\t\t\tc.lin_users_id,\r\n\t\t\t\t1 AS mb_month,\r\n\t\t\t\td.sf284 AS amount_mb\r\n\t\t\tFROM ld_customform22 a\r\n\t\t\tLEFT JOIN ld_customform22scf b ON b.customform22id=a.customform22id\r\n\t\t\tLEFT JOIN ld_customform22detail c ON c.id=a.customform22id\r\n\t\t\tLEFT JOIN ld_customform22detailscf d ON d.lineitem_id=c.lineitem_id\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND b.cf_5277='合同额'\r\n\t\t\t\tAND c.lin_users_id>0\r\n\t\t\t\tAND b.cf_5276='{nian}'\r\n\t\t\tUNION\r\n\t\t\tSELECT\r\n\t\t\t\tc.lin_users_id,\r\n\t\t\t\t2 AS mb_month,\r\n\t\t\t\td.sf285 AS amount_mb\r\n\t\t\tFROM ld_customform22 a\r\n\t\t\tLEFT JOIN ld_customform22scf b ON b.customform22id=a.customform22id\r\n\t\t\tLEFT JOIN ld_customform22detail c ON c.id=a.customform22id\r\n\t\t\tLEFT JOIN ld_customform22detailscf d ON d.lineitem_id=c.lineitem_id\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND b.cf_5277='合同额'\r\n\t\t\t\tAND c.lin_users_id>0\r\n\t\t\t\tAND b.cf_5276='{nian}'\r\n\t\t\tUNION\r\n\t\t\tSELECT\r\n\t\t\t\tc.lin_users_id,\r\n\t\t\t\t3 AS mb_month,\r\n\t\t\t\td.sf286 AS amount_mb\r\n\t\t\tFROM ld_customform22 a\r\n\t\t\tLEFT JOIN ld_customform22scf b ON b.customform22id=a.customform22id\r\n\t\t\tLEFT JOIN ld_customform22detail c ON c.id=a.customform22id\r\n\t\t\tLEFT JOIN ld_customform22detailscf d ON d.lineitem_id=c.lineitem_id\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND b.cf_5277='合同额'\r\n\t\t\t\tAND c.lin_users_id>0\r\n\t\t\t\tAND b.cf_5276='{nian}'\r\n\t\t\tUNION\r\n\t\t\tSELECT\r\n\t\t\t\tc.lin_users_id,\r\n\t\t\t\t4 AS mb_month,\r\n\t\t\t\td.sf287 AS amount_mb\r\n\t\t\tFROM ld_customform22 a\r\n\t\t\tLEFT JOIN ld_customform22scf b ON b.customform22id=a.customform22id\r\n\t\t\tLEFT JOIN ld_customform22detail c ON c.id=a.customform22id\r\n\t\t\tLEFT JOIN ld_customform22detailscf d ON d.lineitem_id=c.lineitem_id\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND b.cf_5277='合同额'\r\n\t\t\t\tAND c.lin_users_id>0\r\n\t\t\t\tAND b.cf_5276='{nian}'\r\n\t\t\tUNION\r\n\t\t\tSELECT\r\n\t\t\t\tc.lin_users_id,\r\n\t\t\t\t5 AS mb_month,\r\n\t\t\t\td.sf288 AS amount_mb\r\n\t\t\tFROM ld_customform22 a\r\n\t\t\tLEFT JOIN ld_customform22scf b ON b.customform22id=a.customform22id\r\n\t\t\tLEFT JOIN ld_customform22detail c ON c.id=a.customform22id\r\n\t\t\tLEFT JOIN ld_customform22detailscf d ON d.lineitem_id=c.lineitem_id\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND b.cf_5277='合同额'\r\n\t\t\t\tAND c.lin_users_id>0\r\n\t\t\t\tAND b.cf_5276='{nian}'\r\n\t\t\tUNION\r\n\t\t\tSELECT\r\n\t\t\t\tc.lin_users_id,\r\n\t\t\t\t6 AS mb_month,\r\n\t\t\t\td.sf289 AS amount_mb\r\n\t\t\tFROM ld_customform22 a\r\n\t\t\tLEFT JOIN ld_customform22scf b ON b.customform22id=a.customform22id\r\n\t\t\tLEFT JOIN ld_customform22detail c ON c.id=a.customform22id\r\n\t\t\tLEFT JOIN ld_customform22detailscf d ON d.lineitem_id=c.lineitem_id\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND b.cf_5277='合同额'\r\n\t\t\t\tAND c.lin_users_id>0\r\n\t\t\t\tAND b.cf_5276='{nian}'\r\n\t\t\tUNION\r\n\t\t\tSELECT\r\n\t\t\t\tc.lin_users_id,\r\n\t\t\t\t7 AS mb_month,\r\n\t\t\t\td.sf290 AS amount_mb\r\n\t\t\tFROM ld_customform22 a\r\n\t\t\tLEFT JOIN ld_customform22scf b ON b.customform22id=a.customform22id\r\n\t\t\tLEFT JOIN ld_customform22detail c ON c.id=a.customform22id\r\n\t\t\tLEFT JOIN ld_customform22detailscf d ON d.lineitem_id=c.lineitem_id\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND b.cf_5277='合同额'\r\n\t\t\t\tAND c.lin_users_id>0\r\n\t\t\t\tAND b.cf_5276='{nian}'\r\n\t\t\tUNION\r\n\t\t\tSELECT\r\n\t\t\t\tc.lin_users_id,\r\n\t\t\t\t8 AS mb_month,\r\n\t\t\t\td.sf291 AS amount_mb\r\n\t\t\tFROM ld_customform22 a\r\n\t\t\tLEFT JOIN ld_customform22scf b ON b.customform22id=a.customform22id\r\n\t\t\tLEFT JOIN ld_customform22detail c ON c.id=a.customform22id\r\n\t\t\tLEFT JOIN ld_customform22detailscf d ON d.lineitem_id=c.lineitem_id\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND b.cf_5277='合同额'\r\n\t\t\t\tAND c.lin_users_id>0\r\n\t\t\t\tAND b.cf_5276='{nian}'\r\n\t\t\tUNION\r\n\t\t\tSELECT\r\n\t\t\t\tc.lin_users_id,\r\n\t\t\t\t9 AS mb_month,\r\n\t\t\t\td.sf292 AS amount_mb\r\n\t\t\tFROM ld_customform22 a\r\n\t\t\tLEFT JOIN ld_customform22scf b ON b.customform22id=a.customform22id\r\n\t\t\tLEFT JOIN ld_customform22detail c ON c.id=a.customform22id\r\n\t\t\tLEFT JOIN ld_customform22detailscf d ON d.lineitem_id=c.lineitem_id\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND b.cf_5277='合同额'\r\n\t\t\t\tAND c.lin_users_id>0\r\n\t\t\t\tAND b.cf_5276='{nian}'\r\n\t\t\tUNION\r\n\t\t\tSELECT\r\n\t\t\t\tc.lin_users_id,\r\n\t\t\t\t10 AS mb_month,\r\n\t\t\t\td.sf293 AS amount_mb\r\n\t\t\tFROM ld_customform22 a\r\n\t\t\tLEFT JOIN ld_customform22scf b ON b.customform22id=a.customform22id\r\n\t\t\tLEFT JOIN ld_customform22detail c ON c.id=a.customform22id\r\n\t\t\tLEFT JOIN ld_customform22detailscf d ON d.lineitem_id=c.lineitem_id\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND b.cf_5277='合同额'\r\n\t\t\t\tAND c.lin_users_id>0\r\n\t\t\t\tAND b.cf_5276='{nian}'\r\n\t\t\tUNION\r\n\t\t\tSELECT\r\n\t\t\t\tc.lin_users_id,\r\n\t\t\t\t11 AS mb_month,\r\n\t\t\t\td.sf294 AS amount_mb\r\n\t\t\tFROM ld_customform22 a\r\n\t\t\tLEFT JOIN ld_customform22scf b ON b.customform22id=a.customform22id\r\n\t\t\tLEFT JOIN ld_customform22detail c ON c.id=a.customform22id\r\n\t\t\tLEFT JOIN ld_customform22detailscf d ON d.lineitem_id=c.lineitem_id\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND b.cf_5277='合同额'\r\n\t\t\t\tAND c.lin_users_id>0\r\n\t\t\t\tAND b.cf_5276='{nian}'\r\n\t\t\tUNION\r\n\t\t\tSELECT\r\n\t\t\t\tc.lin_users_id,\r\n\t\t\t\t12 AS mb_month,\r\n\t\t\t\td.sf295 AS amount_mb\r\n\t\t\tFROM ld_customform22 a\r\n\t\t\tLEFT JOIN ld_customform22scf b ON b.customform22id=a.customform22id\r\n\t\t\tLEFT JOIN ld_customform22detail c ON c.id=a.customform22id\r\n\t\t\tLEFT JOIN ld_customform22detailscf d ON d.lineitem_id=c.lineitem_id\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND b.cf_5277='合同额'\r\n\t\t\t\tAND c.lin_users_id>0\r\n\t\t\t\tAND b.cf_5276='{nian}'\r\n\t\t) a\r\n\t\tWHERE 1=1\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{yue}'='' THEN 1=1\r\n\t\t\t\t\tELSE FIND_IN_SET(mb_month,'{yue}')\r\n\t\t\t\tEND)\r\n\t\tGROUP BY lin_users_id\r\n\t) c ON c.lin_users_id=a.id\r\n\tWHERE a.deleted=0\r\n\t\tAND (f.groupid=2 OR f.parentgroup LIKE '1::2::%')\r\n\t\tAND a.profileid IN (64,65)\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{weidu}'=1 AND TRIM('{ziweidu}')='' THEN 1=1\r\n\t\t\t\tWHEN '{weidu}'=1 AND TRIM('{ziweidu}')<>'' THEN FIND_IN_SET(a.id,'{ziweidu}')\r\n\t\t\t\t\r\n\t\t\t\tWHEN '{weidu}'=2 AND TRIM('{ziweidu}')='' THEN a.user_pianqu IN ('山东区','北京区','河南区','西南区','青岛金东','应急安全产品线')\r\n\t\t\t\tWHEN '{weidu}'=2 THEN FIND_IN_SET(a.user_pianqu,'{ziweidu}')\r\n\r\n\t\t\t\tWHEN '{weidu}'=3 AND TRIM('{ziweidu}')='' THEN a.user_daqu IN ('东部大区','南部大区','西部大区','北部大区','青岛金东','应急安全产品线')\r\n\t\t\t\tWHEN '{weidu}'=3 THEN FIND_IN_SET(a.user_daqu,'{ziweidu}')\r\n\t\t\t\tELSE 1=1\r\n\t\t\tEND) \r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{chanpinxian}'='' OR '{chanpinxian}'=(SELECT GROUP_CONCAT(listvalue ORDER BY sequence) FROM ld_picklist_values WHERE listid=130) THEN 1=1\r\n\t\t\t\tELSE FIND_IN_SET(a.user_chanpinxian,'{chanpinxian}')\r\n\t\t\tEND) \r\n) t\r\nWHERE IFNULL(mubiao_type,'')<>''\r\nGROUP BY mubiao_type\r\n) t\r\nWHERE 1=1\r\nORDER BY rate DESC"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "list_weidu",
        "Alias": "list_weidu",
        "Columns": {
          "0": {
            "Name": "list_key",
            "Index": -1,
            "NameInSource": "list_key",
            "Alias": "list_key",
            "Type": "System.Int32"
          },
          "1": {
            "Name": "list_key2",
            "Index": -1,
            "NameInSource": "list_key2",
            "Alias": "list_key2",
            "Type": "System.String"
          },
          "2": {
            "Name": "list_value",
            "Index": -1,
            "NameInSource": "list_value",
            "Alias": "list_value",
            "Type": "System.String"
          },
          "3": {
            "Name": "list_value2",
            "Index": -1,
            "NameInSource": "list_value2",
            "Alias": "list_value2",
            "Type": "System.String"
          }
        },
        "NameInSource": "ldcrm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\tlist_key,\r\n\tlist_key2,\r\n\tlist_value,\r\n\tlist_value2\r\nFROM (\r\n\tSELECT\r\n\t\t1 AS list_key,\r\n\t\t'客户经理/市场专员' AS list_value,\r\n\t\ta.id AS list_key2,\r\n\t\ta.last_name AS list_value2\r\n\tFROM ld_users a\r\n\tINNER JOIN ld_users2group e ON e.userid=a.id\r\n\tINNER JOIN ld_groups f ON f.groupid=e.groupid\r\n\tWHERE a.deleted=0\r\n\t\tAND (f.groupid=2 OR f.parentgroup LIKE '1::2::%')\r\n\t\tAND a.profileid IN (64,65)\r\n\tUNION\r\n\tSELECT\r\n\t\t2 AS list_key,\r\n\t\t'片区' AS list_value,\r\n\t\ta.user_pianqu AS list_key2,\r\n\t\ta.user_pianqu AS list_value2\r\n\tFROM ld_users a\r\n\tINNER JOIN ld_users2group e ON e.userid=a.id\r\n\tINNER JOIN ld_groups f ON f.groupid=e.groupid\r\n\tWHERE a.deleted=0\r\n\t\tAND (f.groupid=2 OR f.parentgroup LIKE '1::2::%')\r\n\t\tAND a.profileid IN (64,65)\r\n\t\tAND a.user_pianqu IN ('山东区','北京区','河南区','西南区','青岛金东','应急安全产品线')\r\n\tGROUP BY a.user_pianqu\r\n\tUNION\r\n\tSELECT\r\n\t\t3 AS list_key,\r\n\t\t'大区' AS list_value,\r\n\t\ta.user_daqu AS list_key2,\r\n\t\ta.user_daqu AS list_value2\r\n\tFROM ld_users a\r\n\tINNER JOIN ld_users2group e ON e.userid=a.id\r\n\tINNER JOIN ld_groups f ON f.groupid=e.groupid\r\n\tWHERE a.deleted=0\r\n\t\tAND (f.groupid=2 OR f.parentgroup LIKE '1::2::%')\r\n\t\tAND a.profileid IN (64,65)\r\n\t\tAND a.user_daqu IN ('东部大区','南部大区','西部大区','北部大区','青岛金东','应急安全产品线')\r\n\tGROUP BY a.user_daqu\r\n\tUNION\r\n\tSELECT \r\n\t\t4 AS list_key,\r\n\t\t'公司整体' AS list_value,\r\n\t\t'公司整体' AS list_key2,\r\n\t\t'公司整体' AS list_value2\r\n) a\r\nORDER BY a.list_key,\r\n\t(CASE \r\n\t\tWHEN list_key=1 THEN CONVERT(a.list_value2 USING GBK) \r\n\t\tWHEN list_key=2 THEN FIELD(a.list_value2,'山东区','北京区','河南区','西南区','青岛金东','应急安全产品线')\r\n\t\tWHEN list_key=3 THEN FIELD(a.list_value2,'东部大区','南部大区','西部大区','北部大区','青岛金东','应急安全产品线')\r\n\tEND)"
      },
