        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT listvalue FROM ld_picklist_values WHERE listid=130 ORDER BY sequence"
      },
      "3": {
        "Ident": "StiMySqlSource",
        "Name": "list_nian",
        "Alias": "list_nian",
        "Columns": {
          "0": {
            "Name": "list_value",
            "Index": -1,
            "NameInSource": "list_value",
            "Alias": "list_value",
            "Type": "System.Int32"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT YEAR(NOW())-4 AS list_value\r\nUNION\r\nSELECT YEAR(NOW())-3 AS list_value\r\nUNION\r\nSELECT YEAR(NOW())-2 AS list_value\r\nUNION\r\nSELECT YEAR(NOW())-1 AS list_value\r\nUNION\r\nSELECT YEAR(NOW()) AS list_value"
      }
    },
