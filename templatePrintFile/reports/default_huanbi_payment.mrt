        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT \r\n\tb.cashbillid AS billid,\r\n\tb.cashbilldate AS billdate,\r\n\tb.cashbill_no AS billno,\r\n\tk.accountname,\r\n\tROUND(IFNULL(b.Total,0)/IFNULL(b.conversion_rate,1),2) AS total\r\nFROM ld_cashbill b\r\nLEFT JOIN ld_account k ON k.accountid=b.accountid\r\nINNER JOIN (\r\n\tSELECT DISTINCT\r\n\t\tuserid \r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\tld_users.id AS userid \r\n\t\tFROM ld_users\r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='CashBill' and scopeauthority=1 AND userid='[uuid]')\r\n\t\tUNION\r\n\t\tSELECT \r\n\t\t\tviewid AS userid \r\n\t\tFROM ld_scoperhigher\r\n\t\tWHERE userid='[uuid]' AND modulename='CashBill' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename='CashBill')\t\t\t\r\n\t\tUNION\r\n\t\tSELECT DISTINCT \r\n\t\t\tld_users2group.userid AS userid \r\n\t\tFROM ld_scoperhigher \r\n\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\tAND ld_scoperhigher.modulename='CashBill'\r\n\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='CashBill' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\tUNION \r\n\t\tSELECT \r\n\t\t\tid AS userid \r\n\t\tFROM ld_users  \r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\tUNION\r\n\t\tSELECT '[uuid]') AS vw_users\r\n) AS tmp_users ON tmp_users.userid=b.smownerid\r\nWHERE b.deleted=0\r\n\tAND b.approvestatus<>'已拒绝'\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{userid}'='' THEN 1=1\r\n\t\t\tELSE FIND_IN_SET(CASE WHEN b.smownerid is NULL THEN 1 ELSE b.smownerid END,'{userid}')\r\n\t\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{approve}'='true' THEN b.approvestatus='已批准'\r\n\t\t\tELSE 1=1\r\n\t\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{type}'=1 AND '{this[\"querytype\"]}'='this' THEN b.cashbilldate BETWEEN '{this[\"querydate\"]}' AND LAST_DAY(DATE_ADD('{this[\"querydate\"]}',INTERVAL 3 MONTH))\r\n\t\t\tWHEN '{type}'=2 AND '{this[\"querytype\"]}'='this' THEN b.cashbilldate BETWEEN '{this[\"querydate\"]}' AND LAST_DAY('{this[\"querydate\"]}')\r\n\t\t\tWHEN '{type}'=3 AND '{this[\"querytype\"]}'='this' THEN b.cashbilldate BETWEEN '{this[\"querydate\"]}' AND DATE_ADD('{this[\"querydate\"]}',INTERVAL 7 DAY)\r\n\t\t\tWHEN '{type}'=4 AND '{this[\"querytype\"]}'='this' THEN b.cashbilldate='{this[\"querydate\"]}'\r\n\t\t\tWHEN '{type}'=1 AND '{this[\"querytype\"]}'='last' THEN b.cashbilldate BETWEEN DATE_SUB('{this[\"querydate\"]}',INTERVAL 3 MONTH) AND DATE_SUB('{this[\"querydate\"]}',INTERVAL 1 DAY)\r\n\t\t\tWHEN '{type}'=2 AND '{this[\"querytype\"]}'='last' THEN b.cashbilldate BETWEEN DATE_SUB('{this[\"querydate\"]}',INTERVAL 1 MONTH) AND DATE_SUB('{this[\"querydate\"]}',INTERVAL 1 DAY)\r\n\t\t\tWHEN '{type}'=3 AND '{this[\"querytype\"]}'='last' THEN b.cashbilldate BETWEEN DATE_SUB('{this[\"querydate\"]}',INTERVAL 7 DAY) AND DATE_SUB('{this[\"querydate\"]}',INTERVAL 1 DAY)\r\n\t\t\tWHEN '{type}'=4 AND '{this[\"querytype\"]}'='last' THEN b.cashbilldate=DATE_SUB('{this[\"querydate\"]}',INTERVAL 1 DAY)\r\n\t\tEND) \r\nAND (\r\n\tCASE\r\n\t\tWHEN TRIM('{custname}')='' THEN 1=1\r\n\t\tELSE LOCATE(TRIM('{custname}'),k.accountname)>0\r\n\tEND) \r\nORDER BY b.cashbilldate,b.cashbillid"
      }
    },
    "Databases": {
