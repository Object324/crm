    "DataSources": {
      "0": {
        "Ident": "StiMySqlSource",
        "Name": "date",
        "Alias": "date",
        "Columns": {
          "0": {
            "Name": "enddate",
            "Index": -1,
            "NameInSource": "enddate",
            "Alias": "enddate",
            "Type": "System.String"
          },
          "1": {
            "Name": "startdate",
            "Index": -1,
            "NameInSource": "startdate",
            "Alias": "startdate",
            "Type": "System.String"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\tCASE\r\n\t\tWHEN '{type}'=1 THEN concat(date_format(LAST_DAY(MAKEDATE(EXTRACT(YEAR FROM DATE_FORMAT('{start_date}','%Y-%m-%d')),1) + interval QUARTER(DATE_FORMAT('{start_date}','%Y-%m-%d'))*3-3 month),'%Y-%m-'),'01')\r\n\t\tWHEN '{type}'=2 THEN concat(date_format(LAST_DAY(DATE_FORMAT('{start_date}','%Y-%m-%d')),'%Y-%m-'),'01') \r\n\t\tWHEN '{type}'=3 THEN date_sub(DATE_FORMAT('{start_date}','%Y-%m-%d'),INTERVAL WEEKDAY(DATE_FORMAT('{start_date}','%Y-%m-%d')) DAY)\r\n\t\tWHEN '{type}'=4 THEN DATE_FORMAT('{start_date}','%Y-%m-%d')\r\n\tEND as startdate,\r\n\tCASE\r\n\t\tWHEN '{type}'=1 THEN LAST_DAY(MAKEDATE(EXTRACT(YEAR FROM DATE_FORMAT('{end_date}','%Y-%m-%d')),1) + interval QUARTER(DATE_FORMAT('{end_date}','%Y-%m-%d'))*3-1 month)\r\n\t\tWHEN '{type}'=2 THEN LAST_DAY(DATE_FORMAT('{end_date}','%Y-%m-%d')) \r\n\t\tWHEN '{type}'=3 THEN date_sub(DATE_FORMAT('{end_date}','%Y-%m-%d'),INTERVAL WEEKDAY(DATE_FORMAT('{end_date}','%Y-%m-%d')) -6 DAY)\r\n\t\tWHEN '{type}'=4 THEN DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\tEND as enddate"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "report",
        "Alias": "report",
        "Columns": {
          "0": {
            "Name": "date",
            "Index": -1,
            "NameInSource": "date",
            "Alias": "date",
            "Type": "System.DateTime"
          },
          "1": {
            "Name": "huanbi",
            "Index": -1,
            "NameInSource": "huanbi",
            "Alias": "huanbi",
            "Type": "System.String"
          },
          "2": {
            "Name": "remark",
            "Index": -1,
            "NameInSource": "remark",
            "Alias": "remark",
            "Type": "System.String"
          },
          "3": {
            "Name": "tips",
            "Index": -1,
            "NameInSource": "tips",
            "Alias": "tips",
            "Type": "System.String"
          },
          "4": {
            "Name": "tips_bef",
            "Index": -1,
            "NameInSource": "tips_bef",
            "Alias": "tips_bef",
            "Type": "System.String"
          },
          "5": {
            "Name": "total",
            "Index": -1,
            "NameInSource": "total",
            "Alias": "total",
            "Type": "System.Object"
          },
          "6": {
            "Name": "total_bef",
            "Index": -1,
            "NameInSource": "total_bef",
            "Alias": "total_bef",
            "Type": "System.Object"
          }
        },
        "NameInSource": "ldcrm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\t*,\r\n\tCASE\r\n\t\tWHEN total_bef=0 THEN '--'\r\n\t\tELSE concat(format((total-total_bef)*100/total_bef,2),'%')\r\n\tEND AS huanbi,\r\n\tformat(total,2) as tips,\r\n\tformat(total_bef,2) as tips_bef\r\nFROM (\r\n\tSELECT\r\n\t\tt.date,\r\n\t\tt.remark,\r\n\t\tIFNULL(t.total,0) AS total,\r\n\t\tIFNULL((\r\n\t\t\tSELECT\r\n\t\t\t\tSUM(ROUND(b.Total,2)) as total\r\n\t\t\tFROM tmp_date a\r\n\t\t\tLEFT JOIN (\r\n\t\t\t\tSELECT\r\n\t\t\t\t\ta.cashbillid,\r\n\t\t\t\t\ta.smownerid,\r\n\t\t\t\t\ta.cashbilldate,\r\n\t\t\t\t\tIFNULL(a.Total,0)/IFNULL(a.conversion_rate,1) AS Total\r\n\t\t\t\tFROM ld_cashbill a\r\n\t\t\t\tLEFT JOIN ld_account k ON k.accountid=a.accountid\r\n\t\t\t\tINNER JOIN (\r\n\t\t\t\t\tSELECT DISTINCT\r\n\t\t\t\t\t\tuserid \r\n\t\t\t\t\tFROM (\r\n\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\tld_users.id AS userid \r\n\t\t\t\t\t\tFROM ld_users\r\n\t\t\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='CashBill' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\t\t\t\tUNION\r\n\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\tviewid AS userid \r\n\t\t\t\t\t\tFROM ld_scoperhigher\r\n\t\t\t\t\t\tWHERE userid='[uuid]' AND modulename='CashBill' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename='CashBill')\t\t\t\r\n\t\t\t\t\t\tUNION\r\n\t\t\t\t\t\tSELECT DISTINCT \r\n\t\t\t\t\t\t\tld_users2group.userid AS userid \r\n\t\t\t\t\t\tFROM ld_scoperhigher \r\n\t\t\t\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\t\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\t\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\t\t\t\tAND ld_scoperhigher.modulename='CashBill'\r\n\t\t\t\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='CashBill' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\t\t\t\tUNION \r\n\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\tid AS userid \r\n\t\t\t\t\t\tFROM ld_users  \r\n\t\t\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\t\t\t\tUNION\r\n\t\t\t\t\t\tSELECT '[uuid]') AS vw_users\r\n\t\t\t\t) AS tmp_users ON tmp_users.userid=a.smownerid\r\n\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{approve}'='true' THEN a.approvestatus='已批准'\r\n\t\t\t\t\t\t\tELSE 1=1\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{userid}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE FIND_IN_SET(CASE WHEN a.smownerid is NULL THEN 1 ELSE a.smownerid END,'{userid}')\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN TRIM('{custname}')='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE(TRIM('{custname}'),k.accountname)>0\r\n\t\t\t\t\t\tEND) \r\n\t\t\t) b ON b.cashbilldate=a.date\r\n\t\t\tWHERE 1=1\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{type}'=1 THEN a.date BETWEEN DATE_SUB(t.date,INTERVAL 3 MONTH) AND DATE_SUB(t.date,INTERVAL 1 DAY)\r\n\t\t\t\t\t\tWHEN '{type}'=2 THEN a.date BETWEEN DATE_SUB(t.date,INTERVAL 1 MONTH) AND DATE_SUB(t.date,INTERVAL 1 DAY)\r\n\t\t\t\t\t\tWHEN '{type}'=3 THEN a.date BETWEEN DATE_SUB(t.date,INTERVAL 7 DAY) AND DATE_SUB(t.date,INTERVAL 1 DAY)\r\n\t\t\t\t\t\tWHEN '{type}'=4 THEN a.date=DATE_SUB(t.date,INTERVAL 1 DAY)\r\n\t\t\t\t\tEND)\r\n\t\t),0) AS total_bef\r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\tMIN(a.date) AS date,\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{type}'=1 THEN CONCAT(year(a.date),'年Q',quarter(a.date))\r\n\t\t\t\tWHEN '{type}'=2 THEN CONCAT(year(a.date),'年',DATE_FORMAT(a.date,'%m'),'月')\r\n\t\t\t\tWHEN '{type}'=3 THEN CONCAT(year(a.date),'年',WEEK(a.date),'周')\r\n\t\t\t\tWHEN '{type}'=4 THEN a.date\r\n\t\t\tEND AS remark,\r\n\t\t\tSUM(ROUND(b.Total,2)) AS total\r\n\t\tFROM tmp_date a\r\n\t\tLEFT JOIN (\r\n\t\t\tSELECT\r\n\t\t\t\ta.cashbillid,\r\n\t\t\t\ta.smownerid,\r\n\t\t\t\ta.cashbilldate,\r\n\t\t\t\tIFNULL(a.Total,0)/IFNULL(a.conversion_rate,1) AS Total\r\n\t\t\tFROM ld_cashbill a\r\n\t\t\tLEFT JOIN ld_account k ON k.accountid=a.accountid\r\n\t\t\tINNER JOIN (\r\n\t\t\t\tSELECT DISTINCT\r\n\t\t\t\t\tuserid \r\n\t\t\t\tFROM (\r\n\t\t\t\t\tSELECT \r\n\t\t\t\t\t\tld_users.id AS userid \r\n\t\t\t\t\tFROM ld_users\r\n\t\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='CashBill' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\t\t\tUNION\r\n\t\t\t\t\tSELECT \r\n\t\t\t\t\t\tviewid AS userid \r\n\t\t\t\t\tFROM ld_scoperhigher\r\n\t\t\t\t\tWHERE userid='[uuid]' AND modulename='CashBill' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename='CashBill')\t\t\t\r\n\t\t\t\t\tUNION\r\n\t\t\t\t\tSELECT DISTINCT \r\n\t\t\t\t\t\tld_users2group.userid AS userid \r\n\t\t\t\t\tFROM ld_scoperhigher \r\n\t\t\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\t\t\tAND ld_scoperhigher.modulename='CashBill'\r\n\t\t\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='CashBill' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\t\t\tUNION \r\n\t\t\t\t\tSELECT \r\n\t\t\t\t\t\tid AS userid \r\n\t\t\t\t\tFROM ld_users  \r\n\t\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\t\t\tUNION\r\n\t\t\t\t\tSELECT '[uuid]') AS vw_users\r\n\t\t\t) AS tmp_users ON tmp_users.userid=a.smownerid\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{approve}'='true' THEN a.approvestatus='已批准'\r\n\t\t\t\t\t\tELSE 1=1\r\n\t\t\t\t\tEND)\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{userid}'='' THEN 1=1\r\n\t\t\t\t\t\tELSE FIND_IN_SET(CASE WHEN a.smownerid is NULL THEN 1 ELSE a.smownerid END,'{userid}')\r\n\t\t\t\t\tEND)\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN TRIM('{custname}')='' THEN 1=1\r\n\t\t\t\t\t\tELSE LOCATE(TRIM('{custname}'),k.accountname)>0\r\n\t\t\t\t\tEND) \r\n\t\t) b ON b.cashbilldate=a.date\r\n\t\tWHERE 1=1\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{type}'=1 THEN \r\n\t\t\t\t\t\ta.date BETWEEN concat(date_format(LAST_DAY(MAKEDATE(EXTRACT(YEAR FROM DATE_FORMAT('{start_date}','%Y-%m-%d')),1) + interval QUARTER(DATE_FORMAT('{start_date}','%Y-%m-%d'))*3-3 month),'%Y-%m-'),'01')\r\n\t\t\t\t\t\t\tAND LAST_DAY(MAKEDATE(EXTRACT(YEAR FROM DATE_FORMAT('{end_date}','%Y-%m-%d')),1) + interval QUARTER(DATE_FORMAT('{end_date}','%Y-%m-%d'))*3-1 month)\r\n\t\t\t\t\tWHEN '{type}'=2 THEN a.date BETWEEN concat(date_format(LAST_DAY(DATE_FORMAT('{start_date}','%Y-%m-%d')),'%Y-%m-'),'01') AND LAST_DAY(DATE_FORMAT('{end_date}','%Y-%m-%d'))\r\n\t\t\t\t\tWHEN '{type}'=3 THEN a.date BETWEEN date_sub(DATE_FORMAT('{start_date}','%Y-%m-%d'),INTERVAL WEEKDAY(DATE_FORMAT('{start_date}','%Y-%m-%d')) DAY) AND date_sub(DATE_FORMAT('{end_date}','%Y-%m-%d'),INTERVAL WEEKDAY(DATE_FORMAT('{end_date}','%Y-%m-%d')) -6 DAY)\r\n\t\t\t\t\tWHEN '{type}'=4 THEN a.date BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\t\t\t\tEND)\r\n\t\tGROUP BY remark\r\n\t) t\r\n\tORDER BY date\r\n) a"
      },
      "2": {
        "Ident": "StiMySqlSource",
        "Name": "user",
        "Alias": "user",
        "Columns": {
          "0": {
            "Name": "id",
            "Index": -1,
            "NameInSource": "id",
            "Alias": "id",
            "Type": "System.Int32"
          },
          "1": {
            "Name": "last_name",
            "Index": -1,
            "NameInSource": "last_name",
            "Alias": "last_name",
            "Type": "System.String"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\ta.id,\r\n\ta.last_name\r\nFROM ld_users a\r\nINNER JOIN (\r\n\tSELECT DISTINCT\r\n\t\tuserid \r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\tld_users.id as userid \r\n\t\tFROM ld_users\r\n\t\tWHERE EXISTS(select 1 from ld_setscoperhigher where modulename='CashBill' and scopeauthority=1 and userid='[uuid]')\r\n\t\tUNION\r\n\t\tselect \r\n\t\t\tviewid as userid \r\n\t\tfrom ld_scoperhigher\r\n\t\twhere userid='[uuid]' and modulename='CashBill' and EXISTS(select 1 from ld_setscoperhigher where userid='[uuid]' and scopeauthority=2 and modulename='CashBill')\t\t\t\r\n\t\tUNION\r\n\t\tselect DISTINCT \r\n\t\t\tld_users2group.userid as userid \r\n\t\tfrom ld_scoperhigher \r\n\t\tINNER JOIN ld_groups on ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\tINNER JOIN ld_users2group on ld_users2group.groupid=ld_groups.groupid\r\n\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\tand ld_scoperhigher.modulename='CashBill'\r\n\t\t\tand ld_scoperhigher.scopeauthority=3 \r\n\t\t\tand EXISTS(select 1 from ld_setscoperhigher where modulename='CashBill' and scopeauthority=3 and userid='[uuid]')\r\n\t\tUNION \r\n\t\tselect \r\n\t\t\tid as userid \r\n\t\tfrom ld_users  \r\n\t\twhere exists(select 1 from ld_users where id='[uuid]' and is_admin='on')\r\n\t\tUNION\r\n\t\tselect '[uuid]')as vw_users\r\n) as tmp_users ON tmp_users.userid=a.id\r\norder by CONVERT(a.last_name USING gbk)"
      },
      "3": {
        "Ident": "StiMySqlSource",
        "Name": "detail",
