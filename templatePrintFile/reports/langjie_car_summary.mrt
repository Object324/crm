        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\ta.projecttype AS 01_chexing,\r\n\ta.projectname AS 02_chepai,\r\n\tb.cf_2954 AS 03_goucheshi,\r\n\tIFNULL(DATE_FORMAT(a.baoxian_tilldate,'%y.%c.%e'),'') AS 04_baoxian,\r\n  b.cf_3188 AS 041_bxgs,\r\n\tIFNULL(DATE_FORMAT(a.nianshen_tilldate,'%y.%c'),'') AS 05_niansheng,\r\n\tIFNULL(DATE_FORMAT(a.zhonghe_tilldate,'%y.%c'),'') AS 06_zhongheshen,\r\n\tb.cf_2952 AS 07_haiguan,\r\n\tCASE WHEN c.L01>0 THEN FORMAT(c.L01,0) ELSE '' END AS L01,\r\n\tCASE WHEN c.L02>0 THEN FORMAT(c.L02,0) ELSE '' END AS L02,\r\n\tCASE WHEN c.L03>0 THEN FORMAT(c.L03,0) ELSE '' END AS L03,\r\n\tCASE WHEN c.L04>0 THEN FORMAT(c.L04,0) ELSE '' END AS L04,\r\n\tCASE WHEN c.L05>0 THEN FORMAT(c.L05,0) ELSE '' END AS L05,\r\n\tCASE WHEN c.L06>0 THEN FORMAT(c.L06,0) ELSE '' END AS L06,\r\n\tCASE WHEN c.L07>0 THEN FORMAT(c.L07,0) ELSE '' END AS L07,\r\n\tCASE WHEN c.L08>0 THEN FORMAT(c.L08,0) ELSE '' END AS L08,\r\n\tCASE WHEN c.L09>0 THEN FORMAT(c.L09,0) ELSE '' END AS L09,\r\n\tCASE WHEN c.L10>0 THEN FORMAT(c.L10,0) ELSE '' END AS L10,\r\n\tCASE WHEN c.L11>0 THEN FORMAT(c.L11,0) ELSE '' END AS L11,\r\n\tCASE WHEN c.L12>0 THEN FORMAT(c.L12,0) ELSE '' END AS L12,\r\n\tc.L01+c.L02+c.L03+c.L04+c.L05+c.L06+c.L07+c.L08+c.L09+c.L10+c.L11+c.L12 AS total,\r\n  '{nian}' nian\r\nFROM ld_project a\r\nLEFT JOIN ld_projectcf b ON a.projectid=b.projectid\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\ta.projectid,\r\n\t\tREPLACE(projectmilestonename,',','')+0 AS L01,\r\n\t\tREPLACE(b.cf_2957,',','')+0 AS L02,\r\n\t\tREPLACE(b.cf_2958,',','')+0 AS L03,\r\n\t\tREPLACE(b.cf_2959,',','')+0 AS L04,\r\n\t\tREPLACE(b.cf_2960,',','')+0 AS L05,\r\n\t\tREPLACE(b.cf_2961,',','')+0 AS L06,\r\n\t\tREPLACE(b.cf_2962,',','')+0 AS L07,\r\n\t\tREPLACE(b.cf_2963,',','')+0 AS L08,\r\n\t\tREPLACE(b.cf_2964,',','')+0 AS L09,\r\n\t\tREPLACE(b.cf_2965,',','')+0 AS L10,\r\n\t\tREPLACE(b.cf_2966,',','')+0 AS L11,\r\n\t\tREPLACE(b.cf_2967,',','')+0 AS L12, a.projectmilestonetype nian\r\n\tFROM ld_projectmilestone a\r\n\tLEFT JOIN ld_projectmilestonecf b ON b.projectmilestoneid=a.projectmilestoneid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.projectid>0\r\n\t  AND a.projectmilestonetype='{nian}'\r\n\tGROUP BY a.projectid\r\n) c ON c.projectid=a.projectid\r\nWHERE a.deleted=0\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN TRIM('{chepai}')='' THEN 1=1\r\n\t\t\tELSE LOCATE(TRIM('{chepai}'),a.projectname)>0\r\n\t\tEND) \r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN TRIM('{chexing}')='' THEN 1=1\r\n\t\t\tELSE FIND_IN_SET(a.projecttype,'{chexing}')\r\n\t\tEND)\r\nORDER BY 1,2"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "list_nian",
        "Alias": "list_nian",
        "Columns": {
          "0": {
            "Name": "list_value",
