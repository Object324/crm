        },
        "NameInSource": "ldcrm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\t*\r\nFROM (\r\n\tSELECT\r\n\t\ta.purchaseinquiryorderid AS orderid,\r\n\t\ta.purchaseinquiryorder_no AS orderno,\r\n\t\ta.cf_2386 AS bjshr,\r\n\t\tb.cf_2403 AS yunshufangshi,\r\n\t\tb.cf_2404 AS yunshudanhao,\r\n\t\ta.createdtime,\r\n\t\ta.description,\r\n\t\tCASE\r\n\t\t\tWHEN c.entitytype='Quotes' THEN e.potentialname\r\n\t\t\tWHEN c.entitytype='QuotesChange' THEN f.potentialname\r\n\t\tEND AS ccf_no,\r\n\t\tCASE\r\n\t\t\tWHEN c.entitytype='Quotes' THEN e.yuandan_no\r\n\t\t\tWHEN c.entitytype='QuotesChange' THEN f.bsd_no\r\n\t\tEND AS bsd_no,\r\n\t\tCASE\r\n\t\t\tWHEN c.entitytype='Quotes' THEN e.accountname\r\n\t\t\tWHEN c.entitytype='QuotesChange' THEN f.accountname\r\n\t\tEND AS accountname,\r\n\t\ta.modifiedtime,\r\n\t\tCASE\r\n\t\t\tWHEN a.approvestatus='已批准' THEN a.approvetime\r\n\t\t\tELSE NULL\r\n\t\tEND AS approve_endtime,\r\n\t\tCASE\r\n\t\t\tWHEN a.approvestatus='已批准' THEN u1.last_name\r\n\t\t\tELSE NULL\r\n\t\tEND AS approveby,\r\n\t\tu3.last_name AS smowner,\r\n\t\tu2.last_name AS smbiller,\r\n\t\tp.productname,\r\n\t\tp.product_no,\r\n\t\tp.productsheet,\r\n\t\tc.quantity,\r\n\t\tc.sf839 AS sunhuai_serial,\r\n\t\tc.sf1148 AS waigou_info,\r\n\t\tc.sf942 AS fanchang_info,\r\n\t\tc.sf1045 AS bsd_approvedate,\r\n\t\tc.`comment` AS miaoshu,\r\n\t\tCASE\r\n\t\t\tWHEN c.entitytype='Quotes' THEN e.yuandan_no\r\n\t\t\tWHEN c.entitytype='QuotesChange' THEN f.yuandan_no\r\n\t\tEND AS yuandan_no,\r\n\t\tCASE\r\n\t\t\tWHEN c.entitytype='Quotes' THEN '报损单'\r\n\t\t\tWHEN c.entitytype='QuotesChange' THEN '报损变更单'\r\n\t\tEND AS yuandan_type\r\n\tFROM ld_purchaseinquiryorder a\r\n\tLEFT JOIN ld_purchaseinquiryordercf b ON a.purchaseinquiryorderid=b.purchaseinquiryorderid\r\n\tLEFT JOIN ld_purchaseinquiryorderdetail c ON c.id=a.purchaseinquiryorderid\r\n\tLEFT JOIN ld_products p ON p.productid=c.productid\r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\ta.quoteid AS yuandan_id,\r\n\t\t\ta.quote_no AS yuandan_no,\r\n      b.potentialname,\r\n\t\t\tb.potential_no,\r\n\t\t\tc.accountname\r\n\t\tFROM ld_quotes a\r\n\t\tLEFT JOIN ld_potential b ON b.potentialid=a.potentialid\r\n\t\tLEFT JOIN ld_account c ON c.accountid=b.accountid\r\n\t) e ON e.yuandan_id=c.entitytypeid AND c.entitytype='Quotes'\r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\ta.quoteschangeid AS yuandan_id,\r\n\t\t\ta.quoteschange_no AS yuandan_no,\r\n\t\t\tb.quote_no AS bsd_no,\r\n\t\t\tc.potential_no,\r\n\t\t\tc.potentialname,\r\n\t\t\td.accountname\r\n\t\tFROM ld_quoteschange a\r\n\t\tLEFT JOIN ld_quotes b ON a.quoteid=b.quoteid\r\n\t\tLEFT JOIN ld_potential c ON c.potentialid=a.potentialid\r\n\t\tLEFT JOIN ld_account d ON d.accountid=c.accountid\r\n\t) f ON f.yuandan_id=c.entitytypeid AND c.entitytype='QuotesChange'\r\n\tLEFT JOIN ld_users u1 ON u1.id=a.approveby\r\n\tLEFT JOIN ld_users u2 ON u2.id=a.smcreatorid\r\n\tLEFT JOIN ld_users u3 ON u3.id=a.smownerid\r\n\tINNER JOIN (\r\n\t\tSELECT DISTINCT\r\n\t\t\tuserid \r\n\t\tFROM (\r\n\t\t\tSELECT \r\n\t\t\t\tld_users.id AS userid \r\n\t\t\tFROM ld_users\r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='PurchaseInquiryOrder' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\tUNION\r\n\t\t\tSELECT \r\n\t\t\t\tviewid AS userid \r\n\t\t\tFROM ld_scoperhigher\r\n\t\t\tWHERE userid='[uuid]' AND modulename='PurchaseInquiryOrder' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename='PurchaseInquiryOrder')\t\t\t\r\n\t\t\tUNION\r\n\t\t\tSELECT DISTINCT \r\n\t\t\t\tld_users2group.userid AS userid \r\n\t\t\tFROM ld_scoperhigher \r\n\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\tAND ld_scoperhigher.modulename='PurchaseInquiryOrder'\r\n\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='PurchaseInquiryOrder' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\tUNION \r\n\t\t\tSELECT \r\n\t\t\t\tid AS userid \r\n\t\t\tFROM ld_users  \r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\tUNION\r\n\t\t\tSELECT '[uuid]') AS vw_users\r\n\t) AS list_user ON list_user.userid=a.smownerid\r\n\tWHERE a.deleted=0 \r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND IFNULL(b.cf_2375,'')<>'作废单据'\r\n\t\tAND DATE_FORMAT(IFNULL(a.modifiedtime,a.createdtime),'%Y-%m-%d') BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{userid}'='' THEN 1=1\r\n\t\t\t\tELSE FIND_IN_SET(a.smownerid,'{userid}')\r\n\t\t\tEND)\r\n) tmp\r\nWHERE 1=1\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{ccfnum}'='' THEN 1=1\r\n\t\t\tELSE LOCATE(TRIM('{ccfnum}'),ccf_no)>0\r\n\t\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{custname}'='' THEN 1=1\r\n\t\t\tELSE LOCATE(TRIM('{custname}'),accountname)>0\r\n\t\tEND)\r\nORDER BY createdtime"
      }
    },
    "Databases": {
