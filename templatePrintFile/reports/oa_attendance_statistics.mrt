          },
          "1": {
            "Name": "type",
            "Index": -1,
            "NameInSource": "type",
            "Alias": "type",
            "Type": "System.String"
          },
          "2": {
            "Name": "total",
            "Index": -1,
            "NameInSource": "total",
            "Alias": "total",
            "Type": "System.String"
          },
          "3": {
            "Name": "description",
            "Index": -1,
            "NameInSource": "description",
            "Alias": "description",
            "Type": "System.String"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\t(SELECT last_name FROM ld_users WHERE id=t.smownerid) AS last_name,\r\n\tt.type,\r\n\tz.total,\r\n\tt.description\r\nFROM (\r\n\tSELECT\r\n\t\ta.smownerid,\r\n\t\t'加班' AS type,\r\n\t\tCASE \r\n\t\t\tWHEN IFNULL(b.description,'')='' THEN\r\n\t\t\t\tCONCAT('时间:',IFNULL(DATE_FORMAT(b.starttime,'%Y-%m-%d'),'')  ,'至',IFNULL(DATE_FORMAT(b.endtime,'%Y-%m-%d'),''),'  时长:',IF(b.costtime=ROUND(b.costtime,0),ROUND(b.costtime,0),ROUND(b.costtime,1)),'小时')\r\n\t\t\tELSE\r\n\t\t\t\tCONCAT('时间:',IFNULL(DATE_FORMAT(b.starttime,'%Y-%m-%d'),'')  ,'至',IFNULL(DATE_FORMAT(b.endtime,'%Y-%m-%d'),''),'  时长:',IF(b.costtime=ROUND(b.costtime,0),ROUND(b.costtime,0),ROUND(b.costtime,1)),'小时','  备注:',b.description)\r\n\t\tEND AS description\r\n\tFROM ld_addjobbill a\r\n\tLEFT JOIN ld_addjobbilldetail b ON a.addjobbillid=b.id\r\n\tWHERE a.deleted=0\r\n\t\tAND IFNULL(a.approvestatus,'')<>'已拒绝'\r\n\t\tAND (CASE WHEN '{shenpi}'='false' THEN 1=1 ELSE a.approvestatus='已批准' END)\r\n\t\tAND smownerid='{this[\"userid\"]}' \r\n\t\tAND DATE_FORMAT(b.starttime,'%Y-%m-%d')>= DATE_FORMAT(CONCAT('{nian}','-','{yue}','-1'),'%Y-%m-%d')\r\n\t\tAND DATE_FORMAT(b.starttime,'%Y-%m-%d')<= LAST_DAY(CONCAT('{nian}','-','{yue}','-1'))\r\n\tUNION ALL\r\n\tSELECT\r\n\t\ta.smownerid,\r\n\t\tb.minusjobtype AS type,\r\n\t\tCASE \r\n\t\t\tWHEN IFNULL(b.description,'')='' THEN\r\n\t\t\t\tCONCAT('时间:',IFNULL(DATE_FORMAT(b.starttime,'%Y-%m-%d'),'')  ,'至',IFNULL(DATE_FORMAT(b.endtime,'%Y-%m-%d'),''),'  时长:',IF(b.costtime=ROUND(b.costtime,0),ROUND(b.costtime,0),ROUND(b.costtime,1)),'小时')\r\n\t\t\tELSE\r\n\t\t\t\tCONCAT('时间:',IFNULL(DATE_FORMAT(b.starttime,'%Y-%m-%d'),'')  ,'至',IFNULL(DATE_FORMAT(b.endtime,'%Y-%m-%d'),''),'  时长:',IF(b.costtime=ROUND(b.costtime,0),ROUND(b.costtime,0),ROUND(b.costtime,1)),'小时','  备注:',b.description)\r\n\t\tEND AS description\r\n\tFROM ld_minusjobbill a\r\n\tLEFT JOIN ld_minusjobbilldetail b ON a.minusjobbillid=b.id\r\n\tWHERE a.deleted=0\r\n\t\tAND IFNULL(a.approvestatus,'')<>'已拒绝' \r\n\t\tAND (CASE WHEN '{shenpi}'='false' THEN 1=1 ELSE a.approvestatus='已批准' END)\r\n\t\tAND smownerid='{this[\"userid\"]}' \r\n\t\tAND DATE_FORMAT(b.starttime,'%Y-%m-%d')>= DATE_FORMAT(CONCAT('{nian}','-','{yue}','-1'),'%Y-%m-%d')\r\n\t\tAND DATE_FORMAT(b.starttime,'%Y-%m-%d')<= LAST_DAY(CONCAT('{nian}','-','{yue}','-1'))\r\n) t\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\tsmownerid,\r\n\t\ttype,\r\n\t\tCASE\r\n\t\t\tWHEN type IN ('迟到','早退','特殊报钟') THEN CONCAT(COUNT(a.smownerid),'次')\r\n\t\t\tELSE CONCAT(IFNULL(SUM(total),0),'小时')\r\n\t\tEND AS total\r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\t\ta.smownerid,\r\n\t\t\t\t'加班' AS type,\r\n\t\t\t\tb.costtime AS total\r\n\t\t\tFROM ld_addjobbill a\r\n\t\t\tLEFT JOIN ld_addjobbilldetail b ON a.addjobbillid=b.id\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND IFNULL(a.approvestatus,'')<>'已拒绝'\r\n\t\t\t\tAND (CASE WHEN '{shenpi}'='false' THEN 1=1 ELSE a.approvestatus='已批准' END)\r\n\t\t\t\tAND smownerid='{this[\"userid\"]}' \r\n\t\t\t\tAND DATE_FORMAT(b.starttime,'%Y-%m-%d')>= DATE_FORMAT(CONCAT('{nian}','-','{yue}','-1'),'%Y-%m-%d')\r\n\t\t\t\tAND DATE_FORMAT(b.starttime,'%Y-%m-%d')<= LAST_DAY(CONCAT('{nian}','-','{yue}','-1'))\r\n\t\t\tUNION ALL\r\n\t\t\tSELECT\r\n\t\t\t\ta.smownerid,\r\n\t\t\t\tb.minusjobtype AS type,\r\n\t\t\t\tb.costtime AS total\r\n\t\t\tFROM ld_minusjobbill a\r\n\t\t\tLEFT JOIN ld_minusjobbilldetail b ON a.minusjobbillid=b.id\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND IFNULL(a.approvestatus,'')<>'已拒绝' \r\n\t\t\t\tAND (CASE WHEN '{shenpi}'='false' THEN 1=1 ELSE a.approvestatus='已批准' END)\r\n\t\t\t\tAND smownerid='{this[\"userid\"]}' \r\n\t\t\t\tAND DATE_FORMAT(b.starttime,'%Y-%m-%d')>= DATE_FORMAT(CONCAT('{nian}','-','{yue}','-1'),'%Y-%m-%d')\r\n\t\t\t\tAND DATE_FORMAT(b.starttime,'%Y-%m-%d')<= LAST_DAY(CONCAT('{nian}','-','{yue}','-1'))\r\n\t) a\r\n\tGROUP BY type\r\n) z ON t.smownerid=z.smownerid AND z.type=t.type\r\nORDER BY (CASE WHEN t.type IN ('加班','调休','年假','事假','迟到','早退','特殊报钟') THEN 1 ELSE 100 END),FIELD(t.type,'加班','调休','年假','事假','迟到','早退','特殊报钟')"
      }
    },
