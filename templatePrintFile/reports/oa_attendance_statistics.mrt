    "DataSources": {
      "0": {
        "Ident": "StiMySqlSource",
        "Name": "list_nian",
        "Alias": "list_nian",
        "Columns": {
          "0": {
            "Name": "nian",
            "Index": -1,
            "NameInSource": "nian",
            "Alias": "nian",
            "Type": "System.Int32"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\t*\r\nFROM (\r\n\tSELECT YEAR(CURDATE()) AS nian\r\n\tUNION SELECT YEAR(CURDATE())-1\r\n\tUNION SELECT YEAR(CURDATE())-2\r\n\tUNION SELECT YEAR(CURDATE())-3\r\n\tUNION SELECT YEAR(CURDATE())-4\r\n\tUNION SELECT YEAR(CURDATE())-5\r\n\tUNION SELECT YEAR(CURDATE())-6\r\n\tUNION SELECT YEAR(CURDATE())-7\r\n\tUNION SELECT YEAR(CURDATE())-8\r\n\tUNION SELECT YEAR(CURDATE())-9\r\n) a\r\nWHERE nian>=2017\r\nORDER BY nian DESC"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "list_yue",
        "Alias": "list_yue",
        "Columns": {
          "0": {
            "Name": "yue",
            "Index": -1,
            "NameInSource": "yue",
            "Alias": "yue",
            "Type": "System.Int32"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT 1 as yue\r\n\tUNION SELECT 2\r\n\tUNION SELECT 3\r\n\tUNION SELECT 4\r\n\tUNION SELECT 5\r\n\tUNION SELECT 6\r\n\tUNION SELECT 7\r\n\tUNION SELECT 8\r\n\tUNION SELECT 9\r\n\tUNION SELECT 10\r\n\tUNION SELECT 11\r\n\tUNION SELECT 12"
      },
      "2": {
        "Ident": "StiMySqlSource",
        "Name": "list_user",
        "Alias": "list_user",
        "Columns": {
          "0": {
            "Name": "id",
            "Index": -1,
            "NameInSource": "id",
            "Alias": "id",
            "Type": "System.Int32"
          },
          "1": {
            "Name": "last_name",
            "Index": -1,
            "NameInSource": "last_name",
            "Alias": "last_name",
            "Type": "System.String"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\ta.id,\r\n\ta.last_name\r\nFROM ld_users a\r\nLEFT JOIN ld_usersscf b ON a.id=b.id\r\nINNER JOIN (\r\n\tSELECT DISTINCT\r\n\t\tuserid \r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\tld_users.id AS userid \r\n\t\tFROM ld_users\r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='ReportAnalysis' AND scopeauthority=1 AND userid='[uuid]')\r\n\t\tUNION\r\n\t\tSELECT \r\n\t\t\tviewid\r\n\t\tFROM ld_scoperhigher\r\n\t\tWHERE userid='[uuid]' AND modulename='ReportAnalysis' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename='ReportAnalysis')\t\t\t\r\n\t\tUNION\r\n\t\tSELECT DISTINCT \r\n\t\t\tld_users2group.userid AS userid \r\n\t\tFROM ld_scoperhigher \r\n\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\tWHERE ld_scoperhigher.userid='[uuid]'\r\n\t\t\tAND ld_scoperhigher.modulename='ReportAnalysis'\r\n\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='ReportAnalysis' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\tUNION \r\n\t\tSELECT \r\n\t\t\tid\r\n\t\tFROM ld_users  \r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\tUNION\r\n\t\tSELECT '[uuid]') AS vw_users\r\n\t) AS tmp_users ON tmp_users.userid=a.id\r\nWHERE a.`status`='Active'\r\nORDER BY CONVERT(a.last_name USING gbk)"
      },
      "3": {
        "Ident": "StiMySqlSource",
        "Name": "vw_attendance",
        "Alias": "vw_attendance",
        "Columns": {
          "0": {
