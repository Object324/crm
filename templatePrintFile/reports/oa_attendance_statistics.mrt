            "Index": -1,
            "NameInSource": "yuechu_sy_tx",
            "Alias": "yuechu_sy_tx",
            "Type": "System.Decimal"
          },
          "5": {
            "Name": "this_nianjia",
            "Index": -1,
            "NameInSource": "this_nianjia",
            "Alias": "this_nianjia",
            "Type": "System.Decimal"
          },
          "6": {
            "Name": "this_tiaoxiu",
            "Index": -1,
            "NameInSource": "this_tiaoxiu",
            "Alias": "this_tiaoxiu",
            "Type": "System.Decimal"
          },
          "7": {
            "Name": "this_jiaban",
            "Index": -1,
            "NameInSource": "this_jiaban",
            "Alias": "this_jiaban",
            "Type": "System.Decimal"
          },
          "8": {
            "Name": "this_shijia",
            "Index": -1,
            "NameInSource": "this_shijia",
            "Alias": "this_shijia",
            "Type": "System.Decimal"
          },
          "9": {
            "Name": "this_qita",
            "Index": -1,
            "NameInSource": "this_qita",
            "Alias": "this_qita",
            "Type": "System.Decimal"
          },
          "10": {
            "Name": "this_baozhong",
            "Index": -1,
            "NameInSource": "this_baozhong",
            "Alias": "this_baozhong",
            "Type": "System.String"
          },
          "11": {
            "Name": "this_chidaozaotui",
            "Index": -1,
            "NameInSource": "this_chidaozaotui",
            "Alias": "this_chidaozaotui",
            "Type": "System.String"
          },
          "12": {
            "Name": "yuemo_sy_nj",
            "Index": -1,
            "NameInSource": "yuemo_sy_nj",
            "Alias": "yuemo_sy_nj",
            "Type": "System.Decimal"
          },
          "13": {
            "Name": "yuemo_sy_tx",
            "Index": -1,
            "NameInSource": "yuemo_sy_tx",
            "Alias": "yuemo_sy_tx",
            "Type": "System.Decimal"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\tid,\r\n\tlast_name,\r\n\tCONCAT('员工姓名：',last_name,'\r\n','入职日期：',hire_date,'\r\n','所在部门：',groupname) AS tips,\r\n\tyuechu_nianjia_total-yuechu_nianjia_used AS yuechu_sy_nj,\r\n\tyuechu_sy_tx,\r\n\tthis_nianjia,\r\n\tthis_tiaoxiu,\r\n\tthis_jiaban,\r\n\tthis_shijia,\r\n\tthis_qita,\r\n\tthis_baozhong,\r\n\tthis_chidaozaotui,\r\n\tyuemo_nianjia_total-yuemo_nianjia_used AS yuemo_sy_nj,\r\n\tyuemo_sy_tx\r\nFROM (\r\n\tSELECT\r\n\t\ta.id,\r\n\t\ta.last_name,\r\n\t\ta.hire_date,\r\n\t\ta.groupname,\r\n\t\tCASE\r\n\t\t\tWHEN a.hire_date='--' OR YEAR(a.chaxunqishiri_nianjiaqishiri)-YEAR(a.hire_date)<1 THEN 0\r\n\t\t\tWHEN YEAR(a.chaxunqishiri_nianjiaqishiri)-YEAR(a.hire_date)>=1 AND YEAR(a.chaxunqishiri_nianjiaqishiri)-YEAR(a.hire_date)<10 THEN 40\r\n\t\t\tWHEN YEAR(a.chaxunqishiri_nianjiaqishiri)-YEAR(a.hire_date)>=10 AND YEAR(a.chaxunqishiri_nianjiaqishiri)-YEAR(a.hire_date)<20 THEN 80\r\n\t\t\tWHEN YEAR(a.chaxunqishiri_nianjiaqishiri)-YEAR(a.hire_date)>=20 THEN 120\r\n\t\tEND AS yuechu_nianjia_total,\r\n\t\tIFNULL((\r\n\t\t\tSELECT\r\n\t\t\t\tSUM(n.costtime)\r\n\t\t\tFROM ld_minusjobbill m\r\n\t\t\tLEFT JOIN ld_minusjobbilldetail n ON m.minusjobbillid=n.id\r\n\t\t\tWHERE m.deleted=0\r\n\t\t\t\tAND IFNULL(m.approvestatus,'')<>'已拒绝' \r\n\t\t\t\tAND n.minusjobtype='年假'\r\n\t\t\t\tAND (CASE WHEN '{shenpi}'='false' THEN 1=1 ELSE m.approvestatus='已批准' END)\r\n\t\t\t\tAND m.smownerid=a.id\r\n\t\t\t\tAND DATE_FORMAT(n.starttime,'%Y-%m-%d')>=a.chaxunqishiri_nianjiaqishiri\r\n\t\t\t\tAND DATE_FORMAT(n.starttime,'%Y-%m-%d')<DATE_FORMAT(CONCAT('{nian}','-','{yue}','-1'),'%Y-%m-%d')\r\n\t\t),0) AS yuechu_nianjia_used,\r\n\t\tIFNULL(d.jiaban,0)-IFNULL(e.tiaoxiu,0)-IFNULL(b.jiaban,0)+IFNULL(c.tiaoxiu,0) AS yuechu_sy_tx,\r\n\t\tc.nianjia AS this_nianjia,\r\n\t\tc.tiaoxiu AS this_tiaoxiu,\r\n\t\tb.jiaban AS this_jiaban,\r\n\t\tc.shijia AS this_shijia,\r\n\t\tc.qita AS this_qita,\r\n\t\tCASE\r\n\t\t\tWHEN c.baozhong>0 THEN CONCAT(c.baozhong,'次')\r\n\t\t\tELSE ''\r\n\t\tEND AS this_baozhong,\r\n\t\tCASE\r\n\t\t\tWHEN c.chidaozaotui>0 THEN CONCAT(c.chidaozaotui,'次')\r\n\t\t\tELSE ''\r\n\t\tEND AS this_chidaozaotui,\r\n\t\tCASE\r\n\t\t\tWHEN a.hire_date='--' OR YEAR(a.chaxunjiezhiri_nianjiaqishiri)-YEAR(a.hire_date)<1 THEN 0\r\n\t\t\tWHEN YEAR(a.chaxunjiezhiri_nianjiaqishiri)-YEAR(a.hire_date)>=1 AND YEAR(a.chaxunjiezhiri_nianjiaqishiri)-YEAR(a.hire_date)<10 THEN 40\r\n\t\t\tWHEN YEAR(a.chaxunjiezhiri_nianjiaqishiri)-YEAR(a.hire_date)>=10 AND YEAR(a.chaxunjiezhiri_nianjiaqishiri)-YEAR(a.hire_date)<20 THEN 80\r\n\t\t\tWHEN YEAR(a.chaxunjiezhiri_nianjiaqishiri)-YEAR(a.hire_date)>=20 THEN 120\r\n\t\tEND AS yuemo_nianjia_total,\r\n\t\tIFNULL((\r\n\t\t\tSELECT\r\n\t\t\t\tSUM(n.costtime)\r\n\t\t\tFROM ld_minusjobbill m\r\n\t\t\tLEFT JOIN ld_minusjobbilldetail n ON m.minusjobbillid=n.id\r\n\t\t\tWHERE m.deleted=0\r\n\t\t\t\tAND IFNULL(m.approvestatus,'')<>'已拒绝' \r\n\t\t\t\tAND n.minusjobtype='年假'\r\n\t\t\t\tAND (CASE WHEN '{shenpi}'='false' THEN 1=1 ELSE m.approvestatus='已批准' END)\r\n\t\t\t\tAND m.smownerid=a.id\r\n\t\t\t\tAND DATE_FORMAT(n.starttime,'%Y-%m-%d')>=a.chaxunjiezhiri_nianjiaqishiri\r\n\t\t\t\tAND DATE_FORMAT(n.starttime,'%Y-%m-%d')<=LAST_DAY(CONCAT('{nian}','-','{yue}','-1'))\r\n\t\t),0) AS yuemo_nianjia_used,\r\n\t\tIFNULL(d.jiaban,0)-IFNULL(e.tiaoxiu,0) AS yuemo_sy_tx\r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\ta.id,\r\n\t\t\ta.last_name,\r\n\t\t\tGROUP_CONCAT(DISTINCT c.groupname SEPARATOR '/') AS groupname,\r\n\t\t\t0 AS extra_tx,\r\n\t\t\t0 AS extra_nj,\r\n\t\t\tCASE\r\n\t\t\t\tWHEN IFNULL(a.hire_date,'')='' OR a.hire_date='0000-00-00' THEN NULL\r\n\t\t\t\tELSE DATE_ADD(a.hire_date,INTERVAL 2017-YEAR(a.hire_date) YEAR)\r\n\t\t\tEND AS extra_nj_enddate,\r\n\t\t\tIFNULL(a.hire_date,'--') AS hire_date,\r\n\t\t\tCASE\r\n\t\t\t\tWHEN IFNULL(a.hire_date,'')='' OR a.hire_date='0000-00-00' THEN NULL\r\n\t\t\t\tWHEN DATE_ADD(a.hire_date,INTERVAL '{nian}'-YEAR(a.hire_date) YEAR)<=DATE_FORMAT(CONCAT('{nian}','-','{yue}','-1'),'%Y-%m-%d') THEN DATE_ADD(a.hire_date,INTERVAL '{nian}'-YEAR(a.hire_date) YEAR)\r\n\t\t\t\tELSE DATE_ADD(a.hire_date,INTERVAL '{nian}'-YEAR(a.hire_date)-1 YEAR)\r\n\t\t\tEND AS chaxunqishiri_nianjiaqishiri,\r\n\t\t\tCASE\r\n\t\t\t\tWHEN IFNULL(a.hire_date,'')='' OR a.hire_date='0000-00-00' THEN NULL\r\n\t\t\t\tWHEN DATE_ADD(a.hire_date,INTERVAL '{nian}'-YEAR(a.hire_date) YEAR)<=LAST_DAY(CONCAT('{nian}','-','{yue}','-1')) THEN DATE_ADD(a.hire_date,INTERVAL '{nian}'-YEAR(a.hire_date) YEAR)\r\n\t\t\t\tELSE DATE_ADD(a.hire_date,INTERVAL '{nian}'-YEAR(a.hire_date)-1 YEAR)\r\n\t\t\tEND AS chaxunjiezhiri_nianjiaqishiri\r\n\t\tFROM ld_users a\r\n\t\tLEFT JOIN ld_users2group b ON a.id=b.userid\r\n\t\tLEFT JOIN ld_groups c ON c.groupid=b.groupid\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.`status`='Active'\r\n\t\tGROUP BY a.id\r\n\t) a\r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\ta.smownerid,\r\n\t\t\tSUM(b.costtime) AS jiaban\r\n\t\tFROM ld_addjobbill a\r\n\t\tLEFT JOIN ld_addjobbilldetail b ON a.addjobbillid=b.id\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND IFNULL(a.approvestatus,'')<>'已拒绝'\r\n\t\t\tAND (CASE WHEN '{shenpi}'='false' THEN 1=1 ELSE a.approvestatus='已批准' END)\r\n\t\t\tAND YEAR(b.starttime)='{nian}' \r\n\t\t\tAND MONTH(b.starttime)='{yue}'\r\n\t\tGROUP BY a.smownerid\r\n\t) b ON b.smownerid=a.id\r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\tsmownerid,\r\n\t\t\tSUM(nianjia) AS nianjia,\r\n\t\t\tSUM(tiaoxiu) AS tiaoxiu,\r\n\t\t\tSUM(shijia) AS shijia,\r\n\t\t\tSUM(qita) AS qita,\r\n\t\t\tSUM(chidaozaotui) AS chidaozaotui,\r\n\t\t\tSUM(baozhong) AS baozhong\r\n\t\tFROM (\r\n\t\tSELECT\r\n\t\t\ta.smownerid,\r\n\t\t\tCASE \r\n\t\t\t\tWHEN b.minusjobtype='年假' THEN b.costtime\r\n\t\t\t\tELSE 0\r\n\t\t\tEND AS nianjia,\r\n\t\t\tCASE \r\n\t\t\t\tWHEN b.minusjobtype='调休' THEN b.costtime\r\n\t\t\t\tELSE 0\r\n\t\t\tEND AS tiaoxiu,\r\n\t\t\tCASE \r\n\t\t\t\tWHEN b.minusjobtype='事假' THEN b.costtime\r\n\t\t\t\tELSE 0\r\n\t\t\tEND AS shijia,\r\n\t\t\tCASE \r\n\t\t\t\tWHEN b.minusjobtype NOT IN ('年假','调休','事假','迟到','早退','特殊报钟') THEN b.costtime\r\n\t\t\t\tELSE 0\r\n\t\t\tEND AS qita,\r\n\t\t\tCASE \r\n\t\t\t\tWHEN b.minusjobtype IN ('迟到','早退') THEN 1 \r\n\t\t\t\tELSE 0\r\n\t\t\tEND AS chidaozaotui,\r\n\t\t\tCASE \r\n\t\t\t\tWHEN b.minusjobtype='特殊报钟' THEN 1 \r\n\t\t\t\tELSE 0\r\n\t\t\tEND AS baozhong\r\n\t\tFROM ld_minusjobbill a\r\n\t\tLEFT JOIN ld_minusjobbilldetail b ON a.minusjobbillid=b.id\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND IFNULL(a.approvestatus,'')<>'已拒绝' \r\n\t\t\tAND (CASE WHEN '{shenpi}'='false' THEN 1=1 ELSE a.approvestatus='已批准' END)\r\n\t\t\tAND YEAR(b.starttime)='{nian}' \r\n\t\t\tAND MONTH(b.starttime)='{yue}' \r\n\t\t) a\r\n\t\tGROUP BY a.smownerid\r\n\t) c ON c.smownerid=a.id\r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\ta.smownerid,\r\n\t\t\tSUM(b.costtime) AS jiaban\r\n\t\tFROM ld_addjobbill a\r\n\t\tLEFT JOIN ld_addjobbilldetail b ON a.addjobbillid=b.id\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND IFNULL(a.approvestatus,'')<>'已拒绝'\r\n\t\t\tAND (CASE WHEN '{shenpi}'='false' THEN 1=1 ELSE a.approvestatus='已批准' END)\r\n\t\t\tAND DATE_FORMAT(b.starttime,'%Y-%m-%d')<= LAST_DAY(CONCAT('{nian}','-','{yue}','-1'))\r\n\t\tGROUP BY a.smownerid\r\n\t) d ON d.smownerid=a.id\r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\ta.smownerid,\r\n\t\t\tSUM(b.costtime) AS tiaoxiu\r\n\t\tFROM ld_minusjobbill a\r\n\t\tLEFT JOIN ld_minusjobbilldetail b ON a.minusjobbillid=b.id\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND IFNULL(a.approvestatus,'')<>'已拒绝' \r\n\t\t\tAND b.minusjobtype='调休'\r\n\t\t\tAND (CASE WHEN '{shenpi}'='false' THEN 1=1 ELSE a.approvestatus='已批准' END)\r\n\t\t\tAND DATE_FORMAT(b.starttime,'%Y-%m-%d')<= LAST_DAY(CONCAT('{nian}','-','{yue}','-1'))\r\n\t\tGROUP BY a.smownerid\r\n\t) e ON e.smownerid=a.id\r\n) tmp\r\nWHERE 1=1\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{data_range}'='' THEN\r\n\t\t\t\tFIND_IN_SET(id,(\r\n\t\t\t\t\tSELECT\r\n\t\t\t\t\t\tGROUP_CONCAT(a.id)\r\n\t\t\t\t\tFROM ld_users a\r\n\t\t\t\t\tINNER JOIN (\r\n\t\t\t\t\t\tSELECT DISTINCT\r\n\t\t\t\t\t\t\tuserid \r\n\t\t\t\t\t\tFROM (\r\n\t\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\t\tld_users.id AS userid \r\n\t\t\t\t\t\t\tFROM ld_users\r\n\t\t\t\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='ReportAnalysis' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\t\t\t\t\tUNION\r\n\t\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\t\tviewid AS userid \r\n\t\t\t\t\t\t\tFROM ld_scoperhigher\r\n\t\t\t\t\t\t\tWHERE userid='[uuid]' AND modulename='ReportAnalysis' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename='ReportAnalysis')\t\t\t\r\n\t\t\t\t\t\t\tUNION\r\n\t\t\t\t\t\t\tSELECT DISTINCT \r\n\t\t\t\t\t\t\t\tld_users2group.userid AS userid \r\n\t\t\t\t\t\t\tFROM ld_scoperhigher \r\n\t\t\t\t\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\t\t\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\t\t\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\t\t\t\t\tAND ld_scoperhigher.modulename='ReportAnalysis'\r\n\t\t\t\t\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\t\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='ReportAnalysis' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\t\t\t\t\tUNION \r\n\t\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\t\tid AS userid \r\n\t\t\t\t\t\t\tFROM ld_users  \r\n\t\t\t\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\t\t\t\t\tUNION\r\n\t\t\t\t\t\t\tSELECT '[uuid]') AS vw_users\r\n\t\t\t\t\t) AS tmp_users ON tmp_users.userid=a.id\r\n\t\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\t\tAND a.`status`='Active'\r\n\t\t\t\t))\r\n\t\t\tELSE FIND_IN_SET(id,'{data_range}')\r\n\t\tEND)\r\nORDER BY CONVERT(last_name USING GBK)"
      },
      "4": {
        "Ident": "StiMySqlSource",
