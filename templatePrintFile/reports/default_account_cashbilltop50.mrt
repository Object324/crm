        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\ta.report_title,\r\n\tg.custname,\r\n\tCONCAT(IFNULL(c.tabname,''),IFNULL(b.billowner,'')) AS billowner,\r\n\td.cashbill_no,\r\n\te.cashbilldate,\r\n\tf.paymentmethod\r\nFROM (\r\n\tSELECT \r\n\t\t1 AS id,\r\n\t\tb.fieldlabel AS report_title\r\n\tFROM ld_field a\r\n\tLEFT JOIN ld_tranlabel b ON b.trantable='ld_field' AND b.languagetype='zh' AND b.Relateid=a.fieldid\r\n\tWHERE a.tabid=6 \r\n\t\tAND a.columnname='accountname'\r\n\tLIMIT 1\r\n) a\r\nLEFT JOIN (\r\n\tSELECT \r\n\t\t1 AS id,\r\n\t\tb.fieldlabel AS custname\r\n\tFROM ld_field a\r\n\tLEFT JOIN ld_tranlabel b ON b.trantable='ld_field' AND b.languagetype='zh' AND b.Relateid=a.fieldid\r\n\tWHERE a.tablename='ld_cashbill'\r\n\t\tAND a.columnname='accountid'\r\n\tLIMIT 1\r\n) g ON a.id=g.id\r\nLEFT JOIN (\r\n\tSELECT \r\n\t\t1 AS id,\r\n\t\tb.fieldlabel AS billowner\r\n\tFROM ld_field a\r\n\tLEFT JOIN ld_tranlabel b ON b.trantable='ld_field' AND b.languagetype='zh' AND b.Relateid=a.fieldid\r\n\tWHERE a.tablename='ld_cashbill'\r\n\t\tAND a.columnname='smownerid'\r\n\tLIMIT 1\r\n) b ON a.id=b.id\r\nLEFT JOIN (\r\n\tSELECT \r\n\t\t1 AS id,\r\n\t\tb.fieldlabel AS tabname\r\n\tFROM ld_tab a\r\n\tLEFT JOIN ld_tranlabel b ON b.trantable='ld_tab' AND b.languagetype='zh' AND b.Relateid=a.tabid\r\n\tWHERE a.`name`='CashBill'\r\n\tLIMIT 1\r\n) c ON a.id=c.id\r\nLEFT JOIN (\r\n\tSELECT \r\n\t\t1 AS id,\r\n\t\tb.fieldlabel AS cashbill_no\r\n\tFROM ld_field a\r\n\tLEFT JOIN ld_tranlabel b ON b.trantable='ld_field' AND b.languagetype='zh' AND b.Relateid=a.fieldid\r\n\tWHERE a.tablename='ld_cashbill'\r\n\t\tAND a.columnname='cashbill_no'\r\n\tLIMIT 1\r\n) d ON a.id=d.id\r\nLEFT JOIN (\r\n\tSELECT \r\n\t\t1 AS id,\r\n\t\tb.fieldlabel AS cashbilldate\r\n\tFROM ld_field a\r\n\tLEFT JOIN ld_tranlabel b ON b.trantable='ld_field' AND b.languagetype='zh' AND b.Relateid=a.fieldid\r\n\tWHERE a.tablename='ld_cashbill'\r\n\t\tAND a.columnname='cashbilldate'\r\n\tLIMIT 1\r\n) e ON a.id=e.id\r\nLEFT JOIN (\r\n\t\tSELECT \r\n\t\t1 AS id,\r\n\t\tb.fieldlabel AS paymentmethod\r\n\tFROM ld_field a\r\n\tLEFT JOIN ld_tranlabel b ON b.trantable='ld_field' AND b.languagetype='zh' AND b.Relateid=a.fieldid\r\n\tWHERE a.tablename='ld_cashbill'\r\n\t\tAND a.columnname='paymentmethod'\r\n\tLIMIT 1\r\n) f ON a.id=f.id\r\n"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "details",
