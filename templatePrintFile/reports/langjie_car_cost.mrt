        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\tCONCAT(RIGHT('{nian}',2),'年合计') AS title,\r\n\tkemu,\r\n\tCASE WHEN DV699=0 THEN NULL ELSE DV699 END AS DV699,\r\n\tCASE WHEN AV972=0 THEN NULL ELSE AV972 END AS AV972,\r\n\tCASE WHEN EB231=0 THEN NULL ELSE EB231 END AS EB231,\r\n\tCASE WHEN Y0890=0 THEN NULL ELSE Y0890 END AS Y0890,\r\n\tCASE WHEN 4Q9D5=0 THEN NULL ELSE 4Q9D5 END AS 4Q9D5,\r\n\tCASE WHEN 8V3M0=0 THEN NULL ELSE 8V3M0 END AS 8V3M0,\r\n\tCASE WHEN L653G9=0 THEN NULL ELSE L653G9 END AS L653G9,\r\n\tCASE WHEN 3S6S0=0 THEN NULL ELSE 3S6S0 END AS 3S6S0,\r\n\tCASE WHEN total=0 THEN NULL ELSE total END AS total\r\nFROM (\r\nSELECT\r\n\ta.sequence,\r\n\ta.list_value AS kemu,\r\n\tROUND(b.DV699,0) AS DV699,\r\n\tROUND(b.AV972,0) AS AV972,\r\n\tROUND(b.EB231,0) AS EB231,\r\n\tROUND(b.Y0890,0) AS Y0890,\r\n\tROUND(b.4Q9D5,0) AS 4Q9D5,\r\n\tROUND(b.8V3M0,0) AS 8V3M0,\r\n\tROUND(b.L653G9,0) AS L653G9,\r\n\tROUND(b.3S6S0,0) AS 3S6S0,\r\n\tROUND(IFNULL(b.DV699,0),0)+ROUND(IFNULL(b.AV972,0),0)+ROUND(IFNULL(b.EB231,0),0)+ROUND(IFNULL(b.Y0890,0),0)\r\n\t\t+ROUND(IFNULL(b.4Q9D5,0),0)+ROUND(IFNULL(b.8V3M0,0),0)+ROUND(IFNULL(b.L653G9,0),0)+ROUND(IFNULL(b.3S6S0,0),0) AS total\r\nFROM (\r\n\tSELECT '维修保养费' AS list_value,-2 AS sequence\r\n\tUNION\r\n\tSELECT '燃油费' AS list_value,-1 AS sequence\r\n\tUNION\r\n\tSELECT listvalue,sequence FROM ld_picklist_values WHERE listid=82\r\n) a \r\nLEFT JOIN (\r\n\tSELECT\r\n\t\tkemu,\r\n\t\tSUM(DV699) AS DV699,\r\n\t\tSUM(AV972) AS AV972,\r\n\t\tSUM(EB231) AS EB231,\r\n\t\tSUM(Y0890) AS Y0890,\r\n\t\tSUM(4Q9D5) AS 4Q9D5,\r\n\t\tSUM(8V3M0) AS 8V3M0,\r\n\t\tSUM(L653G9) AS L653G9,\r\n\t\tSUM(3S6S0) AS 3S6S0\r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\tb.kemu,\r\n\t\t\tCASE\r\n\t\t\t\tWHEN a.projectname='DV699' THEN b.fee\r\n\t\t\t\tELSE 0\r\n\t\t\tEND AS DV699,\r\n\t\t\tCASE\r\n\t\t\t\tWHEN a.projectname='AV972' THEN b.fee\r\n\t\t\t\tELSE 0\r\n\t\t\tEND AS AV972,\r\n\t\t\tCASE\r\n\t\t\t\tWHEN a.projectname='EB231' THEN b.fee\r\n\t\t\t\tELSE 0\r\n\t\t\tEND AS EB231,\r\n\t\t\tCASE\r\n\t\t\t\tWHEN a.projectname='Y0890' THEN b.fee\r\n\t\t\t\tELSE 0\r\n\t\t\tEND AS Y0890,\r\n\t\t\tCASE\r\n\t\t\t\tWHEN a.projectname='4Q9D5' THEN b.fee\r\n\t\t\t\tELSE 0\r\n\t\t\tEND AS 4Q9D5,\r\n\t\t\tCASE\r\n\t\t\t\tWHEN a.projectname='8V3M0' THEN b.fee\r\n\t\t\t\tELSE 0\r\n\t\t\tEND AS 8V3M0,\r\n\t\t\tCASE\r\n\t\t\t\tWHEN a.projectname='L653G9' THEN b.fee\r\n\t\t\t\tELSE 0\r\n\t\t\tEND AS L653G9,\r\n\t\t\tCASE\r\n\t\t\t\tWHEN a.projectname='3S6S0' THEN b.fee\r\n\t\t\t\tELSE 0\r\n\t\t\tEND AS 3S6S0\r\n\t\tFROM ld_project a\r\n\t\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\t'燃油费' AS kemu,\r\n\t\t\ta.projectid,\r\n\t\t\tDATE_FORMAT(a.startdate,'%b-%y') AS riqi,\r\n\t\t\tSUM(IFNULL(b.cf_2980,0)) AS fee\r\n\t\tFROM ld_projectprogress a\r\n\t\tLEFT JOIN ld_projectprogresscf b ON b.projectprogressid=a.projectprogressid\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.projectid>0\r\n\t\t\tAND YEAR(a.startdate)='{nian}'\r\n\t\tGROUP BY a.projectid\r\n\t\tUNION ALL\r\n\t\tSELECT\r\n\t\t\t'维修保养费' AS kemu,\r\n\t\t\ta.projectid,\r\n\t\t\tDATE_FORMAT(a.startdate,'%b-%y') AS riqi,\r\n\t\t\tSUM(IFNULL(b.cf_2970,0)+IFNULL(b.cf_2969,0)) AS fee\r\n\t\tFROM ld_projecttask a\r\n\t\tLEFT JOIN ld_projecttaskcf b ON b.projecttaskid=a.projecttaskid\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.projectid>0\r\n\t\t\tAND YEAR(a.startdate)='{nian}'\r\n\t\tGROUP BY a.projectid\r\n\t\tUNION ALL\r\n\t\tSELECT\r\n\t\t\tb.expensetype AS kemu,\r\n\t\t\tb.entitytypeid AS projectid,\r\n\t\t\tDATE_FORMAT(b.startdate,'%b-%y') AS riqi,\r\n\t\t\tSUM(IFNULL(c.rmb_total,0)) AS fee\r\n\t\tFROM ld_expense a\r\n\t\tLEFT JOIN ld_expensedetail b ON b.expenseid=a.expenseid\r\n\t\tLEFT JOIN ld_expensedetailscf c ON c.expensedetailid=b.expensedetailid\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND b.entitytype='Project'\r\n\t\t\tAND b.entitytypeid>0\r\n\t\t\tAND YEAR(b.startdate)='{nian}'\r\n\t\tGROUP BY b.entitytypeid,b.expensetype\r\n\t\t) b ON b.projectid=a.projectid\r\n\t\tWHERE a.deleted=0\r\n\t) a\r\n\tGROUP BY kemu\r\n) b ON b.kemu=a.list_value\r\n) tmp\r\nORDER BY sequence"
      },
