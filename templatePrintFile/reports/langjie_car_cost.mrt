        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\ta.projectname AS chart_type,\r\n\tROUND(IFNULL(b.fee,0),0) AS char_value,\r\n\tCONCAT(a.projectname,' - ',FORMAT(IFNULL(b.fee,0),0),' - ',ROUND(ROUND(IFNULL(b.fee,0),0)*100/c.total,0),'%') AS mytag\r\nFROM ld_project a\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\tprojectid,\r\n\t\tSUM(fee) AS fee\r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\t'燃油费' AS kemu,\r\n\t\t\ta.projectid,\r\n\t\t\tSUM(IFNULL(b.cf_2980,0)) AS fee\r\n\t\tFROM ld_projectprogress a\r\n\t\tLEFT JOIN ld_projectprogresscf b ON b.projectprogressid=a.projectprogressid\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.projectid>0\r\n\t\t\tAND YEAR(a.startdate)='{nian}'\r\n\t\tGROUP BY a.projectid\r\n\t\tUNION ALL\r\n\t\tSELECT\r\n\t\t\t'维修保养费' AS kemu,\r\n\t\t\ta.projectid,\r\n\t\t\tSUM(IFNULL(b.cf_2970,0)+IFNULL(b.cf_2969,0)) AS fee\r\n\t\tFROM ld_projecttask a\r\n\t\tLEFT JOIN ld_projecttaskcf b ON b.projecttaskid=a.projecttaskid\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.projectid>0\r\n\t\t\tAND YEAR(a.startdate)='{nian}'\r\n\t\tGROUP BY a.projectid\r\n\t\tUNION ALL\r\n\t\tSELECT\r\n\t\t\tb.expensetype AS kemu,\r\n\t\t\tb.entitytypeid AS projectid,\r\n\t\t\tSUM(IFNULL(c.rmb_total,0)) AS fee\r\n\t\tFROM ld_expense a\r\n\t\tLEFT JOIN ld_expensedetail b ON b.expenseid=a.expenseid\r\n\t\tLEFT JOIN ld_expensedetailscf c ON c.expensedetailid=b.expensedetailid\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND b.entitytype='Project'\r\n\t\t\tAND b.entitytypeid>0\r\n\t\t\tAND YEAR(b.startdate)='{nian}'\r\n\t\tGROUP BY b.entitytypeid,b.expensetype\r\n\t) a\r\n\tGROUP BY projectid\r\n) b ON b.projectid=a.projectid\r\nINNER JOIN (\r\n\tSELECT\r\n\t\tSUM(ROUND(IFNULL(fee,0),0)) AS total\r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\tprojectid,\r\n\t\t\tSUM(fee) AS fee\r\n\t\tFROM (\r\n\t\t\tSELECT\r\n\t\t\t\t'燃油费' AS kemu,\r\n\t\t\t\ta.projectid,\r\n\t\t\t\tSUM(IFNULL(b.cf_2980,0)) AS fee\r\n\t\t\tFROM ld_projectprogress a\r\n\t\t\tLEFT JOIN ld_projectprogresscf b ON b.projectprogressid=a.projectprogressid\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.projectid>0\r\n\t\t\t\tAND YEAR(a.startdate)='{nian}'\r\n\t\t\tGROUP BY a.projectid\r\n\t\t\tUNION ALL\r\n\t\t\tSELECT\r\n\t\t\t\t'维修保养费' AS kemu,\r\n\t\t\t\ta.projectid,\r\n\t\t\t\tSUM(IFNULL(b.cf_2970,0)+IFNULL(b.cf_2969,0)) AS fee\r\n\t\t\tFROM ld_projecttask a\r\n\t\t\tLEFT JOIN ld_projecttaskcf b ON b.projecttaskid=a.projecttaskid\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.projectid>0\r\n\t\t\t\tAND YEAR(a.startdate)='{nian}'\r\n\t\t\tGROUP BY a.projectid\r\n\t\t\tUNION ALL\r\n\t\t\tSELECT\r\n\t\t\t\tb.expensetype AS kemu,\r\n\t\t\t\tb.entitytypeid AS projectid,\r\n\t\t\t\tSUM(IFNULL(c.rmb_total,0)) AS fee\r\n\t\t\tFROM ld_expense a\r\n\t\t\tLEFT JOIN ld_expensedetail b ON b.expenseid=a.expenseid\r\n\t\t\tLEFT JOIN ld_expensedetailscf c ON c.expensedetailid=b.expensedetailid\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND b.entitytype='Project'\r\n\t\t\t\tAND b.entitytypeid>0\r\n\t\t\t\tAND YEAR(b.startdate)='{nian}'\r\n\t\t\tGROUP BY b.entitytypeid,b.expensetype\r\n\t\t) a\r\n\t\tGROUP BY projectid\r\n\t) t\r\n) c ON 1=1\r\nWHERE a.deleted=0\r\nORDER BY a.projectname"
      },
      "3": {
        "Ident": "StiMySqlSource",
