        "NameInSource": "crm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\ta.productid,\r\n\ta.productname,\r\n\tb.projectid,\r\n\tb.projectname,\r\n\tb.project_no,\r\n\tb.smownerid,\r\n\tb.last_name,\r\n\tb.budget_total,\r\n\tb.purchase_total,\r\n\tifnull(b.budget_total, 0) - ifnull(b.purchase_total, 0) AS non_total,\r\n\tcostprice,\r\n\tcf_3967,\r\n\tbudget_quantity,\r\n\tpurchase_quantity,\r\n\t(\r\n\t\tbudget_quantity - purchase_quantity\r\n\t) AS non_quantity,\r\n\tbudget_amount,\r\n\tpurchase_amount,\r\n\t(\r\n\t\tbudget_amount - purchase_amount\r\n\t) AS non_amount,\r\nshould_refund_quantity,should_refund_amount,\r\n\trefund_quantity,refund_amount\r\nFROM\r\n\t(\r\n\t\tSELECT\r\n\t\ta.*, ifnull(b.purchase_quantity, 0) AS purchase_quantity,\r\n\t\tifnull(b.purchase_amount, 0) AS purchase_amount,\r\n\t\tifnull(c.should_refund_quantity, 0)as should_refund_quantity,\r\n\t\tifnull(c.should_refund_amount, 0)as should_refund_amount,\r\n\t\tifnull(d.refund_quantity, 0)as refund_quantity,\r\n\t\tifnull(d.refund_amount, 0)as refund_amount\r\n\tFROM\r\n\t\t(\r\n\t\t\tSELECT\r\n\t\t\t\ta.productid,\r\n\t\t\t\tb.productname,\r\n\t\t\t\tb.costprice,\r\n\t\t\t\tc.cf_3967,\r\n\t\t\t\tconcat(d.projectid,'-', a.productid) AS dol,\r\n\t\t\t\ta.quantity AS budget_quantity,\r\n\t\t\t\td.projectid,\r\n\t\t\t\tsum(ifnull(a.tax_amount,0)) AS budget_amount\r\n\t\t\tFROM\r\n\t\t\t\tld_customform14detail a\r\n\t\t\tLEFT JOIN ld_products b ON a.productid = b.productid\r\n\t\t\tLEFT JOIN ld_productcf c ON a.productid = c.productid\r\n\t\t\tLEFT JOIN ld_customform14 d ON a.id = d.customform14id\r\n\t\t\tWHERE\r\n\t\t\t\t(\r\n\t\t\t\t\ta.productid IS NOT NULL\r\n\t\t\t\t\tOR d.projectid IS NOT NULL\r\n\t\t\t\t)\r\n\t\t\t\r\n\t\t\tAND (\r\n\t\t\t\tCASE WHEN '{form14_type}'='' THEN 1=1 \r\n\t\t\t\tELSE FIND_IN_SET(d.form14_type,'{form14_type}')\r\n\t\t\t\tEND\r\n\t\t\t) \r\n\t\t\tAND b.deleted = 0\r\n\t\t\tAND d.deleted = 0\r\n\t\t\tGROUP BY\r\n\t\t\ta.productid,\r\n\t\t\td.projectid\r\n\t\t\t\t\r\n\t\t) a\r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\ta.productid,\r\n\t\t\td.projectid,\r\n\t\t\tconcat(d.projectid,'-', a.productid) AS dol,\r\n\t\t\tsum(ifnull(a.quantity,0)) AS purchase_quantity,\r\n\t\t\tsum(ifnull(a.tax_amount,0)) AS purchase_amount\r\n\t\tFROM\r\n\t\t\tld_purchaseorderdetail  a\r\n\t\tLEFT JOIN ld_products b ON a.productid = b.productid \r\n\t\tLEFT JOIN ld_productcf c ON a.productid = c.productid\r\n\t\tLEFT JOIN ld_purchaseorder d ON a.id = d.purchaseorderid\r\n\t\tWHERE\r\n\t\t\t(\r\n\t\t\t\ta.productid IS NOT NULL\r\n\t\t\t\tOR d.projectid IS NOT NULL\r\n\t\t\t)\r\n\t\tAND b.deleted = 0\r\n\t\tAND d.deleted = 0 \r\n\t\tGROUP BY\r\n\t\t\ta.productid,\r\n\t\t\td.projectid\r\n\t) b ON a.dol = b.dol\r\n\tleft join (\r\n\t\tSELECT\r\n\t\t\ta.productid,\r\n\t\t\te.projectid,\r\n\t\t\tconcat(e.projectid,'-', a.productid) AS dol,\r\n\t\t\tsum(ifnull(a.quantity,0)) AS should_refund_quantity,\r\n\t\t\tsum(ifnull(a.tax_amount,0)) AS should_refund_amount\r\n\t\tFROM\r\n\t\t\tld_purchasebackdetail  a\r\n\t\tLEFT JOIN ld_products b ON a.productid = b.productid \r\n\t\tLEFT JOIN ld_productcf c ON a.productid = c.productid\r\n\t\tLEFT JOIN ld_purchaseback d ON a.id = d.purchasebackid\r\n\t\tleft join ld_purchaseorder e on e.purchaseorderid=d.purchaseorder_id\r\n\t\tWHERE\r\n\t\t\t(\r\n\t\t\t\ta.productid IS NOT NULL\r\n\t\t\t\tOR e.projectid IS NOT NULL\r\n\t\t\t)\r\n\t\tAND b.deleted = 0\r\n\t\tAND e.deleted = 0  \r\n\t\tGROUP BY\r\n\t\t\ta.productid,\r\n\t\t\te.projectid\r\n\t)\tc on a.dol=c.dol\r\n\tleft join (\r\n\t\tSELECT\r\n\t\t\ta.productid,\r\n\t\t\tf.projectid,\r\n\t\t\tconcat(f.projectid,'-', a.productid) AS dol,\r\n\t\t\tsum(ifnull(a.quantity,0)) AS refund_quantity,\r\n\t\t\tsum(ifnull(a.tax_amount,0)) AS refund_amount\r\n\t\tFROM\r\n\t\t\tld_purchasecashbackdetail  a\r\n\t\tLEFT JOIN ld_products b ON a.productid = b.productid \r\n\t\tLEFT JOIN ld_productcf c ON a.productid = c.productid\r\n\t\tLEFT JOIN ld_purchasecashback d ON a.id = d.purchasecashbackid\r\n\t\tLEFT JOIN ld_purchaseback e ON d.purchaseback_id = e.purchasebackid\r\n\t\tleft join ld_purchaseorder f on f.purchaseorderid=e.purchaseorder_id\r\n\t\tWHERE\r\n\t\t\t(\r\n\t\t\t\ta.productid IS NOT NULL\r\n\t\t\t\tOR f.projectid IS NOT NULL\r\n\t\t\t)\r\n\t\tAND b.deleted = 0\r\n\t\tAND f.deleted = 0  \r\n\t\tGROUP BY\r\n\t\t\ta.productid,\r\n\t\t\tf.projectid\r\n\t)d on a.dol=d.dol\r\n) a\r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\ta.*, b.purchase_total\r\n\t\tFROM\r\n\t\t\t(\r\n\t\t\t\tSELECT\r\n\t\t\t\t\ta.projectid,\r\n\t\t\t\t\tb.projectname,\r\n\t\t\t\t\tb.project_no,\r\n\t\t\t\t\tb.smownerid,\r\n\t\t\t\t\tu.last_name,\r\n\t\t\t\t\tsum(\r\n\t\t\t\t\t\tifnull(adetail.tax_amount, 0)\r\n\t\t\t\t\t) AS budget_total\r\n\t\t\t\tFROM\r\n\t\t\t\t\tld_customform14  a\r\n\t\t\t\tLEFT JOIN ld_users u ON u.id = a.smownerid\r\n\t\t\t\tLEFT JOIN  ld_project b ON a.projectid = b.projectid\r\n\t\t\t\tLEFT JOIN ld_customform14detail adetail ON a.customform14id = adetail.id\r\n\t\t\t\tWHERE\r\n\t\t\t\t\ta.deleted = 0\r\n\t\t\t\tAND b.createdtime >='{starttime}' and b.createdtime <='{endtime}'\r\n\t\t\t\tAND b.projectname like '%{projectname}%'\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE WHEN '{form14_type}'='' THEN 1=1 \r\n\t\t\t\t\tELSE FIND_IN_SET(a.form14_type,'{form14_type}')\r\n\t\t\t\t\tEND\r\n\t\t\t\t) \r\n\t\t\t\tAND b.deleted = 0\r\n\t\t\t\tGROUP BY\r\n\t\t\t\t\ta.projectid\r\n\t\t\t) a\r\n\t\tLEFT JOIN (\r\n\t\t\tSELECT\r\n\t\t\t\ta.projectid,\r\n\t\t\t\tsum(\r\n\t\t\t\t\tifnull(adetail.tax_amount, 0)\r\n\t\t\t\t) AS purchase_total\r\n\t\t\tFROM\r\n\t\t\t\tld_purchaseorder  a\r\n\t\t\tLEFT JOIN  ld_project b ON a.projectid = b.projectid\r\n\t\t\tLEFT JOIN ld_purchaseorderdetail adetail ON a.purchaseorderid = adetail.id\r\n\t\t\tWHERE\r\n\t\t\t\ta.deleted = 0 \r\n\t\t\tAND b.createdtime >='{starttime}' and b.createdtime <='{endtime}'\r\n\t\t\tAND b.projectname like '%{projectname}%'\r\n\t\t\tAND b.deleted = 0 AND a.entitytype='CustomForm14'\r\n\t\t\tGROUP BY\r\n\t\t\t\ta.projectid\r\n\t\t) b ON a.projectid = b.projectid\r\n) b ON b.projectid = a.projectid\r\nwhere b.projectid is not null and b.projectid>0\r\nGROUP BY  b.projectid,a.productid\r\n\r\n\r\n"
      },
