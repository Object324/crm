        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\t\t\t\ta.customform14_no,a.form14_type,p.projectname,\r\n\t\t\t\td.productid,\r\n\t\t\t\tb.productname,\r\n\t\t\t\tb.costprice,\r\n\t\t\t\tc.cf_3967,\r\n\t\t\t\td.quantity,d.tax_amount,\r\n\t\t\t\ta.projectid,\r\n\t\t\t\ta.total,a.modifiedtime\r\n\t\t\tFROM\r\n\t\t\tld_customform14 a\r\n\t\t\t\r\n\t\t\tLEFT JOIN ld_customform14detail d ON d.id = a.customform14id\r\n\t\t\tLEFT JOIN ld_products b ON d.productid = b.productid\r\n\t\t\tLEFT JOIN ld_productcf c ON d.productid = c.productid\r\n\t\t\tLEFT JOIN ld_project p on p.projectid=a.projectid\r\n\t\t\tWHERE\r\n\t\t\t\t(\r\n\t\t\t\t\td.productid IS NOT NULL\r\n\t\t\t\t\tOR a.projectid IS NOT NULL\r\n\t\t\t\t)\r\n\t\t\tAND (\r\n\t\t\t\tCASE WHEN '{form14_type}'='{form14_type}' THEN 1=1 \r\n\t\t\t\tELSE FIND_IN_SET(a.form14_type,'{form14_type}')\r\n\t\t\t\tEND\r\n\t\t\t)  \r\n\t\t\tAND b.deleted = 0\r\n\t\t\tAND a.deleted = 0\r\n\t\t\tAND p.projectid='{this[\"projectid\"]}'\r\n\t\t\tGROUP BY\r\n\t\t\td.productid,\r\n\t\t\ta.projectid;\r\n\r\n\r\n\r\n"
      },
