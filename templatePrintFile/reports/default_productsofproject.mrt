          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\ta.*, p.projectname,\r\n\tv.vendorname,\r\n\tu.last_name\r\nFROM\r\n\tld_purchaseorder a\r\nLEFT JOIN ld_project p ON a.projectid = p.projectid\r\nLEFT JOIN ld_vendor v ON v.vendorid = a.vendorid\r\nLEFT JOIN ld_users u ON u.id = a.smownerid\r\nWHERE\r\n\ta.projectid IS NOT NULL\r\nAND p.deleted = 0\r\nAND a.deleted = 0\r\nAND a.entitytype = 'CustomForm14'\r\nAND p.projectid = '{this[\"projectid\"]}'"
      }
    },
