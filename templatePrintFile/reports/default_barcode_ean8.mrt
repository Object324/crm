          "1": {
            "Name": "productname",
            "Index": -1,
            "NameInSource": "productname",
            "Alias": "productname",
            "Type": "System.String"
          }
        },
        "NameInSource": "crm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\ta.productname,\r\n\ta.productcode\r\nFROM ld_products a\r\nWHERE a.deleted=0\r\n\tAND a.approvestatus<>'已拒绝'\r\n\tAND a.productcode REGEXP '(^[0-9])'\r\n\tAND LENGTH(a.productcode)=8\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN TRIM('{pname}')='' THEN 1=1\r\n\t\t\tELSE LOCATE(TRIM('{pname}'),a.productname)>0\r\n\t\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN TRIM('{pcode}')='' THEN 1=1\r\n\t\t\tELSE LOCATE(TRIM('{pcode}'),a.productcode)>0\r\n\t\tEND) "
      }
    },
