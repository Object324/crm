            "Type": "System.String"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\tu.id,\r\n\tu.user_no,\r\n\tCONCAT(IFNULL(u.user_no,''),'-',u.last_name) AS xingming\r\nFROM (SELECT DISTINCT user_name FROM ld_customform04 WHERE deleted=0) a\r\nINNER JOIN ld_users u ON u.user_name=a.user_name\r\nINNER JOIN (SELECT DISTINCT approved_by FROM ld_approvelog WHERE approveid IN (3,152,153,154,155) AND approved_by>0 AND stepid<>-1) v ON v.approved_by=u.id\r\nWHERE u.deleted=0"
      },
