        },
        "NameInSource": "crm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\tu.user_no AS shenpirenno,\r\n\tu.last_name AS shenpiren,\r\n\tl.createdtime AS approvetime,\r\n\ta.specialoffer_no,\r\n\ta.quote_version,\r\n\ta.zhekou,\r\n\tROUND(a.total,2) AS total,\r\n\ta.gcm,\r\n\ta.spe,\r\n\tb.cf_2918 AS projectname,\r\n\tb.cf_2919 AS industry,\r\n\ta.sales_area,\r\n\tb.cf_2920 AS city,\r\n\ta.banshichu,\r\n\tb.cf_2916 AS jindu,\r\n\ta.validfrom,\r\n\ta.validtill,\r\n\tb.cf_2927 AS jingxiaoshangno,\r\n\tjingxiaoshangname,\r\n\tb.cf_2928 AS shejiyuan,\r\n\tb.cf_2929 AS fazhanshang,\r\n\tb.cf_2930 AS panchang,\r\n\tb.cf_2936 AS KA,\r\n\tb.cf_2934 AS tuzhipinpai,\r\n\tb.cf_2935 AS shangturen,\r\n\tb.cf_2932 AS jungongdate,\r\n\tb.cf_2931 AS zhucedate,\r\n\tDATE_FORMAT(a.stock_date,'%Y-%m-%d') AS stock_date\r\nFROM ld_approvelog l\r\nLEFT JOIN ld_users u ON u.id=l.approved_by\r\nINNER JOIN (\r\n\tSELECT\r\n\t\tt.quoteid,\r\n\t\tt.quote_version,\r\n\t\tt.smownerid,\r\n\t\tt.createdtime,\r\n\t\tt.specialoffer_no,\r\n\t\tt.sales_area,\r\n\t\tt.banshichu,\r\n\t\tt.validfrom,\r\n\t\tt.validtill,\r\n\t\tt.accountid,\r\n\t\tt.stock_date,\r\n\t\tt.jingxiaoshangname,\r\n\t\tIFNULL(FORMAT(100-SUM(tax_amount)*100/SUM(quantity*IFNULL(due_price,0)),2),'') AS zhekou,\r\n\t\tSUM(tax_amount) AS total,\r\n\t\tIFNULL(CONCAT(FORMAT((1-SUM(gcm*quantity)/SUM(tax_amount))*100,2),'%'),'') AS gcm,\r\n\t\tIFNULL(CONCAT(FORMAT((SUM(tax_amount)/SUM(quantity*IFNULL(avge_price,0))-1)*100,2),'%'),'') AS spe \r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\tc.quoteid,\r\n\t\t\tc.quote_version,\r\n\t\t\tc.smownerid,\r\n\t\t\tc.createdtime,\r\n\t\t\tc.specialoffer_no,\r\n\t\t\tc.sales_area,\r\n\t\t\tc.banshichu,\r\n\t\t\tc.validfrom,\r\n\t\t\tc.validtill,\r\n\t\t\tc.accountid,\r\n\t\t\tc.stock_date,\r\n\t\t\tk.accountname AS jingxiaoshangname,\r\n\t\t\ta.quantity,\r\n\t\t\tIFNULL(b.productgroup_name,'') AS productgroup_name,\r\n\t\t\ta.tax_amount,\r\n\t\t\ta.taxprice,\r\n\t\t\tb.gcm_cost AS gcm,\r\n\t\t\t(\r\n\t\t\t\tSELECT \r\n\t\t\t\t\tq.listprice\r\n\t\t\t\tFROM ld_pricebook p\r\n\t\t\t\tLEFT JOIN ld_pricebookproductrel q ON q.pricebookid=p.pricebookid\r\n\t\t\t\tWHERE p.deleted=0 \r\n\t\t\t\t\tAND p.pricebook_type='标准价格表' \r\n\t\t\t\t\tAND DATE_FORMAT(c.createdtime,'%Y-%m-%d')<=p.validtill\r\n\t\t\t\t\tAND q.productid=a.productid\r\n\t\t\t\tORDER BY p.modifiedtime DESC LIMIT 1\r\n\t\t\t) AS due_price,\r\n\t\t\t(\r\n\t\t\t\tSELECT \r\n\t\t\t\t\tavge_price \r\n\t\t\t\tFROM ld_customform03 \r\n\t\t\t\tWHERE deleted=0 \r\n\t\t\t\t\tAND market_code=b.productname\r\n\t\t\t\t\tAND years=YEAR(c.createdtime)-1\r\n\t\t\t\tLIMIT 1\r\n\t\t\t) AS avge_price\r\n\t\tFROM ld_quotes c \r\n\t\tLEFT JOIN ld_quotescf d ON d.quoteid=c.quoteid\r\n\t\tLEFT JOIN ld_account k ON k.accountid=c.accountid\r\n\t\tLEFT JOIN ld_quotesdetail a ON a.id=c.quoteid\r\n\t\tLEFT JOIN ld_products b ON b.productid=a.productid\r\n\t\tINNER JOIN (\r\n\t\t\tSELECT\r\n\t\t\t\tcrmid\r\n\t\t\tFROM ld_approvelog\r\n\t\t\tWHERE createdtime BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_ADD(DATE_FORMAT('{end_date}','%Y-%m-%d'),INTERVAL 1 DAY)\r\n\t\t\tGROUP BY crmid\r\n\t\t) l ON l.crmid=c.quoteid\r\n\t\tWHERE c.deleted=0\r\n\t\t\tAND c.approvestatus<>'已拒绝'\r\n\t\t\tAND c.quotetype='特价报价单'\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN TRIM('{shenqinghao}')='' THEN 1=1\r\n\t\t\t\t\tELSE LOCATE('{shenqinghao}',c.specialoffer_no)>0\r\n\t\t\t\tEND)\r\n\t) t\r\n\tGROUP BY t.quoteid\r\n) a ON a.quoteid=l.crmid\r\nLEFT JOIN ld_quotescf b ON b.quoteid=l.crmid\r\nWHERE l.approveid IN (3,152,153,154,155)\r\n\tAND l.stepid>0\r\n\tAND l.approved_by>0\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{owner}'='' THEN 1=1\r\n\t\t\tELSE FIND_IN_SET(l.approved_by,'{owner}')\r\n\t\tEND)\r\n\tAND l.createdtime BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_ADD(DATE_FORMAT('{end_date}','%Y-%m-%d'),INTERVAL 1 DAY)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{ratefrom}'='NaN' THEN 1=1\r\n\t\t\tELSE a.zhekou+0>='{ratefrom}'+0\r\n\t\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{rateto}'='NaN' THEN 1=1\r\n\t\t\tELSE a.zhekou+0<='{rateto}'+0\r\n\t\tEND)\r\nORDER BY l.createdtime,l.id"
      }
    },
    "Databases": {
