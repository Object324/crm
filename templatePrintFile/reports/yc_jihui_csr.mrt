          },
          "98": {
            "Name": "ownerid_s2",
            "Index": -1,
            "NameInSource": "ownerid_s2",
            "Alias": "ownerid_s2",
            "Type": "System.Int32"
          },
          "99": {
            "Name": "ownerid_s3",
            "Index": -1,
            "NameInSource": "ownerid_s3",
            "Alias": "ownerid_s3",
            "Type": "System.Int32"
          },
          "100": {
            "Name": "ownerid_s4",
            "Index": -1,
            "NameInSource": "ownerid_s4",
            "Alias": "ownerid_s4",
            "Type": "System.Int32"
          }
        },
        "NameInSource": "crm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\t*\r\nFROM (\r\nSELECT\r\n\ts1.smownerid AS ownerid_s1,\r\n\ts2.smownerid AS ownerid_s2,\r\n\ts3.smownerid AS ownerid_s3,\r\n\ts4.smownerid AS ownerid_s4,\r\n\t(SELECT GROUP_CONCAT(DISTINCT viewuserid ORDER BY viewuserid) FROM ld_tabshare WHERE crmid=s1.billid OR crmid=s2.billid OR crmid=s3.billid OR crmid=s4.billid) AS 00_shareids,\r\n\tCASE WHEN t.sf11627='Y' THEN 'Y' ELSE '' END AS 01_mitem,\r\n\ts1.xm_no AS 02_no,\r\n\tCASE\r\n\t\tWHEN s4.xm_no IS NOT NULL THEN s4.xm_status\r\n\t\tWHEN s3.xm_no IS NOT NULL THEN 'S3'\r\n\t\tWHEN s2.xm_no IS NOT NULL THEN 'S2'\r\n\t\tELSE 'S1'\r\n\tEND AS 03_status,\r\n\tCASE\r\n\t\tWHEN s4.xm_no IS NOT NULL THEN 1\r\n\t\tWHEN s3.xm_no IS NOT NULL THEN 2\r\n\t\tWHEN s2.xm_no IS NOT NULL THEN 3\r\n\t\tELSE 4\r\n\tEND AS 03_status_seq,\r\n\tCASE\r\n\t\tWHEN s4.xm_no IS NOT NULL THEN 1\r\n\t\tWHEN s3.xm_no IS NOT NULL THEN 2\r\n\t\tWHEN s2.xm_no IS NOT NULL THEN 3\r\n\t\tELSE 4\r\n\tEND AS 03_ishuoyue,\r\n\tCASE\r\n\t\tWHEN s4.xm_no IS NOT NULL THEN s4.accountname\r\n\t\tWHEN s3.xm_no IS NOT NULL THEN s3.accountname\r\n\t\tWHEN s2.xm_no IS NOT NULL THEN s2.accountname\r\n\t\tELSE s1.accountname\r\n\tEND AS 04_kehu,\r\n\tCASE\r\n\t\tWHEN s4.xm_no IS NOT NULL THEN s4.xiangmuhao\r\n\t\tWHEN s3.xm_no IS NOT NULL THEN s3.xiangmuhao\r\n\t\tWHEN s2.xm_no IS NOT NULL THEN s2.xiangmuhao\r\n\t\tELSE s1.xiangmuhao\r\n\tEND AS 05_xiangmuhao,\r\n\tCASE\r\n\t\tWHEN s4.xm_no IS NOT NULL THEN s4.smowner\r\n\t\tWHEN s3.xm_no IS NOT NULL THEN s3.smowner\r\n\t\tWHEN s2.xm_no IS NOT NULL THEN s2.smowner\r\n\t\tELSE s1.smowner\r\n\tEND AS 06_fuzeren,\r\n\tCASE\r\n\t\tWHEN s4.xm_no IS NOT NULL THEN s4.team\r\n\t\tWHEN s3.xm_no IS NOT NULL THEN s3.team\r\n\t\tWHEN s2.xm_no IS NOT NULL THEN s2.team\r\n\t\tELSE s1.team\r\n\tEND AS 07_team,\r\n\tCASE\r\n\t\tWHEN s4.xm_no IS NOT NULL THEN s4.pro_amount\r\n\t\tWHEN s3.xm_no IS NOT NULL THEN s3.pro_amount\r\n\t\tWHEN s2.xm_no IS NOT NULL THEN s2.pro_amount\r\n\t\tELSE s1.pro_amount\r\n\tEND AS 08_pro_amount,\r\n\tCASE\r\n\t\tWHEN s4.xm_no IS NOT NULL THEN s4.pro_volume\r\n\t\tWHEN s3.xm_no IS NOT NULL THEN s3.pro_volume\r\n\t\tWHEN s2.xm_no IS NOT NULL THEN s2.pro_volume\r\n\t\tELSE s1.pro_volume\r\n\tEND AS 09_pro_volume,\r\n\tCASE\r\n\t\tWHEN s4.xm_no IS NOT NULL THEN s4.pingtaiA\r\n\t\tWHEN s3.xm_no IS NOT NULL THEN s3.pingtaiA\r\n\t\tWHEN s2.xm_no IS NOT NULL THEN s2.pingtaiA\r\n\t\tELSE s1.pingtaiA\r\n\tEND AS 10_pingtaiA,\r\n\r\n\r\n\tCASE\r\n\t\tWHEN s4.xm_no IS NOT NULL THEN s4.pingtaiB\r\n\t\tWHEN s3.xm_no IS NOT NULL THEN s3.pingtaiB\r\n\t\tWHEN s2.xm_no IS NOT NULL THEN s2.pingtaiB\r\n\t\tELSE s1.pingtaiB\r\n\tEND AS 11_pingtaiB,\r\n\tCASE\r\n\t\tWHEN s4.xm_no IS NOT NULL THEN s4.chanpin_leixing\r\n\t\tWHEN s3.xm_no IS NOT NULL THEN s3.chanpin_leixing\r\n\t\tWHEN s2.xm_no IS NOT NULL THEN s2.chanpin_leixing\r\n\t\tELSE s1.chanpin_leixing\r\n\tEND AS 12_productleixing,\r\n\tCASE\r\n\t\tWHEN s4.xm_no IS NOT NULL THEN s4.chanpin_nameIC\r\n\t\tWHEN s3.xm_no IS NOT NULL THEN s3.chanpin_nameIC\r\n\t\tELSE NULL\r\n\tEND AS 13_productnameIC,\r\n\tCASE\r\n\t\tWHEN s4.xm_no IS NOT NULL THEN s4.chanpin_xingtai\r\n\t\tWHEN s3.xm_no IS NOT NULL THEN s3.chanpin_xingtai\r\n\t\tWHEN s2.xm_no IS NOT NULL THEN s2.chanpin_xingtai\r\n\t\tELSE s1.chanpin_xingtai\r\n\tEND AS 14_productstyle,\r\n\tCASE\r\n\t\tWHEN s4.xm_no IS NOT NULL THEN s4.last_kehu\r\n\t\tWHEN s3.xm_no IS NOT NULL THEN s3.last_kehu\r\n\t\tWHEN s2.xm_no IS NOT NULL THEN s2.last_kehu\r\n\t\tELSE s1.last_kehu\r\n\tEND AS 15_zhongduankehu,\r\n\tCASE\r\n\t\tWHEN s4.xm_no IS NOT NULL THEN s4.EMS\r\n\t\tWHEN s3.xm_no IS NOT NULL THEN s3.EMS\r\n\t\tWHEN s2.xm_no IS NOT NULL THEN s2.EMS\r\n\t\tELSE s1.EMS\r\n\tEND AS 16_EMS,\r\n\tCASE\r\n\t\tWHEN s4.xm_no IS NOT NULL THEN s4.DLS\r\n\t\tWHEN s3.xm_no IS NOT NULL THEN s3.DLS\r\n\t\tWHEN s2.xm_no IS NOT NULL THEN s2.DLS\r\n\t\tELSE s1.DLS\r\n\tEND AS 17_dailishang,\r\n\tCASE\r\n\t\tWHEN s4.xm_no IS NOT NULL THEN s4.rel_saleser\r\n\t\tWHEN s3.xm_no IS NOT NULL THEN s3.rel_saleser\r\n\t\tWHEN s2.xm_no IS NOT NULL THEN s2.rel_saleser\r\n\t\tELSE s1.rel_saleser\r\n\tEND AS 18_guanlianxiaoshou,\r\n\r\n\tld_currency_info.currency_code AS a01_bibie,\r\n\tROUND(s4.quote_price_jy,2) AS a02_pricejy,\r\n\tROUND(s4.quote_price_dl,2) AS a03_pricedl,\r\n\tROUND(s4.quote_price_dg,2) AS a04_pricedg,\r\n\tROUND(s4.quote_price_pp,2) AS a05_pricepp,\r\n\tROUND(s4.quote_price_cb,2) AS a06_pricecb,\r\n\ts4.quote_lirun AS a07_lirun,\r\n\ts4.quote_lirun_dl AS a08_lirundl,\r\n\ts4.quote_lirun_dg AS a09_lirundg,\r\n\ts2.jingpinpp AS a10_jingpinpp,\r\n\ts2.jingpinxh AS a10_jingpinxh,\r\n\ts2.jingpinprice AS a11_jingpinprice,\r\n\tp.productname AS a12_productname,\r\n\tp.product_no AS a12_product_no,\r\n\tq.quote_no AS a12_quote_no,\r\n\to.quantity AS a13_qty,\r\n\tROUND(o.taxprice,6) AS a14_price,\r\n\tROUND(t.sf9315,6) AS a15_cost,\r\n\tROUND(t.sf9043,2) AS a16_liruncps,\r\n\tROUND(t.sf8363,6) AS a17_dlprice,\r\n\tROUND(t.sf8499,2) AS a18_dllirun,\r\n\tROUND(t.sf7411,6) AS a19_dgprice,\r\n\tROUND(t.sf8635,2) AS a20_dglirun,\r\n\tROUND(t.sf7547,6) AS a21_ppprice,\r\n\r\n\tCASE \r\n\t\tWHEN r.exists_zhu=1 AND s4.quote_id>0 AND t.sf11627='Y' THEN ROUND(yc.total) \r\n\t\tWHEN IFNULL(r.exists_zhu,0)=0 AND s4.quote_id>0 AND r.minid>0 AND o.lineitem_id=r.minid THEN ROUND(yc.total) \r\n\t\tWHEN IFNULL(r.exists_zhu,0)=0 AND IFNULL(s4.quote_id,0)=0 AND xmcp.product_no=cp.product_no AND xmcp.product_no IS NOT NULL THEN ROUND(yc.total)\r\n\t\tWHEN IFNULL(r.exists_zhu,0)=0 AND IFNULL(s4.quote_id,0)=0 AND xmcp.product_no IS NULL THEN ROUND(yc.total)\t\t\r\n\t\tELSE NULL\r\n\tEND AS b00,\r\n\tCASE \r\n\t\tWHEN r.exists_zhu=1 AND s4.quote_id>0 AND t.sf11627='Y' THEN ROUND(yc.fcst_01) \r\n\t\tWHEN IFNULL(r.exists_zhu,0)=0 AND s4.quote_id>0 AND r.minid>0 AND o.lineitem_id=r.minid THEN ROUND(yc.fcst_01) \r\n\t\tWHEN IFNULL(r.exists_zhu,0)=0 AND IFNULL(s4.quote_id,0)=0 AND xmcp.product_no=cp.product_no AND xmcp.product_no IS NOT NULL THEN ROUND(yc.fcst_01)\r\n\t\tWHEN IFNULL(r.exists_zhu,0)=0 AND IFNULL(s4.quote_id,0)=0 AND xmcp.product_no IS NULL THEN ROUND(yc.fcst_01)\r\n\t\tELSE NULL\r\n\tEND AS b01,\r\n\tCASE \r\n\t\tWHEN r.exists_zhu=1 AND s4.quote_id>0 AND t.sf11627='Y' THEN ROUND(yc.fcst_02) \r\n\t\tWHEN IFNULL(r.exists_zhu,0)=0 AND s4.quote_id>0 AND r.minid>0 AND o.lineitem_id=r.minid THEN ROUND(yc.fcst_02) \r\n\t\tWHEN IFNULL(r.exists_zhu,0)=0 AND IFNULL(s4.quote_id,0)=0 AND xmcp.product_no=cp.product_no AND xmcp.product_no IS NOT NULL THEN ROUND(yc.fcst_02)\r\n\t\tWHEN IFNULL(r.exists_zhu,0)=0 AND IFNULL(s4.quote_id,0)=0 AND xmcp.product_no IS NULL THEN ROUND(yc.fcst_02)\r\n\t\tELSE NULL\r\n\tEND AS b02,\r\n\tCASE \r\n\t\tWHEN r.exists_zhu=1 AND s4.quote_id>0 AND t.sf11627='Y' THEN ROUND(yc.fcst_03) \r\n\t\tWHEN IFNULL(r.exists_zhu,0)=0 AND s4.quote_id>0 AND r.minid>0 AND o.lineitem_id=r.minid THEN ROUND(yc.fcst_03) \r\n\t\tWHEN IFNULL(r.exists_zhu,0)=0 AND IFNULL(s4.quote_id,0)=0 AND xmcp.product_no=cp.product_no AND xmcp.product_no IS NOT NULL THEN ROUND(yc.fcst_03)\r\n\t\tWHEN IFNULL(r.exists_zhu,0)=0 AND IFNULL(s4.quote_id,0)=0 AND xmcp.product_no IS NULL THEN ROUND(yc.fcst_03)\r\n\t\tELSE NULL\r\n\tEND AS b03,\r\n\tCASE \r\n\t\tWHEN r.exists_zhu=1 AND s4.quote_id>0 AND t.sf11627='Y' THEN ROUND(yc.fcst_04) \r\n\t\tWHEN IFNULL(r.exists_zhu,0)=0 AND s4.quote_id>0 AND r.minid>0 AND o.lineitem_id=r.minid THEN ROUND(yc.fcst_04) \r\n\t\tWHEN IFNULL(r.exists_zhu,0)=0 AND IFNULL(s4.quote_id,0)=0 AND xmcp.product_no=cp.product_no AND xmcp.product_no IS NOT NULL THEN ROUND(yc.fcst_04)\r\n\t\tWHEN IFNULL(r.exists_zhu,0)=0 AND IFNULL(s4.quote_id,0)=0 AND xmcp.product_no IS NULL THEN ROUND(yc.fcst_04)\r\n\t\tELSE NULL\r\n\tEND AS b04,\r\n\tCASE \r\n\t\tWHEN r.exists_zhu=1 AND s4.quote_id>0 AND t.sf11627='Y' THEN ROUND(yc.fcst_05) \r\n\t\tWHEN IFNULL(r.exists_zhu,0)=0 AND s4.quote_id>0 AND r.minid>0 AND o.lineitem_id=r.minid THEN ROUND(yc.fcst_05) \r\n\t\tWHEN IFNULL(r.exists_zhu,0)=0 AND IFNULL(s4.quote_id,0)=0 AND xmcp.product_no=cp.product_no AND xmcp.product_no IS NOT NULL THEN ROUND(yc.fcst_05)\r\n\t\tWHEN IFNULL(r.exists_zhu,0)=0 AND IFNULL(s4.quote_id,0)=0 AND xmcp.product_no IS NULL THEN ROUND(yc.fcst_05)\r\n\t\tELSE NULL\r\n\tEND AS b05,\r\n\tCASE \r\n\t\tWHEN r.exists_zhu=1 AND s4.quote_id>0 AND t.sf11627='Y' THEN ROUND(yc.fcst_06) \r\n\t\tWHEN IFNULL(r.exists_zhu,0)=0 AND s4.quote_id>0 AND r.minid>0 AND o.lineitem_id=r.minid THEN ROUND(yc.fcst_06) \r\n\t\tWHEN IFNULL(r.exists_zhu,0)=0 AND IFNULL(s4.quote_id,0)=0 AND xmcp.product_no=cp.product_no AND xmcp.product_no IS NOT NULL THEN ROUND(yc.fcst_06)\r\n\t\tWHEN IFNULL(r.exists_zhu,0)=0 AND IFNULL(s4.quote_id,0)=0 AND xmcp.product_no IS NULL THEN ROUND(yc.fcst_06)\r\n\t\tELSE NULL\r\n\tEND AS b06,\r\n\r\n\tCASE \r\n\t\tWHEN r.exists_zhu=1 AND s4.quote_id>0 AND t.sf11627='Y' THEN ROUND(yc.fcst_07) \r\n\t\tWHEN IFNULL(r.exists_zhu,0)=0 AND s4.quote_id>0 AND r.minid>0 AND o.lineitem_id=r.minid THEN ROUND(yc.fcst_07) \r\n\t\tWHEN IFNULL(r.exists_zhu,0)=0 AND IFNULL(s4.quote_id,0)=0 AND xmcp.product_no=cp.product_no AND xmcp.product_no IS NOT NULL THEN ROUND(yc.fcst_07)\r\n\t\tWHEN IFNULL(r.exists_zhu,0)=0 AND IFNULL(s4.quote_id,0)=0 AND xmcp.product_no IS NULL THEN ROUND(yc.fcst_07)\r\n\t\tELSE NULL\r\n\tEND AS b07,\r\n\tCASE \r\n\t\tWHEN r.exists_zhu=1 AND s4.quote_id>0 AND t.sf11627='Y' THEN ROUND(yc.fcst_08) \r\n\t\tWHEN IFNULL(r.exists_zhu,0)=0 AND s4.quote_id>0 AND r.minid>0 AND o.lineitem_id=r.minid THEN ROUND(yc.fcst_08) \r\n\t\tWHEN IFNULL(r.exists_zhu,0)=0 AND IFNULL(s4.quote_id,0)=0 AND xmcp.product_no=cp.product_no AND xmcp.product_no IS NOT NULL THEN ROUND(yc.fcst_08)\r\n\t\tWHEN IFNULL(r.exists_zhu,0)=0 AND IFNULL(s4.quote_id,0)=0 AND xmcp.product_no IS NULL THEN ROUND(yc.fcst_08)\r\n\t\tELSE NULL\r\n\tEND AS b08,\r\n\tCASE \r\n\t\tWHEN r.exists_zhu=1 AND s4.quote_id>0 AND t.sf11627='Y' THEN ROUND(yc.fcst_09) \r\n\t\tWHEN IFNULL(r.exists_zhu,0)=0 AND s4.quote_id>0 AND r.minid>0 AND o.lineitem_id=r.minid THEN ROUND(yc.fcst_09) \r\n\t\tWHEN IFNULL(r.exists_zhu,0)=0 AND IFNULL(s4.quote_id,0)=0 AND xmcp.product_no=cp.product_no AND xmcp.product_no IS NOT NULL THEN ROUND(yc.fcst_09)\r\n\t\tWHEN IFNULL(r.exists_zhu,0)=0 AND IFNULL(s4.quote_id,0)=0 AND xmcp.product_no IS NULL THEN ROUND(yc.fcst_09)\r\n\t\tELSE NULL\r\n\tEND AS b09,\r\n\tCASE \r\n\t\tWHEN r.exists_zhu=1 AND s4.quote_id>0 AND t.sf11627='Y' THEN ROUND(yc.fcst_10) \r\n\t\tWHEN IFNULL(r.exists_zhu,0)=0 AND s4.quote_id>0 AND r.minid>0 AND o.lineitem_id=r.minid THEN ROUND(yc.fcst_10) \r\n\t\tWHEN IFNULL(r.exists_zhu,0)=0 AND IFNULL(s4.quote_id,0)=0 AND xmcp.product_no=cp.product_no AND xmcp.product_no IS NOT NULL THEN ROUND(yc.fcst_10)\r\n\t\tWHEN IFNULL(r.exists_zhu,0)=0 AND IFNULL(s4.quote_id,0)=0 AND xmcp.product_no IS NULL THEN ROUND(yc.fcst_10)\r\n\t\tELSE NULL\r\n\tEND AS b10,\r\n\tCASE \r\n\t\tWHEN r.exists_zhu=1 AND s4.quote_id>0 AND t.sf11627='Y' THEN ROUND(yc.fcst_11) \r\n\t\tWHEN IFNULL(r.exists_zhu,0)=0 AND s4.quote_id>0 AND r.minid>0 AND o.lineitem_id=r.minid THEN ROUND(yc.fcst_11) \r\n\t\tWHEN IFNULL(r.exists_zhu,0)=0 AND IFNULL(s4.quote_id,0)=0 AND xmcp.product_no=cp.product_no AND xmcp.product_no IS NOT NULL THEN ROUND(yc.fcst_11)\r\n\t\tWHEN IFNULL(r.exists_zhu,0)=0 AND IFNULL(s4.quote_id,0)=0 AND xmcp.product_no IS NULL THEN ROUND(yc.fcst_11)\r\n\t\tELSE NULL\r\n\tEND AS b11,\r\n\tCASE \r\n\t\tWHEN r.exists_zhu=1 AND s4.quote_id>0 AND t.sf11627='Y' THEN ROUND(yc.fcst_12) \r\n\t\tWHEN IFNULL(r.exists_zhu,0)=0 AND s4.quote_id>0 AND r.minid>0 AND o.lineitem_id=r.minid THEN ROUND(yc.fcst_12) \r\n\t\tWHEN IFNULL(r.exists_zhu,0)=0 AND IFNULL(s4.quote_id,0)=0 AND xmcp.product_no=cp.product_no AND xmcp.product_no IS NOT NULL THEN ROUND(yc.fcst_12)\r\n\t\tWHEN IFNULL(r.exists_zhu,0)=0 AND IFNULL(s4.quote_id,0)=0 AND xmcp.product_no IS NULL THEN ROUND(yc.fcst_12)\r\n\t\tELSE NULL\r\n\tEND AS b12,\r\n\r\n\tso.qty1+so.qty2+so.qty3+so.qty4+so.qty5+so.qty6\r\n\t\t+so.qty7+so.qty8+so.qty9+so.qty10+so.qty11+so.qty12 AS c00,\r\n\tso.qty1 AS c01,\r\n\tso.qty2 AS c02,\r\n\tso.qty3 AS c03,\r\n\tso.qty4 AS c04,\r\n\tso.qty5 AS c05,\r\n\tso.qty6 AS c06,\r\n\tso.qty7 AS c07,\r\n\tso.qty8 AS c08,\r\n\tso.qty9 AS c09,\r\n\tso.qty10 AS c10,\r\n\tso.qty11 AS c11,\r\n\tso.qty12 AS c12,\r\n\r\n\tch.cqty1+ch.cqty2+ch.cqty3+ch.cqty4+ch.cqty5+ch.cqty6\r\n\t\t+ch.cqty7+ch.cqty8+ch.cqty9+ch.cqty10+ch.cqty11+ch.cqty12 AS d00,\r\n\tch.cqty1 AS d01,\r\n\tch.cqty2 AS d02,\r\n\tch.cqty3 AS d03,\r\n\tch.cqty4 AS d04,\r\n\tch.cqty5 AS d05,\r\n\tch.cqty6 AS d06,\r\n\tch.cqty7 AS d07,\r\n\tch.cqty8 AS d08,\r\n\tch.cqty9 AS d09,\r\n\tch.cqty10 AS d10,\r\n\tch.cqty11 AS d11,\r\n\tch.cqty12 AS d12,\r\n\r\n\tch.eqty1+ch.eqty2+ch.eqty3+ch.eqty4+ch.eqty5+ch.eqty6\r\n\t\t+ch.eqty7+ch.eqty8+ch.eqty9+ch.eqty10+ch.eqty11+ch.eqty12 AS e00,\r\n\tROUND(ch.eqty1,2) AS e01,\r\n\tROUND(ch.eqty2,2) AS e02,\r\n\tROUND(ch.eqty3,2) AS e03,\r\n\tROUND(ch.eqty4,2) AS e04,\r\n\tROUND(ch.eqty5,2) AS e05,\r\n\tROUND(ch.eqty6,2) AS e06,\r\n\tROUND(ch.eqty7,2) AS e07,\r\n\tROUND(ch.eqty8,2) AS e08,\r\n\tROUND(ch.eqty9,2) AS e09,\r\n\tROUND(ch.eqty10,2) AS e10,\r\n\tROUND(ch.eqty11,2) AS e11,\r\n\tROUND(ch.eqty12,2) AS e12\r\nFROM (\r\n\tSELECT\r\n\t\ta.leadsid AS billid,\r\n\t\ta.leads_no  AS xm_no,\r\n\t\t'S1' AS xm_status,\r\n\t\tk.accountname,\r\n\t\tu.last_name AS smowner,\r\n\t\tNULL AS team,\r\n\t\tb.cf_3682 AS pro_amount,\r\n\t\tb.cf_3603 AS pro_volume,\r\n\t\tb.cf_4811 AS pingtaiA,\r\n\t\tb.cf_4810 AS pingtaiB,\r\n\t\tNULL AS chanpin_leixing,\r\n\t\tb.cf_3942 AS chanpin_xingtai,\r\n\t\tNULL AS last_kehu,\r\n\t\tNULL AS EMS,\r\n\t\tNULL AS DLS,\r\n\t\tb.cf_3752 AS rel_saleser,\r\n\t\tNULL AS xiangmuhao,\r\n\t\tCASE\r\n\t\t\t WHEN b.cf_2995='否' THEN 'yes'\r\n\t\t\t ELSE 'no'\r\n\t\tEND AS is_defshow,\r\n\t\ta.smownerid\r\n\tFROM ld_leads a\r\n\tLEFT JOIN ld_leadscf b ON b.leadsid=a.leadsid\r\n\tLEFT JOIN ld_users u ON u.id=a.smownerid\r\n\tLEFT JOIN ld_account k ON k.accountid=a.accountid\r\n\tWHERE a.deleted=0\r\n\t\tAND IFNULL(a.leads_no,'')<>''\r\n\tGROUP BY a.leads_no\r\n) s1\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\ta.potentialid AS billid,\r\n\t\tb.cf_3341 AS xm_no,\r\n\t\t'S2' AS xm_status,\r\n\t\tk.accountname,\r\n\t\tu.last_name AS smowner,\r\n\t\tb.cf_3453 AS team,\r\n\t\ta.amount AS pro_amount,\r\n\t\tb.cf_3744 AS pro_volume,\r\n\t\tb.cf_4812 AS pingtaiA,\r\n\t\tb.cf_4813 AS pingtaiB,\r\n\t\tb.cf_3426 AS chanpin_leixing,\r\n\t\tb.cf_3943 AS chanpin_xingtai,\r\n\t\tb.cf_3347 AS last_kehu,\r\n\t\tb.cf_3294 AS EMS,\r\n\t\tb.cf_3452 AS DLS,\r\n\t\tb.cf_3777 AS rel_saleser,\r\n\t\tb.cf_3332 AS xiangmuhao,\r\n\t\tb.cf_3342 AS jingpinpp,\r\n\t\tb.cf_3343 AS jingpinxh,\r\n\t\tb.cf_3344 AS jingpinprice,\r\n\t\tCASE\r\n\t\t\t WHEN b.cf_3340='否' THEN 'yes'\r\n\t\t\t ELSE 'no'\r\n\t\tEND AS is_defshow,\r\n\t\ta.smownerid\r\n\tFROM ld_potential a\r\n\tLEFT JOIN ld_potentialscf b ON b.potentialid=a.potentialid\r\n\tLEFT JOIN ld_users u ON u.id=a.smownerid\r\n\tLEFT JOIN ld_account k ON k.accountid=a.accountid\r\n\tWHERE a.deleted=0\r\n\t\tAND IFNULL(b.cf_3341,'')<>''\r\n\tGROUP BY b.cf_3341\r\n) s2 ON s2.xm_no=s1.xm_no\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\ta.customform22id AS billid,\r\n\t\tc.cf_3341 AS xm_no,\r\n\t\t'S3' AS xm_status,\r\n\t\tk.accountname,\r\n\t\tu.last_name AS smowner,\r\n\t\tb.cf_3706 AS team,\r\n\t\tb.cf_3782 AS pro_amount,\r\n\t\tb.cf_3781 AS pro_volume,\r\n\t\tb.cf_4814 AS pingtaiA,\r\n\t\tb.cf_4815 AS pingtaiB,\r\n\t\tb.cf_3784 AS chanpin_leixing,\r\n\t\tb.cf_3944 AS chanpin_xingtai,\r\n\t\tb.cf_3118 AS chanpin_nameIC,\r\n\t\tb.cf_3533 AS last_kehu,\r\n\t\tb.cf_3532 AS EMS,\r\n\t\tb.cf_3531 AS DLS,\r\n\t\tb.cf_3778 AS rel_saleser,\r\n\t\tb.cf_3527 AS xiangmuhao,\r\n\t\tCASE\r\n\t\t\t WHEN b.cf_3077='否' THEN 'yes'\r\n\t\t\t ELSE 'no'\r\n\t\tEND AS is_defshow,\r\n\t\ta.smownerid\r\n\tFROM ld_customform22 a\r\n\tLEFT JOIN ld_customform22scf b ON b.customform22id=a.customform22id\r\n\tLEFT JOIN ld_potentialscf c ON c.potentialid=a.potentialid\r\n\tLEFT JOIN ld_users u ON u.id=a.smownerid\r\n\tLEFT JOIN ld_account k ON k.accountid=a.accountid\r\n\tWHERE a.deleted=0\r\n\t\tAND IFNULL(c.cf_3341,'')<>''\r\n\tGROUP BY c.cf_3341\r\n) s3 ON s3.xm_no=s1.xm_no\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\ta.customform21id AS billid,\r\n\t\ta.quote_id,\r\n\t\tb.cf_3458 AS xm_no,\r\n\t\tb.cf_3457 AS xm_status,\r\n\t\tk.accountname,\r\n\t\tu.last_name AS smowner,\r\n\t\tb.cf_3707 AS team,\r\n\t\tNULL AS pro_amount,\r\n\t\tNULL AS pro_volume,\r\n\t\tb.cf_4816 AS pingtaiA,\r\n\t\tb.cf_4817 AS pingtaiB,\r\n\t\tb.cf_3785 AS chanpin_leixing,\r\n\t\tb.cf_3945 AS chanpin_xingtai,\r\n\t\tCASE\r\n\t\t\tWHEN b.cf_3785='Module' THEN b.cf_4006\r\n\t\t\tELSE b.cf_3124 \r\n\t\tEND AS chanpin_nameIC,\r\n\t\tb.cf_3537 AS last_kehu,\r\n\t\tb.cf_3536 AS EMS,\r\n\t\tb.cf_3535 AS DLS,\r\n\t\tb.cf_4656 AS rel_saleser,\r\n\t\tb.cf_3528 AS xiangmuhao,\r\n\t\t\r\n\t\ta.quote_price_jy,\r\n\t\ta.quote_price_dl,\r\n\t\ta.quote_price_dg,\r\n\t\ta.quote_price_pp,\r\n\t\ta.quote_price_cb,\r\n\t\ta.quote_lirun,\r\n\t\ta.quote_lirun_dl,\r\n\t\ta.quote_lirun_dg,\r\n\t\tCASE\r\n\t\t\t WHEN b.cf_2968='否' OR b.cf_3457='EOL' THEN 'yes'\r\n\t\t\t ELSE 'no'\r\n\t\tEND AS is_defshow,\r\n\t\ta.smownerid\r\n\tFROM ld_customform21 a\r\n\tLEFT JOIN ld_customform21scf b ON b.customform21id=a.customform21id\r\n\tLEFT JOIN ld_users u ON u.id=a.smownerid\r\n\tLEFT JOIN ld_account k ON k.accountid=a.accountid\r\n\tWHERE a.deleted=0\r\n\t\tAND IFNULL(b.cf_3458,'')<>''\r\n\tGROUP BY b.cf_3458\r\n) s4 ON s4.xm_no=s1.xm_no\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\ta.xiangmu_no AS xm_no,\r\n\t\tc.cf_3549 AS chanpin,\r\n\t\ta.fcst_01,\r\n\t\ta.fcst_02,\r\n\t\ta.fcst_03,\r\n\t\ta.fcst_04,\r\n\t\ta.fcst_05,\r\n\t\ta.fcst_06,\r\n\t\ta.fcst_07,\r\n\t\ta.fcst_08,\r\n\t\ta.fcst_09,\r\n\t\ta.fcst_10,\r\n\t\ta.fcst_11,\r\n\t\ta.fcst_12,\r\n\t\tIFNULL(a.fcst_01,0)+IFNULL(a.fcst_02,0)+IFNULL(a.fcst_03,0)+IFNULL(a.fcst_04,0)+IFNULL(a.fcst_05,0)+IFNULL(a.fcst_06,0)\r\n\t\t\t+IFNULL(a.fcst_07,0)+IFNULL(a.fcst_08,0)+IFNULL(a.fcst_09,0)+IFNULL(a.fcst_10,0)+IFNULL(a.fcst_11,0)+IFNULL(a.fcst_12,0) AS total\r\n\tFROM ld_customform03 a\r\n\tLEFT JOIN ld_customform03scf c ON c.customform03id=a.customform03id\r\n\tINNER JOIN (\r\n\t\tSELECT\r\n\t\t\ta.xiangmu_no,\r\n\t\t\ta.customform03id\r\n\t\tFROM (\r\n\t\t\tSELECT\r\n\t\t\t\ta.xiangmu_no,\r\n\t\t\t\ta.customform03id\r\n\t\t\tFROM ld_customform03 a\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.xiangmu_no IS NOT NULL\r\n\t\t\t\tAND a.xiangmu_no<>''\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN EXISTS (SELECT 1 FROM ld_customform03 WHERE deleted=0 AND YEAR(yuce_date)='{nian}' AND MONTH(yuce_date)='{yue}') THEN \r\n\t\t\t\t\t\t\tYEAR(a.yuce_date)='{nian}' AND MONTH(a.yuce_date)='{yue}'\r\n\t\t\t\t\t\tELSE \r\n\t\t\t\t\t\t\ta.yuce_date BETWEEN DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'), INTERVAL 1 MONTH) \r\n\t\t\t\t\t\t\t\tAND LAST_DAY(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'), INTERVAL 1 MONTH))\r\n\t\t\t\t\tEND)\t\t\r\n\t\t\tORDER BY a.xiangmu_no,a.yuce_date DESC,a.modifiedtime DESC\r\n\t\t) a\r\n\t\tGROUP BY a.xiangmu_no\r\n\t) b ON b.customform03id=a.customform03id\r\n) yc ON yc.xm_no=s1.xm_no\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\txm_no,\r\n\t\tproduct_no\r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\td.cf_3458 AS xm_no,\r\n\t\t\tp.productname,\r\n\t\t\tp.product_no\r\n\t\tFROM ld_customform21 a\r\n\t\tLEFT JOIN ld_customform21scf d ON d.customform21id=a.customform21id\r\n\t\tLEFT JOIN ld_quotesdetail b ON b.id=a.quote_id\r\n\t\tLEFT JOIN ld_products p ON p.productid=b.productid\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\tAND a.quote_id>0\r\n\t\tGROUP BY d.cf_3458,p.product_no\r\n\t\tUNION\r\n\t\tSELECT\r\n\t\t\txm_no,\r\n\t\t\tproductname,\r\n\t\t\tproduct_no\r\n\t\tFROM (\r\n\t\t\tSELECT\r\n\t\t\t\ta.customform03id,\r\n\t\t\t\ta.xiangmu_no AS xm_no,\r\n\t\t\t\tc.cf_3549 AS productname,\r\n\t\t\t\t(SELECT product_no FROM ld_products WHERE deleted=0 AND productname=c.cf_3549 ORDER BY deleted,modifiedtime DESC LIMIT 1) AS product_no\r\n\t\t\tFROM ld_customform03 a\r\n\t\t\tLEFT JOIN ld_customform03scf c ON c.customform03id=a.customform03id\r\n\t\t\tINNER JOIN (\r\n\t\t\t\tSELECT\r\n\t\t\t\t\ta.xiangmu_no,\r\n\t\t\t\t\ta.customform03id\r\n\t\t\t\tFROM (\r\n\t\t\t\t\tSELECT\r\n\t\t\t\t\t\ta.xiangmu_no,\r\n\t\t\t\t\t\ta.customform03id\r\n\t\t\t\t\tFROM ld_customform03 a\r\n\t\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\t\tAND a.xiangmu_no IS NOT NULL\r\n\t\t\t\t\t\tAND a.xiangmu_no<>''\r\n\t\t\t\t\t\tAND (\r\n\t\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\t\tWHEN EXISTS (SELECT 1 FROM ld_customform03 WHERE deleted=0 AND YEAR(yuce_date)='2020' AND MONTH(yuce_date)='9') THEN \r\n\t\t\t\t\t\t\t\t\tYEAR(a.yuce_date)='2020' AND MONTH(a.yuce_date)='9'\r\n\t\t\t\t\t\t\t\tELSE \r\n\t\t\t\t\t\t\t\t\ta.yuce_date BETWEEN DATE_SUB(CONCAT('2020','-',LPAD('9',2,'0'),'-01'), INTERVAL 1 MONTH) \r\n\t\t\t\t\t\t\t\t\t\tAND LAST_DAY(DATE_SUB(CONCAT('2020','-',LPAD('9',2,'0'),'-01'), INTERVAL 1 MONTH))\r\n\t\t\t\t\t\t\tEND)\t\t\r\n\t\t\t\t\tORDER BY a.xiangmu_no,a.yuce_date DESC,a.modifiedtime DESC\r\n\t\t\t\t) a\r\n\t\t\t\tGROUP BY a.xiangmu_no\r\n\t\t\t) b ON b.customform03id=a.customform03id\r\n\t\t) tmp\r\n\t\tWHERE IFNULL(product_no,'')<>''\r\n\t\tUNION\r\n\t\tSELECT\r\n\t\t\td.cf_3424 AS xm_no,\r\n\t\t\tp.productname,\r\n\t\t\tp.product_no\r\n\t\tFROM ld_salesorder a\r\n\t\tLEFT JOIN ld_salesordercf d ON d.salesorderid=a.salesorderid\r\n\t\tLEFT JOIN ld_salesorderdetail b ON b.id=a.salesorderid\r\n\t\tLEFT JOIN ld_salesorderdetailscf c ON c.lineitem_id=b.lineitem_id\r\n\t\tLEFT JOIN ld_products p ON p.productid=b.productid\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tGROUP BY d.cf_3424,p.product_no\r\n\t) a\r\n\tGROUP BY xm_no\r\n) xmcp ON xmcp.xm_no=s1.xm_no\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\td.cf_3458 AS xm_no,\r\n\t\tp.productname,\r\n\t\tp.product_no\r\n\tFROM ld_customform21 a\r\n\tLEFT JOIN ld_customform21scf d ON d.customform21id=a.customform21id\r\n\tLEFT JOIN ld_quotesdetail b ON b.id=a.quote_id\r\n\tLEFT JOIN ld_products p ON p.productid=b.productid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND a.quote_id>0\r\n\tGROUP BY d.cf_3458,p.product_no\r\n\tUNION\r\n\tSELECT\r\n\t\txm_no,\r\n\t\tproductname,\r\n\t\tproduct_no\r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\ta.customform03id,\r\n\t\t\ta.xiangmu_no AS xm_no,\r\n\t\t\tc.cf_3549 AS productname,\r\n\t\t\t(SELECT product_no FROM ld_products WHERE deleted=0 AND productname=c.cf_3549 ORDER BY deleted,modifiedtime DESC LIMIT 1) AS product_no\r\n\t\tFROM ld_customform03 a\r\n\t\tLEFT JOIN ld_customform03scf c ON c.customform03id=a.customform03id\r\n\t\tINNER JOIN (\r\n\t\t\tSELECT\r\n\t\t\t\ta.xiangmu_no,\r\n\t\t\t\ta.customform03id\r\n\t\t\tFROM (\r\n\t\t\t\tSELECT\r\n\t\t\t\t\ta.xiangmu_no,\r\n\t\t\t\t\ta.customform03id\r\n\t\t\t\tFROM ld_customform03 a\r\n\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\tAND a.xiangmu_no IS NOT NULL\r\n\t\t\t\t\tAND a.xiangmu_no<>''\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN EXISTS (SELECT 1 FROM ld_customform03 WHERE deleted=0 AND YEAR(yuce_date)='2020' AND MONTH(yuce_date)='9') THEN \r\n\t\t\t\t\t\t\t\tYEAR(a.yuce_date)='2020' AND MONTH(a.yuce_date)='9'\r\n\t\t\t\t\t\t\tELSE \r\n\t\t\t\t\t\t\t\ta.yuce_date BETWEEN DATE_SUB(CONCAT('2020','-',LPAD('9',2,'0'),'-01'), INTERVAL 1 MONTH) \r\n\t\t\t\t\t\t\t\t\tAND LAST_DAY(DATE_SUB(CONCAT('2020','-',LPAD('9',2,'0'),'-01'), INTERVAL 1 MONTH))\r\n\t\t\t\t\t\tEND)\t\t\r\n\t\t\t\tORDER BY a.xiangmu_no,a.yuce_date DESC,a.modifiedtime DESC\r\n\t\t\t) a\r\n\t\t\tGROUP BY a.xiangmu_no\r\n\t\t) b ON b.customform03id=a.customform03id\r\n\t) tmp\r\n\tWHERE IFNULL(product_no,'')<>''\r\n\tUNION\r\n\tSELECT\r\n\t\td.cf_3424 AS xm_no,\r\n\t\tp.productname,\r\n\t\tp.product_no\r\n\tFROM ld_salesorder a\r\n\tLEFT JOIN ld_salesordercf d ON d.salesorderid=a.salesorderid\r\n\tLEFT JOIN ld_salesorderdetail b ON b.id=a.salesorderid\r\n\tLEFT JOIN ld_salesorderdetailscf c ON c.lineitem_id=b.lineitem_id\r\n\tLEFT JOIN ld_products p ON p.productid=b.productid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\tGROUP BY d.cf_3424,p.product_no\r\n) cp ON cp.xm_no=s1.xm_no\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\td.cf_3424 AS xm_no,\r\n\t\tp.product_no,\r\n\t\tSUM(CASE WHEN DATE_FORMAT(a.signed_data,'%Y%m')=DATE_FORMAT(CONCAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 11 MONTH)),'%Y%m') THEN b.quantity ELSE 0 END) AS qty1,\r\n\t\tSUM(CASE WHEN DATE_FORMAT(a.signed_data,'%Y%m')=DATE_FORMAT(CONCAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 10 MONTH)),'%Y%m') THEN b.quantity ELSE 0 END) AS qty2,\r\n\t\tSUM(CASE WHEN DATE_FORMAT(a.signed_data,'%Y%m')=DATE_FORMAT(CONCAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 9 MONTH)),'%Y%m') THEN b.quantity ELSE 0 END) AS qty3,\r\n\t\tSUM(CASE WHEN DATE_FORMAT(a.signed_data,'%Y%m')=DATE_FORMAT(CONCAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 8 MONTH)),'%Y%m') THEN b.quantity ELSE 0 END) AS qty4,\r\n\t\tSUM(CASE WHEN DATE_FORMAT(a.signed_data,'%Y%m')=DATE_FORMAT(CONCAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 7 MONTH)),'%Y%m') THEN b.quantity ELSE 0 END) AS qty5,\r\n\t\tSUM(CASE WHEN DATE_FORMAT(a.signed_data,'%Y%m')=DATE_FORMAT(CONCAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 6 MONTH)),'%Y%m') THEN b.quantity ELSE 0 END) AS qty6,\r\n\t\tSUM(CASE WHEN DATE_FORMAT(a.signed_data,'%Y%m')=DATE_FORMAT(CONCAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 5 MONTH)),'%Y%m') THEN b.quantity ELSE 0 END) AS qty7,\r\n\t\tSUM(CASE WHEN DATE_FORMAT(a.signed_data,'%Y%m')=DATE_FORMAT(CONCAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 4 MONTH)),'%Y%m') THEN b.quantity ELSE 0 END) AS qty8,\r\n\t\tSUM(CASE WHEN DATE_FORMAT(a.signed_data,'%Y%m')=DATE_FORMAT(CONCAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 3 MONTH)),'%Y%m') THEN b.quantity ELSE 0 END) AS qty9,\r\n\t\tSUM(CASE WHEN DATE_FORMAT(a.signed_data,'%Y%m')=DATE_FORMAT(CONCAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 2 MONTH)),'%Y%m') THEN b.quantity ELSE 0 END) AS qty10,\r\n\t\tSUM(CASE WHEN DATE_FORMAT(a.signed_data,'%Y%m')=DATE_FORMAT(CONCAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 1 MONTH)),'%Y%m') THEN b.quantity ELSE 0 END) AS qty11,\r\n\t\tSUM(CASE WHEN DATE_FORMAT(a.signed_data,'%Y%m')=DATE_FORMAT(CONCAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 0 MONTH)),'%Y%m') THEN b.quantity ELSE 0 END) AS qty12\r\n\tFROM ld_salesorder a\r\n\tLEFT JOIN ld_salesordercf d ON d.salesorderid=a.salesorderid\r\n\tLEFT JOIN ld_salesorderdetail b ON b.id=a.salesorderid\r\n\tLEFT JOIN ld_salesorderdetailscf c ON c.lineitem_id=b.lineitem_id\r\n\tLEFT JOIN ld_products p ON p.productid=b.productid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND a.createdtime BETWEEN CONCAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 11 MONTH),' 00:00:00') AND CONCAT(LAST_DAY(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01')),' 23:59:59')\r\n\tGROUP BY d.cf_3424,p.product_no\r\n) so ON so.xm_no=s1.xm_no AND so.product_no=cp.product_no\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\tf.cf_3424 AS xm_no,\r\n\t\tp.product_no,\r\n\t\tSUM(CASE WHEN DATE_FORMAT(a.outdate,'%Y%m')=DATE_FORMAT(CONCAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 11 MONTH)),'%Y%m') THEN c.quantity ELSE 0 END) AS cqty1,\r\n\t\tSUM(CASE WHEN DATE_FORMAT(a.outdate,'%Y%m')=DATE_FORMAT(CONCAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 10 MONTH)),'%Y%m') THEN c.quantity ELSE 0 END) AS cqty2,\r\n\t\tSUM(CASE WHEN DATE_FORMAT(a.outdate,'%Y%m')=DATE_FORMAT(CONCAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 9 MONTH)),'%Y%m') THEN c.quantity ELSE 0 END) AS cqty3,\r\n\t\tSUM(CASE WHEN DATE_FORMAT(a.outdate,'%Y%m')=DATE_FORMAT(CONCAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 8 MONTH)),'%Y%m') THEN c.quantity ELSE 0 END) AS cqty4,\r\n\t\tSUM(CASE WHEN DATE_FORMAT(a.outdate,'%Y%m')=DATE_FORMAT(CONCAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 7 MONTH)),'%Y%m') THEN c.quantity ELSE 0 END) AS cqty5,\r\n\t\tSUM(CASE WHEN DATE_FORMAT(a.outdate,'%Y%m')=DATE_FORMAT(CONCAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 6 MONTH)),'%Y%m') THEN c.quantity ELSE 0 END) AS cqty6,\r\n\t\tSUM(CASE WHEN DATE_FORMAT(a.outdate,'%Y%m')=DATE_FORMAT(CONCAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 5 MONTH)),'%Y%m') THEN c.quantity ELSE 0 END) AS cqty7,\r\n\t\tSUM(CASE WHEN DATE_FORMAT(a.outdate,'%Y%m')=DATE_FORMAT(CONCAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 4 MONTH)),'%Y%m') THEN c.quantity ELSE 0 END) AS cqty8,\r\n\t\tSUM(CASE WHEN DATE_FORMAT(a.outdate,'%Y%m')=DATE_FORMAT(CONCAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 3 MONTH)),'%Y%m') THEN c.quantity ELSE 0 END) AS cqty9,\r\n\t\tSUM(CASE WHEN DATE_FORMAT(a.outdate,'%Y%m')=DATE_FORMAT(CONCAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 2 MONTH)),'%Y%m') THEN c.quantity ELSE 0 END) AS cqty10,\r\n\t\tSUM(CASE WHEN DATE_FORMAT(a.outdate,'%Y%m')=DATE_FORMAT(CONCAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 1 MONTH)),'%Y%m') THEN c.quantity ELSE 0 END) AS cqty11,\r\n\t\tSUM(CASE WHEN DATE_FORMAT(a.outdate,'%Y%m')=DATE_FORMAT(CONCAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 0 MONTH)),'%Y%m') THEN c.quantity ELSE 0 END) AS cqty12,\r\n\r\n\r\n\t\tSUM(CASE WHEN DATE_FORMAT(a.outdate,'%Y%m')=DATE_FORMAT(CONCAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 11 MONTH)),'%Y%m') THEN c.quantity*c.taxprice*ROUND(1/s.conversion_rate,4)/IF(a.currency_id=1,1.13,0.9) ELSE 0 END) AS eqty1,\r\n\t\tSUM(CASE WHEN DATE_FORMAT(a.outdate,'%Y%m')=DATE_FORMAT(CONCAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 10 MONTH)),'%Y%m') THEN c.quantity*c.taxprice*ROUND(1/s.conversion_rate,4)/IF(a.currency_id=1,1.13,0.9) ELSE 0 END) AS eqty2,\r\n\t\tSUM(CASE WHEN DATE_FORMAT(a.outdate,'%Y%m')=DATE_FORMAT(CONCAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 9 MONTH)),'%Y%m') THEN c.quantity*c.taxprice*ROUND(1/s.conversion_rate,4)/IF(a.currency_id=1,1.13,0.9) ELSE 0 END) AS eqty3,\r\n\t\tSUM(CASE WHEN DATE_FORMAT(a.outdate,'%Y%m')=DATE_FORMAT(CONCAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 8 MONTH)),'%Y%m') THEN c.quantity*c.taxprice*ROUND(1/s.conversion_rate,4)/IF(a.currency_id=1,1.13,0.9) ELSE 0 END) AS eqty4,\r\n\t\tSUM(CASE WHEN DATE_FORMAT(a.outdate,'%Y%m')=DATE_FORMAT(CONCAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 7 MONTH)),'%Y%m') THEN c.quantity*c.taxprice*ROUND(1/s.conversion_rate,4)/IF(a.currency_id=1,1.13,0.9) ELSE 0 END) AS eqty5,\r\n\t\tSUM(CASE WHEN DATE_FORMAT(a.outdate,'%Y%m')=DATE_FORMAT(CONCAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 6 MONTH)),'%Y%m') THEN c.quantity*c.taxprice*ROUND(1/s.conversion_rate,4)/IF(a.currency_id=1,1.13,0.9) ELSE 0 END) AS eqty6,\r\n\t\tSUM(CASE WHEN DATE_FORMAT(a.outdate,'%Y%m')=DATE_FORMAT(CONCAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 5 MONTH)),'%Y%m') THEN c.quantity*c.taxprice*ROUND(1/s.conversion_rate,4)/IF(a.currency_id=1,1.13,0.9) ELSE 0 END) AS eqty7,\r\n\t\tSUM(CASE WHEN DATE_FORMAT(a.outdate,'%Y%m')=DATE_FORMAT(CONCAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 4 MONTH)),'%Y%m') THEN c.quantity*c.taxprice*ROUND(1/s.conversion_rate,4)/IF(a.currency_id=1,1.13,0.9) ELSE 0 END) AS eqty8,\r\n\t\tSUM(CASE WHEN DATE_FORMAT(a.outdate,'%Y%m')=DATE_FORMAT(CONCAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 3 MONTH)),'%Y%m') THEN c.quantity*c.taxprice*ROUND(1/s.conversion_rate,4)/IF(a.currency_id=1,1.13,0.9) ELSE 0 END) AS eqty9,\r\n\t\tSUM(CASE WHEN DATE_FORMAT(a.outdate,'%Y%m')=DATE_FORMAT(CONCAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 2 MONTH)),'%Y%m') THEN c.quantity*c.taxprice*ROUND(1/s.conversion_rate,4)/IF(a.currency_id=1,1.13,0.9) ELSE 0 END) AS eqty10,\r\n\t\tSUM(CASE WHEN DATE_FORMAT(a.outdate,'%Y%m')=DATE_FORMAT(CONCAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 1 MONTH)),'%Y%m') THEN c.quantity*c.taxprice*ROUND(1/s.conversion_rate,4)/IF(a.currency_id=1,1.13,0.9) ELSE 0 END) AS eqty11,\r\n\t\tSUM(CASE WHEN DATE_FORMAT(a.outdate,'%Y%m')=DATE_FORMAT(CONCAT(DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 0 MONTH)),'%Y%m') THEN c.quantity*c.taxprice*ROUND(1/s.conversion_rate,4)/IF(a.currency_id=1,1.13,0.9) ELSE 0 END) AS eqty12\r\n\tFROM ld_outboundorder a\r\n\tLEFT JOIN ld_outboundordercf b ON b.out_id=a.out_id\r\n\tLEFT JOIN ld_outboundorderdetail c ON c.id=a.out_id\r\n\tLEFT JOIN ld_salesorder s ON s.salesorderid=c.entitytypeid\r\n\tLEFT JOIN ld_salesordercf f ON f.salesorderid=s.salesorderid\r\n\tLEFT JOIN ld_products p ON p.productid=c.productid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND c.entitytypeid>0\r\n\t\tAND c.entitytype='SalesOrder'\r\n\t\tAND a.outdate BETWEEN DATE_SUB(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'),INTERVAL 11 MONTH) AND LAST_DAY(CONCAT('{nian}','-',LPAD('{yue}',2,'0'),'-01'))\r\n\t\tAND IFNULL(f.cf_3424,'')<>''\r\n\tGROUP BY f.cf_3424,p.product_no\r\n) ch ON ch.xm_no=s1.xm_no AND ch.product_no=cp.product_no\r\nLEFT JOIN ld_quotes AS q ON q.quoteid=s4.quote_id\r\nLEFT JOIN (\r\n\tSELECT \r\n\t\ta.id,\r\n\t\tMIN(a.lineitem_id) AS minid,\r\n\t\tMAX(CASE WHEN b.sf11627='Y' THEN 1 ELSE 0 END) AS exists_zhu\r\n\tFROM ld_quotesdetail a\r\n\tLEFT JOIN ld_quotesdetailscf b ON b.lineitem_id=a.lineitem_id\r\n\tGROUP BY a.id\r\n) r ON r.id=q.quoteid\r\nLEFT JOIN ld_currency_info ON ld_currency_info.id=q.currency_id\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\ta.*,\r\n\t\tb.product_no\r\n\tFROM\tld_quotesdetail a\r\n\tLEFT JOIN ld_products b ON b.productid=a.productid\r\n\tGROUP BY a.id,b.product_no\r\n) o ON o.id=q.quoteid AND o.product_no=cp.product_no\r\nLEFT JOIN ld_quotesdetailscf t ON t.lineitem_id=o.lineitem_id\r\nLEFT JOIN ld_products p ON p.product_no=cp.product_no AND p.deleted=0\r\nWHERE 1=1 \r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN TRIM('{ponum}')='' THEN 1=1\r\n\t\t\tELSE LOCATE(TRIM('{ponum}'),s1.xm_no)>0\r\n\t\tEND) \r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{bizhong}' IN ('','1,7','7,1') OR '{bizhong}'=(SELECT GROUP_CONCAT(id) FROM ld_currency_info WHERE deleted=0 AND currency_status='Active') THEN 1=1\r\n\t\t\tELSE FIND_IN_SET(q.currency_id,'{bizhong}')\r\n\t\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{main_item}'='true' THEN \r\n\t\t\t\t(\r\n\t\t\t\t\tCASE \r\n\t\t\t\t\t\tWHEN r.exists_zhu=1 AND s4.quote_id>0 AND t.sf11627='Y' THEN 'yes' \r\n\t\t\t\t\t\tWHEN IFNULL(r.exists_zhu,0)=0 AND s4.quote_id>0 AND r.minid>0 AND o.lineitem_id=r.minid THEN 'yes'\r\n\t\t\t\t\t\tWHEN IFNULL(r.exists_zhu,0)=0 AND IFNULL(s4.quote_id,0)=0 AND xmcp.product_no=cp.product_no AND xmcp.product_no IS NOT NULL THEN 'yes'\r\n\t\t\t\t\t\tWHEN IFNULL(r.exists_zhu,0)=0 AND IFNULL(s4.quote_id,0)=0 AND xmcp.product_no IS NULL THEN 'yes'\r\n\t\t\t\t\t\tELSE NULL \r\n\t\t\t\t\tEND\r\n\t\t\t\t)='yes'\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN s4.xm_no IS NOT NULL THEN s4.is_defshow\r\n\t\t\t\t\t\tWHEN s3.xm_no IS NOT NULL THEN s3.is_defshow\r\n\t\t\t\t\t\tWHEN s2.xm_no IS NOT NULL THEN s2.is_defshow\r\n\t\t\t\t\t\tELSE s1.is_defshow\r\n\t\t\t\t\tEND\r\n\t\t\t\t)='yes'\r\n\t\t\tELSE 1=1\r\n\t\tEND)\r\n) tmp\r\nWHERE 1=1\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_users WHERE id='[uuid]' AND userlevel IN ('管理员','总经理','副总经理','总监')) THEN 1=1\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_users WHERE id='[uuid]' AND userlevel IN ('普通成员')) THEN\r\n\t\t\t\townerid_s1='[uuid]' OR ownerid_s2='[uuid]' OR ownerid_s3='[uuid]' OR ownerid_s4='[uuid]' OR FIND_IN_SET('[uuid]',00_shareids)\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_users WHERE id='[uuid]' AND userlevel IN ('部门经理')) THEN\r\n\t\t\t\townerid_s1 IN (SELECT userid FROM ld_users2group WHERE groupid IN (SELECT groupid FROM ld_users2group WHERE userid='[uuid]'))\r\n\t\t\t\tOR ownerid_s2 IN (SELECT userid FROM ld_users2group WHERE groupid IN (SELECT groupid FROM ld_users2group WHERE userid='[uuid]'))\r\n\t\t\t\tOR ownerid_s3 IN (SELECT userid FROM ld_users2group WHERE groupid IN (SELECT groupid FROM ld_users2group WHERE userid='[uuid]'))\t\r\n\t\t\t\tOR ownerid_s4 IN (SELECT userid FROM ld_users2group WHERE groupid IN (SELECT groupid FROM ld_users2group WHERE userid='[uuid]'))\t\t\r\n\t\t\t\tOR FIND_IN_SET('[uuid]',00_shareids)\r\n\t\t\tELSE 0=1\r\n\t\tEND)\r\nORDER BY 03_status_seq,FIELD(03_status,'S4','EOL','S3','S2','S1'),02_no"
      },
      "2": {
        "Ident": "StiMySqlSource",
