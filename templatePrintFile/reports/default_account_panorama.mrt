          },
          "10": {
            "Name": "Salesordercount",
            "Index": -1,
            "NameInSource": "Salesordercount",
            "Alias": "Salesordercount",
            "Type": "System.Decimal"
          },
          "11": {
            "Name": "ServiceContractscount",
            "Index": -1,
            "NameInSource": "ServiceContractscount",
            "Alias": "ServiceContractscount",
            "Type": "System.Decimal"
          },
          "12": {
            "Name": "cashbilltotalsum",
            "Index": -1,
            "NameInSource": "cashbilltotalsum",
            "Alias": "cashbilltotalsum",
            "Type": "System.Decimal"
          },
          "13": {
            "Name": "salesordertotalsum",
            "Index": -1,
            "NameInSource": "salesordertotalsum",
            "Alias": "salesordertotalsum",
            "Type": "System.Decimal"
          },
          "14": {
            "Name": "servicecontractstotalsum",
            "Index": -1,
            "NameInSource": "servicecontractstotalsum",
            "Alias": "servicecontractstotalsum",
            "Type": "System.Decimal"
          },
          "15": {
            "Name": "expensetotalsum",
            "Index": -1,
            "NameInSource": "expensetotalsum",
            "Alias": "expensetotalsum",
            "Type": "System.Decimal"
          }
        },
        "NameInSource": "Connection1",
        "SqlCommand": "SELECT ld_account.accountid,ld_users.last_name,ld_account.smownerid,accountname,sum(IFNULL(contactcount,0)) as contactcount,sum(IFNULL(potentialcount,0)) as potentialcount,\r\nsum(IFNULL(Calendarcount,0)) as Calendarcount,sum(IFNULL(ContactRecordscount,0)) as ContactRecordscount,sum(IFNULL(HelpDeskcount,0)) as HelpDeskcount,\r\nsum(IFNULL(CashBillcount,0)) as CashBillcount,sum(IFNULL(Salesordercount,0)) as Salesordercount,sum(IFNULL(ServiceContractscount,0)) as ServiceContractscount,\r\nsum(IFNULL(cashbilltotalsum,0)) as cashbilltotalsum,sum(IFNULL(salesordertotalsum,0)) as salesordertotalsum,\r\nsum(IFNULL(round(servicecontractstotalsum,2),0)) as servicecontractstotalsum,sum(IFNULL(round(expensetotalsum,2),0)) as expensetotalsum\r\nFROM ld_account LEFT JOIN (\r\n\tSELECT count(1) AS contactcount,smownerid,accountid FROM ld_contactdetails WHERE deleted = 0\r\nand CONCAT('全部',\r\n'/',CASE WHEN YEAR(ld_contactdetails.createdtime)=YEAR(CURDATE()) THEN '本年' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_contactdetails.createdtime)=YEAR(CURDATE())-1 THEN '去年' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_contactdetails.createdtime)=YEAR(CURDATE()) AND MONTH(ld_contactdetails.createdtime)=MONTH(CURDATE()) THEN '本月' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_contactdetails.createdtime)=YEAR(CURDATE()) AND MONTH(ld_contactdetails.createdtime)=MONTH(CURDATE())-1 THEN '上月' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_contactdetails.createdtime)=YEAR(CURDATE()) AND WEEK(ld_contactdetails.createdtime)=WEEK(CURDATE()) THEN '本周' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_contactdetails.createdtime)=YEAR(CURDATE()) AND WEEK(ld_contactdetails.createdtime)=WEEK(CURDATE())-1 THEN '上周' ELSE '' END,\r\n'/',CASE WHEN DATE_FORMAT(ld_contactdetails.createdtime,'%Y-%m-%d')=DATE_FORMAT(CURDATE(),'%Y-%m-%d') THEN '今天' ELSE '' END,\r\n'/',CASE WHEN DATE_FORMAT(ld_contactdetails.createdtime,'%Y-%m-%d')=DATE_FORMAT(DATE_SUB(CURDATE(),INTERVAL 1 day),'%Y-%m-%d') THEN '昨天' ELSE '' END) like '%{createdtime}%'\r\n\tGROUP BY accountid\r\n) AS contacttable ON contacttable.accountid = ld_account.accountid\r\nLEFT JOIN (\r\n\tSELECT count(1) AS potentialcount,smownerid,accountid FROM ld_potential WHERE deleted = 0\r\nand CONCAT('全部',\r\n'/',CASE WHEN YEAR(ld_potential.createdtime)=YEAR(CURDATE()) THEN '本年' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_potential.createdtime)=YEAR(CURDATE())-1 THEN '去年' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_potential.createdtime)=YEAR(CURDATE()) AND MONTH(ld_potential.createdtime)=MONTH(CURDATE()) THEN '本月' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_potential.createdtime)=YEAR(CURDATE()) AND MONTH(ld_potential.createdtime)=MONTH(CURDATE())-1 THEN '上月' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_potential.createdtime)=YEAR(CURDATE()) AND WEEK(ld_potential.createdtime)=WEEK(CURDATE()) THEN '本周' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_potential.createdtime)=YEAR(CURDATE()) AND WEEK(ld_potential.createdtime)=WEEK(CURDATE())-1 THEN '上周' ELSE '' END,\r\n'/',CASE WHEN DATE_FORMAT(ld_potential.createdtime,'%Y-%m-%d')=DATE_FORMAT(CURDATE(),'%Y-%m-%d') THEN '今天' ELSE '' END,\r\n'/',CASE WHEN DATE_FORMAT(ld_potential.createdtime,'%Y-%m-%d')=DATE_FORMAT(DATE_SUB(CURDATE(),INTERVAL 1 day),'%Y-%m-%d') THEN '昨天' ELSE '' END) like '%{createdtime}%'\r\n\tGROUP BY accountid\r\n)AS potentialtable ON potentialtable.accountid = ld_account.accountid\r\nLEFT JOIN (\r\n\tSELECT count(1) AS Calendarcount,smownerid,accountid FROM ld_activity WHERE deleted = 0 and activitytype<>'Emails'\r\nand CONCAT('全部',\r\n'/',CASE WHEN YEAR(ld_activity.date_start)=YEAR(CURDATE()) THEN '本年' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_activity.date_start)=YEAR(CURDATE())-1 THEN '去年' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_activity.date_start)=YEAR(CURDATE()) AND MONTH(ld_activity.date_start)=MONTH(CURDATE()) THEN '本月' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_activity.date_start)=YEAR(CURDATE()) AND MONTH(ld_activity.date_start)=MONTH(CURDATE())-1 THEN '上月' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_activity.date_start)=YEAR(CURDATE()) AND WEEK(ld_activity.date_start)=WEEK(CURDATE()) THEN '本周' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_activity.date_start)=YEAR(CURDATE()) AND WEEK(ld_activity.date_start)=WEEK(CURDATE())-1 THEN '上周' ELSE '' END,\r\n'/',CASE WHEN DATE_FORMAT(ld_activity.date_start,'%Y-%m-%d')=DATE_FORMAT(CURDATE(),'%Y-%m-%d') THEN '今天' ELSE '' END,\r\n'/',CASE WHEN DATE_FORMAT(ld_activity.date_start,'%Y-%m-%d')=DATE_FORMAT(DATE_SUB(CURDATE(),INTERVAL 1 day),'%Y-%m-%d') THEN '昨天' ELSE '' END) like '%{createdtime}%'\r\n\tGROUP BY accountid\r\n)AS Calendartable ON Calendartable.accountid = ld_account.accountid\r\nLEFT JOIN (\r\n\tSELECT count(1) AS ContactRecordscount,smownerid,accountid FROM ld_contactrecords WHERE deleted = 0\r\nand CONCAT('全部',\r\n'/',CASE WHEN YEAR(ld_contactrecords.contactdate)=YEAR(CURDATE()) THEN '本年' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_contactrecords.contactdate)=YEAR(CURDATE())-1 THEN '去年' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_contactrecords.contactdate)=YEAR(CURDATE()) AND MONTH(ld_contactrecords.contactdate)=MONTH(CURDATE()) THEN '本月' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_contactrecords.contactdate)=YEAR(CURDATE()) AND MONTH(ld_contactrecords.contactdate)=MONTH(CURDATE())-1 THEN '上月' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_contactrecords.contactdate)=YEAR(CURDATE()) AND WEEK(ld_contactrecords.contactdate)=WEEK(CURDATE()) THEN '本周' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_contactrecords.contactdate)=YEAR(CURDATE()) AND WEEK(ld_contactrecords.contactdate)=WEEK(CURDATE())-1 THEN '上周' ELSE '' END,\r\n'/',CASE WHEN DATE_FORMAT(ld_contactrecords.contactdate,'%Y-%m-%d')=DATE_FORMAT(CURDATE(),'%Y-%m-%d') THEN '今天' ELSE '' END,\r\n'/',CASE WHEN DATE_FORMAT(ld_contactrecords.contactdate,'%Y-%m-%d')=DATE_FORMAT(DATE_SUB(CURDATE(),INTERVAL 1 day),'%Y-%m-%d') THEN '昨天' ELSE '' END) like '%{createdtime}%'\r\n\tGROUP BY accountid\r\n)AS ContactRecordstable ON ContactRecordstable.accountid = ld_account.accountid\r\nLEFT JOIN (\r\n\tSELECT count(1) AS HelpDeskcount,smownerid,accountid FROM ld_troubletickets WHERE deleted = 0\r\nand CONCAT('全部',\r\n'/',CASE WHEN YEAR(ld_troubletickets.realtime)=YEAR(CURDATE()) THEN '本年' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_troubletickets.realtime)=YEAR(CURDATE())-1 THEN '去年' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_troubletickets.realtime)=YEAR(CURDATE()) AND MONTH(ld_troubletickets.realtime)=MONTH(CURDATE()) THEN '本月' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_troubletickets.realtime)=YEAR(CURDATE()) AND MONTH(ld_troubletickets.realtime)=MONTH(CURDATE())-1 THEN '上月' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_troubletickets.realtime)=YEAR(CURDATE()) AND WEEK(ld_troubletickets.realtime)=WEEK(CURDATE()) THEN '本周' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_troubletickets.realtime)=YEAR(CURDATE()) AND WEEK(ld_troubletickets.realtime)=WEEK(CURDATE())-1 THEN '上周' ELSE '' END,\r\n'/',CASE WHEN DATE_FORMAT(ld_troubletickets.realtime,'%Y-%m-%d')=DATE_FORMAT(CURDATE(),'%Y-%m-%d') THEN '今天' ELSE '' END,\r\n'/',CASE WHEN DATE_FORMAT(ld_troubletickets.realtime,'%Y-%m-%d')=DATE_FORMAT(DATE_SUB(CURDATE(),INTERVAL 1 day),'%Y-%m-%d') THEN '昨天' ELSE '' END) like '%{createdtime}%'\r\n\tGROUP BY accountid\r\n)AS HelpDesktable ON HelpDesktable.accountid = ld_account.accountid\r\nLEFT JOIN (\r\n\tSELECT count(1) AS CashBillcount,smownerid,accountid FROM ld_cashbill WHERE deleted = 0\r\n\tand IF(ld_cashbill.checkoutstatus='已审核','0','1') <> (IF('{approve}'='true','1','0.001'))\r\n\tand CONCAT('全部',\r\n'/',CASE WHEN YEAR(ld_cashbill.cashbilldate)=YEAR(CURDATE()) THEN '本年' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_cashbill.cashbilldate)=YEAR(CURDATE())-1 THEN '去年' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_cashbill.cashbilldate)=YEAR(CURDATE()) AND MONTH(ld_cashbill.cashbilldate)=MONTH(CURDATE()) THEN '本月' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_cashbill.cashbilldate)=YEAR(CURDATE()) AND MONTH(ld_cashbill.cashbilldate)=MONTH(CURDATE())-1 THEN '上月' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_cashbill.cashbilldate)=YEAR(CURDATE()) AND WEEK(ld_cashbill.cashbilldate)=WEEK(CURDATE()) THEN '本周' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_cashbill.cashbilldate)=YEAR(CURDATE()) AND WEEK(ld_cashbill.cashbilldate)=WEEK(CURDATE())-1 THEN '上周' ELSE '' END,\r\n'/',CASE WHEN DATE_FORMAT(ld_cashbill.cashbilldate,'%Y-%m-%d')=DATE_FORMAT(CURDATE(),'%Y-%m-%d') THEN '今天' ELSE '' END,\r\n'/',CASE WHEN DATE_FORMAT(ld_cashbill.cashbilldate,'%Y-%m-%d')=DATE_FORMAT(DATE_SUB(CURDATE(),INTERVAL 1 day),'%Y-%m-%d') THEN '昨天' ELSE '' END) like '%{createdtime}%'\r\n\tGROUP BY accountid\r\n)AS CashBilltable ON CashBilltable.accountid = ld_account.accountid\r\nLEFT JOIN (\r\n\tSELECT count(1) AS Salesordercount,smownerid,accountid FROM ld_salesorder WHERE deleted = 0\r\nand IF(ld_salesorder.approvestatus='已批准','0','1') <> (IF('{approve}'='true','1','0.001'))\r\nand CONCAT('全部',\r\n'/',CASE WHEN YEAR(ld_salesorder.signed_data)=YEAR(CURDATE()) THEN '本年' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_salesorder.signed_data)=YEAR(CURDATE())-1 THEN '去年' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_salesorder.signed_data)=YEAR(CURDATE()) AND MONTH(ld_salesorder.signed_data)=MONTH(CURDATE()) THEN '本月' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_salesorder.signed_data)=YEAR(CURDATE()) AND MONTH(ld_salesorder.signed_data)=MONTH(CURDATE())-1 THEN '上月' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_salesorder.signed_data)=YEAR(CURDATE()) AND WEEK(ld_salesorder.signed_data)=WEEK(CURDATE()) THEN '本周' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_salesorder.signed_data)=YEAR(CURDATE()) AND WEEK(ld_salesorder.signed_data)=WEEK(CURDATE())-1 THEN '上周' ELSE '' END,\r\n'/',CASE WHEN DATE_FORMAT(ld_salesorder.signed_data,'%Y-%m-%d')=DATE_FORMAT(CURDATE(),'%Y-%m-%d') THEN '今天' ELSE '' END,\r\n'/',CASE WHEN DATE_FORMAT(ld_salesorder.signed_data,'%Y-%m-%d')=DATE_FORMAT(DATE_SUB(CURDATE(),INTERVAL 1 day),'%Y-%m-%d') THEN '昨天' ELSE '' END) like '%{createdtime}%'\r\n\tGROUP BY accountid\r\n)AS Salesordertable ON Salesordertable.accountid = ld_account.accountid\r\nLEFT JOIN (\r\n\tSELECT count(1) AS ServiceContractscount,smownerid,accountid FROM ld_servicecontracts WHERE deleted = 0\r\nand IF(ld_servicecontracts.approvestatus='已批准','0','1') <> (IF('{approve}'='true','1','0.001'))\r\nand CONCAT('全部',\r\n'/',CASE WHEN YEAR(ld_servicecontracts.due_date)=YEAR(CURDATE()) THEN '本年' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_servicecontracts.due_date)=YEAR(CURDATE())-1 THEN '去年' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_servicecontracts.due_date)=YEAR(CURDATE()) AND MONTH(ld_servicecontracts.due_date)=MONTH(CURDATE()) THEN '本月' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_servicecontracts.due_date)=YEAR(CURDATE()) AND MONTH(ld_servicecontracts.due_date)=MONTH(CURDATE())-1 THEN '上月' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_servicecontracts.due_date)=YEAR(CURDATE()) AND WEEK(ld_servicecontracts.due_date)=WEEK(CURDATE()) THEN '本周' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_servicecontracts.due_date)=YEAR(CURDATE()) AND WEEK(ld_servicecontracts.due_date)=WEEK(CURDATE())-1 THEN '上周' ELSE '' END,\r\n'/',CASE WHEN DATE_FORMAT(ld_servicecontracts.due_date,'%Y-%m-%d')=DATE_FORMAT(CURDATE(),'%Y-%m-%d') THEN '今天' ELSE '' END,\r\n'/',CASE WHEN DATE_FORMAT(ld_servicecontracts.due_date,'%Y-%m-%d')=DATE_FORMAT(DATE_SUB(CURDATE(),INTERVAL 1 day),'%Y-%m-%d') THEN '昨天' ELSE '' END) like '%{createdtime}%'\r\n\tGROUP BY accountid\r\n)AS ServiceContractstable ON ServiceContractstable.accountid = ld_account.accountid\r\nLEFT JOIN (\r\n\tSELECT sum(if(ld_cashbill.currency_id > 1,IFNULL(total,0)/ld_cashbill.conversion_rate,IFNULL(total,0))) as cashbilltotalsum,\r\nsmownerid,accountid FROM ld_cashbill WHERE deleted = 0\r\nand IF(ld_cashbill.checkoutstatus='已审核','0','1') <> (IF('{approve}'='true','1','0.001'))\r\nand CONCAT('全部',\r\n'/',CASE WHEN YEAR(ld_cashbill.cashbilldate)=YEAR(CURDATE()) THEN '本年' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_cashbill.cashbilldate)=YEAR(CURDATE())-1 THEN '去年' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_cashbill.cashbilldate)=YEAR(CURDATE()) AND MONTH(ld_cashbill.cashbilldate)=MONTH(CURDATE()) THEN '本月' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_cashbill.cashbilldate)=YEAR(CURDATE()) AND MONTH(ld_cashbill.cashbilldate)=MONTH(CURDATE())-1 THEN '上月' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_cashbill.cashbilldate)=YEAR(CURDATE()) AND WEEK(ld_cashbill.cashbilldate)=WEEK(CURDATE()) THEN '本周' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_cashbill.cashbilldate)=YEAR(CURDATE()) AND WEEK(ld_cashbill.cashbilldate)=WEEK(CURDATE())-1 THEN '上周' ELSE '' END,\r\n'/',CASE WHEN DATE_FORMAT(ld_cashbill.cashbilldate,'%Y-%m-%d')=DATE_FORMAT(CURDATE(),'%Y-%m-%d') THEN '今天' ELSE '' END,\r\n'/',CASE WHEN DATE_FORMAT(ld_cashbill.cashbilldate,'%Y-%m-%d')=DATE_FORMAT(DATE_SUB(CURDATE(),INTERVAL 1 day),'%Y-%m-%d') THEN '昨天' ELSE '' END) like '%{createdtime}%'\r\n\tGROUP BY accountid\r\n)AS cashbilltotal ON cashbilltotal.accountid = ld_account.accountid\r\nLEFT JOIN (\r\n\tSELECT sum(if(ld_salesorder.currency_id > 1,IFNULL(total,0)/ld_salesorder.conversion_rate,IFNULL(total,0))) as salesordertotalsum,\r\nsmownerid,accountid FROM ld_salesorder WHERE deleted = 0\r\nand IF(ld_salesorder.approvestatus='已批准','0','1') <> (IF('{approve}'='true','1','0.001'))\r\nand CONCAT('全部',\r\n'/',CASE WHEN YEAR(ld_salesorder.signed_data)=YEAR(CURDATE()) THEN '本年' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_salesorder.signed_data)=YEAR(CURDATE())-1 THEN '去年' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_salesorder.signed_data)=YEAR(CURDATE()) AND MONTH(ld_salesorder.signed_data)=MONTH(CURDATE()) THEN '本月' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_salesorder.signed_data)=YEAR(CURDATE()) AND MONTH(ld_salesorder.signed_data)=MONTH(CURDATE())-1 THEN '上月' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_salesorder.signed_data)=YEAR(CURDATE()) AND WEEK(ld_salesorder.signed_data)=WEEK(CURDATE()) THEN '本周' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_salesorder.signed_data)=YEAR(CURDATE()) AND WEEK(ld_salesorder.signed_data)=WEEK(CURDATE())-1 THEN '上周' ELSE '' END,\r\n'/',CASE WHEN DATE_FORMAT(ld_salesorder.signed_data,'%Y-%m-%d')=DATE_FORMAT(CURDATE(),'%Y-%m-%d') THEN '今天' ELSE '' END,\r\n'/',CASE WHEN DATE_FORMAT(ld_salesorder.signed_data,'%Y-%m-%d')=DATE_FORMAT(DATE_SUB(CURDATE(),INTERVAL 1 day),'%Y-%m-%d') THEN '昨天' ELSE '' END) like '%{createdtime}%'\r\n\tGROUP BY accountid\r\n)AS salesordertotal ON salesordertotal.accountid = ld_account.accountid\r\nLEFT JOIN (\r\n\tSELECT sum(if(ld_servicecontracts.currency_id > 1,IFNULL(total,0)/ld_servicecontracts.conversion_rate,IFNULL(total,0))) as servicecontractstotalsum,\r\nsmownerid,accountid FROM ld_servicecontracts WHERE deleted = 0\r\nand IF(ld_servicecontracts.approvestatus='已批准','0','1') <> (IF('{approve}'='true','1','0.001'))\r\nand CONCAT('全部',\r\n'/',CASE WHEN YEAR(ld_servicecontracts.due_date)=YEAR(CURDATE()) THEN '本年' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_servicecontracts.due_date)=YEAR(CURDATE())-1 THEN '去年' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_servicecontracts.due_date)=YEAR(CURDATE()) AND MONTH(ld_servicecontracts.due_date)=MONTH(CURDATE()) THEN '本月' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_servicecontracts.due_date)=YEAR(CURDATE()) AND MONTH(ld_servicecontracts.due_date)=MONTH(CURDATE())-1 THEN '上月' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_servicecontracts.due_date)=YEAR(CURDATE()) AND WEEK(ld_servicecontracts.due_date)=WEEK(CURDATE()) THEN '本周' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_servicecontracts.due_date)=YEAR(CURDATE()) AND WEEK(ld_servicecontracts.due_date)=WEEK(CURDATE())-1 THEN '上周' ELSE '' END,\r\n'/',CASE WHEN DATE_FORMAT(ld_servicecontracts.due_date,'%Y-%m-%d')=DATE_FORMAT(CURDATE(),'%Y-%m-%d') THEN '今天' ELSE '' END,\r\n'/',CASE WHEN DATE_FORMAT(ld_servicecontracts.due_date,'%Y-%m-%d')=DATE_FORMAT(DATE_SUB(CURDATE(),INTERVAL 1 day),'%Y-%m-%d') THEN '昨天' ELSE '' END) like '%{createdtime}%'\r\n\tGROUP BY accountid\r\n)AS servicecontractstotal ON servicecontractstotal.accountid = ld_account.accountid\r\nLEFT JOIN (\r\n\tSELECT sum(if(ld_expense.currency_id > 1,IFNULL(total,0)/ld_expense.conversion_rate,IFNULL(total,0))) as expensetotalsum,\r\nsmownerid,accountid FROM ld_expense WHERE deleted = 0\r\nand IF(ld_expense.approvestatus='已批准','0','1') <> (IF('{approve}'='true','1','0.001'))\r\nand CONCAT('全部',\r\n'/',CASE WHEN YEAR(ld_expense.expensedate)=YEAR(CURDATE()) THEN '本年' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_expense.expensedate)=YEAR(CURDATE())-1 THEN '去年' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_expense.expensedate)=YEAR(CURDATE()) AND MONTH(ld_expense.expensedate)=MONTH(CURDATE()) THEN '本月' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_expense.expensedate)=YEAR(CURDATE()) AND MONTH(ld_expense.expensedate)=MONTH(CURDATE())-1 THEN '上月' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_expense.expensedate)=YEAR(CURDATE()) AND WEEK(ld_expense.expensedate)=WEEK(CURDATE()) THEN '本周' ELSE '' END,\r\n'/',CASE WHEN YEAR(ld_expense.expensedate)=YEAR(CURDATE()) AND WEEK(ld_expense.expensedate)=WEEK(CURDATE())-1 THEN '上周' ELSE '' END,\r\n'/',CASE WHEN DATE_FORMAT(ld_expense.expensedate,'%Y-%m-%d')=DATE_FORMAT(CURDATE(),'%Y-%m-%d') THEN '今天' ELSE '' END,\r\n'/',CASE WHEN DATE_FORMAT(ld_expense.expensedate,'%Y-%m-%d')=DATE_FORMAT(DATE_SUB(CURDATE(),INTERVAL 1 day),'%Y-%m-%d') THEN '昨天' ELSE '' END) like '%{createdtime}%'\r\n\tGROUP BY accountid\r\n)AS expensetotal ON expensetotal.accountid = ld_account.accountid \r\nLEFT JOIN ld_users on ld_account.smownerid=ld_users.id\r\nwhere  ld_account.deleted=0\r\n\tAND(\r\n\t\tCASE \r\n\t\t\tWHEN '{AcountName}' !='' THEN accountname like '%{AcountName}%' \r\n\t\t\tELSE (accountname like '%%' or ifnull(accountname,'')='') \r\n\tEND)\r\n\t\t\t\t\t\tand (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{userid}'='' THEN \r\n\t\t\t\t\t\t\t\tFIND_IN_SET(CASE WHEN ld_account.smownerid is NULL THEN 1 ELSE ld_account.smownerid END,(\r\n\t\t\t\t\t\t\t\t\tSELECT\r\n\t\t\t\t\t\t\t\t\t\tGROUP_CONCAT(userid)\r\n\t\t\t\t\t\t\t\t\tFROM (\r\n\t\t\t\t\t\t\t\t\t\tSELECT DISTINCT\r\n\t\t\t\t\t\t\t\t\t\t\tuserid \r\n\t\t\t\t\t\t\t\t\t\tFROM (\r\n\t\t\t\t\t\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\t\t\t\t\t\tld_users.id as userid \r\n\t\t\t\t\t\t\t\t\t\t\tFROM ld_users\r\n\t\t\t\t\t\t\t\t\t\t\tWHERE EXISTS(select 1 from ld_setscoperhigher where modulename='Accounts' and scopeauthority=1 and userid='[uuid]')\r\n\t\t\t\t\t\t\t\t\t\t\tUNION\r\n\t\t\t\t\t\t\t\t\t\t\tselect \r\n\t\t\t\t\t\t\t\t\t\t\t\tviewid as userid \r\n\t\t\t\t\t\t\t\t\t\t\tfrom ld_scoperhigher\r\n\t\t\t\t\t\t\t\t\t\t\twhere userid='[uuid]' and modulename='Accounts' and EXISTS(select 1 from ld_setscoperhigher where userid='[uuid]' and scopeauthority=2 and modulename='Accounts')\t\t\t\r\n\t\t\t\t\t\t\t\t\t\t\tUNION\r\n\t\t\t\t\t\t\t\t\t\t\tselect DISTINCT \r\n\t\t\t\t\t\t\t\t\t\t\t\tld_users2group.userid as userid \r\n\t\t\t\t\t\t\t\t\t\t\tfrom ld_scoperhigher \r\n\t\t\t\t\t\t\t\t\t\t\tINNER JOIN ld_groups on ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\t\t\t\t\t\t\t\t\tINNER JOIN ld_users2group on ld_users2group.groupid=ld_groups.groupid\r\n\t\t\t\t\t\t\t\t\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\t\t\t\t\t\t\t\t\tand ld_scoperhigher.modulename='Accounts'\r\n\t\t\t\t\t\t\t\t\t\t\t\tand ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\t\t\t\t\t\t\t\t\tand EXISTS(select 1 from ld_setscoperhigher where modulename='Accounts' and scopeauthority=3 and userid='[uuid]')\r\n\t\t\t\t\t\t\t\t\t\t\tUNION \r\n\t\t\t\t\t\t\t\t\t\t\tselect \r\n\t\t\t\t\t\t\t\t\t\t\t\tid as userid \r\n\t\t\t\t\t\t\t\t\t\t\tfrom ld_users  \r\n\t\t\t\t\t\t\t\t\t\t\twhere exists(select 1 from ld_users where id='[uuid]' and is_admin='on')\r\n\t\t\t\t\t\t\t\t\t\t\tUNION\r\n\t\t\t\t\t\t\t\t\t\t\tselect '[uuid]')as vw_users\r\n\t\t\t\t\t\t\t\t\t) as tmp_users))\r\n\t\t\t\t\t\t\tELSE FIND_IN_SET(CASE WHEN ld_account.smownerid is NULL THEN 1 ELSE ld_account.smownerid END,'{userid}')\r\n\t\t\t\t\t\tEND)\r\n\tAND IFNULL(contactcount,0)+IFNULL(potentialcount,0)+IFNULL(Calendarcount,0)+IFNULL(ContactRecordscount,0)+IFNULL(HelpDeskcount,0)+IFNULL(CashBillcount,0)+IFNULL(Salesordercount,0)+IFNULL(ServiceContractscount,0)+IFNULL(cashbilltotalsum,0)+IFNULL(salesordertotalsum,0)+IFNULL(round(servicecontractstotalsum,2),0)+IFNULL(round(expensetotalsum,2),0)<>0\r\n\tAND (\r\n\t\t\tCASE \r\n\t\t\t\tWHEN '{salesorderTotalend}'>0 THEN salesordertotalsum>=IFNULL('{salesorderTotalbegin}',0) AND salesordertotalsum<='{salesorderTotalend}' \r\n\tELSE 1=1\r\n\t\tEND\r\n\t)"
      },
