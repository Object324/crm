          }
        },
        "NameInSource": "crm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\tb.lastname AS key_guys,\r\n\tb.title AS gangwei,\r\n\tb.department AS decision_leverl,\r\n\tc.cf_3642 AS pain_point,\r\n\te.potentialname,\r\n\ta.accountname\r\nFROM ld_potential e\r\nLEFT JOIN ld_account a ON a.accountid=e.accountid\r\nLEFT JOIN ld_contactdetails b ON b.accountid=a.accountid\r\nLEFT JOIN ld_contactscf c ON c.contactid=b.contactid\r\nLEFT JOIN ld_customform51 d ON d.potentialid=e.potentialid\r\nWHERE (d.customform51id='[related_ldcrmid]' OR e.potentialid='[related_ldcrmid]')\r\nORDER BY b.reference DESC,CONVERT(b.lastname USING GBK);"
      }
    },
