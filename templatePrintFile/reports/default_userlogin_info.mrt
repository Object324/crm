  "PreviewSettings": 268435455,
  "Dictionary": {
    "Variables": {
      "0": {
        "Value": "Today",
        "Name": "start_date",
        "Alias": "参考日期",
        "Type": "System.DateTime",
        "RequestFromUser": true,
        "InitBy": "Expression"
      },
      "1": {
        "Value": "全部",
        "Name": "login_type",
        "DialogInfo": {
          "DateTimeType": "DateAndTime",
          "Keys": {
            "0": "全部",
            "1": "企业微信"
          },
          "Values": {
            "0": "全部",
            "1": "企业微信"
          }
        },
        "Alias": "登录方式",
        "Type": "System.String",
        "RequestFromUser": true
      }
    },
    "DataSources": {
      "0": {
        "Ident": "StiMySqlSource",
        "Name": "a",
        "Alias": "a",
        "Columns": {
          "0": {
            "Name": "chart_type",
            "Index": -1,
            "NameInSource": "chart_type",
            "Alias": "chart_type",
            "Type": "System.String"
          },
          "1": {
            "Name": "chart_value",
            "Index": -1,
            "NameInSource": "chart_value",
            "Alias": "chart_value",
            "Type": "System.Int32"
          },
          "2": {
            "Name": "myshow",
            "Index": -1,
            "NameInSource": "myshow",
            "Alias": "myshow",
            "Type": "System.String"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\tchart_type,\r\n\tchart_value,\r\n\tCONCAT('总人数:',IFNULL(total,0),'\\n使用人数:',IFNULL(chart_value,0),'\\n未使用人数:',IFNULL(total,0)-IFNULL(chart_value,0)) AS myshow\r\nFROM (\r\n\tSELECT\r\n\t\tlogin_day AS chart_type,\r\n\t\tlogin_cnt AS chart_value,\r\n\t\t(\r\n\t\t\tSELECT \r\n\t\t\t\tCOUNT(id) \r\n\t\t\tFROM ld_users \r\n\t\t\tWHERE deleted=0 \r\n\t\t\t\tAND status='Active' \r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE \r\n\t\t\t\t\t\tWHEN '{login_type}'='企业微信' THEN TRIM(IFNULL(wx_userid,''))<>''\r\n\t\t\t\t\t\tELSE 1=1\r\n\t\t\t\t\tEND)\r\n\t\t) AS total\r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\tDATE_FORMAT(a.login_time,'%m-%d') AS login_day,\r\n\t\t\tCOUNT(DISTINCT a.user_name) AS login_cnt\r\n\t\tFROM ld_loginhistory a\r\n\t\tWHERE 1=1\r\n\t\t\tAND a.login_time BETWEEN DATE_SUB(DATE_FORMAT('{start_date}','%Y-%m-%d 00:00:00'),INTERVAL 29 DAY) AND DATE_FORMAT('{start_date}','%Y-%m-%d 23:59:59')\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{login_type}'='企业微信' THEN a.login_type='qiyeweixin'\r\n\t\t\t\t\tELSE 1=1\r\n\t\t\t\tEND)\r\n\t\tGROUP BY DATE_FORMAT(a.login_time,'%Y-%m-%d')\r\n\t) a\r\n) tmp"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "b",
        "Alias": "b",
        "Columns": {
          "0": {
            "Name": "groupname",
            "Index": -1,
            "NameInSource": "groupname",
            "Alias": "groupname",
            "Type": "System.String"
          },
          "1": {
            "Name": "last_name",
            "Index": -1,
            "NameInSource": "last_name",
            "Alias": "last_name",
            "Type": "System.String"
          },
          "2": {
            "Name": "login_day",
            "Index": -1,
            "NameInSource": "login_day",
            "Alias": "login_day",
            "Type": "System.String"
          },
          "3": {
            "Name": "user_name",
            "Index": -1,
            "NameInSource": "user_name",
            "Alias": "user_name",
            "Type": "System.String"
          },
          "4": {
            "Name": "user_type",
            "Index": -1,
            "NameInSource": "user_type",
            "Alias": "user_type",
            "Type": "System.String"
          }
        },
        "NameInSource": "ldcrm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\tCASE\r\n\t\tWHEN b.user_name IS NULL THEN '未使用'\r\n\t\tELSE '有使用'\r\n\tEND AS user_type,\r\n\ta.last_name,\r\n\ta.user_name,\r\n\tb.login_day,\r\n\tg.groupname\r\nFROM ld_users a\r\nLEFT JOIN (\r\n\tSELECT \r\n\t\ta.user_name,\r\n\t\tDATE_FORMAT(a.login_time,'%m-%d') AS login_day\r\n\tFROM ld_loginhistory a\r\n\tWHERE 1=1\r\n\t\tAND a.login_time BETWEEN DATE_SUB(DATE_FORMAT('{start_date}','%Y-%m-%d 00:00:00'),INTERVAL 29 DAY) AND DATE_FORMAT('{start_date}','%Y-%m-%d 23:59:59')\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{login_type}'='企业微信' THEN a.login_type='qiyeweixin'\r\n\t\t\t\tELSE 1=1\r\n\t\t\tEND)\r\n\t\tAND DATE_FORMAT(a.login_time,'%m-%d')='{this[\"SeriesArgument\"]}'\r\n\tGROUP BY a.user_name,DATE_FORMAT(a.login_time,'%Y-%m-%d')\r\n) b ON b.user_name=a.user_name\r\nLEFT JOIN(\r\n\tSELECT\r\n\t\ta.userid,\r\n\t\tGROUP_CONCAT(b.groupname ORDER BY b.depth) AS groupname,\r\n\t\tMIN(b.depth) AS depth\r\n\tFROM ld_users2group a\r\n\tLEFT JOIN ld_groups b ON b.groupid=a.groupid\r\n\tWHERE 1=1\r\n\tGROUP BY a.userid\r\n) g ON g.userid=a.id\r\nWHERE a.deleted=0 \r\n\tAND a.status='Active'\r\n\tAND (\r\n\t\tCASE \r\n\t\t\tWHEN '{login_type}'='企业微信' THEN TRIM(IFNULL(a.wx_userid,''))<>''\r\n\t\t\tELSE 1=1\r\n\t\tEND)\r\nORDER BY user_type DESC,g.depth,CONVERT(g.groupname USING GBK),CONVERT(a.last_name USING GBK)"
      }
    },
    "Databases": {
      "0": {
        "Ident": "StiMySqlDatabase",
        "Name": "ldcrm",
        "Alias": "ldcrm",
        "ConnectionStringEncrypted": "41bRCUhcS4VGRymNxJxiXovS+ythA0GJYhWhzGMJ42eQWmnryFnz9cwZsJjoPeJn3nh3604DUfBAeKT0TRQlZsd42cLOCVmkfBp5leoJ"
      }
    }
  },
