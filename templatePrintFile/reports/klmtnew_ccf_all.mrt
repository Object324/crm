            "Type": "System.String"
          }
        },
        "NameInSource": "ldcrm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\tg.account_type,\r\n\td.vendor_no,\r\n\tLEFT(a.potentialname,3) AS bef_num,\r\n\tc.productcategory,\r\n\tb.big_area,\r\n\tf.cf_2391 AS out_type,\r\n\ta.potentialname AS potential_no,\r\n\tDATE_FORMAT(a.createdtime,'%Y-%m-%d') AS createdtime,\r\n\tg.accountname AS real_account,\r\n\tc.unit_module,\r\n\tc.productname,\r\n\th.description,\r\n\tn.solution_method,\r\n\ti.cf_2295 AS gz_zeren,\r\n\tDATE_FORMAT(f.produce_date,'%Y-%m-%d') AS produce_date,\r\n\tDATE_FORMAT(f.out_date,'%Y-%m-%d') AS out_date,\r\n\tDATE_FORMAT(f.debug_date,'%Y-%m-%d') AS debug_date,\r\n\tDATE_FORMAT(f.guarantee_enddate,'%Y-%m-%d') AS guarantee_enddate,\r\n\tu.last_name,\r\n\tDATE_FORMAT(e.sendtime,'%Y-%m-%d') AS sendtime,\r\n\tDATE_FORMAT(e.hopetime,'%Y-%m-%d') AS xwsm_date,\r\n\tDATE_FORMAT(e.realtime,'%Y-%m-%d') AS smfw_date,\r\n\tDATE_FORMAT(e.finishtime,'%Y-%m-%d') AS finishtime,\r\n\tCASE\r\n\t\tWHEN f.cf_2391='调试' THEN DATE_FORMAT(ts.debug_startdate,'%Y-%m-%d')\r\n\t\tELSE (SELECT DATE_FORMAT(MAX(y.realtime),'%Y-%m-%d') FROM ld_outboundorder x LEFT JOIN ld_outboundordercf y ON x.out_id=y.out_id WHERE x.potentialid=a.potentialid)\r\n\tEND AS shiji_arrive_time,\r\n\tCASE\r\n\t\tWHEN f.cf_2391='调试' THEN DATE_FORMAT(ts.debug_enddate,'%Y-%m-%d')\r\n\t\tELSE (SELECT DATE_FORMAT(MAX(y.finishtime),'%Y-%m-%d') FROM ld_outboundorder x LEFT JOIN ld_outboundordercf y ON x.out_id=y.out_id WHERE x.potentialid=a.potentialid)\r\n\tEND AS shiji_donetime,\r\n\tDATE_FORMAT(m.createdtime,'%Y-%m-%d') AS wx_billdate,\r\n\ti.cf_2300 AS zp_pf,\r\n\tDATE_FORMAT(h.createdtime,'%Y-%m-%d') AS bs_billdate,\r\n\tDATEDIFF(m.createdtime,e.createdtime) AS MTTR,\r\n\tDATEDIFF(e.createdtime,a.createdtime) AS ETTR\r\nFROM ld_potential a\r\nLEFT JOIN ld_potentialscf b ON b.potentialid=a.potentialid\r\nLEFT JOIN ld_outboundorder m ON m.potentialid=a.potentialid AND m.deleted=0 AND m.approvestatus<>'已拒绝' \r\nLEFT JOIN ld_products c ON c.productid=a.product_id\r\nLEFT JOIN ld_vendor d ON d.vendorid=a.vendorid\r\nLEFT JOIN ld_troubletickets e ON e.potentialid=a.potentialid AND e.deleted=0 AND e.approvestatus<>'已拒绝'\r\nLEFT JOIN ld_ticketcf f ON f.ticketid=e.ticketid AND IFNULL(f.cf_2373,'')<>'已作废'\r\nLEFT JOIN ld_account g ON g.accountid=a.realaccountid\r\nLEFT JOIN ld_quotes h ON h.potentialid=a.potentialid AND h.deleted=0 AND h.approvestatus<>'已拒绝'\r\nLEFT JOIN ld_quotescf i ON i.quoteid=h.quoteid AND IFNULL(i.cf_2374,'')<>'已作废'\r\nLEFT JOIN ld_outboundordercf n ON n.out_id=m.out_id AND IFNULL(n.cf_2376,'')<>'已作废'\r\nLEFT JOIN ld_users u ON u.id=e.smownerid\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\ta.potentialid,\r\n\t\ta.debug_startdate,\r\n\t\ta.debug_enddate\r\n\tFROM ld_contactrecords a\r\n\tLEFT JOIN ld_contactrecordscf b ON b.contactrecordid=a.contactrecordID\r\n\tWHERE a.deleted=0\r\n\t\tAND a.potentialid>0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND IFNULL(b.cf_2377,'')<>'作废单据'\r\n\tGROUP BY potentialid\r\n) ts ON ts.potentialid=a.potentialid\r\nINNER JOIN (\r\n\tSELECT DISTINCT\r\n\t\tuserid \r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\tld_users.id AS userid \r\n\t\tFROM ld_users\r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='Potentials' and scopeauthority=1 AND userid='[uuid]')\r\n\t\tUNION\r\n\t\tSELECT \r\n\t\t\tviewid AS userid \r\n\t\tFROM ld_scoperhigher\r\n\t\tWHERE userid='[uuid]' AND modulename='Potentials' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename='Potentials')\t\t\t\r\n\t\tUNION\r\n\t\tSELECT DISTINCT \r\n\t\t\tld_users2group.userid AS userid \r\n\t\tFROM ld_scoperhigher \r\n\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\tAND ld_scoperhigher.modulename='Potentials'\r\n\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='Potentials' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\tUNION \r\n\t\tSELECT \r\n\t\t\tid AS userid \r\n\t\tFROM ld_users  \r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\tUNION\r\n\t\tSELECT '[uuid]') AS vw_users\r\n) AS tmp_users ON tmp_users.userid=a.smownerid\r\nWHERE a.deleted=0 \r\n\tAND a.approvestatus<>'已拒绝'\r\n\tAND m.createdtime BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d 00:00:00') AND DATE_FORMAT('{end_date}','%Y-%m-%d 23:59:59')\r\n\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{itemtype}'='' THEN 1=1\r\n\t\t\t\tELSE FIND_IN_SET(c.productcategory,'{itemtype}')\r\n\t\t\tEND)\r\n\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{acctype}'='' THEN 1=1\r\n                                 WHEN '{acctype}' like '%空白%' THEN ((g.account_type is null or g.account_type = '') or FIND_IN_SET(g.account_type,'{acctype}') )\r\n\t\t\t\tELSE FIND_IN_SET(g.account_type,'{acctype}') \r\n\t\t\tEND)\r\nand a.potentialname like '%{ccfnum}%'\r\nand g.accountname like '%{accname}%'\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{quyu}'='' THEN 1=1\r\n\t\t\t\tELSE FIND_IN_SET(b.big_area,'{quyu}')\r\n\t\t\tEND)\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{vendor_no}'='' THEN 1=1\r\n\t\t\t\tELSE FIND_IN_SET(d.vendor_no,'{vendor_no}')\r\n\t\t\tEND)\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{out_type}'='' OR '{out_type}'=(SELECT GROUP_CONCAT(listvalue) FROM ld_picklist_values WHERE listid=122 ORDER BY sequence) THEN 1=1\r\n\t\t\t\tELSE FIND_IN_SET(f.cf_2391,'{out_type}')\r\n\t\t\tEND)\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{trouble_zeren}'='' OR '{trouble_zeren}'=(SELECT GROUP_CONCAT(listvalue) FROM ld_picklist_values WHERE listid=98 ORDER BY sequence) THEN 1=1\r\n\t\t\t\tELSE FIND_IN_SET(i.cf_2295,'{trouble_zeren}')\r\n\t\t\tEND)\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{userid}'='' THEN 1=1\r\n\t\t\t\tELSE FIND_IN_SET(a.smownerid,'{userid}')\r\n\t\t\tEND)\r\nORDER BY m.createdtime"
      },
      "7": {
        "Ident": "StiMySqlSource",
        "Name": "list_accytpe",
        "Alias": "list_accytpe",
        "Columns": {
          "0": {
            "Name": "listvalue",
            "Index": -1,
            "NameInSource": "listvalue",
            "Alias": "listvalue",
            "Type": "System.String"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "select listvalue from ld_picklist_values where listid=4\r\nunion\r\nselect '空白'"
      }
    },
