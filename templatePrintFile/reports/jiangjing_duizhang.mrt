<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<StiSerializer version="1.02" type="Flex" application="StiReport">
  <Dictionary isKey="true" type="Dictionary" Ref="1">
    <Databases isList="true" count="1">
      <ldcrm isKey="true" type="Stimulsoft.Report.Dictionary.StiMySqlDatabase" Ref="2">
        <Alias>ldcrm</Alias>
        <ConnectionStringEncrypted>9Gxz62FcS83hR9WI6CU0n8LQdWBhD1GFwxWx3GqEdy/CyPvKxgvziEYa0fBhXKQvgW5lr+9tM+1r
E8H06vgyI4NgaS3GT0O8Z0n9jcR0tWf/FN3CYVFagUZcoOBnVHTv</ConnectionStringEncrypted>
        <Name>ldcrm</Name>
      </ldcrm>
    </Databases>
    <DataSources isList="true" count="2">
      <lab isKey="true" type="Stimulsoft.Report.Dictionary.StiMySqlSource" Ref="3">
        <Alias>lab</Alias>
        <Columns isList="true" count="1">
          <value>lab1,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1"/>
        <Name>lab</Name>
        <NameInSource>ldcrm</NameInSource>
        <Parameters isList="true" count="0"/>
        <SqlCommand>SELECT
	CASE
		WHEN TRIM('{company}')='' THEN 
			'对  账  单&lt;font color="red"&gt;（请输入完整的客户名称进行精确查询）&lt;/font&gt;'
		WHEN EXISTS (SELECT 1 FROM ld_account WHERE TRIM(accountname)=TRIM('{company}')) THEN
			CONCAT('对  账  单（',TRIM('{company}'),'）')
		ELSE 
			'对  账  单&lt;font color="red"&gt;（查无此客户）&lt;/font&gt;'
	END AS lab1</SqlCommand>
      </lab>
      <report isKey="true" type="Stimulsoft.Report.Dictionary.StiMySqlSource" Ref="4">
        <Alias>report</Alias>
        <Columns isList="true" count="10">
          <value>signed_data,System.DateTime</value>
          <value>productname,System.String</value>
          <value>usageunit,System.String</value>
          <value>quantity,System.Decimal</value>
          <value>listprice,System.Decimal</value>
          <value>list_amount,System.Decimal</value>
          <value>tax2,System.Decimal</value>
          <value>tax_total,System.Decimal</value>
          <value>tax_amount,System.Decimal</value>
          <value>remark,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1"/>
        <Name>report</Name>
        <NameInSource>ldcrm</NameInSource>
        <Parameters isList="true" count="0"/>
        <SqlCommand>SELECT 
	a.signed_data,
	c.productname,
	bf.sf2561 AS usageunit,
	b.quantity,
	b.listprice,
	b.list_amount,
	b.tax2,
	ROUND(b.list_amount*IFNULL(b.tax2,0)*0.01,2) AS tax_total,
	b.tax_amount,
	b.`comment` AS remark
FROM ld_salesorder a
LEFT JOIN ld_inventoryproductrel b ON a.salesorderid=b.id
LEFT JOIN ld_inventoryproductrelscf bf ON b.lineitem_id=bf.lineitem_id
LEFT JOIN ld_products c ON c.productid=b.productid
LEFT JOIN ld_account d ON d.accountid=a.accountid
WHERE a.deleted=0
	AND IFNULL(a.sostatus,'')&lt;&gt;'已作废'
	AND a.approvestatus&lt;&gt;'已拒绝'
	AND a.signed_data BETWEEN STR_TO_DATE('{start_date}','%m/%d/%Y') AND STR_TO_DATE('{end_date}','%m/%d/%Y')
	AND (
		CASE
			WHEN TRIM('{company}')='' THEN 0=1
			ELSE TRIM(d.accountname)=TRIM('{company}')
		END)</SqlCommand>
      </report>
    </DataSources>
    <Relations isList="true" count="0"/>
    <Report isRef="0"/>
    <Variables isList="true" count="3">
      <value>,start_date,起始日期,,System.DateTime,DateSerial_x0028_Year_x0028_Today_x0029__x002C_Month_x0028_Today_x0029__x002C_1_x0029_,False,True,True</value>
      <value>,end_date,截止日期,,System.DateTime,Today,False,True,True</value>
      <value>,company,客户名称,,System.String,,False,False,True</value>
    </Variables>
  </Dictionary>
