          }
        },
        "NameInSource": "ldcrm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\tlast_name,\r\n\tCASE\r\n\t\tWHEN start_date<=CURDATE() AND L1=1 THEN '√'\r\n \t\tWHEN start_date<=CURDATE() AND L1=0 THEN '×'\r\n\t\tWHEN start_date<=CURDATE() AND L1=2 THEN '补'\r\n\t\tELSE  ''\r\n\tEND AS L1,\r\n\tCASE\r\n\t\tWHEN DATE_ADD(start_date,INTERVAL 1 MONTH)<=CURDATE() AND L2=1 THEN '√'\r\n \t\tWHEN DATE_ADD(start_date,INTERVAL 1 MONTH)<=CURDATE() AND L2=0 THEN '×'\r\n \t\tWHEN DATE_ADD(start_date,INTERVAL 1 MONTH)<=CURDATE() AND L2=2 THEN '补'\r\n\t\tELSE  ''\r\n\tEND AS L2,\r\n\tCASE\r\n\t\tWHEN DATE_ADD(start_date,INTERVAL 2 MONTH)<=CURDATE() AND L3=1 THEN '√'\r\n \t\tWHEN DATE_ADD(start_date,INTERVAL 2 MONTH)<=CURDATE() AND L3=0 THEN '×'\r\n \t\tWHEN DATE_ADD(start_date,INTERVAL 2 MONTH)<=CURDATE() AND L3=2 THEN '补'\r\n\t\tELSE  ''\r\n\tEND AS L3,\r\n\tCASE\r\n\t\tWHEN DATE_ADD(start_date,INTERVAL 3 MONTH)<=CURDATE() AND L4=1 THEN '√'\r\n \t\tWHEN DATE_ADD(start_date,INTERVAL 3 MONTH)<=CURDATE() AND L4=0 THEN '×'\r\n\t\tWHEN DATE_ADD(start_date,INTERVAL 3 MONTH)<=CURDATE() AND L4=2 THEN '补'\r\n\t\tELSE  ''\r\n\tEND AS L4,\r\n\tCASE\r\n\t\tWHEN DATE_ADD(start_date,INTERVAL 4 MONTH)<=CURDATE() AND L5=1 THEN '√'\r\n \t\tWHEN DATE_ADD(start_date,INTERVAL 4 MONTH)<=CURDATE() AND L5=0 THEN '×'\r\n \t\tWHEN DATE_ADD(start_date,INTERVAL 4 MONTH)<=CURDATE() AND L5=2 THEN '补'\r\n\t\tELSE  ''\r\n\tEND AS L5,\r\n\tCASE\r\n\t\tWHEN DATE_ADD(start_date,INTERVAL 5 MONTH)<=CURDATE() AND L6=1 THEN '√'\r\n \t\tWHEN DATE_ADD(start_date,INTERVAL 5 MONTH)<=CURDATE() AND L6=0 THEN '×'\r\n \t\tWHEN DATE_ADD(start_date,INTERVAL 5 MONTH)<=CURDATE() AND L6=2 THEN '补'\r\n\t\tELSE  ''\r\n\tEND AS L6,\r\n\tCASE\r\n\t\tWHEN DATE_ADD(start_date,INTERVAL 6 MONTH)<=CURDATE() AND L7=1 THEN '√'\r\n \t\tWHEN DATE_ADD(start_date,INTERVAL 6 MONTH)<=CURDATE() AND L7=0 THEN '×'\r\n \t\tWHEN DATE_ADD(start_date,INTERVAL 6 MONTH)<=CURDATE() AND L7=2 THEN '补'\r\n\t\tELSE  ''\r\n\tEND AS L7,\r\n\tCASE\r\n\t\tWHEN DATE_ADD(start_date,INTERVAL 7 MONTH)<=CURDATE() AND L8=1 THEN '√'\r\n \t\tWHEN DATE_ADD(start_date,INTERVAL 7 MONTH)<=CURDATE() AND L8=0 THEN '×'\r\n \t\tWHEN DATE_ADD(start_date,INTERVAL 7 MONTH)<=CURDATE() AND L8=2 THEN '补'\r\n\t\tELSE  ''\r\n\tEND AS L8,\r\n\tCASE\r\n\t\tWHEN DATE_ADD(start_date,INTERVAL 8 MONTH)<=CURDATE() AND L9=1 THEN '√'\r\n \t\tWHEN DATE_ADD(start_date,INTERVAL 8 MONTH)<=CURDATE() AND L9=0 THEN '×'\r\n \t\tWHEN DATE_ADD(start_date,INTERVAL 8 MONTH)<=CURDATE() AND L9=2 THEN '补'\r\n\t\tELSE  ''\r\n\tEND AS L9,\r\n\tCASE\r\n\t\tWHEN DATE_ADD(start_date,INTERVAL 9 MONTH)<=CURDATE() AND L10=1 THEN '√'\r\n \t\tWHEN DATE_ADD(start_date,INTERVAL 9 MONTH)<=CURDATE() AND L10=0 THEN '×'\r\n \t\tWHEN DATE_ADD(start_date,INTERVAL 9 MONTH)<=CURDATE() AND L10=2 THEN '补'\r\n\t\tELSE  ''\r\n\tEND AS L10,\r\n\tCASE\r\n\t\tWHEN DATE_ADD(start_date,INTERVAL 10 MONTH)<=CURDATE() AND L11=1 THEN '√'\r\n \t\tWHEN DATE_ADD(start_date,INTERVAL 10 MONTH)<=CURDATE() AND L11=0 THEN '×'\r\n \t\tWHEN DATE_ADD(start_date,INTERVAL 10 MONTH)<=CURDATE() AND L11=2 THEN '补'\r\n\t\tELSE  ''\r\n\tEND AS L11,\r\n\tCASE\r\n\t\tWHEN DATE_ADD(start_date,INTERVAL 11 MONTH)<=CURDATE() AND L12=1 THEN '√'\r\n \t\tWHEN DATE_ADD(start_date,INTERVAL 11 MONTH)<=CURDATE() AND L12=0 THEN '×'\r\n \t\tWHEN DATE_ADD(start_date,INTERVAL 11 MONTH)<=CURDATE() AND L12=2 THEN '补'\r\n\t\tELSE  ''\r\n\tEND AS L12,\r\n\tIF(L1=2,1,L1)+IF(L2=2,1,L2)+IF(L3=2,1,L3)+IF(L4=2,1,L4)+IF(L5=2,1,L5)+IF(L6=2,1,L6)+IF(L7=2,1,L7)+IF(L8=2,1,L8)+IF(L9=2,1,L9)+IF(L10=2,1,L10)+IF(L11=2,1,L11)+IF(L12=2,1,L12) AS sub_qty,\r\n\tCASE\r\n\t\tWHEN start_date>CURDATE() THEN 0\r\n\t\tWHEN DATE_ADD(start_date,INTERVAL 11 MONTH)<=CURDATE() THEN 12-(IF(L1=2,1,L1)+IF(L2=2,1,L2)+IF(L3=2,1,L3)+IF(L4=2,1,L4)+IF(L5=2,1,L5)+IF(L6=2,1,L6)+IF(L7=2,1,L7)+IF(L8=2,1,L8)+IF(L9=2,1,L9)+IF(L10=2,1,L10)+IF(L11=2,1,L11)+IF(L12=2,1,L12))\r\n\t\tELSE MONTH(CURDATE())-(IF(L1=2,1,L1)+IF(L2=2,1,L2)+IF(L3=2,1,L3)+IF(L4=2,1,L4)+IF(L5=2,1,L5)+IF(L6=2,1,L6)+IF(L7=2,1,L7)+IF(L8=2,1,L8)+IF(L9=2,1,L9)+IF(L10=2,1,L10)+IF(L11=2,1,L11)+IF(L12=2,1,L12))\r\n\tEND AS no_qty\r\nFROM (\r\n\tSELECT\r\n\t\tu.id,\r\n\t\tu.last_name,\r\n\t\tu.start_date,\r\n\t\tCASE\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_workreport WHERE type=3 AND smcreatorid=u.id \r\n\t\t\t\tAND YEAR(createdtime)=u.query_nian AND MONTH(createdtime)=1\r\n\t\t\t\tAND DATE_FORMAT(createdtime,'%Y-%m-%d') BETWEEN LEFT(sendlog_workdate,10) AND RIGHT(sendlog_workdate,10)) THEN 1\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_workreport WHERE type=3 AND smcreatorid=u.id \r\n\t\t\t\tAND LEFT(sendlog_workdate,10) BETWEEN start_date AND LAST_DAY(start_date)) THEN 2 \r\n\t\t\tELSE 0\r\n\t\tEND AS L1,\r\n\t\tCASE\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_workreport WHERE type=3 AND smcreatorid=u.id \r\n\t\t\t\tAND YEAR(createdtime)=u.query_nian AND MONTH(createdtime)=2\r\n\t\t\t\tAND DATE_FORMAT(createdtime,'%Y-%m-%d') BETWEEN LEFT(sendlog_workdate,10) AND RIGHT(sendlog_workdate,10)) THEN 1\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_workreport WHERE type=3 AND smcreatorid=u.id \r\n\t\t\t\tAND LEFT(sendlog_workdate,10) BETWEEN DATE_ADD(start_date,INTERVAL 1 MONTH) AND LAST_DAY(DATE_ADD(start_date,INTERVAL 1 MONTH))) THEN 2 \r\n\t\t\tELSE 0\r\n\t\tEND AS L2,\r\n\t\tCASE\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_workreport WHERE type=3 AND smcreatorid=u.id \r\n\t\t\t\tAND YEAR(createdtime)=u.query_nian AND MONTH(createdtime)=3\r\n\t\t\t\tAND DATE_FORMAT(createdtime,'%Y-%m-%d') BETWEEN LEFT(sendlog_workdate,10) AND RIGHT(sendlog_workdate,10)) THEN 1\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_workreport WHERE type=3 AND smcreatorid=u.id \r\n\t\t\t\tAND LEFT(sendlog_workdate,10) BETWEEN DATE_ADD(start_date,INTERVAL 2 MONTH) AND LAST_DAY(DATE_ADD(start_date,INTERVAL 2 MONTH))) THEN 2 \r\n\t\t\tELSE 0\r\n\t\tEND AS L3,\r\n\t\tCASE\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_workreport WHERE type=3 AND smcreatorid=u.id \r\n\t\t\t\tAND YEAR(createdtime)=u.query_nian AND MONTH(createdtime)=4\r\n\t\t\t\tAND DATE_FORMAT(createdtime,'%Y-%m-%d') BETWEEN LEFT(sendlog_workdate,10) AND RIGHT(sendlog_workdate,10)) THEN 1\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_workreport WHERE type=3 AND smcreatorid=u.id \r\n\t\t\t\tAND LEFT(sendlog_workdate,10) BETWEEN DATE_ADD(start_date,INTERVAL 3 MONTH) AND LAST_DAY(DATE_ADD(start_date,INTERVAL 3 MONTH))) THEN 2 \r\n\t\t\tELSE 0\r\n\t\tEND AS L4,\r\n\t\tCASE\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_workreport WHERE type=3 AND smcreatorid=u.id \r\n\t\t\t\tAND YEAR(createdtime)=u.query_nian AND MONTH(createdtime)=5\r\n\t\t\t\tAND DATE_FORMAT(createdtime,'%Y-%m-%d') BETWEEN LEFT(sendlog_workdate,10) AND RIGHT(sendlog_workdate,10)) THEN 1\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_workreport WHERE type=3 AND smcreatorid=u.id \r\n\t\t\t\tAND LEFT(sendlog_workdate,10) BETWEEN DATE_ADD(start_date,INTERVAL 4 MONTH) AND LAST_DAY(DATE_ADD(start_date,INTERVAL 4 MONTH))) THEN 2 \r\n\t\t\tELSE 0\r\n\t\tEND AS L5,\r\n\t\tCASE\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_workreport WHERE type=3 AND smcreatorid=u.id \r\n\t\t\t\tAND YEAR(createdtime)=u.query_nian AND MONTH(createdtime)=6\r\n\t\t\t\tAND DATE_FORMAT(createdtime,'%Y-%m-%d') BETWEEN LEFT(sendlog_workdate,10) AND RIGHT(sendlog_workdate,10)) THEN 1\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_workreport WHERE type=3 AND smcreatorid=u.id \r\n\t\t\t\tAND LEFT(sendlog_workdate,10) BETWEEN DATE_ADD(start_date,INTERVAL 5 MONTH) AND LAST_DAY(DATE_ADD(start_date,INTERVAL 5 MONTH))) THEN 2 \r\n\t\t\tELSE 0\r\n\t\tEND AS L6,\r\n\t\tCASE\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_workreport WHERE type=3 AND smcreatorid=u.id \r\n\t\t\t\tAND YEAR(createdtime)=u.query_nian AND MONTH(createdtime)=7\r\n\t\t\t\tAND DATE_FORMAT(createdtime,'%Y-%m-%d') BETWEEN LEFT(sendlog_workdate,10) AND RIGHT(sendlog_workdate,10)) THEN 1\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_workreport WHERE type=3 AND smcreatorid=u.id \r\n\t\t\t\tAND LEFT(sendlog_workdate,10) BETWEEN DATE_ADD(start_date,INTERVAL 6 MONTH) AND LAST_DAY(DATE_ADD(start_date,INTERVAL 6 MONTH))) THEN 2 \r\n\t\t\tELSE 0\r\n\t\tEND AS L7,\r\n\t\tCASE\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_workreport WHERE type=3 AND smcreatorid=u.id \r\n\t\t\t\tAND YEAR(createdtime)=u.query_nian AND MONTH(createdtime)=8\r\n\t\t\t\tAND DATE_FORMAT(createdtime,'%Y-%m-%d') BETWEEN LEFT(sendlog_workdate,10) AND RIGHT(sendlog_workdate,10)) THEN 1\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_workreport WHERE type=3 AND smcreatorid=u.id \r\n\t\t\t\tAND LEFT(sendlog_workdate,10) BETWEEN DATE_ADD(start_date,INTERVAL 7 MONTH) AND LAST_DAY(DATE_ADD(start_date,INTERVAL 7 MONTH))) THEN 2 \r\n\t\t\tELSE 0\r\n\t\tEND AS L8,\r\n\t\tCASE\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_workreport WHERE type=3 AND smcreatorid=u.id \r\n\t\t\t\tAND YEAR(createdtime)=u.query_nian AND MONTH(createdtime)=9\r\n\t\t\t\tAND DATE_FORMAT(createdtime,'%Y-%m-%d') BETWEEN LEFT(sendlog_workdate,10) AND RIGHT(sendlog_workdate,10)) THEN 1\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_workreport WHERE type=3 AND smcreatorid=u.id \r\n\t\t\t\tAND LEFT(sendlog_workdate,10) BETWEEN DATE_ADD(start_date,INTERVAL 8 MONTH) AND LAST_DAY(DATE_ADD(start_date,INTERVAL 8 MONTH))) THEN 2 \r\n\t\t\tELSE 0\r\n\t\tEND AS L9,\r\n\t\tCASE\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_workreport WHERE type=3 AND smcreatorid=u.id \r\n\t\t\t\tAND YEAR(createdtime)=u.query_nian AND MONTH(createdtime)=10\r\n\t\t\t\tAND DATE_FORMAT(createdtime,'%Y-%m-%d') BETWEEN LEFT(sendlog_workdate,10) AND RIGHT(sendlog_workdate,10)) THEN 1\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_workreport WHERE type=3 AND smcreatorid=u.id \r\n\t\t\t\tAND LEFT(sendlog_workdate,10) BETWEEN DATE_ADD(start_date,INTERVAL 9 MONTH) AND LAST_DAY(DATE_ADD(start_date,INTERVAL 9 MONTH))) THEN 2 \r\n\t\t\tELSE 0\r\n\t\tEND AS L10,\r\n\t\tCASE\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_workreport WHERE type=3 AND smcreatorid=u.id \r\n\t\t\t\tAND YEAR(createdtime)=u.query_nian AND MONTH(createdtime)=11\r\n\t\t\t\tAND DATE_FORMAT(createdtime,'%Y-%m-%d') BETWEEN LEFT(sendlog_workdate,10) AND RIGHT(sendlog_workdate,10)) THEN 1\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_workreport WHERE type=3 AND smcreatorid=u.id \r\n\t\t\t\tAND LEFT(sendlog_workdate,10) BETWEEN DATE_ADD(start_date,INTERVAL 10 MONTH) AND LAST_DAY(DATE_ADD(start_date,INTERVAL 10 MONTH))) THEN 2 \r\n\t\t\tELSE 0\r\n\t\tEND AS L11,\r\n\t\tCASE\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_workreport WHERE type=3 AND smcreatorid=u.id \r\n\t\t\t\tAND YEAR(createdtime)=u.query_nian AND MONTH(createdtime)=12\r\n\t\t\t\tAND DATE_FORMAT(createdtime,'%Y-%m-%d') BETWEEN LEFT(sendlog_workdate,10) AND RIGHT(sendlog_workdate,10)) THEN 1\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_workreport WHERE type=3 AND smcreatorid=u.id \r\n\t\t\t\tAND LEFT(sendlog_workdate,10) BETWEEN DATE_ADD(start_date,INTERVAL 11 MONTH) AND LAST_DAY(DATE_ADD(start_date,INTERVAL 11 MONTH))) THEN 2 \r\n\t\t\tELSE 0\r\n\t\tEND AS L12\r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\ta.id,\r\n\t\t\t(case when left(database(),2)='wx' and right(database(),5)+0>10000 and IFNULL(a.real_name,'')<>'' then a.real_name else a.last_name end ) AS last_name,\r\n\t\t\t'{nian}' AS query_nian,\r\n\t\t\tSTR_TO_DATE(CONCAT('{nian}','-01-01'),'%Y-%m-%d') AS start_date\r\n\t\tFROM ld_users a\r\n\t\tINNER JOIN (\r\n\t\t\tSELECT DISTINCT\r\n\t\t\t\tuserid \r\n\t\t\tFROM (\r\n\t\t\t\tSELECT \r\n\t\t\t\t\tld_users.id AS userid \r\n\t\t\t\tFROM ld_users\r\n\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='CooperativeWork' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT \r\n\t\t\t\t\tviewid AS userid \r\n\t\t\t\tFROM ld_scoperhigher\r\n\t\t\t\tWHERE userid='[uuid]' AND modulename='CooperativeWork' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename='CooperativeWork')\t\t\t\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT DISTINCT \r\n\t\t\t\t\tld_users2group.userid AS userid \r\n\t\t\t\tFROM ld_scoperhigher \r\n\t\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\t\tAND ld_scoperhigher.modulename='CooperativeWork'\r\n\t\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='CooperativeWork' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\t\tUNION \r\n\t\t\t\tSELECT \r\n\t\t\t\t\tid AS userid \r\n\t\t\t\tFROM ld_users  \r\n\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT '[uuid]') AS vw_users\r\n\t\t) AS tmp_users ON tmp_users.userid=a.id\r\nINNER JOIN (\r\n\tSELECT\r\n\t\ta.userid\r\n\tFROM ld_users2group a\r\n\tLEFT JOIN ld_groups b ON a.groupid=b.groupid\r\n\tWHERE (\r\n\t\tCASE\r\n\t\t\tWHEN '{bumen}'='' THEN 1=1\r\n\t\t\tWHEN '{bumen}'>0 AND '{bumen}' NOT LIKE '%,%' THEN a.groupid='{bumen}' OR LOCATE((SELECT CONCAT(parentgroup,'::') FROM ld_groups WHERE groupid='{bumen}'),b.parentgroup) \r\n\t\t\tELSE FIND_IN_SET(a.groupid,'{bumen}')\r\n\t\tEND)\r\n\tGROUP BY a.userid\r\n) tmp_groups ON tmp_groups.userid=a.id\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.`status`='Active'\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{userid}'='' THEN 1=1\r\n\t\t\t\t\tELSE FIND_IN_SET(a.id,'{userid}')\r\n\t\t\t\tEND)\r\n\t) u\r\n) t\r\nORDER BY CONVERT(last_name USING GBK)"
      }
    },
