            "Type": "System.Int32"
          },
          "4": {
            "Name": "setype",
            "Index": -1,
            "NameInSource": "setype",
            "Alias": "setype",
            "Type": "System.String"
          },
          "5": {
            "Name": "accountname",
            "Index": -1,
            "NameInSource": "accountname",
            "Alias": "accountname",
            "Type": "System.String"
          },
          "6": {
            "Name": "lastname",
            "Index": -1,
            "NameInSource": "lastname",
            "Alias": "lastname",
            "Type": "System.String"
          },
          "7": {
            "Name": "Subject",
            "Index": -1,
            "NameInSource": "Subject",
            "Alias": "Subject",
            "Type": "System.String"
          },
          "8": {
            "Name": "ticket_no",
            "Index": -1,
            "NameInSource": "ticket_no",
            "Alias": "ticket_no",
            "Type": "System.String"
          },
          "9": {
            "Name": "vendorname",
            "Index": -1,
            "NameInSource": "vendorname",
            "Alias": "vendorname",
            "Type": "System.String"
          },
          "10": {
            "Name": "vendor_lastname",
            "Index": -1,
            "NameInSource": "vendor_lastname",
            "Alias": "vendor_lastname",
            "Type": "System.String"
          },
          "11": {
            "Name": "vendor_subject",
            "Index": -1,
            "NameInSource": "vendor_subject",
            "Alias": "vendor_subject",
            "Type": "System.String"
          },
          "12": {
            "Name": "calltype",
            "Index": -1,
            "NameInSource": "calltype",
            "Alias": "calltype",
            "Type": "System.String"
          },
          "13": {
            "Name": "callnum",
            "Index": -1,
            "NameInSource": "callnum",
            "Alias": "callnum",
            "Type": "System.String"
          },
          "14": {
            "Name": "Talktime",
            "Index": -1,
            "NameInSource": "Talktime",
            "Alias": "Talktime",
            "Type": "System.Int32"
          },
          "15": {
            "Name": "mp3path",
            "Index": -1,
            "NameInSource": "mp3path",
            "Alias": "mp3path",
            "Type": "System.String"
          }
        },
        "NameInSource": "Connection1",
        "SqlCommand": "SELECT\r\n\t*\r\nFROM (\r\n\tSELECT\r\n\t\tj.last_name,\r\n\t\ta.usernum,\r\n\t\ta.Starttime, \r\n\t\ta.indexid, \r\n\t\tld_crmentity.setype, \r\n\t\tCASE \r\n\t\tWHEN ld_crmentity.setype='Accounts' THEN b.accountname \r\n\t\tWHEN ld_crmentity.setype='Contacts' THEN (SELECT accountname FROM ld_account WHERE accountid=c.accountid) \r\n\t\tWHEN ld_crmentity.setype='ContactRecords' THEN (SELECT accountname FROM ld_account WHERE accountid=d.accountid) \r\n\t\tWHEN ld_crmentity.setype='HelpDesk' THEN (SELECT accountname FROM ld_account WHERE accountid=e.accountid) \r\n\t\tElSE '' \r\n\t\tEND AS accountname, \r\n\t\tCASE \r\n\t\tWHEN ld_crmentity.setype='Contacts' THEN c.lastname \r\n\t\tWHEN ld_crmentity.setype='ContactRecords' THEN (SELECT lastname FROM ld_contactdetails WHERE contactid=d.contactid) \r\n\t\tWHEN ld_crmentity.setype='HelpDesk' THEN (SELECT lastname FROM ld_contactdetails WHERE contactid=e.contactid) \r\n\t\tEND AS lastname, \r\n\t\td.contactrecord_no AS `Subject`, \r\n\t\te.ticket_no, \r\n\t\tf.vendorname, \r\n\t\tg.Lastname AS vendor_lastname, \r\n\t\th.contactrecord_no AS vendor_subject,\r\n\t\tCASE \r\n\t\t\tWHEN a.type=1 THEN '去电'\r\n\t\t\tELSE '来电'\r\n\t\tEND AS calltype,\r\n\t\tCASE \r\n\t\t\tWHEN a.type=1 THEN a.callee\r\n\t\t\tELSE a.caller\r\n\t\tEND AS callnum,\r\n\t\ta.Talktime,\r\n\t\tCONCAT(IFNULL((SELECT LEFT(deploy_value,LENGTH(deploy_value)-LOCATE(':',REVERSE(deploy_value))) from ld_systems_deploy WHERE deploy_type=121 LIMIT 1),''),'/recordings/',recordnum) AS mp3path\r\n\tFROM ld_hantian_phonerecord a \r\n\tLEFT JOIN ld_crmentity ON ld_crmentity.crmid=a.indexid \r\n\tLEFT JOIN ld_account b ON b.accountid=a.indexid AND b.deleted=0\r\n\tLEFT JOIN ld_contactdetails c ON c.contactid=a.indexid  AND c.deleted=0\r\n\tLEFT JOIN ld_contactrecords d ON d.contactrecordID=a.indexid  AND d.deleted=0\r\n\tLEFT JOIN ld_troubletickets e ON e.ticketid=a.indexid  AND e.deleted=0\r\n\tLEFT JOIN ld_vendor f ON f.vendorid=a.indexid  AND f.deleted=0\r\n\tLEFT JOIN ld_vendorcontacts g ON g.vendorcontactsid=a.indexid  AND g.deleted=0\r\n\tLEFT JOIN ld_vendorcontactrecords h ON h.contactRecordsid=a.indexid AND h.deleted=0\r\n\tLEFT JOIN ld_users j on j.id=a.userid\r\n\tWHERE\r\n\ta.starttime>=concat(DATE_FORMAT('{begindate}','%Y-%m-%d'),' ','00:00:00') AND a.deadline<=concat(DATE_FORMAT('{enddate}','%Y-%m-%d'),' ','23:59:59')\r\n\tAND \r\n\t(\r\n\t\t\tCASE \r\n\t\t\t\tWHEN '{calltype}'='来电' THEN  a.type=2\r\n\t\t\t\tWHEN '{calltype}'='去电' THEN  a.type=1 \r\n\t\t\t\tELSE 1=1\r\n\t\tEND)\r\n\tAND(\r\n\t\t\tCASE \r\n\t\t\t\tWHEN '{iszero}'='false' THEN IFNULL(a.Talktime, 0)>0 \r\n\t\t\t\tELSE 1=1\r\n\t\tEND)\r\n\tAND \r\n\t(\r\n\t\t\tCASE \r\n\t\t\t\tWHEN '{calltime}'='' THEN 1=1\r\n\t\t\t\tELSE a.Talktime>='{calltime}'\r\n\t\tEND)\r\n\tand (CASE\r\n\t\t\t\t\t\tWHEN '{userid}'='' THEN \r\n\t\t\t\t\t\t\tFIND_IN_SET(a.userid,(\r\n\t\t\t\t\t\t\t\tSELECT\r\n\t\t\t\t\t\t\t\t\tGROUP_CONCAT(userid)\r\n\t\t\t\t\t\t\t\tFROM (\r\n\t\t\t\t\t\t\t\t\tSELECT DISTINCT\r\n\t\t\t\t\t\t\t\t\t\tuserid \r\n\t\t\t\t\t\t\t\t\tFROM (\r\n\t\t\t\t\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\t\t\t\t\tld_users.id as userid \r\n\t\t\t\t\t\t\t\t\t\tFROM ld_users\r\n\t\t\t\t\t\t\t\t\t\tWHERE EXISTS(select 1 from ld_setscoperhigher where modulename='ReportAnalysis' and scopeauthority=1 and userid='[uuid]')\r\n\t\t\t\t\t\t\t\t\t\tUNION\r\n\t\t\t\t\t\t\t\t\t\tselect \r\n\t\t\t\t\t\t\t\t\t\t\tviewid as userid \r\n\t\t\t\t\t\t\t\t\t\tfrom ld_scoperhigher\r\n\t\t\t\t\t\t\t\t\t\twhere userid='[uuid]' and modulename='ReportAnalysis' and EXISTS(select 1 from ld_setscoperhigher where userid='[uuid]' and scopeauthority=2 and modulename='ReportAnalysis')\t\t\t\r\n\t\t\t\t\t\t\t\t\t\tUNION\r\n\t\t\t\t\t\t\t\t\t\tselect DISTINCT \r\n\t\t\t\t\t\t\t\t\t\t\tld_users2group.userid as userid \r\n\t\t\t\t\t\t\t\t\t\tfrom ld_scoperhigher \r\n\t\t\t\t\t\t\t\t\t\tINNER JOIN ld_groups on ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\t\t\t\t\t\t\t\tINNER JOIN ld_users2group on ld_users2group.groupid=ld_groups.groupid\r\n\t\t\t\t\t\t\t\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\t\t\t\t\t\t\t\tand ld_scoperhigher.modulename='ReportAnalysis'\r\n\t\t\t\t\t\t\t\t\t\t\tand ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\t\t\t\t\t\t\t\tand EXISTS(select 1 from ld_setscoperhigher where modulename='ReportAnalysis' and scopeauthority=3 and userid='[uuid]')\r\n\t\t\t\t\t\t\t\t\t\tUNION \r\n\t\t\t\t\t\t\t\t\t\tselect \r\n\t\t\t\t\t\t\t\t\t\t\tid as userid \r\n\t\t\t\t\t\t\t\t\t\tfrom ld_users  \r\n\t\t\t\t\t\t\t\t\t\twhere exists(select 1 from ld_users where id='[uuid]' and is_admin='on')\r\n\t\t\t\t\t\t\t\t\t\tUNION\r\n\t\t\t\t\t\t\t\t\t\tselect '[uuid]')as vw_users\r\n\t\t\t\t\t\t\t\t) as tmp_users)) OR a.userid IS NULL\r\n\t\t\t\t\t\tELSE FIND_IN_SET(a.userid,'{userid}') OR a.userid IS NULL\r\n\t\t\t\t\tEND)\r\n) t\r\nWHERE 1=1\r\nAND \r\n(\r\n\t\tCASE \r\n\t\t\tWHEN '{telnum}'='' THEN 1=1\r\n\t\t\tELSE callnum like '%{telnum}%'\r\n\tEND)\r\nAND \r\n(\r\n\t\tCASE \r\n\t\t\tWHEN '{AcountName}'='' THEN 1=1\r\n\t\t\tELSE accountname like '%{AcountName}%'\r\n\tEND)\r\nORDER BY usernum,Starttime"
      }
    },
    "Databases": {
      "0": {
        "Ident": "StiMySqlDatabase",
        "Name": "Connection1",
