        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\ta.projectid,\r\n\ta.projectname,\r\n\ta.project_no,\r\n\tu.last_name,\r\n\ta.salesorderid,\r\n\ta.projectstatus,\r\n\tb.ordertype,\r\n\tb.order_no,\r\n\tc.cashbilldate,\r\n\tb.order_total AS order_total,\r\n\tc.sk_total AS sk_total,\r\n\tc.amount AS amount,\r\n\tCASE \r\n\t\tWHEN '{suanfa}'='按本次收款金额' THEN ROUND(c.amount*0.01*'{rate}',2) \r\n\t\tELSE  ROUND(c.sk_total*0.01*'{rate}',2) \r\n\tEND AS tc_amount,\r\n\ta.accountid,\r\n\tCASE \r\n\t\tWHEN EXISTS (SELECT 1 FROM ld_field WHERE tabid=48 AND columnname='end_accountid' AND presence<>1) THEN (SELECT accountname FROM ld_account WHERE accountid=a.end_accountid)\r\n\t\tELSE \tk.accountname\r\n\tEND AS accountname\r\nFROM ld_project a\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\tsalesorderid AS order_id,\r\n\t\tsalesorder_no AS order_no,\r\n\t\t'SalesOrder' AS ordertype,\r\n\t\treceived_amount,\r\n\t\tcashbilldate,\r\n\t\ttotal AS order_total\r\n\tFROM ld_salesorder \r\n\tWHERE deleted=0\r\n\tUNION \r\n\tSELECT \r\n\t\tservicecontractsid AS order_id,\r\n\t\tcontract_no AS order_no,\r\n\t\t'ServiceContracts' AS ordertype,\r\n\t\treceived_amount,\r\n\t\tcashbilldate,\r\n\t\ttotal AS order_total\r\n\tFROM ld_servicecontracts\r\n\tWHERE deleted=0 \r\n) b ON b.order_id=a.salesorderid\r\nINNER JOIN (\r\n\tSELECT\r\n\t\tSUM(amount) AS sk_total,\r\n\t\tamount,\r\n\t\tcashbilldate,\r\n\t\tentitytypeid\r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\ta.smownerid,\r\n\t\t\ta.cashbillid,\r\n\t\t\ta.cashbill_no,\r\n\t\t\ta.cashbilldate,\r\n\t\t\ta.accountid,\r\n\t\t\ta.currency_symbol,\r\n\t\t\ta.conversion_rate,\r\n\t\t\tCASE \r\n\t\t\t\tWHEN b.entitytype='PaymentPlan' THEN\r\n\t\t\t\t\t(SELECT entitytype FROM ld_paymentplan WHERE paymentplanid=b.entitytypeid)\r\n\t\t\t\tELSE b.entitytype\r\n\t\t\tEND AS entitytype,\r\n\t\t\tCASE \r\n\t\t\t\tWHEN b.entitytype='PaymentPlan' THEN\r\n\t\t\t\t\t(SELECT entitytypeid FROM ld_paymentplan WHERE paymentplanid=b.entitytypeid)\r\n\t\t\t\tELSE b.entitytypeid\r\n\t\t\tEND AS entitytypeid,\r\n\t\t\tCASE\r\n\t\t\t\tWHEN b.CashBillID>0 THEN  b.amount\r\n\t\t\t\tELSE a.Total\r\n\t\t\tEND AS amount,\r\n\t\t\ta.deleted,\r\n\t\t\ta.checkoutstatus\r\n\t\tFROM ld_cashbill a\r\n\t\tLEFT JOIN ld_cashbill2paymentplan b ON a.cashbillid = b.CashBillID\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND IFNULL(a.approvestatus,'')<>'已拒绝'\r\n\t\t\tAND a.cashbilldate BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\t\t\tAND (\r\n\t\t\t\tCASE \r\n\t\t\t\t\tWHEN EXISTS (SELECT 1 from ld_systems_deploy where deploy_type=83 and deploy_value=0) THEN 1=1\r\n\t\t\t\t\tELSE a.checkoutstatus='已审核'\r\n\t\t\t\tEND)\t\r\n\t\t\tHAVING 1\r\n\t\t\tORDER BY cashbilldate DESC\r\n\t) a\r\n\tWHERE entitytypeid>0\r\n\tGROUP BY entitytypeid\r\n) c ON c.entitytypeid=a.salesorderid\r\nLEFT JOIN ld_account k ON k.accountid=a.accountid\r\nLEFT JOIN ld_users u ON u.id=a.smownerid\r\nINNER JOIN (\r\n\tSELECT DISTINCT\r\n\t\tuserid \r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\tld_users.id AS userid \r\n\t\tFROM ld_users\r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Project' and scopeauthority=1 AND userid='[uuid]')\r\n\t\tUNION\r\n\t\tSELECT \r\n\t\t\tviewid AS userid \r\n\t\tFROM ld_scoperhigher\r\n\t\tWHERE userid='[uuid]' AND modulename ='Project' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename ='Project')\t\t\t\r\n\t\tUNION\r\n\t\tSELECT DISTINCT \r\n\t\t\tld_users2group.userid AS userid \r\n\t\tFROM ld_scoperhigher \r\n\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\tAND ld_scoperhigher.modulename ='Project'\r\n\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Project' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\tUNION \r\n\t\tSELECT \r\n\t\t\tid AS userid \r\n\t\tFROM ld_users  \r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\tUNION\r\n\t\tSELECT '[uuid]') AS vw_users\r\n) AS tmp_users ON tmp_users.userid=a.smownerid\r\nWHERE a.deleted=0\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN TRIM('{accountname}')='' THEN 1=1\r\n\t\t\tELSE LOCATE(TRIM('{accountname}'),(\tCASE WHEN EXISTS (SELECT 1 FROM ld_field WHERE tabid=48 AND columnname='end_accountid' AND presence<>1) THEN (SELECT accountname FROM ld_account WHERE accountid=a.end_accountid) ELSE k.accountname END))>0\r\n\t\tEND) \r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN TRIM('{jieduan}')='' THEN a.projectstatus IN (SELECT listvalue FROM ld_picklist_set a LEFT JOIN ld_picklist_values b ON b.listid=a.listid WHERE a.listname='projectstatus')\r\n\t\t\tELSE FIND_IN_SET(a.projectstatus,'{jieduan}')\r\n\t\tEND) \r\n\tAND(\r\n\t\tCASE\r\n\t\t\tWHEN FIND_IN_SET(1,'{data_range}') OR '{data_range}'='' THEN 1=1\r\n\t\t\tWHEN FIND_IN_SET(2,'{data_range}') THEN a.smownerid='[uuid]'\r\n\t\t\tELSE \r\n\t\t\t\t\t\ta.smownerid IN (\r\n\t\t\t\t\t\t\t\tSELECT\r\n\t\t\t\t\t\t\t\t\ta.userid\r\n\t\t\t\t\t\t\t\tFROM ld_users2group a\r\n\t\t\t\t\t\t\t\tINNER JOIN (\r\n\t\t\t\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\t\t\t\tsubstring_index(substring_index(a.splitsting,',',b.seq+1),',',-1)-200000 AS groupid\r\n\t\t\t\t\t\t\t\t\tFROM (SELECT '{data_range}' AS splitsting) a \r\n\t\t\t\t\t\t\t\t\tLEFT JOIN sequence b ON b.seq < (length(a.splitsting) - length(replace(a.splitsting,',',''))+1) \r\n\t\t\t\t\t\t\t\t\tWHERE substring_index(substring_index(a.splitsting,',',b.seq+1),',',-1) BETWEEN 200000 AND 300000\r\n\t\t\t\t\t\t\t\t) b ON b.groupid=a.groupid\r\n\t\t\t\t\t\t\t\tGROUP BY a.userid\r\n\t\t\t\t\t\t\t\tUNION \r\n\t\t\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\t\t\tsubstring_index(substring_index(a.splitsting,',',b.seq+1),',',-1)-300000 AS groupid\r\n\t\t\t\t\t\t\t\tFROM (SELECT '{data_range}' AS splitsting) a \r\n\t\t\t\t\t\t\t\tLEFT JOIN sequence b ON b.seq < (length(a.splitsting) - length(replace(a.splitsting,',',''))+1) \r\n\t\t\t\t\t\t\t\tWHERE substring_index(substring_index(a.splitsting,',',b.seq+1),',',-1)>300000\r\n\t\t\t\t\t\t)\r\n\t\tEND)"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "LAB",
        "Alias": "LAB",
        "Columns": {
          "0": {
            "Name": "LAB1",
            "Index": -1,
            "NameInSource": "LAB1",
            "Alias": "LAB1",
            "Type": "System.String"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\t(\r\n\t\tSELECT \r\n\t\t\tfieldlabel \r\n\t\tFROM ld_tranlabel \r\n\t\tWHERE languagetype='zh' \r\n\t\t\tAND trantable='ld_field' \r\n\t\t\tAND tabid=48\r\n\t\t\tAND Relateid=(SELECT fieldid FROM ld_field WHERE tabid=48 AND columnname='smownerid' LIMIT 1)\r\n\t\t) AS LAB1"
      },
      "2": {
        "Ident": "StiMySqlSource",
        "Name": "list_users",
        "Alias": "list_users",
        "Columns": {
          "0": {
            "Name": "list_order",
            "Index": -1,
            "NameInSource": "list_order",
            "Alias": "list_order",
            "Type": "System.String"
          },
          "1": {
            "Name": "listid",
            "Index": -1,
            "NameInSource": "listid",
            "Alias": "listid",
            "Type": "System.Int32"
          },
          "2": {
            "Name": "listtype",
            "Index": -1,
            "NameInSource": "listtype",
            "Alias": "listtype",
            "Type": "System.Int32"
          },
          "3": {
            "Name": "listvalue",
            "Index": -1,
            "NameInSource": "listvalue",
            "Alias": "listvalue",
            "Type": "System.String"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT 1 AS listid,'全部' AS listvalue,0 AS list_order,1 AS listtype\r\nUNION\r\nSELECT 2 AS listid, '我负责的' AS listvalue,0 AS list_order,2 AS listtype\r\nUNION (\r\n\tSELECT\r\n\t\ta.groupid+200000 AS listid,\r\n\t\tCONCAT('部门::',IFNULL(a.groupname,'')) AS listvalue,\r\n\t\tGROUP_CONCAT(IFNULL(a.splitsting,'') ORDER BY a.splitsting SEPARATOR '::') AS listorder,\r\n\t\t1 AS listtype\r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\ta.groupid, \r\n\t\t\ta.groupname, \r\n\t\t\tLPAD(substring_index(substring_index(a.splitsting,',',b.seq+1),',',-1),8,'0') AS splitsting\r\n\t\tFROM (\r\n\t\t\tSELECT \r\n\t\t\t\ta.groupid,\r\n\t\t\t\ta.groupname, \r\n\t\t\t\tREPLACE(a.parentgroup,'::',',') AS splitsting \r\n\t\t\tFROM ld_groups a\r\n\t\t\tLEFT JOIN ld_users2group b ON b.groupid=a.groupid\r\n\t\t\tGROUP BY a.groupid\r\n\t\t) a \r\n\t\tLEFT JOIN sequence b ON b.seq < (length(a.splitsting) - length(replace(a.splitsting,',',''))+1)\r\n\t) a\r\n\tGROUP BY a.groupid\r\n)\r\nUNION (\r\n\tSELECT\r\n\t\ta.id+300000 AS listid,\r\n\t\tCONCAT('用户::',IFNULL(a.last_name,''),'(',c.listvalue,')') AS listvalue,\r\n\t\tc.listorder,\r\n\t\t2 AS listtype\r\n\tFROM ld_users a\r\n\tLEFT JOIN ld_users2group b ON b.userid=a.id  \r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\ta.groupid,\r\n\t\t\ta.groupid+200000 AS listid,\r\n\t\t\tCONCAT('部门::',IFNULL(a.groupname,'')) AS listvalue,\r\n\t\t\tGROUP_CONCAT(IFNULL(a.splitsting,'') ORDER BY a.splitsting SEPARATOR '::') AS listorder\r\n\t\tFROM (\r\n\t\t\tSELECT \r\n\t\t\t\ta.groupid, \r\n\t\t\t\ta.groupname, \r\n\t\t\t\tLPAD(substring_index(substring_index(a.splitsting,',',b.seq+1),',',-1),8,'0') AS splitsting\r\n\t\t\tFROM (\r\n\t\t\t\tSELECT \r\n\t\t\t\t\ta.groupid,\r\n\t\t\t\t\ta.groupname, \r\n\t\t\t\t\tREPLACE(a.parentgroup,'::',',') AS splitsting \r\n\t\t\t\tFROM ld_groups a\r\n\t\t\t\tLEFT JOIN ld_users2group b ON b.groupid=a.groupid\r\n\t\t\t\tGROUP BY a.groupid\r\n\t\t\t) a \r\n\t\t\tLEFT JOIN sequence b ON b.seq < (length(a.splitsting) - length(replace(a.splitsting,',',''))+1)\r\n\t\t) a\r\n\t\tGROUP BY a.groupid\r\n\t) c ON c.groupid=b.groupid\r\n\tINNER JOIN (\r\n\t\tSELECT DISTINCT\r\n\t\t\tuserid \r\n\t\tFROM (\r\n\t\t\tSELECT \r\n\t\t\t\tld_users.id AS userid \r\n\t\t\tFROM ld_users\r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Project' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\tUNION\r\n\t\t\tSELECT \r\n\t\t\t\tviewid AS userid \r\n\t\t\tFROM ld_scoperhigher\r\n\t\t\tWHERE userid='[uuid]' AND modulename ='Project' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename ='Project')\t\t\t\r\n\t\t\tUNION\r\n\t\t\tSELECT DISTINCT \r\n\t\t\t\tld_users2group.userid AS userid \r\n\t\t\tFROM ld_scoperhigher \r\n\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\tAND ld_scoperhigher.modulename ='Project'\r\n\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Project' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\tUNION \r\n\t\t\tSELECT \r\n\t\t\t\tid AS userid \r\n\t\t\tFROM ld_users  \r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\tUNION\r\n\t\t\tSELECT '[uuid]') AS vw_users\r\n\t) AS tmp_users ON tmp_users.userid=a.id\r\n\tWHERE a.deleted=0\r\n\t\tAND a.`status`='Active'\r\n)\r\nORDER BY list_order,listtype"
      },
      "3": {
        "Ident": "StiMySqlSource",
        "Name": "list_jieduan",
        "Alias": "list_jieduan",
        "Columns": {
          "0": {
            "Name": "listid",
            "Index": -1,
            "NameInSource": "listid",
            "Alias": "listid",
            "Type": "System.Int32"
          },
          "1": {
            "Name": "listvalue",
            "Index": -1,
            "NameInSource": "listvalue",
            "Alias": "listvalue",
            "Type": "System.String"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\tb.listvalue,\r\n\tb.listid\r\nFROM ld_picklist_set a\r\nLEFT JOIN ld_picklist_values b ON b.listid=a.listid \r\nWHERE a.listname='projectstatus'\r\nORDER BY b.sequence"
      }
    },
    "Databases": {
      "0": {
