            "NameInSource": "15_xingtai4",
            "Alias": "15_xingtai4",
            "Type": "System.String"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\tDATE_FORMAT(b.cf_2999,'%y.%m.%d') AS 01_date,\r\n\tc.projectname AS 02_chepai,\r\n\td.vendorname AS 03_siji,\r\n\tt1.accountname AS 04_kehu1,\r\n\tb.cf_3032 AS 05_qty1,\r\n\tb.cf_2993 AS 06_xingtai1,\r\n\tt2.accountname AS 07_kehu2,\r\n\tb.cf_3029 AS 08_qty2,\r\n\tb.cf_3000 AS 09_xingtai2,\r\n\tt3.accountname AS 10_kehu3,\r\n\tb.cf_3030 AS 11_qty3,\r\n\tb.cf_3005 AS 12_xingtai3,\r\n\tt4.accountname AS 13_kehu4,\r\n\tb.cf_3031 AS 14_qty4,\r\n\tb.cf_3010 AS 15_xingtai4\r\nFROM ld_customform02 a\r\nLEFT JOIN ld_customform02scf b On b.customform02id=a.customform02id\r\nLEFT JOIN ld_project c ON c.projectid=a.projectid\r\nLEFT JOIN ld_vendor d ON d.vendorid=a.vendorid\r\nLEFT JOIN ld_account t1 ON t1.accountid=a.accountid_01\r\nLEFT JOIN ld_account t2 ON t2.accountid=a.accountid_02\r\nLEFT JOIN ld_account t3 ON t3.accountid=a.accountid_03\r\nLEFT JOIN ld_account t4 ON t4.accountid=a.accountid_04\r\nWHERE b.cf_2999 BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\nORDER BY b.cf_2999,c.projectname"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "list_nian",
        "Alias": "list_nian",
        "Columns": {
          "0": {
            "Name": "list_value",
            "Index": -1,
            "NameInSource": "list_value",
            "Alias": "list_value",
            "Type": "System.Decimal"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT YEAR(NOW())-7 AS list_value\r\nUNION\r\nSELECT YEAR(NOW())-6 AS list_value\r\nUNION\r\nSELECT YEAR(NOW())-5 AS list_value\r\nUNION\r\nSELECT YEAR(NOW())-4 AS list_value\r\nUNION\r\nSELECT YEAR(NOW())-3 AS list_value\r\nUNION\r\nSELECT YEAR(NOW())-2 AS list_value\r\nUNION\r\nSELECT YEAR(NOW())-1 AS list_value\r\nUNION\r\nSELECT YEAR(NOW()) AS list_value"
      }
