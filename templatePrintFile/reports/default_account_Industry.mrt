          "1": {
            "Name": "seq",
            "Index": -1,
            "NameInSource": "seq",
            "Alias": "seq",
            "Type": "System.Int32"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "\tSELECT 0 AS seq, '空值' AS bill_state\r\n\tUNION\r\n\tSELECT \r\n\t\tsequence AS seq,\r\n\t\tb.listvalue\r\n\tFROM ld_picklist_set a\r\n\tLEFT JOIN ld_picklist_values b ON a.listid=b.listid\r\n\tWHERE a.listname='bill_state'\r\n\t\tAND a.relatetable='ld_field'\r\n\tORDER BY seq"
      },
      "2": {
        "Ident": "StiMySqlSource",
        "Name": "users",
        "Alias": "users",
        "Columns": {
          "0": {
            "Name": "id",
            "Index": -1,
            "NameInSource": "id",
            "Alias": "id",
            "Type": "System.Int32"
          },
          "1": {
            "Name": "last_name",
            "Index": -1,
            "NameInSource": "last_name",
            "Alias": "last_name",
            "Type": "System.String"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\ta.id,\r\n\ta.last_name\r\nFROM ld_users a\r\nINNER JOIN (\r\n\tSELECT DISTINCT\r\n\t\tuserid \r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\tld_users.id as userid \r\n\t\tFROM ld_users\r\n\t\tWHERE EXISTS(select 1 from ld_setscoperhigher where modulename='Accounts' and scopeauthority=1 and userid='[uuid]')\r\n\t\tUNION\r\n\t\tselect \r\n\t\t\tviewid as userid \r\n\t\tfrom ld_scoperhigher\r\n\t\twhere userid='[uuid]' and modulename='Accounts' and EXISTS(select 1 from ld_setscoperhigher where userid='[uuid]' and scopeauthority=2 and modulename='Accounts')\t\t\t\r\n\t\tUNION\r\n\t\tselect DISTINCT \r\n\t\t\tld_users2group.userid as userid \r\n\t\tfrom ld_scoperhigher \r\n\t\tINNER JOIN ld_groups on ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\tINNER JOIN ld_users2group on ld_users2group.groupid=ld_groups.groupid\r\n\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\tand ld_scoperhigher.modulename='Accounts'\r\n\t\t\tand ld_scoperhigher.scopeauthority=3 \r\n\t\t\tand EXISTS(select 1 from ld_setscoperhigher where modulename='Accounts' and scopeauthority=3 and userid='[uuid]')\r\n\t\tUNION \r\n\t\tselect \r\n\t\t\tid as userid \r\n\t\tfrom ld_users  \r\n\t\twhere exists(select 1 from ld_users where id='[uuid]' and is_admin='on')\r\n\t\tUNION\r\n\t\tselect '[uuid]')as vw_users\r\n) as tmp_users ON tmp_users.userid=a.id\r\norder by CONVERT(a.last_name USING gbk)"
      },
      "3": {
        "Ident": "StiMySqlSource",
        "Name": "report",
        "Alias": "report",
        "Columns": {
          "0": {
            "Name": "argument_column",
            "Index": -1,
            "NameInSource": "argument_column",
            "Alias": "argument_column",
            "Type": "System.String"
          },
          "1": {
            "Name": "value_column",
            "Index": -1,
            "NameInSource": "value_column",
            "Alias": "value_column",
            "Type": "System.Int32"
          }
        },
        "NameInSource": "ldcrm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\tCASE\r\n\t\tWHEN a.industry IS NULL OR a.industry='' or a.industry='--无--' THEN '空值' \r\n\t\tELSE a.industry \r\n\tEND AS argument_column,\r\nCOUNT(1) AS value_column\r\nFROM ld_account a\r\nLEFT JOIN ld_accountscf c ON c.accountid=a.accountid\r\nLEFT JOIN ld_users b ON b.id=a.smownerid\r\nINNER JOIN (\r\n\tSELECT DISTINCT\r\n\t\tuserid \r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\tld_users.id AS userid \r\n\t\tFROM ld_users\r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='Accounts' and scopeauthority=1 AND userid='[uuid]')\r\n\t\tUNION\r\n\t\tSELECT \r\n\t\t\tviewid AS userid \r\n\t\tFROM ld_scoperhigher\r\n\t\tWHERE userid='[uuid]' AND modulename='Accounts' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename='Accounts')\t\t\t\r\n\t\tUNION\r\n\t\tSELECT DISTINCT \r\n\t\t\tld_users2group.userid AS userid \r\n\t\tFROM ld_scoperhigher \r\n\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\tAND ld_scoperhigher.modulename='Accounts'\r\n\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='Accounts' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\tUNION \r\n\t\tSELECT \r\n\t\t\tid AS userid \r\n\t\tFROM ld_users  \r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\tUNION\r\n\t\tSELECT '[uuid]') AS vw_users\r\n) AS tmp_users ON tmp_users.userid=a.smownerid\r\nWHERE a.deleted=0\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{userid}'='' THEN 1=1\r\n\t\t\tELSE FIND_IN_SET(CASE WHEN a.smownerid IS NULL THEN 1 ELSE a.smownerid END,'{userid}')\r\n\t\tEND)\r\n\tAND (\r\n\t\tCASE \r\n\t\t\tWHEN '{bill_state}'='' THEN 1=1 \r\n\t\t\tELSE FIND_IN_SET(IF(IFNULL(a.bill_state,'')='' OR a.bill_state='--无--','空值',a.bill_state),'{bill_state}')\r\n\t\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{createdtime}'='全部' THEN 1=1\r\n\t\t\tWHEN '{createdtime}'='本年' THEN YEAR(a.createdtime)=YEAR(NOW())\r\n\t\t\tWHEN '{createdtime}'='本月' THEN YEAR(a.createdtime)=YEAR(NOW()) AND MONTH(a.createdtime)=MONTH(NOW())\r\n\t\t\tWHEN '{createdtime}'='本周' THEN DATE_FORMAT(a.createdtime,'%Y-%m-%d') \r\n\t\t\t\t\t\t\t\tBETWEEN DATE_SUB(CURDATE(),INTERVAL WEEKDAY(CURDATE()) DAY) \r\n\t\t\t\t\t\t\t\t\t\tAND DATE_ADD(CURDATE(),INTERVAL 6-WEEKDAY(CURDATE()) DAY)\r\n\t\t\tWHEN '{createdtime}'='今天' THEN DATE_FORMAT(a.createdtime,'%Y-%m-%d')=DATE_FORMAT(NOW(),'%Y-%m-%d')\r\n\t\t\tWHEN '{createdtime}'='去年' THEN YEAR(a.createdtime)=YEAR(NOW())-1\r\n\t\t\tWHEN '{createdtime}'='上月' THEN\tDATE_FORMAT(a.createdtime,'%Y-%m-%d') \r\n\t\t\t\t\t\t\t\tBETWEEN DATE_SUB(DATE_SUB(CURDATE(),INTERVAL DAY(CURDATE())-1 DAY),INTERVAL 1 MONTH) \r\n\t\t\t\t\t\t\t\t\t\tAND DATE_SUB(DATE_SUB(CURDATE(),INTERVAL DAY(CURDATE())-1 DAY),INTERVAL 1 DAY)\r\n\t\t\tWHEN '{createdtime}'='上周' THEN DATE_FORMAT(a.createdtime,'%Y-%m-%d') \r\n\t\t\t\t\t\t\t\tBETWEEN DATE_SUB(CURDATE(),INTERVAL WEEKDAY(CURDATE())+7 DAY) \r\n\t\t\t\t\t\t\t\t\t\tAND DATE_SUB(CURDATE(),INTERVAL WEEKDAY(CURDATE())+1 DAY)\r\n\t\t\t\r\n\t\t\tWHEN '{createdtime}'='昨天' THEN DATE_FORMAT(a.createdtime,'%Y-%m-%d')=DATE_SUB(CURDATE(),INTERVAL 1 DAY)\r\n\t\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{modifiedtime}'='全部' THEN 1=1\r\n\t\t\tWHEN '{modifiedtime}'='本年' THEN YEAR(a.modifiedtime)=YEAR(NOW())\r\n\t\t\tWHEN '{modifiedtime}'='本月' THEN YEAR(a.modifiedtime)=YEAR(NOW()) AND MONTH(a.modifiedtime)=MONTH(NOW())\r\n\t\t\tWHEN '{modifiedtime}'='本周' THEN DATE_FORMAT(a.modifiedtime,'%Y-%m-%d') \r\n\t\t\t\t\t\t\t\tBETWEEN DATE_SUB(CURDATE(),INTERVAL WEEKDAY(CURDATE()) DAY) \r\n\t\t\t\t\t\t\t\t\t\tAND DATE_ADD(CURDATE(),INTERVAL 6-WEEKDAY(CURDATE()) DAY)\r\n\t\t\tWHEN '{modifiedtime}'='今天' THEN DATE_FORMAT(a.modifiedtime,'%Y-%m-%d')=DATE_FORMAT(NOW(),'%Y-%m-%d')\r\n\t\t\tWHEN '{modifiedtime}'='去年' THEN YEAR(a.modifiedtime)=YEAR(NOW())-1\r\n\t\t\tWHEN '{modifiedtime}'='上月' THEN\tDATE_FORMAT(a.modifiedtime,'%Y-%m-%d') \r\n\t\t\t\t\t\t\t\tBETWEEN DATE_SUB(DATE_SUB(CURDATE(),INTERVAL DAY(CURDATE())-1 DAY),INTERVAL 1 MONTH) \r\n\t\t\t\t\t\t\t\t\t\tAND DATE_SUB(DATE_SUB(CURDATE(),INTERVAL DAY(CURDATE())-1 DAY),INTERVAL 1 DAY)\r\n\t\t\tWHEN '{modifiedtime}'='上周' THEN DATE_FORMAT(a.modifiedtime,'%Y-%m-%d') \r\n\t\t\t\t\t\t\t\tBETWEEN DATE_SUB(CURDATE(),INTERVAL WEEKDAY(CURDATE())+7 DAY) \r\n\t\t\t\t\t\t\t\t\t\tAND DATE_SUB(CURDATE(),INTERVAL WEEKDAY(CURDATE())+1 DAY)\r\n\t\t\t\r\n\t\t\tWHEN '{modifiedtime}'='昨天' THEN DATE_FORMAT(a.modifiedtime,'%Y-%m-%d')=DATE_SUB(CURDATE(),INTERVAL 1 DAY)\r\n\t\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{nolinkdays_from}'='' THEN 1=1\r\n\t\t\tELSE IFNULL(a.nolinkdays,0)>=('{nolinkdays_from}'+0)\r\n\t\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{nolinkdays_to}'='' OR '{nolinkdays_to}'=0 THEN 1=1\r\n\t\t\tELSE IFNULL(a.nolinkdays,0)<=('{nolinkdays_to}'+0)\r\n\t\tEND)\r\nGROUP BY argument_column"
      },
