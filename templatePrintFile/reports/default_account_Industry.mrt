        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT \r\n\treport_title,\r\n\taccountname,\r\n\tbill_state,\r\n\tcreatedtime,\r\n\tmodifiedtime,\r\n\tnolinkdays,\r\n\tsmownerid\r\nFROM (\r\n\t\tSELECT \r\n\t\t\t1 AS id,\r\n\t\t\tb.fieldlabel AS report_title\r\n\t\tFROM ld_field a\r\n\t\tLEFT JOIN ld_tranlabel b ON b.trantable='ld_field' AND b.languagetype='zh' AND b.Relateid=a.fieldid\r\n\t\tWHERE a.tabid=6 \r\n\t\t\tAND a.columnname='industry'\r\n\t\tLIMIT 1\r\n) a \r\nLEFT JOIN (\r\n\tSELECT \r\n\t\t1 AS id,\r\n\t\tb.fieldlabel AS accountname\r\n\tFROM ld_field a\r\n\tLEFT JOIN ld_tranlabel b ON b.trantable='ld_field' AND b.languagetype='zh' AND b.Relateid=a.fieldid\r\n\tWHERE a.tabid=6 \r\n\t\tAND a.columnname='accountname'\r\n\tLIMIT 1\r\n) b ON a.id=b.id\r\nLEFT JOIN (\r\n\tSELECT \r\n\t\t1 AS id,\r\n\t\tb.fieldlabel AS bill_state\r\n\tFROM ld_field a\r\n\tLEFT JOIN ld_tranlabel b ON b.trantable='ld_field' AND b.languagetype='zh' AND b.Relateid=a.fieldid\r\n\tWHERE a.tabid=6 \r\n\t\tAND a.columnname='bill_state'\r\n\tLIMIT 1\r\n) c ON a.id=c.id\r\nLEFT JOIN (\r\n\tSELECT \r\n\t\t1 AS id,\r\n\t\tb.fieldlabel AS createdtime\r\n\tFROM ld_field a\r\n\tLEFT JOIN ld_tranlabel b ON b.trantable='ld_field' AND b.languagetype='zh' AND b.Relateid=a.fieldid\r\n\tWHERE a.tabid=6 \r\n\t\tAND a.columnname='createdtime'\r\n\tLIMIT 1\r\n) d ON a.id=d.id\r\nLEFT JOIN (\r\n\tSELECT \r\n\t\t1 AS id,\r\n\t\tb.fieldlabel AS modifiedtime\r\n\tFROM ld_field a\r\n\tLEFT JOIN ld_tranlabel b ON b.trantable='ld_field' AND b.languagetype='zh' AND b.Relateid=a.fieldid\r\n\tWHERE a.tabid=6 \r\n\t\tAND a.columnname='modifiedtime'\r\n\tLIMIT 1\r\n) e ON a.id=e.id\r\nLEFT JOIN (\r\n\tSELECT \r\n\t\t1 AS id,\r\n\t\tb.fieldlabel AS nolinkdays\r\n\tFROM ld_field a\r\n\tLEFT JOIN ld_tranlabel b ON b.trantable='ld_field' AND b.languagetype='zh' AND b.Relateid=a.fieldid\r\n\tWHERE a.tabid=6 \r\n\t\tAND a.columnname='nolinkdays'\r\n\tLIMIT 1\r\n) f ON a.id=f.id\r\nLEFT JOIN (\r\n\tSELECT \r\n\t\t1 AS id,\r\n\t\tb.fieldlabel AS smownerid\r\n\tFROM ld_field a\r\n\tLEFT JOIN ld_tranlabel b ON b.trantable='ld_field' AND b.languagetype='zh' AND b.Relateid=a.fieldid\r\n\tWHERE a.tabid=6 \r\n\t\tAND a.columnname='smownerid'\r\n\tLIMIT 1\r\n) g ON a.id=g.id"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "state",
