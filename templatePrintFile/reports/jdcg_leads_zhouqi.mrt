            "Type": "System.Int32"
          },
          "7": {
            "Name": "zhouqi_shangji",
            "Index": -1,
            "NameInSource": "zhouqi_shangji",
            "Alias": "zhouqi_shangji",
            "Type": "System.Int32"
          },
          "8": {
            "Name": "zhouqi_toubiao",
            "Index": -1,
            "NameInSource": "zhouqi_toubiao",
            "Alias": "zhouqi_toubiao",
            "Type": "System.Int32"
          }
        },
        "NameInSource": "crm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\ta.potentialid AS id,\r\n\tb.cf_5281 AS xm_no,\r\n\ta.potentialname AS xm_name,\r\n\tb.cf_3677 AS chanpin_xian,\r\n\tb.cf_5709 AS xm_laiyuan,\r\n\r\n\tCASE\r\n\t\tWHEN d.outtime IS NULL THEN NULL\r\n\t\tWHEN d.outtime<=IFNULL(c.intime,a.createdtime) THEN NULL\r\n\t\tELSE DATEDIFF(d.outtime,IFNULL(c.intime,a.createdtime))\r\n\tEND AS zhouqi_shangji,\r\n\tCASE\r\n\t\tWHEN f.outtime IS NULL OR e.intime IS NULL THEN NULL\r\n\t\tWHEN f.outtime<=e.intime THEN NULL\r\n\t\tELSE DATEDIFF(f.outtime,e.intime)\r\n\tEND AS zhouqi_lixiang,\r\n\tCASE\r\n\t\tWHEN h.outtime IS NULL OR g.intime IS NULL THEN NULL\r\n\t\tWHEN h.outtime<=g.intime THEN NULL\r\n\t\tELSE DATEDIFF(h.outtime,g.intime)\r\n\tEND AS zhouqi_toubiao,\r\n\tCASE\r\n\t\tWHEN j.outtime IS NULL OR i.intime IS NULL THEN NULL\r\n\t\tWHEN j.outtime<=i.intime THEN NULL\r\n\t\tELSE DATEDIFF(j.outtime,i.intime)\r\n\tEND AS zhouqi_hetong\r\nFROM (\r\n\tSELECT\r\n\t\ta.*\r\n\tFROM ld_potential a\r\n\tINNER JOIN (\r\n\t\tSELECT DISTINCT\r\n\t\t\tuserid \r\n\t\tFROM (\r\n\t\t\tSELECT \r\n\t\t\t\tld_users.id AS userid \r\n\t\t\tFROM ld_users\r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Potentials' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\tUNION\r\n\t\t\tSELECT \r\n\t\t\t\tviewid AS userid \r\n\t\t\tFROM ld_scoperhigher\r\n\t\t\tWHERE userid='[uuid]' AND modulename ='Potentials' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename ='Potentials')\t\t\t\r\n\t\t\tUNION\r\n\t\t\tSELECT DISTINCT \r\n\t\t\t\tld_users2group.userid AS userid \r\n\t\t\tFROM ld_scoperhigher \r\n\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\tAND ld_scoperhigher.modulename ='Potentials'\r\n\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Potentials' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\tUNION \r\n\t\t\tSELECT \r\n\t\t\t\tid AS userid \r\n\t\t\tFROM ld_users  \r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\tUNION\r\n\t\t\tSELECT '[uuid]') AS vw_users\r\n\t) AS tmp_users ON tmp_users.userid=a.smownerid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND a.createdtime BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d %H:%i:%s') AND DATE_FORMAT('{end_date}','%Y-%m-%d %H:%i:%s')\r\n\tUNION\r\n\tSELECT\r\n\t\ta.*\r\n\tFROM ld_potential a\r\n\tINNER JOIN ld_tabshare s ON s.crmid=a.potentialid\r\n\tWHERE s.viewuserid='[uuid]'\r\n\t\tAND a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND a.createdtime BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d %H:%i:%s') AND DATE_FORMAT('{end_date}','%Y-%m-%d %H:%i:%s')\r\n) a\r\nLEFT JOIN ld_potentialscf b ON b.potentialid=a.potentialid\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\ta.crmid,\r\n\t\tMIN(a.changedon) AS intime\r\n\tFROM ld_modtracker_basic a\r\n\tLEFT JOIN ld_modtracker_detail b ON b.id=a.id\r\n\tINNER JOIN ld_potential c ON c.potentialid=a.crmid\r\n\tWHERE a.module='Potentials'\r\n\t\tAND b.fieldname='sales_stage'\r\n\t\tAND b.postvalue='线索阶段'\r\n\tGROUP BY a.crmid\r\n) c ON c.crmid=a.potentialid\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\ta.crmid,\r\n\t\tMAX(a.changedon) AS outtime\r\n\tFROM ld_modtracker_basic a\r\n\tLEFT JOIN ld_modtracker_detail b ON b.id=a.id\r\n\tINNER JOIN ld_potential c ON c.potentialid=a.crmid\r\n\tWHERE a.module='Potentials'\r\n\t\tAND b.fieldname='sales_stage'\r\n\t\tAND b.prevalue='线索阶段'\r\n\tGROUP BY a.crmid\r\n) d ON d.crmid=a.potentialid\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\ta.crmid,\r\n\t\tMIN(a.changedon) AS intime\r\n\tFROM ld_modtracker_basic a\r\n\tLEFT JOIN ld_modtracker_detail b ON b.id=a.id\r\n\tINNER JOIN ld_potential c ON c.potentialid=a.crmid\r\n\tWHERE a.module='Potentials'\r\n\t\tAND b.fieldname='sales_stage'\r\n\t\tAND b.postvalue='商机阶段'\r\n\tGROUP BY a.crmid\r\n) e ON e.crmid=a.potentialid\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\ta.crmid,\r\n\t\tMAX(a.changedon) AS outtime\r\n\tFROM ld_modtracker_basic a\r\n\tLEFT JOIN ld_modtracker_detail b ON b.id=a.id\r\n\tINNER JOIN ld_potential c ON c.potentialid=a.crmid\r\n\tWHERE a.module='Potentials'\r\n\t\tAND b.fieldname='sales_stage'\r\n\t\tAND b.prevalue='商机阶段'\r\n\tGROUP BY a.crmid\r\n) f ON f.crmid=a.potentialid\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\ta.crmid,\r\n\t\tMIN(a.changedon) AS intime\r\n\tFROM ld_modtracker_basic a\r\n\tLEFT JOIN ld_modtracker_detail b ON b.id=a.id\r\n\tINNER JOIN ld_potential c ON c.potentialid=a.crmid\r\n\tWHERE a.module='Potentials'\r\n\t\tAND b.fieldname='sales_stage'\r\n\t\tAND b.postvalue='立项阶段'\r\n\tGROUP BY a.crmid\r\n) g ON g.crmid=a.potentialid\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\ta.crmid,\r\n\t\tMAX(a.changedon) AS outtime\r\n\tFROM ld_modtracker_basic a\r\n\tLEFT JOIN ld_modtracker_detail b ON b.id=a.id\r\n\tINNER JOIN ld_potential c ON c.potentialid=a.crmid\r\n\tWHERE a.module='Potentials'\r\n\t\tAND b.fieldname='sales_stage'\r\n\t\tAND b.prevalue='立项阶段'\r\n\tGROUP BY a.crmid\r\n) h ON h.crmid=a.potentialid\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\ta.crmid,\r\n\t\tMIN(a.changedon) AS intime\r\n\tFROM ld_modtracker_basic a\r\n\tLEFT JOIN ld_modtracker_detail b ON b.id=a.id\r\n\tINNER JOIN ld_potential c ON c.potentialid=a.crmid\r\n\tWHERE a.module='Potentials'\r\n\t\tAND b.fieldname='sales_stage'\r\n\t\tAND b.postvalue='商务谈判'\r\n\tGROUP BY a.crmid\r\n) i ON i.crmid=a.potentialid\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\ta.crmid,\r\n\t\tMAX(a.changedon) AS outtime\r\n\tFROM ld_modtracker_basic a\r\n\tLEFT JOIN ld_modtracker_detail b ON b.id=a.id\r\n\tINNER JOIN ld_potential c ON c.potentialid=a.crmid\r\n\tWHERE a.module='Potentials'\r\n\t\tAND b.fieldname='sales_stage'\r\n\t\tAND b.prevalue='商务谈判'\r\n\tGROUP BY a.crmid\r\n) j ON j.crmid=a.potentialid\r\nWHERE a.deleted=0\r\n\tAND a.approvestatus<>'已拒绝'\r\n\tAND a.createdtime BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d %H:%i:%s') AND DATE_FORMAT('{end_date}','%Y-%m-%d %H:%i:%s')\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN TRIM('{xmname}')='' THEN 1=1\r\n\t\t\tELSE LOCATE(TRIM('{xmname}'),a.potentialname)>0\r\n\t\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN TRIM('{chanpinxian}')='' OR '{chanpinxian}'=(SELECT GROUP_CONCAT(listvalue ORDER BY sequence) FROM ld_picklist_values WHERE listid=180) THEN 1=1\r\n\t\t\tELSE FIND_IN_SET(b.cf_3677,'{chanpinxian}')\r\n\t\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN TRIM('{laiyuan}')='' OR '{laiyuan}'=(SELECT GROUP_CONCAT(listvalue ORDER BY sequence) FROM ld_picklist_values WHERE listid=178) THEN 1=1\r\n\t\t\tELSE FIND_IN_SET(b.cf_5709,'{laiyuan}')\r\n\t\tEND)"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "list_laiyuan",
        "Alias": "list_laiyuan",
