        "NameInSource": "crm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\tb.cf_3162 AS 01_fahuoren,\r\n\tb.cf_3163 AS 02_shouhuoren,\r\n\tb.cf_3164 AS 03_tongzhiren,\r\n\tb.cf_3165 AS 04_zhuanghuogang,\r\n\tb.cf_3166 AS 05_xiehuogang,\r\n\tb.cf_3167 AS 06_mudigang,\r\n\t(\r\n\t\tSELECT \r\n\t\t\tb.cf_3657\r\n\t\tFROM ld_customform26 a\r\n\t\tLEFT JOIN ld_customform26scf b ON b.customform26id=a.customform26id\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\tAND a.customform21_id=a.customform21_id\r\n\t\tORDER BY a.modifiedtime DESC LIMIT 1\r\n\t) AS 07_hangci,\r\n\tCASE\r\n\t\tWHEN a.xiangxing='CFS' THEN FORMAT(b.cf_3168,0)\r\n\t\tELSE NULL\r\n\tEND AS qty_01,\r\n\tCASE\r\n\t\tWHEN a.xiangxing=\"20'GP\" THEN FORMAT(b.cf_3168,0)\r\n\t\tELSE NULL\r\n\tEND AS qty_02,\r\n\tCASE\r\n\t\tWHEN a.xiangxing=\"40'GP\" THEN FORMAT(b.cf_3168,0)\r\n\t\tELSE NULL\r\n\tEND AS qty_03,\r\n\tCASE\r\n\t\tWHEN a.xiangxing=\"40'HQ\" THEN FORMAT(b.cf_3168,0)\r\n\t\tELSE NULL\r\n\tEND AS qty_04,\r\n\tCASE\r\n\t\tWHEN a.xiangxing=\"20'OT\" THEN FORMAT(b.cf_3168,0)\r\n\t\tELSE NULL\r\n\tEND AS qty_05,\r\n\tCASE\r\n\t\tWHEN a.xiangxing=\"40'OT\" THEN FORMAT(b.cf_3168,0)\r\n\t\tELSE NULL\r\n\tEND AS qty_06,\r\n\tCASE\r\n\t\tWHEN a.xiangxing=\"20'FR\" THEN FORMAT(b.cf_3168,0)\r\n\t\tELSE NULL\r\n\tEND AS qty_07,\r\n\tCASE\r\n\t\tWHEN a.xiangxing=\"40'FR\" THEN FORMAT(b.cf_3168,0)\r\n\t\tELSE NULL\r\n\tEND AS qty_08,\r\n\tCASE\r\n\t\tWHEN a.xiangxing=\"20'REEFER\" THEN FORMAT(b.cf_3168,0)\r\n\t\tELSE NULL\r\n\tEND AS qty_09,\r\n\tCASE\r\n\t\tWHEN a.xiangxing=\"40'REEFER\" THEN FORMAT(b.cf_3168,0)\r\n\t\tELSE NULL\r\n\tEND AS qty_10,\r\n\tb.cf_3169 AS 12_maoyitiaokuan,\r\n\tDATE_FORMAT(b.cf_3158,'%Y-%m-%d') AS 13_zhuanghuoriqi,\r\n\tCASE\r\n\t\tWHEN b.cf_3170='预付金额' THEN '√'\r\n\t\tELSE NULL\r\n\tEND AS yunfei_01,\r\n\tCASE\r\n\t\tWHEN b.cf_3170='到付金额' THEN '√'\r\n\t\tELSE NULL\r\n\tEND AS yunfei_02,\r\n\tCASE\r\n\t\tWHEN b.cf_3171='货运税票' THEN '√'\r\n\t\tELSE NULL\r\n\tEND AS fapiao_01,\r\n\tCASE\r\n\t\tWHEN b.cf_3171='普通发票' THEN '√'\r\n\t\tELSE NULL\r\n\tEND AS fapiao_02,\r\n\tCASE\r\n\t\tWHEN b.cf_3172='自行拖车' THEN '√'\r\n\t\tELSE NULL\r\n\tEND AS tuoche_01,\r\n\tCASE\r\n\t\tWHEN b.cf_3172='委托拖车' THEN '√'\r\n\t\tELSE NULL\r\n\tEND AS tuoche_02,\r\n\tCASE\r\n\t\tWHEN b.cf_3173='自行报关' THEN '√'\r\n\t\tELSE NULL\r\n\tEND AS baoguan_01,\r\n\tCASE\r\n\t\tWHEN b.cf_3173='委托报关' THEN '√'\r\n\t\tELSE NULL\r\n\tEND AS baoguan_02,\r\n\tCASE\r\n\t\tWHEN b.cf_3173='一般贸易' THEN '√'\r\n\t\tELSE NULL\r\n\tEND AS baoguan_03,\r\n\tCASE\r\n\t\tWHEN b.cf_3173='转关' THEN '√'\r\n\t\tELSE NULL\r\n\tEND AS baoguan_04,\r\n\tCASE\r\n\t\tWHEN b.cf_3173='手册报关' THEN '√'\r\n\t\tELSE NULL\r\n\tEND AS baoguan_05,\r\n\tCASE\r\n\t\tWHEN b.cf_3174='船东单' THEN '√'\r\n\t\tELSE NULL\r\n\tEND AS tidan_01,\r\n\tCASE\r\n\t\tWHEN b.cf_3174='威洋通提单' THEN '√'\r\n\t\tELSE NULL\r\n\tEND AS tidan_02,\r\n\tCASE\r\n\t\tWHEN b.cf_3174='电放单' THEN '√'\r\n\t\tELSE NULL\r\n\tEND AS tidan_03,\r\n\tCASE\r\n\t\tWHEN b.cf_3174='同行货代单' THEN '√'\r\n\t\tELSE NULL\r\n\tEND AS tidan_04,\r\n\tIFNULL(b.cf_3169,'') AS 20_maoyitiaokuan,\r\n\tIFNULL(a.description,'') AS 21_tebieyaoqiu,\r\n\tCONCAT('要求开航日期：',IFNULL(DATE_FORMAT(a.delivery_date,'%Y-%m-%d'),''),'\\r\\n','装货日期：',IFNULL(DATE_FORMAT(b.cf_3158,'%Y-%m-%d'),'')) AS 22_beizhu\r\nFROM ld_customform21 a\r\nLEFT JOIN ld_customform21scf b ON b.customform21id=a.customform21id\r\nWHERE a.customform21id='[related_ldcrmid]'"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "b",
        "Alias": "b",
        "Columns": {
          "0": {
