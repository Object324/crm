            "Type": "System.String"
          }
        },
        "NameInSource": "crm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\tb.sf131\tAS markno,\r\n\tFORMAT(b.sf223,2) AS shuliang,\r\n\tb.sf218 AS zh_name,\r\n\tb.sf219 AS en_name,\r\n\tFORMAT(b.sf135,2) AS maozhong,\r\n\tFORMAT(b.sf222,3) AS tiji\r\nFROM ld_customform21detail a\r\nLEFT JOIN ld_customform21detailscf b ON b.lineitem_id=a.lineitem_id\r\nWHERE a.id='[related_ldcrmid]'"
      }
    },
