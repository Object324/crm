        "NameInSource": "crm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\tversion,\r\n\tapprovetime,\r\n\tapprovestatus,\r\n\tbill_no,\r\n\tbill_id,\r\n\ttotal,\r\n\tquyu,\r\n\tlouceng,\r\n\tproductname,\r\n\r\n\ttaxprice,\r\n\twuyefeedanjia,\r\n\tservicecontracts_start_date,\r\n\tservicecontracts_end_date,\r\n\tmianyue,\r\n\twuye_mianyue,\r\n\tyajin,\r\n\tzujin,\r\n\twuyeguanlifee,\r\n\twuyefee,\r\n\ttax_amount\r\nFROM (\r\n\tSELECT\r\n\t\t'V1.0' AS version,\r\n\t\tDATE_FORMAT(a.approvetime,'%Y-%m-%d %H:%i') AS approvetime,\r\n\t\ta.approvestatus,\r\n\t\ta.contract_no AS bill_no,\r\n\t\ta.servicecontractsid AS bill_id,\r\n\t\ta.total,\r\n\t\tp.productcategory AS quyu,\r\n\t\td.cf_4158 AS louceng,\r\n\t\tp.productname,\r\n\r\n\t\tb.taxprice,\r\n\t\tc.sf8702 AS wuyefeedanjia,\r\n\t\tb.servicecontracts_start_date,\r\n\t\tb.servicecontracts_end_date,\r\n\t\tc.sf9542 AS mianyue,\r\n\t\tc.sf6207 AS wuye_mianyue,\r\n\t\tc.sf1622 AS yajin,\r\n\t\tc.sf6622 AS zujin,\r\n\t\tc.sf6830 AS wuyeguanlifee,\r\n\t\tc.sf7038 AS wuyefee,\r\n\t\tb.tax_amount,\r\n\t\tb.sequence_no,\r\n\t\t1 AS seq\r\n\tFROM ld_servicecontracts a\r\n\tLEFT JOIN ld_servicecontractsdetail b ON b.id=a.servicecontractsid\r\n\tLEFT JOIN ld_servicecontractsdetailscf c ON c.lineitem_id=b.lineitem_id\r\n\tLEFT JOIN ld_products p ON p.productid=b.productid\r\n\tLEFT JOIN ld_productcf d ON d.productid=p.productid\r\n\tWHERE a.servicecontractsid='[related_ldcrmid]'\r\n\t\tAND a.approvestatus<>'已批准'\r\n\tUNION\r\n\tSELECT\r\n\t\t'V1.0' AS version,\r\n\t\tDATE_FORMAT(a.approvetime,'%Y-%m-%d %H:%i') AS approvetime,\r\n\t\ta.approvestatus,\r\n\t\ta.contract_no AS bill_no,\r\n\t\ta.servicecontractsid AS bill_id,\r\n\t\te.total,\r\n\t\tp.productcategory AS quyu,\r\n\t\td.cf_4158 AS louceng,\r\n\t\tp.productname,\r\n\r\n\t\tb.taxprice,\r\n\t\tc.sf8702 AS wuyefeedanjia,\r\n\t\tb.servicecontracts_start_date,\r\n\t\tb.servicecontracts_end_date,\r\n\t\tc.sf9542 AS mianyue,\r\n\t\tc.sf6207 AS wuye_mianyue,\r\n\t\tc.sf1622 AS yajin,\r\n\t\tc.sf6622 AS zujin,\r\n\t\tc.sf6830 AS wuyeguanlifee,\r\n\t\tc.sf7038 AS wuyefee,\r\n\t\tb.tax_amount,\r\n\t\tb.sequence_no,\r\n\t\t1 AS seq\r\n\tFROM ld_servicecontracts a\r\n\tLEFT JOIN ld_servicecontractsdetail_approved b ON b.id=a.servicecontractsid\r\n\tLEFT JOIN ld_servicecontractsdetailscf_approved c ON c.lineitem_id=b.lineitem_id\r\n\tLEFT JOIN ld_products p ON p.productid=b.productid\r\n\tLEFT JOIN ld_productcf d ON d.productid=p.productid\r\n\tLEFT JOIN (\r\n\t\tSELECT \r\n\t\t\tid,\r\n\t\t\tSUM(tax_amount) AS total\r\n\t\tFROM ld_servicecontractsdetail_approved\r\n\t\tGROUP BY id\r\n\t) e ON e.id=a.servicecontractsid\r\n\tWHERE a.servicecontractsid='[related_ldcrmid]'\r\n\t\tAND a.approvestatus='已批准'\r\n\tUNION\r\n\tSELECT\r\n\t\tCONCAT('V',e.seq,'.0') AS version,\r\n\t\tDATE_FORMAT(a.approvetime,'%Y-%m-%d %H:%i') AS approvetime,\r\n\t\ta.approvestatus,\r\n\t\ta.customform16_no AS bill_no,\r\n\t\ta.customform16id AS bill_id,\r\n\t\ta.total,\r\n\t\tp.productcategory AS quyu,\r\n\t\td.cf_4158 AS louceng,\r\n\t\tp.productname,\r\n\r\n\t\tb.taxprice,\r\n\t\tc.sf8702 AS wuyefeedanjia,\r\n\t\tb.servicecontracts_start_date,\r\n\t\tb.servicecontracts_end_date,\r\n\t\tc.sf9542 AS mianyue,\r\n\t\tc.sf6207 AS wuye_mianyue,\r\n\t\tc.sf1622 AS yajin,\r\n\t\tc.sf6622 AS zujin,\r\n\t\tc.sf6830 AS wuyeguanlifee,\r\n\t\tc.sf7038 AS wuyefee,\r\n\t\tb.tax_amount,\r\n\t\tb.sequence_no,\r\n\t\te.seq\r\n\tFROM ld_customform16 a\r\n\tLEFT JOIN ld_customform16detail b ON b.id=a.customform16id\r\n\tLEFT JOIN ld_customform16detailscf c ON c.lineitem_id=b.lineitem_id\r\n\tLEFT JOIN ld_products p ON p.productid=b.productid\r\n\tLEFT JOIN ld_productcf d ON d.productid=p.productid\r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\ta.customform16id,\r\n\t\t\t(@i:=@i+1)+1 AS seq\r\n\t\tFROM (\r\n\t\t\tSELECT\r\n\t\t\t\ta.customform16id\r\n\t\t\tFROM ld_customform16 a\r\n\t\t\tLEFT JOIN ld_customform16detail b ON b.id=a.customform16id\r\n\t\t\tWHERE a.approvestatus='已批准'\r\n\t\t\t\tAND b.entitytypeid='[related_ldcrmid]'\r\n\t\t\tGROUP BY a.customform16id\r\n\t\t\tORDER BY a.approvetime,a.customform16id\r\n\t\t) a,(SELECT @i:=0) i\r\n\t) e ON e.customform16id=a.customform16id\r\n\tWHERE a.approvestatus='已批准'\r\n\t\tAND b.entitytypeid='[related_ldcrmid]'\r\n) a\r\nORDER BY a.seq DESC,a.sequence_no"
      }
    },
    "Databases": {
