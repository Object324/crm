          "2": {
            "Name": "productid",
            "Index": -1,
            "NameInSource": "productid",
            "Alias": "productid",
            "Type": "System.Int32"
          },
          "3": {
            "Name": "productname",
            "Index": -1,
            "NameInSource": "productname",
            "Alias": "productname",
            "Type": "System.String"
          },
          "4": {
            "Name": "quantity",
            "Index": -1,
            "NameInSource": "quantity",
            "Alias": "quantity",
            "Type": "System.Decimal"
          },
          "5": {
            "Name": "serialnumber",
            "Index": -1,
            "NameInSource": "serialnumber",
            "Alias": "serialnumber",
            "Type": "System.String"
          }
        },
        "NameInSource": "crm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\tserialnumber,\r\n\tproductid,\r\n\tproductname,\r\n\tSUM(quantity) AS quantity,\r\n\tMIN(signed_data) AS first_date,\r\n\tMAX(signed_data) AS last_date\r\nFROM (\r\n\tSELECT\r\n\t\tCASE\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_producttoolfield WHERE tablename='ld_outboundorderdetail' AND columnname='serialnumber' AND presence<>1) THEN b.serialnumber\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_producttoolfield WHERE tablename='ld_outboundorderdetailscf' AND columnname='sf3' AND presence<>1) THEN f.sf3\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_producttoolfield WHERE tablename='ld_outboundorderdetailscf' AND columnname='sf4' AND presence<>1) THEN f.sf4\r\n\t\tEND AS serialnumber,\r\n\t\tp.productid,\r\n\t\tp.productname,\r\n\t\tb.quantity AS quantity,\r\n\t\td.signed_data,\r\n\t\tk.accountname\r\n\tFROM ld_outboundorder a\r\n\tLEFT JOIN ld_outboundorderdetail b ON b.id=a.out_id\r\n\tLEFT JOIN ld_outboundorderdetailscf f ON f.lineitem_id=b.lineitem_id\r\n\tLEFT JOIN ld_salesorderdetail c ON b.parent_lineitem_id=c.lineitem_id\r\n\tLEFT JOIN ld_salesorder d ON d.salesorderid=c.id\r\n\tLEFT JOIN ld_products p ON p.productid=b.productid\r\n\tLEFT JOIN ld_account k ON k.accountid=a.accountid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND a.accountid>0\r\n\t\tAND a.accountid='[related_ldcrmid]'\r\n) tmp\r\nGROUP BY IFNULL(serialnumber,''),productid\r\nORDER BY IFNULL(serialnumber,''),first_date,CONVERT(productname USING GBK)"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "a",
        "Alias": "a",
        "Columns": {
          "0": {
            "Name": "accountname",
            "Index": -1,
            "NameInSource": "accountname",
            "Alias": "accountname",
            "Type": "System.String"
          }
        },
        "NameInSource": "crm",
        "Type": "Table",
        "SqlCommand": "SELECT accountname FROM ld_account WHERE accountid='[related_ldcrmid]'"
      }
    },
