          }
        },
        "NameInSource": "crm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\tb.listvalue,\r\n\tc.*\r\nFROM ld_picklist_set a\r\nLEFT JOIN ld_picklist_values b ON b.listid=a.listid\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\tjuece_level,\r\n\t\tMAX(R1_xm) AS R1_xm,\r\n\t\tMAX(R1_gw) AS R1_gw,\r\n\t\tMAX(R1_fg) AS R1_fg,\r\n\t\tMAX(R1_df+0) AS R1_df,\r\n\t\tMAX(R1_jdf+0) AS R1_jdf,\r\n\r\n\t\tMAX(R2_xm) AS R2_xm,\r\n\t\tMAX(R2_gw) AS R2_gw,\r\n\t\tMAX(R2_fg) AS R2_fg,\r\n\t\tMAX(R2_df+0) AS R2_df,\r\n\t\tMAX(R2_jdf+0) AS R2_jdf,\r\n\r\n\t\tMAX(R3_xm) AS R3_xm,\r\n\t\tMAX(R3_gw) AS R3_gw,\r\n\t\tMAX(R3_fg) AS R3_fg,\r\n\t\tMAX(R3_df+0) AS R3_df,\r\n\t\tMAX(R3_jdf+0) AS R3_jdf,\r\n\r\n\t\tMAX(R4_xm) AS R4_xm,\r\n\t\tMAX(R4_gw) AS R4_gw,\r\n\t\tMAX(R4_fg) AS R4_fg,\r\n\t\tMAX(R4_df+0) AS R4_df,\r\n\t\tMAX(R4_jdf+0) AS R4_jdf,\r\n\r\n\t\tMAX(R5_xm) AS R5_xm,\r\n\t\tMAX(R5_gw) AS R5_gw,\r\n\t\tMAX(R5_fg) AS R5_fg,\r\n\t\tMAX(R5_df+0) AS R5_df,\r\n\t\tMAX(R5_jdf+0) AS R5_jdf,\r\n\r\n\t\tMAX(R6_xm) AS R6_xm,\r\n\t\tMAX(R6_gw) AS R6_gw,\r\n\t\tMAX(R6_fg) AS R6_fg,\r\n\t\tMAX(R6_df+0) AS R6_df,\r\n\t\tMAX(R6_jdf+0) AS R6_jdf,\r\n\r\n\t\tMAX(R7_xm) AS R7_xm,\r\n\t\tMAX(R7_gw) AS R7_gw,\r\n\t\tMAX(R7_fg) AS R7_fg,\r\n\t\tMAX(R7_df+0) AS R7_df,\r\n\t\tMAX(R7_jdf+0) AS R7_jdf,\r\n\r\n\t\tMAX(R8_xm) AS R8_xm,\r\n\t\tMAX(R8_gw) AS R8_gw,\r\n\t\tMAX(R8_fg) AS R8_fg,\r\n\t\tMAX(R8_df+0) AS R8_df,\r\n\t\tMAX(R8_jdf+0) AS R8_jdf,\r\n\r\n\t\tMAX(R9_xm) AS R9_xm,\r\n\t\tMAX(R9_gw) AS R9_gw,\r\n\t\tMAX(R9_fg) AS R9_fg,\r\n\t\tMAX(R9_df+0) AS R9_df,\r\n\t\tMAX(R9_jdf+0) AS R9_jdf,\r\n\r\n\t\tMAX(R10_xm) AS R10_xm,\r\n\t\tMAX(R10_gw) AS R10_gw,\r\n\t\tMAX(R10_fg) AS R10_fg,\r\n\t\tMAX(R10_df+0) AS R10_df,\r\n\t\tMAX(R10_jdf+0) AS R10_jdf\r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\ta.contactid,\r\n\t\t\ta.department AS juece_level,\r\n\t\t\ta.lastname,\r\n\t\t\ta.firstname AS zhiwu,\r\n\t\t\ta.title AS gangwei,\r\n\t\t\tCASE\r\n\t\t\t\tWHEN IFNULL(b.cf_3425,'')='' THEN 0\r\n\t\t\t\tWHEN b.cf_3425 LIKE '%-（-1%' THEN REPLACE(RIGHT(cf_3425,CHAR_LENGTH(cf_3425)-LOCATE('分',cf_3425)+3),'分）','')\r\n\t\t\t\tELSE REPLACE(RIGHT(cf_3425,CHAR_LENGTH(cf_3425)-LOCATE('分',cf_3425)+2),'分','')\r\n\t\t\tEND AS score,\r\n\t\t\tCASE\r\n\t\t\t\tWHEN a.contactid=(SELECT contactid FROM ld_contactdetails WHERE deleted=0 AND accountid=a.accountid AND department=a.department ORDER BY contactid LIMIT 1) THEN a.lastname\r\n\t\t\t\tELSE NULL\r\n\t\t\tEND AS R1_xm,\r\n\t\t\tCASE\r\n\t\t\t\tWHEN a.contactid=(SELECT contactid FROM ld_contactdetails WHERE deleted=0 AND accountid=a.accountid AND department=a.department ORDER BY contactid LIMIT 1) THEN a.title\r\n\t\t\t\tELSE NULL\r\n\t\t\tEND AS R1_gw,\r\n\t\t\tCASE\r\n\t\t\t\tWHEN a.contactid=(SELECT contactid FROM ld_contactdetails WHERE deleted=0 AND accountid=a.accountid AND department=a.department ORDER BY contactid LIMIT 1) THEN b.cf_3426\r\n\t\t\t\tELSE NULL\r\n\t\t\tEND AS R1_fg,\r\n\t\t\tCASE\r\n\t\t\t\tWHEN a.contactid=(SELECT contactid FROM ld_contactdetails WHERE deleted=0 AND accountid=a.accountid AND department=a.department ORDER BY contactid LIMIT 1) THEN \r\n\t\t\t\t\t(CASE\r\n\t\t\t\t\t\tWHEN IFNULL(b.cf_3425,'')='' THEN 0\r\n\t\t\t\t\t\tWHEN b.cf_3425 LIKE '%-（-1%' THEN REPLACE(RIGHT(cf_3425,CHAR_LENGTH(cf_3425)-LOCATE('分',cf_3425)+3),'分）','')\r\n\t\t\t\t\t\tELSE REPLACE(RIGHT(cf_3425,CHAR_LENGTH(cf_3425)-LOCATE('分',cf_3425)+2),'分','')\r\n\t\t\t\t\tEND)\r\n\t\t\t\tELSE -1000\r\n\t\t\tEND AS R1_df,\r\n\t\t\tCASE\r\n\t\t\t\tWHEN a.contactid=(SELECT contactid FROM ld_contactdetails WHERE deleted=0 AND accountid=a.accountid AND department=a.department ORDER BY contactid LIMIT 1) THEN \r\n\t\t\t\t\t(CASE\r\n\t\t\t\t\t\tWHEN IFNULL(b.cf_5362,'')='' THEN 0\r\n\t\t\t\t\t\tWHEN b.cf_5362 LIKE '%-（-1%' THEN REPLACE(RIGHT(cf_5362,CHAR_LENGTH(cf_5362)-LOCATE('分',cf_5362)+3),'分）','')\r\n\t\t\t\t\t\tELSE REPLACE(RIGHT(cf_5362,CHAR_LENGTH(cf_5362)-LOCATE('分',cf_5362)+2),'分','')\r\n\t\t\t\t\tEND)\r\n\t\t\t\tELSE -1000\r\n\t\t\tEND AS R1_jdf,\r\n\t\t\tCASE\r\n\t\t\t\tWHEN a.contactid=(SELECT con