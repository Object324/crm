rtment ORDER BY contactid LIMIT 8,1) THEN \r\n\t\t\t\t\t(CASE\r\n\t\t\t\t\t\tWHEN IFNULL(b.cf_5362,'')='' THEN 0\r\n\t\t\t\t\t\tWHEN b.cf_5362 LIKE '%-（-1%' THEN REPLACE(RIGHT(cf_5362,CHAR_LENGTH(cf_5362)-LOCATE('分',cf_5362)+3),'分）','')\r\n\t\t\t\t\t\tELSE REPLACE(RIGHT(cf_5362,CHAR_LENGTH(cf_5362)-LOCATE('分',cf_5362)+2),'分','')\r\n\t\t\t\t\tEND)\r\n\t\t\t\tELSE -1000\r\n\t\t\tEND AS R9_jdf,\r\n\t\t\tCASE\r\n\t\t\t\tWHEN a.contactid=(SELECT contactid FROM ld_contactdetails WHERE deleted=0 AND accountid=a.accountid AND department=a.department ORDER BY contactid LIMIT 9,1) THEN a.lastname\r\n\t\t\t\tELSE NULL\r\n\t\t\tEND AS R10_xm,\r\n\t\t\tCASE\r\n\t\t\t\tWHEN a.contactid=(SELECT contactid FROM ld_contactdetails WHERE deleted=0 AND accountid=a.accountid AND department=a.department ORDER BY contactid LIMIT 9,1) THEN a.title\r\n\t\t\t\tELSE NULL\r\n\t\t\tEND AS R10_gw,\r\n\t\t\tCASE\r\n\t\t\t\tWHEN a.contactid=(SELECT contactid FROM ld_contactdetails WHERE deleted=0 AND accountid=a.accountid AND department=a.department ORDER BY contactid LIMIT 9,1) THEN b.cf_3426\r\n\t\t\t\tELSE NULL\r\n\t\t\tEND AS R10_fg,\r\n\t\t\tCASE\r\n\t\t\t\tWHEN a.contactid=(SELECT contactid FROM ld_contactdetails WHERE deleted=0 AND accountid=a.accountid AND department=a.department ORDER BY contactid LIMIT 9,1) THEN \r\n\t\t\t\t\t(CASE\r\n\t\t\t\t\t\tWHEN IFNULL(b.cf_3425,'')='' THEN 0\r\n\t\t\t\t\t\tWHEN b.cf_3425 LIKE '%-（-1%' THEN REPLACE(RIGHT(cf_3425,CHAR_LENGTH(cf_3425)-LOCATE('分',cf_3425)+3),'分）','')\r\n\t\t\t\t\t\tELSE REPLACE(RIGHT(cf_3425,CHAR_LENGTH(cf_3425)-LOCATE('分',cf_3425)+2),'分','')\r\n\t\t\t\t\tEND)\r\n\t\t\t\tELSE -1000\r\n\t\t\tEND AS R10_df,\r\n\t\t\tCASE\r\n\t\t\t\tWHEN a.contactid=(SELECT contactid FROM ld_contactdetails WHERE deleted=0 AND accountid=a.accountid AND department=a.department ORDER BY contactid LIMIT 9,1) THEN \r\n\t\t\t\t\t(CASE\r\n\t\t\t\t\t\tWHEN IFNULL(b.cf_5362,'')='' THEN 0\r\n\t\t\t\t\t\tWHEN b.cf_5362 LIKE '%-（-1%' THEN REPLACE(RIGHT(cf_5362,CHAR_LENGTH(cf_5362)-LOCATE('分',cf_5362)+3),'分）','')\r\n\t\t\t\t\t\tELSE REPLACE(RIGHT(cf_5362,CHAR_LENGTH(cf_5362)-LOCATE('分',cf_5362)+2),'分','')\r\n\t\t\t\t\tEND)\r\n\t\t\t\tELSE -1000\r\n\t\t\tEND AS R10_jdf\r\n\t\tFROM ld_contactdetails a\r\n\t\tLEFT JOIN ld_contactscf b ON b.contactid=a.contactid\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.accountid>0\r\n\t\t\tAND (\r\n\t\t\t\t\ta.accountid=(SELECT accountid FROM ld_customform52 WHERE customform52id='[related_ldcrmid]')\r\n\t\t\t\tOR a.accountid=(SELECT accountid FROM ld_potential WHERE potentialid='[related_ldcrmid]')\r\n\t\t\t)\r\n\t) a \r\n\tWHERE IFNULL(juece_level,'')<>''\r\n\tGROUP BY juece_level\r\n) c ON c.juece_level=b.listvalue\r\nWHERE a.listname='department'\r\nORDER BY b.sequence DESC "
      }
    },
