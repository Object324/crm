          "Border": "All;153,153,153;;;;;;solid:Black",
          "Brush": "solid:Transparent",
          "Components": {
            "0": {
              "Ident": "StiText",
              "Name": "Text91",
              "Guid": "e9f643d993eeba66b62855ba239fa890",
              "ClientRectangle": "0,0,56,1.2",
              "Interaction": {
                "Ident": "StiInteraction"
