        "NameInSource": "Connection1",
        "Type": "Table",
        "SqlCommand": "SELECT \r\n\ti.id,\r\n\tconcat(i.id,'_',p.productid,'_',i.sequence_no) as tags,\r\n\tob.out_no, \r\n\tob.out_id,\r\n\tob.presence,\r\n\ti.sequence_no, \r\n\tCASE\r\n\t\tWHEN t1.balanceoutproductcount>0 THEN '未清'\r\n\t\tELSE '已清'\r\n\tEND as hangzhuangtai,\r\n\tob.outdate, \r\n\tw.`name`,\r\n\tob.accountid,\r\n\ta.account_no, \r\n\ta.accountname, \r\n\tp.product_no, \r\n\tp.productname,\r\n\tp.productsheet,\r\n\tp.usageunit,  \r\n\tt2.order_no,\r\n\tt3.last_name, \r\n\ti.entitytype, \r\n\ti.entitytypeid, \r\n\tt1.haveoutproductcount,\r\n\tt1.balanceoutproductcount,\r\n\tround((ifnull(i.listprice,0) / ob.conversion_rate),2) as listprice,\r\n\tround((ifnull(i.taxprice,0) / ob.conversion_rate),2) as taxprice,\r\n\tround((ifnull(i.list_amount,0) / ob.conversion_rate),2) as list_amount,\r\n\tround((ifnull(i.tax_total,0) / ob.conversion_rate),2) as tax_total,\r\n\tround((ifnull(i.taxprice,0) / ob.conversion_rate),2)*t1.balancepurchasecount as weiqinghanshuijine,\r\n\ti.`comment`\r\nFROM ld_outboundorder ob\r\nLEFT JOIN ld_outboundorderdetail i on i.id=ob.out_id \r\nLEFT JOIN ld_warehouse w on w.id=i.wareid \r\nLEFT JOIN ld_account a on a.accountid = ob.accountid \r\nLEFT JOIN ld_products p on p.productid = i.productid \r\nLEFT JOIN ld_salesorderdetail t1 on t1.id=i.entitytypeid and t1.productid=i.productid \r\nLEFT JOIN ( \r\n\tSELECT salesorderid as id,salesorder_no as order_no,smownerid FROM ld_salesorder\r\n\tUNION ALL \r\n\tSELECT servicecontractsid,contract_no,smownerid FROM ld_servicecontracts\r\n\tUNION ALL \r\n\tSELECT invoiceid,invoice_no,smownerid FROM ld_invoice\r\n\tUNION ALL \r\n\tSELECT stock_id,ware_stock_no,smownerid FROM ld_stock\r\n) t2 ON t2.id=i.entitytypeid \r\nLEFT JOIN ld_users t3 ON t3.id=t2.smownerid\r\nWHERE ob.deleted=0\r\n\tAND ob.approvestatus<>'已拒绝'\r\n\tAND ob.outdate BETWEEN DATE_FORMAT('{outback_start_date}','%Y-%m-%d') AND DATE_FORMAT('{outback_end_date}','%Y-%m-%d') \r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{approve}'='true' THEN a.approvestatus='已批准'\r\n\t\t\tELSE 1=1\r\n\t\tEND)\r\n\tAND(\r\n\t\tCASE \r\n\t\t\tWHEN '{OutNo}' ='' THEN 1=1\r\n\t\t\tELSE LOCATE(TRIM('{OutNo}'),ob.out_no)>0\r\n\tEND)\r\n\tAND(\r\n\t\tCASE \r\n\t\t\tWHEN '{wareHouse}' ='' OR '{wareHouse}'='全部' THEN 1=1\r\n\t\t\tELSE LOCATE(TRIM('{wareHouse}'),w.`name`)>0\r\n\tEND)\r\n\tAND(\r\n\t\tCASE \r\n\t\t\tWHEN '{productsNo}' ='' THEN 1=1\r\n\t\t\tELSE LOCATE(TRIM('{productsNo}'),p.product_no)>0\r\n\tEND)\r\n\tAND(\r\n\t\tCASE \r\n\t\t\tWHEN '{produstName}' ='' THEN 1=1\r\n\t\t\tELSE LOCATE(TRIM('{produstName}'),p.productname)>0\r\n\tEND)\r\n\tAND(\r\n\t\tCASE \r\n\t\t\tWHEN '{productSheet}' ='' THEN 1=1\r\n\t\t\tELSE LOCATE(TRIM('{productSheet}'),p.productsheet)>0\r\n\tEND)\r\n\tAND(\r\n\t\tCASE \r\n\t\t\tWHEN '{AcountName}' ='' THEN 1=1\r\n\t\t\tELSE LOCATE(TRIM('{AcountName}'),a.accountname)>0\r\n\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{userid}'='' THEN \r\n\t\t\t\tFIND_IN_SET(CASE WHEN a.smownerid is NULL THEN 1 ELSE a.smownerid END,(\r\n\t\t\t\t\t\tSELECT\r\n\t\t\t\t\t\t\tGROUP_CONCAT(a.id)\r\n\t\t\t\t\t\tFROM ld_users a\r\n\t\t\t\t\t\tINNER JOIN (\r\n\t\t\t\t\t\t\tSELECT DISTINCT\r\n\t\t\t\t\t\t\t\tuserid \r\n\t\t\t\t\t\t\tFROM (\r\n\t\t\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\t\t\tld_users.id AS userid \r\n\t\t\t\t\t\t\t\tFROM ld_users\r\n\t\t\t\t\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='OutboundOrder' AND scopeauthority=1 AND userid='[uuid]')\r\n\t\t\t\t\t\t\t\tUNION\r\n\t\t\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\t\t\tviewid\r\n\t\t\t\t\t\t\t\tFROM ld_scoperhigher\r\n\t\t\t\t\t\t\t\tWHERE userid='[uuid]' AND modulename='OutboundOrder' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename='OutboundOrder')\t\t\t\r\n\t\t\t\t\t\t\t\tUNION\r\n\t\t\t\t\t\t\t\tSELECT DISTINCT \r\n\t\t\t\t\t\t\t\t\tld_users2group.userid AS userid \r\n\t\t\t\t\t\t\t\tFROM ld_scoperhigher \r\n\t\t\t\t\t\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\t\t\t\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\t\t\t\t\t\tWHERE ld_scoperhigher.userid='[uuid]'\r\n\t\t\t\t\t\t\t\t\tAND ld_scoperhigher.modulename='OutboundOrder'\r\n\t\t\t\t\t\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\t\t\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='OutboundOrder' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\t\t\t\t\t\tUNION \r\n\t\t\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\t\t\tid\r\n\t\t\t\t\t\t\t\tFROM ld_users  \r\n\t\t\t\t\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\t\t\t\t\t\tUNION\r\n\t\t\t\t\t\t\t\tSELECT '[uuid]') AS vw_users\r\n\t\t\t\t\t\t\t) AS tmp_users ON tmp_users.userid=a.id\r\n\t\t\t\t\t\tWHERE a.id IN (\r\n\t\t\t\t\t\t\tSELECT DISTINCT\r\n\t\t\t\t\t\t\t\tb.smownerid\r\n\t\t\t\t\t\t\tFROM (\r\n\t\t\t\t\t\t\t\tSELECT DISTINCT\r\n\t\t\t\t\t\t\t\t\tb.entitytypeid\r\n\t\t\t\t\t\t\t\tFROM ld_outboundorder a\r\n\t\t\t\t\t\t\t\tLEFT JOIN ld_outboundorderdetail b ON a.out_id=b.id\r\n\t\t\t\t\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\t\t\t\t\tAND b.entitytypeid>0\r\n\t\t\t\t\t\t\t\t\tAND a.outdate BETWEEN DATE_FORMAT('{outback_start_date}','%Y-%m-%d') AND DATE_FORMAT('{outback_end_date}','%Y-%m-%d')\r\n\t\t\t\t\t\t\t) a\r\n\t\t\t\t\t\t\tINNER JOIN (\r\n\t\t\t\t\t\t\t\tSELECT salesorderid as id,smownerid FROM ld_salesorder\r\n\t\t\t\t\t\t\t\tUNION ALL \r\n\t\t\t\t\t\t\t\tSELECT servicecontractsid,smownerid FROM ld_servicecontracts\r\n\t\t\t\t\t\t\t\tUNION ALL \r\n\t\t\t\t\t\t\t\tSELECT invoiceid,smownerid FROM ld_invoice\r\n\t\t\t\t\t\t\t\tUNION ALL \r\n\t\t\t\t\t\t\t\tSELECT stock_id,smownerid FROM ld_stock\r\n\t\t\t\t\t\t\t) b ON b.id=a.entitytypeid \r\n\t\t\t\t\t\t)\r\n\t\t\t\t\t)\r\n\t\t\t\t)\r\n\t\t\tELSE FIND_IN_SET(CASE WHEN a.smownerid is NULL THEN 1 ELSE a.smownerid END,'{userid}')\r\n\t\tEND)"
      }
    },
