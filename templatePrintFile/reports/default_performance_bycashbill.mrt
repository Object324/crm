          },
          "15": {
            "Name": "source_rmbtotal",
            "Index": -1,
            "NameInSource": "source_rmbtotal",
            "Alias": "source_rmbtotal",
            "Type": "System.Object"
          },
          "16": {
            "Name": "ticheng",
            "Index": -1,
            "NameInSource": "ticheng",
            "Alias": "ticheng",
            "Type": "System.Int32"
          },
          "17": {
            "Name": "total_cost",
            "Index": -1,
            "NameInSource": "total_cost",
            "Alias": "total_cost",
            "Type": "System.Object"
          },
          "18": {
            "Name": "total_display",
            "Index": -1,
            "NameInSource": "total_display",
            "Alias": "total_display",
            "Type": "System.String"
          },
          "19": {
            "Name": "total_fy",
            "Index": -1,
            "NameInSource": "total_fy",
            "Alias": "total_fy",
            "Type": "System.Object"
          },
          "20": {
            "Name": "total_rmb",
            "Index": -1,
            "NameInSource": "total_rmb",
            "Alias": "total_rmb",
            "Type": "System.Object"
          },
          "21": {
            "Name": "total_yj",
            "Index": -1,
            "NameInSource": "total_yj",
            "Alias": "total_yj",
            "Type": "System.Object"
          },
          "22": {
            "Name": "yeji",
            "Index": -1,
            "NameInSource": "yeji",
            "Alias": "yeji",
            "Type": "System.Object"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\tlast_name,\r\n\tsmownerid,\r\n\torder2,\r\n\tCASE\r\n\t\tWHEN cashbillid>0 THEN cashbillid\r\n\t\tELSE '00'\r\n\tEND AS cashbillid,\r\n\tcashbill_no,\r\n\tcashbilldate,\r\n\tCASE\r\n\t\tWHEN accountid>0 THEN accountid\r\n\t\tELSE '00'\r\n\tEND AS accountid,\r\n\taccountname,\r\n\tCASE\r\n\t\tWHEN entitytypeid>0 THEN entitytypeid\r\n\t\tELSE '00'\r\n\tEND AS entitytypeid,\r\n\tsource_no,\r\n\ttotal_display,\r\n\tROUND(total_rmb,2) AS total_rmb,\r\n\tIFNULL(source_displaytotal,'￥0.00') AS source_displaytotal,\r\n\tIFNULL(source_rmbtotal,0) source_rmbtotal,\r\n\tIFNULL(source_rmbsubtotal,0) source_rmbsubtotal,\r\n\tIFNULL(source_displayreceived,'￥0.00') AS source_displayreceived,\r\n\tIFNULL(source_rmbreceived,0) AS source_rmbreceived,\r\n\tIFNULL(source_rmbsubreceived,0) AS source_rmbsubreceived,\r\n\ttotal_cost,\r\n\ttotal_fy,\r\n\ttotal_yj,\r\n\tCASE\r\n\t\tWHEN '{jititype}'='1' THEN ROUND(IFNULL(total_rmb,0),2)\r\n\t\tWHEN '{jititype}'='2' THEN ROUND(IFNULL(total_rmb,0),2)-ROUND(IFNULL(total_fy,0),2)-ROUND(IFNULL(total_yj,0),2)\r\n\t\tWHEN '{jititype}'='3' THEN ROUND(IFNULL(total_rmb,0),2)-ROUND(IFNULL(total_fy,0),2)-ROUND(IFNULL(total_yj,0),2)-ROUND(IFNULL(total_cost,0),2)\r\n\tEND AS yeji,\r\n\tCASE\r\n\t\tWHEN '{jititype}'='1' THEN ROUND(ROUND(IFNULL(total_rmb,0),2)*'{rate}'/100,2)\r\n\t\tWHEN '{jititype}'='2' THEN ROUND((ROUND(IFNULL(total_rmb,0),2)-ROUND(IFNULL(total_fy,0),2)-ROUND(IFNULL(total_yj,0),2))*'{rate}'/100,2)\r\n\t\tWHEN '{jititype}'='3' THEN ROUND((ROUND(IFNULL(total_rmb,0),2)-ROUND(IFNULL(total_fy,0),2)-ROUND(IFNULL(total_yj,0),2)-ROUND(IFNULL(total_cost,0),2))*'{rate}'/100,2)\r\n\tEND AS ticheng\r\nFROM (\r\n\tSELECT\r\n\t\tlast_name,\r\n\t\tsmownerid,\r\n\t\t1 AS order2,\r\n\t\tcashbillid,\r\n\t\tcashbill_no,\r\n\t\tcashbilldate,\r\n\t\taccountid,\r\n\t\taccountname,\r\n\t\tentitytypeid,\r\n\t\ttotal_display,\r\n\t\ttotal_rmb,\r\n\t\tsource_no,\r\n\t\tsource_displaytotal,\r\n\t\tCASE\r\n\t\t\tWHEN cashbillid=periodfirst_cashbillid THEN source_rmbtotal\r\n\t\t\tELSE 0\r\n\t\tEND AS source_rmbtotal,\r\n\t\tCASE\r\n\t\t\tWHEN cashbillid=min_cashbillid THEN source_rmbtotal\r\n\t\t\tELSE 0\r\n\t\tEND AS source_rmbsubtotal,\r\n\t\tsource_displayreceived,\r\n\t\tCASE\r\n\t\t\tWHEN cashbillid=periodfirst_cashbillid THEN source_rmbreceived\r\n\t\t\tELSE 0\r\n\t\tEND AS source_rmbreceived,\r\n\t\tCASE\r\n\t\t\tWHEN cashbillid=min_cashbillid THEN source_rmbreceived\r\n\t\t\tELSE 0\r\n\t\tEND AS source_rmbsubreceived,\r\n\t\tCASE\r\n\t\t\tWHEN cashbillid=first_cashbillid THEN total_cost\r\n\t\t\tELSE 0\r\n\t\tEND AS total_cost,\r\n\t\tCASE\r\n\t\t\tWHEN cashbillid=periodfirst_cashbillid THEN IFNULL(total_fy,0)\r\n\t\t\tELSE 0\r\n\t\tEND AS total_fy,\r\n\t\tCASE\r\n\t\t\tWHEN cashbillid=periodfirst_cashbillid THEN IFNULL(total_yj,0)\r\n\t\t\tELSE 0\r\n\t\tEND AS total_yj\r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\tb.last_name,\r\n\t\t\ta.smownerid,\r\n\t\t\ta.cashbillid,\r\n\t\t\ti.cashbillid AS first_cashbillid,\r\n\t\t\tj.cashbillid AS periodfirst_cashbillid,\r\n\t\t\t(SELECT\r\n\t\t\t\tmin(cashbillid) \r\n\t\t\tFROM (\r\n\t\t\t\tSELECT\r\n\t\t\t\t\ta.smownerid,\r\n\t\t\t\t\ta.cashbillid,\r\n\t\t\t\t\tb.entitytypeid\r\n\t\t\t\tFROM ld_cashbill a\r\n\t\t\t\tLEFT JOIN ld_cashbill2paymentplan b ON a.cashbillid=b.CashBillID\r\n\t\t\t\tLEFT JOIN ld_account c ON c.accountid=a.accountid\r\n\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\tAND IFNULL(a.approvestatus,'')<>'已拒绝'\r\n\t\t\t\t\tAND b.entitytypeid>0\r\n\t\t\t\t\tAND a.cashbilldate BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE \r\n\t\t\t\t\t\t\tWHEN EXISTS (SELECT 1 from ld_systems_deploy where deploy_type=83 and deploy_value=0) THEN 1=1\r\n\t\t\t\t\t\t\tELSE a.checkoutstatus='已审核'\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{accountname}'='' THEN\t1=1\r\n\t\t\t\t\t\t\tELSE accountname like '%{accountname}%'\t\t\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tORDER BY a.cashbilldate,a.cashbillid\r\n\t\t\t\t) t1 WHERE t1.smownerid=a.smownerid and t1.entitytypeid=a.entitytypeid) AS min_cashbillid,\r\n\t\t\ta.cashbill_no,\r\n\t\t\ta.cashbilldate,\r\n\t\t\ta.currency_symbol,\r\n\t\t\ta.accountid,\r\n\t\t\tc.accountname,\r\n\t\t\ta.entitytype,\r\n\t\t\ta.entitytypeid,\r\n\t\t\tCONCAT(a.currency_symbol,FORMAT(IFNULL(a.amount,0),2)) AS total_display,\r\n\t\t\tROUND(a.amount,2)/IFNULL(a.conversion_rate,1) AS total_rmb,\r\n\t\t\td.order_no AS source_no,\r\n\t\t\tCONCAT(d.currency_symbol,FORMAT(IFNULL(d.total,0),2)) AS source_displaytotal,\r\n\t\t\tROUND(IFNULL(d.total,0)/IFNULL(d.conversion_rate,1),2) AS source_rmbtotal,\r\n\t\t\tCONCAT(d.currency_symbol,FORMAT(IFNULL(d.received_amount,0),2)) AS source_displayreceived,\r\n\t\t\tROUND(IFNULL(d.received_amount,0)/IFNULL(d.conversion_rate,1),2) AS source_rmbreceived,\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{costtype}'='1' THEN productcost\r\n\t\t\t\tWHEN '{costtype}'='2' THEN ROUND(g.total,2)\r\n\t\t\t\tWHEN '{costtype}'='3' THEN ROUND(m.total,2)\r\n\t\t\t\tWHEN '{costtype}'='4' THEN ROUND(n.total,2)\r\n\t\t\tEND AS total_cost,\r\n\t\t\te.rmb_total AS total_fy,\r\n\t\t\tf.total_yj,\r\n\t\t\ta.deleted,\r\n\t\t\ta.checkoutstatus\r\n\t\tFROM (\r\n\t\t\tSELECT\r\n\t\t\t\tsmownerid,\r\n\t\t\t\tcashbillid,\r\n\t\t\t\tcashbill_no,\r\n\t\t\t\tcashbilldate,\r\n\t\t\t\tcurrency_symbol,\r\n\t\t\t\tconversion_rate,\r\n\t\t\t\taccountid,\r\n\t\t\t\tentitytype,\r\n\t\t\t\tentitytypeid,\r\n\t\t\t\tSUM(amount) AS amount,\r\n\t\t\t\tdeleted,\r\n\t\t\t\tcheckoutstatus\r\n\t\t\tFROM (\r\n\t\t\t\tSELECT\r\n\t\t\t\t\ta.smownerid,\r\n\t\t\t\t\ta.cashbillid,\r\n\t\t\t\t\ta.cashbill_no,\r\n\t\t\t\t\ta.cashbilldate,\r\n\t\t\t\t\ta.accountid,\r\n\t\t\t\t\ta.currency_symbol,\r\n\t\t\t\t\ta.conversion_rate,\r\n\t\t\t\t\tCASE \r\n\t\t\t\t\t\tWHEN b.entitytype='PaymentPlan' THEN\r\n\t\t\t\t\t\t\t(SELECT entitytype FROM ld_paymentplan WHERE paymentplanid=b.entitytypeid)\r\n\t\t\t\t\t\tELSE b.entitytype\r\n\t\t\t\t\tEND AS entitytype,\r\n\t\t\t\t\tCASE \r\n\t\t\t\t\t\tWHEN b.entitytype='PaymentPlan' THEN\r\n\t\t\t\t\t\t\t(SELECT entitytypeid FROM ld_paymentplan WHERE paymentplanid=b.entitytypeid)\r\n\t\t\t\t\t\tELSE b.entitytypeid\r\n\t\t\t\t\tEND AS entitytypeid,\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN b.CashBillID>0 THEN  b.amount\r\n\t\t\t\t\t\tELSE a.Total\r\n\t\t\t\t\tEND AS amount,\r\n\t\t\t\t\ta.deleted,\r\n\t\t\t\t\ta.checkoutstatus\r\n\t\t\t\tFROM ld_cashbill a\r\n\t\t\t\tLEFT JOIN ld_cashbill2paymentplan b ON a.cashbillid = b.CashBillID\r\n\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\tAND IFNULL(a.approvestatus,'')<>'已拒绝'\r\n\t\t\t\t\tAND a.cashbilldate BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE \r\n\t\t\t\t\t\t\tWHEN EXISTS (SELECT 1 from ld_systems_deploy where deploy_type=83 and deploy_value=0) THEN 1=1\r\n\t\t\t\t\t\t\tELSE a.checkoutstatus='已审核'\r\n\t\t\t\t\t\tEND)\t\r\n\t\t\t) a\r\n\t\t\tGROUP BY cashbillid,entitytypeid\r\n\t\t) a\r\n\t\tLEFT JOIN ld_users b ON a.smownerid=b.id\r\n\t\tLEFT JOIN ld_account c ON a.accountid=c.accountid\r\n\t\tLEFT JOIN (\r\n\t\t\tSELECT salesorderid AS order_id,currency_id,conversion_rate,currency_symbol,total,received_amount,`subject`,salesorder_no AS order_no FROM ld_salesorder\r\n\t\t\tUNION ALL \r\n\t\t\tSELECT servicecontractsid,currency_id,conversion_rate,currency_symbol,total,received_amount,`subject`,contract_no FROM ld_servicecontracts\r\n\t\t\tUNION ALL \r\n\t\t\tSELECT invoiceid,currency_id,conversion_rate,currency_symbol,total,received_amount,`subject`,invoice_no FROM ld_invoice\r\n\t\t\tUNION ALL \r\n\t\t\tSELECT out_id,currency_id,conversion_rate,currency_symbol,total,received_amount,'',out_no FROM ld_outboundorder\r\n\t\t) d ON d.order_id=a.entitytypeid\r\n\t\tLEFT JOIN (\r\n\t\t\tSELECT\r\n\t\t\t\tb.entitytypeid,\r\n\t\t\t\tSUM(c.rmb_total) AS rmb_total\r\n\t\t\tFROM ld_expense a\r\n\t\t\tLEFT JOIN ld_expensedetail b ON a.expenseid=b.expenseid\r\n\t\t\tLEFT JOIN ld_expensedetailscf c ON c.expensedetailid=b.expensedetailid\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.expensedate BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\t\t\t\tAND b.entitytype in ('SalesOrder','ServiceContracts')\r\n\t\t\t\tAND IFNULL(a.approvestatus,'')<>'已拒绝'\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{fee_range}'='false' THEN 1=1\r\n\t\t\t\t\t\tELSE a.approvestatus='已批准'\r\n\t\t\t\t\tEND)\r\n\t\t\tGROUP BY b.entitytypeid\r\n\t\t) e ON e.entitytypeid=a.entitytypeid\r\n\t\t\tLEFT JOIN (\r\n\t\t\t\tSELECT\r\n\t\t\t\t\tb.entitytypeid,\r\n\t\t\t\t\tSUM(ROUND(b.amount/IFNULL(a.conversion_rate,1),2)) AS total_yj\r\n\t\t\t\tFROM ld_commission a\r\n\t\t\t\tLEFT JOIN ld_commission2payment b ON a.commission_id=b.commission_id\r\n\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\tAND a.expensedate BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\t\t\t\t\tAND b.entitytype in ('SalesOrder','ServiceContracts')\r\n\t\t\t\t\tAND IFNULL(a.approvestatus,'')<>'已拒绝'\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{fee_range}'='false' THEN 1=1\r\n\t\t\t\t\t\t\tELSE a.approvestatus='已批准'\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\tGROUP BY b.entitytypeid\r\n\t\t\t) f ON f.entitytypeid=a.entitytypeid\r\n\t\tLEFT JOIN (\r\n\t\t\tSELECT\r\n\t\t\t\tSUM(ROUND(b.tax_amount/IFNULL(a.conversion_rate,1),2)) AS total,\r\n\t\t\t\tb.entitytypeid\r\n\t\t\tFROM ld_purchaseorder a\r\n\t\t\tLEFT JOIN ld_purchaseorderdetail b ON a.purchaseorderid=b.id\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND IFNULL(a.approvestatus,'')<>'已拒绝'\r\n\t\t\t\tAND IFNULL(a.postatus,'')<>'已作废'\r\n\t\t\t\tAND b.entitytypeid>0\r\n\t\t\tGROUP BY b.entitytypeid\r\n\t\t) g ON g.entitytypeid=a.entitytypeid\r\n\t\tLEFT JOIN (\r\n\t\t\tSELECT\r\n\t\t\t\tid,\t\r\n\t\t\t\tSUM(productcost) AS productcost\r\n\t\t\tFROM (\r\n\t\t\t\tSELECT\r\n\t\t\t\t\tid,\r\n\t\t\t\t\tCASE \r\n\t\t\t\t\t\tWHEN IFNULL(a.productcost,0)>0 THEN ROUND(a.quantity*a.productcost,2)/IFNULL(c.conversion_rate,1)\r\n\t\t\t\t\t\tELSE ROUND(a.quantity*IFNULL(b.costprice,0),2)\r\n\t\t\t\t\tEND AS productcost\r\n\t\t\t\tFROM (\r\n\t\t\t\t\tSELECT\r\n\t\t\t\t\t\tid,\r\n\t\t\t\t\t\tproductid,\r\n\t\t\t\t\t\tquantity,\r\n\t\t\t\t\t\tproductcost\r\n\t\t\t\t\tFROM ld_salesorderdetail\r\n\t\t\t\t\tUNION ALL\r\n\t\t\t\t\tSELECT\r\n\t\t\t\t\t\tid,\r\n\t\t\t\t\t\tproductid,\r\n\t\t\t\t\t\tquantity,\r\n\t\t\t\t\t\tproductcost\r\n\t\t\t\t\tFROM ld_servicecontractsdetail\r\n\t\t\t\t\t) a\r\n\t\t\t\tLEFT JOIN ld_products b ON a.productid=b.productid\r\n\t\t\t\tLEFT JOIN (\r\n\t\t\t\t\tSELECT salesorderid AS orderid,conversion_rate FROM ld_salesorder\r\n\t\t\t\t\tUNION ALL\r\n\t\t\t\t\tSELECT servicecontractsid,conversion_rate FROM ld_servicecontracts\r\n\t\t\t\t\tUNION ALL \r\n\t\t\t\t\tSELECT invoiceid,conversion_rate FROM ld_invoice\r\n\t\t\t\t\tUNION ALL \r\n\t\t\t\t\tSELECT out_id,conversion_rate FROM ld_outboundorder\r\n\t\t\t\t\t) c ON a.id=c.orderid\r\n\t\t\t) a\r\n\t\t\tGROUP BY id\r\n\t\t) h ON h.id=a.entitytypeid\r\n\t\tLEFT JOIN (\r\n\t\t\tSELECT\r\n\t\t\t\ta.orderid,\r\n\t\t\t\tsum(ROUND(b.quantity*IFNULL(c.costprice,0),2)) as total\r\n\t\t\tFROM (\r\n\t\t\t\tSELECT salesorderid AS orderid,conversion_rate FROM ld_salesorder\r\n\t\t\t\tUNION ALL\r\n\t\t\t\tSELECT servicecontractsid,conversion_rate FROM ld_servicecontracts\r\n\t\t\t) a\r\n\t\t\tLEFT JOIN (\r\n\t\t\t\tSELECT id,productid,quantity,productcost FROM ld_salesorderdetail\r\n\t\t\t\tUNION ALL\r\n\t\t\t\tSELECT id,productid,quantity,productcost FROM ld_servicecontractsdetail\r\n\t\t\t) b ON a.orderid=b.id\r\n\t\t\tLEFT JOIN (\r\n\t\t\t\tSELECT\r\n\t\t\t\t\tb.productid,\r\n\t\t\t\t\tsum(b.tax_amount/IFNULL(a.conversion_rate,1))/sum(b.quantity) as costprice\r\n\t\t\t\tFROM ld_purchaseorder a\r\n\t\t\t\tLEFT JOIN ld_purchaseorderdetail b ON a.purchaseorderid=b.id\r\n\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\tAND IFNULL(a.approvestatus,'')<>'已拒绝'\r\n\t\t\t\t\tAND IFNULL(a.postatus,'')<>'已作废'\r\n\t\t\t\tGROUP BY b.productid\r\n\t\t\t) c ON c.productid=b.productid\r\n\t\t\tGROUP BY a.orderid\r\n\t\t) m ON m.orderid=a.entitytypeid\r\n\t\tLEFT JOIN (\r\n\t\t\tSELECT\r\n\t\t\t\tSUM(ROUND(b.tax_amount/IFNULL(a.conversion_rate,1),2)) AS total,\r\n\t\t\t\tb.entitytypeid\r\n\t\t\tFROM ld_outboundorder a\r\n\t\t\tLEFT JOIN ld_outboundorderdetail b ON a.out_id=b.id\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND IFNULL(a.approvestatus,'')<>'已拒绝'\r\n\t\t\t\tAND b.entitytypeid>0\r\n\t\t\tGROUP BY b.entitytypeid\r\n\t\t) n ON n.entitytypeid=a.entitytypeid\t\r\n\t\tLEFT JOIN (\r\n\t\t\tSELECT\r\n\t\t\t\tentitytypeid,\r\n\t\t\t\tcashbillid\r\n\t\t\tFROM (\r\n\t\t\t\tSELECT\r\n\t\t\t\t\ta.cashbillid,\r\n\t\t\t\t\ta.cashbilldate,\r\n\t\t\t\t\tb.entitytypeid\r\n\t\t\t\tFROM ld_cashbill a\r\n\t\t\t\tLEFT JOIN ld_cashbill2paymentplan b ON a.cashbillid=b.CashBillID\r\n\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\tAND IFNULL(a.approvestatus,'')<>'已拒绝'\r\n\t\t\t\t\tAND b.entitytypeid>0\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE \r\n\t\t\t\t\t\t\tWHEN EXISTS (SELECT 1 from ld_systems_deploy where deploy_type=83 and deploy_value=0) THEN 1=1\r\n\t\t\t\t\t\t\tELSE a.checkoutstatus='已审核'\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tORDER BY a.cashbilldate,a.cashbillid\r\n\t\t\t) a GROUP BY entitytypeid\r\n\t\t) i ON i.entitytypeid=a.entitytypeid\r\n\t\tLEFT JOIN (\r\n\t\t\tSELECT\r\n\t\t\t\tentitytypeid,\r\n\t\t\t\tcashbillid\r\n\t\t\tFROM (\r\n\t\t\t\tSELECT\r\n\t\t\t\t\ta.cashbillid,\r\n\t\t\t\t\ta.cashbilldate,\r\n\t\t\t\t\tb.entitytypeid\r\n\t\t\t\tFROM ld_cashbill a\r\n\t\t\t\tLEFT JOIN ld_cashbill2paymentplan b ON a.cashbillid=b.CashBillID\r\n\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\tAND IFNULL(a.approvestatus,'')<>'已拒绝'\r\n\t\t\t\t\tAND b.entitytypeid>0\r\n\t\t\t\t\tAND a.cashbilldate BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE \r\n\t\t\t\t\t\t\tWHEN EXISTS (SELECT 1 from ld_systems_deploy where deploy_type=83 and deploy_value=0) THEN 1=1\r\n\t\t\t\t\t\t\tELSE a.checkoutstatus='已审核'\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tORDER BY a.cashbilldate,a.cashbillid\r\n\t\t\t) a GROUP BY entitytypeid\r\n\t\t) j ON j.entitytypeid=a.entitytypeid\r\n\t\tWHERE 1=1\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{accountname}'='' THEN\t1=1\r\n\t\t\t\t\tELSE accountname like '%{accountname}%'\t\t\r\n\t\t\t\tEND)\r\n\t) temp\r\n\tUNION ALL\r\n\tSELECT\r\n\t\ta.last_name,\r\n\t\tt.smownerid,\r\n\t\t2 AS order2,\r\n\t\tt.order_id,\r\n\t\tt.order_no,\r\n\t\tt.expensedate,\r\n\t\tt.accountid,\r\n\t\tb.accountname,\r\n\t\t'' AS entitytypeid,\r\n\t\t'￥0.00' total_display,\r\n\t\t0 total_rmb,\r\n\t\t'' AS source_no,\r\n\t\t'' AS source_displaytotal,\r\n\t\t0 AS source_rmbtotal,\r\n\t\t0 AS source_rmbsubtotal,\r\n\t\t'' AS source_displayreceived,\r\n\t\t0 AS source_rmbreceived,\r\n\t\t0 AS source_rmbsubreceived,\r\n\t\t0 AS total_cost,\r\n\t\tt.total_fy,\r\n\t\tt.total_yj\r\n\tFROM (\r\n\t\t(SELECT\r\n\t\t\ta.smownerid,\r\n\t\t\ta.expenseid AS order_id,\r\n\t\t\ta.accountid,\r\n\t\t\ta.expense_no AS order_no,\r\n\t\t\ta.expensedate,\r\n\t\t\tSUM(ROUND(c.rmb_total/IFNULL(a.conversion_rate,1),2)) AS total_fy,\r\n\t\t\t0 AS total_yj\r\n\t\tFROM ld_expense a\r\n\t\tLEFT JOIN ld_expensedetail b ON a.expenseid=b.expenseid\r\n\t\tLEFT JOIN ld_expensedetailscf c ON c.expensedetailid=b.expensedetailid\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.accountid>0\r\n\t\t\tAND b.entitytypeid NOT IN (\r\n\t\t\t\tSELECT DISTINCT\r\n\t\t\t\t\tCASE \r\n\t\t\t\t\t\tWHEN b.entitytype='PaymentPlan' THEN\r\n\t\t\t\t\t\t\t(SELECT entitytypeid FROM ld_paymentplan WHERE paymentplanid=b.entitytypeid)\r\n\t\t\t\t\t\tELSE b.entitytypeid\r\n\t\t\t\t\tEND AS entitytypeid\r\n\t\t\t\tFROM ld_cashbill a\r\n\t\t\t\tLEFT JOIN ld_cashbill2paymentplan b ON a.cashbillid = b.CashBillID\r\n\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\tAND IFNULL(a.approvestatus,'')<>'已拒绝'\r\n\t\t\t\t\tAND a.cashbilldate BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE \r\n\t\t\t\t\t\t\tWHEN EXISTS (SELECT 1 from ld_systems_deploy where deploy_type=83 and deploy_value=0) THEN 1=1\r\n\t\t\t\t\t\t\tELSE a.checkoutstatus='已审核'\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t)\t\t\r\n\t\t\tAND a.expensedate BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{fee_range}'='false' THEN 1=1\r\n\t\t\t\t\tELSE a.approvestatus='已批准'\r\n\t\t\t\tEND)\r\n\t\tGROUP BY a.expenseid)\r\n\t\tUNION ALL\r\n\t\t(SELECT\r\n\t\t\ta.smownerid,\r\n\t\t\ta.commission_id,\r\n\t\t\ta.accountid,\r\n\t\t\ta.commission_no,\r\n\t\t\ta.expensedate,\r\n\t\t\t0 AS total_fy,\r\n\t\t\tSUM(ROUND(b.amount/IFNULL(conversion_rate,1),2)) AS total_yj\r\n\t\tFROM ld_commission a\r\n\t\tLEFT JOIN ld_commission2payment b ON a.commission_id=b.commission_id\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.accountid>0\r\n\t\t\tAND b.entitytypeid NOT IN (\r\n\t\t\t\tSELECT DISTINCT\r\n\t\t\t\t\tCASE \r\n\t\t\t\t\t\tWHEN b.entitytype='PaymentPlan' THEN\r\n\t\t\t\t\t\t\t(SELECT entitytypeid FROM ld_paymentplan WHERE paymentplanid=b.entitytypeid)\r\n\t\t\t\t\t\tELSE b.entitytypeid\r\n\t\t\t\t\tEND AS entitytypeid\r\n\t\t\t\tFROM ld_cashbill a\r\n\t\t\t\tLEFT JOIN ld_cashbill2paymentplan b ON a.cashbillid = b.CashBillID\r\n\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\tAND IFNULL(a.approvestatus,'')<>'已拒绝'\r\n\t\t\t\t\tAND a.cashbilldate BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE \r\n\t\t\t\t\t\t\tWHEN EXISTS (SELECT 1 from ld_systems_deploy where deploy_type=83 and deploy_value=0) THEN 1=1\r\n\t\t\t\t\t\t\tELSE a.checkoutstatus='已审核'\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t)\r\n\t\t\tAND a.expensedate BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{fee_range}'='false' THEN 1=1\r\n\t\t\t\t\tELSE a.approvestatus='已批准'\r\n\t\t\t\tEND)\r\n\t\tGROUP BY a.commission_id)\r\n\t) t\r\n\tLEFT JOIN ld_users a ON a.id=t.smownerid\r\n\tLEFT JOIN ld_account b ON b.accountid=t.accountid\r\n) report\r\nWHERE (\r\n\tCASE\r\n\t\tWHEN '{data_range}'='' THEN\r\n\t\t\tFIND_IN_SET(smownerid,(\r\n\t\t\t\tSELECT\r\n\t\t\t\t\tGROUP_CONCAT(a.id)\r\n\t\t\t\tFROM ld_users a\r\n\t\t\t\tINNER JOIN (\r\n\t\t\t\t\tSELECT DISTINCT\r\n\t\t\t\t\t\tuserid \r\n\t\t\t\t\tFROM (\r\n\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\tld_users.id AS userid \r\n\t\t\t\t\t\tFROM ld_users\r\n\t\t\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='OftenUseReport' AND scopeauthority=1 AND userid='[uuid]')\r\n\t\t\t\t\t\tUNION\r\n\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\tviewid\r\n\t\t\t\t\t\tFROM ld_scoperhigher\r\n\t\t\t\t\t\tWHERE userid='[uuid]' AND modulename='OftenUseReport' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename='OftenUseReport')\t\t\t\r\n\t\t\t\t\t\tUNION\r\n\t\t\t\t\t\tSELECT DISTINCT \r\n\t\t\t\t\t\t\tld_users2group.userid AS userid \r\n\t\t\t\t\t\tFROM ld_scoperhigher \r\n\t\t\t\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\t\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\t\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\t\t\t\tAND ld_scoperhigher.modulename='OftenUseReport'\r\n\t\t\t\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='OftenUseReport' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\t\t\t\tUNION \r\n\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\tid\r\n\t\t\t\t\t\tFROM ld_users  \r\n\t\t\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\t\t\t\tUNION\r\n\t\t\t\t\t\tSELECT '[uuid]') AS vw_users\r\n\t\t\t\t) AS tmp_users ON tmp_users.userid=a.id\r\n\t\t\t\tINNER JOIN (\r\n\t\t\t\t\t(SELECT smownerid FROM ld_salesorder WHERE deleted=0 GROUP BY smownerid)\r\n\t\t\t\t\tUNION\r\n\t\t\t\t\t(SELECT smownerid FROM ld_servicecontracts WHERE deleted=0 GROUP BY smownerid)\r\n\t\t\t\t\tUNION\r\n\t\t\t\t\t(SELECT smownerid FROM ld_expense WHERE deleted=0 and accountid>0 GROUP BY smownerid)\r\n\t\t\t\t\tUNION\r\n\t\t\t\t\t(SELECT smownerid FROM ld_commission WHERE deleted=0 and accountid>0 GROUP BY smownerid)\r\n\t\t\t\t\tUNION\r\n\t\t\t\t\t(SELECT '[uuid]')\r\n\t\t\t\t) c ON c.smownerid=a.id\r\n\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\tAND a.`status`='Active'\r\n\t\t\t))\r\n\t\tELSE FIND_IN_SET(smownerid,'{data_range}')\r\n\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{accountname}'='' THEN\t1=1\r\n\t\t\tELSE accountname like '%{accountname}%'\t\t\r\n\t\tEND)\r\nORDER BY CONVERT(last_name USING GBK),order2,cashbilldate,cashbill_no"
      },
      "3": {
        "Ident": "StiMySqlSource",
        "Name": "detail",
        "Alias": "detail",
        "Columns": {
          "0": {
            "Name": "costtype",
            "Index": -1,
