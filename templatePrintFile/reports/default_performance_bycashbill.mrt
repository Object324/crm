    "DataSources": {
      "0": {
        "Ident": "StiMySqlSource",
        "Name": "columnname",
        "Alias": "columnname",
        "Columns": {
          "0": {
            "Name": "column_num",
            "Index": -1,
            "NameInSource": "column_num",
            "Alias": "column_num",
            "Type": "System.String"
          },
          "1": {
            "Name": "column_qty",
            "Index": -1,
            "NameInSource": "column_qty",
            "Alias": "column_qty",
            "Type": "System.String"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\tCASE \r\n\t\tWHEN {costtype}=4 THEN\r\n\t\t\t(select \r\n\t\t\t\tconcat(fieldlabel,'编号') \r\n\t\t\tfrom ld_tranlabel \r\n\t\t\twhere trantable='ld_tab' \r\n\t\t\t\tand languagetype='zh' \r\n\t\t\t\tand Relateid=(select tabid from ld_tab where `name`='OutboundOrder') limit 1)\r\n\t\tELSE\r\n\t\t\t(select \r\n\t\t\t\tconcat(fieldlabel,'编号') \r\n\t\t\tfrom ld_tranlabel \r\n\t\t\twhere trantable='ld_tab' \r\n\t\t\t\tand languagetype='zh' \r\n\t\t\t\tand Relateid=(select tabid from ld_tab where `name`='PurchaseOrder') limit 1)\r\n\tEND AS column_num,\r\n\tCASE \r\n\t\tWHEN {costtype}=4 THEN '出库数量'\r\n\t\tELSE '采购数量'\r\n\tEND AS column_qty"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "user",
        "Alias": "user",
        "Columns": {
          "0": {
            "Name": "id",
            "Index": -1,
            "NameInSource": "id",
            "Alias": "id",
            "Type": "System.Int32"
          },
          "1": {
            "Name": "last_name",
            "Index": -1,
            "NameInSource": "last_name",
            "Alias": "last_name",
            "Type": "System.String"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\ta.id,\r\n\ta.last_name\r\nFROM ld_users a\r\nINNER JOIN (\r\n\tSELECT DISTINCT\r\n\t\tuserid \r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\tld_users.id AS userid \r\n\t\tFROM ld_users\r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='OftenUseReport' AND scopeauthority=1 AND userid='[uuid]')\r\n\t\tUNION\r\n\t\tSELECT \r\n\t\t\tviewid\r\n\t\tFROM ld_scoperhigher\r\n\t\tWHERE userid='[uuid]' AND modulename='OftenUseReport' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename='OftenUseReport')\t\t\t\r\n\t\tUNION\r\n\t\tSELECT DISTINCT \r\n\t\t\tld_users2group.userid AS userid \r\n\t\tFROM ld_scoperhigher \r\n\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\tAND ld_scoperhigher.modulename='OftenUseReport'\r\n\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='OftenUseReport' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\tUNION \r\n\t\tSELECT \r\n\t\t\tid\r\n\t\tFROM ld_users  \r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\tUNION\r\n\t\tSELECT '[uuid]') AS vw_users\r\n) AS tmp_users ON tmp_users.userid=a.id\r\nINNER JOIN (\r\n\t(SELECT smownerid FROM ld_cashbill WHERE deleted=0 GROUP BY smownerid)\r\n\tUNION\r\n\t(SELECT smownerid FROM ld_expense WHERE deleted=0 and accountid>0 GROUP BY smownerid)\r\n\tUNION\r\n\t(SELECT smownerid FROM ld_commission WHERE deleted=0 and accountid>0 GROUP BY smownerid)\r\n\tUNION\r\n\t(SELECT '[uuid]')\r\n) c ON c.smownerid=a.id\r\nWHERE a.deleted=0\r\n\tAND a.`status`='Active'\r\nORDER BY CONVERT(a.last_name USING gbk)"
      },
