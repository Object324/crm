            "NameInSource": "purchase_qty",
            "Alias": "purchase_qty",
            "Type": "System.Decimal"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\t'{costtype}' AS costtype,\r\n\ta.order_num,\r\n\tb.sequence_no,\r\n\tc.productname,\r\n\tc.product_no,\r\n\tb.quantity,\r\n\tCASE\r\n\t\tWHEN '{costtype}'='1' AND IFNULL(b.productcost,0)<>0 THEN ROUND(b.quantity*b.productcost/IFNULL(a.conversion_rate,1),2)\r\n\t\tWHEN '{costtype}'='1' AND IFNULL(b.productcost,0)=0 THEN ROUND(b.quantity*c.costprice,2)\r\n\t\tWHEN '{costtype}'='2' THEN ROUND(d.total,2)\r\n\t\tWHEN '{costtype}'='3' THEN ROUND(e.total,2)\r\n\t\tWHEN '{costtype}'='4' THEN ROUND(f.total,2)\r\n\tEND AS productcost,\r\n\td.purchaseorderid,\r\n\td.purchaseorder_no,\r\n\tIFNULL(d.purchase_qty,0) AS purchase_qty\r\nFROM (\r\n\tSELECT salesorderid AS order_id,salesorder_no AS order_num,IFNULL(conversion_rate,1) AS conversion_rate FROM ld_salesorder\r\n\tUNION ALL\r\n\tSELECT servicecontractsid,contract_no,IFNULL(conversion_rate,1) FROM ld_servicecontracts\r\n\tUNION ALL\r\n\tSELECT invoiceid,invoice_no,IFNULL(conversion_rate,1) FROM ld_invoice\r\n\tUNION ALL\r\n\tSELECT out_id,out_no,IFNULL(conversion_rate,1) FROM ld_outboundorder\r\n) a\r\nLEFT JOIN (\r\n\tSELECT id,sequence_no,productid,quantity,productcost FROM ld_salesorderdetail\r\n\tUNION ALL\r\n\tSELECT id,sequence_no,productid,quantity,productcost FROM ld_servicecontractsdetail\r\n\tUNION ALL\r\n\tSELECT id,sequence_no,productid,quantity,productcost FROM ld_invoicedetail\r\n\tUNION ALL\r\n\tSELECT id,sequence_no,productid,quantity,productcost FROM ld_outboundorderdetail\r\n) b ON a.order_id=b.id\r\nLEFT JOIN ld_products c ON c.productid=b.productid\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\ta.purchaseorderid,\r\n\t\ta.purchaseorder_no,\r\n\t\tSUM(ROUND(b.tax_amount/IFNULL(a.conversion_rate,1),2)) AS total,\r\n\t\tSUM(b.quantity) AS purchase_qty,\r\n\t\tb.productid,\r\n\t\tb.entitytypeid\r\n\tFROM ld_purchaseorder a\r\n\tLEFT JOIN ld_purchasebackdetail b ON a.purchaseorderid=b.id\r\n\tWHERE a.deleted=0\r\n\t\tAND IFNULL(a.approvestatus,'')<>'已拒绝'\r\n\t\tAND IFNULL(a.postatus,'')<>'已作废'\r\n\t\tAND b.entitytypeid>0\r\n\tGROUP BY b.entitytypeid,b.productid\r\n) d ON d.entitytypeid=a.order_id AND d.productid=b.productid  \r\nLEFT JOIN (\r\n\tSELECT\r\n\t\ta.orderid,\r\n\t\tb.productid,\r\n\t\tb.quantity*IFNULL(c.costprice,0) as total\r\n\tFROM (\r\n\t\tSELECT salesorderid AS orderid,conversion_rate FROM ld_salesorder\r\n\t\tUNION ALL\r\n\t\tSELECT servicecontractsid,conversion_rate FROM ld_servicecontracts\r\n\t) a\r\n\tLEFT JOIN (\r\n\t\tSELECT id,sequence_no,productid,quantity,productcost FROM ld_salesorderdetail\r\n\t\tUNION ALL\r\n\t\tSELECT id,sequence_no,productid,quantity,productcost FROM ld_servicecontractsdetail\r\n\t) b ON a.orderid=b.id\r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\tb.productid,\r\n\t\t\tsum(b.tax_amount/IFNULL(a.conversion_rate,1))/sum(b.quantity) as costprice\r\n\t\tFROM ld_purchaseorder a\r\n\t\tLEFT JOIN ld_purchasebackdetail b ON a.purchaseorderid=b.id\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND IFNULL(a.approvestatus,'')<>'已拒绝'\r\n\t\t\tAND IFNULL(a.postatus,'')<>'已作废'\r\n\t\tGROUP BY b.productid\r\n\t) c ON c.productid=b.productid\r\n) e ON e.orderid=a.order_id AND e.productid=b.productid \r\nLEFT JOIN (\r\n\tSELECT\r\n\t\ta.out_id,\r\n\t\ta.out_no,\r\n\t\tSUM(ROUND(b.tax_amount/IFNULL(a.conversion_rate,1),2)) AS total,\r\n\t\tSUM(b.quantity) AS purchase_qty,\r\n\t\tb.productid,\r\n\t\tb.entitytypeid\r\n\tFROM ld_outboundorder a\r\n\tLEFT JOIN ld_outboundorderdetail b ON a.out_id=b.id\r\n\tWHERE a.deleted=0\r\n\t\tAND IFNULL(a.approvestatus,'')<>'已拒绝'\r\n\t\tAND b.entitytypeid>0\r\n\tGROUP BY b.entitytypeid,b.productid\r\n) f ON f.entitytypeid=a.order_id AND f.productid=b.productid \r\nWHERE a.order_id='{this[\"id\"]}'"
      }
    },
