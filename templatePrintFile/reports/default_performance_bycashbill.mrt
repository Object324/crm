            "Alias": "purchaseorderid",
            "Type": "System.Int32"
          },
          "8": {
            "Name": "purchaseorder_no",
            "Index": -1,
            "NameInSource": "purchaseorder_no",
            "Alias": "purchaseorder_no",
            "Type": "System.String"
          },
          "9": {
            "Name": "purchase_qty",
