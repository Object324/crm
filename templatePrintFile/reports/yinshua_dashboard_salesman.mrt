            "Type": "System.String"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\tmytemp.ticketid AS billid,\r\n\tmytemp.ticket_no AS billno,\r\n\tDATE_FORMAT(mytemp.time,'%Y-%m-%d %H:%i:%s') time,\r\n\tmytemp.version,\r\n\tmytemp.keypoint\r\nFROM sequence \r\nLEFT JOIN (\r\n\tSELECT\r\n\t\ta.ticketid,\r\n\t\ta.ticket_no,\r\n\t\tb.cf_2990 AS time,\r\n\t\tb.cf_2991 AS version,\r\n\t\tb.cf_2986 AS keypoint,\r\n\t\t(\r\n\t\t\tSELECT\r\n\t\t\t\tCOUNT(o.ticketid)\r\n\t\t\tFROM ld_troubletickets o\r\n\t\t\tLEFT JOIN ld_ticketcf p ON o.ticketid=p.ticketid\r\n\t\t\tWHERE o.deleted=0\r\n\t\t\t\tAND o.approvestatus<>'已拒绝'\r\n\t\t\t\tAND o.`status`='在途'\r\n\t\t\t\tAND o.createdtime>=a.createdtime AND o.ticketid>=a.ticketid\r\n\t\t) AS seq\r\n\tFROM ld_troubletickets a\r\n\tLEFT JOIN ld_ticketcf b ON b.ticketid=a.ticketid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND a.`status`='在途'\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{smowner}'='' THEN a.smownerid=(SELECT id FROM ld_users ORDER BY CONVERT(last_name USING GBK) LIMIT 1)\r\n\t\t\t\tELSE a.smownerid='{smowner}'\r\n\t\t\tEND)\r\n\tORDER BY a.createdtime DESC,a.ticketid DESC LIMIT 3\r\n) mytemp ON mytemp.seq=sequence.seq\r\nWHERE sequence.seq BETWEEN 1 AND 3"
      },
      "6": {
        "Ident": "StiMySqlSource",
        "Name": "t4",
        "Alias": "t4",
        "Columns": {
          "0": {
            "Name": "argument",
            "Index": -1,
            "NameInSource": "argument",
            "Alias": "argument",
            "Type": "System.Int32"
          },
          "1": {
            "Name": "value_a",
            "Index": -1,
            "NameInSource": "value_a",
            "Alias": "value_a",
            "Type": "System.Int32"
          },
          "2": {
            "Name": "value_b",
            "Index": -1,
            "NameInSource": "value_b",
            "Alias": "value_b",
            "Type": "System.Int32"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT \r\n\ta.seq AS argument,\r\n\tIFNULL(b.cnt,0) AS value_a,\r\n\tIFNULL(c.cnt,0) AS value_b\r\nFROM sequence a\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\tLEFT(a.cf_2963,1) AS fenji,\r\n\t\tCOUNT(a.accountid) AS cnt\r\n\tFROM ld_account a\r\n\tWHERE a.deleted=0\r\n\t\tAND a.cf_2963 IN ('1级','2级','3级','4级','5级')\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{smowner}'='' THEN a.smownerid=(SELECT id FROM ld_users ORDER BY CONVERT(last_name USING GBK) LIMIT 1)\r\n\t\t\t\tELSE a.smownerid='{smowner}'\r\n\t\t\tEND)\r\n\tGROUP BY a.cf_2963\r\n) b ON b.fenji=a.seq\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\tLEFT(a.cf_2963,1) AS fenji,\r\n\t\tCOUNT(a.accountid) AS cnt\r\n\tFROM ld_account a\r\n\tWHERE a.deleted=0\r\n\t\tAND a.cf_2963 IN ('1级','2级','3级','4级','5级')\r\n\t\tAND a.nolinkdays>=45\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{smowner}'='' THEN a.smownerid=(SELECT id FROM ld_users ORDER BY CONVERT(last_name USING GBK) LIMIT 1)\r\n\t\t\t\tELSE a.smownerid='{smowner}'\r\n\t\t\tEND)\r\n\tGROUP BY a.cf_2963\r\n) c ON c.fenji=a.seq\r\nWHERE a.seq BETWEEN 1 AND 5\r\nORDER BY a.seq DESC"
      },
