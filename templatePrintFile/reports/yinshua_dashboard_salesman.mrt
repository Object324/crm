          },
          "3": {
            "Name": "billyear",
            "Index": -1,
            "NameInSource": "billyear",
            "Alias": "billyear",
            "Type": "System.Int32"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\tbillid,\r\n\tbillno,\r\n\tbillname,\r\n\tbillyear\r\nFROM (\r\n\tSELECT\r\n\t\t'新客户线索' AS billtype,\r\n\t\ta.accountid AS billid,\r\n\t\ta.accountname AS billname,\r\n\t\ta.account_no AS billno,\r\n\t\tYEAR(a.createdtime) AS billyear\r\n\tFROM ld_account a\r\n\tWHERE a.deleted=0\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{this[\"valuetype\"]}'='期初值' THEN  YEAR(a.createdtime)='{nian}'-1\r\n\t\t\t\tWHEN '{this[\"valuetype\"]}'='当前值' THEN  YEAR(a.createdtime)='{nian}'\r\n\t\t\tEND)\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{smowner}'='' THEN a.smownerid=(SELECT id FROM ld_users ORDER BY CONVERT(last_name USING GBK) LIMIT 1)\r\n\t\t\t\tELSE a.smownerid='{smowner}'\r\n\t\t\tEND)\r\n\t\tAND '新客户线索'='{this[\"thistype\"]}'\r\n\tGROUP BY a.accountid\r\n\tUNION\r\n\tSELECT\r\n\t\t'跟进' AS billtype,\r\n\t\ta.accountid AS billid,\r\n\t\tb.accountname AS billname,\r\n\t\tb.account_no AS billno,\r\n\t\tYEAR(a.createdtime) AS billyear\r\n\tFROM ld_contactrecords a\r\n\tLEFT JOIN ld_account b ON a.accountid=b.accountid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.contactrecordtype='电话'\r\n\t\tAND a.accountid>0\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{this[\"valuetype\"]}'='期初值' THEN  YEAR(a.createdtime)='{nian}'-1\r\n\t\t\t\tWHEN '{this[\"valuetype\"]}'='当前值' THEN  YEAR(a.createdtime)='{nian}'\r\n\t\t\tEND)\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{smowner}'='' THEN a.smownerid=(SELECT id FROM ld_users ORDER BY CONVERT(last_name USING GBK) LIMIT 1)\r\n\t\t\t\tELSE a.smownerid='{smowner}'\r\n\t\t\tEND)\r\n\t\tAND '跟进'='{this[\"thistype\"]}'\r\n\tGROUP BY a.accountid\r\n\tUNION\r\n\tSELECT\r\n\t\t'面访' AS billtype,\r\n\t\ta.accountid AS billid,\r\n\t\tb.accountname AS billname,\r\n\t\tb.account_no AS billno,\r\n\t\tYEAR(a.createdtime) AS billyear\r\n\tFROM ld_contactrecords a\r\n\tLEFT JOIN ld_account b ON a.accountid=b.accountid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.contactrecordtype='上门'\r\n\t\tAND a.accountid>0\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{this[\"valuetype\"]}'='期初值' THEN  YEAR(a.createdtime)='{nian}'-1\r\n\t\t\t\tWHEN '{this[\"valuetype\"]}'='当前值' THEN  YEAR(a.createdtime)='{nian}'\r\n\t\t\tEND)\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{smowner}'='' THEN a.smownerid=(SELECT id FROM ld_users ORDER BY CONVERT(last_name USING GBK) LIMIT 1)\r\n\t\t\t\tELSE a.smownerid='{smowner}'\r\n\t\t\tEND)\r\n\t\tAND '面访'='{this[\"thistype\"]}'\r\n\tGROUP BY a.accountid\r\n\tUNION\r\n\tSELECT\r\n\t\t'商机' AS billtype,\r\n\t\ta.accountid AS billid,\r\n\t\tb.accountname AS billname,\r\n\t\tb.account_no AS billno,\r\n\t\tYEAR(a.createdtime) AS billyear\r\n\tFROM ld_potential a\r\n\tLEFT JOIN ld_account b ON a.accountid=b.accountid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.accountid>0\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{this[\"valuetype\"]}'='期初值' THEN  YEAR(a.createdtime)='{nian}'-1\r\n\t\t\t\tWHEN '{this[\"valuetype\"]}'='当前值' THEN  YEAR(a.createdtime)='{nian}'\r\n\t\t\tEND)\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{smowner}'='' THEN a.smownerid=(SELECT id FROM ld_users ORDER BY CONVERT(last_name USING GBK) LIMIT 1)\r\n\t\t\t\tELSE a.smownerid='{smowner}'\r\n\t\t\tEND)\r\n\t\tAND '商机'='{this[\"thistype\"]}'\r\n\tGROUP BY a.accountid\r\n\tUNION\r\n\tSELECT\r\n\t\t'报价' AS billtype,\r\n\t\ta.accountid AS billid,\r\n\t\tb.accountname AS billname,\r\n\t\tb.account_no AS billno,\r\n\t\tYEAR(a.createdtime) AS billyear\r\n\tFROM ld_quotes a\r\n\tLEFT JOIN ld_account b ON b.accountid=a.accountid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.accountid>0\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{this[\"valuetype\"]}'='期初值' THEN  YEAR(a.createdtime)='{nian}'-1\r\n\t\t\t\tWHEN '{this[\"valuetype\"]}'='当前值' THEN  YEAR(a.createdtime)='{nian}'\r\n\t\t\tEND)\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{smowner}'='' THEN a.smownerid=(SELECT id FROM ld_users ORDER BY CONVERT(last_name USING GBK) LIMIT 1)\r\n\t\t\t\tELSE a.smownerid='{smowner}'\r\n\t\t\tEND)\r\n\t\tAND '报价'='{this[\"thistype\"]}'\r\n\tGROUP BY a.accountid\r\n\tUNION\r\n\tSELECT\r\n\t\t'长期' AS billtype,\r\n\t\ta.accountid AS billid,\r\n\t\tb.accountname AS billname,\r\n\t\tb.account_no AS billno,\r\n\t\tYEAR(a.createdtime) AS billyear\r\n\tFROM ld_quotes a\r\n\tLEFT JOIN ld_account b ON b.accountid=a.accountid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.accountid>0\r\n\t\tAND DATE_ADD(a.createdtime,INTERVAL 1 YEAR)<NOW()\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{this[\"valuetype\"]}'='期初值' THEN  YEAR(a.createdtime)='{nian}'-1\r\n\t\t\t\tWHEN '{this[\"valuetype\"]}'='当前值' THEN  YEAR(a.createdtime)='{nian}'\r\n\t\t\tEND)\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{smowner}'='' THEN a.smownerid=(SELECT id FROM ld_users ORDER BY CONVERT(last_name USING GBK) LIMIT 1)\r\n\t\t\t\tELSE a.smownerid='{smowner}'\r\n\t\t\tEND)\r\n\t\tAND '长期'='{this[\"thistype\"]}'\r\n\tGROUP BY a.accountid\r\n) tmp\r\nWHERE billtype='{this[\"thistype\"]}'"
      },
