          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\tCASE\r\n\t\tWHEN '{smowner}'='' THEN (SELECT last_name FROM ld_users ORDER BY CONVERT(last_name USING GBK) LIMIT 1)\r\n\t\tELSE (SELECT last_name FROM ld_users WHERE id='{smowner}')\r\n\tEND AS LAB1"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "list_nian",
