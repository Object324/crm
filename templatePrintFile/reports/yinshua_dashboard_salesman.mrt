            "Type": "System.Decimal"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\tCASE\r\n\t\tWHEN seq=1 THEN '3级,潜力值'\r\n\t\tELSE '3级,当前值'\r\n\tEND AS argument_l3,\r\n\tROUND(value_l3*100/total_l3,0) AS value_l3,\r\n\tCASE\r\n\t\tWHEN seq=1 THEN '4级,潜力值'\r\n\t\tELSE '4级,当前值'\r\n\tEND AS argument_l4,\r\n\tROUND(value_l4*100/total_l4,0) AS value_l4,\r\n\tCASE\r\n\t\tWHEN seq=1 THEN '5级,潜力值'\r\n\t\tELSE '5级,当前值'\r\n\tEND AS argument_l5,\r\n\tROUND(value_l5*100/total_l5,0) AS value_l5\r\nFROM (\r\n\tSELECT\r\n\t\ta.seq,\r\n\t\tIF(IFNULL(b.total_l3,0)=0,0.1,b.total_l3) AS value_l3,\r\n\t\tIFNULL((\r\n\t\t\tSELECT\r\n\t\t\t\tSUM(IFNULL(total,0.1))\r\n\t\t\tFROM (\r\n\t\t\t\tSELECT\r\n\t\t\t\t\tSUM(a.total/IFNULL(a.conversion_rate,1)) AS total\r\n\t\t\t\tFROM ld_servicecontracts a\r\n\t\t\t\tLEFT JOIN ld_account b ON b.accountid=a.accountid\r\n\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{smowner}'='' THEN a.smownerid=(SELECT id FROM ld_users ORDER BY CONVERT(last_name USING GBK) LIMIT 1)\r\n\t\t\t\t\t\t\tELSE a.smownerid='{smowner}'\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND b.cf_2963='3级'\r\n\t\t\t\tUNION ALL\r\n\t\t\t\tSELECT\r\n\t\t\t\t\tSUM(a.total/IFNULL(a.conversion_rate,1)) AS total\r\n\t\t\t\tFROM ld_salesorder a\r\n\t\t\t\tLEFT JOIN ld_account b ON b.accountid=a.accountid\r\n\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\t\tAND b.cf_2963='3级'\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{smowner}'='' THEN a.smownerid=(SELECT id FROM ld_users ORDER BY CONVERT(last_name USING GBK) LIMIT 1)\r\n\t\t\t\t\t\t\tELSE a.smownerid='{smowner}'\r\n\t\t\t\t\t\tEND)\r\n\t\t\t) a\r\n\t\t),0.2) AS total_l3,\r\n\t\tIF(IFNULL(b.total_l4,0)=0,0.1,b.total_l4) AS value_l4,\r\n\t\tIFNULL((\r\n\t\t\tSELECT\r\n\t\t\t\tSUM(IFNULL(total,0.1))\r\n\t\t\tFROM (\r\n\t\t\t\tSELECT\r\n\t\t\t\t\tSUM(a.total/IFNULL(a.conversion_rate,1)) AS total\r\n\t\t\t\tFROM ld_servicecontracts a\r\n\t\t\t\tLEFT JOIN ld_account b ON b.accountid=a.accountid\r\n\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{smowner}'='' THEN a.smownerid=(SELECT id FROM ld_users ORDER BY CONVERT(last_name USING GBK) LIMIT 1)\r\n\t\t\t\t\t\t\tELSE a.smownerid='{smowner}'\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND b.cf_2963='4级'\r\n\t\t\t\tUNION ALL\r\n\t\t\t\tSELECT\r\n\t\t\t\t\tSUM(a.total/IFNULL(a.conversion_rate,1)) AS total\r\n\t\t\t\tFROM ld_salesorder a\r\n\t\t\t\tLEFT JOIN ld_account b ON b.accountid=a.accountid\r\n\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\t\tAND b.cf_2963='4级'\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{smowner}'='' THEN a.smownerid=(SELECT id FROM ld_users ORDER BY CONVERT(last_name USING GBK) LIMIT 1)\r\n\t\t\t\t\t\t\tELSE a.smownerid='{smowner}'\r\n\t\t\t\t\t\tEND)\r\n\t\t\t) a\r\n\t\t),0.2) AS total_l4,\r\n\t\tIF(IFNULL(b.total_l5,0)=0,0.1,b.total_l5) AS value_l5,\r\n\t\tIFNULL((\r\n\t\t\tSELECT\r\n\t\t\t\tSUM(IFNULL(total,0.1))\r\n\t\t\tFROM (\r\n\t\t\t\tSELECT\r\n\t\t\t\t\tSUM(a.total/IFNULL(a.conversion_rate,1)) AS total\r\n\t\t\t\tFROM ld_servicecontracts a\r\n\t\t\t\tLEFT JOIN ld_account b ON b.accountid=a.accountid\r\n\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{smowner}'='' THEN a.smownerid=(SELECT id FROM ld_users ORDER BY CONVERT(last_name USING GBK) LIMIT 1)\r\n\t\t\t\t\t\t\tELSE a.smownerid='{smowner}'\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND b.cf_2963='5级'\r\n\t\t\t\tUNION ALL\r\n\t\t\t\tSELECT\r\n\t\t\t\t\tSUM(a.total/IFNULL(a.conversion_rate,1)) AS total\r\n\t\t\t\tFROM ld_salesorder a\r\n\t\t\t\tLEFT JOIN ld_account b ON b.accountid=a.accountid\r\n\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\t\tAND b.cf_2963='5级'\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{smowner}'='' THEN a.smownerid=(SELECT id FROM ld_users ORDER BY CONVERT(last_name USING GBK) LIMIT 1)\r\n\t\t\t\t\t\t\tELSE a.smownerid='{smowner}'\r\n\t\t\t\t\t\tEND)\r\n\t\t\t) a\r\n\t\t),0.2) AS total_l5\r\n\tFROM sequence a\r\n\tLEFT JOIN(\r\n\tSELECT\r\n\t\t\ta.seq,\r\n\t\t\tSUM(total_l3) AS total_l3,\r\n\t\t\tSUM(total_l4) AS total_l4,\r\n\t\t\tSUM(total_l5) AS total_l5\r\n\t\tFROM (\r\n\t\t\tSELECT\r\n\t\t\t\t1 AS seq,\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN b.cf_2963='3级' THEN a.total/IFNULL(a.conversion_rate,1) \r\n\t\t\t\t\tELSE 0\r\n\t\t\t\tEND AS total_l3,\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN b.cf_2963='4级' THEN a.total/IFNULL(a.conversion_rate,1) \r\n\t\t\t\t\tELSE 0\r\n\t\t\t\tEND AS total_l4,\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN b.cf_2963='5级' THEN a.total/IFNULL(a.conversion_rate,1) \r\n\t\t\t\t\tELSE 0\r\n\t\t\t\tEND AS total_l5\r\n\t\t\tFROM ld_servicecontracts a\r\n\t\t\tLEFT JOIN ld_account b ON b.accountid=a.accountid\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{smowner}'='' THEN a.smownerid=(SELECT id FROM ld_users ORDER BY CONVERT(last_name USING GBK) LIMIT 1)\r\n\t\t\t\t\t\tELSE a.smownerid='{smowner}'\r\n\t\t\t\t\tEND)\r\n\t\t) a\r\n\t\tUNION\r\n\t\tSELECT\r\n\t\t\ta.seq,\r\n\t\t\tSUM(total_l3) AS total_l3,\r\n\t\t\tSUM(total_l4) AS total_l4,\r\n\t\t\tSUM(total_l5) AS total_l5\r\n\t\tFROM (\r\n\t\t\tSELECT\r\n\t\t\t\t2 AS seq,\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN b.cf_2963='3级' THEN a.total/IFNULL(a.conversion_rate,1) \r\n\t\t\t\t\tELSE 0\r\n\t\t\t\tEND AS total_l3,\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN b.cf_2963='4级' THEN a.total/IFNULL(a.conversion_rate,1) \r\n\t\t\t\t\tELSE 0\r\n\t\t\t\tEND AS total_l4,\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN b.cf_2963='5级' THEN a.total/IFNULL(a.conversion_rate,1) \r\n\t\t\t\t\tELSE 0\r\n\t\t\t\tEND AS total_l5\r\n\t\t\tFROM ld_salesorder a\r\n\t\t\tLEFT JOIN ld_account b ON b.accountid=a.accountid\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND b.cf_2963 IN ('3级','4级','5级')\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{smowner}'='' THEN a.smownerid=(SELECT id FROM ld_users ORDER BY CONVERT(last_name USING GBK) LIMIT 1)\r\n\t\t\t\t\t\tELSE a.smownerid='{smowner}'\r\n\t\t\t\t\tEND)\r\n\t\t) a\r\n\t) b ON b.seq=a.seq\r\n\tWHERE a.seq BETWEEN 1 AND 2\r\n)tmp"
      },
      "8": {
        "Ident": "StiMySqlSource",
        "Name": "t6",
        "Alias": "t6",
        "Columns": {
          "0": {
            "Name": "type",
            "Index": -1,
            "NameInSource": "type",
            "Alias": "type",
            "Type": "System.String"
          },
          "1": {
            "Name": "last_value",
            "Index": -1,
            "NameInSource": "last_value",
            "Alias": "last_value",
            "Type": "System.Decimal"
          },
          "2": {
            "Name": "this_value",
            "Index": -1,
            "NameInSource": "this_value",
            "Alias": "this_value",
            "Type": "System.Decimal"
          },
          "3": {
            "Name": "this_rate",
            "Index": -1,
            "NameInSource": "this_rate",
            "Alias": "this_rate",
            "Type": "System.Decimal"
          },
          "4": {
            "Name": "quarter_value",
            "Index": -1,
            "NameInSource": "quarter_value",
            "Alias": "quarter_value",
            "Type": "System.Int32"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\t'新客户线索' AS type, \r\n\tSUM(IFNULL(t.last_value,0)) AS last_value,\r\n\tSUM(IFNULL(t.this_value,0)) AS this_value,\r\n\tCASE\r\n\t\tWHEN SUM(IFNULL(t.last_value,0))=0 THEN 1\r\n\t\tELSE SUM(IFNULL(t.this_value,0))/SUM(IFNULL(t.last_value,0))\r\n\tEND AS this_rate,\r\n\t(\r\n\t\tSELECT\r\n\t\t\tcnt\r\n\t\tFROM (\r\n\t\t\tSELECT\r\n\t\t\t\tcnt,\r\n\t\t\t\t(\r\n\t\t\t\t\tSELECT\r\n\t\t\t\t\t\tCOUNT(1)\r\n\t\t\t\t\tFROM (\r\n\t\t\t\t\t\t\tSELECT\r\n\t\t\t\t\t\t\t\tCOUNT(a.accountid)*10000+a.smownerid AS smownerid,\r\n\t\t\t\t\t\t\t\tCOUNT(a.accountid) AS cnt\r\n\t\t\t\t\t\t\tFROM ld_account a\r\n\t\t\t\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\t\t\t\tAND YEAR(a.createdtime)='{nian}'\r\n\t\t\t\t\t\t\tGROUP BY a.smownerid\r\n\t\t\t\t\t\t) b\r\n\t\t\t\t\tWHERE b.cnt>=a.cnt AND b.smownerid>=a.smownerid\r\n\t\t\t\t) seq\r\n\t\t\tFROM (\r\n\t\t\t\tSELECT\r\n\t\t\t\t\tCOUNT(a.accountid)*10000+a.smownerid AS smownerid,\r\n\t\t\t\t\tCOUNT(a.accountid) AS cnt\r\n\t\t\t\tFROM ld_account a\r\n\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\tAND YEAR(a.createdtime)='{nian}'\r\n\t\t\t\tGROUP BY a.smownerid\r\n\t\t\t\tORDER BY cnt DESC,a.smownerid DESC\r\n\t\t\t) a\r\n\t\t) tmp\r\n\t\tWHERE seq=CEIL(IFNULL((\r\n\t\t\tSELECT\r\n\t\t\t\tCOUNT(1)\r\n\t\t\tFROM (\r\n\t\t\t\tSELECT\r\n\t\t\t\t\ta.smownerid\r\n\t\t\t\tFROM ld_account a\r\n\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\tAND YEAR(a.createdtime)='{nian}'\r\n\t\t\t\tGROUP BY a.smownerid\r\n\t\t\t) a\r\n\t\t),0)/4) LIMIT 1\r\n\t) AS  quarter_value\r\nFROM (\r\n\tSELECT\r\n\t\tCASE\r\n\t\t\tWHEN YEAR(a.createdtime)='{nian}'-1 THEN 1\r\n\t\t\tELSE 0\r\n\t\tEND AS last_value,\r\n\t\tCASE\r\n\t\t\tWHEN YEAR(a.createdtime)='{nian}' THEN 1\r\n\t\t\tELSE 0\r\n\t\tEND AS this_value\r\n\tFROM ld_account a\r\n\tWHERE a.deleted=0\r\n\t\tAND (YEAR(a.createdtime)='{nian}' OR YEAR(a.createdtime)='{nian}'-1)\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{smowner}'='' THEN a.smownerid=(SELECT id FROM ld_users ORDER BY CONVERT(last_name USING GBK) LIMIT 1)\r\n\t\t\t\tELSE a.smownerid='{smowner}'\r\n\t\t\tEND)\r\n) t\r\nUNION\r\nSELECT\r\n\t'跟进' AS type, \r\n\tSUM(IFNULL(t.last_value,0)) AS last_value,\r\n\tSUM(IFNULL(t.this_value,0)) AS this_value,\r\n\tCASE\r\n\t\tWHEN SUM(IFNULL(t.last_value,0))=0 THEN 1\r\n\t\tELSE SUM(IFNULL(t.this_value,0))/SUM(IFNULL(t.last_value,0))\r\n\tEND AS this_rate,\r\n\t(\r\n\t\tSELECT\r\n\t\t\tcnt\r\n\t\tFROM (\r\n\t\t\tSELECT\r\n\t\t\t\tcnt,\r\n\t\t\t\t(\r\n\t\t\t\t\tSELECT\r\n\t\t\t\t\t\tCOUNT(1)\r\n\t\t\t\t\tFROM (\r\n\t\t\t\t\t\t\tSELECT\r\n\t\t\t\t\t\t\t\tCOUNT(DISTINCT a.accountid)*10000+a.smownerid AS smownerid,\r\n\t\t\t\t\t\t\t\tCOUNT(DISTINCT a.accountid) AS cnt\r\n\t\t\t\t\t\t\tFROM ld_contactrecords a\r\n\t\t\t\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\t\t\t\tAND a.contactrecordtype='电话'\r\n\t\t\t\t\t\t\t\tAND a.accountid>0\r\n\t\t\t\t\t\t\t\tAND YEAR(a.createdtime)='{nian}'\r\n\t\t\t\t\t\t\tGROUP BY a.smownerid\r\n\t\t\t\t\t\t) b\r\n\t\t\t\t\tWHERE b.cnt>=a.cnt AND b.smownerid>=a.smownerid\r\n\t\t\t\t) seq\r\n\t\t\tFROM (\r\n\t\t\t\tSELECT\r\n\t\t\t\t\tCOUNT(DISTINCT a.accountid)*10000+a.smownerid AS smownerid,\r\n\t\t\t\t\tCOUNT(DISTINCT a.accountid) AS cnt\r\n\t\t\t\tFROM ld_contactrecords a\r\n\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\tAND a.contactrecordtype='电话'\r\n\t\t\t\t\tAND a.accountid>0\r\n\t\t\t\t\tAND YEAR(a.createdtime)='{nian}'\r\n\t\t\t\tGROUP BY a.smownerid\r\n\t\t\t\tORDER BY cnt DESC,a.smownerid DESC\r\n\t\t\t) a\r\n\t\t) tmp\r\n\t\tWHERE seq=CEIL(IFNULL((\r\n\t\t\tSELECT\r\n\t\t\t\tCOUNT(DISTINCT accountid)\r\n\t\t\tFROM (\r\n\t\t\t\tSELECT\r\n\t\t\t\t\ta.smownerid,\r\n\t\t\t\t\ta.accountid\r\n\t\t\t\tFROM ld_contactrecords a\r\n\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\tAND a.contactrecordtype='电话'\r\n\t\t\t\t\tAND a.accountid>0\r\n\t\t\t\t\tAND YEAR(a.createdtime)='{nian}'\r\n\t\t\t\tGROUP BY a.smownerid\r\n\t\t\t) a\r\n\t\t),0)/4) LIMIT 1\r\n\t) AS  quarter_value\r\nFROM (\r\n\tSELECT\r\n\t\tCASE\r\n\t\t\tWHEN YEAR(a.createdtime)='{nian}'-1 THEN 1\r\n\t\t\tELSE 0\r\n\t\tEND AS last_value,\r\n\t\tCASE\r\n\t\t\tWHEN YEAR(a.createdtime)='{nian}' THEN 1\r\n\t\t\tELSE 0\r\n\t\tEND AS this_value\r\n\tFROM ld_contactrecords a\r\n\tWHERE a.deleted=0\r\n\t\tAND a.contactrecordtype='电话'\r\n\t\tAND a.accountid>0\r\n\t\tAND (YEAR(a.createdtime)='{nian}' OR YEAR(a.createdtime)='{nian}'-1)\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{smowner}'='' THEN a.smownerid=(SELECT id FROM ld_users ORDER BY CONVERT(last_name USING GBK) LIMIT 1)\r\n\t\t\t\tELSE a.smownerid='{smowner}'\r\n\t\t\tEND)\r\n\tGROUP BY a.accountid\r\n) t\r\nUNION\r\nSELECT\r\n\t'面访' AS type, \r\n\tSUM(IFNULL(t.last_value,0)) AS last_value,\r\n\tSUM(IFNULL(t.this_value,0)) AS this_value,\r\n\tCASE\r\n\t\tWHEN SUM(IFNULL(t.last_value,0))=0 THEN 1\r\n\t\tELSE SUM(IFNULL(t.this_value,0))/SUM(IFNULL(t.last_value,0))\r\n\tEND AS this_rate,\r\n\t(\r\n\t\tSELECT\r\n\t\t\tcnt\r\n\t\tFROM (\r\n\t\t\tSELECT\r\n\t\t\t\tcnt,\r\n\t\t\t\t(\r\n\t\t\t\t\tSELECT\r\n\t\t\t\t\t\tCOUNT(1)\r\n\t\t\t\t\tFROM (\r\n\t\t\t\t\t\t\tSELECT\r\n\t\t\t\t\t\t\t\tCOUNT(DISTINCT a.accountid)*10000+a.smownerid AS smownerid,\r\n\t\t\t\t\t\t\t\tCOUNT(DISTINCT a.accountid) AS cnt\r\n\t\t\t\t\t\t\tFROM ld_contactrecords a\r\n\t\t\t\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\t\t\t\tAND a.contactrecordtype='上门'\r\n\t\t\t\t\t\t\t\tAND a.accountid>0\r\n\t\t\t\t\t\t\t\tAND YEAR(a.createdtime)='{nian}'\r\n\t\t\t\t\t\t\tGROUP BY a.smownerid\r\n\t\t\t\t\t\t) b\r\n\t\t\t\t\tWHERE b.cnt>=a.cnt AND b.smownerid>=a.smownerid\r\n\t\t\t\t) seq\r\n\t\t\tFROM (\r\n\t\t\t\tSELECT\r\n\t\t\t\t\tCOUNT(DISTINCT a.accountid)*10000+a.smownerid AS smownerid,\r\n\t\t\t\t\tCOUNT(DISTINCT a.accountid) AS cnt\r\n\t\t\t\tFROM ld_contactrecords a\r\n\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\tAND a.contactrecordtype='上门'\r\n\t\t\t\t\tAND a.accountid>0\r\n\t\t\t\t\tAND YEAR(a.createdtime)='{nian}'\r\n\t\t\t\tGROUP BY a.smownerid\r\n\t\t\t\tORDER BY cnt DESC,a.smownerid DESC\r\n\t\t\t) a\r\n\t\t) tmp\r\n\t\tWHERE seq=CEIL(IFNULL((\r\n\t