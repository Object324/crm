          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT YEAR(NOW())-4 AS listvalue\r\nUNION\r\nSELECT YEAR(NOW())-3 AS listvalue\r\nUNION\r\nSELECT YEAR(NOW())-2 AS listvalue\r\nUNION\r\nSELECT YEAR(NOW())-1 AS listvalue\r\nUNION\r\nSELECT YEAR(NOW()) AS listvalue"
      },
      "2": {
        "Ident": "StiMySqlSource",
        "Name": "list_users",
        "Alias": "list_users",
        "Columns": {
          "0": {
            "Name": "listid",
            "Index": -1,
            "NameInSource": "listid",
