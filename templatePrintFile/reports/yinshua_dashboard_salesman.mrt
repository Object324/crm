            "Type": "System.String"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\ta.id AS listid,\r\n\ta.last_name AS listvalue\r\nFROM ld_users a\r\nORDER BY CONVERT(a.last_name USING GBK)"
      },
      "3": {
        "Ident": "StiMySqlSource",
        "Name": "t",
        "Alias": "t",
        "Columns": {
          "0": {
            "Name": "argument",
            "Index": -1,
            "NameInSource": "argument",
            "Alias": "argument",
            "Type": "System.String"
          },
          "1": {
            "Name": "value_a",
            "Index": -1,
            "NameInSource": "value_a",
            "Alias": "value_a",
            "Type": "System.Decimal"
          },
          "2": {
            "Name": "value_b",
            "Index": -1,
            "NameInSource": "value_b",
            "Alias": "value_b",
            "Type": "System.Decimal"
          },
          "3": {
            "Name": "value_c",
            "Index": -1,
            "NameInSource": "value_c",
            "Alias": "value_c",
            "Type": "System.Decimal"
          },
          "4": {
            "Name": "value_d",
            "Index": -1,
            "NameInSource": "value_d",
            "Alias": "value_d",
            "Type": "System.Decimal"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\tCASE\r\n\t\tWHEN a.seq=13 THEN '年度总计'\r\n\t\tELSE CONCAT('{nian}','年',a.seq,'月')\r\n\tEND AS argument,\r\n\tROUND(IFNULL(b.value_data,0)*0.0001) AS value_a,\r\n\tROUND(IFNULL(c.value_data,0)*0.0001,0) AS value_b,\r\n\tCASE\r\n\t\tWHEN IFNULL(d.value_data,0)=0 THEN 0\r\n\t\tWHEN IFNULL(d.value_data,0)>0 AND IFNULL(e.value_data,0)=0 THEN 100\r\n\t\tELSE ROUND(IFNULL(d.value_data,0)*100/IFNULL(e.value_data,0),0)\r\n\tEND AS value_c,\r\n\tCASE\r\n\t\tWHEN IFNULL(f.value_data,0)=0 THEN 0\r\n\t\tWHEN IFNULL(f.value_data,0)>0 AND IFNULL(g.value_data,0)=0 THEN 100\r\n\t\tELSE ROUND(IFNULL(f.value_data,0)*100/IFNULL(g.value_data,0),0)\r\n\tEND AS value_d\r\nFROM sequence a\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\tMONTH(a.signed_data) AS argument_data,\r\n\t\tSUM(a.total/IFNULL(a.conversion_rate,1)) AS value_data\r\n\tFROM ld_salesorder a\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND YEAR(a.signed_data)='{nian}'\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{smowner}'='' THEN a.smownerid=(SELECT id FROM ld_users ORDER BY CONVERT(last_name USING GBK) LIMIT 1)\r\n\t\t\t\tELSE a.smownerid='{smowner}'\r\n\t\t\tEND)\r\n\tGROUP BY MONTH(a.signed_data)\r\n\tUNION\r\n\tSELECT\r\n\t\t13 AS argument_data,\r\n\t\tSUM(a.total/IFNULL(a.conversion_rate,1)) AS value_data\r\n\tFROM ld_salesorder a\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND YEAR(a.signed_data)='{nian}'\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{smowner}'='' THEN a.smownerid=(SELECT id FROM ld_users ORDER BY CONVERT(last_name USING GBK) LIMIT 1)\r\n\t\t\t\tELSE a.smownerid='{smowner}'\r\n\t\t\tEND)\r\n) b ON b.argument_data=a.seq \r\nLEFT JOIN (\r\n\tSELECT\r\n\t\ttargetmouth AS argument_data,\r\n\t\tcontractamount AS value_data\r\n\tFROM ld_salestarget\r\n\tWHERE targetyear='{nian}'\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{smowner}'='' THEN userid=(SELECT id FROM ld_users ORDER BY CONVERT(last_name USING GBK) LIMIT 1)\r\n\t\t\t\tELSE userid='{smowner}'\r\n\t\t\tEND)\r\n\tUNION\r\n\tSELECT\r\n\t\t13 AS argument_data,\r\n\t\tSUM(contractamount) AS value_data\r\n\tFROM ld_salestarget\r\n\tWHERE targetyear='{nian}'\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{smowner}'='' THEN userid=(SELECT id FROM ld_users ORDER BY CONVERT(last_name USING GBK) LIMIT 1)\r\n\t\t\t\tELSE userid='{smowner}'\r\n\t\t\tEND)\r\n) c ON c.argument_data=a.seq\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\tMONTH(a.createdtime) AS argument_date,\r\n\t\tCOUNT(a.quoteid) AS value_data\r\n\tFROM ld_quotes a\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND YEAR(a.createdtime)='{nian}'\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{smowner}'='' THEN a.smownerid=(SELECT id FROM ld_users ORDER BY CONVERT(last_name USING GBK) LIMIT 1)\r\n\t\t\t\tELSE a.smownerid='{smowner}'\r\n\t\t\tEND)\r\n\tGROUP BY MONTH(a.createdtime)\r\n\tUNION\r\n\tSELECT\r\n\t\t13 AS argument_date,\r\n\t\tCOUNT(a.quoteid) AS value_data\r\n\tFROM ld_quotes a\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND YEAR(a.createdtime)='{nian}'\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{smowner}'='' THEN a.smownerid=(SELECT id FROM ld_users ORDER BY CONVERT(last_name USING GBK) LIMIT 1)\r\n\t\t\t\tELSE a.smownerid='{smowner}'\r\n\t\t\tEND)\r\n) d ON d.argument_date=a.seq \r\nLEFT JOIN (\r\n\tSELECT\r\n\t\tMONTH(a.contactdate) AS argument_date,\r\n\t\tCOUNT(a.contactrecordID) AS value_data\r\n\tFROM ld_contactrecords a\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND YEAR(a.contactdate)='{nian}'\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{smowner}'='' THEN a.smownerid=(SELECT id FROM ld_users ORDER BY CONVERT(last_name USING GBK) LIMIT 1)\r\n\t\t\t\tELSE a.smownerid='{smowner}'\r\n\t\t\tEND)\r\n\tGROUP BY MONTH(a.contactdate)\r\n\tUNION\r\n\tSELECT\r\n\t\t13 AS argument_date,\r\n\t\tCOUNT(a.contactrecordID) AS value_data\r\n\tFROM ld_contactrecords a\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND YEAR(a.contactdate)='{nian}'\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{smowner}'='' THEN a.smownerid=(SELECT id FROM ld_users ORDER BY CONVERT(last_name USING GBK) LIMIT 1)\r\n\t\t\t\tELSE a.smownerid='{smowner}'\r\n\t\t\tEND)\r\n) e ON e.value_data=a.seq \r\nLEFT JOIN (\r\n\tSELECT\r\n\t\tMONTH(a.createdtime) AS argument_date,\r\n\t\tCOUNT(a.quoteid) AS value_data\r\n\tFROM ld_quotes a\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND YEAR(a.createdtime)='{nian}'\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{smowner}'='' THEN a.smownerid=(SELECT id FROM ld_users ORDER BY CONVERT(last_name USING GBK) LIMIT 1)\r\n\t\t\t\tELSE a.smownerid='{smowner}'\r\n\t\t\tEND)\r\n\tGROUP BY MONTH(a.createdtime)\r\n\tUNION\r\n\tSELECT\r\n\t\t13 AS argument_date,\r\n\t\tCOUNT(a.quoteid) AS value_data\r\n\tFROM ld_quotes a\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND YEAR(a.createdtime)='{nian}'\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{smowner}'='' THEN a.smownerid=(SELECT id FROM ld_users ORDER BY CONVERT(last_name USING GBK) LIMIT 1)\r\n\t\t\t\tELSE a.smownerid='{smowner}'\r\n\t\t\tEND)\r\n) f ON f.argument_date=a.seq \r\nLEFT JOIN (\r\n\tSELECT\r\n\t\tMONTH(a.createdtime) AS argument_date,\r\n\t\tCOUNT(a.quoteid) AS value_data\r\n\tFROM ld_quotes a\r\n\tLEFT JOIN ld_quotescf b ON b.quoteid =a.quoteid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND IFNULL(b.cf_2973,'')<>''\r\n\t\tAND YEAR(a.createdtime)='{nian}'\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{smowner}'='' THEN a.smownerid=(SELECT id FROM ld_users ORDER BY CONVERT(last_name USING GBK) LIMIT 1)\r\n\t\t\t\tELSE a.smownerid='{smowner}'\r\n\t\t\tEND)\r\n\tGROUP BY MONTH(a.createdtime)\r\n\tUNION\r\n\tSELECT\r\n\t\t13 AS argument_date,\r\n\t\tCOUNT(a.quoteid) AS value_data\r\n\tFROM ld_quotes a\r\n\tLEFT JOIN ld_quotescf b ON b.quoteid =a.quoteid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND IFNULL(b.cf_2973,'')<>''\r\n\t\tAND YEAR(a.createdtime)='{nian}'\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{smowner}'='' THEN a.smownerid=(SELECT id FROM ld_users ORDER BY CONVERT(last_name USING GBK) LIMIT 1)\r\n\t\t\t\tELSE a.smownerid='{smowner}'\r\n\t\t\tEND)\r\n) g ON g.value_data=a.seq \r\nWHERE a.seq BETWEEN 1 AND 13\r\nORDER BY a.seq"
      },
      "4": {
        "Ident": "StiMySqlSource",
        "Name": "t2",
        "Alias": "t2",
        "Columns": {
          "0": {
