        "Ident": "StiMySqlSource",
        "Name": "t7",
        "Alias": "t7",
        "Columns": {
          "0": {
            "Name": "argumnet",
            "Index": -1,
            "NameInSource": "argumnet",
            "Alias": "argumnet",
            "Type": "System.String"
          },
          "1": {
            "Name": "mydate",
            "Index": -1,
            "NameInSource": "mydate",
            "Alias": "mydate",
            "Type": "System.Int32"
          },
          "2": {
            "Name": "mytag",
            "Index": -1,
            "NameInSource": "mytag",
            "Alias": "mytag",
            "Type": "System.String"
          },
          "3": {
            "Name": "mytips",
            "Index": -1,
            "NameInSource": "mytips",
            "Alias": "mytips",
            "Type": "System.String"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\targumnet,\r\n\tmydate,\r\n\tCASE\r\n\t\tWHEN IFNULL(total_cnt,0)=0 THEN '0'\r\n\t\tELSE CONCAT(ROUND(mydate*100/total_cnt,0),'%')\r\n\tEND AS mytag,\r\n\tCASE\r\n\t\tWHEN IFNULL(total_cnt,0)=0 THEN CONCAT(argumnet,' - ','0')\r\n\t\tELSE CONCAT(argumnet,' - ',ROUND(mydate*100/total_cnt,0),'%')\r\n\tEND AS mytips\r\nFROM (\r\n\tSELECT\r\n\t\ta.sequence,\r\n\t\ta.listvalue AS argumnet,\r\n\t\tIFNULL(b.cnt,0) mydate,\r\n\t\t(\r\n\t\t\tSELECT\r\n\t\t\t\tCOUNT(a.accountid) AS cnt\r\n\t\t\tFROM ld_account a\r\n\t\t\tLEFT JOIN ld_accountscf b ON b.accountid=a.accountid\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{smowner}'='' THEN a.smownerid=(SELECT id FROM ld_users ORDER BY CONVERT(last_name USING GBK) LIMIT 1)\r\n\t\t\t\t\t\tELSE a.smownerid='{smowner}'\r\n\t\t\t\t\tEND)\r\n\t\t) AS total_cnt\r\n\tFROM (SELECT listvalue,sequence FROM ld_picklist_values WHERE listid=141) a\r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\tIF(IFNULL(b.cf_2992,'')='','销售线索',b.cf_2992) AS argument,\r\n\t\t\tCOUNT(a.accountid) AS cnt\r\n\t\tFROM ld_account a\r\n\t\tLEFT JOIN ld_accountscf b ON b.accountid=a.accountid\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{smowner}'='' THEN a.smownerid=(SELECT id FROM ld_users ORDER BY CONVERT(last_name USING GBK) LIMIT 1)\r\n\t\t\t\t\tELSE a.smownerid='{smowner}'\r\n\t\t\t\tEND)\r\n\t\tGROUP BY IF(IFNULL(b.cf_2992,'')='','销售线索',b.cf_2992)\r\n\t) b ON b.argument=a.listvalue\r\n) t\r\nORDER BY sequence"
      },
      "10": {
        "Ident": "StiMySqlSource",
        "Name": "t8",
        "Alias": "t8",
        "Columns": {
          "0": {
            "Name": "billid",
            "Index": -1,
            "NameInSource": "billid",
            "Alias": "billid",
            "Type": "System.Int32"
          },
          "1": {
            "Name": "billname",
            "Index": -1,
            "NameInSource": "billname",
            "Alias": "billname",
