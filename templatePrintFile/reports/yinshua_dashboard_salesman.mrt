            "Alias": "billname",
            "Type": "System.String"
          },
          "2": {
            "Name": "billno",
            "Index": -1,
            "NameInSource": "billno",
            "Alias": "billno",
            "Type": "System.String"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\ta.accountid AS billid,\r\n\ta.account_no AS billno,\r\n\ta.accountname AS billname\r\nFROM ld_account a\r\nWHERE a.deleted=0\r\n\tAND a.cf_2963 IN ('1级','2级','3级','4级','5级')\r\n\tAND LEFT(a.cf_2963,1)='{this[\"SeriesArgument\"]}'\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{smowner}'='' THEN a.smownerid=(SELECT id FROM ld_users ORDER BY CONVERT(last_name USING GBK) LIMIT 1)\r\n\t\t\tELSE a.smownerid='{smowner}'\r\n\t\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{this[\"SeriesTitle\"]}'='45天沉客' THEN a.nolinkdays>=45\r\n\t\t\tELSE 1=1\r\n\t\tEND)\r\n"
      },
      "12": {
        "Ident": "StiMySqlSource",
        "Name": "d1",
        "Alias": "d1",
        "Columns": {
          "0": {
            "Name": "cur_total",
            "Index": -1,
            "NameInSource": "cur_total",
            "Alias": "cur_total",
            "Type": "System.Decimal"
          },
          "1": {
            "Name": "id",
            "Index": -1,
            "NameInSource": "id",
            "Alias": "id",
            "Type": "System.Int32"
          },
          "2": {
            "Name": "myname",
            "Index": -1,
            "NameInSource": "myname",
            "Alias": "myname",
            "Type": "System.String"
          },
          "3": {
            "Name": "qian_total",
            "Index": -1,
            "NameInSource": "qian_total",
            "Alias": "qian_total",
            "Type": "System.String"
          },
          "4": {
            "Name": "thislevel",
            "Index": -1,
            "NameInSource": "thislevel",
            "Alias": "thislevel",
            "Type": "System.String"
          }
        },
        "NameInSource": "crm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\t'{this[\"SeriesTitle\"]}' AS thislevel,\r\n\ta.id,\r\n\ta.last_name AS myname,\r\n\tb.total AS cur_total,\r\n\tc.total AS qian_total\r\nFROM ld_users a\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\ta.smownerid,\r\n\t\t'当前值' type,\r\n\t\tSUM(a.total/IFNULL(a.conversion_rate,1)) AS total\r\n\tFROM ld_salesorder a\r\n\tLEFT JOIN ld_account b ON b.accountid=a.accountid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND b.cf_2963 IN ('3级','4级','5级')\r\n\t\tAND b.cf_2963='{this[\"SeriesTitle\"]}'\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{smowner}'='' THEN a.smownerid=(SELECT id FROM ld_users ORDER BY CONVERT(last_name USING GBK) LIMIT 1)\r\n\t\t\t\tELSE a.smownerid='{smowner}'\r\n\t\t\tEND)\r\n) b ON b.smownerid=a.id\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\ta.smownerid,\r\n\t\t'潜力值' type,\r\n\t\tSUM(a.total/IFNULL(a.conversion_rate,1)) AS total\r\n\tFROM ld_servicecontracts a\r\n\tLEFT JOIN ld_account b ON b.accountid=a.accountid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND b.cf_2963 IN ('3级','4级','5级')\r\n\t\tAND b.cf_2963='{this[\"SeriesTitle\"]}'\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{smowner}'='' THEN a.smownerid=(SELECT id FROM ld_users ORDER BY CONVERT(last_name USING GBK) LIMIT 1)\r\n\t\t\t\tELSE a.smownerid='{smowner}'\r\n\t\t\tEND)\r\n) c ON c.smownerid=a.id\r\nWHERE 1=1\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{smowner}'='' THEN a.id=(SELECT id FROM ld_users ORDER BY CONVERT(last_name USING GBK) LIMIT 1)\r\n\t\t\tELSE a.id='{smowner}'\r\n\t\tEND)"
      },
      "13": {
        "Ident": "StiMySqlSource",
        "Name": "d2",
        "Alias": "d2",
        "Columns": {
          "0": {
            "Name": "billid",
            "Index": -1,
            "NameInSource": "billid",
            "Alias": "billid",
            "Type": "System.Int32"
          },
          "1": {
            "Name": "billno",
            "Index": -1,
            "NameInSource": "billno",
            "Alias": "billno",
            "Type": "System.String"
          },
          "2": {
            "Name": "smownerid",
            "Index": -1,
            "NameInSource": "smownerid",
            "Alias": "smownerid",
            "Type": "System.Int32"
          },
          "3": {
            "Name": "total",
            "Index": -1,
            "NameInSource": "total",
            "Alias": "total",
            "Type": "System.Decimal"
          }
        },
        "NameInSource": "crm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\ta.smownerid,\r\n\ta.salesorderid AS billid,\r\n\ta.salesorder_no AS billno,\r\n\ta.total/IFNULL(a.conversion_rate,1) AS total\r\nFROM ld_salesorder a\r\nLEFT JOIN ld_account b ON b.accountid=a.accountid\r\nWHERE a.deleted=0\r\n\tAND a.approvestatus<>'已拒绝'\r\n\tAND b.cf_2963 IN ('3级','4级','5级')\r\n\tAND b.cf_2963='{this[\"mylevel\"]}'\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{smowner}'='' THEN a.smownerid=(SELECT id FROM ld_users ORDER BY CONVERT(last_name USING GBK) LIMIT 1)\r\n\t\t\tELSE a.smownerid='{smowner}'\r\n\t\tEND)\r\n\tAND '当前值'='{this[\"this_type\"]}'\r\nUNION\r\nSELECT\r\n\ta.smownerid,\r\n\ta.servicecontractsid AS billid,\r\n\ta.contract_no AS billno,\r\n\ta.total/IFNULL(a.conversion_rate,1) AS total\r\nFROM ld_servicecontracts a\r\nLEFT JOIN ld_account b ON b.accountid=a.accountid\r\nWHERE a.deleted=0\r\n\tAND a.approvestatus<>'已拒绝'\r\n\tAND b.cf_2963 IN ('3级','4级','5级')\r\n\tAND b.cf_2963='{this[\"mylevel\"]}'\r\n\tAND '潜力值'='{this[\"this_type\"]}'\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{smowner}'='' THEN a.smownerid=(SELECT id FROM ld_users ORDER BY CONVERT(last_name USING GBK) LIMIT 1)\r\n\t\t\tELSE a.smownerid='{smowner}'\r\n\t\tEND)\r\n\r\n\r\n"
      }
    },
