          },
          "4": {
            "Name": "keypoint",
            "Index": -1,
            "NameInSource": "keypoint",
            "Alias": "keypoint",
            "Type": "System.String"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\tquotes.quoteid AS billid,\r\n\tquotes.quote_no AS billno,\r\n\tDATE_FORMAT(quotes.time,'%Y-%m-%d %H:%i:%s') time,\r\n\tquotes.version,\r\n\tquotes.keypoint\r\nFROM sequence \r\nLEFT JOIN (\r\n\tSELECT\r\n\t\ta.quoteid,\r\n\t\ta.quote_no,\r\n\t\tb.cf_2988 AS time,\r\n\t\tb.cf_2989 AS version,\r\n\t\tb.cf_2987 AS keypoint,\r\n\t\t(\r\n\t\t\tSELECT\r\n\t\t\t\tCOUNT(o.quoteid)\r\n\t\t\tFROM ld_quotes o\r\n\t\t\tLEFT JOIN ld_quotescf p ON o.quoteid=p.quoteid\r\n\t\t\tWHERE o.deleted=0\r\n\t\t\t\tAND o.approvestatus<>'已拒绝'\r\n\t\t\t\tAND o.quotestage='在途'\r\n\t\t\t\tAND o.createdtime>=a.createdtime AND o.quoteid>=a.quoteid\r\n\t\t) AS seq\r\n\tFROM ld_quotes a\r\n\tLEFT JOIN ld_quotescf b ON b.quoteid=a.quoteid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND a.quotestage='在途'\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{smowner}'='' THEN a.smownerid=(SELECT id FROM ld_users ORDER BY CONVERT(last_name USING GBK) LIMIT 1)\r\n\t\t\t\tELSE a.smownerid='{smowner}'\r\n\t\t\tEND)\r\n\tORDER BY a.createdtime DESC,a.quoteid DESC LIMIT 3\r\n) quotes ON quotes.seq=sequence.seq\r\nWHERE sequence.seq BETWEEN 1 AND 3"
      },
      "5": {
        "Ident": "StiMySqlSource",
        "Name": "t3",
