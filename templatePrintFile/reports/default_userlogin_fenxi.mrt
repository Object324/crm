        "Value": "DateSerial(Year(Today),Month(Today),Day(Today)-Switch(DayOfWeek(Today)==\"星期一\",0,DayOfWeek(Today)==\"星期二\",1,DayOfWeek(Today)==\"星期三\",2,DayOfWeek(Today)==\"星期四\",3,DayOfWeek(Today)==\"星期五\",4,DayOfWeek(Today)==\"星期六\",5,DayOfWeek(Today)==\"星期日\",6))",
        "Name": "start_date",
        "Alias": "起始日期",
