    "DataSources": {
      "0": {
        "Ident": "StiMySqlSource",
        "Name": "a",
        "Alias": "a",
        "Columns": {
          "0": {
            "Name": "all_cnt",
            "Index": -1,
            "NameInSource": "all_cnt",
            "Alias": "all_cnt",
            "Type": "System.Object"
          },
          "1": {
            "Name": "groupname",
            "Index": -1,
            "NameInSource": "groupname",
            "Alias": "groupname",
            "Type": "System.String"
          },
          "2": {
            "Name": "last_name",
            "Index": -1,
            "NameInSource": "last_name",
            "Alias": "last_name",
            "Type": "System.String"
          },
          "3": {
            "Name": "searchtype",
            "Index": -1,
            "NameInSource": "searchtype",
            "Alias": "searchtype",
            "Type": "System.Object"
          },
          "4": {
            "Name": "wx_cnt",
            "Index": -1,
            "NameInSource": "wx_cnt",
            "Alias": "wx_cnt",
            "Type": "System.Object"
          }
        },
        "NameInSource": "crm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\tg.groupname,\r\n\ta.last_name,\r\n\tb.all_cnt,\r\n\tb.wx_cnt,\r\n\tCASE \r\n\t\tWHEN '{jctype}'='统计未使用成员' THEN 1\r\n\t\tELSE 0\r\n\tEND AS searchtype\r\nFROM ld_users a\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\tuser_name,\r\n\t\tSUM(all_cnt) AS all_cnt,\r\n\t\tSUM(wx_cnt) AS wx_cnt\r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\tuser_name,\r\n\t\t\t1 AS all_cnt,\r\n\t\t\tMAX(CASE\r\n\t\t\t\tWHEN login_type='qiyeweixin' THEN 1\r\n\t\t\t\tELSE 0\r\n\t\t\tEND) AS wx_cnt\r\n\t\tFROM ld_loginhistory \r\n\t\tWHERE login_time BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d 00:00:00') AND DATE_FORMAT('{end_date}','%Y-%m-%d 23:59:59')\r\n\t\tGROUP BY user_name,DATE_FORMAT(login_time,'%Y-%m-%d')\r\n\t) a\r\n\tGROUP BY user_name\r\n) b ON b.user_name=a.user_name\r\nINNER JOIN (\r\n\tSELECT\r\n\t\ta.userid,\r\n\t\tGROUP_CONCAT(b.groupname ORDER BY b.depth) AS groupname,\r\n\t\tMIN(b.depth) AS depth\r\n\tFROM ld_users2group a\r\n\tLEFT JOIN ld_groups b ON b.groupid=a.groupid\r\n\tWHERE 1=1\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN TRIM('{department}')='' THEN 1=1\r\n\t\t\t\tELSE FIND_IN_SET(a.groupid,'{department}')\r\n\t\t\tEND)\r\n\tGROUP BY a.userid\r\n) g ON g.userid=a.id\r\nWHERE a.deleted=0\r\n\tAND a.status='Active'\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{jctype}'='统计未使用成员' THEN \r\n\t\t\t\t\ta.user_name NOT IN (\r\n\t\t\t\t\t\tSELECT DISTINCT\r\n\t\t\t\t\t\t\tuser_name\r\n\t\t\t\t\t\tFROM ld_loginhistory\r\n\t\t\t\t\t\tWHERE login_time BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d 00:00:00') AND DATE_FORMAT('{end_date}','%Y-%m-%d 23:59:59')\r\n\t\t\t\t\t)\r\n\t\t\tELSE b.all_cnt>0\r\n\t\tEND)\r\nORDER BY b.all_cnt,g.depth,CONVERT(g.groupname USING GBK),CONVERT(a.last_name USING GBK)"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "list_group",
        "Alias": "list_group",
        "Columns": {
          "0": {
            "Name": "groupid",
            "Index": -1,
            "NameInSource": "groupid",
            "Alias": "groupid",
            "Type": "System.Int32"
          },
          "1": {
            "Name": "groupname",
            "Index": -1,
            "NameInSource": "groupname",
            "Alias": "groupname",
            "Type": "System.String"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "(SELECT\r\n\ta.groupid,\r\n\tIFNULL(a.groupname,'') AS groupname\r\nFROM (\r\n\tSELECT \r\n\t\ta.groupid, \r\n\t\ta.groupname, \r\n\t\tLPAD(substring_index(substring_index(a.splitsting,',',b.seq+1),',',-1),8,'0') AS splitsting\r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\ta.groupid,\r\n\t\t\ta.groupname, \r\n\t\t\tREPLACE(a.parentgroup,'::',',') AS splitsting \r\n\t\tFROM ld_groups a\r\n\t\tLEFT JOIN ld_users2group b ON b.groupid=a.groupid\r\n\t\tGROUP BY a.groupid\r\n\t) a \r\n\tLEFT JOIN sequence b ON b.seq < (length(a.splitsting) - length(replace(a.splitsting,',',''))+1)\r\n) a\r\nGROUP BY a.groupid\r\nORDER BY GROUP_CONCAT(IFNULL(a.splitsting,'') ORDER BY a.splitsting SEPARATOR '::'))"
      }
    },
    "Databases": {
      "0": {
