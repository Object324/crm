    "DataSources": {
      "0": {
        "Ident": "StiMySqlSource",
        "Name": "b",
        "Alias": "b",
        "Columns": {
          "0": {
            "Name": "accountid",
            "Index": -1,
            "NameInSource": "accountid",
            "Alias": "accountid",
            "Type": "System.Int32"
          },
          "1": {
            "Name": "accountname",
            "Index": -1,
            "NameInSource": "accountname",
            "Alias": "accountname",
            "Type": "System.String"
          },
          "2": {
            "Name": "due_date",
            "Index": -1,
            "NameInSource": "due_date",
            "Alias": "due_date",
            "Type": "System.DateTime"
          },
          "3": {
            "Name": "hf_qty",
            "Index": -1,
            "NameInSource": "hf_qty",
            "Alias": "hf_qty",
            "Type": "System.Decimal"
          },
          "4": {
            "Name": "lastservicedate",
            "Index": -1,
            "NameInSource": "lastservicedate",
            "Alias": "lastservicedate",
            "Type": "System.DateTime"
          },
          "5": {
            "Name": "rating",
            "Index": -1,
            "NameInSource": "rating",
            "Alias": "rating",
            "Type": "System.String"
          },
          "6": {
            "Name": "sm_qty",
            "Index": -1,
            "NameInSource": "sm_qty",
            "Alias": "sm_qty",
            "Type": "System.Decimal"
          },
          "7": {
            "Name": "total",
            "Index": -1,
            "NameInSource": "total",
            "Alias": "total",
            "Type": "System.Decimal"
          },
          "8": {
            "Name": "yc_qty",
            "Index": -1,
            "NameInSource": "yc_qty",
            "Alias": "yc_qty",
            "Type": "System.Decimal"
          }
        },
        "NameInSource": "crm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\ta.accountid,\r\n\ta.accountname,\r\n\ta.rating,\r\n\tb.due_date,\r\n\tb.total,\r\n\ta.lastservicedate,\r\n\tIFNULL(c.yc_qty,0) AS yc_qty,\r\n\tIFNULL(c.hf_qty,0) AS hf_qty,\r\n\tIFNULL(c.sm_qty,0) AS sm_qty\r\nFROM ld_account a\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\taccountid,\r\n\t\tdue_date,\r\n\t\ttotal\r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\taccountid,\r\n\t\t\tdue_date,\r\n\t\t\ttotal/IFNULL(conversion_rate,1) AS total\r\n\t\tFROM ld_servicecontracts\r\n\t\tWHERE deleted=0\r\n\t\t\tAND approvestatus<>'已拒绝'\r\n\t\t\tAND accountid>0\r\n\t\tORDER BY accountid,due_date DESC\r\n\t) a\r\n\tGROUP BY accountid\r\n) b ON b.accountid=a.accountid\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\taccountid,\r\n\t\tSUM(yc_qty) AS yc_qty,\r\n\t\tSUM(sm_qty) AS sm_qty,\r\n\t\tSUM(hf_qty) AS hf_qty\r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\ta.accountid,\r\n\t\t\tCASE\r\n\t\t\t\tWHEN a.servicetype LIKE '%远程' THEN 1\r\n\t\t\t\tELSE 0\r\n\t\t\tEND AS yc_qty,\r\n\t\t\tCASE\r\n\t\t\t\tWHEN a.servicetype LIKE '上门%' THEN 1\r\n\t\t\t\tELSE 0\r\n\t\t\tEND AS sm_qty,\r\n\t\t\tCASE\r\n\t\t\t\tWHEN b.servicereturnid>0 THEN 1\r\n\t\t\t\tELSE 0\r\n\t\t\tEND AS hf_qty\r\n\t\tFROM ld_troubletickets a\r\n\t\tLEFT JOIN (\r\n\t\t\tSELECT\r\n\t\t\t\tservicereturnid,\r\n\t\t\t\ttroubleticketid\r\n\t\t\tFROM ld_servicereturn \r\n\t\t\tWHERE deleted=0\r\n\t\t\t\tAND approvestatus<>'已拒绝'\r\n\t\t\t\tAND troubleticketid>0\r\n\t\t) b ON b.troubleticketid=a.ticketid\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\tAND a.accountid>0\r\n\t\t\tAND a.createdtime BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d %H:%i:%s') AND DATE_FORMAT(DATE_ADD('{end_date}',INTERVAL 1 DAY),'%Y-%m-%d %H:%i:%s')\r\n\t) tmp\r\n\tGROUP BY accountid\r\n) c ON c.accountid=a.accountid\r\nINNER JOIN (\r\n\tSELECT DISTINCT\r\n\t\tuserid \r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\tld_users.id AS userid \r\n\t\tFROM ld_users\r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Accounts' and scopeauthority=1 AND userid='[uuid]')\r\n\t\tUNION\r\n\t\tSELECT \r\n\t\t\tviewid AS userid \r\n\t\tFROM ld_scoperhigher\r\n\t\tWHERE userid='[uuid]' AND modulename ='Accounts' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename ='Accounts')\t\t\t\r\n\t\tUNION\r\n\t\tSELECT DISTINCT \r\n\t\t\tld_users2group.userid AS userid \r\n\t\tFROM ld_scoperhigher \r\n\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\tAND ld_scoperhigher.modulename ='Accounts'\r\n\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Accounts' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\tUNION \r\n\t\tSELECT \r\n\t\t\tid AS userid \r\n\t\tFROM ld_users  \r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\tUNION\r\n\t\tSELECT '[uuid]') AS vw_users\r\n) AS tmp_users ON tmp_users.userid=a.smownerid\r\nWHERE a.deleted=0\r\n\tAND(\r\n\t\tCASE\r\n\t\t\tWHEN FIND_IN_SET(1,'{data_range}') OR '{data_range}'='' THEN 1=1\r\n\t\t\tWHEN FIND_IN_SET(2,'{data_range}') THEN a.smownerid='[uuid]'\r\n\t\t\tELSE FIND_IN_SET(a.smownerid,(\r\n\t\t\t\t\t\t\t\tSELECT\r\n\t\t\t\t\t\t\t\t\tGROUP_CONCAT(a.userid)\r\n\t\t\t\t\t\t\t\tFROM ld_users2group a\r\n\t\t\t\t\t\t\t\tINNER JOIN (\r\n\t\t\t\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\t\t\t\tsubstring_index(substring_index(a.splitsting,',',b.seq+1),',',-1)-200000 AS groupid\r\n\t\t\t\t\t\t\t\t\tFROM (SELECT '{data_range}' AS splitsting) a \r\n\t\t\t\t\t\t\t\t\tLEFT JOIN sequence b ON b.seq < (length(a.splitsting) - length(replace(a.splitsting,',',''))+1) \r\n\t\t\t\t\t\t\t\t\tWHERE substring_index(substring_index(a.splitsting,',',b.seq+1),',',-1) BETWEEN 200000 AND 300000\r\n\t\t\t\t\t\t\t\t) b ON b.groupid=a.groupid\r\n\t\t\t\t\t\t\t\tGROUP BY a.userid\r\n\t\t\t\t\t\t\t\tUNION \r\n\t\t\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\t\t\tsubstring_index(substring_index(a.splitsting,',',b.seq+1),',',-1)-300000 AS groupid\r\n\t\t\t\t\t\t\t\tFROM (SELECT '{data_range}' AS splitsting) a \r\n\t\t\t\t\t\t\t\tLEFT JOIN sequence b ON b.seq < (length(a.splitsting) - length(replace(a.splitsting,',',''))+1) \r\n\t\t\t\t\t\t\t\tWHERE substring_index(substring_index(a.splitsting,',',b.seq+1),',',-1)>300000\r\n\t\t\t\t\t\t))\r\n\t\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{khzt}'='全部' THEN 1=1\r\n\t\t\tELSE '{khzt}'=a.rating\r\n\t\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{showdata}'='全部' OR '{showdata}'='' THEN 1=1\r\n\t\t\tWHEN '{showdata}'='只统计未服务的客户' THEN IFNULL(c.yc_qty,0)+IFNULL(c.sm_qty,0)=0\r\n\t\t\tWHEN '{showdata}'='只统计已服务的客户' THEN IFNULL(c.yc_qty,0)+IFNULL(c.sm_qty,0)>0\r\n\t\t\tWHEN '{showdata}'='只统计有上门的客户' THEN IFNULL(c.sm_qty,0)>0\r\n\t\tEND)\r\nORDER BY IFNULL(c.yc_qty,0)+IFNULL(c.sm_qty,0) DESC"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "list_users",
        "Alias": "list_users",
        "Columns": {
          "0": {
            "Name": "listid",
            "Index": -1,
            "NameInSource": "listid",
            "Alias": "listid",
            "Type": "System.Int32"
          },
          "1": {
            "Name": "listvalue",
            "Index": -1,
            "NameInSource": "listvalue",
            "Alias": "listvalue",
            "Type": "System.String"
          }
        },
        "NameInSource": "crm",
        "Type": "Table",
        "SqlCommand": "SELECT 1 AS listid,'全部' AS listvalue\r\nUNION\r\nSELECT 2, '我负责的'\r\nUNION\r\n(SELECT\r\n\ta.groupid+200000,\r\n\tCONCAT('部门::',IFNULL(a.groupname,''))\r\nFROM (\r\n\tSELECT \r\n\t\ta.groupid, \r\n\t\ta.groupname, \r\n\t\tLPAD(substring_index(substring_index(a.splitsting,',',b.seq+1),',',-1),8,'0') AS splitsting\r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\ta.groupid,\r\n\t\t\ta.groupname, \r\n\t\t\tREPLACE(a.parentgroup,'::',',') AS splitsting \r\n\t\tFROM ld_groups a\r\n\t\tLEFT JOIN ld_users2group b ON b.groupid=a.groupid\r\n\t\tGROUP BY a.groupid\r\n\t) a \r\n\tLEFT JOIN sequence b ON b.seq < (length(a.splitsting) - length(replace(a.splitsting,',',''))+1)\r\n) a\r\nGROUP BY a.groupid\r\nORDER BY GROUP_CONCAT(IFNULL(a.splitsting,'') ORDER BY a.splitsting SEPARATOR '::'))\r\nUNION \r\n(SELECT\r\n\ta.id+300000,\r\n\tCONCAT('用户::',IFNULL(a.last_name,''))\r\nFROM ld_users a\r\nINNER JOIN (\r\n\tSELECT DISTINCT\r\n\t\tuserid \r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\tld_users.id AS userid \r\n\t\tFROM ld_users\r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Accounts' and scopeauthority=1 AND userid='[uuid]')\r\n\t\tUNION\r\n\t\tSELECT \r\n\t\t\tviewid AS userid \r\n\t\tFROM ld_scoperhigher\r\n\t\tWHERE userid='[uuid]' AND modulename ='Accounts' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename ='Accounts')\t\t\t\r\n\t\tUNION\r\n\t\tSELECT DISTINCT \r\n\t\t\tld_users2group.userid AS userid \r\n\t\tFROM ld_scoperhigher \r\n\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\tAND ld_scoperhigher.modulename ='Accounts'\r\n\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Accounts' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\tUNION \r\n\t\tSELECT \r\n\t\t\tid AS userid \r\n\t\tFROM ld_users  \r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\tUNION\r\n\t\tSELECT '[uuid]') AS vw_users\r\n) AS tmp_users ON tmp_users.userid=a.id\r\nWHERE a.deleted=0\r\n\tAND a.`status`='Active'\r\nORDER BY CONVERT(a.last_name USING gbk))"
      },
      "2": {
        "Ident": "StiMySqlSource",
        "Name": "list_rating",
        "Alias": "list_rating",
        "Columns": {
          "0": {
            "Name": "listvalue",
            "Index": -1,
            "NameInSource": "listvalue",
            "Alias": "listvalue",
            "Type": "System.String"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT '全部' AS listvalue\r\nUNION\r\n(SELECT\r\n\tb.listvalue\r\nFROM ld_picklist_set a\r\nLEFT JOIN ld_picklist_values b ON b.listid=a.listid\r\nWHERE a.listname='rating'\r\nORDER BY b.sequence)"
      }
    },
    "Databases": {
