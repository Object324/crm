            "Alias": "setype",
            "Type": "System.String"
          },
          "5": {
            "Name": "accountname",
            "Index": -1,
            "NameInSource": "accountname",
            "Alias": "accountname",
            "Type": "System.String"
          },
          "6": {
            "Name": "lastname",
            "Index": -1,
