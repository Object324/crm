            "Alias": "lastname",
            "Type": "System.String"
          },
          "7": {
            "Name": "Subject",
            "Index": -1,
            "NameInSource": "Subject",
            "Alias": "Subject",
            "Type": "System.String"
          },
          "8": {
            "Name": "ticket_no",
            "Index": -1,
            "NameInSource": "ticket_no",
            "Alias": "ticket_no",
            "Type": "System.String"
          },
          "9": {
            "Name": "vendorname",
            "Index": -1,
            "NameInSource": "vendorname",
            "Alias": "vendorname",
            "Type": "System.String"
          },
          "10": {
            "Name": "vendor_lastname",
            "Index": -1,
            "NameInSource": "vendor_lastname",
            "Alias": "vendor_lastname",
            "Type": "System.String"
          },
          "11": {
            "Name": "vendor_subject",
            "Index": -1,
            "NameInSource": "vendor_subject",
            "Alias": "vendor_subject",
            "Type": "System.String"
          },
          "12": {
            "Name": "calltype",
            "Index": -1,
            "NameInSource": "calltype",
            "Alias": "calltype",
            "Type": "System.String"
          },
          "13": {
            "Name": "callnum",
            "Index": -1,
            "NameInSource": "callnum",
            "Alias": "callnum",
            "Type": "System.String"
          },
          "14": {
            "Name": "Talktime",
            "Index": -1,
            "NameInSource": "Talktime",
            "Alias": "Talktime",
            "Type": "System.Int32"
          },
          "15": {
            "Name": "mp3path",
            "Index": -1,
            "NameInSource": "mp3path",
            "Alias": "mp3path",
            "Type": "System.String"
          }
        },
        "NameInSource": "Connection1",
        "SqlCommand": "SELECT\r\n\tj.last_name,\r\n\ta.usernum,\r\n\ta.Starttime, \r\n\ta.indexid, \r\n\tld_crmentity.setype, \r\n\tCASE \r\n\tWHEN ld_crmentity.setype='Accounts' THEN b.accountname \r\n\tWHEN ld_crmentity.setype='Contacts' THEN (SELECT accountname FROM ld_account WHERE accountid=c.accountid) \r\n\tWHEN ld_crmentity.setype='ContactRecords' THEN (SELECT accountname FROM ld_account WHERE accountid=d.accountid) \r\n\tWHEN ld_crmentity.setype='HelpDesk' THEN (SELECT accountname FROM ld_account WHERE accountid=e.accountid) \r\n\tElSE '' \r\n\tEND AS accountname, \r\n\tCASE \r\n\tWHEN ld_crmentity.setype='Contacts' THEN c.lastname \r\n\tWHEN ld_crmentity.setype='ContactRecords' THEN (SELECT lastname FROM ld_contactdetails WHERE contactid=d.contactid) \r\n\tWHEN ld_crmentity.setype='HelpDesk' THEN (SELECT lastname FROM ld_contactdetails WHERE contactid=e.contactid) \r\n\tEND AS lastname, \r\n\td.contactrecord_no AS `Subject`, \r\n\te.ticket_no, \r\n\tf.vendorname, \r\n\tg.Lastname AS vendor_lastname, \r\n\th.contactrecord_no AS vendor_subject,\r\n\tCASE \r\n\t\tWHEN a.type=1 THEN '去电'\r\n\t\tELSE '来电'\r\n\tEND AS calltype,\r\n\tCASE\r\n\t\tWHEN a.type=1 THEN a.callee\r\n\t\tELSE a.caller\r\n\tEND AS callnum,\t\r\n\ta.Talktime,\r\n\tCONCAT('recordings/',recordnum) as mp3path\r\nFROM ld_hantian_phonerecord a \r\nLEFT JOIN ld_crmentity ON ld_crmentity.crmid=a.indexid \r\nLEFT JOIN ld_account b ON b.accountid=a.indexid AND b.deleted=0\r\nLEFT JOIN ld_contactdetails c ON c.contactid=a.indexid  AND c.deleted=0\r\nLEFT JOIN ld_contactrecords d ON d.contactrecordID=a.indexid  AND d.deleted=0\r\nLEFT JOIN ld_troubletickets e ON e.ticketid=a.indexid  AND e.deleted=0\r\nLEFT JOIN ld_vendor f ON f.vendorid=a.indexid  AND f.deleted=0\r\nLEFT JOIN ld_vendorcontacts g ON g.vendorcontactsid=a.indexid  AND g.deleted=0\r\nLEFT JOIN ld_vendorcontactrecords h ON h.contactRecordsid=a.indexid AND h.deleted=0\r\nLEFT JOIN ld_users j on j.id=a.userid\r\nWHERE a.usernum='{this[\"userid\"]}'\r\n\tAND date_format(starttime,'%Y-%m-%d') BETWEEN DATE_FORMAT('{begindate}','%Y-%m-%d') AND DATE_FORMAT('{enddate}','%Y-%m-%d')\r\n\tAND(\r\n\t\t\tCASE \r\n\t\t\t\tWHEN '{this[\"type\"]}'!='3' THEN a.type='{this[\"type\"]}'\r\n\t\t\t\tELSE 1=1 \r\n\t\tEND)"
      }
    },
