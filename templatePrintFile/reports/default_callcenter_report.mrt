    "DataSources": {
      "0": {
        "Ident": "StiMySqlSource",
        "Name": "users",
        "Alias": "users",
        "Columns": {
          "0": {
            "Name": "id",
            "Index": -1,
            "NameInSource": "id",
            "Alias": "id",
            "Type": "System.Int32"
          },
          "1": {
            "Name": "last_name",
            "Index": -1,
            "NameInSource": "last_name",
            "Alias": "last_name",
            "Type": "System.String"
          }
        },
        "NameInSource": "Connection1",
        "SqlCommand": "SELECT\r\n\ta.id,\r\n\ta.last_name\r\nFROM ld_users a\r\nINNER JOIN (\r\n\tSELECT DISTINCT\r\n\t\tuserid \r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\tld_users.id as userid \r\n\t\tFROM ld_users\r\n\t\tWHERE EXISTS(select 1 from ld_setscoperhigher where modulename='ReportAnalysis' and scopeauthority=1 and userid='[uuid]')\r\n\t\tUNION\r\n\t\tselect \r\n\t\t\tviewid as userid \r\n\t\tfrom ld_scoperhigher\r\n\t\twhere userid='[uuid]' and modulename='ReportAnalysis' and EXISTS(select 1 from ld_setscoperhigher where userid='[uuid]' and scopeauthority=2 and modulename='ReportAnalysis')\t\t\t\r\n\t\tUNION\r\n\t\tselect DISTINCT \r\n\t\t\tld_users2group.userid as userid \r\n\t\tfrom ld_scoperhigher \r\n\t\tINNER JOIN ld_groups on ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\tINNER JOIN ld_users2group on ld_users2group.groupid=ld_groups.groupid\r\n\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\tand ld_scoperhigher.modulename='ReportAnalysis'\r\n\t\t\tand ld_scoperhigher.scopeauthority=3 \r\n\t\t\tand EXISTS(select 1 from ld_setscoperhigher where modulename='ReportAnalysis' and scopeauthority=3 and userid='[uuid]')\r\n\t\tUNION \r\n\t\tselect \r\n\t\t\tid as userid \r\n\t\tfrom ld_users  \r\n\t\twhere exists(select 1 from ld_users where id='[uuid]' and is_admin='on')\r\n\t\tUNION\r\n\t\tselect '[uuid]')as vw_users\r\n) as tmp_users ON tmp_users.userid=a.id\r\norder by CONVERT(a.last_name USING gbk)"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "Period",
        "Alias": "Period",
        "Columns": {
          "0": {
            "Name": "Period",
            "Index": -1,
            "NameInSource": "Period",
            "Alias": "Period",
            "Type": "System.String"
          }
        },
        "NameInSource": "Connection1",
        "SqlCommand": "SELECT '全部' as Period\r\nUNION \r\nselect'本年' \r\nUNION \r\nselect'本月'\r\nUNION \r\nselect'本周'\r\nUNION \r\nselect'今天'\r\nUNION \r\nselect'去年'\r\nUNION \r\nselect'去年' \r\nUNION \r\nselect'上月'\r\nUNION \r\nselect'上周'\r\nUNION \r\nselect'昨天'"
      },
      "2": {
        "Ident": "StiMySqlSource",
        "Name": "selectdata",
        "Alias": "selectdata",
        "Columns": {
          "0": {
            "Name": "id",
            "Index": -1,
            "NameInSource": "id",
            "Alias": "id",
            "Type": "System.String"
          },
          "1": {
            "Name": "last_name",
            "Index": -1,
            "NameInSource": "last_name",
            "Alias": "last_name",
            "Type": "System.String"
          },
          "2": {
            "Name": "total",
            "Index": -1,
            "NameInSource": "total",
            "Alias": "total",
            "Type": "System.Object"
          },
          "3": {
            "Name": "countlaidian",
            "Index": -1,
            "NameInSource": "countlaidian",
            "Alias": "countlaidian",
            "Type": "System.Object"
          },
          "4": {
            "Name": "countqudian",
            "Index": -1,
            "NameInSource": "countqudian",
            "Alias": "countqudian",
            "Type": "System.Object"
          }
        },
        "NameInSource": "Connection1",
        "SqlCommand": "SELECT\r\n\tid,\r\n\tCASE\r\n\t\tWHEN LEFT(last_name,2)='//' THEN RIGHT(last_name,CHAR_LENGTH(last_name)-2)\r\n\t\tELSE last_name\r\n\tEND AS last_name,\r\n\ttotal,\r\n\tcountlaidian,\r\n\tcountqudian\r\nFROM (\r\n\tSELECT\r\n\t\tid,\r\n\t\tGROUP_CONCAT(DISTINCT IFNULL(last_name,'') ORDER BY CONVERT(IFNULL(last_name,'') USING GBK) SEPARATOR '//') AS last_name,\r\n\t\tIFNULL(sum(laidian),0)+IFNULL(sum(qudian),0) AS total,\r\n\t\tIFNULL(sum(laidian),0) as countlaidian,\r\n\t\tIFNULL(sum(qudian),0) as countqudian\r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\tb.usernum AS id,\r\n\t\t\tIFNULL(b.userid,0) AS userid,\r\n\t\t\ta.last_name,\r\n\t\t\ta.`status`,\r\n\t\t\tb.type,\r\n\t\t\tb.starttime,\r\n\t\t\tCASE\r\n\t\t\t\tWHEN b.type=2 THEN 1 \r\n\t\t\t\tELSE 0\r\n\t\t\tEND AS laidian,\r\n\t\t\tCASE\r\n\t\t\t\tWHEN b.type=1 THEN 1 \r\n\t\t\t\tELSE 0\r\n\t\t\tEND AS qudian\r\n\t\tFROM ld_hantian_phonerecord b\r\n\t\tLEFT JOIN ld_users a ON a.id=b.userid\r\n\t) t\r\n\tWHERE IFNULL(`status`,'')<>'Inactive'\r\n\t\tAND date_format(starttime,'%Y-%m-%d') BETWEEN DATE_FORMAT('{begindate}','%Y-%m-%d') AND DATE_FORMAT('{enddate}','%Y-%m-%d')\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{iszero}'='false' THEN laidian+qudian>0\r\n\t\t\t\tELSE 1=1\r\n\t\t\tEND)\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{userid}'='' THEN \r\n\t\t\t\t\tFIND_IN_SET(userid,(\r\n\t\t\t\t\t\tSELECT\r\n\t\t\t\t\t\t\tGROUP_CONCAT(userid)\r\n\t\t\t\t\t\tFROM (\r\n\t\t\t\t\t\t\tSELECT DISTINCT\r\n\t\t\t\t\t\t\t\tuserid \r\n\t\t\t\t\t\t\tFROM (\r\n\t\t\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\t\t\tld_users.id as userid \r\n\t\t\t\t\t\t\t\tFROM ld_users\r\n\t\t\t\t\t\t\t\tWHERE EXISTS(select 1 from ld_setscoperhigher where modulename='ReportAnalysis' and scopeauthority=1 and userid='[uuid]')\r\n\t\t\t\t\t\t\t\tUNION\r\n\t\t\t\t\t\t\t\tselect \r\n\t\t\t\t\t\t\t\t\tviewid as userid \r\n\t\t\t\t\t\t\t\tfrom ld_scoperhigher\r\n\t\t\t\t\t\t\t\twhere userid='[uuid]' and modulename='ReportAnalysis' and EXISTS(select 1 from ld_setscoperhigher where userid='[uuid]' and scopeauthority=2 and modulename='ReportAnalysis')\t\t\t\r\n\t\t\t\t\t\t\t\tUNION\r\n\t\t\t\t\t\t\t\tselect DISTINCT \r\n\t\t\t\t\t\t\t\t\tld_users2group.userid as userid \r\n\t\t\t\t\t\t\t\tfrom ld_scoperhigher \r\n\t\t\t\t\t\t\t\tINNER JOIN ld_groups on ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\t\t\t\t\t\tINNER JOIN ld_users2group on ld_users2group.groupid=ld_groups.groupid\r\n\t\t\t\t\t\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\t\t\t\t\t\tand ld_scoperhigher.modulename='ReportAnalysis'\r\n\t\t\t\t\t\t\t\t\tand ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\t\t\t\t\t\tand EXISTS(select 1 from ld_setscoperhigher where modulename='ReportAnalysis' and scopeauthority=3 and userid='[uuid]')\r\n\t\t\t\t\t\t\t\tUNION \r\n\t\t\t\t\t\t\t\tselect \r\n\t\t\t\t\t\t\t\t\tid as userid \r\n\t\t\t\t\t\t\t\tfrom ld_users  \r\n\t\t\t\t\t\t\t\twhere exists(select 1 from ld_users where id='[uuid]' and is_admin='on')\r\n\t\t\t\t\t\t\t\tUNION\r\n\t\t\t\t\t\t\t\tselect '[uuid]')as vw_users\r\n\t\t\t\t\t\t) as tmp_users)) OR userid=0\r\n\t\t\t\tELSE FIND_IN_SET(userid,'{userid}') OR userid=0\r\n\t\t\tEND)\r\n\tGROUP BY id\r\n) a\r\nORDER BY id"
      },
      "3": {
        "Ident": "StiMySqlSource",
        "Name": "detail1",
        "Alias": "detail1",
        "Columns": {
          "0": {
            "Name": "last_name",
