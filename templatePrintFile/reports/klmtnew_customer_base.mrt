            "NameInSource": "maintenance_enddate",
            "Alias": "maintenance_enddate",
            "Type": "System.DateTime"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\ta.productid,\r\n\ta.productname,\r\n\tb.vendor_no,\r\n\ta.productcategory,\r\n\tcf.cf_2190 AS area,\r\n\ta.business_contract,\r\n\td.accountname AS user_name,\r\n\tc.bill_street AS user_address,\r\n\tc.accountname AS real_account,\r\n\te.real_lianxiren,\r\n\te.real_lianxiphone,\r\n\te.real_lianximobile,\r\n\ta.sales_person,\r\n\r\n\ta.unit_module,\r\n\ta.produce_date,\r\n\tf.sendtime,\r\n\ta.debug_date,\r\n\ta.maintenance_clause,\r\n\ta.guarantee_enddate,\r\n\tCASE\r\n\t\tWHEN IFNULL(guarantee_enddate,'')='' THEN ''\r\n\t\tWHEN guarantee_enddate>=CURDATE() THEN '保内'\r\n\t\tWHEN guarantee_enddate<CURDATE() THEN '保外'\r\n\tEND AS guarantee_type,\r\n\ta.maintenance_type,\r\n\ta.maintenance_enddate\r\nFROM ld_products a\r\nLEFT JOIN ld_vendor b ON b.vendorid=a.vendorid\r\nLEFT JOIN ld_account c ON c.accountid=a.realaccountid\r\nLEFT JOIN ld_accountscf cf ON cf.accountid=c.accountid\r\nLEFT JOIN ld_account d ON d.accountid=c.parentid\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\taccountid,\r\n\t\tGROUP_CONCAT(lastname ORDER BY reference DESC,contactid SEPARATOR '\r\n') AS real_lianxiren,\r\n\t\tGROUP_CONCAT(IFNULL(phone,'-') ORDER BY reference DESC,contactid SEPARATOR '\r\n') AS real_lianxiphone,\r\n\t\tGROUP_CONCAT(IFNULL(mobile,'-') ORDER BY reference DESC,contactid SEPARATOR '\r\n') AS real_lianximobile\r\n\tFROM ld_contactdetails\r\n\tWHERE deleted=0\r\n\t\tAND accountid>0\r\n\tGROUP BY accountid\r\n) e ON e.accountid=a.realaccountid\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\ta.product_id,\r\n\t\tMIN(b.sendtime) AS sendtime\r\n\tFROM ld_potential a\r\n\tLEFT JOIN ld_troubletickets b ON a.potentialid=b.potentialid AND b.deleted=0\r\n\tLEFT JOIN ld_ticketcf c ON c.ticketid=b.ticketid \r\n\tWHERE a.deleted=0\r\n\t\tAND c.cf_2391='调试'\r\n\t\tAND a.product_id>0\r\n\tGROUP BY a.product_id\r\n) f ON f.product_id=a.productid\r\nWHERE a.deleted=0\r\n\tAND a.realaccountid>0\r\n\tAND IFNULL(a.productcategory,'') NOT IN ('备件','赠品')\r\n\tAND DATE_FORMAT(a.createdtime,'%Y-%m-%d') \r\n\r\nBETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\r\n\r\nand DATE_FORMAT(a.guarantee_enddate,'%Y-%m-%d') \r\nBETWEEN DATE_FORMAT('{baoxiustart_date}','%Y-%m-%d') AND DATE_FORMAT('{baoxiuend_date}','%Y-%m-%d')\r\n\r\n\r\n\r\n\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{itemtype}'='' THEN 1=1\r\n\t\t\tELSE FIND_IN_SET(a.productcategory,'{itemtype}')\r\n\t\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{quyu}'='' THEN 1=1\r\n\t\t\tELSE FIND_IN_SET(cf.cf_2190,'{quyu}')\r\n\t\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{vendor_no}'='' THEN 1=1\r\n\t\t\tELSE FIND_IN_SET(b.vendor_no,'{vendor_no}')\r\n\t\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{accname}'='' THEN 1=1\r\n\t\t\tELSE LOCATE('{accname}',c.accountname)\r\n\t\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{sales_man}'='' THEN 1=1\r\n\t\t\tELSE LOCATE('{sales_man}',a.sales_person)\r\n\t\tEND)"
      }
    },
