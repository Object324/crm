            "Name": "p190t",
            "Index": -1,
            "NameInSource": "p190t",
            "Alias": "p190t",
            "Type": "System.String"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "CALL pw_east2F('{color_type}','[uuid]')"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "c",
        "Alias": "c",
        "Columns": {
          "0": {
            "Name": "color_tip",
            "Index": -1,
            "NameInSource": "color_tip",
            "Alias": "color_tip",
            "Type": "System.String"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\tCASE\r\n\t\tWHEN '{color_type}'=1 THEN 'https://xx.dongmaoguoji.cn/crm/templatePrintFile/reports/pw_color1.png'\r\n\t\tELSE 'https://xx.dongmaoguoji.cn/crm/templatePrintFile/reports/pw_color2.png'\r\n\tEND AS color_tip"
      },
      "2": {
        "Ident": "StiMySqlSource",
        "Name": "list_color",
        "Alias": "list_color",
        "Columns": {
          "0": {
            "Name": "listid",
            "Index": -1,
            "NameInSource": "listid",
            "Alias": "listid",
            "Type": "System.Int32"
          },
          "1": {
            "Name": "listvalue",
            "Index": -1,
            "NameInSource": "listvalue",
            "Alias": "listvalue",
            "Type": "System.String"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT 1 AS listid,'铺位状态' AS listvalue\r\nUNION\r\nSELECT 2 AS listid,'基准单价' AS listvalue"
      }
    },
