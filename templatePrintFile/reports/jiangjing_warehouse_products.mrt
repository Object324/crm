    <DataSources count="7" isList="true">
      <columnname type="Stimulsoft.Report.Dictionary.StiMySqlSource" isKey="true" Ref="3">
        <Alias>columnname</Alias>
        <Columns count="5" isList="true">
          <value>productname,System.String</value>
          <value>product_no,System.String</value>
          <value>productsheet,System.String</value>
          <value>anniu_name,System.String</value>
          <value>anniu_tips,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1"/>
        <Name>columnname</Name>
        <NameInSource>ldcrm</NameInSource>
        <Parameters count="0" isList="true"/>
        <SqlCommand>SELECT
	(SELECT 
		b.fieldlabel
	FROM ld_field a
	LEFT JOIN ld_tranlabel b ON a.fieldid=b.Relateid AND b.trantable='ld_field' AND b.languagetype='zh'
	WHERE a.tabid=14 and columnname='productname' limit 1) AS productname,
	(SELECT 
		b.fieldlabel
	FROM ld_field a
	LEFT JOIN ld_tranlabel b ON a.fieldid=b.Relateid AND b.trantable='ld_field' AND b.languagetype='zh'
	WHERE a.tabid=14 and columnname='product_no' limit 1) AS product_no,
	(SELECT 
		b.fieldlabel
	FROM ld_field a
	LEFT JOIN ld_tranlabel b ON a.fieldid=b.Relateid AND b.trantable='ld_field' AND b.languagetype='zh'
	WHERE a.tabid=14 and columnname='productsheet' limit 1) AS productsheet,
	(SELECT 
		CONCAT('创建',fieldlabel)
	FROM ld_tranlabel 
	WHERE trantable='ld_tab' AND tabid=21 and Relateid=21 AND languagetype='zh' limit 1) AS anniu_name,
	(SELECT 
		CONCAT('为安全库存差额小于0的产品创建',fieldlabel)
	FROM ld_tranlabel 
	WHERE trantable='ld_tab' AND tabid=21 and Relateid=21 AND languagetype='zh' limit 1) AS anniu_tips</SqlCommand>
      </columnname>
