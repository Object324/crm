      <report type="Stimulsoft.Report.Dictionary.StiMySqlSource" isKey="true" Ref="5">
        <Alias>report</Alias>
        <Columns count="14" isList="true">
          <value>productid,System.Int32</value>
          <value>productname,System.String</value>
          <value>product_no,System.String</value>
          <value>productsheet,System.String</value>
          <value>qty,System.Decimal</value>
          <value>qtyearly,System.Decimal</value>
          <value>IFNULL_x0028_b_x002E_qty_locked_x002C_0_x0029_,System.Decimal</value>
          <value>IFNULL_x0028_c_x002E_qty_way_x002C_0_x0029_,System.Decimal</value>
          <value>balance_safety,System.Decimal</value>
          <value>qty_show,System.String</value>
          <value>qty_locked_show,System.String</value>
          <value>qty_way_show,System.String</value>
          <value>qtyearly_show,System.String</value>
          <value>balance_safety_show,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1"/>
        <Name>report</Name>
        <NameInSource>ldcrm</NameInSource>
        <Parameters count="0" isList="true"/>
        <SqlCommand>SELECT
	a.productid,
	a.productname,
	a.product_no,
	a.productsheet,
	a.qty,
	a.qtyearly,
	IFNULL(b.qty_locked,0),
	IFNULL(c.qty_way,0),
	a.qty-IFNULL(b.qty_locked,0)+IFNULL(c.qty_way,0)-IFNULL(c.qty_way,0) AS balance_safety,
	FORMAT(a.qty,a.digit_length) AS qty_show,
	FORMAT(IFNULL(b.qty_locked,0),a.digit_length) AS qty_locked_show,
	FORMAT(IFNULL(c.qty_way,0),a.digit_length) AS qty_way_show,
	FORMAT(IFNULL(a.qtyearly,0),a.digit_length) AS qtyearly_show,
	FORMAT(a.qty-IFNULL(b.qty_locked,0)+IFNULL(c.qty_way,0)-IFNULL(a.qtyearly,0),a.digit_length) AS balance_safety_show
FROM (
	SELECT
		(select deploy_value from ld_systems_deploy where deploy_type=49 limit 1) AS digit_length,
		a.productid,
		c.productname,
		c.product_no,
		c.productsheet,
		SUM(a.productqty) AS qty,
		c.qtyearly
	FROM ld_warehouse2products a
	LEFT JOIN ld_warehouse b ON a.warehouseid=b.id 
	LEFT JOIN ld_products c ON c.productid=a.productid
	WHERE b.`status`=0
		AND c.deleted=0
		AND (
			CASE
				WHEN '{warename}'=0 THEN 1=1
				ELSE b.id='{warename}'
			END)
		AND (
			CASE
				WHEN '{productno}'='' THEN 1=1
				ELSE c.product_no like '%{productno}%'
			END)
		AND (
			CASE
				WHEN '{productname}'='' THEN 1=1
				ELSE c.productname like '%{productname}%'
			END)
		AND (
			CASE
				WHEN '{productsheet}'='' THEN 1=1
				ELSE c.productsheet like '%{productsheet}%'
			END)
	GROUP BY productid
) a
LEFT JOIN (
	SELECT
		b.productid,
		SUM(b.balanceoutproductcount) AS qty_locked
	FROM (
		SELECT 
			a.salesorderid AS order_id
		FROM ld_salesorder a 
		WHERE a.deleted=0 
			AND a.approvestatus&lt;&gt;'已拒绝' 
			AND IFNULL(a.sostatus,'')&lt;&gt;'已作废'
		UNION ALL
		SELECT 
			a.servicecontractsid
		FROM ld_servicecontracts a 
		WHERE a.deleted=0 
			AND a.approvestatus&lt;&gt;'已拒绝' 
			AND IFNULL(a.contract_status,'')&lt;&gt;'已作废'
	) a
	LEFT JOIN ld_inventoryproductrel b ON a.order_id=b.id
	WHERE b.balanceoutproductcount&gt;0
	GROUP BY b.productid
) b ON a.productid=b.productid
LEFT JOIN (
	SELECT
		b.productid,
		SUM(b.balancepurchasecount) AS qty_way
	FROM ld_purchaseorder a
	LEFT JOIN ld_inventoryproductrel b ON a.purchaseorderid=b.id
	WHERE a.deleted=0
		AND a.approvestatus&lt;&gt;'已拒绝'
		AND IFNULL(a.postatus,'')&lt;&gt;'已作废'
		AND b.balancepurchasecount&gt;0
	GROUP BY b.productid
) c ON c.productid=a.productid
WHERE (
		CASE
			WHEN '{qty_range}'='true' THEN a.qty&gt;0
			ELSE 1=1
		END)
	AND (
		CASE
			WHEN '{safety_range}'='true' THEN a.qty-IFNULL(b.qty_locked,0)+IFNULL(c.qty_way,0)-IFNULL(a.qtyearly,0)&lt;0
			ELSE 1=1
		END)</SqlCommand>
      </report>
      <report_total type="Stimulsoft.Report.Dictionary.StiMySqlSource" isKey="true" Ref="6">
        <Alias>report_total</Alias>
        <Columns count="8" isList="true">
          <value>qty,System.Decimal</value>
          <value>qty_locked,System.Decimal</value>
          <value>qty_way,System.Decimal</value>
          <value>balance_safety,System.Decimal</value>
          <value>qty_show,System.String</value>
          <value>qty_locked_show,System.String</value>
          <value>qty_way_show,System.String</value>
          <value>balance_safety_show,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1"/>
        <Name>report_total</Name>
        <NameInSource>ldcrm</NameInSource>
        <Parameters count="0" isList="true"/>
        <SqlCommand>SELECT
	SUM(a.qty) AS qty,
	SUM(IFNULL(b.qty_locked,0)) AS qty_locked,
	SUM(IFNULL(c.qty_way,0)) AS qty_way,
	SUM(a.qty-IFNULL(b.qty_locked,0)+IFNULL(c.qty_way,0)-IFNULL(c.qty_way,0)) AS balance_safety,
	FORMAT(SUM(a.qty),a.digit_length) AS qty_show,
	FORMAT(SUM(IFNULL(b.qty_locked,0)),a.digit_length) AS qty_locked_show,
	FORMAT(SUM(IFNULL(c.qty_way,0)),a.digit_length) AS qty_way_show,
	FORMAT(SUM(a.qty-IFNULL(b.qty_locked,0)+IFNULL(c.qty_way,0)-IFNULL(a.qtyearly,0)),a.digit_length) AS balance_safety_show
FROM (
	SELECT
		(select deploy_value from ld_systems_deploy where deploy_type=49 limit 1) AS digit_length,
		a.productid,
		c.productname,
		c.product_no,
		c.productsheet,
		SUM(a.productqty) AS qty,
		c.qtyearly
	FROM ld_warehouse2products a
	LEFT JOIN ld_warehouse b ON a.warehouseid=b.id 
	LEFT JOIN ld_products c ON c.productid=a.productid
	WHERE b.`status`=0
		AND c.deleted=0
		AND (
			CASE
				WHEN '{warename}'=0 THEN 1=1
				ELSE b.id='{warename}'
			END)
		AND (
			CASE
				WHEN '{productno}'='' THEN 1=1
				ELSE c.product_no like '%{productno}%'
			END)
		AND (
			CASE
				WHEN '{productname}'='' THEN 1=1
				ELSE c.productname like '%{productname}%'
			END)
		AND (
			CASE
				WHEN '{productsheet}'='' THEN 1=1
				ELSE c.productsheet like '%{productsheet}%'
			END)
	GROUP BY productid
) a
LEFT JOIN (
	SELECT
		b.productid,
		SUM(b.balanceoutproductcount) AS qty_locked
	FROM (
		SELECT 
			a.salesorderid AS order_id
		FROM ld_salesorder a 
		WHERE a.deleted=0 
			AND a.approvestatus&lt;&gt;'已拒绝' 
			AND IFNULL(a.sostatus,'')&lt;&gt;'已作废'
		UNION ALL
		SELECT 
			a.servicecontractsid
		FROM ld_servicecontracts a 
		WHERE a.deleted=0 
			AND a.approvestatus&lt;&gt;'已拒绝' 
			AND IFNULL(a.contract_status,'')&lt;&gt;'已作废'
	) a
	LEFT JOIN ld_inventoryproductrel b ON a.order_id=b.id
	WHERE b.balanceoutproductcount&gt;0
	GROUP BY b.productid
) b ON a.productid=b.productid
LEFT JOIN (
	SELECT
		b.productid,
		SUM(b.balancepurchasecount) AS qty_way
	FROM ld_purchaseorder a
	LEFT JOIN ld_inventoryproductrel b ON a.purchaseorderid=b.id
	WHERE a.deleted=0
		AND a.approvestatus&lt;&gt;'已拒绝'
		AND IFNULL(a.postatus,'')&lt;&gt;'已作废'
		AND b.balancepurchasecount&gt;0
	GROUP BY b.productid
) c ON c.productid=a.productid
WHERE (
		CASE
			WHEN '{qty_range}'='true' THEN a.qty&gt;0
			ELSE 1=1
		END)
	AND (
		CASE
			WHEN '{safety_range}'='true' THEN a.qty-IFNULL(b.qty_locked,0)+IFNULL(c.qty_way,0)-IFNULL(a.qtyearly,0)&lt;0
			ELSE 1=1
		END)</SqlCommand>
      </report_total>
      <detail_locked type="Stimulsoft.Report.Dictionary.StiMySqlSource" isKey="true" Ref="7">
        <Alias>detail_locked</Alias>
        <Columns count="9" isList="true">
          <value>order_id,System.Int32</value>
          <value>order_no,System.String</value>
          <value>signed_data,System.DateTime</value>
          <value>sostatus,System.String</value>
          <value>approvestatus,System.String</value>
          <value>productid,System.Int32</value>
          <value>qty_locked,System.Decimal</value>
          <value>qty_locked_show,System.String</value>
          <value>last_name,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1"/>
        <Name>detail_locked</Name>
        <NameInSource>ldcrm</NameInSource>
        <Parameters count="0" isList="true"/>
        <SqlCommand>SELECT
	a.order_id,
	a.order_no,
	a.signed_data,
	a.sostatus,
	a.approvestatus,
	b.productid,
	SUM(b.balanceoutproductcount) AS qty_locked,
	FORMAT(SUM(b.balanceoutproductcount),(select deploy_value from ld_systems_deploy where deploy_type=49 limit 1)) AS qty_locked_show,
	c.last_name
FROM (
	SELECT
		a.salesorderid AS order_id,
		a.salesorder_no AS order_no,
		a.signed_data,
		a.sostatus,
		a.approvestatus,
		a.smownerid
	FROM ld_salesorder a 
	WHERE a.deleted=0 
		AND a.approvestatus&lt;&gt;'已拒绝' 
		AND IFNULL(a.sostatus,'')&lt;&gt;'已作废'
	UNION ALL
	SELECT 
		a.servicecontractsid,
		a.contract_no,
		a.due_date,
		a.contract_status,
		a.approvestatus,
		a.smownerid
	FROM ld_servicecontracts a 
	WHERE a.deleted=0 
		AND a.approvestatus&lt;&gt;'已拒绝' 
		AND IFNULL(a.contract_status,'')&lt;&gt;'已作废'
) a
LEFT JOIN ld_inventoryproductrel b ON a.order_id=b.id
LEFT JOIN ld_users c ON c.id=a.smownerid
WHERE b.balanceoutproductcount&gt;0
	AND b.productid='{this["id"]}'
GROUP BY a.order_id</SqlCommand>
      </detail_locked>
      <detail_way type="Stimulsoft.Report.Dictionary.StiMySqlSource" isKey="true" Ref="8">
        <Alias>detail_way</Alias>
        <Columns count="9" isList="true">
          <value>purchaseorderid,System.Int32</value>
          <value>purchaseorder_no,System.String</value>
          <value>signed_data,System.DateTime</value>
          <value>postatus,System.String</value>
          <value>approvestatus,System.String</value>
          <value>productid,System.Int32</value>
          <value>qty_way,System.Decimal</value>
          <value>qty_locked_show,System.String</value>
          <value>last_name,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1"/>
        <Name>detail_way</Name>
        <NameInSource>ldcrm</NameInSource>
        <Parameters count="0" isList="true"/>
        <SqlCommand>SELECT
	a.purchaseorderid,
	a.purchaseorder_no,
	a.signed_data,
	a.postatus,
	a.approvestatus,
	b.productid,
	SUM(b.balancepurchasecount) AS qty_way,
	FORMAT(SUM(b.balancepurchasecount),(select deploy_value from ld_systems_deploy where deploy_type=49 limit 1)) AS qty_locked_show,
	c.last_name	
FROM ld_purchaseorder a
LEFT JOIN ld_inventoryproductrel b ON a.purchaseorderid=b.id
LEFT JOIN ld_users c ON c.id=a.smownerid
WHERE a.deleted=0
	AND a.approvestatus&lt;&gt;'已拒绝'
	AND IFNULL(a.postatus,'')&lt;&gt;'已作废'
	AND b.balancepurchasecount&gt;0
	AND b.productid='{this["id"]}'
GROUP BY a.purchaseorderid</SqlCommand>
      </detail_way>
      <purchase_data type="Stimulsoft.Report.Dictionary.StiMySqlSource" isKey="true" Ref="9">
        <Alias>purchase_data</Alias>
        <Columns count="1" isList="true">
          <value>json_products,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1"/>
        <Name>purchase_data</Name>
        <NameInSource>ldcrm</NameInSource>
        <Parameters count="0" isList="true"/>
        <SqlCommand>SELECT
	CONCAT('[',GROUP_CONCAT(CONCAT(s1,'"productid":',productid,',"quantity":',REPLACE(qty,',',''),s2)),']') AS json_products
FROM (
	SELECT
		a.productid,
		(select symbol from tmp_symbol where id=1) AS s1,
		(select symbol from tmp_symbol where id=2) AS s2,
		FORMAT(ABS(a.qty-IFNULL(b.qty_locked,0)+IFNULL(c.qty_way,0)-IFNULL(a.qtyearly,0)),(select deploy_value from ld_systems_deploy where deploy_type=49 limit 1)) AS qty
	FROM (
		SELECT
			a.productid,
			c.productname,
			c.product_no,
			c.productsheet,
			SUM(a.productqty) AS qty,
			c.qtyearly
		FROM ld_warehouse2products a
		LEFT JOIN ld_warehouse b ON a.warehouseid=b.id 
		LEFT JOIN ld_products c ON c.productid=a.productid
		WHERE b.`status`=0
			AND c.deleted=0
			AND (
				CASE
					WHEN '{warename}'=0 THEN 1=1
					ELSE b.id='{warename}'
				END)
			AND (
				CASE
					WHEN '{productno}'='' THEN 1=1
					ELSE c.product_no like '%{productno}%'
				END)
			AND (
				CASE
					WHEN '{productname}'='' THEN 1=1
					ELSE c.productname like '%{productname}%'
				END)
			AND (
				CASE
					WHEN '{productsheet}'='' THEN 1=1
					ELSE c.productsheet like '%{productsheet}%'
				END)
		GROUP BY productid
	) a
	LEFT JOIN (
		SELECT
			b.productid,
			SUM(b.balanceoutproductcount) AS qty_locked
		FROM (
			SELECT 
				a.salesorderid AS order_id
			FROM ld_salesorder a 
			WHERE a.deleted=0 
				AND a.approvestatus&lt;&gt;'已拒绝' 
				AND IFNULL(a.sostatus,'')&lt;&gt;'已作废'
			UNION ALL
			SELECT 
				a.servicecontractsid
			FROM ld_servicecontracts a 
			WHERE a.deleted=0 
				AND a.approvestatus&lt;&gt;'已拒绝' 
				AND IFNULL(a.contract_status,'')&lt;&gt;'已作废'
		) a
		LEFT JOIN ld_inventoryproductrel b ON a.order_id=b.id
		WHERE b.balanceoutproductcount&gt;0
		GROUP BY b.productid
	) b ON a.productid=b.productid
	LEFT JOIN (
		SELECT
			b.productid,
			SUM(b.balancepurchasecount) AS qty_way
		FROM ld_purchaseorder a
		LEFT JOIN ld_inventoryproductrel b ON a.purchaseorderid=b.id
		WHERE a.deleted=0
			AND a.approvestatus&lt;&gt;'已拒绝'
			AND IFNULL(a.postatus,'')&lt;&gt;'已作废'
			AND b.balancepurchasecount&gt;0
		GROUP BY b.productid
	) c ON c.productid=a.productid
	WHERE (
			CASE
				WHEN '{qty_range}'='true' THEN a.qty&gt;0
				ELSE 1=1
			END)
		AND (
			CASE
				WHEN '{safety_range}'='true' THEN a.qty-IFNULL(b.qty_locked,0)+IFNULL(c.qty_way,0)-IFNULL(c.qty_way,0)&lt;0
				ELSE 1=1
			END)
		AND a.qty-IFNULL(b.qty_locked,0)+IFNULL(c.qty_way,0)-IFNULL(a.qtyearly,0) &lt;0
) t</SqlCommand>
      </purchase_data>
