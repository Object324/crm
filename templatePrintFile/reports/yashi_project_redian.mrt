        "NameInSource": "ldcrm",
        "SqlCommand": "select \r\nld_potential.potentialid,\r\nld_potential.potential_no,\r\nld_potential.accountid,\r\nld_account.accountname,\r\nld_potential.potentialname,\r\nld_potential.smownerid,\r\nld_users.last_name,\r\nld_potentialscf.cf_4708 as product_type,\r\nld_potential.total/10000 as total,\r\ndetail.quantity,\r\nld_potential.closingdate,\r\nld_potentialscf.cf_4753 as fahuo_date,\r\nld_potential.sales_stage,\r\nld_potential.nolinkdays,\r\nDATEDIFF(NOW(),ld_potential.createdtime)as created_days,\r\nifnull(contact_record.record_count,0)as record_count\r\nfrom ld_potential\r\nleft join ld_account on ld_potential.accountid=ld_account.accountid\r\nleft join ld_users on ld_users.id=ld_potential.smownerid\r\nleft join ld_potentialscf on ld_potentialscf.potentialid=ld_potential.potentialid\r\nleft join (\r\n\tselect sum(quantity)as quantity,id \r\n\tfrom ld_potentialsdetail\r\n\tgroup by id\r\n) detail on detail.id=ld_potential.potentialid\r\nleft join (\r\n\tselect count(1)as record_count,potentialid\r\n\tfrom ld_contactrecords\r\n\tgroup by  potentialid\r\n) contact_record on contact_record.potentialid=ld_potential.potentialid\r\ninner join (\r\n\t\tselect distinct u.id  as id\r\n\t\tfrom ld_users u\r\n\t\tleft join ld_users2group u2g on u2g.userid=u.id\r\n\t\tleft join ld_groups g on g.groupid=u2g.groupid\r\n\t\tleft join ld_groups g2 on g2.groupid=g.parentid\r\n\t\tWHERE u.deleted=0 \r\n\t\tAND u.`status`='Active'\r\n\t\tand FIND_IN_SET(u.userlevel,'销售经理,分公司经理,分公司副经理,办事处经理,大区经理,大区副经理')\r\n\t\tand (\r\n\t\t\tcase when '{weidu}'=3 and '{ziweidu}'!='' then FIND_IN_SET(u.id ,'{ziweidu}')\r\n\t\t\twhen '{weidu}'=3 and '{ziweidu}'='' then 1=1\r\n\t\t\twhen '{weidu}'=2 and '{ziweidu}'!=''  then FIND_IN_SET( g.groupid ,'{ziweidu}') and g.depth=4\r\n\t\t\twhen '{weidu}'=2 and '{ziweidu}'=''  then g.depth=4\r\n\t\t\twhen '{weidu}'=1 and '{ziweidu}'!=''  then FIND_IN_SET( g.parentid ,'{ziweidu}') \r\n\t\t\twhen '{weidu}'=1 and '{ziweidu}'=''  then 1=1\r\n\t\t\telse 1=1\r\n\t\t\tend \r\n\t\t) \r\n\t)u on u.id=ld_potential.smownerid \r\n\tINNER JOIN (\r\n\t\tSELECT DISTINCT\r\n\t\t\tuserid \r\n\t\tFROM (\r\n\t\t\tSELECT \r\n\t\t\t\tld_users.id AS userid \r\n\t\t\tFROM ld_users\r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Potentials' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\tUNION\r\n\t\t\tSELECT \r\n\t\t\t\tviewid AS userid \r\n\t\t\tFROM ld_scoperhigher\r\n\t\t\tWHERE userid='[uuid]' AND modulename ='Potentials' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename ='Potentials')\t\t\t\r\n\t\t\tUNION\r\n\t\t\tSELECT DISTINCT \r\n\t\t\t\tld_users2group.userid AS userid \r\n\t\t\tFROM ld_scoperhigher \r\n\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\tAND ld_scoperhigher.modulename ='Potentials'\r\n\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Potentials' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\tUNION \r\n\t\t\tSELECT \r\n\t\t\t\tid AS userid \r\n\t\t\tFROM ld_users  \r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\tUNION\r\n\t\t\tSELECT '[uuid]') AS vw_users\r\n\t) AS tmp_users ON tmp_users.userid=ld_potential.smownerid \r\n\tWHERE ld_potential.deleted=0 \r\n\tand ld_potential.closingdate like concat('%',date_format(date_add(date_format(concat('{nian}','-','{yue}','-',1),'%Y-%m-%d'),interval 1 month),'%Y-%m'),'%')\r\n\t\r\n\t\r\n"
      },
