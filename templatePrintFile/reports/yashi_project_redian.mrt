        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT YEAR(CURDATE()) AS list_value\r\nUNION\r\nSELECT YEAR(CURDATE())-1\r\nUNION\r\nSELECT YEAR(CURDATE())-2\r\nUNION\r\nSELECT YEAR(CURDATE())-3\r\nUNION\r\nSELECT YEAR(CURDATE())-4"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "ld_target",
        "Alias": "ld_target",
        "Key": "675d0d651e5043b4b66f0ead5f16908c",
        "Columns": {
          "0": {
            "Name": "onemonth",
            "Index": -1,
            "NameInSource": "onemonth",
            "Alias": "onemonth",
            "Type": "System.Decimal"
          },
          "1": {
            "Name": "onetarget",
            "Index": -1,
            "NameInSource": "onetarget",
            "Alias": "onetarget",
            "Type": "System.Decimal"
          },
          "2": {
            "Name": "threemonth",
            "Index": -1,
            "NameInSource": "threemonth",
            "Alias": "threemonth",
            "Type": "System.Decimal"
          },
          "3": {
            "Name": "threetarget",
            "Index": -1,
            "NameInSource": "threetarget",
            "Alias": "threetarget",
            "Type": "System.Decimal"
          },
          "4": {
            "Name": "twomonth",
            "Index": -1,
            "NameInSource": "twomonth",
            "Alias": "twomonth",
            "Type": "System.Decimal"
          },
          "5": {
            "Name": "twotarget",
            "Index": -1,
            "NameInSource": "twotarget",
            "Alias": "twotarget",
            "Type": "System.Decimal"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "\r\nselect \r\nsum(case when seq=1 then targetmouth else 0 end ) as onemonth,\r\nsum(case when seq=2 then targetmouth else 0 end ) as twomonth,\r\nsum(case when seq=3 then targetmouth else 0 end ) as threemonth,\r\nsum(case when seq=1 then contractamount else 0 end )/10000 as onetarget,\r\nsum(case when seq=2 then contractamount else 0 end )/10000 as twotarget,\r\nsum(case when seq=3 then contractamount else 0 end )/10000 as threetarget \r\nfrom (\r\nselect sum(contractamount) as contractamount,targetmouth,date,(@i:=@i+1) AS seq from (\r\n\tselect sum(ld_salestarget.contractamount)as contractamount,ld_salestarget.userid,date_format(concat(targetyear,'-',targetmouth,'-',1),'%Y-%m-%d') as date,targetmouth \r\n\tfrom ld_salestarget \r\n\tleft join ld_users u on u.id=ld_salestarget.userid \r\n\tleft join ld_users2group u2g on u2g.userid=u.id\r\n\tleft join ld_groups g on g.groupid=u2g.groupid\r\n\tleft join ld_groups g2 on g2.groupid=g.parentid\r\n\tINNER JOIN (\r\n\t\tSELECT DISTINCT\r\n\t\t\tuserid \r\n\t\tFROM (\r\n\t\t\tSELECT \r\n\t\t\t\tld_users.id AS userid \r\n\t\t\tFROM ld_users\r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='SalesOrder' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\tUNION\r\n\t\t\tSELECT \r\n\t\t\t\tviewid AS userid \r\n\t\t\tFROM ld_scoperhigher\r\n\t\t\tWHERE userid='[uuid]' AND modulename ='SalesOrder' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename ='SalesOrder')\t\t\t\r\n\t\t\tUNION\r\n\t\t\tSELECT DISTINCT \r\n\t\t\t\tld_users2group.userid AS userid \r\n\t\t\tFROM ld_scoperhigher \r\n\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\tAND ld_scoperhigher.modulename ='SalesOrder'\r\n\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='SalesOrder' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\tUNION \r\n\t\t\tSELECT \r\n\t\t\t\tid AS userid \r\n\t\t\tFROM ld_users  \r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\tUNION\r\n\t\t\tSELECT '[uuid]') AS vw_users\r\n\t) AS tmp_users ON tmp_users.userid=u.id\r\n\tWHERE u.deleted=0\r\n\tAND u.`status`='Active'\r\n\tand g.parentgroup like '1::2::7::%' \r\n\tand g2.parentgroup like '1::2::7::%'\r\n\tand FIND_IN_SET(u.userlevel,'销售经理,分公司经理,分公司副经理,办事处经理,大区经理,大区副经理')\r\n\tand (\r\n\t\tcase when '{weidu}'=3 and '{ziweidu}'!='' then FIND_IN_SET(u.id ,'{ziweidu}')\r\n\t\twhen '{weidu}'=3 and '{ziweidu}'='' then 1=1\r\n\t\twhen '{weidu}'=2 and '{ziweidu}'!=''  then FIND_IN_SET( g.groupid ,'{ziweidu}') and g.depth=4\r\n\t\twhen '{weidu}'=2 and '{ziweidu}'=''  then g.depth=4\r\n\t\twhen '{weidu}'=1 and '{ziweidu}'!=''  then FIND_IN_SET( g.parentid ,'{ziweidu}') \r\n\t\twhen '{weidu}'=1 and '{ziweidu}'=''  then 1=1\r\n\t\telse 1=1\r\n\t\tend \r\n\t)  \r\n\tgroup by (\r\n\t\tcase when '{weidu}'=3 then u.id \r\n\t\twhen '{weidu}'=2  then g.groupid\r\n\t\twhen '{weidu}'=1 then g.parentid\r\n\t\telse u.id \r\n\t\tend \r\n\t ),date\r\n)target,(SELECT @i:=0) s\r\nwhere date>DATE_FORMAT(concat('{nian}','-','{yue}','-',1),'%Y-%m-%d') and date<=date_sub(date_format(concat('{nian}','-','{yue}','-',1),'%Y-%m-%d'),interval -3 month)\r\nGROUP BY date\r\n)a "
      },
      "2": {
        "Ident": "StiMySqlSource",
        "Name": "ld_project",
        "Alias": "ld_project",
        "Key": "b40a6e25d9c04aa4a66eed3e346b5e6f",
        "Columns": {
          "0": {
            "Name": "alltotal",
            "Index": -1,
            "NameInSource": "alltotal",
            "Alias": "alltotal",
            "Type": "System.Decimal"
          },
          "1": {
            "Name": "eight_pencent",
            "Index": -1,
            "NameInSource": "eight_pencent",
            "Alias": "eight_pencent",
            "Type": "System.Decimal"
          },
          "2": {
            "Name": "five_pencent",
            "Index": -1,
            "NameInSource": "five_pencent",
            "Alias": "five_pencent",
            "Type": "System.Decimal"
          },
          "3": {
            "Name": "four_pencent",
            "Index": -1,
            "NameInSource": "four_pencent",
            "Alias": "four_pencent",
            "Type": "System.Decimal"
          },
          "4": {
            "Name": "nine_pencent",
            "Index": -1,
            "NameInSource": "nine_pencent",
            "Alias": "nine_pencent",
            "Type": "System.Decimal"
          },
          "5": {
            "Name": "seven_pencent",
            "Index": -1,
            "NameInSource": "seven_pencent",
            "Alias": "seven_pencent",
            "Type": "System.Decimal"
          },
          "6": {
            "Name": "six_pencent",
            "Index": -1,
            "NameInSource": "six_pencent",
            "Alias": "six_pencent",
            "Type": "System.Decimal"
          },
          "7": {
            "Name": "ten_pencent",
            "Index": -1,
            "NameInSource": "ten_pencent",
            "Alias": "ten_pencent",
            "Type": "System.Decimal"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "\r\nselect \r\nsum(case when sales_stage='40%热度' then ifnull(total,0) else 0 end )/10000 as four_pencent,\r\nsum(case when sales_stage='50%热度' then ifnull(total,0) else 0 end )/10000 as five_pencent,\r\nsum(case when sales_stage='60%热度' then ifnull(total,0) else 0 end )/10000 as six_pencent,\r\nsum(case when sales_stage='70%热度' then ifnull(total,0) else 0 end )/10000 as seven_pencent,\r\nsum(case when sales_stage='80%热度' then ifnull(total,0) else 0 end )/10000 as eight_pencent,\r\nsum(case when sales_stage='90%热度' then ifnull(total,0) else 0 end )/10000 as nine_pencent,\r\nsum(case when sales_stage='100%热度' then ifnull(total,0) else 0 end )/10000 as ten_pencent,\r\nsum(ifnull(total,0))/10000 as alltotal\r\nfrom (\r\n\tselect sum(total)as total,sales_stage from (\r\n\tselect  \r\n\t\tp.total,p.smownerid,p.closingdate,p.sales_stage\r\n\tfrom ld_potential p \r\n\tinner join (\r\n\t\tselect distinct u.id  as id\r\n\t\tfrom ld_users u\r\n\t\tleft join ld_users2group u2g on u2g.userid=u.id\r\n\t\tleft join ld_groups g on g.groupid=u2g.groupid\r\n\t\tleft join ld_groups g2 on g2.groupid=g.parentid\r\n\t\tWHERE u.deleted=0 \r\n\t\tAND u.`status`='Active'\r\n\t\tand FIND_IN_SET(u.userlevel,'销售经理,分公司经理,分公司副经理,办事处经理,大区经理,大区副经理')\r\n\t\tand (\r\n\t\t\tcase when '{weidu}'=3 and '{ziweidu}'!='' then FIND_IN_SET(u.id ,'{ziweidu}')\r\n\t\t\twhen '{weidu}'=3 and '{ziweidu}'='' then 1=1\r\n\t\t\twhen '{weidu}'=2 and '{ziweidu}'!=''  then FIND_IN_SET( g.groupid ,'{ziweidu}') and g.depth=4\r\n\t\t\twhen '{weidu}'=2 and '{ziweidu}'=''  then g.depth=4\r\n\t\t\twhen '{weidu}'=1 and '{ziweidu}'!=''  then FIND_IN_SET( g.parentid ,'{ziweidu}') \r\n\t\t\twhen '{weidu}'=1 and '{ziweidu}'=''  then 1=1\r\n\t\t\telse 1=1\r\n\t\t\tend \r\n\t\t) \r\n\t)u on u.id=p.smownerid \r\n\tINNER JOIN (\r\n\t\tSELECT DISTINCT\r\n\t\t\tuserid \r\n\t\tFROM (\r\n\t\t\tSELECT \r\n\t\t\t\tld_users.id AS userid \r\n\t\t\tFROM ld_users\r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Potentials' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\tUNION\r\n\t\t\tSELECT \r\n\t\t\t\tviewid AS userid \r\n\t\t\tFROM ld_scoperhigher\r\n\t\t\tWHERE userid='[uuid]' AND modulename ='Potentials' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename ='Potentials')\t\t\t\r\n\t\t\tUNION\r\n\t\t\tSELECT DISTINCT \r\n\t\t\t\tld_users2group.userid AS userid \r\n\t\t\tFROM ld_scoperhigher \r\n\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\tAND ld_scoperhigher.modulename ='Potentials'\r\n\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Potentials' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\tUNION \r\n\t\t\tSELECT \r\n\t\t\t\tid AS userid \r\n\t\t\tFROM ld_users  \r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\tUNION\r\n\t\t\tSELECT '[uuid]') AS vw_users\r\n\t) AS tmp_users ON tmp_users.userid=p.smownerid \r\n\twhere p.closingdate like CONCAT('%',DATE_FORMAT(CONCAT('{nian}','-','{yue}-1'),'%Y-%m'),'%') \r\n\tand p.sales_stage !='20%热度' and p.sales_stage !='30%热度'\r\n\tand p.deleted=0 \r\n\t)\ta group by sales_stage\r\n)a\r\n \r\n"
      },
