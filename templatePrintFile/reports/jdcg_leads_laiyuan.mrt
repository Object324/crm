    "DataSources": {
      "0": {
        "Ident": "StiMySqlSource",
        "Name": "b",
        "Alias": "b",
        "Columns": {
          "0": {
            "Name": "laiyuan",
            "Index": -1,
            "NameInSource": "laiyuan",
            "Alias": "laiyuan",
            "Type": "System.String"
          },
          "1": {
            "Name": "qty_re",
            "Index": -1,
            "NameInSource": "qty_re",
            "Alias": "qty_re",
            "Type": "System.Decimal"
          },
          "2": {
            "Name": "qty_wuxiao",
            "Index": -1,
            "NameInSource": "qty_wuxiao",
            "Alias": "qty_wuxiao",
            "Type": "System.Decimal"
          },
          "3": {
            "Name": "qty_xiansuo",
            "Index": -1,
            "NameInSource": "qty_xiansuo",
            "Alias": "qty_xiansuo",
            "Type": "System.Int32"
          },
          "4": {
            "Name": "total_re",
            "Index": -1,
            "NameInSource": "total_re",
            "Alias": "total_re",
            "Type": "System.Decimal"
          }
        },
        "NameInSource": "crm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\tlaiyuan,\r\n\tCOUNT(1) AS qty_xiansuo,\r\n\tSUM(qty_wuxiao) AS qty_wuxiao,\r\n\tSUM(qty_re) AS qty_re,\r\n\tROUND(IFNULL(SUM(total_re),0),0) AS total_re\r\nFROM (\r\n\tSELECT\r\n\t\ta.customform53id,\r\n\t\tb.cf_3932 AS laiyuan,\r\n\t\tCASE WHEN b.cf_3955='无效线索' THEN 1 ELSE 0 END AS qty_wuxiao,\r\n\t\tCASE WHEN b.cf_3955='热线索' THEN 1 ELSE 0 END AS qty_re,\r\n\t\tCASE WHEN b.cf_3955='热线索' THEN c.total ELSE 0 END AS total_re\r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\ta.*\r\n\t\tFROM ld_customform53 a\r\n\t\tLEFT JOIN ld_customform53scf b ON b.customform53id=a.customform53id\r\n\t\tINNER JOIN (\r\n\t\t\tSELECT DISTINCT\r\n\t\t\t\tuserid \r\n\t\t\tFROM (\r\n\t\t\t\tSELECT \r\n\t\t\t\t\tld_users.id AS userid \r\n\t\t\t\tFROM ld_users\r\n\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='CustomForm53' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT \r\n\t\t\t\t\tviewid AS userid \r\n\t\t\t\tFROM ld_scoperhigher\r\n\t\t\t\tWHERE userid='[uuid]' AND modulename ='CustomForm53' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename ='CustomForm53')\t\t\t\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT DISTINCT \r\n\t\t\t\t\tld_users2group.userid AS userid \r\n\t\t\t\tFROM ld_scoperhigher \r\n\t\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\t\tAND ld_scoperhigher.modulename ='CustomForm53'\r\n\t\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='CustomForm53' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\t\tUNION \r\n\t\t\t\tSELECT \r\n\t\t\t\t\tid AS userid \r\n\t\t\t\tFROM ld_users  \r\n\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT '[uuid]') AS vw_users\r\n\t\t) AS tmp_users ON tmp_users.userid=a.smownerid\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\tAND IFNULL(b.cf_3932,'')<>''\r\n\t\t\tAND a.createdtime BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d %H:%i:%s') AND DATE_FORMAT('{end_date}','%Y-%m-%d %H:%i:%s')\r\n\t\tUNION\r\n\t\tSELECT\r\n\t\t\ta.*\r\n\t\tFROM ld_customform53 a\r\n\t\tLEFT JOIN ld_customform53scf b ON b.customform53id=a.customform53id\r\n\t\tINNER JOIN ld_tabshare s ON s.crmid=a.customform53id\r\n\t\tWHERE s.viewuserid='[uuid]'\r\n\t\t\tAND a.deleted=0\r\n\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\tAND IFNULL(b.cf_3932,'')<>''\r\n\t\t\tAND a.createdtime BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d %H:%i:%s') AND DATE_FORMAT('{end_date}','%Y-%m-%d %H:%i:%s')\r\n\t) a\r\n\tLEFT JOIN ld_customform53scf b ON b.customform53id=a.customform53id\r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\tb.customform53_id,\r\n\t\t\tSUM(a.total/IFNULL(a.conversion_rate,1)) AS total \r\n\t\tFROM ld_servicecontracts a\r\n\t\tLEFT JOIN ld_potential b ON b.potentialid=a.potentialid\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\tAND b.customform53_id>0\r\n\t\tGROUP BY b.customform53_id\r\n\t) c ON c.customform53_id=a.customform53id\r\n) a\r\nLEFT JOIN ld_picklist_values b ON b.listid=178 AND b.listvalue=a.laiyuan\r\nGROUP BY laiyuan\r\nORDER BY b.sequence"
      }
    },
