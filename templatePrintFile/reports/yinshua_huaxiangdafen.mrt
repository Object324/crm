          }
        },
        "NameInSource": "ldcrm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\taccountid,\r\n\tkh_level,\r\n\taccount_no,\r\n\taccountname,\r\n\tuser_name,\r\n\tscore,\r\n\tstand_score,\r\n\tscore-stand_score AS scoreinfo\r\nFROM (\r\nSELECT\r\n\ta.accountid,\r\n\ta.account_no,\r\n\ta.accountname,\r\n\tg.groupname,\r\n\tb.last_name AS user_name,\r\n\ta.cf_2974 AS score,\r\n\ta.cf_2963 AS kh_level,\r\n\tCASE\r\n\t\tWHEN a.cf_2963='5级' THEN 160\r\n\t\tWHEN a.cf_2963='4级' THEN 120\r\n\t\tWHEN a.cf_2963='3级' THEN 80\r\n\t\tWHEN a.cf_2963='2级' THEN 50\r\n\tEND AS stand_score,\r\n\ta.smownerid\r\nFROM ld_account a\r\nLEFT JOIN ld_users b ON b.id=a.smownerid\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\ta.userid,\r\n\t\tGROUP_CONCAT(b.groupname ORDER BY b.depth SEPARATOR '、') AS groupname\r\n\tFROM ld_users2group a\r\n\tLEFT JOIN ld_groups b ON b.groupid=a.groupid\r\n\tGROUP BY a.userid\r\n) g ON g.userid=a.smownerid\r\nINNER JOIN (\r\n\tSELECT DISTINCT\r\n\t\tuserid \r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\tld_users.id AS userid \r\n\t\tFROM ld_users\r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Accounts' and scopeauthority=1 AND userid='[uuid]')\r\n\t\tUNION\r\n\t\tSELECT \r\n\t\t\tviewid AS userid \r\n\t\tFROM ld_scoperhigher\r\n\t\tWHERE userid='[uuid]' AND modulename ='Accounts' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename ='Accounts')\t\t\t\r\n\t\tUNION\r\n\t\tSELECT DISTINCT \r\n\t\t\tld_users2group.userid AS userid \r\n\t\tFROM ld_scoperhigher \r\n\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\tAND ld_scoperhigher.modulename ='Accounts'\r\n\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Accounts' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\tUNION \r\n\t\tSELECT \r\n\t\t\tid AS userid \r\n\t\tFROM ld_users  \r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\tUNION\r\n\t\tSELECT '[uuid]') AS vw_users\r\n) AS tmp_users ON tmp_users.userid=a.smownerid\r\nWHERE a.deleted=0\r\n\tAND a.cf_2963 IN ('5级','4级','3级','2级')\r\n\tAND(\r\n\t\tCASE\r\n\t\t\tWHEN FIND_IN_SET(1,'{data_range}') OR '{data_range}'='' THEN 1=1\r\n\t\t\tWHEN FIND_IN_SET(2,'{data_range}') THEN a.smownerid='[uuid]'\r\n\t\t\tELSE \r\n\t\t\t\t\ta.smownerid IN (\r\n\t\t\t\t\t\t\tSELECT\r\n\t\t\t\t\t\t\t\ta.userid\r\n\t\t\t\t\t\t\tFROM ld_users2group a\r\n\t\t\t\t\t\t\tINNER JOIN (\r\n\t\t\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\t\t\tsubstring_index(substring_index(a.splitsting,',',b.seq+1),',',-1)-200000 AS groupid\r\n\t\t\t\t\t\t\t\tFROM (SELECT '{data_range}' AS splitsting) a \r\n\t\t\t\t\t\t\t\tLEFT JOIN sequence b ON b.seq < (length(a.splitsting) - length(replace(a.splitsting,',',''))+1) \r\n\t\t\t\t\t\t\t\tWHERE substring_index(substring_index(a.splitsting,',',b.seq+1),',',-1) BETWEEN 200000 AND 300000\r\n\t\t\t\t\t\t\t) b ON b.groupid=a.groupid\r\n\t\t\t\t\t\t\tGROUP BY a.userid\r\n\t\t\t\t\t\t\tUNION \r\n\t\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\t\tsubstring_index(substring_index(a.splitsting,',',b.seq+1),',',-1)-300000 AS groupid\r\n\t\t\t\t\t\t\tFROM (SELECT '{data_range}' AS splitsting) a \r\n\t\t\t\t\t\t\tLEFT JOIN sequence b ON b.seq < (length(a.splitsting) - length(replace(a.splitsting,',',''))+1) \r\n\t\t\t\t\t\t\tWHERE substring_index(substring_index(a.splitsting,',',b.seq+1),',',-1)>300000\r\n\t\t\t\t\t)\r\n\t\tEND)\r\n) a\r\nWHERE 1=1\r\n\tAND score-stand_score<0\r\n\tAND (user_name='{this[\"SeriesArgument\"]}' OR kh_level='{this[\"SeriesArgument\"]}')"
      }
    },
