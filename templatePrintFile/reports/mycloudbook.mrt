  "Dictionary": {
    "Variables": {
      "0": {
        "Value": "DateSerial(Year(Today),Month(Today),1)",
        "Name": "time_start",
        "Alias": "起始日期",
        "Type": "System.DateTime",
        "RequestFromUser": true,
        "InitBy": "Expression"
      },
      "1": {
        "Value": "Today",
        "Name": "time_end",
        "Alias": "截止日期",
        "Type": "System.DateTime",
        "RequestFromUser": true,
        "InitBy": "Expression"
      },
      "2": {
        "Name": "nickname",
        "DialogInfo": {
          "DateTimeType": "DateAndTime"
        },
        "Alias": "昵称",
        "Type": "System.String",
        "RequestFromUser": true
      }
    },
    "DataSources": {
      "0": {
        "Ident": "StiMySqlSource",
        "Name": "cloudbook",
        "Alias": "cloudbook",
        "Key": "2b10d6434ed719be1ba0a1af75c2a0b4",
        "Columns": {
          "0": {
            "Name": "avatar",
            "Index": -1,
            "NameInSource": "avatar",
            "Alias": "avatar",
            "Type": "System.String"
          },
          "1": {
            "Name": "create_time",
            "Index": -1,
            "NameInSource": "create_time",
            "Alias": "create_time",
            "Type": "System.String"
          },
          "2": {
            "Name": "nickname",
            "Index": -1,
            "NameInSource": "nickname",
            "Alias": "nickname",
            "Type": "System.String"
          },
          "3": {
            "Name": "tel",
            "Index": -1,
            "NameInSource": "tel",
            "Alias": "tel",
            "Type": "System.String"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT u.nickname,u.avatar,b.tel,b.create_time FROM ld_cloud_book AS b\r\nLEFT JOIN ld_cloud_users AS u ON u.id=b.cloud_id\r\nWHERE  b.create_time BETWEEN '{time_start}' AND '{time_end}'\r\nAND (\r\n        CASE\r\n        WHEN TRIM('{nickname}')='' THEN 1=1\r\n        ELSE LOCATE(TRIM('{nickname}'),u.nickname)>0\r\n        END);"
      }
    },
