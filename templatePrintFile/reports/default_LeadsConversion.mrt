            "Type": "System.Decimal"
          },
          "2": {
            "Name": "add_leadtokhcg",
            "Index": -1,
            "NameInSource": "add_leadtokhcg",
            "Alias": "add_leadtokhcg",
            "Type": "System.Decimal"
          },
          "3": {
            "Name": "add_leadtosj",
            "Index": -1,
            "NameInSource": "add_leadtosj",
            "Alias": "add_leadtosj",
            "Type": "System.Decimal"
          },
          "4": {
            "Name": "add_leadtosjcg",
            "Index": -1,
            "NameInSource": "add_leadtosjcg",
            "Alias": "add_leadtosjcg",
            "Type": "System.Decimal"
          },
          "5": {
            "Name": "amount_sj",
            "Index": -1,
            "NameInSource": "amount_sj",
            "Alias": "amount_sj",
            "Type": "System.Decimal"
          },
          "6": {
            "Name": "amount_sjcg",
            "Index": -1,
            "NameInSource": "amount_sjcg",
            "Alias": "amount_sjcg",
            "Type": "System.Decimal"
          },
          "7": {
            "Name": "cunliang_kh",
            "Index": -1,
            "NameInSource": "cunliang_kh",
            "Alias": "cunliang_kh",
            "Type": "System.Decimal"
          },
          "8": {
            "Name": "cunliang_sj",
            "Index": -1,
            "NameInSource": "cunliang_sj",
            "Alias": "cunliang_sj",
            "Type": "System.Decimal"
          },
          "9": {
            "Name": "listvalue",
            "Index": -1,
            "NameInSource": "listvalue",
            "Alias": "listvalue",
            "Type": "System.String"
          },
          "10": {
            "Name": "rate",
            "Index": -1,
            "NameInSource": "rate",
            "Alias": "rate",
            "Type": "System.Decimal"
          }
        },
        "NameInSource": "ldcrm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\ta.listvalue,\r\n\tc.add_lead,\r\n\tc.add_leadtokh,\r\n\tc.add_leadtokhcg,\r\n\tc.add_leadtosj,\r\n\tc.add_leadtosjcg,\r\n\tc.amount_sj,\r\n\tc.amount_sjcg,\r\n\td.cnt AS cunliang_kh,\r\n\te.cnt AS cunliang_sj, \r\n\t(CASE WHEN c.add_lead>0 THEN IFNULL(c.add_leadtokh,0)/ c.add_lead ELSE 0 END) AS rate\r\nFROM ld_picklist_values a\r\nLEFT JOIN ld_picklist_set b ON b.listid=a.listid\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\ta.leadsource,\r\n\t\tSUM(a.add_lead) AS add_lead,\r\n\t\tSUM(a.add_leadtokh) AS add_leadtokh,\r\n\t\tSUM(a.add_leadtokhcg) AS add_leadtokhcg,\r\n\t\tSUM(b.add_leadtosj) AS add_leadtosj,\r\n\t\tSUM(b.amount_sj) AS amount_sj,\r\n\t\tSUM(b.amount_sjcg) AS amount_sjcg,\r\n\t\tSUM(b.add_leadtosjcg) AS add_leadtosjcg\r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\ta.smownerid,\r\n\t\t\ta.leadsource,\r\n\t\t\t1 AS add_lead,\r\n\t\t\t0 AS add_leadtokh,\r\n\t\t\tb.accountid,\r\n\t\t\t0 AS add_leadtokhcg\r\n\t\tFROM ld_leads a\r\n\t\tLEFT JOIN ld_account b ON  b.accountid=a.upgradeaccountid\r\n\t\tWHERE a.deleted IN (0,2)\r\n\t\t\tAND a.approvestatus<>'已拒绝'\t\r\n\t\t\tAND a.createdtime BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d 00:00:00') AND DATE_FORMAT('{end_date}','%Y-%m-%d 23:59:59')\r\n\t\tUNION ALL\r\n\t\tSELECT\r\n\t\t\ta.smcreatorid AS smownerid,\r\n\t\t\tb.leadsource,\r\n\t\t\t0 AS add_lead,\r\n\t\t\t1 AS add_leadtokh,\r\n\t\t\ta.accountid,\r\n\t\t\tCASE WHEN a.rating LIKE '%成交%' THEN 1 ELSE 0 END AS add_leadtokhcg\r\n\t\tFROM ld_account a\r\n\t\tLEFT JOIN ld_accountscf b ON b.accountid=a.accountid\r\n\t\tinner JOIN ld_leads c ON c.upgradeaccountid=a.accountid\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus<>'已拒绝' \r\n\t\t\tAND c.createdtime BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d 00:00:00') AND DATE_FORMAT('{end_date}','%Y-%m-%d 23:59:59')\r\n\t\t) a\r\n\t\tLEFT JOIN (\r\n\t\t\tSELECT\r\n\t\t\t\ta.accountid,\r\n\t\t\t\ta.potentialid,\r\n\t\t\t\tSUM(a.amount/IFNULL(a.conversion_rate,1)) AS amount_sj,\r\n\t\t\t\tSUM(CASE WHEN a.sales_stage LIKE '%成功%' THEN a.amount/IFNULL(a.conversion_rate,1) ELSE 0 END) AS amount_sjcg,\r\n\t\t\t\t1 AS add_leadtosj,\r\n\t\t\t\tCASE WHEN a.sales_stage LIKE '%成功%' THEN 1 ELSE 0 END AS add_leadtosjcg\r\n\t\t\tFROM ld_potential a\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝' \r\n\t\t\t\tAND a.accountid>0\r\n\t\t\tGROUP BY a.accountid\r\n\t\t) b ON b.accountid=a.accountid\r\n\t\tINNER JOIN (\r\n\t\t\tSELECT DISTINCT\r\n\t\t\t\tuserid \r\n\t\t\tFROM (\r\n\t\t\t\tSELECT \r\n\t\t\t\t\tld_users.id AS userid \r\n\t\t\t\tFROM ld_users\r\n\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Leads' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT \r\n\t\t\t\t\tviewid AS userid \r\n\t\t\t\tFROM ld_scoperhigher\r\n\t\t\t\tWHERE userid='[uuid]' AND modulename ='Leads' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename ='Leads')\t\t\t\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT DISTINCT \r\n\t\t\t\t\tld_users2group.userid AS userid \r\n\t\t\t\tFROM ld_scoperhigher \r\n\t\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\t\tAND ld_scoperhigher.modulename ='Leads'\r\n\t\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Leads' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\t\tUNION \r\n\t\t\t\tSELECT \r\n\t\t\t\t\tid AS userid \r\n\t\t\t\tFROM ld_users  \r\n\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT '[uuid]') AS vw_users\r\n\t\t) AS tmp_users ON tmp_users.userid=a.smownerid\r\n\t\tWHERE 1=1\r\n\t\t\tAND(\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN FIND_IN_SET(1,'{data_range}') OR '{data_range}'='' THEN 1=1\r\n\t\t\t\t\tWHEN FIND_IN_SET(2,'{data_range}') THEN a.smownerid='[uuid]'\r\n\t\t\t\t\tELSE \r\n\t\t\t\t\t\t\t\ta.smownerid IN (\r\n\t\t\t\t\t\t\t\t\t\tSELECT\r\n\t\t\t\t\t\t\t\t\t\t\ta.userid\r\n\t\t\t\t\t\t\t\t\t\tFROM ld_users2group a\r\n\t\t\t\t\t\t\t\t\t\tINNER JOIN (\r\n\t\t\t\t\t\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\t\t\t\t\t\tsubstring_index(substring_index(a.splitsting,',',b.seq+1),',',-1)-200000 AS groupid\r\n\t\t\t\t\t\t\t\t\t\t\tFROM (SELECT '{data_range}' AS splitsting) a \r\n\t\t\t\t\t\t\t\t\t\t\tLEFT JOIN sequence b ON b.seq < (length(a.splitsting) - length(replace(a.splitsting,',',''))+1) \r\n\t\t\t\t\t\t\t\t\t\t\tWHERE substring_index(substring_index(a.splitsting,',',b.seq+1),',',-1) BETWEEN 200000 AND 300000\r\n\t\t\t\t\t\t\t\t\t\t) b ON b.groupid=a.groupid\r\n\t\t\t\t\t\t\t\t\t\tGROUP BY a.userid\r\n\t\t\t\t\t\t\t\t\t\tUNION \r\n\t\t\t\t\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\t\t\t\t\tsubstring_index(substring_index(a.splitsting,',',b.seq+1),',',-1)-300000 AS groupid\r\n\t\t\t\t\t\t\t\t\t\tFROM (SELECT '{data_range}' AS splitsting) a \r\n\t\t\t\t\t\t\t\t\t\tLEFT JOIN sequence b ON b.seq < (length(a.splitsting) - length(replace(a.splitsting,',',''))+1) \r\n\t\t\t\t\t\t\t\t\t\tWHERE substring_index(substring_index(a.splitsting,',',b.seq+1),',',-1)>300000\r\n\t\t\t\t\t\t\t\t)\r\n\t\t\t\tEND)\r\n\tGROUP BY a.leadsource\r\n) c ON c.leadsource=a.listvalue\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\tleadsource,\r\n\t\tSUM(add_leadtokh) AS cnt\r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\ta.smcreatorid AS smownerid,\r\n\t\t\tb.leadsource,\r\n\t\t\t1 AS add_leadtokh\r\n\t\tFROM ld_account a\r\n\t\tLEFT JOIN ld_accountscf b ON b.accountid=a.accountid\r\n\t\tinner JOIN ld_leads c ON c.upgradeaccountid=a.accountid\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\tAND c.createdtime BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d 00:00:00') AND DATE_FORMAT('{end_date}','%Y-%m-%d 23:59:59')\r\n\t) a\r\n\tINNER JOIN (\r\n\t\tSELECT DISTINCT\r\n\t\t\tuserid \r\n\t\tFROM (\r\n\t\t\tSELECT \r\n\t\t\t\tld_users.id AS userid \r\n\t\t\tFROM ld_users\r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Leads' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\tUNION\r\n\t\t\tSELECT \r\n\t\t\t\tviewid AS userid \r\n\t\t\tFROM ld_scoperhigher\r\n\t\t\tWHERE userid='[uuid]' AND modulename ='Leads' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename ='Leads')\t\t\t\r\n\t\t\tUNION\r\n\t\t\tSELECT DISTINCT \r\n\t\t\t\tld_users2group.userid AS userid \r\n\t\t\tFROM ld_scoperhigher \r\n\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\tAND ld_scoperhigher.modulename ='Leads'\r\n\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Leads' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\tUNION \r\n\t\t\tSELECT \r\n\t\t\t\tid AS userid \r\n\t\t\tFROM ld_users  \r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\tUNION\r\n\t\t\tSELECT '[uuid]') AS vw_users\r\n\t) AS tmp_users ON tmp_users.userid=a.smownerid\r\n\tWHERE 1=1\r\n\t\tAND(\r\n\t\t\tCASE\r\n\t\t\t\tWHEN FIND_IN_SET(1,'{data_range}') OR '{data_range}'='' THEN 1=1\r\n\t\t\t\tWHEN FIND_IN_SET(2,'{data_range}') THEN a.smownerid='[uuid]'\r\n\t\t\t\tELSE \r\n\t\t\t\t\t\t\ta.smownerid IN (\r\n\t\t\t\t\t\t\t\t\tSELECT\r\n\t\t\t\t\t\t\t\t\t\ta.userid\r\n\t\t\t\t\t\t\t\t\tFROM ld_users2group a\r\n\t\t\t\t\t\t\t\t\tINNER JOIN (\r\n\t\t\t\t\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\t\t\t\t\tsubstring_index(substring_index(a.splitsting,',',b.seq+1),',',-1)-200000 AS groupid\r\n\t\t\t\t\t\t\t\t\t\tFROM (SELECT '{data_range}' AS splitsting) a \r\n\t\t\t\t\t\t\t\t\t\tLEFT JOIN sequence b ON b.seq < (length(a.splitsting) - length(replace(a.splitsting,',',''))+1) \r\n\t\t\t\t\t\t\t\t\t\tWHERE substring_index(substring_index(a.splitsting,',',b.seq+1),',',-1) BETWEEN 200000 AND 300000\r\n\t\t\t\t\t\t\t\t\t) b ON b.groupid=a.groupid\r\n\t\t\t\t\t\t\t\t\tGROUP BY a.userid\r\n\t\t\t\t\t\t\t\t\tUNION \r\n\t\t\t\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\t\t\t\tsubstring_index(substring_index(a.splitsting,',',b.seq+1),',',-1)-300000 AS groupid\r\n\t\t\t\t\t\t\t\t\tFROM (SELECT '{data_range}' AS splitsting) a \r\n\t\t\t\t\t\t\t\t\tLEFT JOIN sequence b ON b.seq < (length(a.splitsting) - length(replace(a.splitsting,',',''))+1) \r\n\t\t\t\t\t\t\t\t\tWHERE substring_index(substring_index(a.splitsting,',',b.seq+1),',',-1)>300000\r\n\t\t\t\t\t\t\t)\r\n\t\t\tEND)\r\n\t\tAND IFNULL(leadsource,'')<>'' \r\n\tGROUP BY leadsource\r\n) d ON d.leadsource=a.listvalue\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\tleadsource,\r\n\t\tSUM(cnt) AS cnt\r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\ta.accountid,\r\n\t\t\ta.leadsource,\r\n\t\t\t1 AS cnt\r\n\t\tFROM (\r\n\t\t\tSELECT\r\n\t\t\t\ta.smcreatorid AS smownerid,\r\n\t\t\t\tb.leadsource,\r\n\t\t\t\t1 AS add_leadtokh,\r\n\t\t\t\tb.accountid\r\n\t\t\tFROM ld_account a\r\n\t\t\tLEFT JOIN ld_accountscf b ON b.accountid=a.accountid\r\n\t\t\tinner JOIN ld_leads c ON c.upgradeaccountid=a.accountid\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND c.createdtime BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d 00:00:00') AND DATE_FORMAT('{end_date}','%Y-%m-%d 23:59:59')\r\n\t\t) a\r\n\t\tLEFT JOIN ld_potential b ON b.accountid=a.accountid\r\n\t\tINNER JOIN (\r\n\t\t\tSELECT DISTINCT\r\n\t\t\t\tuserid \r\n\t\t\tFROM (\r\n\t\t\t\tSELECT \r\n\t\t\t\t\tld_users.id AS userid \r\n\t\t\t\tFROM ld_users\r\n\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Leads' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT \r\n\t\t\t\t\tviewid AS userid \r\n\t\t\t\tFROM ld_scoperhigher\r\n\t\t\t\tWHERE userid='[uuid]' AND modulename ='Leads' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename ='Leads')\t\t\t\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT DISTINCT \r\n\t\t\t\t\tld_users2group.userid AS userid \r\n\t\t\t\tFROM ld_scoperhigher \r\n\t\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\t\tAND ld_scoperhigher.modulename ='Leads'\r\n\t\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Leads' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\t\tUNION \r\n\t\t\t\tSELECT \r\n\t\t\t\t\tid AS userid \r\n\t\t\t\tFROM ld_users  \r\n\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\t\tUNION\r\n\t\t\t\tSELECT '[uuid]') AS vw_users\r\n\t\t) AS tmp_users ON tmp_users.userid=a.smownerid\r\n\t\tWHERE 1=1\r\n\t\t\tAND(\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN FIND_IN_SET(1,'{data_range}') OR '{data_range}'='' THEN 1=1\r\n\t\t\t\t\tWHEN FIND_IN_SET(2,'{data_range}') THEN a.smownerid='[uuid]'\r\n\t\t\t\t\tELSE \r\n\t\t\t\t\t\t\t\ta.smownerid IN (\r\n\t\t\t\t\t\t\t\t\t\tSELECT\r\n\t\t\t\t\t\t\t\t\t\t\ta.userid\r\n\t\t\t\t\t\t\t\t\t\tFROM ld_users2group a\r\n\t\t\t\t\t\t\t\t\t\tINNER JOIN (\r\n\t\t\t\t\t\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\t\t\t\t\t\tsubstring_index(substring_index(a.splitsting,',',b.seq+1),',',-1)-200000 AS groupid\r\n\t\t\t\t\t\t\t\t\t\t\tFROM (SELECT '{data_range}' AS splitsting) a \r\n\t\t\t\t\t\t\t\t\t\t\tLEFT JOIN sequence b ON b.seq < (length(a.splitsting) - length(replace(a.splitsting,',',''))+1) \r\n\t\t\t\t\t\t\t\t\t\t\tWHERE substring_index(substring_index(a.splitsting,',',b.seq+1),',',-1) BETWEEN 200000 AND 300000\r\n\t\t\t\t\t\t\t\t\t\t) b ON b.groupid=a.groupid\r\n\t\t\t\t\t\t\t\t\t\tGROUP BY a.userid\r\n\t\t\t\t\t\t\t\t\t\tUNION \r\n\t\t\t\t\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\t\t\t\t\tsubstring_index(substring_index(a.splitsting,',',b.seq+1),',',-1)-300000 AS groupid\r\n\t\t\t\t\t\t\t\t\t\tFROM (SELECT '{data_range}' AS splitsting) a \r\n\t\t\t\t\t\t\t\t\t\tLEFT JOIN sequence b ON b.seq < (length(a.splitsting) - length(replace(a.splitsting,',',''))+1) \r\n\t\t\t\t\t\t\t\t\t\tWHERE substring_index(substring_index(a.splitsting,',',b.seq+1),',',-1)>300000\r\n\t\t\t\t\t\t\t\t)\r\n\t\t\t\tEND)\r\n\t\t\tAND b.deleted=0\r\n\t\t\tAND b.accountid>0\r\n\t\t\tAND b.createdtime BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d 00:00:00') AND DATE_FORMAT('{end_date}','%Y-%m-%d 23:59:59')\r\n\t\tGROUP BY a.accountid\r\n\t) a\r\n\tWHERE IFNULL(leadsource,'')<>''\r\n\tGROUP BY leadsource\r\n) e ON e.leadsource=a.listvalue\r\nWHERE b.listname='leadsource'\r\n\tAND IFNULL(c.add_lead,0)+ IFNULL(c.add_leadtokh,0)+IFNULL(c.add_leadtokhcg,0)+IFNULL(c.add_leadtosj,0)+IFNULL(d.cnt,0)+IFNULL(e.cnt,0)>0\r\nORDER BY (CASE WHEN c.add_lead>0 THEN IFNULL(c.add_leadtokh,0)/ c.add_lead ELSE 0 END) DESC "
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "list_users",
        "Alias": "list_users",
        "Columns": {
          "0": {
            "Name": "list_order",
            "Index": -1,
            "NameInSource": "list_order",
            "Alias": "list_order",
            "Type": "System.String"
          },
          "1": {
            "Name": "listid",
            "Index": -1,
            "NameInSource": "listid",
            "Alias": "listid",
            "Type": "System.Int32"
          },
          "2": {
            "Name": "listtype",
