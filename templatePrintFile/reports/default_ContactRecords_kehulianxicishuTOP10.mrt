            "Type": "System.String"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\ta.report_title,\r\n\tg.custname,\r\n\te.billno,\r\n\td.billdate AS billdate,\r\n\tCONCAT(IFNULL(c.tabname,''),IFNULL(b.billsmowner,'')) AS billsmowner,\r\n\tf.content\r\nFROM (\r\n\tSELECT \r\n\t\t1 AS id,\r\n\t\tb.fieldlabel AS report_title\r\n\tFROM ld_field a\r\n\tLEFT JOIN ld_tranlabel b ON b.trantable='ld_field' AND b.languagetype='zh' AND b.Relateid=a.fieldid\r\n\tWHERE a.tabid=6 \r\n\t\tAND a.columnname='accountname'\r\n\tLIMIT 1\r\n) a\r\nLEFT JOIN (\r\n\tSELECT \r\n\t\t1 AS id,\r\n\t\tb.fieldlabel AS custname\r\n\tFROM ld_field a\r\n\tLEFT JOIN ld_tranlabel b ON b.trantable='ld_field' AND b.languagetype='zh' AND b.Relateid=a.fieldid\r\n\tWHERE a.tablename='ld_contactrecords'\r\n\t\tAND a.columnname='accountid'\r\n\tLIMIT 1\r\n) g ON a.id=g.id\r\nLEFT JOIN (\r\n\tSELECT \r\n\t\t1 AS id,\r\n\t\tb.fieldlabel AS billsmowner\r\n\tFROM ld_field a\r\n\tLEFT JOIN ld_tranlabel b ON b.trantable='ld_field' AND b.languagetype='zh' AND b.Relateid=a.fieldid\r\n\tWHERE a.tablename='ld_contactrecords'\r\n\t\tAND a.columnname='smownerid'\r\n\tLIMIT 1\r\n) b ON a.id=b.id\r\nLEFT JOIN (\r\n\tSELECT \r\n\t\t1 AS id,\r\n\t\tb.fieldlabel AS tabname\r\n\tFROM ld_tab a\r\n\tLEFT JOIN ld_tranlabel b ON b.trantable='ld_tab' AND b.languagetype='zh' AND b.Relateid=a.tabid\r\n\tWHERE a.`name`='ContactRecords'\r\n\tLIMIT 1\r\n) c ON a.id=c.id\r\nLEFT JOIN (\r\n\tSELECT \r\n\t\t1 AS id,\r\n\t\tb.fieldlabel AS billdate\r\n\tFROM ld_field a\r\n\tLEFT JOIN ld_tranlabel b ON b.trantable='ld_field' AND b.languagetype='zh' AND b.Relateid=a.fieldid\r\n\tWHERE a.tablename='ld_contactrecords'\r\n\t\tAND a.columnname='contactdate'\r\n\tLIMIT 1\r\n) d ON a.id=d.id\r\nLEFT JOIN (\r\n\tSELECT \r\n\t\t1 AS id,\r\n\t\tb.fieldlabel AS billno\r\n\tFROM ld_field a\r\n\tLEFT JOIN ld_tranlabel b ON b.trantable='ld_field' AND b.languagetype='zh' AND b.Relateid=a.fieldid\r\n\tWHERE a.tablename='ld_contactrecords'\r\n\t\tAND a.columnname='contactrecord_no'\r\n\tLIMIT 1\r\n) e ON a.id=e.id\r\nLEFT JOIN (\r\n\tSELECT \r\n\t\t1 AS id,\r\n\t\tb.fieldlabel AS content\r\n\tFROM ld_field a\r\n\tLEFT JOIN ld_tranlabel b ON b.trantable='ld_field' AND b.languagetype='zh' AND b.Relateid=a.fieldid\r\n\tWHERE a.tablename='ld_contactrecords'\r\n\t\tAND a.columnname='content'\r\n\tLIMIT 1\r\n) f ON a.id=f.id"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "details",
        "Alias": "details",
        "Columns": {
          "0": {
