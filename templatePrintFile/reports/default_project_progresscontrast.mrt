        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\ta.keyid,\r\n\ta.project_no,\r\n\ta.projectid,\r\n\ta.projecttaskid,\r\n\ta.projectname,\r\n\r\n\ta.projecttaskname,\r\n\ta.progress,\r\n\ta.xm_owner,\r\n\ta.projectstatus,\r\n\ta.completetask,\r\n\r\n\t(SELECT DATE_FORMAT(MIN(startdate),'%Y-%m-%d') FROM ld_projecttask WHERE deleted=0 AND approvestatus<>'已拒绝' AND projectid=a.projectid) AS jh_startdate,\r\n\t(SELECT DATE_FORMAT(MAX(enddate),'%Y-%m-%d') FROM ld_projecttask WHERE deleted=0 AND approvestatus<>'已拒绝' AND projectid=a.projectid) AS jh_endate,\r\n\t(SELECT DATE_FORMAT(MIN(startdate),'%Y-%m-%d') FROM ld_projectprogress WHERE deleted=0 AND approvestatus<>'已拒绝' AND projectid=a.projectid AND projecttaskid>0) AS sj_startdate,\r\n\tCASE WHEN a.projectstatus='已完成' THEN (SELECT DATE_FORMAT(MIN(startdate),'%Y-%m-%d') FROM ld_projectprogress WHERE deleted=0 AND approvestatus<>'已拒绝' AND projectid=a.projectid AND projecttaskid>0) ELSE NULL END AS sj_endate,\r\n\r\n\ta.projecttaskstatus,\r\n\ta.startdate,\r\n\tCASE \r\n\t\tWHEN a.startdate<a.enddate THEN DATE_ADD(a.enddate,INTERVAL 86399 SECOND)\r\n\t\tWHEN a.enddate>=CURDATE() AND a.projecttaskstatus='进行中' THEN NOW()\r\n\t\tELSE DATE_ADD(a.enddate,INTERVAL 1 MINUTE) \r\n\tEND AS enddate,\r\n\ta.argumnt,\r\n\ta.color\r\nFROM (\r\n\tSELECT \r\n\t\ta.projecttaskid+s.seq*0.1 AS keyid,\r\n\t\tb.project_no,\r\n\t\ta.projectid,\r\n\t\ta.projecttaskid,\r\n\t\tb.projectname,\r\n\t\ta.projecttaskname,\r\n\t\ta.projecttaskprogress AS progress,\r\n\t\tv.last_name AS xm_owner,\r\n\t\tb.projectstatus,\r\n\t\tb.completetask,\r\n\t\ta.projecttaskstatus,\r\n\t\tCASE\r\n\t\t\tWHEN s.seq=1 THEN a.startdate\r\n\t\t\tELSE IFNULL(c.startdate,a.startdate)\r\n\t\tEND AS startdate,\r\n\t\tCASE\r\n\t\t\tWHEN s.seq=1 THEN a.enddate\r\n\t\t\tWHEN s.seq=2 AND (c.startdate>CURDATE() OR c.startdate IS NULL) THEN IFNULL(c.startdate,a.startdate)\r\n\t\t\tELSE c.enddate\r\n\t\tEND AS enddate,\r\n\t\tCONCAT('',\r\n\t\t\t\t\t'『',IFNULL(a.projecttaskname,''),'』-',\r\n\t\t\t\t\t'『',u.last_name,'』-',\r\n\t\t\t\t\t'『',(CASE WHEN s.seq=1 THEN '计划' ELSE '实际' END),'』-『',\r\n\t\t\t\t\t(CASE \r\n\t\t\t\t\t\tWHEN s.seq=1 THEN DATE_FORMAT(a.startdate,'%Y年%m月%d日')\r\n\t\t\t\t\t\tWHEN s.seq=2 AND (c.startdate>CURDATE() OR c.startdate IS NULL) THEN '待-----开------始'\r\n\t\t\t\t\t\tELSE DATE_FORMAT(c.startdate,'%Y年%m月%d日')\t\r\n\t\t\t\t\tEND),\r\n\t\t\t\t\t'』-『',\r\n\t\t\t\t\t(CASE \r\n\t\t\t\t\t\tWHEN s.seq=1 THEN DATE_FORMAT(a.enddate,'%Y年%m月%d日')\r\n\t\t\t\t\t\tWHEN s.seq=2 AND IFNULL(a.projecttaskstatus,'')<>'已完成' AND c.enddate>a.enddate THEN '已-----超------期'\r\n\t\t\t\t\t\tWHEN s.seq=2 AND IFNULL(a.projecttaskstatus,'')<>'已完成' AND c.enddate BETWEEN a.startdate AND a.enddate THEN '进-----行------中'\r\n\t\t\t\t\t\tWHEN s.seq=2 AND (c.startdate>CURDATE() OR c.startdate IS NULL) THEN '------------------'\r\n\t\t\t\t\t\tWHEN s.seq=2 AND IFNULL(a.projecttaskstatus,'')='已完成' THEN DATE_FORMAT(IFNULL(c.enddate,CURDATE()),'%Y年%m月%d日')\r\n\t\t\t\t\tEND),\r\n\t\t\t\t\t'』'\r\n\t\t\t) AS argumnt,\r\n\t\tCASE\t\r\n\t\t\tWHEN s.seq=1 THEN '0,176,240'\r\n\t\t\tWHEN s.seq=2 AND IFNULL(a.projecttaskstatus,'')<>'已完成' AND c.enddate>a.enddate THEN '255,0,0'\r\n\t\t\tWHEN s.seq=2 AND IFNULL(a.projecttaskstatus,'')<>'已完成' AND c.enddate BETWEEN a.startdate AND a.enddate THEN '255,255,0'\r\n\t\t\tWHEN s.seq=2 AND (c.startdate>CURDATE() OR c.startdate IS NULL) THEN '50,63,79'\r\n\t\t\tWHEN s.seq=2 AND IFNULL(a.projecttaskstatus,'')='已完成' THEN '146,208,80'\r\n\t\tEND AS color,\r\n\t\ts.seq\r\n\tFROM ld_projecttask a\r\n\tLEFT JOIN ld_project b ON b.projectid=a.projectid\r\n\tLEFT JOIN ld_users u ON u.id=a.smownerid\r\n\tLEFT JOIN ld_users v ON v.id=b.smownerid\r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\ta.projecttaskid,\r\n\t\t\tMIN(a.startdate) AS startdate,\r\n\t\t\tMAX(a.enddate) AS enddate\r\n\t\tFROM ld_projectprogress a\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\tAND a.projecttaskid>0\r\n\t\tGROUP BY a.projecttaskid\r\n\t) c ON c.projecttaskid=a.projecttaskid\r\n\tCROSS JOIN (SELECT seq FROM sequence WHERE seq BETWEEN 1 AND 2) s\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{xm_name}'='' THEN \r\n\t\t\t\t\ta.projectid=(\r\n\t\t\t\t\t\tSELECT\r\n\t\t\t\t\t\t\ta.projectid\r\n\t\t\t\t\t\tFROM ld_projecttask a\r\n\t\t\t\t\t\tINNER JOIN ld_project b ON b.projectid=a.projectid\r\n\t\t\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\t\t\tAND b.deleted=0\r\n\t\t\t\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\t\t\t\tAND b.approvestatus<>'已拒绝'\r\n\t\t\t\t\t\tORDER BY CONVERT(b.projectname USING GBK),a.startdate,a.enddate,a.projecttaskid\r\n\t\t\t\t\t\tLIMIT 1)\r\n\t\t\t\tELSE a.projectid='{xm_name}'\r\n\t\t\tEND)\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{jh_name}'='' THEN 1=1\r\n\t\t\t\tELSE FIND_IN_SET(a.projecttaskid,'{jh_name}')\r\n\t\t\tEND)\r\n)a\r\nORDER BY CONVERT(a.projecttaskname USING GBK) DESC,a.projecttaskid DESC,a.seq DESC"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "list_xmjh",
