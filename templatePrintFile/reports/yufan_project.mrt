        "NameInSource": "crm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\tprojectid,\r\n\taccountid,\r\n\ta01_fengongsi,\r\n\ta02_xiangmuno,\r\n\ta03_kehu,\r\n\ta04_ordertotal,\r\n\ta05_chanzhitotal,\r\n\r\n\tIFNULL(a07_rengong,0)+IFNULL(a08_zhejiu,0)+IFNULL(a09_zhafei,0)+IFNULL(a10_cailiao,0)+IFNULL(a11_fenbao,0) AS a06_xmcost,\r\n\ta07_rengong,\r\n\ta08_zhejiu,\r\n\ta09_zhafei,\r\n\ta10_cailiao,\r\n\ta11_fenbao,\r\n\r\n\tIFNULL(a05_chanzhitotal,0)-(IFNULL(a07_rengong,0)+IFNULL(a08_zhejiu,0)+IFNULL(a09_zhafei,0)+IFNULL(a10_cailiao,0)+IFNULL(a11_fenbao,0)) AS maoli,\r\n\t(IFNULL(a05_chanzhitotal,0)-(IFNULL(a07_rengong,0)+IFNULL(a08_zhejiu,0)+IFNULL(a09_zhafei,0)+IFNULL(a10_cailiao,0)+IFNULL(a11_fenbao,0)))/IFNULL(a05_chanzhitotal,0) AS maolilv,\r\n\r\n\ta12_fapiao,\r\n\ta13_hetong,\r\n\ta14_shoukuan,\r\n\tIFNULL(a05_chanzhitotal,0)-IFNULL(a14_shoukuan,0) AS a15_yingshouyue,\r\n\tIFNULL(a13_hetong,0)-IFNULL(a14_shoukuan,0) AS a16_xmyingshou\r\nFROM (\r\nSELECT\r\n\ta.projectid,\r\n\ta.accountid,\r\n\tb.cf_3345 AS a01_fengongsi,\r\n\ta.project_no AS a02_xiangmuno,\r\n\tc.accountname AS a03_kehu,\r\n\tb.cf_3646 AS a04_ordertotal,\r\n\td.chanzhi_total AS a05_chanzhitotal,\r\n\r\n\te.cost_rengong AS a07_rengong,\r\n\te.cost_zhejiu AS a08_zhejiu,\r\n\te.cost_zhafei AS a09_zhafei,\r\n\tf.chuku_total AS a10_cailiao,\r\n\tg.fenbaototal AS a11_fenbao,\r\n\th.fapiao_total AS a12_fapiao, \r\n\ti.hetong_total AS a13_hetong,\r\n\tj.shoukuan_total AS a14_shoukuan\r\nFROM ld_project a\r\nLEFT JOIN ld_projectcf b ON b.projectid=a.projectid\r\nLEFT JOIN ld_account c ON c.accountid=a.accountid\r\nLEFT JOIN (\r\n\tSELECT \r\n\t\ta.projectid,\r\n\t\t(sum(a.total)+sum(b.cf_4209)+sum(b.cf_4249)+sum(b.cf_4251)) AS chanzhi_total\r\n\tFROM ld_servicecontracts a\r\n\tLEFT JOIN ld_servicecontractscf b ON b.servicecontractsid=a.servicecontractsid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus='已批准'\r\n\t\tAND a.projectid>0\r\n\t\tAND b.cf_3879 BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n) d ON d.projectid=a.projectid\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\tc.entitytypeid,\r\n\t\tSUM(CASE WHEN c.expensetype IN ('项目其他工资','项目绩效工资') THEN d.rmb_total ELSE 0 END) AS cost_rengong,\r\n\t\tSUM(CASE WHEN c.expensetype IN ('项目设备折旧') THEN d.rmb_total ELSE 0 END) AS cost_zhejiu,\r\n\t\tSUM(CASE WHEN c.expensetype IN ('项目其他费用') THEN d.rmb_total ELSE 0 END) AS cost_zhafei\r\n\tFROM ld_expense a\r\n\tLEFT JOIN ld_expensedetail c ON c.expenseid=a.expenseid\r\n\tLEFT JOIN ld_expensedetailscf d ON d.expensedetailid=c.expensedetailid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus='已批准'\r\n\t\tAND c.entitytypeid>0\r\n\t\tAND a.expensedate BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d') \r\n\tGROUP BY c.entitytypeid\r\n) e ON e.entitytypeid=a.projectid\r\nLEFT JOIN (\r\n\tSELECT \r\n\t\ta.projectid,\r\n\t\tSUM(a.total) AS chuku_total\r\n\tFROM ld_outboundorder a\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus='已批准'\r\n\t\tAND a.projectid>0\r\n\t\tAND a.outdate BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n) f ON f.projectid=a.projectid\r\nLEFT JOIN (\r\n\tSELECT \r\n\t\ta.projectid,\r\n\t\tSUM(a.total) AS fenbaototal\r\n\tFROM ld_customform14 a\r\n\tLEFT JOIN ld_customform14scf b ON b.customform14id=a.customform14id\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus='已批准'\r\n\t\tAND a.projectid>0\r\n\t\tAND b.cf_3981 BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n) g ON g.projectid=a.projectid\r\nLEFT JOIN (\r\n\tSELECT \r\n\t\ta.projectid,\r\n\t\tSUM(a.total) AS fapiao_total\r\n\tFROM ld_invoice a\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus='已批准'\r\n\t\tAND a.projectid>0\r\n\t\tAND a.invoicedate<=DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n) h ON h.projectid=a.projectid\r\nLEFT JOIN (\r\n\tSELECT \r\n\t\ta.projectid,\r\n\t\tSUM(a.total) AS hetong_total\r\n\tFROM ld_salesorder a\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus='已批准'\r\n\t\tAND a.projectid>0\r\n\t\tAND a.signed_data<=DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n) i ON h.projectid=a.projectid\r\nLEFT JOIN (\r\n\tSELECT \r\n\t\ta.projectid,\r\n\t\tSUM(a.total) AS shoukuan_total\r\n\tFROM ld_cashbill a\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus='已批准'\r\n\t\tAND a.projectid>0\r\n\t\tAND a.cashbilldate<=DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n) j ON h.projectid=a.projectid\r\nWHERE a.deleted=0\r\n\tAND a.createdtime BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d 00:00:00') AND DATE_FORMAT('{end_date}','%Y-%m-%d 23:59:59') \r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN TRIM('{custname}')='' THEN 1=1\r\n\t\t\tELSE LOCATE(TRIM('{custname}'),c.accountname)>0\r\n\t\tEND) \r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN TRIM('{xmno}')='' THEN 1=1\r\n\t\t\tELSE LOCATE(TRIM('{xmno}'),a.project_no)>0\r\n\t\tEND) \r\n) t"
      }
    },
