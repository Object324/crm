          },
          "9": {
            "Name": "port_start",
            "Index": -1,
            "NameInSource": "port_start",
            "Alias": "port_start",
            "Type": "System.String"
          },
          "10": {
            "Name": "real_flightdate",
            "Index": -1,
            "NameInSource": "real_flightdate",
            "Alias": "real_flightdate",
            "Type": "System.String"
          },
          "11": {
            "Name": "real_flightno",
            "Index": -1,
            "NameInSource": "real_flightno",
            "Alias": "real_flightno",
            "Type": "System.String"
          }
        },
        "NameInSource": "crm",
        "Type": "Table",
        "SqlCommand": "SELECT \r\n\tCONCAT('Port of Loading: ',IFNULL(a.start_port,'')) AS port_start,\r\n\tCONCAT('Port of Destination: ',IFNULL(a.end_port,'')) AS port_end,\r\n\tCONCAT('Flight No.: ',IFNULL(a.real_flightno,'')) AS real_flightno,\r\n\tCONCAT('Flight Date: ',IFNULL(DATE_FORMAT(a.real_flightdate,'%m.%d.%Y'),'')) AS real_flightdate,\r\n\ta.masterorder_no,\r\n\tSUM(d.sf171) AS mast_qty,\r\n\tb.cf_3811 AS master_wight,\r\n\ta.masterorder_shipper,\r\n\ta.masterorder_shipperaddress,\r\n\ta.masterorder_receiver,\r\n\ta.masterorder_receiveraddress,\r\n\tCASE\r\n\t\tWHEN COUNT(1)>0 THEN 'CONSOLIDATED SHPT AS PER ATTACHED CARGO MANIFEST'\r\n\t\tELSE d.sf170\r\n\tEND AS goods\r\nFROM ld_customform25 a\r\nLEFT JOIN ld_customform25scf b ON b.customform25id=a.customform25id\r\nLEFT JOIN ld_customform25detail c ON c.id=a.customform25id\r\nLEFT JOIN ld_customform25detailscf d ON d.lineitem_id=c.lineitem_id\r\nWHERE a.customform25id='[related_ldcrmid]' \r\nGROUP BY a.customform25id"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "b",
        "Alias": "b",
        "Columns": {
          "0": {
            "Name": "bill_no",
            "Index": -1,
            "NameInSource": "bill_no",
            "Alias": "bill_no",
            "Type": "System.String"
          },
          "1": {
            "Name": "goods",
            "Index": -1,
            "NameInSource": "goods",
            "Alias": "goods",
            "Type": "System.String"
          },
          "2": {
            "Name": "pkg",
            "Index": -1,
            "NameInSource": "pkg",
            "Alias": "pkg",
            "Type": "System.String"
          },
          "3": {
            "Name": "ship_address",
            "Index": -1,
            "NameInSource": "ship_address",
            "Alias": "ship_address",
            "Type": "System.String"
          },
          "4": {
            "Name": "ship_name",
            "Index": -1,
            "NameInSource": "ship_name",
            "Alias": "ship_name",
            "Type": "System.String"
          },
          "5": {
            "Name": "shou_address",
            "Index": -1,
            "NameInSource": "shou_address",
            "Alias": "shou_address",
            "Type": "System.String"
          },
          "6": {
            "Name": "shou_name",
            "Index": -1,
            "NameInSource": "shou_name",
            "Alias": "shou_name",
            "Type": "System.String"
          },
          "7": {
            "Name": "wight",
            "Index": -1,
            "NameInSource": "wight",
            "Alias": "wight",
            "Type": "System.Object"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT \r\n\td.sf169 AS bill_no,\r\n\tCONCAT(IFNULL(d.sf171,0),IFNULL(d.sf172,'')) AS pkg,\r\n\td.sf173 AS wight,\r\n\td.sf176 AS ship_name,\r\n\td.sf177 AS ship_address,\r\n\td.sf178 AS shou_name,\r\n\td.sf179 AS shou_address,\r\n\td.sf170 AS goods\r\nFROM ld_customform25 a\r\nLEFT JOIN ld_customform25scf b ON b.customform25id=a.customform25id\r\nLEFT JOIN ld_customform25detail c ON c.id=a.customform25id\r\nLEFT JOIN ld_customform25detailscf d ON d.lineitem_id=c.lineitem_id\r\nWHERE a.customform25id='[related_ldcrmid]' "
      }
    },
