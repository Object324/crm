        "SqlCommand": "SELECT\r\n\t*\r\nFROM (\r\nSELECT\r\n\ts1.smownerid AS ownerid_s1,\r\n\ts2.smownerid AS ownerid_s2,\r\n\ts3.smownerid AS ownerid_s3,\r\n\ts4.smownerid AS ownerid_s4,\r\n\t(SELECT GROUP_CONCAT(DISTINCT viewuserid ORDER BY viewuserid) FROM ld_tabshare WHERE crmid=s1.billid OR crmid=s2.billid OR crmid=s3.billid OR crmid=s4.billid) AS 00_shareids,\r\n\ts1.xm_no AS 02_no,\r\n\tCASE\r\n\t\tWHEN s4.xm_no IS NOT NULL THEN s4.xm_status\r\n\t\tWHEN s3.xm_no IS NOT NULL THEN 'S3'\r\n\t\tWHEN s2.xm_no IS NOT NULL THEN 'S2'\r\n\t\tELSE 'S1'\r\n\tEND AS 03_status,\r\n\tCASE\r\n\t\tWHEN s4.xm_no IS NOT NULL THEN 1\r\n\t\tWHEN s3.xm_no IS NOT NULL THEN 2\r\n\t\tWHEN s2.xm_no IS NOT NULL THEN 3\r\n\t\tELSE 4\r\n\tEND AS 03_status_seq,\r\n\tCASE\r\n\t\tWHEN s4.xm_no IS NOT NULL THEN 1\r\n\t\tWHEN s3.xm_no IS NOT NULL THEN 2\r\n\t\tWHEN s2.xm_no IS NOT NULL THEN 3\r\n\t\tELSE 4\r\n\tEND AS 03_ishuoyue,\r\n\tCASE\r\n\t\tWHEN s4.xm_no IS NOT NULL THEN s4.accountname\r\n\t\tWHEN s3.xm_no IS NOT NULL THEN s3.accountname\r\n\t\tWHEN s2.xm_no IS NOT NULL THEN s2.accountname\r\n\t\tELSE s1.accountname\r\n\tEND AS 04_kehu,\r\n\tCASE\r\n\t\tWHEN s4.xm_no IS NOT NULL THEN s4.xiangmuhao\r\n\t\tWHEN s3.xm_no IS NOT NULL THEN s3.xiangmuhao\r\n\t\tWHEN s2.xm_no IS NOT NULL THEN s2.xiangmuhao\r\n\t\tELSE s1.xiangmuhao\r\n\tEND AS 05_xiangmuhao,\r\n\tCASE\r\n\t\tWHEN s4.xm_no IS NOT NULL THEN s4.smowner\r\n\t\tWHEN s3.xm_no IS NOT NULL THEN s3.smowner\r\n\t\tWHEN s2.xm_no IS NOT NULL THEN s2.smowner\r\n\t\tELSE s1.smowner\r\n\tEND AS 06_fuzeren,\r\n\tCASE\r\n\t\tWHEN s4.xm_no IS NOT NULL THEN s4.team\r\n\t\tWHEN s3.xm_no IS NOT NULL THEN s3.team\r\n\t\tWHEN s2.xm_no IS NOT NULL THEN s2.team\r\n\t\tELSE s1.team\r\n\tEND AS 07_team,\r\n\tCASE\r\n\t\tWHEN s4.xm_no IS NOT NULL THEN s4.pro_amount\r\n\t\tWHEN s3.xm_no IS NOT NULL THEN s3.pro_amount\r\n\t\tWHEN s2.xm_no IS NOT NULL THEN s2.pro_amount\r\n\t\tELSE s1.pro_amount\r\n\tEND AS 08_pro_amount,\r\n\tCASE\r\n\t\tWHEN s4.xm_no IS NOT NULL THEN s4.pro_volume\r\n\t\tWHEN s3.xm_no IS NOT NULL THEN s3.pro_volume\r\n\t\tWHEN s2.xm_no IS NOT NULL THEN s2.pro_volume\r\n\t\tELSE s1.pro_volume\r\n\tEND AS 09_pro_volume,\r\n\tCASE\r\n\t\tWHEN s4.xm_no IS NOT NULL THEN s4.pingtaiA\r\n\t\tWHEN s3.xm_no IS NOT NULL THEN s3.pingtaiA\r\n\t\tWHEN s2.xm_no IS NOT NULL THEN s2.pingtaiA\r\n\t\tELSE s1.pingtaiA\r\n\tEND AS 10_pingtaiA,\r\n\r\n\r\n\tCASE\r\n\t\tWHEN s4.xm_no IS NOT NULL THEN s4.pingtaiB\r\n\t\tWHEN s3.xm_no IS NOT NULL THEN s3.pingtaiB\r\n\t\tWHEN s2.xm_no IS NOT NULL THEN s2.pingtaiB\r\n\t\tELSE s1.pingtaiB\r\n\tEND AS 11_pingtaiB,\r\n\tCASE\r\n\t\tWHEN s4.xm_no IS NOT NULL THEN s4.chanpin_leixing\r\n\t\tWHEN s3.xm_no IS NOT NULL THEN s3.chanpin_leixing\r\n\t\tWHEN s2.xm_no IS NOT NULL THEN s2.chanpin_leixing\r\n\t\tELSE s1.chanpin_leixing\r\n\tEND AS 12_productleixing,\r\n\tCASE\r\n\t\tWHEN s4.xm_no IS NOT NULL THEN s4.chanpin_nameIC\r\n\t\tWHEN s3.xm_no IS NOT NULL THEN s3.chanpin_nameIC\r\n\t\tELSE NULL\r\n\tEND AS 13_productnameIC,\r\n\tCASE\r\n\t\tWHEN s4.xm_no IS NOT NULL THEN s4.chanpin_xingtai\r\n\t\tWHEN s3.xm_no IS NOT NULL THEN s3.chanpin_xingtai\r\n\t\tWHEN s2.xm_no IS NOT NULL THEN s2.chanpin_xingtai\r\n\t\tELSE s1.chanpin_xingtai\r\n\tEND AS 14_productstyle,\r\n\tCASE\r\n\t\tWHEN s4.xm_no IS NOT NULL THEN s4.last_kehu\r\n\t\tWHEN s3.xm_no IS NOT NULL THEN s3.last_kehu\r\n\t\tWHEN s2.xm_no IS NOT NULL THEN s2.last_kehu\r\n\t\tELSE s1.last_kehu\r\n\tEND AS 15_zhongduankehu,\r\n\tCASE\r\n\t\tWHEN s4.xm_no IS NOT NULL THEN s4.EMS\r\n\t\tWHEN s3.xm_no IS NOT NULL THEN s3.EMS\r\n\t\tWHEN s2.xm_no IS NOT NULL THEN s2.EMS\r\n\t\tELSE s1.EMS\r\n\tEND AS 16_EMS,\r\n\tCASE\r\n\t\tWHEN s4.xm_no IS NOT NULL THEN s4.DLS\r\n\t\tWHEN s3.xm_no IS NOT NULL THEN s3.DLS\r\n\t\tWHEN s2.xm_no IS NOT NULL THEN s2.DLS\r\n\t\tELSE s1.DLS\r\n\tEND AS 17_dailishang,\r\n\tCASE\r\n\t\tWHEN s4.xm_no IS NOT NULL THEN s4.rel_saleser\r\n\t\tWHEN s3.xm_no IS NOT NULL THEN s3.rel_saleser\r\n\t\tWHEN s2.xm_no IS NOT NULL THEN s2.rel_saleser\r\n\t\tELSE s1.rel_saleser\r\n\tEND AS 18_guanlianxiaoshou,\r\n\r\n\tROUND(s4.quote_price_jy,2) AS a02_pricejy,\r\n\tROUND(s4.quote_price_dl,2) AS a03_pricedl,\r\n\tROUND(s4.quote_price_dg,2) AS a04_pricedg,\r\n\tROUND(s4.quote_price_pp,2) AS a05_pricepp,\r\n\tROUND(s4.quote_price_cb,2) AS a06_pricecb,\r\n\ts4.quote_lirun AS a07_lirun,\r\n\ts4.quote_lirun_dl AS a08_lirundl,\r\n\ts4.quote_lirun_dg AS a09_lirundg,\r\n\ts2.jingpinpp AS a10_jingpinpp,\r\n\ts2.jingpinxh AS a10_jingpinxh,\r\n\ts2.jingpinprice AS a11_jingpinprice\r\nFROM (\r\n\tSELECT\r\n\t\ta.leadsid AS billid,\r\n\t\ta.leads_no  AS xm_no,\r\n\t\t'S1' AS xm_status,\r\n\t\tk.accountname,\r\n\t\tu.last_name AS smowner,\r\n\t\tNULL AS team,\r\n\t\tb.cf_3682 AS pro_amount,\r\n\t\tb.cf_3603 AS pro_volume,\r\n\t\tb.cf_4811 AS pingtaiA,\r\n\t\tb.cf_4810 AS pingtaiB,\r\n\t\tNULL AS chanpin_leixing,\r\n\t\tb.cf_3942 AS chanpin_xingtai,\r\n\t\tNULL AS last_kehu,\r\n\t\tNULL AS EMS,\r\n\t\tNULL AS DLS,\r\n\t\tb.cf_3752 AS rel_saleser,\r\n\t\tNULL AS xiangmuhao,\r\n\t\tCASE\r\n\t\t\t WHEN b.cf_2995='否' THEN 'yes'\r\n\t\t\t ELSE 'no'\r\n\t\tEND AS is_defshow,\r\n\t\ta.smownerid\r\n\tFROM ld_leads a\r\n\tLEFT JOIN ld_leadscf b ON b.leadsid=a.leadsid\r\n\tLEFT JOIN ld_users u ON u.id=a.smownerid\r\n\tLEFT JOIN ld_account k ON k.accountid=a.accountid\r\n\tWHERE a.deleted=0\r\n\t\tAND IFNULL(a.leads_no,'')<>''\r\n\tGROUP BY a.leads_no\r\n) s1\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\ta.potentialid AS billid,\r\n\t\tb.cf_3341 AS xm_no,\r\n\t\t'S2' AS xm_status,\r\n\t\tk.accountname,\r\n\t\tu.last_name AS smowner,\r\n\t\tb.cf_3453 AS team,\r\n\t\ta.amount AS pro_amount,\r\n\t\tb.cf_3744 AS pro_volume,\r\n\t\tb.cf_4812 AS pingtaiA,\r\n\t\tb.cf_4813 AS pingtaiB,\r\n\t\tb.cf_3426 AS chanpin_leixing,\r\n\t\tb.cf_3943 AS chanpin_xingtai,\r\n\t\tb.cf_3347 AS last_kehu,\r\n\t\tb.cf_3294 AS EMS,\r\n\t\tb.cf_3452 AS DLS,\r\n\t\tb.cf_3777 AS rel_saleser,\r\n\t\tb.cf_3332 AS xiangmuhao,\r\n\t\tb.cf_3342 AS jingpinpp,\r\n\t\tb.cf_3343 AS jingpinxh,\r\n\t\tb.cf_3344 AS jingpinprice,\r\n\t\tCASE\r\n\t\t\t WHEN b.cf_3340='否' THEN 'yes'\r\n\t\t\t ELSE 'no'\r\n\t\tEND AS is_defshow,\r\n\t\ta.smownerid\r\n\tFROM ld_potential a\r\n\tLEFT JOIN ld_potentialscf b ON b.potentialid=a.potentialid\r\n\tLEFT JOIN ld_users u ON u.id=a.smownerid\r\n\tLEFT JOIN ld_account k ON k.accountid=a.accountid\r\n\tWHERE a.deleted=0\r\n\t\tAND IFNULL(b.cf_3341,'')<>''\r\n\tGROUP BY b.cf_3341\r\n) s2 ON s2.xm_no=s1.xm_no\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\ta.customform22id AS billid,\r\n\t\tc.cf_3341 AS xm_no,\r\n\t\t'S3' AS xm_status,\r\n\t\tk.accountname,\r\n\t\tu.last_name AS smowner,\r\n\t\tb.cf_3706 AS team,\r\n\t\tb.cf_3782 AS pro_amount,\r\n\t\tb.cf_3781 AS pro_volume,\r\n\t\tb.cf_4814 AS pingtaiA,\r\n\t\tb.cf_4815 AS pingtaiB,\r\n\t\tb.cf_3784 AS chanpin_leixing,\r\n\t\tb.cf_3944 AS chanpin_xingtai,\r\n\t\tb.cf_3118 AS chanpin_nameIC,\r\n\t\tb.cf_3533 AS last_kehu,\r\n\t\tb.cf_3532 AS EMS,\r\n\t\tb.cf_3531 AS DLS,\r\n\t\tb.cf_3778 AS rel_saleser,\r\n\t\tb.cf_3527 AS xiangmuhao,\r\n\t\tCASE\r\n\t\t\t WHEN b.cf_3077='否' THEN 'yes'\r\n\t\t\t ELSE 'no'\r\n\t\tEND AS is_defshow,\r\n\t\ta.smownerid\r\n\tFROM ld_customform22 a\r\n\tLEFT JOIN ld_customform22scf b ON b.customform22id=a.customform22id\r\n\tLEFT JOIN ld_potentialscf c ON c.potentialid=a.potentialid\r\n\tLEFT JOIN ld_users u ON u.id=a.smownerid\r\n\tLEFT JOIN ld_account k ON k.accountid=a.accountid\r\n\tWHERE a.deleted=0\r\n\t\tAND IFNULL(c.cf_3341,'')<>''\r\n\tGROUP BY c.cf_3341\r\n) s3 ON s3.xm_no=s1.xm_no\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\ta.customform21id AS billid,\r\n\t\ta.quote_id,\r\n\t\tb.cf_3458 AS xm_no,\r\n\t\tb.cf_3457 AS xm_status,\r\n\t\tk.accountname,\r\n\t\tu.last_name AS smowner,\r\n\t\tb.cf_3707 AS team,\r\n\t\tNULL AS pro_amount,\r\n\t\tNULL AS pro_volume,\r\n\t\tb.cf_4816 AS pingtaiA,\r\n\t\tb.cf_4817 AS pingtaiB,\r\n\t\tb.cf_3785 AS chanpin_leixing,\r\n\t\tb.cf_3945 AS chanpin_xingtai,\r\n\t\tCASE\r\n\t\t\tWHEN b.cf_3785='Module' THEN b.cf_4006\r\n\t\t\tELSE b.cf_3124 \r\n\t\tEND AS chanpin_nameIC,\r\n\t\tb.cf_3537 AS last_kehu,\r\n\t\tb.cf_3536 AS EMS,\r\n\t\tb.cf_3535 AS DLS,\r\n\t\tb.cf_4656 AS rel_saleser,\r\n\t\tb.cf_3528 AS xiangmuhao,\r\n\t\t\r\n\t\ta.quote_price_jy,\r\n\t\ta.quote_price_dl,\r\n\t\ta.quote_price_dg,\r\n\t\ta.quote_price_pp,\r\n\t\ta.quote_price_cb,\r\n\t\ta.quote_lirun,\r\n\t\ta.quote_lirun_dl,\r\n\t\ta.quote_lirun_dg,\r\n\t\tCASE\r\n\t\t\t WHEN b.cf_2968='否' OR b.cf_3457='EOL' THEN 'yes'\r\n\t\t\t ELSE 'no'\r\n\t\tEND AS is_defshow,\r\n\t\ta.smownerid\r\n\tFROM ld_customform21 a\r\n\tLEFT JOIN ld_customform21scf b ON b.customform21id=a.customform21id\r\n\tLEFT JOIN ld_users u ON u.id=a.smownerid\r\n\tLEFT JOIN ld_account k ON k.accountid=a.accountid\r\n\tWHERE a.deleted=0\r\n\t\tAND IFNULL(b.cf_3458,'')<>''\r\n\tGROUP BY b.cf_3458\r\n) s4 ON s4.xm_no=s1.xm_no\r\nWHERE 1=1 \r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN TRIM('{ponum}')='' THEN 1=1\r\n\t\t\tELSE LOCATE(TRIM('{ponum}'),s1.xm_no)>0\r\n\t\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{main_item}'='true' THEN \r\n\t\t\t\t (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN s4.xm_no IS NOT NULL THEN s4.is_defshow\r\n\t\t\t\t\t\tWHEN s3.xm_no IS NOT NULL THEN s3.is_defshow\r\n\t\t\t\t\t\tWHEN s2.xm_no IS NOT NULL THEN s2.is_defshow\r\n\t\t\t\t\t\tELSE s1.is_defshow\r\n\t\t\t\t\tEND\r\n\t\t\t\t)='yes'\r\n\t\t\tELSE 1=1\r\n\t\tEND) \r\n) tmp\r\nWHERE 1=1\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_users WHERE id='[uuid]' AND userlevel IN ('管理员','总经理','副总经理','总监')) THEN 1=1\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_users WHERE id='[uuid]' AND userlevel IN ('普通成员')) THEN\r\n\t\t\t\townerid_s1='[uuid]' OR ownerid_s2='[uuid]' OR ownerid_s3='[uuid]' OR ownerid_s4='[uuid]' OR FIND_IN_SET('[uuid]',00_shareids)\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_users WHERE id='[uuid]' AND userlevel IN ('部门经理')) THEN\r\n\t\t\t\townerid_s1 IN (SELECT userid FROM ld_users2group WHERE groupid IN (SELECT groupid FROM ld_users2group WHERE userid='[uuid]'))\r\n\t\t\t\tOR ownerid_s2 IN (SELECT userid FROM ld_users2group WHERE groupid IN (SELECT groupid FROM ld_users2group WHERE userid='[uuid]'))\r\n\t\t\t\tOR ownerid_s3 IN (SELECT userid FROM ld_users2group WHERE groupid IN (SELECT groupid FROM ld_users2group WHERE userid='[uuid]'))\t\r\n\t\t\t\tOR ownerid_s4 IN (SELECT userid FROM ld_users2group WHERE groupid IN (SELECT groupid FROM ld_users2group WHERE userid='[uuid]'))\t\t\r\n\t\t\t\tOR FIND_IN_SET('[uuid]',00_shareids)\r\n\t\t\tELSE 0=1\r\n\t\tEND)\r\nORDER BY 03_status_seq,FIELD(03_status,'S4','EOL','S3','S2','S1'),02_no"
      },
      "2": {
        "Ident": "StiMySqlSource",
        "Name": "c",
        "Alias": "c",
        "Columns": {
          "0": {
            "Name": "tips_s1",
