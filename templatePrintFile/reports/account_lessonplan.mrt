            "Type": "System.String"
          }
        },
        "NameInSource": "crm",
        "Type": "Table",
        "SqlCommand": "SELECT accountname FROM ld_account WHERE accountid='[related_ldcrmid]'"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "b",
        "Alias": "b",
        "Columns": {
          "0": {
            "Name": "address",
            "Index": -1,
            "NameInSource": "address",
            "Alias": "address",
            "Type": "System.String"
          },
          "1": {
            "Name": "banji",
            "Index": -1,
