          },
          "2": {
            "Name": "jiaoshi",
            "Index": -1,
            "NameInSource": "jiaoshi",
            "Alias": "jiaoshi",
            "Type": "System.String"
          },
          "3": {
            "Name": "kaoqin_status",
            "Index": -1,
            "NameInSource": "kaoqin_status",
            "Alias": "kaoqin_status",
            "Type": "System.String"
          },
          "4": {
            "Name": "kechengname",
            "Index": -1,
            "NameInSource": "kechengname",
            "Alias": "kechengname",
            "Type": "System.String"
          },
          "5": {
            "Name": "lessiondate",
            "Index": -1,
            "NameInSource": "lessiondate",
            "Alias": "lessiondate",
            "Type": "System.DateTime"
          },
          "6": {
            "Name": "teacher",
            "Index": -1,
            "NameInSource": "teacher",
            "Alias": "teacher",
            "Type": "System.String"
          },
          "7": {
            "Name": "time",
            "Index": -1,
            "NameInSource": "time",
            "Alias": "time",
            "Type": "System.String"
          }
        },
        "NameInSource": "crm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\ta.kechengname,\r\n\tc.projectname AS banji,\r\n\tf.projectmilestonename AS teacher,\r\n\td.projecttaskname AS jiaoshi,\r\n\te.cf_2749 AS address,\r\n\tb.lessiondate,\r\n\tCONCAT(IFNULL(b.starttime,''),' ~ ',IFNULL(b.endtime,'')) AS time,\r\n\tkaoqin_status\r\nFROM (\r\n\tSELECT\r\n\t\tb.entitytypeid,\r\n\t\tc.subject AS kechengname\r\n\tFROM ld_salesorder a\r\n\tLEFT JOIN ld_salesorderdetail b ON b.id=a.salesorderid\r\n\tLEFT JOIN ld_servicecontracts c ON c.servicecontractsid=b.entitytypeid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND b.entitytypeid>0\r\n\t\tAND a.accountid='[related_ldcrmid]'\r\n\tGROUP BY b.entitytypeid\r\n) a\r\nINNER JOIN (\r\n\tSELECT\r\n\t\tlessiondate,\r\n\t\tprojectid,\r\n\t\tservicecontractsid,\r\n\t\tprojectmilestoneid,\r\n\t\tprojecttaskid,\r\n\t\tstarttime,\r\n\t\tendtime\r\n\tFROM ld_lessionplan\r\n\tWHERE deleted=0\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{showonly}'='true' THEN lessiondate>=CURDATE()\r\n\t\t\t\tELSE 1=1\r\n\t\t\tEND) \r\n) b ON b.servicecontractsid=a.entitytypeid\r\nLEFT JOIN ld_project c ON c.projectid=b.projectid\r\nLEFT JOIN ld_projecttask d ON d.projecttaskid=b.projecttaskid\r\nLEFT JOIN ld_projecttaskcf e ON e.projecttaskid=d.projecttaskid\r\nLEFT JOIN ld_projectmilestone f ON f.projectmilestoneid=b.projectmilestoneid\r\nLEFT JOIN (\r\nSELECT\r\n\ta.servicecontractsid,\r\n\ta.projectid,\r\n\ta.projectmilestone_id,\r\n\ta.kaoqin_date,\r\n\tb.entitytypeid,\r\n\tb.kaoqin_status\r\nFROM ld_customform21 a\r\nLEFT JOIN ld_customform21detail b ON b.id=a.customform21id\r\nWHERE a.deleted=0\r\n\tAND b.entitytypeid='[related_ldcrmid]'\r\n\tAND a.approvestatus<>'已拒绝'\r\n\tAND a.kaoqin_date>'2000-01-01'\r\n\tAND b.entitytypeid>0\r\nGROUP BY a.kaoqin_date,a.servicecontractsid,a.projectid,a.projectmilestone_id\r\n) g ON g.servicecontractsid=b.servicecontractsid AND g.projectid=b.projectid AND g.projectmilestone_id=b.projectmilestoneid AND g.kaoqin_date=b.lessiondate\r\nWHERE 1=1\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN TRIM('{myke}')='' THEN 1=1\r\n\t\t\tELSE LOCATE(TRIM('{myke}'),a.kechengname)>0\r\n\t\tEND) \r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN TRIM('{myban}')='' THEN 1=1\r\n\t\t\tELSE LOCATE(TRIM('{myban}'),c.projectname)>0\r\n\t\tEND) \r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN TRIM('{mylaoshi}')='' THEN 1=1\r\n\t\t\tELSE LOCATE(TRIM('{mylaoshi}'),f.projectmilestonename)>0\r\n\t\tEND) \r\nORDER BY CONVERT(a.kechengname USING GBK),a.entitytypeid,CONVERT(c.projectname USING GBK),\r\n\tCONVERT(d.projecttaskname USING GBK),b.lessiondate,b.starttime,b.endtime"
      }
    },
