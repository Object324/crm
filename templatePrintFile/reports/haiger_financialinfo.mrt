            "NameInSource": "zhekou_two",
            "Alias": "zhekou_two",
            "Type": "System.Decimal"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\ta.productgroup_name AS chanpinzu,\r\n\ta.standardprice_total,\r\n\ta.zhekou_this,\r\n\tROUND(a.zhekou,4) AS zhekou,\r\n\tCONCAT(IFNULL(a.productgroup_name,''),':',ROUND(IFNULL(a.zhekou_this,0)*100,2)) AS listname,\r\n\tROUND(IFNULL(b.discount_percent3,100)*0.01,4) AS zhekou_one,\r\n\tROUND(IFNULL(b.discount_percent4,100)*0.01,4) AS zhekou_two,\r\n\tROUND(IFNULL(b.discount_percent5,100)*0.01,4) AS zhekou_three,\r\n\tROUND(a.standardprice_total*(1-ROUND(a.zhekou,8)),8) AS net_value,\r\n\tROUND(a.gcm,4) AS gcm,\r\n\tROUND(a.spe,4) AS spe,\r\n\tROUND(a.specnt,4) AS specnt,\r\n\t(ROUND(a.zhekou,4)-ROUND(IFNULL(b.discount_percent3,100)*0.01,4))*a.standardprice_total AS below_I,\r\n\t(ROUND(a.zhekou,4)-ROUND(IFNULL(b.discount_percent4,100)*0.01,4))*a.standardprice_total AS below_II,\r\n\t(ROUND(a.zhekou,4)-ROUND(IFNULL(b.discount_percent5,100)*0.01,4))*a.standardprice_total AS below_III,\r\n\tCASE\r\n\t\tWHEN (ROUND(a.zhekou,4)-ROUND(IFNULL(b.discount_percent3,100)*0.01,4))*a.standardprice_total>0 THEN 1\r\n\t\tELSE 0\r\n\tEND AS color_I,\t\r\n\tCASE\r\n\t\tWHEN (ROUND(a.zhekou,4)-ROUND(IFNULL(b.discount_percent4,100)*0.01,4))*a.standardprice_total>0 THEN 1\r\n\t\tELSE 0\r\n\tEND AS color_II,\t\r\n\tCASE\r\n\t\tWHEN (ROUND(a.zhekou,4)-ROUND(IFNULL(b.discount_percent5,100)*0.01,4))*a.standardprice_total>0 THEN 1\r\n\t\tELSE 0\r\n\tEND AS color_III,\t\r\n\ta.quantity,\r\n\tc.gcm_target,\r\n\tCASE WHEN IFNULL(d.avg_discount,'')='' THEN NULL ELSE d.avg_discount*0.01 END AS avgvalue_banshichu,\t\t\r\n\tCASE WHEN IFNULL(e.avg_discount,'')='' THEN NULL ELSE e.avg_discount*0.01 END AS avgvalue_area,\r\n\ta.max_zhekou*0.01 AS max_zhekou,\r\n\ta.min_zhekou*0.01 AS min_zhekou\r\nFROM (\r\n\tSELECT\r\n\t\tt.productgroup_id,\r\n\t\tt.productgroup_name,\r\n\t\tt.zhekou_this,\r\n\t\tt.zhekou_change,\r\n\t\tSUM(t.quantity) AS quantity,\r\n\t\tSUM(t.standardprice*t.quantity) AS standardprice_total,\r\n\t\t1-SUM(t.taxprice*t.quantity)/SUM(t.standardprice*t.quantity) AS zhekou,\r\n\t\t1-SUM(t.gcm*t.quantity)/SUM(t.taxprice*t.quantity) AS gcm,\r\n\t\tSUM((CASE WHEN t.avge_price=0 THEN 0 ELSE t.taxprice END)*t.quantity)/SUM(IFNULL(t.avge_price,0)*t.quantity)-1 AS spe,\r\n\t\tSUM(CASE WHEN t.avge_price=0 THEN 0 ELSE 1 END)/COUNT(1) AS specnt,\r\n\t\tsalesreg_id,\r\n\t\tbanshichu,\r\n\t\tMAX(discount_percent) AS max_zhekou,\r\n\t\tMIN(discount_percent) AS min_zhekou\r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\tquantity,\r\n\t\t\tproductgroup_id,\r\n\t\t\tproductgroup_name,\r\n\t\t\tstandardprice,\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{tiaozheng}'='' OR IFNULL(zhekou_this,0)=IFNULL(zhekou_change,0) THEN taxprice\r\n\t\t\t\tELSE (1-IFNULL(zhekou_change,0))*standardprice\r\n\t\t\tEND AS taxprice,\r\n\t\t\tzhekou_this,\r\n\t\t\tzhekou_change,\r\n\t\t\tgcm,\r\n\t\t\tavge_price,\r\n\t\t\tsalesreg_id,\r\n\t\t\tbanshichu,\r\n\t\t\tdiscount_percent\r\n\t\tFROM (\r\n\t\t\tSELECT\r\n\t\t\t\tb.quantity,\r\n\t\t\t\tIFNULL(c.productgroup_id,'') AS productgroup_id,\r\n\t\t\t\tIFNULL(c.productgroup_name,'') AS productgroup_name,\r\n\t\t\t\tIFNULL(b.standardprice,0) AS standardprice,\r\n\t\t\t\tb.taxprice,\r\n\t\t\t\td.zhekou_this,\r\n\t\t\t\tIFNULL(e.zhekou_change,d.zhekou_this) AS zhekou_change,\r\n\t\t\t\tc.gcm_cost AS gcm,\r\n\t\t\t\tIFNULL(b.avgeprice,0) AS avge_price,\r\n\t\t\t\ta.salesreg_id,\r\n\t\t\t\ta.banshichu,\r\n\t\t\t\tIFNULL(b.discount_percent,0) AS discount_percent\r\n\t\t\tFROM ld_quotes a\r\n\t\t\tLEFT JOIN ld_quotesdetail b ON b.id=a.quoteid\r\n\t\t\tLEFT JOIN ld_products c ON c.productid=b.productid\r\n\t\t\tLEFT JOIN (\r\n\t\t\t\tSELECT\r\n\t\t\t\t\tt.productgroup_name,\r\n\t\t\t\t\tROUND(1-SUM(t.taxprice*t.quantity)/SUM(t.standardprice*t.quantity),4) AS zhekou_this\r\n\t\t\t\tFROM (\r\n\t\t\t\t\tSELECT\r\n\t\t\t\t\t\tb.quantity,\r\n\t\t\t\t\t\tIFNULL(c.productgroup_name,'') AS productgroup_name,\r\n\t\t\t\t\t\tIFNULL(b.standardprice,0) AS standardprice,\r\n\t\t\t\t\t\tb.taxprice\r\n\t\t\t\t\tFROM ld_quotes a\r\n\t\t\t\t\tLEFT JOIN ld_quotesdetail b ON b.id=a.quoteid\r\n\t\t\t\t\tLEFT JOIN ld_products c ON c.productid=b.productid\r\n\t\t\t\t\tWHERE a.quoteid='[related_ldcrmid]'\r\n\t\t\t\t) t\r\n\t\t\t\tGROUP BY productgroup_name\r\n\t\t\t) d ON d.productgroup_name=IFNULL(c.productgroup_name,'')\r\n\t\t\tLEFT JOIN (\r\n\t\t\t\tSELECT\r\n\t\t\t\t\tLEFT(mystring,LOCATE(':',mystring)-1) AS groupname,\r\n\t\t\t\t\tROUND(RIGHT(mystring,LENGTH(mystring)-LOCATE(':',mystring))*0.01,4) AS zhekou_change\r\n\t\t\t\tFROM (\r\n\t\t\t\t\tSELECT \r\n\t\t\t\t\t\tsubstring_index(substring_index(a.splitsting,',',b.seq+1),',',-1)  AS mystring\r\n\t\t\t\t\tFROM (SELECT '{tiaozheng}' AS splitsting) a \r\n\t\t\t\t\tLEFT JOIN sequence b ON b.seq < (length(a.splitsting) - length(replace(a.splitsting,',',''))+1) \r\n\t\t\t\t) a\r\n\t\t\t\tWHERE RIGHT(mystring,LENGTH(mystring)-LOCATE(':',mystring))<>''\r\n\t\t\t\tGROUP BY groupname\r\n\t\t\t) e ON e.groupname=IFNULL(c.productgroup_name,'')\r\n\t\t\tWHERE a.quoteid='[related_ldcrmid]'\r\n\t\t) tmp\r\n\t) t\r\n\tGROUP BY productgroup_name\r\n) a\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\tproductgroup_id,\r\n\t\tdiscount_percent3,\r\n\t\tdiscount_percent4,\r\n\t\tdiscount_percent5\r\n\tFROM ld_customform02\r\n\tWHERE deleted=0\r\n\t\tAND approvestatus<>'已拒绝'\r\n\tGROUP BY productgroup_id\r\n) b ON b.productgroup_id=a.productgroup_id\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\tproduct_groupname,\r\n\t\tgcm_target\r\n\tFROM ld_customform07 a\r\n\tWHERE a.deleted=0\r\n\t\tAND a.gcm_year=(SELECT YEAR(createdtime) FROM ld_quotes WHERE quoteid='[related_ldcrmid]')\r\n\tGROUP BY product_groupname\r\n) c ON c.product_groupname=a.productgroup_name\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\tproductgroup_id,\r\n\t\tarea_id,\r\n\t\tarea_name,\r\n\t\tavg_discount\r\n\tFROM ld_customform49\r\n\tWHERE deleted=0\r\n        AND years=YEAR(NOW())-1\r\n\t\tAND bill_type='O'\r\n) d ON d.productgroup_id=a.productgroup_id AND d.area_name=a.banshichu\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\tproductgroup_id,\r\n\t\tarea_id,\r\n\t\tarea_name,\r\n\t\tavg_discount\r\n\tFROM ld_customform49\r\n\tWHERE deleted=0\r\n        AND years=YEAR(NOW())-1\r\n\t\tAND bill_type='R'\r\n) e ON e.productgroup_id=a.productgroup_id AND e.area_id=a.salesreg_id\r\nWHERE 1=1\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN EXISTS (SELECT id FROM ld_users WHERE profileid IN (SELECT profileid FROM ld_profile WHERE description LIKE '允许查看%') AND id='[uuid]') THEN 1=1\r\n\t\t\tELSE 0=1\r\n\t\tEND)\r\nORDER BY a.productgroup_name"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "b",
        "Alias": "b",
        "Columns": {
          "0": {
            "Name": "rebate_value",
            "Index": -1,
            "NameInSource": "rebate_value",
            "Alias": "rebate_value",
            "Type": "System.String"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT rebate_value FROM ld_quotes WHERE quoteid='[related_ldcrmid]'"
      },
      "2": {
        "Ident": "StiMySqlSource",
        "Name": "c",
        "Alias": "c",
        "Columns": {
          "0": {
            "Name": "gcm",
            "Index": -1,
            "NameInSource": "gcm",
            "Alias": "gcm",
            "Type": "System.Int32"
          },
          "1": {
            "Name": "net_value",
            "Index": -1,
            "NameInSource": "net_value",
            "Alias": "net_value",
            "Type": "System.String"
          },
          "2": {
            "Name": "spe",
            "Index": -1,
            "NameInSource": "spe",
            "Alias": "spe",
            "Type": "System.Int32"
          },
          "3": {
            "Name": "specnt",
            "Index": -1,
            "NameInSource": "specnt",
            "Alias": "specnt",
            "Type": "System.Object"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\tROUND(1-SUM(t.gcm*t.quantity)/SUM(t.taxprice*t.quantity),4) AS gcm,\r\n\tROUND(SUM((CASE WHEN IFNULL(avge_price,0)=0 THEN 0 ELSE t.taxprice END)*t.quantity)/SUM(IFNULL(t.avge_price,0)*t.quantity)-1,4) AS spe,\r\n\tSUM(CASE WHEN IFNULL(avge_price,0)=0 THEN 0 ELSE 1 END)/COUNT(1) AS specnt,\r\n\tROUND(SUM(tax_amount),2) AS net_value\r\nFROM (\r\n\tSELECT\r\n\t\tquantity,\r\n\t\tproductgroup_id,\r\n\t\tproductgroup_name,\r\n\t\tstandardprice,\r\n\t\tCASE\r\n\t\t\tWHEN '{tiaozheng}'='' OR IFNULL(zhekou_this,0)=IFNULL(zhekou_change,0) THEN taxprice\r\n\t\t\tELSE (1-IFNULL(zhekou_change,0))*standardprice\r\n\t\tEND AS taxprice,\r\n\t\tCASE\r\n\t\t\tWHEN '{tiaozheng}'='' OR IFNULL(zhekou_this,0)=IFNULL(zhekou_change,0) THEN tax_amount\r\n\t\t\tELSE (1-IFNULL(zhekou_change,0))*standardprice*quantity\r\n\t\tEND AS tax_amount,\r\n\t\tzhekou_this,\r\n\t\tzhekou_change,\r\n\t\tgcm,\r\n\t\tavge_price\r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\tb.quantity,\r\n\t\t\tIFNULL(c.productgroup_id,'') AS productgroup_id,\r\n\t\t\tIFNULL(c.productgroup_name,'') AS productgroup_name,\r\n\t\t\tIFNULL(b.standardprice,0) AS standardprice,\r\n\t\t\tb.taxprice,\r\n\t\t\tb.tax_amount,\r\n\t\t\td.zhekou_this,\r\n\t\t\tIFNULL(e.zhekou_change,d.zhekou_this) AS zhekou_change,\r\n\t\t\tc.gcm_cost AS gcm,\r\n\t\t\tIFNULL(b.avgeprice,0) AS avge_price\r\n\t\tFROM ld_quotes a\r\n\t\tLEFT JOIN ld_quotesdetail b ON b.id=a.quoteid\r\n\t\tLEFT JOIN ld_products c ON c.productid=b.productid\r\n\t\tLEFT JOIN (\r\n\t\t\tSELECT\r\n\t\t\t\tt.productgroup_name,\r\n\t\t\t\tROUND(1-SUM(t.taxprice*t.quantity)/SUM(t.standardprice*t.quantity),4) AS zhekou_this\r\n\t\t\tFROM (\r\n\t\t\t\tSELECT\r\n\t\t\t\t\tb.quantity,\r\n\t\t\t\t\tIFNULL(c.productgroup_name,'') AS productgroup_name,\r\n\t\t\t\t\tIFNULL(b.standardprice,0) AS standardprice,\r\n\t\t\t\t\tIFNULL(b.taxprice,0) AS taxprice\r\n\t\t\t\tFROM ld_quotes a\r\n\t\t\t\tLEFT JOIN ld_quotesdetail b ON b.id=a.quoteid\r\n\t\t\t\tLEFT JOIN ld_products c ON c.productid=b.productid\r\n\t\t\t\tWHERE a.quoteid='[related_ldcrmid]'\r\n\t\t\t) t\r\n\t\t\tGROUP BY productgroup_name\r\n\t\t) d ON d.productgroup_name=IFNULL(c.productgroup_name,'')\r\n\t\tLEFT JOIN (\r\n\t\t\tSELECT\r\n\t\t\t\tLEFT(mystring,LOCATE(':',mystring)-1) AS groupname,\r\n\t\t\t\tROUND(RIGHT(mystring,LENGTH(mystring)-LOCATE(':',mystring))*0.01,4) AS zhekou_change\r\n\t\t\tFROM (\r\n\t\t\t\tSELECT \r\n\t\t\t\t\tsubstring_index(substring_index(a.splitsting,',',b.seq+1),',',-1)  AS mystring\r\n\t\t\t\tFROM (SELECT '{tiaozheng}' AS splitsting) a \r\n\t\t\t\tLEFT JOIN sequence b ON b.seq < (length(a.splitsting) - length(replace(a.splitsting,',',''))+1) \r\n\t\t\t) a\r\n\t\t\tWHERE RIGHT(mystring,LENGTH(mystring)-LOCATE(':',mystring))<>''\r\n\t\t\tGROUP BY groupname\r\n\t\t) e ON e.groupname=IFNULL(c.productgroup_name,'')\r\n\t\tWHERE a.quoteid='[related_ldcrmid]'\r\n\t) tmp\r\n) t\r\nWHERE 1=1\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN EXISTS (SELECT id FROM ld_users WHERE profileid IN (SELECT profileid FROM ld_profile WHERE description LIKE '允许查看%') AND id='[uuid]') THEN 1=1\r\n\t\t\tELSE 0=1\r\n\t\tEND)"
      },
