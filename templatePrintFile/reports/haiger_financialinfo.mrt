          },
          "5": {
            "Name": "quantity",
            "Index": -1,
            "NameInSource": "quantity",
            "Alias": "quantity",
            "Type": "System.Object"
          },
          "6": {
            "Name": "spe",
            "Index": -1,
            "NameInSource": "spe",
            "Alias": "spe",
            "Type": "System.Int32"
          },
          "7": {
            "Name": "standardprice",
            "Index": -1,
            "NameInSource": "standardprice",
            "Alias": "standardprice",
            "Type": "System.Int32"
          },
          "8": {
            "Name": "tax_amount",
            "Index": -1,
            "NameInSource": "tax_amount",
            "Alias": "tax_amount",
            "Type": "System.Int32"
          },
          "9": {
            "Name": "taxprice",
            "Index": -1,
            "NameInSource": "taxprice",
            "Alias": "taxprice",
            "Type": "System.Int32"
          },
          "10": {
            "Name": "usageunit",
            "Index": -1,
            "NameInSource": "usageunit",
            "Alias": "usageunit",
            "Type": "System.String"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\tproductgroup_name,\r\n\tproductname,\r\n\tusageunit,\r\n\tpricefactor,\r\n\tstandardprice,\r\n\tROUND(quantity,2) AS quantity,\r\n\tROUND(taxprice,2) AS taxprice,\r\n\ttaxprice*quantity AS tax_amount,\r\n\tROUND((CASE WHEN avge_price IS NULL THEN 0 ELSE taxprice END)*quantity/(IFNULL(avge_price,0)*quantity)-1,4) AS spe,\r\n\tROUND(1-gcm*quantity/(taxprice*quantity),4) AS gcm,\r\n\tCASE\r\n\t\tWHEN '{tiaozheng}'='' OR IFNULL(zhekou_this,0)=IFNULL(zhekou_change,0) THEN discount_percent*0.01\r\n\t\tELSE zhekou_change\r\n\tEND AS discount_percent\r\nFROM (\r\n\tSELECT\r\n\t\tquantity,\r\n\t\tusageunit,\r\n\t\tproductname,\r\n\t\tpricefactor,\r\n\t\tdiscount_percent,\r\n\t\tproductgroup_id,\r\n\t\tproductgroup_name,\r\n\t\tstandardprice,\r\n\t\tCASE\r\n\t\t\tWHEN '{tiaozheng}'='' OR IFNULL(zhekou_this,0)=IFNULL(zhekou_change,0) THEN taxprice\r\n\t\t\tELSE (1-IFNULL(zhekou_change,0))*standardprice\r\n\t\tEND AS taxprice,\r\n\t\tzhekou_this,\r\n\t\tzhekou_change,\r\n\t\tgcm,\r\n\t\tavge_price\r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\tb.quantity,\r\n\t\t\tc.usageunit,\r\n\t\t\tc.productname,\r\n\t\t\tb.pricefactor,\r\n\t\t\tb.discount_percent,\r\n\t\t\tIFNULL(c.productgroup_id,'') AS productgroup_id,\r\n\t\t\tIFNULL(c.productgroup_name,'') AS productgroup_name,\r\n\t\t\tIFNULL(b.standardprice,0) AS standardprice,\r\n\t\t\tb.taxprice,\r\n\t\t\td.zhekou_this,\r\n\t\t\tIFNULL(e.zhekou_change,d.zhekou_this) AS zhekou_change,\r\n\t\t\tc.gcm_cost AS gcm,\r\n\t\t\tIFNULL(b.avgeprice,0) AS avge_price\r\n\t\tFROM ld_quotes a\r\n\t\tLEFT JOIN ld_quotesdetail b ON b.id=a.quoteid\r\n\t\tLEFT JOIN ld_products c ON c.productid=b.productid\r\n\t\tLEFT JOIN (\r\n\t\t\tSELECT\r\n\t\t\t\tt.productgroup_name,\r\n\t\t\t\tROUND(1-SUM(t.taxprice*t.quantity)/SUM(t.standardprice*t.quantity),4) AS zhekou_this\r\n\t\t\tFROM (\r\n\t\t\t\tSELECT\r\n\t\t\t\t\tb.quantity,\r\n\t\t\t\t\tIFNULL(c.productgroup_name,'') AS productgroup_name,\r\n\t\t\t\t\tIFNULL(b.standardprice,0) AS standardprice,\r\n\t\t\t\t\tIFNULL(b.taxprice,0) AS taxprice\r\n\t\t\t\tFROM ld_quotes a\r\n\t\t\t\tLEFT JOIN ld_quotesdetail b ON b.id=a.quoteid\r\n\t\t\t\tLEFT JOIN ld_products c ON c.productid=b.productid\r\n\t\t\t\tWHERE a.quoteid='[related_ldcrmid]'\r\n\t\t\t\t\tAND IFNULL(c.productgroup_name,'')='{this[\"mygroupname\"]}'\r\n\t\t\t) t\r\n\t\t\tGROUP BY productgroup_name\r\n\t\t) d ON d.productgroup_name=IFNULL(c.productgroup_name,'')\r\n\t\tLEFT JOIN (\r\n\t\t\tSELECT\r\n\t\t\t\tLEFT(mystring,LOCATE(':',mystring)-1) AS groupname,\r\n\t\t\t\tROUND(RIGHT(mystring,LENGTH(mystring)-LOCATE(':',mystring))*0.01,4) AS zhekou_change\r\n\t\t\tFROM (\r\n\t\t\t\tSELECT \r\n\t\t\t\t\tsubstring_index(substring_index(a.splitsting,',',b.seq+1),',',-1)  AS mystring\r\n\t\t\t\tFROM (SELECT '{tiaozheng}' AS splitsting) a \r\n\t\t\t\tLEFT JOIN sequence b ON b.seq < (length(a.splitsting) - length(replace(a.splitsting,',',''))+1) \r\n\t\t\t) a\r\n\t\t\tWHERE RIGHT(mystring,LENGTH(mystring)-LOCATE(':',mystring))<>''\r\n\t\t\tGROUP BY groupname\r\n\t\t) e ON e.groupname=IFNULL(c.productgroup_name,'')\r\n\t\tWHERE a.quoteid='[related_ldcrmid]'\r\n\t\t\tAND IFNULL(c.productgroup_name,'')='{this[\"mygroupname\"]}'\r\n\t) tmp\r\n) t"
      },
      "4": {
        "Ident": "StiMySqlSource",
        "Name": "e",
        "Alias": "e",
        "Columns": {
          "0": {
            "Name": "gcm",
            "Index": -1,
            "NameInSource": "gcm",
            "Alias": "gcm",
            "Type": "System.Int32"
          },
          "1": {
            "Name": "spe",
            "Index": -1,
            "NameInSource": "spe",
            "Alias": "spe",
            "Type": "System.Int32"
          },
          "2": {
            "Name": "zhekou",
            "Index": -1,
            "NameInSource": "zhekou",
            "Alias": "zhekou",
            "Type": "System.Int32"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\tROUND(a.zhekou,4) AS zhekou,\r\n\tROUND(a.gcm,4) AS gcm,\r\n\tROUND(a.spe,4) AS spe\r\nFROM (\r\n\tSELECT\r\n\t\tt.productgroup_id,\r\n\t\tt.productgroup_name,\r\n\t\tt.zhekou_this,\r\n\t\tt.zhekou_change,\r\n\t\tSUM(t.quantity) AS quantity,\r\n\t\tSUM(t.standardprice*t.quantity) AS standardprice_total,\r\n\t\t1-SUM(t.taxprice*t.quantity)/SUM(t.standardprice*t.quantity) AS zhekou,\r\n\t\t1-SUM(t.gcm*t.quantity)/SUM(t.taxprice*t.quantity) AS gcm,\r\n\t\tROUND(SUM((CASE WHEN avge_price IS NULL THEN 0 ELSE t.taxprice END)*t.quantity)/SUM(IFNULL(t.avge_price,0)*t.quantity)-1,4) AS spe,\r\n\t\tSUM(CASE WHEN avge_price IS NULL THEN 0 ELSE 1 END)/COUNT(1) AS specnt\r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\tquantity,\r\n\t\t\tproductgroup_id,\r\n\t\t\tproductgroup_name,\r\n\t\t\tstandardprice,\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{tiaozheng}'='' OR IFNULL(zhekou_this,0)=IFNULL(zhekou_change,0) THEN taxprice\r\n\t\t\t\tELSE (1-IFNULL(zhekou_change,0))*standardprice\r\n\t\t\tEND AS taxprice,\r\n\t\t\tzhekou_this,\r\n\t\t\tzhekou_change,\r\n\t\t\tgcm,\r\n\t\t\tavge_price\r\n\t\tFROM (\r\n\t\t\tSELECT\r\n\t\t\t\tb.quantity,\r\n\t\t\t\tIFNULL(c.productgroup_id,'') AS productgroup_id,\r\n\t\t\t\tIFNULL(c.productgroup_name,'') AS productgroup_name,\r\n\t\t\t\tIFNULL(b.standardprice,0) AS standardprice,\r\n\t\t\t\tb.taxprice,\r\n\t\t\t\td.zhekou_this,\r\n\t\t\t\tIFNULL(e.zhekou_change,d.zhekou_this) AS zhekou_change,\r\n\t\t\t\tc.gcm_cost AS gcm,\r\n\t\t\t\tIFNULL(b.avgeprice,0) AS avge_price\r\n\t\t\tFROM ld_quotes a\r\n\t\t\tLEFT JOIN ld_quotesdetail b ON b.id=a.quoteid\r\n\t\t\tLEFT JOIN ld_products c ON c.productid=b.productid\r\n\t\t\tLEFT JOIN (\r\n\t\t\t\tSELECT\r\n\t\t\t\t\tt.productgroup_name,\r\n\t\t\t\t\tROUND(1-SUM(t.taxprice*t.quantity)/SUM(t.standardprice*t.quantity),4) AS zhekou_this\r\n\t\t\t\tFROM (\r\n\t\t\t\t\tSELECT\r\n\t\t\t\t\t\tb.quantity,\r\n\t\t\t\t\t\tIFNULL(c.productgroup_name,'') AS productgroup_name,\r\n\t\t\t\t\t\tIFNULL(b.standardprice,0) AS standardprice,\r\n\t\t\t\t\t\tIFNULL(b.taxprice,0) AS taxprice\r\n\t\t\t\t\tFROM ld_quotes a\r\n\t\t\t\t\tLEFT JOIN ld_quotesdetail b ON b.id=a.quoteid\r\n\t\t\t\t\tLEFT JOIN ld_products c ON c.productid=b.productid\r\n\t\t\t\t\tWHERE a.quoteid='[related_ldcrmid]'\r\n\t\t\t\t) t\r\n\t\t\t\tGROUP BY productgroup_name\r\n\t\t\t) d ON d.productgroup_name=IFNULL(c.productgroup_name,'')\r\n\t\t\tLEFT JOIN (\r\n\t\t\t\tSELECT\r\n\t\t\t\t\tLEFT(mystring,LOCATE(':',mystring)-1) AS groupname,\r\n\t\t\t\t\tROUND(RIGHT(mystring,LENGTH(mystring)-LOCATE(':',mystring))*0.01,4) AS zhekou_change\r\n\t\t\t\tFROM (\r\n\t\t\t\t\tSELECT \r\n\t\t\t\t\t\tsubstring_index(substring_index(a.splitsting,',',b.seq+1),',',-1)  AS mystring\r\n\t\t\t\t\tFROM (SELECT '{tiaozheng}' AS splitsting) a \r\n\t\t\t\t\tLEFT JOIN sequence b ON b.seq < (length(a.splitsting) - length(replace(a.splitsting,',',''))+1) \r\n\t\t\t\t) a\r\n\t\t\t\tWHERE RIGHT(mystring,LENGTH(mystring)-LOCATE(':',mystring))<>''\r\n\t\t\t\tGROUP BY groupname\r\n\t\t\t) e ON e.groupname=IFNULL(c.productgroup_name,'')\r\n\t\t\tWHERE a.quoteid='[related_ldcrmid]'\r\n\t\t\t\tAND IFNULL(c.productgroup_name,'')='{this[\"mygroupname\"]}'\r\n\t\t) tmp\r\n\t) t\r\n\tGROUP BY productgroup_name\r\n) a\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\tproductgroup_id,\r\n\t\tdiscount_percent3,\r\n\t\tdiscount_percent4,\r\n\t\tdiscount_percent5\r\n\tFROM ld_customform02\r\n\tWHERE deleted=0\r\n\t\tAND approvestatus<>'已拒绝'\r\n\tGROUP BY productgroup_id\r\n) b ON b.productgroup_id=a.productgroup_id\r\nWHERE 1=1\r\n\tAND IFNULL(a.productgroup_name,'')='{this[\"mygroupname\"]}'"
      },
      "5": {
        "Ident": "StiMySqlSource",
        "Name": "f",
        "Alias": "f",
        "Columns": {
          "0": {
            "Name": "agent_discount",
            "Index": -1,
            "NameInSource": "agent_discount",
            "Alias": "agent_discount",
