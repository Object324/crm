          },
          "3": {
            "Name": "zhekou",
            "Index": -1,
            "NameInSource": "zhekou",
            "Alias": "zhekou",
            "Type": "System.Decimal"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\tp.productname,\r\n\ta.quantity,\r\n\tCASE\r\n\t\tWHEN '{tiaozheng}'='' THEN ROUND(a.discount_percent,2)\r\n\t\tELSE ROUND(c.zhekou_change*100,2)\r\n\tEND AS zhekou,\r\n\ta.agent_discount\r\nFROM ld_quotesdetail a\r\nLEFT JOIN ld_products p ON p.productid=a.productid\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\tLEFT(mystring,LOCATE(':',mystring)-1) AS groupname,\r\n\t\tROUND(RIGHT(mystring,LENGTH(mystring)-LOCATE(':',mystring))*0.01,4) AS zhekou_change\r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\tsubstring_index(substring_index(a.splitsting,',',b.seq+1),',',-1)  AS mystring\r\n\t\tFROM (SELECT '{tiaozheng}' AS splitsting) a \r\n\t\tLEFT JOIN sequence b ON b.seq < (length(a.splitsting) - length(replace(a.splitsting,',',''))+1) \r\n\t) a\r\n\tWHERE RIGHT(mystring,LENGTH(mystring)-LOCATE(':',mystring))<>''\r\n\tGROUP BY groupname\r\n) c ON c.groupname=p.productgroup_name\r\nWHERE a.id='[related_ldcrmid]'"
      },
      "6": {
        "Ident": "StiMySqlSource",
        "Name": "u",
        "Alias": "u",
        "Columns": {
          "0": {
            "Name": "info_type",
            "Index": -1,
            "NameInSource": "info_type",
            "Alias": "info_type",
            "Type": "System.Int32"
          }
        },
        "NameInSource": "crm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\tCASE\r\n\t\tWHEN b.profilename IN ('价格委员会','总经理','产品组','销售总监') THEN 3\r\n\t\tELSE 2\r\n\tEND AS info_type\r\nFROM ld_users a\r\nLEFT JOIN ld_profile b ON b.profileid=a.profileid\r\nWHERE a.id='[uuid]'"
      }
    },
