        "NameInSource": "crm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\ta.lastname,\r\n\ta.in_date,\r\n\ta.laiyuan,\r\n\ta.remark,\r\n\ta.id,\r\n\ta.accountid,\r\n\ta.accountname,\r\n\ta.shouji,\r\n\ta.bill_state,\r\n\ta.bill_city,\r\n\ta.bill_area\r\nFROM (\r\n\tSELECT\r\n\t\td.lastname,\r\n\t\tDATE_FORMAT(c.sf293,'%Y-%m-%d %H:%i') AS in_date,\r\n\t\t'大巴车签到审批表' AS laiyuan,\r\n\t\tCONCAT('单据编号：',a.customform21_no) AS remark,\r\n\t\ta.customform21id AS id,\r\n\t\tb.line_servicecharge_id AS accountid,\r\n\t\te.accountname,\r\n\t\tc.sf299 AS shouji,\r\n\t\te.bill_state,\r\n\t\te.bill_city,\r\n\t\te.bill_area\r\n\tFROM ld_customform21 a\r\n\tLEFT JOIN ld_customform21detail b ON b.id=a.customform21id\r\n\tLEFT JOIN ld_customform21detailscf c ON c.lineitem_id=b.lineitem_id\r\n\tLEFT JOIN ld_contactdetails d ON d.contactid=b.line_contacts_id\r\n\tLEFT JOIN ld_account e ON e.accountid=b.line_servicecharge_id\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus='已批准'\r\n\t\tAND d.contactid>0\r\n\t\tAND c.sf293 BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d %H:%i:%s') AND DATE_FORMAT('{end_date}','%Y-%m-%d %H:%i:%s')\r\n\tUNION ALL\r\n\tSELECT\r\n\t\ta.lastname,\r\n\t\tDATE_FORMAT(c.intime,'%Y-%m-%d %H:%i' ) AS in_date,\r\n\t\tCONCAT('自驾-',cardtype,'：',b.lxr_carnum) AS laiyuan,\r\n\t\tNULL AS remark,\r\n\t\tNULL AS id,\r\n\t\ta.accountid,\r\n\t\td.accountname,\r\n\t\ta.mobile AS shouji,\r\n\t\td.bill_state,\r\n\t\td.bill_city,\r\n\t\td.bill_area\r\n\tFROM ld_contactdetails a\r\n\tLEFT JOIN ld_contactscf b ON b.contactid=a.contactid\r\n\tINNER JOIN ld_parkoutlog c ON c.platenum=b.lxr_carnum\r\n\tLEFT JOIN ld_account d ON d.accountid=a.accountid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.contactid>0\r\n\t\tAND IFNULL(b.lxr_carnum,'')<>''\r\n\t\tAND c.intime>'1900-01-01'\r\n\t\tAND c.intime BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d %H:%i:%s') AND DATE_FORMAT('{end_date}','%Y-%m-%d %H:%i:%s')\r\n\tGROUP BY a.contactid,DATE_FORMAT(c.intime,'%Y-%m-%d %H:%i' ),b.lxr_carnum\r\n\tUNION ALL\r\n\tSELECT \r\n\t\td.lastname,\r\n\t\tDATE_FORMAT(c.intime,'%Y-%m-%d %H:%i' ) AS in_date,\r\n\t\t'自驾' AS laiyuan,\r\n\t\tCONCAT(c.cardtype,'：',a.car_no) AS remark,\r\n\t\tNULL AS id,\r\n\t\ta.servicecharge_id AS accountid,\r\n\t\te.accountname,\r\n\t\td.mobile AS shouji,\r\n\t\te.bill_state,\r\n\t\te.bill_city,\r\n\t\te.bill_area\r\n\tFROM ld_customform100 a\r\n\tLEFT JOIN ld_contactdetails d ON d.contactid=a.contactid\r\n\tINNER JOIN ld_parkoutlog c ON c.platenum=a.car_no\r\n\tLEFT JOIN ld_account e ON e.accountid=a.servicecharge_id\r\n\tWHERE a.deleted=0\r\n\t\tAND IFNULL(a.car_no,'')<>''\r\n\t\tAND d.contactid>0\r\n\t\tAND c.intime BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d %H:%i:%s') AND DATE_FORMAT('{end_date}','%Y-%m-%d %H:%i:%s')\r\n\tGROUP BY a.contactid,DATE_FORMAT(c.intime,'%Y-%m-%d %H:%i'),a.car_no\r\n\tUNION ALL\r\n\tSELECT\r\n\t\td.lastname,\r\n\t\tDATE_FORMAT(a.createdtime,'%Y-%m-%d %H:%i' ) AS in_date,\r\n\t\t'活动参与记录' AS laiyuan,\r\n\t\tCONCAT('单据编号：',a.customform98_no,'（',c.activity_name,'）') AS remark,\r\n\t\ta.customform98id AS id,\r\n\t\ta.servicecharge_id AS accountid,\r\n\t\te.accountname,\r\n\t\td.mobile AS shouji,\r\n\t\te.bill_state,\r\n\t\te.bill_city,\r\n\t\te.bill_area\r\n\tFROM ld_customform98 a\r\n\tLEFT JOIN ld_contactdetails d ON d.contactid=a.contactid\r\n\tLEFT JOIN ld_customform99 c ON c.customform99id=a.customform99_id\r\n\tLEFT JOIN ld_account e ON e.accountid=a.servicecharge_id\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus='已批准'\r\n\t\tAND d.contactid>0\r\n\t\tAND a.createdtime BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d %H:%i:%s') AND DATE_FORMAT('{end_date}','%Y-%m-%d %H:%i:%s')\r\n\tUNION ALL\r\n\tSELECT\r\n\t\td.lastname,\r\n\t\tDATE_FORMAT(a.createdtime,'%Y-%m-%d %H:%i' ) AS in_date,\r\n\t\t'优惠券发放记录' AS laiyuan,\r\n\t\tCASE \r\n\t\t\tWHEN IFNULL(c.cf_5089,'')='' THEN CONCAT('单据编号：',a.customform96_no,'（',a.coupon_no,'）')\r\n\t\t\tELSE CONCAT('单据编号：',a.customform96_no,'（',a.coupon_no,'，',c.cf_5089,'）')\r\n\t\tEND AS remark,\r\n\t\ta.customform96id AS id,\r\n\t\ta.accountid AS accountid,\r\n\t\te.accountname,\r\n\t\td.mobile AS shouji,\r\n\t\te.bill_state,\r\n\t\te.bill_city,\r\n\t\te.bill_area\r\n\tFROM ld_customform96 a\r\n\tLEFT JOIN ld_contactdetails d ON d.contactid=a.contactid\r\n\tLEFT JOIN ld_customform96scf c ON c.customform96id=a.customform96id\r\n\tLEFT JOIN ld_account e ON e.accountid=a.accountid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND d.contactid>0\r\n\t\tAND a.createdtime BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d %H:%i:%s') AND DATE_FORMAT('{end_date}','%Y-%m-%d %H:%i:%s')\r\n\tUNION ALL\r\n\tSELECT\r\n\t\td.lastname,\r\n\t\tDATE_FORMAT(a.createdtime,'%Y-%m-%d %H:%i' ) AS in_date,\r\n\t\t'优惠券核销记录' AS laiyuan,\r\n\t\tCASE \r\n\t\t\tWHEN IFNULL(c.cf_5099,'')='' THEN CONCAT('单据编号：',a.customform95_no,'（',IFNULL(a.coupon_no,'--'),'）')\r\n\t\t\tELSE CONCAT('单据编号：',a.customform95_no,'（',IFNULL(a.coupon_no,'--'),'，',c.cf_5099,'）')\r\n\t\tEND AS remark,\r\n\t\ta.customform95id AS id,\r\n\t\ta.accountid AS accountid,\r\n\t\te.accountname,\r\n\t\td.mobile AS shouji,\r\n\t\te.bill_state,\r\n\t\te.bill_city,\r\n\t\te.bill_area\r\n\tFROM ld_customform95 a\r\n\tLEFT JOIN ld_contactdetails d ON d.contactid=a.contactid\r\n\tLEFT JOIN ld_customform95scf c ON c.customform95id=a.customform95id\r\n\tLEFT JOIN ld_account e ON e.accountid=a.accountid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus='已批准'\r\n\t\tAND d.contactid>0\r\n\t\tAND a.createdtime BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d %H:%i:%s') AND DATE_FORMAT('{end_date}','%Y-%m-%d %H:%i:%s')\r\n) a\r\nWHERE 1=1\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN TRIM('{xingming}')='' THEN 1=1\r\n\t\t\tELSE LOCATE(TRIM('{xingming}'),a.lastname)>0\r\n\t\tEND) \r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN TRIM('{leixing}')='' THEN 1=1\r\n\t\t\tELSE FIND_IN_SET(a.laiyuan,'{leixing}')\r\n\t\tEND) \r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN TRIM('{shoujihao}')='' THEN 1=1\r\n\t\t\tELSE LOCATE(TRIM('{shoujihao}'),a.shouji)>0\r\n\t\tEND) \r\nORDER BY a.in_date DESC,a.id DESC"
      }
    },
