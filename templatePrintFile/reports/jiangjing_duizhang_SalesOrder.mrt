<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<StiSerializer version="1.02" type="Flex" application="StiReport">
  <Dictionary type="Dictionary" isKey="true" Ref="1">
    <Databases isList="true" count="1">
      <ldcrm type="Stimulsoft.Report.Dictionary.StiMySqlDatabase" isKey="true" Ref="2">
        <Alias>ldcrm</Alias>
        <ConnectionStringEncrypted>9Gxz62FcS83hR9WI6CU0n8LQdWBhD1GFwxWx3GqEdy/CyPvKxgvziEYa0fBhXKQvgW5lr+9tM+1r
E8H06vgyI4NgaS3GT0O8Z0n9jcR0tWf/FN3CYVFagUZcoOBnVHTv</ConnectionStringEncrypted>
        <Name>ldcrm</Name>
      </ldcrm>
    </Databases>
    <DataSources isList="true" count="2">
      <invoice type="Stimulsoft.Report.Dictionary.StiMySqlSource" isKey="true" Ref="3">
        <Alias>invoice</Alias>
        <Columns isList="true" count="2">
          <value>accountid,System.Int32</value>
          <value>entitytypeid,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1"/>
        <Name>invoice</Name>
        <NameInSource>ldcrm</NameInSource>
        <Parameters isList="true" count="0"/>
        <SqlCommand>SELECT DISTINCT
	a.accountid,
	GROUP_CONCAT(DISTINCT a.salesorderid) AS entitytypeid
FROM ld_salesorder a
LEFT JOIN ld_inventoryproductrel b ON a.salesorderid=b.id
LEFT JOIN ld_account d ON d.accountid=a.accountid
LEFT JOIN ld_accountscf e ON d.accountid=e.accountid
LEFT JOIN ld_salesordercf g ON g.salesorderid=a.salesorderid
WHERE a.deleted=0
	AND IFNULL(a.sostatus,'')&lt;&gt;'已作废'
	AND a.approvestatus&lt;&gt;'已拒绝'
	AND a.stockpresence='全部出库'
	AND e.cf_2209='销售合同'
	AND a.signed_data BETWEEN STR_TO_DATE('{start_date}','%m/%d/%Y') AND STR_TO_DATE('{end_date}','%m/%d/%Y')
	AND (
		CASE
			WHEN '{needinvoice}'='全部' THEN 1=1
			ELSE g.cf_2317='{needinvoice}'
		END)
	AND (
		CASE
			WHEN TRIM('{company}')='' THEN 1=1
			ELSE LOCATE(TRIM('{company}'),d.accountname)
		END)
	AND b.balanceinvoicecount&gt;0
GROUP BY a.accountid
ORDER BY CONVERT(d.accountname USING GBK),a.signed_data,a.salesorder_no,a.salesorderid,b.sequence_no LIMIT 1</SqlCommand>
      </invoice>
      <report type="Stimulsoft.Report.Dictionary.StiMySqlSource" isKey="true" Ref="4">
        <Alias>report</Alias>
        <Columns isList="true" count="18">
          <value>accountid,System.Int32</value>
          <value>salesorderid,System.Int32</value>
          <value>accountname,System.String</value>
          <value>createddate,System.String</value>
          <value>salesorder_no,System.String</value>
          <value>stockpresence,System.String</value>
          <value>pname,System.String</value>
          <value>productname,System.String</value>
          <value>usageunit,System.String</value>
          <value>quantity,System.Decimal</value>
          <value>discount_percent,System.Decimal</value>
          <value>listprice,System.Decimal</value>
          <value>tax2,System.Decimal</value>
          <value>taxprice,System.Decimal</value>
          <value>list_amount,System.Decimal</value>
          <value>tax_total,System.Decimal</value>
          <value>tax_amount,System.Decimal</value>
          <value>remark,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1"/>
        <Name>report</Name>
        <NameInSource>ldcrm</NameInSource>
        <Parameters isList="true" count="0"/>
        <SqlCommand>SELECT
	a.accountid,
	a.salesorderid,
	d.accountname,
	DATE_FORMAT(a.createdtime,'%Y-%m-%d') AS createddate,
	a.salesorder_no,
	a.stockpresence,
	cf.cf_2089 AS pname,
	c.productname,
	bf.sf2561 AS usageunit,
	b.quantity,
	b.discount_percent,
	b.listprice,
	b.tax2,
	b.taxprice,
	b.list_amount,
	b.list_amount*0.01*b.tax2 AS tax_total,
	b.tax_amount,
	b.comment AS remark
FROM ld_salesorder a
LEFT JOIN ld_inventoryproductrel b ON a.salesorderid=b.id
LEFT JOIN ld_inventoryproductrelscf bf ON b.lineitem_id=bf.lineitem_id
LEFT JOIN ld_products c ON c.productid=b.productid
LEFT JOIN ld_productcf cf ON cf.productid=c.productid
LEFT JOIN ld_account d ON d.accountid=a.accountid
LEFT JOIN ld_accountscf e ON d.accountid=e.accountid
LEFT JOIN ld_salesordercf g ON g.salesorderid=a.salesorderid
WHERE a.deleted=0
	AND IFNULL(a.sostatus,'')&lt;&gt;'已作废'
	AND a.approvestatus&lt;&gt;'已拒绝'
	AND a.stockpresence='全部出库'
	AND e.cf_2209='销售合同'
	AND a.signed_data BETWEEN STR_TO_DATE('{start_date}','%m/%d/%Y') AND STR_TO_DATE('{end_date}','%m/%d/%Y')
	AND (
		CASE
			WHEN '{needinvoice}'='全部' THEN 1=1
			ELSE g.cf_2317='{needinvoice}'
		END)
	AND (
		CASE
			WHEN TRIM('{company}')='' THEN 1=1
			ELSE LOCATE(TRIM('{company}'),d.accountname)
		END)
	AND (
		CASE
			WHEN '{invoice_range}'='true' THEN b.balanceinvoicecount&gt;0
			ELSE 1=1
		END)
ORDER BY CONVERT(d.accountname USING GBK),createddate,a.salesorder_no,a.salesorderid,b.sequence_no</SqlCommand>
      </report>
    </DataSources>
