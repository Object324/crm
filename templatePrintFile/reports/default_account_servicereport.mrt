        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\tCASE\r\n\t\tWHEN EXISTS (SELECT 1 FROM ld_account WHERE accountname=TRIM('{custname}') AND deleted=0) THEN 'no'\r\n\t\tELSE 'yes'\r\n\tEND AS enabled,\r\n\tb.lastname,\r\n\tb.title,\r\n\tb.pphone,\r\n\tb.mobile,\r\n\tc.qq,\r\n\tb.email\r\nFROM (SELECT accountid FROM ld_account WHERE deleted=0 AND accountname=TRIM('{custname}') ORDER BY accountid LIMIT 1) a\r\nLEFT JOIN ld_contactdetails b ON a.accountid=b.accountid AND b.deleted=0\r\nLEFT JOIN ld_contactscf c ON b.contactid=c.contactid"
      },
      "2": {
        "Ident": "StiMySqlSource",
        "Name": "product",
        "Alias": "product",
        "Columns": {
          "0": {
            "Name": "productname",
            "Index": -1,
            "NameInSource": "productname",
            "Alias": "productname",
            "Type": "System.String"
          },
          "1": {
            "Name": "productcategory",
            "Index": -1,
            "NameInSource": "productcategory",
            "Alias": "productcategory",
            "Type": "System.String"
          },
          "2": {
            "Name": "quantity",
            "Index": -1,
            "NameInSource": "quantity",
            "Alias": "quantity",
            "Type": "System.Decimal"
          },
          "3": {
            "Name": "serialnumber",
            "Index": -1,
            "NameInSource": "serialnumber",
            "Alias": "serialnumber",
            "Type": "System.String"
          },
          "4": {
            "Name": "enddate",
            "Index": -1,
            "NameInSource": "enddate",
            "Alias": "enddate",
            "Type": "System.DateTime"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\t*\r\nFROM (\r\n\tSELECT\r\n\t\tproductname,\r\n\t\tproductcategory,\r\n\t\tquantity,\r\n\t\tserialnumber,\r\n\t\tmax(servicecontracts_end_date) AS enddate\r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\tc.productid,\r\n\t\t\td.productname,\r\n\t\t\td.productcategory,\r\n\t\t\tc.servicecontracts_end_date,\r\n\t\t\tc.quantity,\r\n\t\t\tc.serialnumber\r\n\t\tFROM (SELECT accountid FROM ld_account WHERE deleted=0 AND accountname=TRIM('{custname}') ORDER BY accountid LIMIT 1) a\r\n\t\tLEFT JOIN ld_servicecontracts b ON a.accountid=b.accountid\r\n\t\tLEFT JOIN ld_servicecontractsdetail c ON b.servicecontractsid=c.id\r\n\t\tLEFT JOIN ld_products d ON d.productid=c.productid\r\n\t\tWHERE b.deleted=0\r\n\t\t\tAND IFNULL(b.contract_status,'')<>'已作废'\r\n\t\t\tAND b.approvestatus<>'已拒绝'\r\n\t\tORDER BY c.productid,c.servicecontracts_end_date desc\r\n\t) a\r\n\tGROUP BY productid\r\n) t\r\nORDER BY CONVERT (productname USING GBK)"
      },
      "3": {
        "Ident": "StiMySqlSource",
        "Name": "ticket",
        "Alias": "ticket",
        "Columns": {
          "0": {
            "Name": "category",
            "Index": -1,
            "NameInSource": "category",
            "Alias": "category",
            "Type": "System.String"
          },
          "1": {
            "Name": "hopetime",
