        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n(SELECT \r\n\tCASE \r\n\t\tWHEN EXISTS (SELECT 1 FROM ld_account WHERE accountname=TRIM('{custname}') AND deleted=0) THEN 'yes'\r\n\t\tELSE 'no'\r\n\tEND) AS enabled,\r\n(SELECT \r\n\tCASE \r\n\t\tWHEN TRIM('{custname}')='' THEN \r\n\t\t\t'******公司******年度服务报告'\r\n\t\tWHEN EXISTS (SELECT 1 FROM ld_account WHERE accountname=TRIM('{custname}') AND deleted=0) THEN\r\n\t\t\t(SELECT CONCAT(accountname,'年度服务报告') FROM ld_account WHERE accountname=TRIM('{custname}') AND deleted=0 ORDER BY accountid LIMIT 1)\r\n\t\tELSE\r\n\t\t\t'******公司******年度服务报告'\r\n\tEND) AS lab_report,\r\n(SELECT\r\n\tb.fieldlabel\r\nFROM ld_field a\r\nLEFT JOIN ld_tranlabel b ON a.fieldid=b.Relateid AND b.trantable='ld_field' AND b.languagetype='zh'\r\nWHERE a.tabid=6\r\n\tAND a.columnname='accountname' LIMIT 1) AS lab_acc1,\r\n(SELECT \r\n\tCASE \r\n\tWHEN TRIM('{custname}')='' THEN '请输入完整客户名称进行精确查找'\r\n\tWHEN EXISTS (SELECT 1 FROM ld_account WHERE accountname=TRIM('{custname}') AND deleted=0) THEN\r\n\t\t(SELECT accountname FROM ld_account WHERE accountname=TRIM('{custname}') AND deleted=0 ORDER BY accountid LIMIT 1)\r\n\tELSE\r\n\t\t'未找到任何记录，请重新输入完整的客户名称进行精确查找'\r\nEND) lab_acc2,\r\n(SELECT\r\n\tb.fieldlabel\r\nFROM ld_field a\r\nLEFT JOIN ld_tranlabel b ON a.fieldid=b.Relateid AND b.trantable='ld_field' AND b.languagetype='zh'\r\nWHERE a.tabid=6\r\n\tAND a.columnname='bill_street' LIMIT 1) AS lab_acc3,\r\n(SELECT bill_street FROM ld_account WHERE accountname=TRIM('{custname}') AND deleted=0 ORDER BY accountid DESC LIMIT 1) AS lab_acc4,\r\n(SELECT\r\n\tb.fieldlabel\r\nFROM ld_field a\r\nLEFT JOIN ld_tranlabel b ON a.fieldid=b.Relateid AND b.trantable='ld_field' AND b.languagetype='zh'\r\nWHERE a.tabid=6\r\n\tAND a.columnname='phone' LIMIT 1) AS lab_acc5,\r\n(SELECT phone FROM ld_account WHERE accountname=TRIM('{custname}') AND deleted=0 ORDER BY accountid DESC LIMIT 1) AS lab_acc6,\r\n'联系人' AS lab_con1,\r\n(SELECT\r\n\tb.fieldlabel\r\nFROM ld_field a\r\nLEFT JOIN ld_tranlabel b ON a.fieldid=b.Relateid AND b.trantable='ld_field' AND b.languagetype='zh'\r\nWHERE a.tabid=4\r\n\tAND a.columnname='title' LIMIT 1) AS lab_con2,\r\n(SELECT\r\n\tb.fieldlabel\r\nFROM ld_field a\r\nLEFT JOIN ld_tranlabel b ON a.fieldid=b.Relateid AND b.trantable='ld_field' AND b.languagetype='zh'\r\nWHERE a.tabid=4\r\n\tAND a.columnname='pphone' LIMIT 1) AS lab_con3,\r\n(SELECT\r\n\tb.fieldlabel\r\nFROM ld_field a\r\nLEFT JOIN ld_tranlabel b ON a.fieldid=b.Relateid AND b.trantable='ld_field' AND b.languagetype='zh'\r\nWHERE a.tabid=4\r\n\tAND a.columnname='mobile' LIMIT 1) AS lab_con4,\r\n(SELECT\r\n\tb.fieldlabel\r\nFROM ld_field a\r\nLEFT JOIN ld_tranlabel b ON a.fieldid=b.Relateid AND b.trantable='ld_field' AND b.languagetype='zh'\r\nWHERE a.tabid=4\r\n\tAND a.columnname='qq' LIMIT 1) AS lab_con5,\r\n(SELECT\r\n\tb.fieldlabel\r\nFROM ld_field a\r\nLEFT JOIN ld_tranlabel b ON a.fieldid=b.Relateid AND b.trantable='ld_field' AND b.languagetype='zh'\r\nWHERE a.tabid=4\r\n\tAND a.columnname='email' LIMIT 1) AS lab_con6,\r\n(SELECT\r\n\tb.fieldlabel\r\nFROM ld_field a\r\nLEFT JOIN ld_tranlabel b ON a.fieldid=b.Relateid AND b.trantable='ld_field' AND b.languagetype='zh'\r\nWHERE a.tabid=14\r\n\tAND a.columnname='productname' LIMIT 1) AS lab_pro1,\r\n(SELECT\r\n\tb.fieldlabel\r\nFROM ld_field a\r\nLEFT JOIN ld_tranlabel b ON a.fieldid=b.Relateid AND b.trantable='ld_field' AND b.languagetype='zh'\r\nWHERE a.tabid=14\r\n\tAND a.columnname='productcategory' LIMIT 1) AS lab_pro2,\r\n'使用模块' AS lab_pro3,\r\n(SELECT\r\n\tb.fieldlabel\r\nFROM ld_producttoolfield a\r\nLEFT JOIN ld_tranlabel b ON a.producttoolfieldid=b.Relateid AND b.trantable='ld_producttoolfield' AND b.languagetype='zh'\r\nWHERE a.tabid=37\r\n\tAND a.columnname='quantity' LIMIT 1) AS lab_pro4,\r\n(SELECT\r\n\tb.fieldlabel\r\nFROM ld_producttoolfield a\r\nLEFT JOIN ld_tranlabel b ON a.producttoolfieldid=b.Relateid AND b.trantable='ld_producttoolfield' AND b.languagetype='zh'\r\nWHERE a.tabid=37\r\n\tAND a.columnname='serialnumber' LIMIT 1) AS lab_pro5,\r\n(SELECT\r\n\tb.fieldlabel\r\nFROM ld_producttoolfield a\r\nLEFT JOIN ld_tranlabel b ON a.producttoolfieldid=b.Relateid AND b.trantable='ld_producttoolfield' AND b.languagetype='zh'\r\nWHERE a.tabid=37\r\n\tAND a.columnname='servicecontracts_end_date' LIMIT 1) AS lab_pro6,\r\nCONCAT('服务时间：',IFNULL(DATE_FORMAT('{start_date}','%Y-%m-%d'),''),' 至 ',IFNULL(DATE_FORMAT('{end_date}','%Y-%m-%d'),'')) AS lab_sertime,\r\n(SELECT\r\n\tb.fieldlabel\r\nFROM ld_field a\r\nLEFT JOIN ld_tranlabel b ON a.fieldid=b.Relateid AND b.trantable='ld_field' AND b.languagetype='zh'\r\nWHERE a.tabid=13\r\n\tAND a.columnname='ticket_no' LIMIT 1) AS lab_ser1,\r\n(SELECT\r\n\tb.fieldlabel\r\nFROM ld_field a\r\nLEFT JOIN ld_tranlabel b ON a.fieldid=b.Relateid AND b.trantable='ld_field' AND b.languagetype='zh'\r\nWHERE a.tabid=13\r\n\tAND a.columnname='servicetype' LIMIT 1) AS lab_ser2,\r\n(SELECT\r\n\tb.fieldlabel\r\nFROM ld_field a\r\nLEFT JOIN ld_tranlabel b ON a.fieldid=b.Relateid AND b.trantable='ld_field' AND b.languagetype='zh'\r\nWHERE a.tabid=13\r\n\tAND a.columnname='hopetime' LIMIT 1) AS lab_ser3,\r\n(SELECT\r\n\tb.fieldlabel\r\nFROM ld_field a\r\nLEFT JOIN ld_tranlabel b ON a.fieldid=b.Relateid AND b.trantable='ld_field' AND b.languagetype='zh'\r\nWHERE a.tabid=13\r\n\tAND a.columnname='realtime' LIMIT 1) AS lab_ser4,\r\n(SELECT\r\n\tb.fieldlabel\r\nFROM ld_field a\r\nLEFT JOIN ld_tranlabel b ON a.fieldid=b.Relateid AND b.trantable='ld_field' AND b.languagetype='zh'\r\nWHERE a.tabid=13\r\n\tAND a.columnname='category' LIMIT 1) AS lab_ser5,\r\n(SELECT\r\n\tb.fieldlabel\r\nFROM ld_field a\r\nLEFT JOIN ld_tranlabel b ON a.fieldid=b.Relateid AND b.trantable='ld_field' AND b.languagetype='zh'\r\nWHERE a.tabid=13\r\n\tAND a.columnname='status' LIMIT 1) AS lab_ser6"
      },
      "1": {
