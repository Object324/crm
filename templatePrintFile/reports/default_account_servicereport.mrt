            "NameInSource": "realtime",
            "Alias": "realtime",
            "Type": "System.String"
          },
          "3": {
            "Name": "servicetype",
            "Index": -1,
            "NameInSource": "servicetype",
            "Alias": "servicetype",
            "Type": "System.String"
          },
          "4": {
            "Name": "status",
            "Index": -1,
            "NameInSource": "status",
            "Alias": "status",
            "Type": "System.String"
          },
          "5": {
            "Name": "ticket_no",
            "Index": -1,
            "NameInSource": "ticket_no",
            "Alias": "ticket_no",
            "Type": "System.String"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\tb.ticket_no,\r\n\tb.servicetype,\r\n\tDATE_FORMAT(b.hopetime,'%Y-%m-%d %H:%i:%s') AS hopetime,\r\n\tDATE_FORMAT(b.realtime,'%Y-%m-%d %H:%i:%s') AS realtime,\r\n\tb.category,\r\n\tb.`status`\r\nFROM (SELECT accountid FROM ld_account WHERE deleted=0 AND accountname=TRIM('{custname}') ORDER BY accountid LIMIT 1) a\r\nLEFT JOIN ld_troubletickets b ON a.accountid=b.accountid\r\nWHERE b.deleted=0\r\n\tAND b.approvestatus<>'已拒绝'\r\n\tAND DATE_FORMAT(IFNULL(b.realtime,b.createdtime),'%Y-%m-%d') BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\nORDER BY b.realtime"
      },
      "4": {
        "Ident": "StiMySqlSource",
        "Name": "chart",
        "Alias": "chart",
        "Columns": {
          "0": {
            "Name": "charttype",
            "Index": -1,
            "NameInSource": "charttype",
            "Alias": "charttype",
            "Type": "System.String"
          },
          "1": {
            "Name": "chartvalue",
            "Index": -1,
            "NameInSource": "chartvalue",
            "Alias": "chartvalue",
            "Type": "System.Int32"
          }
        },
        "NameInSource": "ldcrm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\tifnull(b.servicetype,0) AS charttype,\r\n\tcount(1) AS chartvalue\r\nFROM (SELECT accountid FROM ld_account WHERE deleted=0 AND accountname=TRIM('{custname}') ORDER BY accountid LIMIT 1) a\r\nLEFT JOIN ld_troubletickets b ON a.accountid=b.accountid\r\nWHERE b.deleted=0\r\n\tAND b.approvestatus<>'已拒绝'\r\n\tAND DATE_FORMAT(IFNULL(b.realtime,b.createdtime),'%Y-%m-%d') BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\nGROUP BY b.servicetype\r\nORDER BY CONVERT(b.servicetype USING GBK)"
      }
    },
