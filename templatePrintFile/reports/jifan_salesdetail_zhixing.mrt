        "NameInSource": "lderp",
        "SqlCommand": "SELECT\r\n\ta.accountname,\r\n\ta.salesorderid,\r\n\ta.salesorderno,\r\n\ta.sale_date,\r\n\ta.currencyname,\r\n\ta.detailid,\r\n\ta.productid,\r\n\ta.quantity,\r\n\ta.taxamount,\r\n\ta.unitprice,\r\n\ta.unitid,\r\n\ta.unitname,\r\n\ta.productno,\r\n\ta.huohao,\r\n\ta.guige,\r\n\ta.productname,\r\n\ta.isfree,\r\n\tb.outid,\r\n\tb.outno,\r\n\tb.outdetailid,\r\n\tb.outquantity,\r\n\t(isnull(b.outquantity,0)*a.unitprice) AS outtaxamount,\r\n\t(isnull(a.quantity,0)-isnull(b.outquantity,0))as non_outquantity,\r\n\t(isnull(a.quantity,0)-isnull(b.outquantity,0))*isnull(a.unitprice,0) as non_outamount,\r\n\tc.noticeid,\r\n\tc.noticeno,\r\n\tc.noticedetailid,\r\n\tc.noticequantity,\r\n\t (isnull(c.noticequantity,0)*a.unitprice) AS noticetaxamount,\r\n\t d.returnid,\r\n\td.returnno,\r\n\td.returndetailid,\r\n\td.returnquantity,\r\n\t (isnull(d.returnquantity,0)*a.unitprice) AS returntaxamount,\r\n\t\r\n\te.receivablequantity,\r\n\te.receivableamount,\r\n\te.jiesuan_amount,\r\n\t(isnull(e.receivableamount,0)-isnull(e.jiesuan_amount,0)) AS not_jiesuanamount,\r\n\t \r\n\tf.invoicequantity,\r\n\tf.invoiceamount,\r\n\t\r\n\tisnull(e.receivablequantity,0)-isnull(f.invoicequantity,0) as not_invoicequantity,\r\n\tisnull(e.receivableamount,0)-isnull(f.invoiceamount,0) as not_invoiceamount,\r\n\t\r\n\tg.cashamount,(isnull(e.receivableamount,0)-isnull(g.cashamount,0))as notreceived,\r\n\tg.hexiao_amount \r\nFROM\r\n\t(\r\n\tSELECT\r\n\t\ta.FID AS salesorderid,\r\n\t\ta.FBILLNO AS salesorderno,\r\n\t\ta.FDATE AS sale_date,\r\n\t\tc.FNAME AS currencyname,\r\n\t\td.FENTRYID AS detailid,\r\n\t\td.FMATERIALID AS productid,\r\n\t\td.FQTY AS quantity,\r\n\t\td.FALLAMOUNTEXCEPTDISCOUNT AS taxamount,\r\n\t\t( CASE WHEN d.FQTY= 0 THEN 0 ELSE d.FALLAMOUNTEXCEPTDISCOUNT/ d.FQTY END ) AS unitprice,\r\n\t\td.FUNITID AS unitid,\r\n\t\te.FNAME AS unitname,\r\n\t\tf.FNUMBER AS productno,\r\n\t\tf.FMNEMONICCODE as huohao,\r\n\t\tg.FSPECIFICATION as guige,\r\n\t\tg.FNAME AS productname,\r\n\t\th.FNAme AS accountname,\r\n\t\t(case when df.FISFREE=1 then '是' else '否' end)as  isfree\r\n\tFROM\r\n\t\tT_SAL_ORDER a\r\n\t\tLEFT JOIN T_SAL_ORDERFIN b ON a.FID= b.FID\r\n\t\tLEFT JOIN T_BD_CURRENCY_L c ON b.FSETTLECURRID= c.FCURRENCYID\r\n\t\tLEFT JOIN T_SAL_ORDERENTRY d ON d.FID= a.FID\r\n\t\tleft join T_SAL_ORDERENTRY_F df on df.FENTRYID=d.FENTRYID\r\n\t\tLEFT JOIN T_BD_UNIT_L e ON d.FUNITID= e.FUNITID\r\n\t\tLEFT JOIN T_BD_MATERIAL f ON d.FMATERIALID= f.FMATERIALID\r\n\t\tLEFT JOIN T_BD_MATERIAL_L g ON d.FMATERIALID= g.FMATERIALID \r\n\t\tLEFT JOIN T_BD_CUSTOMER_L h ON h.FCUSTID=a.FCUSTID\r\n\t\tWHERE CONVERT(VARCHAR(100), a.FDATE, 120) BETWEEN '{start_date}' AND  DATEADD(SECOND,24*36000-1,'{end_date}')\r\n\t) a\r\n\tLEFT JOIN (\r\n\tSELECT\r\n\t\ta.FID AS outid,\r\n\t\ta.FBILLNO AS outno,\r\n\t\tb.FENTRYID AS outdetailid,\r\n\t\tb.FREALQTY AS outquantity,\r\n\t\tb.FMATERIALID AS productid,\r\n\t\tc.FSBILLID AS salesorderid,\r\n\t\tc.FSID AS salesorderdetailid \r\n\tFROM\r\n\t\tT_SAL_OUTSTOCK a\r\n\t\tLEFT JOIN T_SAL_OUTSTOCKENTRY b ON a.FID= b.FID\r\n\t\tLEFT JOIN T_SAL_OUTSTOCKENTRY_LK c ON b.FENTRYID= c.FENTRYID \r\n\t) b ON a.detailid= b.salesorderdetailid \r\n\tLEFT JOIN (\r\n\t\tselect \r\n\t\ta.FID as noticeid,\r\n\t\ta.FBILLNO AS noticeno,\r\n\t\tb.FQTY as noticequantity,\r\n\t\tb.FMATERIALID AS productid,\r\n\t\tb.FENTRYID AS noticedetailid,\r\n\t\tc.FSBILLID as salesorderid,\r\n\t\tc.FSID as salesorderdetailid\r\n\t\tfrom T_SAL_RETURNNOTICE a \r\n\t\tleft join T_SAL_RETURNNOTICEENTRY b on a.FID=b.FID \r\n\t\tleft join T_SAL_RETURNNOTICEENTRY_LK c on b.FENTRYID=c.FENTRYID\r\n\t\twhere c.FSID>0\r\n\t)c ON a.detailid=c.salesorderdetailid\r\n\tleft join (\r\n\t\tselect \r\n\t\ta.FID as returnid,\r\n\t\ta.FBILLNO AS returnno,\r\n\t\tb.FREALQTY as returnquantity,\r\n\t\tb.FMATERIALID AS productid,\r\n\t\tb.FENTRYID AS returndetailid,\r\n\t\tc.FSBILLID as salesorderid,\r\n\t\tc.FSID as salesorderdetailid\r\n\t\tfrom T_SAL_RETURNSTOCK a \r\n\t\tleft join T_SAL_RETURNSTOCKENTRY b on a.FID=b.FID \r\n\t\tleft join T_SAL_RETURNSTOCKENTRY_LK c on b.FENTRYID=c.FENTRYID\r\n\t)d ON a.detailid=d.salesorderdetailid\r\n\tLEFT JOIN (\r\n\t\t\tselect \r\n\t\t\tsum(isnull(a.receivablequantity,0))as receivablequantity,\r\n\t\t\tsum(isnull(a.receivableamount,0))as receivableamount,\r\n\t\t\tsum(isnull(a.jiesuan_amount,0))as jiesuan_amount,\r\n\t\t\ta.outid,\r\n\t\t\ta.outdetailid\r\n\t\t\tfrom (\r\n\t\t\t\tselect \r\n\t\t\t\tb.FPRICEQTY as receivablequantity,\r\n\t\t\t\tb.FALLAMOUNTFOR AS receivableamount,\r\n\t\t\t\tb.FRECEIVEAMOUNT as jiesuan_amount,\r\n\t\t\t\tb.FENTRYID AS receivabledetailid,\r\n\t\t\t\tc.FSBILLID as outid,\r\n\t\t\t\tc.FSID as outdetailid\r\n\t\t\t\tfrom T_AR_RECEIVABLE a \r\n\t\t\t\tleft join T_AR_RECEIVABLEENTRY b on a.FID=b.FID \r\n\t\t\t\tleft join T_AR_RECEIVABLEENTRY_LK c on b.FENTRYID=c.FENTRYID\r\n\t\t\t\t\r\n\t\t\t\twhere c.FSBILLID>0\r\n\t\t\t\t\r\n\t\t\t)a  group by a.outid,a.outdetailid\r\n)e on b.outdetailid=e.outdetailid\r\n\tleft join (\r\n\t\tselect \r\n\t\tsum(isnull(a.invoicequantity,0))as invoicequantity,\r\n\t\tsum(isnull(a.totalamount,0))as invoiceamount,\r\n\t\ta.outid,\r\n\t\ta.outdetailid\r\n\t\tfrom \r\n\t\t(\t\r\n\t\t\tselect \r\n\t\t\ta.FID as invoiceid,\r\n\t\t\ta.FBILLNO AS invoiceno,\r\n\t\t\tb.FPRICEQTY as invoicequantity,\r\n\t\t\tb.FALLAMOUNTFOR as totalamount,\r\n\t\t\tb.FMATERIALID AS productid,\r\n\t\t\tb.FENTRYID AS invoicetailid,\r\n\t\t\tc.FSBILLID as receivableid,\r\n\t\t\tc.FSID as receivabletailid,\r\n\t\t\td.FSBILLID as outid,\r\n\t\t\td.FSID as outdetailid\r\n\t\t\tfrom T_IV_SALESIC a \r\n\t\t\tleft join T_IV_SALESICENTRY b on a.FID=b.FID \r\n\t\t\tleft join T_IV_SALESICENTRY_LK c on b.FENTRYID=c.FENTRYID\r\n\t\t\tleft join T_AR_RECEIVABLEENTRY_LK d on c.FSID=d.FENTRYID\r\n\t\t\twhere c.FSID>0\r\n\t\t\t) a  group by a.outid,a.outdetailid\r\n\t) f on b.outdetailid=f.outdetailid\r\n\tleft join (\r\n\t\t\tselect sum(cashamount)as cashamount,sum(hexiao_amount)as hexiao_amount,outid,outdetailid from (\r\n\t\t\tselect \r\n\t\t\tc.FREALRECAMOUNT AS cashamount,\r\n\t\t\tb.FWRITTENOFFAMOUNTFOR  as hexiao_amount,\r\n\t\t\td.FSBILLID as outid,\r\n\t\t\td.FSID as outdetailid\r\n\t\tfrom T_AR_RECEIVEBILL a \r\n\t\tleft join T_AR_RECEIVEBILLENTRY b on a.FID=b.FID \r\n\t\tleft join T_AR_RECEIVEBILLSRCENTRY_LK c on b.FENTRYID=c.FENTRYID\r\n\t\tleft join T_AR_RECEIVABLEENTRY_LK d on c.FSID=d.FENTRYID\r\n\t\twhere c.FSBILLID>0 \r\n\t)a group by outid,outdetailid\r\n) g on b.outdetailid=g.outdetailid \r\nWHERE  a.salesorderid>0\r\nand a.huohao like '%{huohao}%' \r\nand a.accountname like '%{accountname}%' \r\nand (case \r\n\twhen '{isoutbound}'='已出库' then b.outquantity\r\n\twhen '{isoutbound}'='未出库' then (isnull(a.quantity,0)-isnull(b.outquantity,0))\r\n\telse 1\r\n\tend )>0\r\nand (case \r\n\twhen '{isrefund}'='是' then d.returnquantity\r\n\telse 1\r\n\tend )>0\r\nand (case \r\n\twhen '{isvoice}'='已开票' then f.invoicequantity\r\n\twhen '{isvoice}'='未开票' then isnull(e.receivablequantity,0)-isnull(f.invoicequantity,0)\r\n\telse 1\r\n\tend )>0\r\nand (case \r\n\twhen '{is_jiesuan}'='已结算' then e.jiesuan_amount\r\n\twhen '{is_jiesuan}'='未结算' then (isnull(e.receivableamount,0)-isnull(e.jiesuan_amount,0))\r\n\telse 1\r\n\tend )>0\r\nORDER BY a.salesorderid DESC"
      },
      "1": {
        "Ident": "StiSqlSource",
