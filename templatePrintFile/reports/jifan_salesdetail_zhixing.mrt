        "NameInSource": "ldcrm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\ts.salesorderid,\r\n\ts.salesorder_no,\r\n \tascf.cf_4440 as sales_area,\r\n\ta.bill_state ,\r\n\tu.last_name,\r\n\tg.groupname\r\nFROM ld_salesorder s\r\nleft join ld_salesorderdetail sdetail on s.salesorderid=sdetail.id\r\nleft join ld_account a on a.accountid=s.accountid\r\nleft join ld_accountscf ascf on a.accountid=ascf.accountid\r\nleft join ld_users u on u.id=s.smownerid\r\nleft join ld_users2group u2g on u2g.userid=u.id\r\nleft join ld_groups g on g.groupid=u2g.groupid\r\nINNER JOIN (\r\n\tSELECT \r\n\t\tld_users.id AS userid \r\n\tFROM ld_users\r\n\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='SalesOrder' and scopeauthority=1 AND userid='[uuid]')\r\n\tUNION\r\n\tSELECT \r\n\t\tviewid AS userid \r\n\tFROM ld_scoperhigher\r\n\tWHERE userid='[uuid]' AND modulename ='SalesOrder' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename ='SalesOrder')\t\t\t\r\n\tUNION\r\n\tSELECT DISTINCT \r\n\t\tld_users2group.userid AS userid \r\n\tFROM ld_scoperhigher \r\n\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\tAND ld_scoperhigher.modulename ='SalesOrder'\r\n\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='SalesOrder' AND scopeauthority=3 AND userid='[uuid]')\r\n\tUNION \r\n\tSELECT \r\n\t\tid AS userid \r\n\tFROM ld_users  \r\n\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\tUNION\r\n\tSELECT '[uuid]' \r\n) AS tmp_users ON tmp_users.userid=s.smownerid\r\nwhere s.deleted=0\r\n\tAND s.approvestatus='已批准' \r\n\tAND s.salesorderid>0\r\n\tAND s.signed_data BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN TRIM('{accountname}')='' THEN 1=1\r\n\t\t\tELSE LOCATE(TRIM('{accountname}'),a.accountname)>0\r\n\t\tEND) \r\nand (case when '{province}'='' then 1=1 else a.bill_state like '%{province}%' end )\r\nand (case when '{account_area}'='' then 1=1 else ascf.cf_4440='{account_area}' end )\r\nAND(\r\n\tCASE\r\n\t\tWHEN FIND_IN_SET(1,'{data_range}') OR '{data_range}'='' THEN 1=1\r\n\t\tWHEN FIND_IN_SET(2,'{data_range}') THEN a.smownerid='[uuid]'\r\n\t\tELSE \r\n\t\t\t\t\ta.smownerid IN (\r\n\t\t\t\t\t\t\tSELECT\r\n\t\t\t\t\t\t\t\ta.userid\r\n\t\t\t\t\t\t\tFROM ld_users2group a\r\n\t\t\t\t\t\t\tINNER JOIN (\r\n\t\t\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\t\t\tsubstring_index(substring_index(a.splitsting,',',b.seq+1),',',-1)-200000 AS groupid\r\n\t\t\t\t\t\t\t\tFROM (SELECT '{data_range}' AS splitsting) a \r\n\t\t\t\t\t\t\t\tLEFT JOIN sequence b ON b.seq < (length(a.splitsting) - length(replace(a.splitsting,',',''))+1) \r\n\t\t\t\t\t\t\t\tWHERE substring_index(substring_index(a.splitsting,',',b.seq+1),',',-1) BETWEEN 200000 AND 300000\r\n\t\t\t\t\t\t\t) b ON b.groupid=a.groupid\r\n\t\t\t\t\t\t\tGROUP BY a.userid\r\n\t\t\t\t\t\t\tUNION \r\n\t\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\t\tsubstring_index(substring_index(a.splitsting,',',b.seq+1),',',-1)-300000 AS groupid\r\n\t\t\t\t\t\t\tFROM (SELECT '{data_range}' AS splitsting) a \r\n\t\t\t\t\t\t\tLEFT JOIN sequence b ON b.seq < (length(a.splitsting) - length(replace(a.splitsting,',',''))+1) \r\n\t\t\t\t\t\t\tWHERE substring_index(substring_index(a.splitsting,',',b.seq+1),',',-1)>300000\r\n\t\t\t\t\t)\r\n\tEND)"
      },
      "4": {
        "Ident": "StiMySqlSource",
        "Name": "list_users",
        "Alias": "list_users",
        "Columns": {
          "0": {
            "Name": "listid",
            "Index": -1,
            "NameInSource": "listid",
            "Alias": "listid",
            "Type": "System.Int32"
          },
          "1": {
            "Name": "listvalue",
            "Index": -1,
            "NameInSource": "listvalue",
            "Alias": "listvalue",
            "Type": "System.String"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT 1 AS listid,'全部' AS listvalue\r\nUNION\r\nSELECT 2, '我负责的'\r\nUNION\r\n(SELECT\r\n\ta.groupid+200000,\r\n\tCONCAT('部门::',IFNULL(a.groupname,''))\r\nFROM (\r\n\tSELECT \r\n\t\ta.groupid, \r\n\t\ta.groupname, \r\n\t\tLPAD(substring_index(substring_index(a.splitsting,',',b.seq+1),',',-1),8,'0') AS splitsting\r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\ta.groupid,\r\n\t\t\ta.groupname, \r\n\t\t\tREPLACE(a.parentgroup,'::',',') AS splitsting \r\n\t\tFROM ld_groups a\r\n\t\tLEFT JOIN ld_users2group b ON b.groupid=a.groupid\r\n\t\tGROUP BY a.groupid\r\n\t) a \r\n\tLEFT JOIN sequence b ON b.seq < (length(a.splitsting) - length(replace(a.splitsting,',',''))+1)\r\n) a\r\nGROUP BY a.groupid\r\nORDER BY GROUP_CONCAT(IFNULL(a.splitsting,'') ORDER BY a.splitsting SEPARATOR '::'))\r\nUNION \r\n(SELECT\r\n\ta.id+300000,\r\n\tCONCAT('用户::',IFNULL(a.last_name,''))\r\nFROM ld_users a\r\nINNER JOIN (\r\n\tSELECT DISTINCT\r\n\t\tuserid \r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\tld_users.id AS userid \r\n\t\tFROM ld_users\r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename IN ('SalesOrder','ServiceContracts') and scopeauthority=1 AND userid='[uuid]')\r\n\t\tUNION\r\n\t\tSELECT \r\n\t\t\tviewid AS userid \r\n\t\tFROM ld_scoperhigher\r\n\t\tWHERE userid='[uuid]' AND modulename IN ('SalesOrder','ServiceContracts') AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename IN ('SalesOrder','ServiceContracts'))\t\t\t\r\n\t\tUNION\r\n\t\tSELECT DISTINCT \r\n\t\t\tld_users2group.userid AS userid \r\n\t\tFROM ld_scoperhigher \r\n\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\tAND ld_scoperhigher.modulename IN ('SalesOrder','ServiceContracts')\r\n\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename IN ('SalesOrder','ServiceContracts') AND scopeauthority=3 AND userid='[uuid]')\r\n\t\tUNION \r\n\t\tSELECT \r\n\t\t\tid AS userid \r\n\t\tFROM ld_users  \r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\tUNION\r\n\t\tSELECT '[uuid]') AS vw_users\r\n) AS tmp_users ON tmp_users.userid=a.id\r\nWHERE a.deleted=0\r\n\tAND a.`status`='Active'\r\nORDER BY CONVERT(a.last_name USING gbk))"
      },
      "5": {
        "Ident": "StiMySqlSource",
        "Name": "list_area",
        "Alias": "list_area",
        "Columns": {
          "0": {
            "Name": "listvalue",
            "Index": -1,
            "NameInSource": "listvalue",
            "Alias": "listvalue",
            "Type": "System.String"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "select \r\nlistvalue \r\nfrom ld_picklist_set\r\nleft join ld_picklist_values on ld_picklist_set.listid=ld_picklist_values.listid\r\nwhere ld_picklist_set.listname='cf_4440';"
      }
    },
