        "NameInSource": "crm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\tid,\r\n\tb01_billno,\r\n\tb02_area,\r\n\tb03_ordernum,\r\n\tb04_kehuname,\r\n\tb05_qianyuefang,\r\n\tb06_ordertype,\r\n\tb07_qianyuedate,\r\n\tb08_qianyueren,\r\n\tb09_orderamount,\r\n\tb10_invoiceamount,\r\n\tb11_shouruamount,\r\n\tpotentialid,\r\n\tfee01_xiangmu+fee02_bxll+fee03_wxfw+fee04_dz+fee05_az+fee06_bg+fee07_yunshu+fee08_fulli+fee09_jiaoji+fee10_jiaotong+fee11_tingche+fee12_chailv+fee13_shouji+fee14_youji AS fee00_all,\r\n\tCASE\r\n\t\tWHEN b11_shouruamount=0 THEN 1\r\n\t\tELSE (b11_shouruamount-(fee01_xiangmu+fee02_bxll+fee03_wxfw+fee04_dz+fee05_az+fee06_bg+fee07_yunshu+fee08_fulli+fee09_jiaoji+fee10_jiaotong+fee11_tingche+fee12_chailv+fee13_shouji+fee14_youji))/b11_shouruamount\r\n\tEND AS fee00_gp,\r\n\tfee01_xiangmu,\r\n\tfee02_bxll,\r\n\tfee03_wxfw,\r\n\tfee04_dz,\r\n\tfee05_az,\r\n\tfee06_bg,\r\n\tfee07_yunshu,\r\n\tfee08_fulli,\r\n\tfee09_jiaoji,\r\n\tfee10_jiaotong,\r\n\tfee11_tingche,\r\n\tfee12_chailv,\r\n\tfee13_shouji,\r\n\tfee14_youji,\r\n\tb13_tiaokuan,\r\n\tb14_beizhu\r\nFROM (\r\nSELECT\r\n\ta.salesorderid AS id,\r\n\ta.salesorder_no AS b01_billno,\r\n\tb.cf_2395 AS b02_area,\r\n\tc.potentialname AS b03_ordernum,\r\n\tk.accountname AS b04_kehuname,\r\n\tb.cf_2327 AS b05_qianyuefang,\r\n\tb.cf_2323 AS b06_ordertype,\r\n\ta.signed_data AS b07_qianyuedate,\r\n\tu.last_name AS b08_qianyueren,\r\n\ta.total AS b09_orderamount,\r\n\ta.have_invoicetotal AS b10_invoiceamount,\r\n\tROUND(IFNULL(e.list_amount,0),2) AS b11_shouruamount,\r\n\td.potentialid,\r\n\tSUM(CASE WHEN g.expensetype IN ('项目费') THEN h.rmb_total ELSE 0 END) AS fee01_xiangmu,\r\n\tSUM(CASE WHEN g.expensetype IN ('维修材料费用','焊炬租用','焊具租用') THEN h.rmb_total ELSE 0 END) AS fee02_bxll,\r\n\tSUM(CASE WHEN g.expensetype IN ('维修服务费') THEN h.rmb_total ELSE 0 END) AS fee03_wxfw,\r\n\tSUM(CASE WHEN g.expensetype IN ('吊装费') THEN h.rmb_total ELSE 0 END) AS fee04_dz,\r\n\tSUM(CASE WHEN g.expensetype IN ('安装费') THEN h.rmb_total ELSE 0 END) AS fee05_az,\r\n\tSUM(CASE WHEN g.expensetype IN ('办公用品','网络费') THEN h.rmb_total ELSE 0 END) AS fee06_bg,\r\n\tSUM(CASE WHEN g.expensetype IN ('运输费') THEN h.rmb_total ELSE 0 END) AS fee07_yunshu,\r\n\tSUM(CASE WHEN g.expensetype IN ('市内餐补','出差餐补','加班补贴') THEN h.rmb_total ELSE 0 END) AS fee08_fulli,\r\n\tSUM(CASE WHEN g.expensetype IN ('交际费') THEN h.rmb_total ELSE 0 END) AS fee09_jiaoji,\r\n\tSUM(CASE WHEN g.expensetype IN ('市内交通费','车贴','过路费') THEN h.rmb_total ELSE 0 END) AS fee10_jiaotong,\r\n\tSUM(CASE WHEN g.expensetype IN ('停车费') THEN h.rmb_total ELSE 0 END) AS fee11_tingche,\r\n\tSUM(CASE WHEN g.expensetype IN ('出差交通费','住宿费') THEN h.rmb_total ELSE 0 END) AS fee12_chailv,\r\n\tSUM(CASE WHEN g.expensetype IN ('手机费') THEN h.rmb_total ELSE 0 END) AS fee13_shouji,\r\n\tSUM(CASE WHEN g.expensetype IN ('快递费') THEN h.rmb_total ELSE 0 END) AS fee14_youji,\r\n\tb.cf_2321 AS b13_tiaokuan,\r\n\ta.description AS b14_beizhu\r\nFROM ld_salesorder a\r\nLEFT JOIN ld_salesordercf b ON b.salesorderid=a.salesorderid\r\nLEFT JOIN ld_account k ON k.accountid=a.accountid\r\nLEFT JOIN ld_potential c ON c.potentialid=a.potentialid\r\nLEFT JOIN ld_potentialscf d ON d.cf_2897=c.potentialname\r\nLEFT JOIN ld_users u ON u.id=a.smownerid\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\tb.entitytypeid,\r\n\t\tSUM(b.list_amount) AS list_amount,\r\n\t\tSUM(b.tax_amount) AS tax_amount\r\n\tFROM ld_invoice a\r\n\tLEFT JOIN ld_invoicedetail b ON b.id=a.invoiceid\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND b.entitytypeid>0\r\n\tGROUP BY b.entitytypeid\r\n) e ON e.entitytypeid=a.salesorderid\r\nLEFT JOIN (SELECT expenseid,potentialid FROM ld_expense WHERE deleted=0 AND approvestatus='已批准' AND potentialid>0) f ON f.potentialid=d.potentialid\r\nLEFT JOIN ld_expensedetail g ON g.expenseid=f.expenseid\r\nLEFT JOIN ld_expensedetailscf h ON h.expensedetailid=g.expensedetailid\r\nINNER JOIN (\r\n\tSELECT DISTINCT\r\n\t\tuserid \r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\tld_users.id AS userid \r\n\t\tFROM ld_users\r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='SalesOrder' and scopeauthority=1 AND userid='[uuid]')\r\n\t\tUNION\r\n\t\tSELECT \r\n\t\t\tviewid AS userid \r\n\t\tFROM ld_scoperhigher\r\n\t\tWHERE userid='[uuid]' AND modulename ='SalesOrder' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename ='SalesOrder')\t\t\t\r\n\t\tUNION\r\n\t\tSELECT DISTINCT \r\n\t\t\tld_users2group.userid AS userid \r\n\t\tFROM ld_scoperhigher \r\n\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\tAND ld_scoperhigher.modulename ='SalesOrder'\r\n\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='SalesOrder' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\tUNION \r\n\t\tSELECT \r\n\t\t\tid AS userid \r\n\t\tFROM ld_users  \r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\tUNION\r\n\t\tSELECT '[uuid]') AS vw_users\r\n) AS tmp_users ON tmp_users.userid=a.smownerid\r\nWHERE a.deleted=0\r\n\tAND a.approvestatus<>'已拒绝'\r\n\tAND a.signed_data BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN TRIM('{quyu}')='' THEN 1=1\r\n\t\t\tELSE FIND_IN_SET(b.cf_2395,'{quyu}')\r\n\t\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN TRIM('{custname}')='' THEN 1=1\r\n\t\t\tELSE LOCATE(TRIM('{custname}'),b.cf_2327)>0\r\n\t\tEND) \r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN TRIM('{ordernum}')='' THEN 1=1\r\n\t\t\tELSE LOCATE(TRIM('{ordernum}'),c.potentialname)>0\r\n\t\tEND) \r\n\tAND(\r\n\t\tCASE\r\n\t\t\tWHEN FIND_IN_SET(1,'{data_range}') OR '{data_range}'='' THEN 1=1\r\n\t\t\tWHEN FIND_IN_SET(2,'{data_range}') THEN a.smownerid='[uuid]'\r\n\t\t\tELSE \r\n\t\t\t\t\t\ta.smownerid IN (\r\n\t\t\t\t\t\t\t\tSELECT\r\n\t\t\t\t\t\t\t\t\ta.userid\r\n\t\t\t\t\t\t\t\tFROM ld_users2group a\r\n\t\t\t\t\t\t\t\tINNER JOIN (\r\n\t\t\t\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\t\t\t\tsubstring_index(substring_index(a.splitsting,',',b.seq+1),',',-1)-200000 AS groupid\r\n\t\t\t\t\t\t\t\t\tFROM (SELECT '{data_range}' AS splitsting) a \r\n\t\t\t\t\t\t\t\t\tLEFT JOIN sequence b ON b.seq < (length(a.splitsting) - length(replace(a.splitsting,',',''))+1) \r\n\t\t\t\t\t\t\t\t\tWHERE substring_index(substring_index(a.splitsting,',',b.seq+1),',',-1) BETWEEN 200000 AND 300000\r\n\t\t\t\t\t\t\t\t) b ON b.groupid=a.groupid\r\n\t\t\t\t\t\t\t\tGROUP BY a.userid\r\n\t\t\t\t\t\t\t\tUNION \r\n\t\t\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\t\t\tsubstring_index(substring_index(a.splitsting,',',b.seq+1),',',-1)-300000 AS groupid\r\n\t\t\t\t\t\t\t\tFROM (SELECT '{data_range}' AS splitsting) a \r\n\t\t\t\t\t\t\t\tLEFT JOIN sequence b ON b.seq < (length(a.splitsting) - length(replace(a.splitsting,',',''))+1) \r\n\t\t\t\t\t\t\t\tWHERE substring_index(substring_index(a.splitsting,',',b.seq+1),',',-1)>300000\r\n\t\t\t\t\t\t)\r\n\t\tEND)\r\nGROUP BY a.salesorderid\r\n) aa"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "list_quyu",
        "Alias": "list_quyu",
        "Columns": {
          "0": {
