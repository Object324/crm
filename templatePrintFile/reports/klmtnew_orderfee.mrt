        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\tb.listvalue\r\nFROM ld_picklist_set a\r\nLEFT JOIN ld_picklist_values b ON b.listid=a.listid\r\nWHERE a.listname='cf_2395'\r\nORDER BY sequence"
      },
      "2": {
        "Ident": "StiMySqlSource",
