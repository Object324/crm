            "NameInSource": "last_name",
            "Alias": "last_name",
            "Type": "System.String"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\ta.id,\r\n\ta.last_name\r\nFROM ld_users a\r\nINNER JOIN (\r\n\tSELECT DISTINCT\r\n\t\tuserid \r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\tld_users.id AS userid \r\n\t\tFROM ld_users\r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='Quotes' and scopeauthority=1 AND userid='[uuid]')\r\n\t\tUNION\r\n\t\tSELECT \r\n\t\t\tviewid AS userid \r\n\t\tFROM ld_scoperhigher\r\n\t\tWHERE userid='[uuid]' AND modulename='Quotes' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename='Quotes')\t\t\t\r\n\t\tUNION\r\n\t\tSELECT DISTINCT \r\n\t\t\tld_users2group.userid AS userid \r\n\t\tFROM ld_scoperhigher \r\n\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\tAND ld_scoperhigher.modulename='Quotes'\r\n\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='Quotes' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\tUNION \r\n\t\tSELECT \r\n\t\t\tid AS userid \r\n\t\tFROM ld_users  \r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\tUNION\r\n\t\tSELECT '[uuid]') AS vw_users\r\n) AS tmp_users ON tmp_users.userid=a.id\r\nWHERE a.deleted=0\r\nORDER BY CONVERT(a.last_name USING GBK)"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "list_type",
        "Alias": "list_type",
        "Columns": {
          "0": {
            "Name": "sourcevalue",
            "Index": -1,
            "NameInSource": "sourcevalue",
            "Alias": "sourcevalue",
            "Type": "System.String"
          },
          "1": {
            "Name": "targetvalues",
            "Index": -1,
            "NameInSource": "targetvalues",
            "Alias": "targetvalues",
            "Type": "System.String"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\tsourcevalue,\r\n\ttargetvalues\r\nFROM (\r\n\t(\r\n\t\tSELECT \r\n\t\t'全部' AS sourcevalue,\r\n\t\t'全部' AS targetvalues,\r\n\t\t-3 AS seq1,\r\n\t\t-3 AS seq2\r\n\t)\r\n\tUNION \r\n\t(\r\n\t\tSELECT \r\n\t\t\t'全部' AS sourcevalue,\r\n\t\t\tlistvalue AS targetvalues,\r\n\t\t\t-2 AS seq1,\r\n\t\t\tsequence AS seq2\r\n\t\tFROM ld_picklist_values \r\n\t\tWHERE listid=120 \r\n\t)\r\n\tUNION\r\n\t(\r\n\t\tSELECT\r\n\t\t\ta.sourcevalue,\r\n\t\t\ta.targetvalues,\r\n\t\t\tb.sequence seq1,\r\n\t\t\tIFNULL(c.sequence,-1) AS seq2\r\n\t\tFROM (\r\n\t\t\tSELECT \r\n\t\t\t\ta.sourcevalue,\r\n\t\t\t\tsubstring_index(substring_index(a.targetvalues,',',b.seq+1),',',-1) AS targetvalues\r\n\t\t\tFROM (\r\n\t\t\t\tSELECT \r\n\t\t\t\t\ttabid,\r\n\t\t\t\t\tsourcevalue,REPLACE(REPLACE(REPLACE(targetvalues,'[\"',''),'\"]',''),'\"','') AS targetvalues \r\n\t\t\t\tFROM ld_picklist_dependency \r\n\t\t\t\tWHERE tabid=20\r\n\t\t\t) a \r\n\t\t\tLEFT JOIN sequence b ON b.seq < (length(a.targetvalues) - length(replace(a.targetvalues,',',''))+1) \r\n\t\t\tWHERE a.tabid=20\r\n\t\t\tUNION\r\n\t\t\t(SELECT listvalue AS sourcevalue,'全部' AS targetvalues FROM ld_picklist_values WHERE listid=119)\r\n\t\t) a\r\n\t\tLEFT JOIN (SELECT listvalue,sequence FROM ld_picklist_values WHERE listid=119) b ON b.listvalue=a.sourcevalue\r\n\t\tLEFT JOIN (SELECT listvalue,sequence FROM ld_picklist_values WHERE listid=120) c ON c.listvalue=a.targetvalues\r\n\t)\r\n) t\r\nORDER BY seq1,seq2"
      },
