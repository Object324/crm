<StiSerializer version="1.02" type="Flex" application="StiReport">
  <Dictionary type="Dictionary" isKey="true" Ref="1">
    <Databases isList="true" count="1">
      <ldcrm type="Stimulsoft.Report.Dictionary.StiMySqlDatabase" isKey="true" Ref="2">
        <Alias>ldcrm</Alias>
        <ConnectionStringEncrypted>9Gxz62FcS83hR9WI6CU0n8LQdWBhD1GFwxWx3GqEdy/CyPvKxgvziEYa0fBhXKQvgW5lr+9tM+1r
E8H06vgyI4NgaS3GT0O8Z0n9jcR0tWf/FN3CYVFagUZcoOBnVHTv</ConnectionStringEncrypted>
        <Name>ldcrm</Name>
      </ldcrm>
    </Databases>
    <DataSources isList="true" count="4">
      <users type="Stimulsoft.Report.Dictionary.StiMySqlSource" isKey="true" Ref="3">
        <Alias>users</Alias>
        <Columns isList="true" count="2">
          <value>id,System.Int32</value>
          <value>last_name,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1"/>
        <Name>users</Name>
        <NameInSource>ldcrm</NameInSource>
        <Parameters isList="true" count="0"/>
        <SqlCommand>SELECT
	id,
	last_name
FROM ld_users 
WHERE `status`='Active'
	AND last_name IN ('罗来宝','罗方','白宇')</SqlCommand>
      </users>
      <order_status type="Stimulsoft.Report.Dictionary.StiMySqlSource" isKey="true" Ref="4">
        <Alias>order_status</Alias>
        <Columns isList="true" count="1">
          <value>sostatus,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1"/>
        <Name>order_status</Name>
        <NameInSource>ldcrm</NameInSource>
        <Parameters isList="true" count="0"/>
        <SqlCommand>SELECT
	b.listvalue AS sostatus
FROM ld_picklist_set a
LEFT JOIN ld_picklist_values b ON a.listid=b.listid 
WHERE a.listname='sostatus'
	AND a.relatetable='ld_field'
	AND b.listvalue NOT IN ('已取消')</SqlCommand>
      </order_status>
      <report type="Stimulsoft.Report.Dictionary.StiMySqlSource" isKey="true" Ref="5">
        <Alias>report</Alias>
        <Columns isList="true" count="19">
          <value>salesorderid,System.Int32</value>
          <value>salesorder_no,System.String</value>
          <value>signed_data,System.DateTime</value>
          <value>rkdate,System.DateTime</value>
          <value>accountname,System.String</value>
          <value>productname,System.String</value>
          <value>productsheet,System.String</value>
          <value>sostatus,System.String</value>
          <value>stockpresence,System.String</value>
          <value>cf_2319,System.String</value>
          <value>smownerid,System.Int32</value>
          <value>last_name,System.String</value>
          <value>quantity,System.Decimal</value>
          <value>danjia,System.Decimal</value>
          <value>xiaoji,System.Decimal</value>
          <value>haveoutproductcount,System.Decimal</value>
          <value>balanceoutproductcount,System.Decimal</value>
          <value>balancepurchasecount,System.Decimal</value>
          <value>comment,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1"/>
        <Name>report</Name>
        <NameInSource>ldcrm</NameInSource>
        <Parameters isList="true" count="0"/>
        <SqlCommand>SELECT
	a.salesorderid,
	a.salesorder_no,
	a.signed_data,
	(SELECT MAX(p.createdate) FROM ld_stock p LEFT JOIN ld_inventoryproductrel i ON p.stock_id=i.id WHERE i.entitytypeid=a.salesorderid) AS rkdate,
	c.accountname,
	d.productname,
	d.productsheet,
	a.sostatus,
	a.stockpresence,
	a.cf_2319,
	a.smownerid,
	e.last_name,
	b.quantity,
	d.unit_price*0.21 AS danjia,
	b.quantity*d.unit_price*0.21 xiaoji,
	b.haveoutproductcount,
	b.balanceoutproductcount,
	b.balancepurchasecount,
	b.`comment`
FROM ld_salesorder a
LEFT JOIN ld_inventoryproductrel b ON a.salesorderid=b.id
LEFT JOIN ld_account c ON c.accountid=a.accountid
LEFT JOIN ld_products d ON d.productid=b.productid
LEFT JOIN ld_users e ON e.id=a.smownerid
WHERE a.deleted=0
	AND a.approvestatus&lt;&gt;'已拒绝'
	AND signed_data BETWEEN STR_TO_DATE('{start_date}','%m/%d/%Y') AND STR_TO_DATE('{end_date}','%m/%d/%Y')
	AND LOCATE(TRIM('{custname}'),c.accountname)&gt;0
	AND LOCATE(TRIM('{orderno}'),a.salesorder_no)&gt;0
	AND (
		CASE
			WHEN TRIM('{ckzt}')='' THEN a.stockpresence NOT IN ('全部出库')
			ELSE FIND_IN_SET(a.stockpresence,'{ckzt}')
		END)
	AND (
		CASE
			WHEN TRIM('{ddzt}')='' THEN a.sostatus NOT IN ('已取消')
			ELSE FIND_IN_SET(a.sostatus,'{ddzt}')
		END)
	AND (
		CASE
			WHEN '{cgzt}'='' THEN 1=1
			ELSE FIND_IN_SET(IF(IFNULL(a.cf_2319,'')='','未采购',a.cf_2319),'{cgzt}')
		END)
	AND (
		CASE
			WHEN '{userid}'='' THEN FIND_IN_SET(a.smownerid,'18,19,20')
			ELSE FIND_IN_SET(a.smownerid,'{userid}')
		END)</SqlCommand>
      </report>
      <purchase_data type="Stimulsoft.Report.Dictionary.StiMySqlSource" isKey="true" Ref="6">
        <Alias>purchase_data</Alias>
        <Columns isList="true" count="1">
          <value>json_products,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1"/>
        <Name>purchase_data</Name>
        <NameInSource>ldcrm</NameInSource>
        <Parameters isList="true" count="0"/>
        <SqlCommand>SELECT
	CONCAT('[',GROUP_CONCAT(CONCAT((select symbol from tmp_symbol where id=1),'"productid":',b.productid,',"quantity":',REPLACE(b.balanceoutproductcount,',',''),',"lineitem_id":',b.lineitem_id,',"entitytype":','"SalesOrder"',(select symbol from tmp_symbol where id=2))),']') AS json_products
FROM ld_salesorder a
LEFT JOIN ld_inventoryproductrel b ON a.salesorderid=b.id
LEFT JOIN ld_account c ON c.accountid=a.accountid
LEFT JOIN ld_products d ON d.productid=b.productid
LEFT JOIN ld_users e ON e.id=a.smownerid
WHERE a.deleted=0
	AND a.approvestatus&lt;&gt;'已拒绝'
	AND b.balanceoutproductcount&gt;0
	AND signed_data BETWEEN STR_TO_DATE('{start_date}','%m/%d/%Y') AND STR_TO_DATE('{end_date}','%m/%d/%Y')
	AND LOCATE(TRIM('{custname}'),c.accountname)&gt;0
	AND LOCATE(TRIM('{orderno}'),a.salesorder_no)&gt;0
	AND (
		CASE
			WHEN TRIM('{ckzt}')='' THEN a.stockpresence NOT IN ('全部出库')
			ELSE FIND_IN_SET(a.stockpresence,'{ckzt}')
		END)
	AND (
		CASE
			WHEN TRIM('{ddzt}')='' THEN a.sostatus NOT IN ('已取消')
			ELSE FIND_IN_SET(a.sostatus,'{ddzt}')
		END)
	AND (
		CASE
			WHEN '{cgzt}'='' THEN 1=1
			ELSE FIND_IN_SET(IF(IFNULL(a.cf_2319,'')='','未采购',a.cf_2319),'{cgzt}')
		END)
	AND (
		CASE
			WHEN '{userid}'='' THEN FIND_IN_SET(a.smownerid,'18,19,20')
			ELSE FIND_IN_SET(a.smownerid,'{userid}')
		END)</SqlCommand>
      </purchase_data>
    </DataSources>
