{"ReportVersion":"2023.2.2","ReportGuid":"aaddc3adac6b065506558742490c817f","ReportName":"Report","ReportAlias":"综合排序","ReportFile":"CustomReport_18_89.mrt","ReportCreated":"/Date(1575034647000+0800)/","ReportChanged":"/Date(1686568683000+0800)/","EngineVersion":"EngineV2","CalculationMode":"Interpretation","ReportUnit":"Centimeters","PreviewSettings":268435455,"Styles":{"0":{"Ident":"StiStyle","Name":"column_odd","VertAlignment":"Center","Font":"微软雅黑;9;;","Border":";128,128,128;;;;;;solid:0,0,0","Brush":"solid:255,255,255","TextBrush":"solid:0,0,0","NegativeTextBrush":"solid:255,0,0","AllowUseHorAlignment":true,"AllowUseVertAlignment":true,"AllowUseBorderSidesFromLocation":true},"1":{"Ident":"StiStyle","Name":"column_even","VertAlignment":"Center","Font":"微软雅黑;9;;","Border":";128,128,128;;;;;;solid:0,0,0","Brush":"solid:252,252,252","TextBrush":"solid:0,0,0","NegativeTextBrush":"solid:255,0,0","AllowUseHorAlignment":true,"AllowUseVertAlignment":true,"AllowUseBorderSidesFromLocation":true}},"Dictionary":{"Variables":{"0":{"Value":"Year(Today)","Name":"nian","DialogInfo":{"DateTimeType":"DateAndTime","ItemsInitializationType":"Columns","KeysColumn":"list_nian.list_value","ValuesColumn":"list_nian.list_value"},"Alias":"年度","Type":"System.String","RequestFromUser":true,"InitBy":"Expression"},"1":{"Value":"月度","Name":"date_type","DialogInfo":{"DateTimeType":"DateAndTime","ItemsInitializationType":"Columns","KeysColumn":"list_date.list_key","ValuesColumn":"list_date.list_key","AllowUserValues":false},"Alias":"时间类型","Type":"System.String","RequestFromUser":true},"2":{"Value":"1","Name":"weidu","DialogInfo":{"DateTimeType":"DateAndTime","ItemsInitializationType":"Columns","KeysColumn":"list_weidu.list_key","ValuesColumn":"list_weidu.list_value","AllowUserValues":false},"Alias":"查询方式","Type":"System.String","RequestFromUser":true},"3":{"Value":"50","Name":"rate_ht","DialogInfo":{"DateTimeType":"DateAndTime"},"Alias":"合同额权重","Type":"System.Single","RequestFromUser":true},"4":{"Value":"0","Name":"rate_xs","DialogInfo":{"DateTimeType":"DateAndTime"},"Alias":"线索权重","Type":"System.Single","RequestFromUser":true},"5":{"Value":"30","Name":"rate_lx","DialogInfo":{"DateTimeType":"DateAndTime"},"Alias":"立项权重","Type":"System.Single","RequestFromUser":true},"6":{"Name":"chanpinxian","DialogInfo":{"DateTimeType":"DateAndTime","ItemsInitializationType":"Columns","KeysColumn":"list_chanpinxian.listvalue","ValuesColumn":"list_chanpinxian.listvalue","AllowUserValues":false},"Alias":"产品线","Type":"Stimulsoft.Report.StringList","RequestFromUser":true},"7":{"Name":"date_value","DialogInfo":{"DateTimeType":"DateAndTime","ItemsInitializationType":"Columns","KeysColumn":"list_date.list_value","ValuesColumn":"list_date.list_value","BindingValuesColumn":"list_date.list_key","AllowUserValues":false,"BindingValue":true,"BindingVariable":"date_type"},"Alias":"时间范围","Type":"Stimulsoft.Report.StringList","RequestFromUser":true,"SelectionMode":"Nothing"},"8":{"Name":"ziweidu","DialogInfo":{"DateTimeType":"DateAndTime","ItemsInitializationType":"Columns","KeysColumn":"list_weidu.list_key2","ValuesColumn":"list_weidu.list_value2","BindingValuesColumn":"list_weidu.list_key","AllowUserValues":false,"BindingValue":true,"BindingVariable":"weidu"},"Alias":"范围明细","Type":"Stimulsoft.Report.StringList","RequestFromUser":true},"9":{"Value":"10","Name":"rate_sr","DialogInfo":{"DateTimeType":"DateAndTime"},"Alias":"营业收入权重","Type":"System.Single","RequestFromUser":true},"10":{"Value":"10","Name":"rate_sj","DialogInfo":{"DateTimeType":"DateAndTime"},"Alias":"商机权重","Type":"System.Single","RequestFromUser":true}},"DataSources":{"0":{"Ident":"StiMySqlSource","Name":"b","Alias":"b","Columns":{"0":{"Name":"mubiao_desp","NameInSource":"mubiao_desp","Alias":"mubiao_desp","Type":"System.String"},"1":{"Name":"mubiao_type","NameInSource":"mubiao_type","Alias":"mubiao_type","Type":"System.String"},"2":{"Name":"mb_hetong","NameInSource":"mb_hetong","Alias":"mb_hetong","Type":"System.Decimal"},"3":{"Name":"wc_hetong","NameInSource":"wc_hetong","Alias":"wc_hetong","Type":"System.Decimal"},"4":{"Name":"rate_hetong","NameInSource":"rate_hetong","Alias":"rate_hetong","Type":"System.Decimal"},"5":{"Name":"mb_shouru","NameInSource":"mb_shouru","Alias":"mb_shouru","Type":"System.Decimal"},"6":{"Name":"wc_shouru","NameInSource":"wc_shouru","Alias":"wc_shouru","Type":"System.Decimal"},"7":{"Name":"rate_shouru","NameInSource":"rate_shouru","Alias":"rate_shouru","Type":"System.Decimal"},"8":{"Name":"mb_xiansuo","NameInSource":"mb_xiansuo","Alias":"mb_xiansuo","Type":"System.Decimal"},"9":{"Name":"wc_xiansuo","NameInSource":"wc_xiansuo","Alias":"wc_xiansuo","Type":"System.Decimal"},"10":{"Name":"wc_xiansuo_zhou","NameInSource":"wc_xiansuo_zhou","Alias":"wc_xiansuo_zhou","Type":"System.Decimal"},"11":{"Name":"rate_xiansuo","NameInSource":"rate_xiansuo","Alias":"rate_xiansuo","Type":"System.Decimal"},"12":{"Name":"mb_shangji","NameInSource":"mb_shangji","Alias":"mb_shangji","Type":"System.Decimal"},"13":{"Name":"wc_shangji","NameInSource":"wc_shangji","Alias":"wc_shangji","Type":"System.Decimal"},"14":{"Name":"wc_shangji_zhou","NameInSource":"wc_shangji_zhou","Alias":"wc_shangji_zhou","Type":"System.Decimal"},"15":{"Name":"rate_shangji","NameInSource":"rate_shangji","Alias":"rate_shangji","Type":"System.Decimal"},"16":{"Name":"mb_lixiang","NameInSource":"mb_lixiang","Alias":"mb_lixiang","Type":"System.Decimal"},"17":{"Name":"wc_lixiang","NameInSource":"wc_lixiang","Alias":"wc_lixiang","Type":"System.Decimal"},"18":{"Name":"wc_lixiang_zhou","NameInSource":"wc_lixiang_zhou","Alias":"wc_lixiang_zhou","Type":"System.Decimal"},"19":{"Name":"rate_lixiang","NameInSource":"rate_lixiang","Alias":"rate_lixiang","Type":"System.Decimal"},"20":{"Name":"rate_total","NameInSource":"rate_total","Alias":"rate_total","Type":"System.Decimal"}},"NameInSource":"ldcrm","SqlCommand":"SELECT\r\n\tmubiao_desp,\r\n\tCASE\r\n\t\tWHEN '{weidu}'=2 THEN CONCAT(mubiao_type,'  (负责人：',IFNULL((SELECT last_name FROM list_users WHERE  userlevel='区域负责人' AND user_pianqu=a.mubiao_type and groupname=a.mubiao_type LIMIT 1),''),')')\r\n\t\tWHEN '{weidu}'=5 THEN CONCAT(mubiao_type,'  (负责人：',IFNULL((SELECT last_name FROM list_users WHERE  userlevel='区域负责人' AND user_quyu=a.mubiao_type and groupname=a.mubiao_type LIMIT 1),''),')')\r\n\t\tELSE mubiao_type\r\n\tEND AS mubiao_type,\r\n\tmb_hetong,\r\n\twc_hetong,\r\n\trate_hetong,\r\n\r\n\tmb_shouru,\r\n\twc_shouru,\r\n\trate_shouru,\r\n\r\n\tmb_xiansuo,\r\n\twc_xiansuo,\r\n\twc_xiansuo_zhou,\r\n\trate_xiansuo,\r\n\r\n\tmb_shangji,\r\n\twc_shangji,\r\n\twc_shangji_zhou,\r\n\trate_shangji,\r\n\r\n\tmb_lixiang,\r\n\twc_lixiang,\r\n\twc_lixiang_zhou,\r\n\trate_lixiang,\r\n\r\n\t(IFNULL(rate_hetong,0)*'{rate_ht}'+IFNULL(rate_shouru,0)*'{rate_sr}'+IFNULL(rate_xiansuo,0)*'{rate_xs}'+IFNULL(rate_shangji,0)*'{rate_sj}'+IFNULL(rate_lixiang,0)*'{rate_lx}')*0.01 AS rate_total\r\nFROM (\r\nSELECT\r\n\tCASE\r\n\t\tWHEN '{weidu}'=1 THEN '客户经理'\r\n\t\tWHEN '{weidu}'=2 THEN '区域'\r\n\t\tWHEN '{weidu}'=3 THEN '大区'\r\n\t\tWHEN '{weidu}'=5 THEN '片区'\r\n\t\tELSE '公司整体'\r\n\tEND AS mubiao_desp,\r\n\tmubiao_type,\r\n\r\n\tSUM(mb_hetong) AS mb_hetong,\r\n\tSUM(wc_hetong) AS wc_hetong,\r\n\tCASE\r\n\t\tWHEN SUM(mb_hetong)>0 THEN SUM(wc_hetong)/SUM(mb_hetong)\r\n\t\tELSE NULL\r\n\tEND AS rate_hetong,\r\n\r\n\tSUM(mb_shouru) AS mb_shouru,\r\n\tSUM(wc_shouru) AS wc_shouru,\r\n\tCASE\r\n\t\tWHEN SUM(mb_shouru)>0 THEN SUM(wc_shouru)/SUM(mb_shouru)\r\n\t\tELSE NULL\r\n\tEND AS rate_shouru,\r\n\r\n\tSUM(mb_xiansuo) AS mb_xiansuo,\r\n\tSUM(wc_xiansuo) AS wc_xiansuo,\r\n\tSUM(wc_xiansuo_zhou) AS wc_xiansuo_zhou,\r\n\tCASE\r\n\t\tWHEN SUM(mb_xiansuo) THEN SUM(wc_xiansuo)/SUM(mb_xiansuo)\r\n\t\tELSE NULL\r\n\tEND AS rate_xiansuo,\r\n\r\n\tSUM(mb_shangji) AS mb_shangji,\r\n\tSUM(wc_shangji) AS wc_shangji,\r\n\tSUM(wc_shangji_zhou) AS wc_shangji_zhou,\r\n\tCASE\r\n\t\tWHEN SUM(mb_shangji)>0 THEN SUM(wc_shangji)/SUM(mb_shangji)\r\n\t\tELSE NULL\r\n\tEND AS rate_shangji,\r\n\r\n\tSUM(mb_lixiang) AS mb_lixiang,\r\n\tSUM(wc_lixiang) AS wc_lixiang,\r\n\tSUM(wc_lixiang_zhou) AS wc_lixiang_zhou,\r\n\tCASE\r\n\t\tWHEN SUM(mb_lixiang)>0 THEN SUM(wc_lixiang)/SUM(mb_lixiang)\r\n\t\tELSE NULL\r\n\tEND AS rate_lixiang\r\nFROM (\r\n\tSELECT\r\n\t\ta.id,\r\n\t\tCASE\r\n\t\t\tWHEN '{weidu}'=1 THEN a.last_name\r\n\t\t\tWHEN '{weidu}'=2 THEN a.user_pianqu\r\n\t\t\tWHEN '{weidu}'=3 THEN a.user_daqu\r\n\t\t\tWHEN '{weidu}'=5 THEN a.user_quyu\r\n\t\t\tELSE '公司整体'\r\n\t\tEND AS mubiao_type,\r\n\t\tCASE\r\n\t\t\tWHEN '{weidu}'=1 THEN m.mb_hetong*0.0001\r\n\t\t\tELSE m.mb_hetong*0.0001-m.mb_hetong2*0.0001\r\n\t\tEND mb_hetong,\r\n\t\tCASE\r\n\t\t\tWHEN '{weidu}'=1 AND a.profileid=65 AND a.id NOT IN (28,31) THEN\r\n\t\t\t\t(\r\n\t\t\t\t\tSELECT\r\n\t\t\t\t\t\tSUM(x.total)*0.0001 AS wc_total\r\n\t\t\t\t\tFROM ld_servicecontracts x\r\n\t\t\t\t\tLEFT JOIN ld_users y ON y.id=x.smcreatorid\r\n\t\t\t\t\tWHERE x.deleted=0\r\n\t\t\t\t\t\tAND x.approvestatus='已批准'\r\n\t\t\t\t\t\tAND YEAR(x.createdtime) IN ('{nian}')\r\n\t\t\t\t\t\tAND y.groupid=a.groupid\r\n\t\t\t\t\t\tAND y.profileid IN (64,65)\r\n\t\t\t\t\t\tAND y.status='Active'\r\n\t\t\t\t\t\tAND (\r\n\t\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(MONTH(x.createdtime),'{date_value}')\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(QUARTER(x.createdtime),'{date_value}')\r\n\t\t\t\t\t\t\tEND)\r\n\t\t\t\t)\r\n\t\t\tELSE e.wc_total*0.0001\r\n\t\tEND AS wc_hetong,\r\n\r\n\t\tCASE\r\n\t\t\tWHEN '{weidu}'=1 THEN m.mb_shouru*0.0001\r\n\t\t\tELSE m.mb_shouru*0.0001-m.mb_shouru2*0.0001\r\n\t\tEND mb_shouru,\r\n\t\tCASE\r\n\t\t\tWHEN '{weidu}'=1 AND a.profileid=65 AND a.id NOT IN (28,31) THEN\r\n\t\t\t\t(\r\n\t\t\t\t\tSELECT\r\n\t\t\t\t\t\tSUM(x.total)*0.0001 AS wc_total\r\n\t\t\t\t\tFROM ld_cashbill x\r\n\t\t\t\t\tLEFT JOIN ld_users y ON y.id=x.smcreatorid\r\n\t\t\t\t\tWHERE x.deleted=0\r\n\t\t\t\t\t\tAND x.approvestatus<>'已拒绝'\r\n\t\t\t\t\t\tAND YEAR(x.cashbilldate) IN ('{nian}')\r\n\t\t\t\t\t\tAND y.groupid=a.groupid\r\n\t\t\t\t\t\tAND y.profileid IN (64,65)\r\n\t\t\t\t\t\tAND y.status='Active'\r\n\t\t\t\t\t\tAND (\r\n\t\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(MONTH(x.cashbilldate),'{date_value}')\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(QUARTER(x.cashbilldate),'{date_value}')\r\n\t\t\t\t\t\t\tEND)\r\n\t\t\t\t)\r\n\t\t\tELSE f.wc_total*0.0001\r\n\t\tEND AS wc_shouru,\r\n\r\n\t\tCASE\r\n\t\t\tWHEN '{weidu}'=1 THEN m.mb_xiansuo\r\n\t\t\tELSE m.mb_xiansuo-m.mb_xiansuo2\r\n\t\tEND mb_xiansuo,\r\n\t\tCASE\r\n\t\t\tWHEN '{weidu}'=1 AND a.profileid=65 AND a.id NOT IN (28,31) THEN\r\n\t\t\t\t(\r\n\t\t\t\t\tSELECT\r\n\t\t\t\t\t\tCOUNT(1) AS wc_total\r\n\t\t\t\t\tFROM ld_customform53 x\r\n\t\t\t\t\tLEFT JOIN ld_users y ON y.id=x.smcreatorid\r\n\t\t\t\t\tWHERE x.deleted=0\r\n\t\t\t\t\t\tAND x.approvestatus='已批准'\r\n\t\t\t\t\t\tAND YEAR(x.createdtime) IN ('{nian}')\r\n\t\t\t\t\t\tAND y.groupid=a.groupid\r\n\t\t\t\t\t\tAND y.profileid IN (64,65)\r\n\t\t\t\t\t\tAND y.status='Active'\r\n\t\t\t\t\t\tAND (\r\n\t\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(MONTH(x.createdtime),'{date_value}')\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(QUARTER(x.createdtime),'{date_value}')\r\n\t\t\t\t\t\t\tEND)\r\n\t\t\t\t)\r\n\t\t\tELSE g.wc_total\r\n\t\tEND AS wc_xiansuo,\r\n\t\tCASE\r\n\t\t\tWHEN '{weidu}'=1 AND a.profileid=65 AND a.id NOT IN (28,31) THEN\r\n\t\t\t\t(\r\n\t\t\t\t\tSELECT\r\n\t\t\t\t\t\tCOUNT(1) AS wc_total\r\n\t\t\t\t\tFROM ld_customform53 x\r\n\t\t\t\t\tLEFT JOIN ld_users y ON y.id=x.smcreatorid\r\n\t\t\t\t\tWHERE x.deleted=0\r\n\t\t\t\t\t\tAND x.approvestatus='已批准'\r\n\t\t\t\t\t\tAND y.groupid=a.groupid\r\n\t\t\t\t\t\tAND y.profileid IN (64,65)\r\n\t\t\t\t\t\tAND y.status='Active'\r\n\t\t\t\t\t\tAND x.createdtime BETWEEN DATE_SUB(CURDATE(),INTERVAL WEEKDAY(CURDATE()) DAY) AND DATE_SUB(CURDATE(),INTERVAL WEEKDAY(CURDATE())-6 DAY)\r\n\t\t\t\t)\r\n\t\t\tELSE h.wc_total\r\n\t\tEND AS wc_xiansuo_zhou,\r\n\r\n\t\tCASE\r\n\t\t\tWHEN '{weidu}'=1 THEN m.mb_shangji\r\n\t\t\tELSE m.mb_shangji-m.mb_shangji2\r\n\t\tEND mb_shangji,\r\n\t\tCASE\r\n\t\t\tWHEN '{weidu}'=1 AND a.profileid=65 AND a.id NOT IN (28,31) THEN\r\n\t\t\t\t(\r\n\t\t\t\t\tSELECT\r\n\t\t\t\t\t\tCOUNT(1) AS wc_total\r\n\t\t\t\t\tFROM ld_customform51 x\r\n\t\t\t\t\tLEFT JOIN ld_users y ON y.id=x.smcreatorid\r\n\t\t\t\t\tWHERE x.deleted=0\r\n\t\t\t\t\t\tAND x.approvestatus='已批准'\r\n\t\t\t\t\t\tAND YEAR(x.createdtime) IN ('{nian}')\r\n\t\t\t\t\t\tAND y.groupid=a.groupid\r\n\t\t\t\t\t\tAND y.profileid IN (64,65)\r\n\t\t\t\t\t\tAND y.status='Active'\r\n\t\t\t\t\t\tAND (\r\n\t\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(MONTH(x.createdtime),'{date_value}')\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(QUARTER(x.createdtime),'{date_value}')\r\n\t\t\t\t\t\t\tEND)\r\n\t\t\t\t)\r\n\t\t\tELSE i.wc_total\r\n\t\tEND AS wc_shangji,\r\n\t\tCASE\r\n\t\t\tWHEN '{weidu}'=1 AND a.profileid=65 AND a.id NOT IN (28,31) THEN\r\n\t\t\t\t(\r\n\t\t\t\t\tSELECT\r\n\t\t\t\t\t\tCOUNT(1) AS wc_total\r\n\t\t\t\t\tFROM ld_customform51 x\r\n\t\t\t\t\tLEFT JOIN ld_users y ON y.id=x.smcreatorid\r\n\t\t\t\t\tWHERE x.deleted=0\r\n\t\t\t\t\t\tAND x.approvestatus='已批准'\r\n\t\t\t\t\t\tAND y.groupid=a.groupid\r\n\t\t\t\t\t\tAND y.profileid IN (64,65)\r\n\t\t\t\t\t\tAND y.status='Active'\r\n\t\t\t\t\t\tAND x.createdtime BETWEEN DATE_SUB(CURDATE(),INTERVAL WEEKDAY(CURDATE()) DAY) AND DATE_SUB(CURDATE(),INTERVAL WEEKDAY(CURDATE())-6 DAY)\r\n\t\t\t\t)\r\n\t\t\tELSE j.wc_total\r\n\t\tEND AS wc_shangji_zhou,\r\n\r\n\t\tCASE\r\n\t\t\tWHEN '{weidu}'=1 THEN m.mb_lixiang*0.0001\r\n\t\t\tELSE m.mb_lixiang*0.0001-m.mb_lixiang2*0.0001\r\n\t\tEND mb_lixiang,\r\n\t\tCASE\r\n\t\t\tWHEN '{weidu}'=1 AND a.profileid=65 AND a.id NOT IN (28,31) THEN\r\n\t\t\t\t(\r\n\t\t\t\t\tSELECT\r\n\t\t\t\t\t\tSUM(z.cf_5835)*0.0001 AS wc_total\r\n\t\t\t\t\tFROM ld_customform52 x\r\n\t\t\t\t\tLEFT JOIN ld_customform52scf z ON z.customform52id=x.customform52id\r\n\t\t\t\t\tLEFT JOIN ld_users y ON y.id=x.smcreatorid\r\n\t\t\t\t\tWHERE x.deleted=0\r\n\t\t\t\t\t\tAND x.approvestatus='已批准'\r\n\t\t\t\t\t\tAND YEAR(x.createdtime) IN ('{nian}')\r\n\t\t\t\t\t\tAND y.groupid=a.groupid\r\n\t\t\t\t\t\tAND y.profileid IN (64,65)\r\n\t\t\t\t\t\tAND y.status='Active'\r\n\t\t\t\t\t\tAND (\r\n\t\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(MONTH(x.createdtime),'{date_value}')\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\t\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(QUARTER(x.createdtime),'{date_value}')\r\n\t\t\t\t\t\t\tEND)\r\n\t\t\t\t)\r\n\t\t\tELSE k.wc_total*0.0001\r\n\t\tEND AS wc_lixiang,\r\n\t\tCASE\r\n\t\t\tWHEN '{weidu}'=1  AND a.profileid=65 AND a.id NOT IN (28,31) THEN\r\n\t\t\t\t(\r\n\t\t\t\t\tSELECT\r\n\t\t\t\t\t\tSUM(z.cf_5835)*0.0001 AS wc_total\r\n\t\t\t\t\tFROM ld_customform52 x\r\n\t\t\t\t\tLEFT JOIN ld_customform52scf z ON z.customform52id=x.customform52id\r\n\t\t\t\t\tLEFT JOIN ld_users y ON y.id=x.smcreatorid\r\n\t\t\t\t\tWHERE x.deleted=0\r\n\t\t\t\t\t\tAND x.approvestatus='已批准'\r\n\t\t\t\t\t\tAND y.groupid=a.groupid\r\n\t\t\t\t\t\tAND y.profileid IN (64,65)\r\n\t\t\t\t\t\tAND y.status='Active'\r\n\t\t\t\t\t\tAND x.createdtime BETWEEN DATE_SUB(CURDATE(),INTERVAL WEEKDAY(CURDATE()) DAY) AND DATE_SUB(CURDATE(),INTERVAL WEEKDAY(CURDATE())-6 DAY)\r\n\t\t\t\t)\r\n\t\t\tELSE l.wc_total*0.0001\r\n\t\tEND AS wc_lixiang_zhou\r\n\tFROM ld_users a\r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\tlin_users_id,\r\n\t\t\tSUM(CASE WHEN mb_type='合同额' THEN mb_amount ELSE 0 END) AS mb_hetong,\r\n\t\t\tSUM(CASE WHEN mb_type='合同额' THEN mb_amount2 ELSE 0 END) AS mb_hetong2,\r\n\t\t\tSUM(CASE WHEN mb_type='线索' THEN mb_amount ELSE 0 END) AS mb_xiansuo,\r\n\t\t\tSUM(CASE WHEN mb_type='线索' THEN mb_amount2 ELSE 0 END) AS mb_xiansuo2,\r\n\t\t\tSUM(CASE WHEN mb_type='商机' THEN mb_amount ELSE 0 END) AS mb_shangji,\r\n\t\t\tSUM(CASE WHEN mb_type='商机' THEN mb_amount2 ELSE 0 END) AS mb_shangji2,\r\n\t\t\tSUM(CASE WHEN mb_type='立项' THEN mb_amount ELSE 0 END) AS mb_lixiang,\r\n\t\t\tSUM(CASE WHEN mb_type='立项' THEN mb_amount2 ELSE 0 END) AS mb_lixiang2,\r\n\t\t\tSUM(CASE WHEN mb_type='收入' THEN mb_amount ELSE 0 END) AS mb_shouru,\r\n\t\t\tSUM(CASE WHEN mb_type='收入' THEN mb_amount2 ELSE 0 END) AS mb_shouru2\r\n\t\tFROM (\r\n\t\t\tSELECT\r\n\t\t\t\tc.lin_users_id,\r\n\t\t\t\tb.cf_5276 AS mb_nian,\r\n\t\t\t\t1 AS mb_yue,\r\n\t\t\t\t1 AS mb_ji,\r\n\t\t\t\tb.cf_5277 AS mb_type,\r\n\t\t\t\td.sf284 AS mb_amount,\r\n\t\t\t\tCASE WHEN u.profileid=64 OR u.id IN (28,31) THEN d.sf284 ELSE 0 END AS mb_amount2\r\n\t\t\tFROM ld_customform22 a\r\n\t\t\tLEFT JOIN ld_customform22scf b ON b.customform22id=a.customform22id\r\n\t\t\tLEFT JOIN ld_customform22detail c ON c.id=a.customform22id\r\n\t\t\tLEFT JOIN ld_customform22detailscf d ON d.lineitem_id=c.lineitem_id\r\n\t\t\tLEFT JOIN ld_users u ON u.id=c.lin_users_id\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND c.lin_users_id>0\r\n\t\t\t\tAND b.cf_5276 IN ('{nian}')\r\n\t\t\t\tAND u.status='Active'\r\n\t\t\tUNION\r\n\t\t\tSELECT\r\n\t\t\t\tc.lin_users_id,\r\n\t\t\t\tb.cf_5276 AS mb_nian,\r\n\t\t\t\t2 AS mb_yue,\r\n\t\t\t\t1 AS mb_ji,\r\n\t\t\t\tb.cf_5277 AS mb_type,\r\n\t\t\t\td.sf285 AS mb_amount,\r\n\t\t\t\tCASE WHEN u.profileid=64 OR u.id IN (28,31) THEN d.sf285 ELSE 0 END AS mb_amount2\r\n\t\t\tFROM ld_customform22 a\r\n\t\t\tLEFT JOIN ld_customform22scf b ON b.customform22id=a.customform22id\r\n\t\t\tLEFT JOIN ld_customform22detail c ON c.id=a.customform22id\r\n\t\t\tLEFT JOIN ld_customform22detailscf d ON d.lineitem_id=c.lineitem_id\r\n\t\t\tLEFT JOIN ld_users u ON u.id=c.lin_users_id\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND c.lin_users_id>0\r\n\t\t\t\tAND b.cf_5276 IN ('{nian}')\r\n\t\t\t\tAND u.status='Active'\r\n\t\t\tUNION\r\n\t\t\tSELECT\r\n\t\t\t\tc.lin_users_id,\r\n\t\t\t\tb.cf_5276 AS mb_nian,\r\n\t\t\t\t3 AS mb_yue,\r\n\t\t\t\t1 AS mb_ji,\r\n\t\t\t\tb.cf_5277 AS mb_type,\r\n\t\t\t\td.sf286 AS mb_amount,\r\n\t\t\t\tCASE WHEN u.profileid=64 OR u.id IN (28,31) THEN d.sf286 ELSE 0 END AS mb_amount2\r\n\t\t\tFROM ld_customform22 a\r\n\t\t\tLEFT JOIN ld_customform22scf b ON b.customform22id=a.customform22id\r\n\t\t\tLEFT JOIN ld_customform22detail c ON c.id=a.customform22id\r\n\t\t\tLEFT JOIN ld_customform22detailscf d ON d.lineitem_id=c.lineitem_id\r\n\t\t\tLEFT JOIN ld_users u ON u.id=c.lin_users_id\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND c.lin_users_id>0\r\n\t\t\t\tAND b.cf_5276 IN ('{nian}')\r\n\t\t\t\tAND u.status='Active'\r\n\t\t\tUNION\r\n\t\t\tSELECT\r\n\t\t\t\tc.lin_users_id,\r\n\t\t\t\tb.cf_5276 AS mb_nian,\r\n\t\t\t\t4 AS mb_yue,\r\n\t\t\t\t2 AS mb_ji,\r\n\t\t\t\tb.cf_5277 AS mb_type,\r\n\t\t\t\td.sf287 AS mb_amount,\r\n\t\t\t\tCASE WHEN u.profileid=64 OR u.id IN (28,31