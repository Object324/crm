ustomform22id\r\n\t\t\tLEFT JOIN ld_customform22detail c ON c.id=a.customform22id\r\n\t\t\tLEFT JOIN ld_customform22detailscf d ON d.lineitem_id=c.lineitem_id\r\n\t\t\tLEFT JOIN ld_users u ON u.id=c.lin_users_id\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND c.lin_users_id>0\r\n\t\t\t\tAND b.cf_5276 IN ('{nian}')\r\n\t\t\t\tAND u.status='Active'\r\n\t\t\tUNION\r\n\t\t\tSELECT\r\n\t\t\t\tc.lin_users_id,\r\n\t\t\t\tb.cf_5276 AS mb_nian,\r\n\t\t\t\t10 AS mb_yue,\r\n\t\t\t\t4 AS mb_ji,\r\n\t\t\t\tb.cf_5277 AS mb_type,\r\n\t\t\t\td.sf293 AS mb_amount,\r\n\t\t\t\tCASE WHEN u.profileid=64 OR u.id IN (28,31) THEN d.sf293 ELSE 0 END AS mb_amount2\r\n\t\t\tFROM ld_customform22 a\r\n\t\t\tLEFT JOIN ld_customform22scf b ON b.customform22id=a.customform22id\r\n\t\t\tLEFT JOIN ld_customform22detail c ON c.id=a.customform22id\r\n\t\t\tLEFT JOIN ld_customform22detailscf d ON d.lineitem_id=c.lineitem_id\r\n\t\t\tLEFT JOIN ld_users u ON u.id=c.lin_users_id\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND c.lin_users_id>0\r\n\t\t\t\tAND b.cf_5276 IN ('{nian}')\r\n\t\t\t\tAND u.status='Active'\r\n\t\t\tUNION\r\n\t\t\tSELECT\r\n\t\t\t\tc.lin_users_id,\r\n\t\t\t\tb.cf_5276 AS mb_nian,\r\n\t\t\t\t11 AS mb_yue,\r\n\t\t\t\t4 AS mb_ji,\r\n\t\t\t\tb.cf_5277 AS mb_type,\r\n\t\t\t\td.sf294 AS mb_amount,\r\n\t\t\t\tCASE WHEN u.profileid=64 OR u.id IN (28,31) THEN d.sf294 ELSE 0 END AS mb_amount2\r\n\t\t\tFROM ld_customform22 a\r\n\t\t\tLEFT JOIN ld_customform22scf b ON b.customform22id=a.customform22id\r\n\t\t\tLEFT JOIN ld_customform22detail c ON c.id=a.customform22id\r\n\t\t\tLEFT JOIN ld_customform22detailscf d ON d.lineitem_id=c.lineitem_id\r\n\t\t\tLEFT JOIN ld_users u ON u.id=c.lin_users_id\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND c.lin_users_id>0\r\n\t\t\t\tAND b.cf_5276 IN ('{nian}')\r\n\t\t\t\tAND u.status='Active'\r\n\t\t\tUNION\r\n\t\t\tSELECT\r\n\t\t\t\tc.lin_users_id,\r\n\t\t\t\tb.cf_5276 AS mb_nian,\r\n\t\t\t\t12 AS mb_yue,\r\n\t\t\t\t4 AS mb_ji,\r\n\t\t\t\tb.cf_5277 AS mb_type,\r\n\t\t\t\td.sf295 AS mb_amount,\r\n\t\t\t\tCASE WHEN u.profileid=64 OR u.id IN (28,31) THEN d.sf295 ELSE 0 END AS mb_amount2\r\n\t\t\tFROM ld_customform22 a\r\n\t\t\tLEFT JOIN ld_customform22scf b ON b.customform22id=a.customform22id\r\n\t\t\tLEFT JOIN ld_customform22detail c ON c.id=a.customform22id\r\n\t\t\tLEFT JOIN ld_customform22detailscf d ON d.lineitem_id=c.lineitem_id\r\n\t\t\tLEFT JOIN ld_users u ON u.id=c.lin_users_id\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND c.lin_users_id>0\r\n\t\t\t\tAND b.cf_5276 IN ('{nian}')\r\n\t\t\t\tAND u.status='Active'\r\n\t\t) a\r\n\t\tWHERE 1=1\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(a.mb_yue,'{date_value}')\r\n\t\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(a.mb_ji,'{date_value}')\r\n\t\t\t\tEND)\r\n\t\t\tAND mb_type IN ('合同额','线索','商机','立项','收入')\r\n\t\tGROUP BY a.lin_users_id\r\n\t) m ON m.lin_users_id=a.id\r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\ta.smcreatorid,\r\n\t\t\tSUM(a.total) AS wc_total\r\n\t\tFROM ld_servicecontracts a\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus='已批准'\r\n\t\t\tAND YEAR(a.createdtime) IN ('{nian}')\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(MONTH(a.createdtime),'{date_value}')\r\n\t\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(QUARTER(a.createdtime),'{date_value}')\r\n\t\t\t\tEND)\r\n\t\tGROUP BY a.smcreatorid\r\n\t) e ON e.smcreatorid=a.id\r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\ta.smcreatorid,\r\n\t\t\tSUM(a.total) AS wc_total\r\n\t\tFROM ld_cashbill a\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\tAND YEAR(a.cashbilldate) IN ('{nian}')\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(MONTH(a.cashbilldate),'{date_value}')\r\n\t\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(QUARTER(a.cashbilldate),'{date_value}')\r\n\t\t\t\tEND)\r\n\t\tGROUP BY a.smcreatorid\r\n\t) f ON f.smcreatorid=a.id\r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\ta.smcreatorid,\r\n\t\t\tCOUNT(1) AS wc_total\r\n\t\tFROM ld_customform53 a\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus='已批准'\r\n\t\t\tAND YEAR(a.createdtime) IN ('{nian}')\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(MONTH(a.createdtime),'{date_value}')\r\n\t\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(QUARTER(a.createdtime),'{date_value}')\r\n\t\t\t\tEND)\r\n\t\tGROUP BY a.smcreatorid\r\n\t) g ON g.smcreatorid=a.id\r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\ta.smcreatorid,\r\n\t\t\tCOUNT(1) AS wc_total\r\n\t\tFROM ld_customform53 a\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus='已批准'\r\n\t\t\tAND a.createdtime BETWEEN DATE_SUB(CURDATE(),INTERVAL WEEKDAY(CURDATE()) DAY) AND DATE_SUB(CURDATE(),INTERVAL WEEKDAY(CURDATE())-6 DAY)\r\n\t\tGROUP BY a.smcreatorid\r\n\t) h ON h.smcreatorid=a.id\r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\ta.smcreatorid,\r\n\t\t\tCOUNT(1) AS wc_total\r\n\t\tFROM ld_customform51 a\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus='已批准'\r\n\t\t\tAND YEAR(a.createdtime) IN ('{nian}')\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(MONTH(a.createdtime),'{date_value}')\r\n\t\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(QUARTER(a.createdtime),'{date_value}')\r\n\t\t\t\tEND)\r\n\t\tGROUP BY a.smcreatorid\r\n\t) i ON i.smcreatorid=a.id\r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\ta.smcreatorid,\r\n\t\t\tCOUNT(1) AS wc_total\r\n\t\tFROM ld_customform51 a\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus='已批准'\r\n\t\t\tAND a.createdtime BETWEEN DATE_SUB(CURDATE(),INTERVAL WEEKDAY(CURDATE()) DAY) AND DATE_SUB(CURDATE(),INTERVAL WEEKDAY(CURDATE())-6 DAY)\r\n\t\tGROUP BY a.smcreatorid\r\n\t) j ON j.smcreatorid=a.id\r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\ta.smcreatorid,\r\n\t\t\tSUM(b.cf_5835) AS wc_total\r\n\t\tFROM ld_customform52 a\r\n\t\tLEFT JOIN ld_customform52scf b ON b.customform52id=a.customform52id\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus='已批准'\r\n\t\t\tAND YEAR(a.createdtime) IN ('{nian}')\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\t\tWHEN '{date_type}'='月度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(MONTH(a.createdtime),'{date_value}')\r\n\t\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')='' THEN 1=1\r\n\t\t\t\t\tWHEN '{date_type}'='季度' AND TRIM('{date_value}')<>'' THEN FIND_IN_SET(QUARTER(a.createdtime),'{date_value}')\r\n\t\t\t\tEND)\r\n\t\tGROUP BY a.smcreatorid\r\n\t) k ON k.smcreatorid=a.id\r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\ta.smcreatorid,\r\n\t\t\tSUM(b.cf_5835) AS wc_total\r\n\t\tFROM ld_customform52 a\r\n\t\tLEFT JOIN ld_customform52scf b ON b.customform52id=a.customform52id\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus='已批准'\r\n\t\t\tAND a.createdtime BETWEEN DATE_SUB(CURDATE(),INTERVAL WEEKDAY(CURDATE()) DAY) AND DATE_SUB(CURDATE(),INTERVAL WEEKDAY(CURDATE())-6 DAY)\r\n\t\tGROUP BY a.smcreatorid\r\n\t) l ON l.smcreatorid=a.id\r\n\tINNER JOIN (\r\n\t\tSELECT DISTINCT\r\n\t\t\tm.userid\r\n\t\tFROM ld_users2group m\r\n\t\tINNER JOIN ld_groups n ON  n.groupid=m.groupid\r\n\t\tWHERE n.groupid=2 OR n.parentgroup LIKE '1::2::%'\r\n\t) u ON u.userid=a.id\r\n\tINNER JOIN (\r\n\t\tSELECT DISTINCT\r\n\t\t\tuserid \r\n\t\tFROM (\r\n\t\t\tSELECT \r\n\t\t\t\tld_users.id AS userid \r\n\t\t\tFROM ld_users\r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='CustomForm22' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\tUNION\r\n\t\t\tSELECT \r\n\t\t\t\tviewid AS userid \r\n\t\t\tFROM ld_scoperhigher\r\n\t\t\tWHERE userid='[uuid]' AND modulename ='CustomForm22' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename ='CustomForm22')\t\t\t\r\n\t\t\tUNION\r\n\t\t\tSELECT DISTINCT \r\n\t\t\t\tld_users2group.userid AS userid \r\n\t\t\tFROM ld_scoperhigher \r\n\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\tAND ld_scoperhigher.modulename ='CustomForm22'\r\n\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='CustomForm22' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\tUNION \r\n\t\t\tSELECT \r\n\t\t\t\tid AS userid \r\n\t\t\tFROM ld_users  \r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\tUNION\r\n\t\t\tSELECT '[uuid]') AS vw_users\r\n\t) AS tmp_users ON tmp_users.userid=a.id\r\n\tWHERE a.deleted=0\r\n\t\tAND a.profileid IN (64,65)\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{weidu}'=1 AND TRIM('{ziweidu}')='' THEN  a.profileid<>65\r\n\t\t\t\tWHEN '{weidu}'=1 AND TRIM('{ziweidu}')<>'' THEN FIND_IN_SET(a.id,'{ziweidu}') and a.profileid<>65\r\n\t\t\t\t\r\n\t\t\t\tWHEN '{weidu}'=2 AND TRIM('{ziweidu}')='' THEN a.user_pianqu IN (select list_key2 from list_weidu where list_key=2)\r\n\t\t\t\tWHEN '{weidu}'=2 THEN FIND_IN_SET(a.user_pianqu,'{ziweidu}')\r\n\r\n\t\t\t\tWHEN '{weidu}'=3 AND TRIM('{ziweidu}')='' THEN a.user_daqu IN (select list_key2 from list_weidu where list_key=3)\r\n\t\t\t\tWHEN '{weidu}'=3 THEN FIND_IN_SET(a.user_daqu,'{ziweidu}')\r\n\t\t\t\t\r\n\t\t\t\tWHEN '{weidu}'=5 AND TRIM('{ziweidu}')='' THEN a.user_quyu IN (select list_key2 from list_weidu where list_key=5)\r\n\t\t\t\tWHEN '{weidu}'=5 THEN FIND_IN_SET(a.user_quyu,'{ziweidu}')\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\tELSE 1=1\r\n\t\t\tEND) \r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{chanpinxian}'='' OR '{chanpinxian}'=(SELECT GROUP_CONCAT(listvalue ORDER BY sequence) FROM ld_picklist_values WHERE listid=130) THEN 1=1\r\n\t\t\t\t\tELSE FIND_IN_SET(a.user_chanpinxian, '{chanpinxian}')\r\n\t\t\t\tEND)\r\n) a\r\nWHERE IFNULL(mubiao_type,'')<>''\r\nGROUP BY mubiao_type\r\n) a\r\nWHERE 1=1\r\nORDER BY rate_total DESC"},"1":{"Ident":"StiMySqlSource","Name":"list_weidu","Alias":"list_weidu","Columns":{"0":{"Name":"list_key","NameInSource":"list_key","Alias":"list_key","Type":"System.Int32"},"1":{"Name":"list_key2","NameInSource":"list_key2","Alias":"list_key2","Type":"System.String"},"2":{"Name":"list_value","NameInSource":"list_value","Alias":"list_value","Type":"System.String"},"3":{"Name":"list_value2","NameInSource":"list_value2","Alias":"list_value2","Type":"System.String"}},"NameInSource":"ldcrm","SqlCommand":"/*SELECT\r\n\tlist_key,\r\n\tlist_key2,\r\n\tlist_value,\r\n\tlist_value2\r\nFROM (\r\n\tSELECT\r\n\t\t1 AS list_key,\r\n\t\t'客户经理/市场专员' AS list_value,\r\n\t\ta.id AS list_key2,\r\n\t\ta.last_name AS list_value2\r\n\tFROM ld_users a\r\n\tINNER JOIN ld_users2group e ON e.userid=a.id\r\n\tINNER JOIN ld_groups f ON f.groupid=e.groupid\r\n\tWHERE a.deleted=0\r\n\t\tAND (f.groupid=2 OR f.parentgroup LIKE '1::2::%')\r\n\t\tAND a.profileid IN (64,65)\r\n\t\tAND a.status='Active'\r\n\tUNION\r\n\tSELECT\r\n\t\t2 AS list_key,\r\n\t\t'片区' AS list_value,\r\n\t\ta.user_pianqu AS list_key2,\r\n\t\ta.user_pianqu AS list_value2\r\n\tFROM ld_users a\r\n\tINNER JOIN ld_users2group e ON e.userid=a.id\r\n\tINNER JOIN ld_groups f ON f.groupid=e.groupid\r\n\tWHERE a.deleted=0\r\n\t\tAND (f.groupid=2 OR f.parentgroup LIKE '1::2::%')\r\n\t\tAND a.profileid IN (64,65)\r\n\t\tAND a.user_pianqu IN ('山东区','华北区','华中区','西北区','青岛金东')\r\n\t\tAND a.status='Active'\r\n\tGROUP BY a.user_pianqu\r\n\tUNION\r\n\tSELECT\r\n\t\t3 AS list_key,\r\n\t\t'大区' AS list_value,\r\n\t\ta.user_daqu AS list_key2,\r\n\t\ta.user_daqu AS list_value2\r\n\tFROM ld_users a\r\n\tINNER JOIN ld_users2group e ON e.userid=a.id\r\n\tINNER JOIN ld_groups f ON f.groupid=e.groupid\r\n\tWHERE a.deleted=0\r\n\t\tAND (f.groupid=2 OR f.parentgroup LIKE '1::2::%')\r\n\t\tAND a.profileid IN (64,65)\r\n\t\tAND a.user_daqu IN ('东部大区','青岛金东','中部大区','北部大区')\r\n\t\tAND a.status='Active'\r\n\tGROUP BY a.user_daqu\r\n\tUNION\r\n\tSELECT \r\n\t\t4 AS list_key,\r\n\t\t'公司整体' AS list_value,\r\n\t\t'公司整体' AS list_key2,\r\n\t\t'公司整体' AS list_value2\r\n) a\r\nORDER BY a.list_key,\r\n\t(CASE \r\n\t\tWHEN list_key=1 THEN CONVERT(a.list_value2 USING GBK) \r\n\t\tWHEN list_key=2 THEN FIELD(a.list_value2,'山东区','华北区','华中区','西北区','青岛金东')\r\n\t\tWHEN list_key=3 THEN FIELD(a.list_value2,'东部大区','青岛金东','中部大区','北部大区')\r\n\tEND)*/\r\nselect * from list_weidu_new\r\nwhere list_key<>4\r\norder by FIELD(list_key,1,3,2,5)"},"2":{"Ident":"StiMySqlSource","Name":"list_chanpinxian","Alias":"list_chanpinxian","Columns":{"0":{"Name":"listvalue","NameInSource":"listvalue","Alias":"listvalue","Type":"System.String"}},"NameInSource":"ldcrm","SqlCommand":"SELECT listvalue FROM ld_picklist_values WHERE listid=130 ORDER BY sequence"},"3":{"Ident":"StiMySqlSource","Name":"list_date","Alias":"list_date","Columns":{"0":{"Name":"list_key","NameInSource":"list_key","Alias":"list_key","Type":"System.String"},"1":{"Name":"list_value","NameInSource":"list_value","Alias":"list_value","Type":"System.Int32"}},"NameInSource":"ldcrm","SqlCommand":"SELECT '月度' AS list_key,seq AS list_value FROM sequence WHERE seq BETWEEN 1 AND 12\r\nUNION ALL\r\nSELECT '季度' AS list_key,seq AS list_value FROM sequence WHERE seq BETWEEN 1 AND 4"},"4":{"Ident":"StiMySqlSource","Name":"list_nian","Alias":"list_nian","Columns":{"0":{"Name":"list_value","NameInSource":"list_value","Alias":"list_value","Type":"System.Int32"}},"NameInSource":"ldcrm","SqlCommand":"SELECT YEAR(NOW()) AS list_value\r\nUNION\r\nSELECT YEAR(NOW())-1 AS list_value\r\nUNION\r\nSELECT YEAR(NOW())-2 AS list_value\r\nUNION\r\nSELECT YEAR(NOW())-3 AS list_value\r\nUNION\r\nSELECT YEAR(NOW())-3 AS list_value\r\n"}},"Databases":{"0":{"Ident":"StiMySqlDatabase","Name":"ldcrm","Alias":"ldcrm","ConnectionStringEncrypted":"42x9CUgIMZnhRymYykl3btXIf8LGCaOIYluhpWoRJZfCbPMC51YZmMwZpFhqEKQ72dT9r08KSc1DEIyAY2A1ZsNW0eliBam8aRPQ2GJctUaNGHU="}}},"Pages":{"0":{"Ident":"StiPage","Name":"Page1","Guid":"5d4b27b46a74e040391803bfd0a0787f","Alias":"综合排序","Interaction":{"Ident":"StiInteraction"},"Border":";;2;;;;;solid:Black","Brush":"solid:255,255,255","Components":{"0":{"Ident":"StiReportTitleBand","Name":"ReportTitleBand1","ClientRectangle":"0,0.4,37,1.2","Interaction":{"Ident":"StiInteraction"},"Border":";;;;;;;solid:Black","Brush":"solid:","Components":{"0":{"Ident":"StiText","Name":"Text1","Guid":"064ab2ce1191db9ac51797bd4ee15a05","CanGrow":true,"GrowToHeight":true,"ClientRectangle":"0,0,4.6,1.2","Interaction":{"Ident":"StiInteraction"},"Text":{"Value":"{b.mubiao_desp}"},"VertAlignment":"Center","Font":"Microsoft YaHei;9;Bold;","Border":"All;221,221,221;;;;;;solid:0,0,0","Brush":"solid:240,244,252","TextBrush":"solid:Black","TextOptions":{"WordWrap":true},"Margins":{"Left":3,"Right":0,"Top":0,"Bottom":0},"Type":"DataColumn"},"1":{"Ident":"StiText","Name":"Text7","Guid":"7d53c21436335f43c8779ce9a4ff62d4","CanGr