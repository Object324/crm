        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT \r\n\tCASE\r\n\t\tWHEN LOCATE('-',a.masterorder_no)>0 THEN LEFT(a.masterorder_no,LOCATE('-',a.masterorder_no)-1)\r\n\t\tELSE a.masterorder_no\r\n\tEND AS L01,\r\n\tCASE\r\n\t\tWHEN LOCATE('-',a.masterorder_no)>0 THEN RIGHT(a.masterorder_no,LENGTH(a.masterorder_no)-LOCATE('-',a.masterorder_no))\r\n\t\tELSE a.masterorder_no\r\n\tEND AS L02,\r\n\tCONCAT('HAWB NO:',IFNULL(d.sf169,'')) AS L03,\r\n\tIFNULL(d.sf176,'') AS L041,\r\n\tIFNULL(d.sf177,'') AS L042,\r\n\tIFNULL(d.sf178,'') AS L051,\r\n\tIFNULL(d.sf179,'') AS L052,\r\n\ta.real_flightno AS L06,\r\n\tDATE_FORMAT(a.real_flightdate,'%Y-%c-%e') AS L07,\r\n\td.sf173 AS L08,\r\n\td.sf174 AS L09,\r\n\td.sf170 AS L10,\r\n\td.sf175 AS L11,\r\n\tLEFT(a.real_flightno,2) AS L12,\r\n\tCONCAT(d.sf171,d.sf172) AS L13,\r\n\ta.start_port AS L14,\r\n\ta.end_port AS L15\r\nFROM ld_customform25 a\r\nLEFT JOIN ld_customform25scf b ON b.customform25id=a.customform25id\r\nLEFT JOIN ld_customform25detail c ON c.id=a.customform25id\r\nLEFT JOIN ld_customform25detailscf d ON d.lineitem_id=c.lineitem_id\r\nWHERE a.customform25id='[related_ldcrmid]' "
      }
    },
