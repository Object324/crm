<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<StiSerializer version="1.02" type="Flex" application="StiReport">
  <Dictionary isKey="true" type="Dictionary" Ref="1">
    <Databases isList="true" count="1">
      <ldcrm isKey="true" type="Stimulsoft.Report.Dictionary.StiMySqlDatabase" Ref="2">
        <Alias>ldcrm</Alias>
        <ConnectionStringEncrypted>9HybAtcNAbxsW7X07x1q58Lcf2BCWQGkRXn9zGRc427BxHXLRkwxxWIbua3lGaBnw2LNw0No2d1v
GKiIYxC3Y8J4+wJhCrv9cmSlvOR0Ig+BXInCYVlB3eJarInoJSFqg1rR6FBXS51xR4SRyGBiY9E=</ConnectionStringEncrypted>
        <Name>ldcrm</Name>
      </ldcrm>
    </Databases>
    <DataSources isList="true" count="2">
      <report isKey="true" type="Stimulsoft.Report.Dictionary.StiMySqlSource" Ref="3">
        <Alias>report</Alias>
        <Columns isList="true" count="24">
          <value>accountid,System.Int32</value>
          <value>out_id,System.Int32</value>
          <value>out_no,System.String</value>
          <value>accountname,System.String</value>
          <value>outdate,System.String</value>
          <value>salesorderid,System.Int32</value>
          <value>salesorder_no,System.String</value>
          <value>stockpresence,System.String</value>
          <value>pname,System.String</value>
          <value>productname,System.String</value>
          <value>usageunit,System.String</value>
          <value>entitytypeid,System.Int32</value>
          <value>quantity,System.Decimal</value>
          <value>balanceinvoicecount,System.Decimal</value>
          <value>dsp_quantity,System.String</value>
          <value>dsp_balanceinvoicecount,System.String</value>
          <value>discount_percent,System.Decimal</value>
          <value>listprice,System.Decimal</value>
          <value>tax2,System.Decimal</value>
          <value>taxprice,System.Decimal</value>
          <value>list_amount,System.Decimal</value>
          <value>tax_total,System.Decimal</value>
          <value>tax_amount,System.Decimal</value>
          <value>remark,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1"/>
        <Name>report</Name>
        <NameInSource>ldcrm</NameInSource>
        <Parameters isList="true" count="0"/>
        <SqlCommand>SELECT
	a.accountid,
	a.out_id,
	a.out_no,
	d.accountname,
	DATE_FORMAT(a.createdtime,'%Y-%m-%d') AS outdate,
	f.salesorderid,
	f.salesorder_no,
	f.stockpresence,
	cf.cf_2089 AS pname,
	c.productname,
	c.usageunit AS usageunit,
	b.entitytypeid,
	b.quantity,
	b.balanceinvoicecount,
	FORMAT(b.quantity,0) AS dsp_quantity,
	FORMAT(b.balanceinvoicecount,0) AS dsp_balanceinvoicecount,
	b.discount_percent,
	b.listprice,
	b.tax2,
	b.taxprice,
	b.list_amount,
	b.list_amount*0.01*b.tax2 AS tax_total,
	b.tax_amount,
	b.`comment` AS remark
FROM ld_outboundorder a
LEFT JOIN ld_inventoryproductrel b ON a.out_id=b.id
LEFT JOIN ld_products c ON c.productid=b.productid
LEFT JOIN ld_productcf cf ON cf.productid=c.productid
LEFT JOIN ld_account d ON d.accountid=a.accountid
LEFT JOIN ld_accountscf e ON d.accountid=e.accountid
LEFT JOIN ld_salesorder f ON (f.salesorderid=b.entitytypeid AND b.entitytype='SalesOrder')
LEFT JOIN ld_salesordercf g ON g.salesorderid=f.salesorderid
WHERE a.deleted=0
	AND a.approvestatus&lt;&gt;'已拒绝'
	AND e.cf_2209='出库清单'
	AND IFNULL(f.stockpresence,'全部出库') IN ('全部出库','部分出库','')
	AND a.outdate BETWEEN STR_TO_DATE('{start_date}','%m/%d/%Y') AND STR_TO_DATE('{end_date}','%m/%d/%Y')
	AND (
		CASE
			WHEN '{needinvoice}'='全部' THEN 1=1
			ELSE IFNULL(g.cf_2317,'是')='{needinvoice}'
		END)
	AND (
		CASE
			WHEN TRIM('{ckstatus}')='' THEN 1=1
			ELSE FIND_IN_SET(IFNULL(f.stockpresence,'全部出库'),'{ckstatus}')
		END)
	AND (
		CASE
			WHEN TRIM('{company}')='' THEN 1=1
			ELSE LOCATE(TRIM('{company}'),d.accountname)
		END)
	AND (
		CASE
			WHEN '{invoice_range}'='true' THEN b.balanceinvoicecount&gt;0
			ELSE 1=1
		END)
ORDER BY CONVERT(d.accountname USING GBK),outdate,f.salesorder_no,a.out_id,b.sequence_no</SqlCommand>
      </report>
      <invoice isKey="true" type="Stimulsoft.Report.Dictionary.StiMySqlSource" Ref="4">
        <Alias>invoice</Alias>
        <Columns isList="true" count="2">
          <value>accountid,System.Int32</value>
          <value>entitytypeid,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1"/>
        <Name>invoice</Name>
        <NameInSource>ldcrm</NameInSource>
        <Parameters isList="true" count="0"/>
        <SqlCommand>SELECT
	a.accountid,
	GROUP_CONCAT(DISTINCT out_id) AS entitytypeid
FROM ld_outboundorder a
LEFT JOIN ld_inventoryproductrel b ON a.out_id=b.id
LEFT JOIN ld_products c ON c.productid=b.productid
LEFT JOIN ld_productcf cf ON cf.productid=c.productid
LEFT JOIN ld_account d ON d.accountid=a.accountid
LEFT JOIN ld_accountscf e ON d.accountid=e.accountid
LEFT JOIN ld_salesorder f ON (f.salesorderid=b.entitytypeid AND b.entitytype='SalesOrder')
LEFT JOIN ld_salesordercf g ON g.salesorderid=f.salesorderid
WHERE a.deleted=0
	AND a.approvestatus&lt;&gt;'已拒绝'
	AND e.cf_2209='出库清单'
	AND IFNULL(f.stockpresence,'全部出库') IN ('全部出库','部分出库','')
	AND a.outdate BETWEEN STR_TO_DATE('{start_date}','%m/%d/%Y') AND STR_TO_DATE('{end_date}','%m/%d/%Y')
	AND (
		CASE
			WHEN '{needinvoice}'='全部' THEN 1=1
			ELSE IFNULL(g.cf_2317,'是')='{needinvoice}'
		END)
	AND (
		CASE
			WHEN TRIM('{ckstatus}')='' THEN 1=1
			ELSE FIND_IN_SET(IFNULL(f.stockpresence,'全部出库'),'{ckstatus}')
		END)
	AND (
		CASE
			WHEN TRIM('{company}')='' THEN 1=1
			ELSE LOCATE(TRIM('{company}'),d.accountname)
		END)
	AND (
		CASE
			WHEN '{invoice_range}'='true' THEN b.balanceinvoicecount&gt;0
			ELSE 1=1
		END)
ORDER BY CONVERT(d.accountname USING GBK),outdate,f.salesorder_no,a.out_id,b.sequence_no</SqlCommand>
      </invoice>
    </DataSources>
