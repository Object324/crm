          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT '全部' AS listvalue\r\nUNION (\r\n\tSELECT\r\n\t\tlistvalue\r\n\tFROM ld_picklist_set a\r\n\tLEFT JOIN ld_picklist_values b ON a.listid=b.listid\r\n\tWHERE a.listname='cf_2320'\r\n\t\tAND a.relatetable='ld_field'\r\n\tORDER BY sequence)"
      },
