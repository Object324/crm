        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\ta.expenseid AS orderid,\r\n\ta.expense_no AS orderno,\r\n\tu3.last_name AS approver,\r\n\ta.approvetime,\r\n\tc.potentialname AS ccfno,\r\n\td.accountname,\r\n\tcf.big_area AS quyu,\r\n\ta.expensedate,\r\n\tu1.last_name AS smowner,\r\n\ta.smownerid,\r\n\tu2.last_name AS smbiller,\r\n\ta.createdtime,\r\n\te.expensetype,\r\n\tf.rmb_total,\r\n\te.description,\r\n\tb.cf_2344 AS gongzuo,\r\n\ta.cf_2343 AS groupname\r\nFROM ld_expense a\r\nLEFT JOIN ld_expensescf b ON b.expenseid=a.expenseid\r\nLEFT JOIN ld_potential c ON c.potentialid=a.potentialid\r\nLEFT JOIN ld_potentialscf cf ON cf.potentialid=c.potentialid\r\nLEFT JOIN ld_account d ON d.accountid=a.accountid\r\nLEFT JOIN ld_expensedetail e ON e.expenseid=a.expenseid\r\nLEFT JOIN ld_expensedetailscf f ON f.expensedetailid=e.expensedetailid\r\nLEFT JOIN ld_users u1 ON u1.id=a.smownerid\r\nLEFT JOIN ld_users u2 ON u2.id=a.smcreatorid\r\nLEFT JOIN ld_users u3 ON u3.id=a.approveby\r\nINNER JOIN (\r\n\tSELECT DISTINCT\r\n\t\tuserid \r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\tld_users.id AS userid \r\n\t\tFROM ld_users\r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='Expense' and scopeauthority=1 AND userid='[uuid]')\r\n\t\tUNION\r\n\t\tSELECT \r\n\t\t\tviewid AS userid \r\n\t\tFROM ld_scoperhigher\r\n\t\tWHERE userid='[uuid]' AND modulename='Expense' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename='Expense')\t\t\t\r\n\t\tUNION\r\n\t\tSELECT DISTINCT \r\n\t\t\tld_users2group.userid AS userid \r\n\t\tFROM ld_scoperhigher \r\n\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\tAND ld_scoperhigher.modulename='Expense'\r\n\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='Expense' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\tUNION \r\n\t\tSELECT \r\n\t\t\tid AS userid \r\n\t\tFROM ld_users  \r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\tUNION\r\n\t\tSELECT '[uuid]') AS vw_users\r\n) AS list_user ON list_user.userid=a.smownerid\r\nWHERE a.deleted=0\r\n\tAND a.approvestatus<>'已拒绝'\r\n\tAND IFNULL(b.cf_2382,'')<>'作废单据'\r\n\tAND a.expensedate BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{ccfnum}'='' THEN 1=1\r\n\t\t\tELSE LOCATE(TRIM('{ccfnum}'),c.potentialname)>0\r\n\t\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{custname}'='' THEN 1=1\r\n\t\t\tELSE LOCATE(TRIM('{custname}'),d.accountname)>0\r\n\t\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{userid}'='' THEN 1=1\r\n\t\t\tELSE FIND_IN_SET(a.smownerid,'{userid}')\r\n\t\tEND)\r\nORDER BY a.expensedate,a.createdtime"
      }
    },
