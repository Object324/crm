            "Type": "System.Decimal"
          }
        },
        "NameInSource": "ldcrm ",
        "Type": "Table",
        "SqlCommand": "select \r\naccount.accountid,\r\naccount.accountname,\r\nascf.cf_4402 as sales_area,\r\nascf.cf_4404 as sales_fenzhi,\r\nu.last_name,\r\nascf.important_level,\r\nifnull(form24.sf336,0)/10000 as year_target,\r\nsales.yeartotal_youxiao,\r\nsales.yeartotal,\r\nsales.month1,\r\nsales.month2,\r\nsales.month3,\r\nsales.month4,\r\nsales.month5,\r\nsales.month6,\r\nsales.month7,\r\nsales.month8,\r\nsales.month9,\r\nsales.month10,\r\nsales.month11,\r\nsales.month12,\r\nifnull(p.over60_total,0)/10000 as  over60_total ,\r\nifnull(p.below60_total,0)/10000 as below60_total,\r\nifnull(p.over60_nums,0) as  over60_nums ,\r\nifnull(p.below60_nums,0) as below60_nums,\r\nifnull(p2.yuji_total,0) as yuji_total,\r\nifnull(p2.yuji_nums,0) as yuji_nums,\r\ns2.days\r\n\r\nfrom ld_account account \r\nleft join ld_accountscf ascf on ascf.accountid=account.accountid \r\nleft join ld_users u on u.id=account.smownerid\r\ninner join (\r\n\tselect \r\n\tform24.accountid,\r\n\tform24detailscf.sf336\r\n\tfrom ld_customform24 form24\r\n\tleft join ld_customform24scf form24scf on form24.customform24id=form24scf.customform24id\r\n\tleft join ld_customform24detail form24detail on form24.customform24id=form24detail.id\r\n\tleft join ld_customform24detailscf form24detailscf on form24detail.lineitem_id=form24detailscf.lineitem_id\r\n\twhere form24scf.cf_4750='{nian}年'\r\n\tgroup by form24.accountid\r\n)form24 on form24.accountid=account.accountid\r\nleft join (\r\n\tselect \r\n\tsales.accountid,\r\n\tsum(case when sostatus='已生效' then ifnull(sales.total,0) else 0 end )/10000 as yeartotal_youxiao,\r\n\tsum(ifnull(sales.total,0))/10000 as yeartotal,\r\n\tsum(case when sales.curmonth=1 and sostatus='已生效' then ifnull(sales.total,0) else 0 end  )/10000 as month1,\r\n\tsum(case when sales.curmonth=2 and sostatus='已生效' then ifnull(sales.total,0) else 0 end  )/10000 as month2,\r\n\tsum(case when sales.curmonth=3 and sostatus='已生效' then ifnull(sales.total,0) else 0 end  )/10000 as month3,\r\n\tsum(case when sales.curmonth=4 and sostatus='已生效' then ifnull(sales.total,0) else 0 end  )/10000 as month4,\r\n\tsum(case when sales.curmonth=5 and sostatus='已生效' then ifnull(sales.total,0) else 0 end  )/10000 as month5,\r\n\tsum(case when sales.curmonth=6 and sostatus='已生效' then ifnull(sales.total,0) else 0 end  )/10000 as month6,\r\n\tsum(case when sales.curmonth=7 and sostatus='已生效' then ifnull(sales.total,0) else 0 end  )/10000 as month7,\r\n\tsum(case when sales.curmonth=8 and sostatus='已生效' then ifnull(sales.total,0) else 0 end  )/10000 as month8,\r\n\tsum(case when sales.curmonth=9 and sostatus='已生效' then ifnull(sales.total,0) else 0 end  )/10000 as month9,\r\n\tsum(case when sales.curmonth=10 and sostatus='已生效' then ifnull(sales.total,0) else 0 end  )/10000 as month10,\r\n\tsum(case when sales.curmonth=11 and sostatus='已生效' then ifnull(sales.total,0) else 0 end  )/10000 as month11,\r\n\tsum(case when sales.curmonth=12 and sostatus='已生效' then ifnull(sales.total,0) else 0 end  )/10000 as month12\r\n\tfrom (\r\n\t\tselect sales.smownerid,sales.total ,sales.accountid,(date_format(sales.signed_data,'%m')+0) as curmonth,sales.sostatus \r\n\t\tfrom  ld_salesorder sales\r\n\t\tleft join ld_salesordercf scf on sales.salesorderid=scf.salesorderid\r\n\t\twhere sales.deleted=0\r\n\t  and sales.signed_data like '%{nian}%'\r\n\t)sales\r\n\tgroup by sales.accountid\r\n) sales on sales.accountid=account.accountid \r\nleft join(\r\n\tselect \r\n\taccountid ,\r\n\tsum(case when sales_stage='60%热度' or sales_stage='70%热度' or sales_stage='80%热度' or sales_stage='90%热度' or sales_stage='100%热度' then ifnull(total,0) else 0 end ) as over60_total,\r\n\tsum(case when sales_stage='20%热度' or sales_stage='30%热度' or sales_stage='40%热度' or sales_stage='50%热度' then ifnull(total,0) else 0 end ) as below60_total,\r\n\tsum(case when sales_stage='60%热度' or sales_stage='70%热度' or sales_stage='80%热度' or sales_stage='90%热度' or sales_stage='100%热度' then 1 else 0 end ) as over60_nums,\r\n\tsum(case when sales_stage='20%热度' or sales_stage='30%热度' or sales_stage='40%热度' or sales_stage='50%热度' then 1 else 0 end ) as below60_nums\r\n\tfrom ld_potential \r\n\twhere deleted=0 \r\n\tgroup by accountid\r\n)p on p.accountid=account.accountid \r\nleft join (\r\n\tselect \r\n\taccountid ,\r\n\tsum(ifnull(total,0))as yuji_total,\r\n\tcount(1) as yuji_nums\r\n\tfrom ld_potential \r\n\twhere deleted=0  AND DATE_FORMAT(closingdate, '%Y-%m') = DATE_FORMAT(CONCAT('{nian}','-','{yue}'-1,'-1'), '%Y-%m')\r\n\tgroup by accountid\r\n) p2 on p2.accountid=account.accountid \r\nleft join (\r\n\tselect \r\n\tmin(DATEDIFF(date_format(now(),\"%Y-%m-%d\"),s.signed_data))as days ,accountid \r\n\tfrom ld_salesorder s\r\n\twhere deleted=0\r\n\tgroup by accountid\r\n) s2 on s2.accountid=account.accountid \r\ninner join(\r\n\tselect \r\n\tid as userid \r\n\tfrom ld_users u \r\n\tleft join ld_users2group u2g on u2g.userid=u.id\r\n\tleft join ld_groups g on g.groupid=u2g.groupid\r\n\tleft join ld_groups g2 on g2.groupid=g.parentid\r\n\twhere u.deleted=0\r\n\tand (\r\n\t\tcase when '{weidu}'=3 and '{ziweidu}'!='' then FIND_IN_SET(u.id ,'{ziweidu}')\r\n\t\twhen '{weidu}'=3 and '{ziweidu}'='' then 1=1\r\n\t\twhen '{weidu}'=2 and '{ziweidu}'!=''  then FIND_IN_SET( g.groupid ,'{ziweidu}') and g.depth=4\r\n\t\twhen '{weidu}'=2 and '{ziweidu}'=''  then g.depth=4\r\n\t\twhen '{weidu}'=1 and '{ziweidu}'!=''  then FIND_IN_SET( g.parentid ,'{ziweidu}') \r\n\t\twhen '{weidu}'=1 and '{ziweidu}'=''  then 1=1\r\n\t\telse 1=1\r\n\t\tend \r\n\t) \r\n)datarange on datarange.userid=account.smownerid\r\nINNER JOIN (\r\n\t\tSELECT DISTINCT\r\n\t\t\tuserid \r\n\t\tFROM (\r\n\t\t\tSELECT \r\n\t\t\t\tld_users.id AS userid \r\n\t\t\tFROM ld_users\r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Accounts' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\tUNION\r\n\t\t\tSELECT \r\n\t\t\t\tviewid AS userid \r\n\t\t\tFROM ld_scoperhigher\r\n\t\t\tWHERE userid='[uuid]' AND modulename ='Accounts' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename ='Accounts')\t\t\t\r\n\t\t\tUNION\r\n\t\t\tSELECT DISTINCT \r\n\t\t\t\tld_users2group.userid AS userid \r\n\t\t\tFROM ld_scoperhigher \r\n\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\tAND ld_scoperhigher.modulename ='Accounts'\r\n\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Accounts' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\tUNION \r\n\t\t\tSELECT \r\n\t\t\t\tid AS userid \r\n\t\t\tFROM ld_users  \r\n\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\tUNION\r\n\t\t\tSELECT '[uuid]') AS vw_users\r\n\t) AS tmp_users ON tmp_users.userid=u.id \r\nwhere account.deleted=0"
      }
    },
