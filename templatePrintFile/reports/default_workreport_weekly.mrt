          },
          "11": {
            "Name": "sub_qty",
            "Index": -1,
            "NameInSource": "sub_qty",
            "Alias": "sub_qty",
            "Type": "System.Int32"
          },
          "12": {
            "Name": "no_qty",
            "Index": -1,
            "NameInSource": "no_qty",
            "Alias": "no_qty",
            "Type": "System.Int32"
          }
        },
        "NameInSource": "ldcrm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\tlast_name,\r\n\tT1,\r\n\tT2,\r\n\tT3,\r\n\tT4,\r\n\tT5,\r\n\tCASE\r\n\t\tWHEN start_date<=CURDATE() AND L1=1 THEN '√'\r\n\t\tWHEN start_date<=CURDATE() AND L1=0 THEN '×'\r\n\t\tWHEN start_date<=CURDATE() AND L1=2 THEN '补'\r\n\t\tELSE  ''\r\n\tEND AS L1,\r\n\tCASE\r\n\t\tWHEN DATE_ADD(start_date,INTERVAL 7 DAY)<=CURDATE() AND L2=1 THEN '√'\r\n\t\tWHEN DATE_ADD(start_date,INTERVAL 7 DAY)<=CURDATE() AND L2=0 THEN '×'\r\n\t\tWHEN DATE_ADD(start_date,INTERVAL 7 DAY)<=CURDATE() AND L2=2 THEN '补'\r\n\t\tELSE  ''\r\n\tEND AS L2,\r\n\tCASE\r\n\t\tWHEN DATE_ADD(start_date,INTERVAL 14 DAY)<=CURDATE() AND L3=1 THEN '√'\r\n\t\tWHEN DATE_ADD(start_date,INTERVAL 14 DAY)<=CURDATE() AND L3=0 THEN '×'\r\n\t\tWHEN DATE_ADD(start_date,INTERVAL 14 DAY)<=CURDATE() AND L3=2 THEN '补'\r\n\t\tELSE  ''\r\n\tEND AS L3,\r\n\tCASE\r\n\t\tWHEN DATE_ADD(start_date,INTERVAL 21 DAY)<=CURDATE() AND L4=1 THEN '√'\r\n\t\tWHEN DATE_ADD(start_date,INTERVAL 21 DAY)<=CURDATE() AND L4=0 THEN '×'\r\n\t\tWHEN DATE_ADD(start_date,INTERVAL 21 DAY)<=CURDATE() AND L4=2 THEN '补'\r\n\t\tELSE  ''\r\n\tEND AS L4,\r\n\tCASE\r\n\t\tWHEN DATE_ADD(start_date,INTERVAL 28 DAY)<=CURDATE() AND L5=1 THEN '√'\r\n\t\tWHEN DATE_ADD(start_date,INTERVAL 28 DAY)<=CURDATE() AND L5=0 THEN '×'\r\n\t\tWHEN DATE_ADD(start_date,INTERVAL 28 DAY)<=CURDATE() AND L5=2 THEN '补'\r\n\t\tELSE  ''\r\n\tEND AS L5,\r\n\tIF(L1=2,1,L1)+IF(L2=2,1,L2)+IF(L3=2,1,L3)+IF(L4=2,1,L4)+IF(L5=2,1,L5) AS sub_qty,\r\n\tCASE\r\n\t\tWHEN start_date>CURDATE() THEN 0\r\n\t\tWHEN DATE_ADD(start_date,INTERVAL 28 DAY)<=CURDATE() THEN 5-(IF(L1=2,1,L1)+IF(L2=2,1,L2)+IF(L3=2,1,L3)+IF(L4=2,1,L4)+IF(L5=2,1,L5))\r\n\t\tELSE WEEK(CURDATE(),3)-WEEK(start_date,3)+1-(IF(L1=2,1,L1)+IF(L2=2,1,L2)+IF(L3=2,1,L3)+IF(L4=2,1,L4)+IF(L5=2,1,L5))\r\n\tEND AS no_qty\r\nFROM (\r\n\tSELECT\r\n\t\ta.id,\r\n\t\ta.last_name,\r\n\t\ta.start_date,\r\n\t\tCONCAT(start_date,'~',DATE_ADD(start_date,INTERVAL 6 DAY)) AS T1,\r\n\t\tCONCAT(DATE_ADD(start_date,INTERVAL 7 DAY),'~',DATE_ADD(start_date,INTERVAL 13 DAY)) AS T2,\r\n\t\tCONCAT(DATE_ADD(start_date,INTERVAL 14 DAY),'~',DATE_ADD(start_date,INTERVAL 20 DAY)) AS T3,\r\n\t\tCONCAT(DATE_ADD(start_date,INTERVAL 21 DAY),'~',DATE_ADD(start_date,INTERVAL 27 DAY)) AS T4,\r\n\t\tCONCAT(DATE_ADD(start_date,INTERVAL 28 DAY),'~',DATE_ADD(start_date,INTERVAL 34 DAY)) AS T5,\r\n\t\tCASE\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_workreport WHERE type=2 AND smcreatorid=a.id \r\n\t\t\t\tAND DATE_FORMAT(createdtime,'%Y-%m-%d') BETWEEN start_date AND DATE_ADD(start_date,INTERVAL 6 DAY)\r\n\t\t\t\tAND DATE_FORMAT(createdtime,'%Y-%m-%d') BETWEEN LEFT(sendlog_workdate,10) AND RIGHT(sendlog_workdate,10)) THEN 1\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_workreport WHERE type=2 AND smcreatorid=a.id \r\n\t\t\t\tAND LEFT(sendlog_workdate,10) BETWEEN start_date AND DATE_ADD(start_date,INTERVAL 6 DAY)) THEN 2 \r\n\t\t\tELSE 0\r\n\t\tEND AS L1,\r\n\t\tCASE\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_workreport WHERE type=2 AND smcreatorid=a.id \r\n\t\t\t\tAND DATE_FORMAT(createdtime,'%Y-%m-%d') BETWEEN DATE_ADD(start_date,INTERVAL 7 DAY) AND DATE_ADD(start_date,INTERVAL 13 DAY)\r\n\t\t\t\tAND DATE_FORMAT(createdtime,'%Y-%m-%d') BETWEEN LEFT(sendlog_workdate,10) AND RIGHT(sendlog_workdate,10)) THEN 1\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_workreport WHERE type=2 AND smcreatorid=a.id \r\n\t\t\t\tAND LEFT(sendlog_workdate,10) BETWEEN DATE_ADD(start_date,INTERVAL 7 DAY) AND DATE_ADD(start_date,INTERVAL 13 DAY)) THEN 2\r\n\t\t\tELSE 0\r\n\t\tEND AS L2,\r\n\t\tCASE\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_workreport WHERE type=2 AND smcreatorid=a.id \r\n\t\t\t\tAND DATE_FORMAT(createdtime,'%Y-%m-%d') BETWEEN DATE_ADD(start_date,INTERVAL 14 DAY) AND DATE_ADD(start_date,INTERVAL 20 DAY)\r\n\t\t\t\tAND DATE_FORMAT(createdtime,'%Y-%m-%d') BETWEEN LEFT(sendlog_workdate,10) AND RIGHT(sendlog_workdate,10)) THEN 1\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_workreport WHERE type=2 AND smcreatorid=a.id \r\n\t\t\t\tAND LEFT(sendlog_workdate,10) BETWEEN DATE_ADD(start_date,INTERVAL 14 DAY) AND DATE_ADD(start_date,INTERVAL 20 DAY)) THEN 2\r\n\t\t\tELSE 0\r\n\t\tEND AS L3,\r\n\t\tCASE\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_workreport WHERE type=2 AND smcreatorid=a.id \r\n\t\t\t\tAND DATE_FORMAT(createdtime,'%Y-%m-%d') BETWEEN DATE_ADD(start_date,INTERVAL 21 DAY) AND DATE_ADD(start_date,INTERVAL 27 DAY)\r\n\t\t\t\tAND DATE_FORMAT(createdtime,'%Y-%m-%d') BETWEEN LEFT(sendlog_workdate,10) AND RIGHT(sendlog_workdate,10)) THEN 1\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_workreport WHERE type=2 AND smcreatorid=a.id \r\n\t\t\t\tAND LEFT(sendlog_workdate,10) BETWEEN DATE_ADD(start_date,INTERVAL 21 DAY) AND DATE_ADD(start_date,INTERVAL 27 DAY)) THEN 2\r\n\t\t\tELSE 0\r\n\t\tEND AS L4,\r\n\t\tCASE\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_workreport WHERE type=2 AND smcreatorid=a.id \r\n\t\t\t\tAND DATE_FORMAT(createdtime,'%Y-%m-%d') BETWEEN DATE_ADD(start_date,INTERVAL 28 DAY) AND DATE_ADD(start_date,INTERVAL 34 DAY)\r\n\t\t\t\tAND DATE_FORMAT(createdtime,'%Y-%m-%d') BETWEEN LEFT(sendlog_workdate,10) AND RIGHT(sendlog_workdate,10)) THEN 1\r\n\t\t\tWHEN EXISTS (SELECT 1 FROM ld_workreport WHERE type=2 AND smcreatorid=a.id \r\n\t\t\t\tAND LEFT(sendlog_workdate,10) BETWEEN DATE_ADD(start_date,INTERVAL 28 DAY) AND DATE_ADD(start_date,INTERVAL 34 DAY)) THEN 2\r\n\t\t\tELSE 0\r\n\t\tEND AS L5\r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\tu.id,\r\n\t\t\tu.last_name,\r\n\t\t\tCASE\r\n\t\t\t\tWHEN WEEKDAY(start_day) IN (0,1,2,3,4,5) THEN DATE_SUB(start_day,INTERVAL WEEKDAY(start_day) DAY)\r\n\t\t\t\tELSE DATE_SUB(start_day,INTERVAL WEEKDAY(start_day)-7 DAY)\r\n\t\t\tEND AS start_date\r\n\t\tFROM (\r\n\t\t\tSELECT\r\n\t\t\t\ta.id,\r\n\t\t\t\t(case when left(database(),2)='wx' and right(database(),5)+0>10000 and IFNULL(a.real_name,'')<>'' then a.real_name else a.last_name end ) AS last_name,\r\n\t\t\t\tSTR_TO_DATE(CONCAT('{nian}','-','{yue}','-','1'),'%Y-%m-%d') AS start_day,\r\n\t\t\t\tLAST_DAY(STR_TO_DATE(CONCAT('{nian}','-','{yue}','-','1'),'%Y-%m-%d')) AS end_day\r\n\t\t\tFROM ld_users a\r\n\t\t\tINNER JOIN (\r\n\t\t\t\tSELECT DISTINCT\r\n\t\t\t\t\tuserid \r\n\t\t\t\tFROM (\r\n\t\t\t\t\tSELECT \r\n\t\t\t\t\t\tld_users.id AS userid \r\n\t\t\t\t\tFROM ld_users\r\n\t\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='CooperativeWork' and scopeauthority=1 AND userid='[uuid]')\r\n\t\t\t\t\tUNION\r\n\t\t\t\t\tSELECT \r\n\t\t\t\t\t\tviewid AS userid \r\n\t\t\t\t\tFROM ld_scoperhigher\r\n\t\t\t\t\tWHERE userid='[uuid]' AND modulename='CooperativeWork' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename='CooperativeWork')\t\t\t\r\n\t\t\t\t\tUNION\r\n\t\t\t\t\tSELECT DISTINCT \r\n\t\t\t\t\t\tld_users2group.userid AS userid \r\n\t\t\t\t\tFROM ld_scoperhigher \r\n\t\t\t\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\t\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\t\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\t\t\tAND ld_scoperhigher.modulename='CooperativeWork'\r\n\t\t\t\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='CooperativeWork' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\t\t\t\tUNION \r\n\t\t\t\t\tSELECT \r\n\t\t\t\t\t\tid AS userid \r\n\t\t\t\t\tFROM ld_users  \r\n\t\t\t\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\t\t\t\tUNION\r\n\t\t\t\t\tSELECT '[uuid]') AS vw_users\r\n\t\t\t) AS tmp_users ON tmp_users.userid=a.id\r\n\t\t\tINNER JOIN (\r\n\t\t\t\tSELECT\r\n\t\t\t\t\ta.userid\r\n\t\t\t\tFROM ld_users2group a\r\n\t\t\t\tLEFT JOIN ld_groups b ON a.groupid=b.groupid\r\n\t\t\t\tWHERE (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{bumen}'='' THEN 1=1\r\n\t\t\t\t\t\tWHEN '{bumen}'>0 AND '{bumen}' NOT LIKE '%,%' THEN a.groupid='{bumen}' OR LOCATE((SELECT CONCAT(parentgroup,'::') FROM ld_groups WHERE groupid='{bumen}'),b.parentgroup) \r\n\t\t\t\t\t\tELSE FIND_IN_SET(a.groupid,'{bumen}')\r\n\t\t\t\t\tEND)\r\n\t\t\t\tGROUP BY a.userid\r\n\t\t\t) tmp_groups ON tmp_groups.userid=a.id\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.`status`='Active'\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{userid}'='' THEN 1=1\r\n\t\t\t\t\t\tELSE FIND_IN_SET(a.id,'{userid}')\r\n\t\t\t\t\tEND)\r\n\t\t) u\r\n\t) a\r\n) t\r\nORDER BY CONVERT(last_name USING GBK)"
      }
    },
