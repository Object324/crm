        "NameInSource": "ldcrm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\ta.invoiceid AS orderid,\r\n\ta.invoice_no AS orderno,\r\n\tf.potentialname AS ccf_no,\r\n\tg.accountname,\r\n\tu1.last_name AS smowner,\r\n\td.salesorder_no,\r\n\te.cf_2323 AS htxz,\r\n\te.cf_2395 AS quyu,\r\n\te.cf_2321 AS term,\r\n\ta.description,\r\n\tb.invoicetype,\r\n\ta.invoicedate,\r\n\ta.total\r\nFROM ld_invoice a\r\nLEFT JOIN ld_invoicecf b ON a.invoiceid=b.invoiceid\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\tid,\r\n\t\tentitytypeid\r\n\tFROM ld_invoicedetail \r\n\tWHERE entitytypeid>0\r\n\t\tAND entitytype='SalesOrder'\r\n\tGROUP BY id\r\n) c ON c.id=a.invoiceid\r\nLEFT JOIN ld_salesorder d ON d.salesorderid=c.entitytypeid\r\nLEFT JOIN ld_salesordercf e ON e.salesorderid=d.salesorderid\r\nLEFT JOIN ld_potential f ON f.potentialid=a.potentialid\r\nLEFT JOIN ld_account g ON g.accountid=a.accountid\r\nLEFT JOIN ld_users u1 ON u1.id=a.smownerid\r\nINNER JOIN (\r\n\tSELECT DISTINCT\r\n\t\tuserid \r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\tld_users.id AS userid \r\n\t\tFROM ld_users\r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='Invoice' and scopeauthority=1 AND userid='[uuid]')\r\n\t\tUNION\r\n\t\tSELECT \r\n\t\t\tviewid AS userid \r\n\t\tFROM ld_scoperhigher\r\n\t\tWHERE userid='[uuid]' AND modulename='Invoice' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename='Invoice')\t\t\t\r\n\t\tUNION\r\n\t\tSELECT DISTINCT \r\n\t\t\tld_users2group.userid AS userid \r\n\t\tFROM ld_scoperhigher \r\n\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\tAND ld_scoperhigher.modulename='Invoice'\r\n\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename='Invoice' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\tUNION \r\n\t\tSELECT \r\n\t\t\tid AS userid \r\n\t\tFROM ld_users  \r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\tUNION\r\n\t\tSELECT '[uuid]') AS vw_users\r\n) AS list_user ON list_user.userid=a.smownerid\r\nWHERE a.deleted=0 \r\n\tAND a.approvestatus<>'已拒绝'\r\n\tAND a.invoicedate BETWEEN   DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{ordernum}'='' THEN 1=1\r\n\t\t\tELSE LOCATE(TRIM('{ordernum}'),f.potentialname)>0\r\n\t\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{custname}'='' THEN 1=1\r\n\t\t\tELSE LOCATE(TRIM('{custname}'),g.accountname)>0\r\n\t\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{userid}'='' THEN 1=1\r\n\t\t\tELSE FIND_IN_SET(a.smownerid,'{userid}')\r\n\t\tEND)\r\nORDER BY a.invoicedate,a.createdtime"
      }
    },
