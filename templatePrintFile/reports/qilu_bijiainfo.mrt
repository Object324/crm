        "NameInSource": "crm",
        "Type": "Table",
        "SqlCommand": "\tSELECT\r\n\t\tc.productid,\r\n\t\td.product_no,\r\n\t\td.productname,\r\n\t\td.productsheet,\r\n\t\tc.quantity,\r\n\t\t(SELECT\r\n\t\t\tz.vendorname\r\n\t\tFROM ld_purchaseinquiryorder x\r\n\t\tLEFT JOIN ld_purchaseinquiryorderdetail y ON y.id=x.purchaseinquiryorderid\r\n\t\tLEFT JOIN ld_vendor z On z.vendorid=x.vendorid\r\n\t\tWHERE x.deleted=0\r\n\t\t\tAND x.approvestatus<>'已拒绝'\r\n\t\t\tAND y.productid=c.productid\r\n\t\tORDER BY y.taxprice LIMIT 0,1) AS v1,\r\n\t\tCONCAT(CONCAT((SELECT\r\n\t\t\ty.taxprice\r\n\t\tFROM ld_purchaseinquiryorder x\r\n\t\tLEFT JOIN ld_purchaseinquiryorderdetail y ON y.id=x.purchaseinquiryorderid\r\n\t\tWHERE x.deleted=0\r\n\t\t\tAND x.approvestatus<>'已拒绝'\r\n\t\t\tAND y.productid=c.productid\r\n\t\tORDER BY y.taxprice LIMIT 0,1),'')+0,'') AS p1,\r\n\r\n\t\t(SELECT\r\n\t\t\tz.vendorname\r\n\t\tFROM ld_purchaseinquiryorder x\r\n\t\tLEFT JOIN ld_purchaseinquiryorderdetail y ON y.id=x.purchaseinquiryorderid\r\n\t\tLEFT JOIN ld_vendor z On z.vendorid=x.vendorid\r\n\t\tWHERE x.deleted=0\r\n\t\t\tAND x.approvestatus<>'已拒绝'\r\n\t\t\tAND y.productid=c.productid\r\n\t\tORDER BY y.taxprice LIMIT 1,1) AS v2,\r\n\t\tCONCAT(CONCAT((SELECT\r\n\t\t\ty.taxprice\r\n\t\tFROM ld_purchaseinquiryorder x\r\n\t\tLEFT JOIN ld_purchaseinquiryorderdetail y ON y.id=x.purchaseinquiryorderid\r\n\t\tWHERE x.deleted=0\r\n\t\t\tAND x.approvestatus<>'已拒绝'\r\n\t\t\tAND y.productid=c.productid\r\n\t\tORDER BY y.taxprice LIMIT 1,1),'')+0,'') AS p2,\r\n\r\n\t\t(SELECT\r\n\t\t\tz.vendorname\r\n\t\tFROM ld_purchaseinquiryorder x\r\n\t\tLEFT JOIN ld_purchaseinquiryorderdetail y ON y.id=x.purchaseinquiryorderid\r\n\t\tLEFT JOIN ld_vendor z On z.vendorid=x.vendorid\r\n\t\tWHERE x.deleted=0\r\n\t\t\tAND x.approvestatus<>'已拒绝'\r\n\t\t\tAND y.productid=c.productid\r\n\t\tORDER BY y.taxprice LIMIT 2,1) AS v3,\r\n\t\tCONCAT(CONCAT((SELECT\r\n\t\t\ty.taxprice\r\n\t\tFROM ld_purchaseinquiryorder x\r\n\t\tLEFT JOIN ld_purchaseinquiryorderdetail y ON y.id=x.purchaseinquiryorderid\r\n\t\tWHERE x.deleted=0\r\n\t\t\tAND x.approvestatus<>'已拒绝'\r\n\t\t\tAND y.productid=c.productid\r\n\t\tORDER BY y.taxprice LIMIT 2,1),'')+0,'') AS p3,\r\n\r\n\t\t(SELECT\r\n\t\t\tz.vendorname\r\n\t\tFROM ld_purchaseinquiryorder x\r\n\t\tLEFT JOIN ld_purchaseinquiryorderdetail y ON y.id=x.purchaseinquiryorderid\r\n\t\tLEFT JOIN ld_vendor z On z.vendorid=x.vendorid\r\n\t\tWHERE x.deleted=0\r\n\t\t\tAND x.approvestatus<>'已拒绝'\r\n\t\t\tAND y.productid=c.productid\r\n\t\tORDER BY y.taxprice LIMIT 3,1) AS v4,\r\n\t\tCONCAT(CONCAT((SELECT\r\n\t\t\ty.taxprice\r\n\t\tFROM ld_purchaseinquiryorder x\r\n\t\tLEFT JOIN ld_purchaseinquiryorderdetail y ON y.id=x.purchaseinquiryorderid\r\n\t\tWHERE x.deleted=0\r\n\t\t\tAND x.approvestatus<>'已拒绝'\r\n\t\t\tAND y.productid=c.productid\r\n\t\tORDER BY y.taxprice LIMIT 3,1),'')+0,'') AS p4,\r\n\r\n\t\t(SELECT\r\n\t\t\tz.vendorname\r\n\t\tFROM ld_purchaseinquiryorder x\r\n\t\tLEFT JOIN ld_purchaseinquiryorderdetail y ON y.id=x.purchaseinquiryorderid\r\n\t\tLEFT JOIN ld_vendor z On z.vendorid=x.vendorid\r\n\t\tWHERE x.deleted=0\r\n\t\t\tAND x.approvestatus<>'已拒绝'\r\n\t\t\tAND y.productid=c.productid\r\n\t\tORDER BY y.taxprice LIMIT 4,1) AS v5,\r\n\t\tCONCAT(CONCAT((SELECT\r\n\t\t\ty.taxprice\r\n\t\tFROM ld_purchaseinquiryorder x\r\n\t\tLEFT JOIN ld_purchaseinquiryorderdetail y ON y.id=x.purchaseinquiryorderid\r\n\t\tWHERE x.deleted=0\r\n\t\t\tAND x.approvestatus<>'已拒绝'\r\n\t\t\tAND y.productid=c.productid\r\n\t\tORDER BY y.taxprice LIMIT 4,1),'')+0,'') AS p5,\r\n\r\n\t\t(SELECT\r\n\t\t\tz.vendorname\r\n\t\tFROM ld_purchaseinquiryorder x\r\n\t\tLEFT JOIN ld_purchaseinquiryorderdetail y ON y.id=x.purchaseinquiryorderid\r\n\t\tLEFT JOIN ld_vendor z On z.vendorid=x.vendorid\r\n\t\tWHERE x.deleted=0\r\n\t\t\tAND x.approvestatus<>'已拒绝'\r\n\t\t\tAND y.productid=c.productid\r\n\t\tORDER BY y.taxprice LIMIT 5,1) AS v6,\r\n\t\tCONCAT(CONCAT((SELECT\r\n\t\t\ty.taxprice\r\n\t\tFROM ld_purchaseinquiryorder x\r\n\t\tLEFT JOIN ld_purchaseinquiryorderdetail y ON y.id=x.purchaseinquiryorderid\r\n\t\tWHERE x.deleted=0\r\n\t\t\tAND x.approvestatus<>'已拒绝'\r\n\t\t\tAND y.productid=c.productid\r\n\t\tORDER BY y.taxprice LIMIT 5,1),'')+0,'') AS p6\r\n\tFROM ld_purchaseorder a\r\n\tLEFT JOIN ld_purchaseordercf b ON b.purchaseorderid=a.purchaseorderid\r\n\tLEFT JOIN ld_purchaseorderdetail c ON c.id=a.purchaseorderid\r\n\tLEFT JOIN ld_products d ON d.productid=c.productid\r\n\tWHERE a.purchaseorderid='[related_ldcrmid]'"
      }
    },
