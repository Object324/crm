            "Type": "System.DateTime"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\ta.purchaseorderid,\r\n\ta.purchaseorder_no,\r\n\ta.signed_data,\r\n\ta.postatus,\r\n\ta.approvestatus,\r\n\tb.productid,\r\n\tSUM(b.balancepurchasecount) AS qty_way,\r\n\tFORMAT(SUM(b.balancepurchasecount),(select deploy_value from ld_systems_deploy where deploy_type=49 limit 1)) AS qty_locked_show,\r\n\tc.last_name\t\r\nFROM ld_purchaseorder a\r\nLEFT JOIN ld_purchaseorderdetail b ON a.purchaseorderid=b.id\r\nLEFT JOIN ld_users c ON c.id=a.smownerid\r\nWHERE a.deleted=0\r\n\tAND a.approvestatus<>'已拒绝'\r\n\tAND IFNULL(a.postatus,'')<>'已作废'\r\n\tAND b.balancepurchasecount>0\r\n\tAND b.productid='{this[\"id\"]}'\r\nGROUP BY a.purchaseorderid\r\nORDER BY a.signed_data,a.purchaseorderid"
      },
      "4": {
        "Ident": "StiMySqlSource",
        "Name": "detai_ware",
        "Alias": "detai_ware",
        "Columns": {
