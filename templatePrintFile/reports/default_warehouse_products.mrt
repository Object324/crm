        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\tbillseq,\r\n\tproductid,\r\n\tproductname,\r\n\tproduct_no,\r\n\tproductsheet,\r\n\tusageunit,\r\n\tbatchtext,\r\n\tFORMAT(inventory_qty,diglength) AS qty_show,\r\n\tFORMAT(qty_locked,diglength) AS qty_locked_show,\r\n\tFORMAT(qty_way,diglength) AS qty_way_show,\r\n\tFORMAT(anquan_qty,diglength) AS anquan_qty_show,\r\n\tFORMAT(cha_qty,diglength) AS cha_qty_show\r\nFROM ( \r\n\t(SELECT\r\n\t\t0 AS billseq,\r\n\t\t(SELECT deploy_value FROM ld_systems_deploy WHERE deploy_type=49 LIMIT 1) AS diglength,\r\n\t\tproductid,\r\n\t\tproductname,\r\n\t\tproduct_no,\r\n\t\tproductsheet,\r\n\t\tusageunit,\r\n\t\tbatchtext,\r\n\t\tinventory_qty,\r\n\t\tqty_locked,\r\n\t\tqty_way,\r\n\t\tanquan_qty,\r\n\t\tcha_qty\r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\tp.productid,\r\n\t\t\tp.productname,\r\n\t\t\tp.product_no,\r\n\t\t\tp.productsheet,\r\n\t\t\tp.usageunit,\r\n\t\t\ta.batchtext,\r\n\t\t\tIFNULL(a.inventory_qty,0) AS inventory_qty,\r\n\t\t\tIFNULL(b.qty_locked,0) AS qty_locked,\r\n\t\t\tIFNULL(c.qty_way,0) AS qty_way,\r\n\t\t\tIFNULL(p.qtyearly,0) AS anquan_qty,\r\n\t\t\tIFNULL(a.inventory_qty,0)-IFNULL(b.qty_locked,0)+IFNULL(c.qty_way,0)-IFNULL(p.qtyearly,0) AS cha_qty\r\n\t\tFROM ld_products p\r\n\t\tINNER JOIN (\r\n\t\t\tSELECT\r\n\t\t\t\ta.productid,\r\n\t\t\t\ta.batchtext,\r\n\t\t\t\tSUM(a.inventory_qty) AS inventory_qty\r\n\t\t\tFROM (\r\n\t\t\t\tSELECT\r\n\t\t\t\t\ta.warehouseid AS wareid,\r\n\t\t\t\t\ta.productid,\r\n\t\t\t\t\ta.batchtext,\r\n\t\t\t\t\ta.lastqty AS inventory_qty\r\n\t\t\t\tFROM ld_warehousecondtions a\r\n\t\t\t\tLEFT JOIN ld_products c ON c.productid=a.productid\r\n\t\t\t\tWHERE a.modulename='库存初始化'\r\n\t\t\t\t\tAND a.type='确认初始库存'\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{productname}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{productname}',c.productname)>0\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{productno}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{productno}',c.product_no)>0\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{productsheet}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{productsheet}',c.productsheet)>0\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{pici}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{pici}',a.batchtext)>0\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{warename}'='0' THEN 1=1\r\n\t\t\t\t\t\t\tELSE a.warehouseid='{warename}'\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\tUNION ALL\r\n\t\t\t\tSELECT\r\n\t\t\t\t\ta.wareid,\r\n\t\t\t\t\tc.productid,\r\n\t\t\t\t\tc.batchtext,\r\n\t\t\t\t\tc.quantity\r\n\t\t\t\tFROM ld_stock a\r\n\t\t\t\tLEFT JOIN ld_stockdetail c ON c.id=a.stock_id\r\n\t\t\t\tLEFT JOIN ld_products p ON p.productid=c.productid\r\n\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{productname}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{productname}',p.productname)>0\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{productno}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{productno}',p.product_no)>0\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{productsheet}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{productsheet}',p.productsheet)>0\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{pici}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{pici}',c.batchtext)>0\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{warename}'='0' THEN 1=1\r\n\t\t\t\t\t\t\tELSE a.wareid='{warename}'\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{shenpi}'='1' THEN 1=1\r\n\t\t\t\t\t\t\tELSE a.approvestatus='已批准'\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\tUNION ALL\r\n\t\t\t\tSELECT\r\n\t\t\t\t\ta.wareid,\r\n\t\t\t\t\tc.productid,\r\n\t\t\t\t\tc.batchtext,\r\n\t\t\t\t\tc.quantity\r\n\t\t\t\tFROM ld_salesback a\r\n\t\t\t\tLEFT JOIN ld_salesbackdetail c ON c.id=a.salesbackid\r\n\t\t\t\tLEFT JOIN ld_products p ON p.productid=c.productid\r\n\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\tAND a.salesbackstatus<>'中止'\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{productname}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{productname}',p.productname)>0\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{productno}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{productno}',p.product_no)>0\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{productsheet}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{productsheet}',p.productsheet)>0\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{pici}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{pici}',c.batchtext)>0\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{warename}'='0' THEN 1=1\r\n\t\t\t\t\t\t\tELSE a.wareid='{warename}'\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{shenpi}'='1' THEN 1=1\r\n\t\t\t\t\t\t\tELSE a.approvestatus='已批准'\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\tUNION ALL\r\n\t\t\t\tSELECT\r\n\t\t\t\t\tc.wareid,\r\n\t\t\t\t\tc.productid,\r\n\t\t\t\t\tc.batchtext,\r\n\t\t\t\t\t0-c.quantity\r\n\t\t\t\tFROM ld_outboundorder a\r\n\t\t\t\tLEFT JOIN ld_outboundordercf b ON a.out_id=b.out_id\r\n\t\t\t\tLEFT JOIN ld_outboundorderdetail c ON c.id=a.out_id\r\n\t\t\t\tLEFT JOIN ld_outboundorderdetailscf d ON d.lineitem_id=c.lineitem_id\r\n\t\t\t\tLEFT JOIN ld_products p ON p.productid=c.productid\r\n\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{productname}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{productname}',p.productname)>0\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{productno}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{productno}',p.product_no)>0\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{productsheet}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{productsheet}',p.productsheet)>0\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{pici}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{pici}',c.batchtext)>0\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{warename}'='0' THEN 1=1\r\n\t\t\t\t\t\t\tELSE c.wareid='{warename}'\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{shenpi}'='1' THEN 1=1\r\n\t\t\t\t\t\t\tELSE a.approvestatus='已批准'\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\tUNION ALL\r\n\t\t\t\tSELECT\r\n\t\t\t\t\ta.wareid,\r\n\t\t\t\t\tc.productid,\r\n\t\t\t\t\tc.batchtext,\r\n\t\t\t\t\t0-c.quantity\r\n\t\t\t\tFROM ld_purchaseback a\r\n\t\t\t\tLEFT JOIN ld_purchasebackdetail c ON c.id=a.purchasebackid\r\n\t\t\t\tLEFT JOIN ld_products p ON p.productid=c.productid\r\n\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\tAND a.purchasebackstatus<>'中止'\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{productname}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{productname}',p.productname)>0\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{productno}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{productno}',p.product_no)>0\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{productsheet}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{productsheet}',p.productsheet)>0\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{pici}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{pici}',c.batchtext)>0\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{warename}'='0' THEN 1=1\r\n\t\t\t\t\t\t\tELSE a.wareid='{warename}'\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{shenpi}'='1' THEN 1=1\r\n\t\t\t\t\t\t\tELSE a.purchasebackstatus='结束'\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\tUNION ALL\r\n\t\t\t\tSELECT\r\n\t\t\t\t\ta.inwarehouse,\r\n\t\t\t\t\tc.productid,\r\n\t\t\t\t\tc.batchtext,\r\n\t\t\t\t\tc.quantity\r\n\t\t\t\tFROM ld_warehousetransfer a\r\n\t\t\t\tLEFT JOIN ld_warehousetransferdetail c ON c.id=a.warehousetransferid\r\n\t\t\t\tLEFT JOIN ld_products p ON p.productid=c.productid\r\n\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{productname}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{productname}',p.productname)>0\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{productno}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{productno}',p.product_no)>0\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{productsheet}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{productsheet}',p.productsheet)>0\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{pici}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{pici}',c.batchtext)>0\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{warename}'='0' THEN 1=1\r\n\t\t\t\t\t\t\tELSE a.inwarehouse='{warename}'\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{shenpi}'='1' THEN 1=1\r\n\t\t\t\t\t\t\tELSE a.transferstatus='已审核'\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\tUNION ALL\r\n\t\t\t\tSELECT\r\n\t\t\t\t\ta.outwarehouse,\r\n\t\t\t\t\tc.productid,\r\n\t\t\t\t\tc.batchtext,\r\n\t\t\t\t\t0-c.quantity\r\n\t\t\t\tFROM ld_warehousetransfer a\r\n\t\t\t\tLEFT JOIN ld_warehousetransferdetail c ON c.id=a.warehousetransferid\r\n\t\t\t\tLEFT JOIN ld_products p ON p.productid=c.productid\r\n\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{productname}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{productname}',p.productname)>0\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{productno}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{productno}',p.product_no)>0\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{productsheet}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{productsheet}',p.productsheet)>0\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{pici}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{pici}',c.batchtext)>0\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{warename}'='0' THEN 1=1\r\n\t\t\t\t\t\t\tELSE a.outwarehouse='{warename}'\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{shenpi}'='1' THEN 1=1\r\n\t\t\t\t\t\t\tELSE a.transferstatus='已审核'\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\tUNION ALL\r\n\t\t\t\tSELECT\r\n\t\t\t\t\ta.wareid,\r\n\t\t\t\t\tc.productid,\r\n\t\t\t\t\tc.batchtext,\r\n\t\t\t\t\tc.profitloss\r\n\t\t\t\tFROM ld_checks a\r\n\t\t\t\tLEFT JOIN ld_checksdetail c ON c.id=a.id\r\n\t\t\t\tLEFT JOIN ld_products p ON p.productid=c.productid\r\n\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{productname}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{productname}',p.productname)>0\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{productno}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{productno}',p.product_no)>0\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{productsheet}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{productsheet}',p.productsheet)>0\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{pici}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{pici}',c.batchtext)>0\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{warename}'='0' THEN 1=1\r\n\t\t\t\t\t\t\tELSE a.wareid='{warename}'\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{shenpi}'='1' THEN 1=1\r\n\t\t\t\t\t\t\tELSE a.presence='盘点结束'\r\n\t\t\t\t\t\tEND)\r\n\t\t\t) a\r\n\t\t\tWHERE a.productid>0\r\n\t\t\tGROUP BY a.productid,IFNULL(a.batchtext,'')\r\n\t\t) a ON p.productid=a.productid\r\n\t\tLEFT JOIN (\r\n\t\t\tSELECT\r\n\t\t\t\tb.productid,\r\n\t\t\t\tSUM(b.balanceoutproductcount) AS qty_locked\r\n\t\t\tFROM (\r\n\t\t\t\tSELECT \r\n\t\t\t\t\ta.salesorderid AS order_id\r\n\t\t\t\tFROM ld_salesorder a \r\n\t\t\t\tWHERE a.deleted=0 \r\n\t\t\t\t\tAND a.approvestatus<>'已拒绝' \r\n\t\t\t\t\tAND IFNULL(a.sostatus,'')<>'已作废'\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{shenpi}'='1' THEN 1=1\r\n\t\t\t\t\t\t\tELSE a.approvestatus='已批准'\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\tUNION ALL\r\n\t\t\t\tSELECT \r\n\t\t\t\t\ta.servicecontractsid\r\n\t\t\t\tFROM ld_servicecontracts a \r\n\t\t\t\tWHERE a.deleted=0 \r\n\t\t\t\t\tAND a.approvestatus<>'已拒绝' \r\n\t\t\t\t\tAND IFNULL(a.contract_status,'')<>'已作废'\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{shenpi}'='1' THEN 1=1\r\n\t\t\t\t\t\t\tELSE a.approvestatus='已批准'\r\n\t\t\t\t\t\tEND)\r\n\t\t\t) a\r\n\t\t\tLEFT JOIN (\r\n\t\t\t\tSELECT id,productid,balanceoutproductcount FROM ld_salesorderdetail\r\n\t\t\t\tUNION ALL\r\n\t\t\t\tSELECT id,productid,balanceoutproductcount FROM ld_servicecontractsdetail\r\n\t\t\t) b ON a.order_id=b.id\r\n\t\t\tWHERE b.balanceoutproductcount>0\r\n\t\t\tGROUP BY b.productid\r\n\t\t) b ON a.productid=b.productid\r\n\t\tLEFT JOIN (\r\n\t\t\tSELECT\r\n\t\t\t\tb.productid,\r\n\t\t\t\tSUM(b.balancepurchasecount) AS qty_way\r\n\t\t\tFROM ld_purchaseorder a\r\n\t\t\tLEFT JOIN ld_purchaseorderdetail b ON a.purchaseorderid=b.id\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND IFNULL(a.postatus,'')<>'已作废'\r\n\t\t\t\tAND b.balancepurchasecount>0\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{shenpi}'='1' THEN 1=1\r\n\t\t\t\t\t\tELSE a.approvestatus='已批准'\r\n\t\t\t\t\tEND)\r\n\t\t\tGROUP BY b.productid\r\n\t\t) c ON c.productid=a.productid\r\n\t) tmp\r\n\tWHERE (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{qty_range}'='true' THEN inventory_qty>0\r\n\t\t\t\tELSE 1=1\r\n\t\t\tEND)\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{safety_range}'='true' THEN cha_qty<0\r\n\t\t\t\tELSE 1=1\r\n\t\t\tEND)\r\n) UNION ALL (\r\n\tSELECT\r\n\t\t1 AS billseq,\r\n\t\t(SELECT deploy_value FROM ld_systems_deploy WHERE deploy_type=49 LIMIT 1) AS diglength,\r\n\t\tproductid,\r\n\t\tCONCAT(productname,' - 小计') AS productname,\r\n\t\tproduct_no,\r\n\t\tproductsheet,\r\n\t\tusageunit,\r\n\t\t'' AS batchtext,\r\n\t\tSUM(inventory_qty) AS inventory_qty,\r\n\t\tqty_locked,\r\n\t\tqty_way,\r\n\t\tanquan_qty,\r\n\t\tSUM(inventory_qty)-qty_locked+qty_way-anquan_qty AS cha_qty\r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\tp.productid,\r\n\t\t\tp.productname,\r\n\t\t\tp.product_no,\r\n\t\t\tp.productsheet,\r\n\t\t\tp.usageunit,\r\n\t\t\ta.batchtext,\r\n\t\t\tIFNULL(a.inventory_qty,0) AS inventory_qty,\r\n\t\t\tIFNULL(b.qty_locked,0) AS qty_locked,\r\n\t\t\tIFNULL(c.qty_way,0) AS qty_way,\r\n\t\t\tIFNULL(p.qtyearly,0) AS anquan_qty,\r\n\t\t\tIFNULL(a.inventory_qty,0)-IFNULL(b.qty_locked,0)+IFNULL(c.qty_way,0)-IFNULL(p.qtyearly,0) AS cha_qty\r\n\t\tFROM ld_products p\r\n\t\tLEFT JOIN (\r\n\t\t\tSELECT\r\n\t\t\t\ta.productid,\r\n\t\t\t\ta.batchtext,\r\n\t\t\t\tSUM(a.inventory_qty) AS inventory_qty\r\n\t\t\tFROM (\r\n\t\t\t\tSELECT\r\n\t\t\t\t\ta.warehouseid AS wareid,\r\n\t\t\t\t\ta.productid,\r\n\t\t\t\t\ta.batchtext,\r\n\t\t\t\t\ta.lastqty AS inventory_qty\r\n\t\t\t\tFROM ld_warehousecondtions a\r\n\t\t\t\tLEFT JOIN ld_products c ON c.productid=a.productid\r\n\t\t\t\tWHERE a.modulename='库存初始化'\r\n\t\t\t\t\tAND a.type='确认初始库存'\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{productname}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{productname}',c.productname)>0\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{productno}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{productno}',c.product_no)>0\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{productsheet}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{productsheet}',c.productsheet)>0\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{pici}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{pici}',a.batchtext)>0\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{warename}'='0' THEN 1=1\r\n\t\t\t\t\t\t\tELSE a.warehouseid='{warename}'\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\tUNION ALL\r\n\t\t\t\tSELECT\r\n\t\t\t\t\ta.wareid,\r\n\t\t\t\t\tc.productid,\r\n\t\t\t\t\tc.batchtext,\r\n\t\t\t\t\tc.quantity\r\n\t\t\t\tFROM ld_stock a\r\n\t\t\t\tLEFT JOIN ld_stockdetail c ON c.id=a.stock_id\r\n\t\t\t\tLEFT JOIN ld_products p ON p.productid=c.productid\r\n\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{productname}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{productname}',p.productname)>0\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{productno}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{productno}',p.product_no)>0\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{productsheet}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{productsheet}',p.productsheet)>0\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{pici}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{pici}',c.batchtext)>0\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{warename}'='0' THEN 1=1\r\n\t\t\t\t\t\t\tELSE a.wareid='{warename}'\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{shenpi}'='1' THEN 1=1\r\n\t\t\t\t\t\t\tELSE a.approvestatus='已批准'\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\tUNION ALL\r\n\t\t\t\tSELECT\r\n\t\t\t\t\ta.wareid,\r\n\t\t\t\t\tc.productid,\r\n\t\t\t\t\tc.batchtext,\r\n\t\t\t\t\tc.quantity\r\n\t\t\t\tFROM ld_salesback a\r\n\t\t\t\tLEFT JOIN ld_salesbackdetail c ON c.id=a.salesbackid\r\n\t\t\t\tLEFT JOIN ld_products p ON p.productid=c.productid\r\n\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\tAND a.salesbackstatus<>'中止'\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{productname}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{productname}',p.productname)>0\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{productno}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{productno}',p.product_no)>0\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{productsheet}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{productsheet}',p.productsheet)>0\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{pici}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{pici}',c.batchtext)>0\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{warename}'='0' THEN 1=1\r\n\t\t\t\t\t\t\tELSE a.wareid='{warename}'\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{shenpi}'='1' THEN 1=1\r\n\t\t\t\t\t\t\tELSE a.approvestatus='已批准'\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\tUNION ALL\r\n\t\t\t\tSELECT\r\n\t\t\t\t\ta.wareid,\r\n\t\t\t\t\tc.productid,\r\n\t\t\t\t\tc.batchtext,\r\n\t\t\t\t\t0-c.quantity\r\n\t\t\t\tFROM ld_outboundorder a\r\n\t\t\t\tLEFT JOIN ld_outboundordercf b ON a.out_id=b.out_id\r\n\t\t\t\tLEFT JOIN ld_outboundorderdetail c ON c.id=a.out_id\r\n\t\t\t\tLEFT JOIN ld_outboundorderdetailscf d ON d.lineitem_id=c.lineitem_id\r\n\t\t\t\tLEFT JOIN ld_products p ON p.productid=c.productid\r\n\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{productname}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{productname}',p.productname)>0\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{productno}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{productno}',p.product_no)>0\r\n\t\t\t\t\t\tEND)\r\n\t\t\t\t\tAND (\r\n\t\t\t\t\t\tCASE\r\n\t\t\t\t\t\t\tWHEN '{productsheet}'='' THEN 1=1\r\n\t\t\t\t\t\t\tELSE LOCATE('{productsheet}',p.productsheet)>0\r