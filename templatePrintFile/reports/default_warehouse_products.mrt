            "Type": "System.String"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\ta.order_id,\r\n\ta.order_no,\r\n\ta.signed_data,\r\n\ta.sostatus,\r\n\ta.approvestatus,\r\n\tb.productid,\r\n\tSUM(b.balanceoutproductcount) AS qty_locked,\r\n\tFORMAT(SUM(b.balanceoutproductcount),(select deploy_value from ld_systems_deploy where deploy_type=49 limit 1)) AS qty_locked_show,\r\n\tc.last_name\r\nFROM (\r\n\tSELECT\r\n\t\ta.salesorderid AS order_id,\r\n\t\ta.salesorder_no AS order_no,\r\n\t\ta.signed_data,\r\n\t\ta.sostatus,\r\n\t\ta.approvestatus,\r\n\t\ta.smownerid\r\n\tFROM ld_salesorder a \r\n\tWHERE a.deleted=0 \r\n\t\tAND a.approvestatus<>'已拒绝' \r\n\t\tAND IFNULL(a.sostatus,'')<>'已作废'\r\n\tUNION ALL\r\n\tSELECT \r\n\t\ta.servicecontractsid,\r\n\t\ta.contract_no,\r\n\t\ta.due_date,\r\n\t\ta.contract_status,\r\n\t\ta.approvestatus,\r\n\t\ta.smownerid\r\n\tFROM ld_servicecontracts a \r\n\tWHERE a.deleted=0 \r\n\t\tAND a.approvestatus<>'已拒绝' \r\n\t\tAND IFNULL(a.contract_status,'')<>'已作废'\r\n) a\r\nLEFT JOIN (\r\n\tSELECT id,productid,balanceoutproductcount FROM ld_salesorderdetail\r\n\tUNION ALL\r\n\tSELECT id,productid,balanceoutproductcount FROM ld_servicecontractsdetail\r\n) b ON a.order_id=b.id\r\nLEFT JOIN ld_users c ON c.id=a.smownerid\r\nWHERE b.balanceoutproductcount>0\r\n\tAND b.productid='{this[\"id\"]}'\r\nGROUP BY a.order_id\r\nORDER BY a.signed_data,a.order_id"
      },
