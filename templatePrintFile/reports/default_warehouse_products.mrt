            "Index": -1,
            "NameInSource": "pname",
            "Alias": "pname",
            "Type": "System.String"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\t(SELECT \r\n\t\tb.fieldlabel\r\n\tFROM ld_field a\r\n\tLEFT JOIN ld_tranlabel b ON a.fieldid=b.Relateid AND b.trantable='ld_field' AND b.languagetype='zh'\r\n\tWHERE a.tabid=14 and columnname='productname' limit 1) AS productname,\r\n\t(SELECT \r\n\t\tb.fieldlabel\r\n\tFROM ld_field a\r\n\tLEFT JOIN ld_tranlabel b ON a.fieldid=b.Relateid AND b.trantable='ld_field' AND b.languagetype='zh'\r\n\tWHERE a.tabid=14 and columnname='product_no' limit 1) AS product_no,\r\n\t(SELECT \r\n\t\tb.fieldlabel\r\n\tFROM ld_field a\r\n\tLEFT JOIN ld_tranlabel b ON a.fieldid=b.Relateid AND b.trantable='ld_field' AND b.languagetype='zh'\r\n\tWHERE a.tabid=14 and columnname='productsheet' limit 1) AS productsheet,\r\n\t(SELECT \r\n\t\tCONCAT('创建',fieldlabel)\r\n\tFROM ld_tranlabel \r\n\tWHERE trantable='ld_tab' AND tabid=21 and Relateid=21 AND languagetype='zh' limit 1) AS anniu_name,\r\n\t(SELECT \r\n\t\tCONCAT('为安全库存差额小于0的产品创建',fieldlabel)\r\n\tFROM ld_tranlabel \r\n\tWHERE trantable='ld_tab' AND tabid=21 and Relateid=21 AND languagetype='zh' limit 1) AS anniu_tips,\r\n\t(SELECT productname FROM ld_products WHERE productid='{this[\"id\"]}' LIMIT 1) AS pname"
      },
      "1": {
