            "Index": -1,
            "NameInSource": "inventory_qty",
            "Alias": "inventory_qty",
            "Type": "System.Decimal"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\ta.wareid,\r\n\tw.name,\r\n\tp.productid,\r\n\tp.productname,\r\n\tp.product_no,\r\n\tp.productsheet,\r\n\tp.usageunit,\r\n\ta.batchtext,\r\n\tSUM(IFNULL(a.inventory_qty,0)) AS inventory_qty\r\nFROM ld_products p\r\nINNER JOIN (\r\n\tSELECT\r\n\t\ta.wareid,\r\n\t\ta.productid,\r\n\t\ta.batchtext,\r\n\t\tSUM(a.inventory_qty) AS inventory_qty\r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\ta.warehouseid AS wareid,\r\n\t\t\ta.productid,\r\n\t\t\ta.batchtext,\r\n\t\t\ta.lastqty AS inventory_qty\r\n\t\tFROM ld_warehousecondtions a\r\n\t\tLEFT JOIN ld_products c ON c.productid=a.productid\r\n\t\tWHERE a.modulename='库存初始化'\r\n\t\t\tAND a.type='确认初始库存'\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{productname}'='' THEN 1=1\r\n\t\t\t\t\tELSE LOCATE('{productname}',c.productname)>0\r\n\t\t\t\tEND)\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{pici}'='' THEN 1=1\r\n\t\t\t\t\tELSE LOCATE('{pici}',a.batchtext)>0\r\n\t\t\t\tEND)\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{warename}'='0' THEN 1=1\r\n\t\t\t\t\tELSE a.warehouseid='{warename}'\r\n\t\t\t\tEND)\r\n\t\tUNION ALL\r\n\t\tSELECT\r\n\t\t\ta.wareid,\r\n\t\t\tc.productid,\r\n\t\t\tc.batchtext,\r\n\t\t\tc.quantity\r\n\t\tFROM ld_stock a\r\n\t\tLEFT JOIN ld_stockdetail c ON c.id=a.stock_id\r\n\t\tLEFT JOIN ld_products p ON p.productid=c.productid\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{productname}'='' THEN 1=1\r\n\t\t\t\t\tELSE LOCATE('{productname}',p.productname)>0\r\n\t\t\t\tEND)\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{pici}'='' THEN 1=1\r\n\t\t\t\t\tELSE LOCATE('{pici}',c.batchtext)>0\r\n\t\t\t\tEND)\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{warename}'='0' THEN 1=1\r\n\t\t\t\t\tELSE a.wareid='{warename}'\r\n\t\t\t\tEND)\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{shenpi}'='1' THEN 1=1\r\n\t\t\t\t\tELSE a.approvestatus='已批准'\r\n\t\t\t\tEND)\r\n\t\tUNION ALL\r\n\t\tSELECT\r\n\t\t\ta.wareid,\r\n\t\t\tc.productid,\r\n\t\t\tc.batchtext,\r\n\t\t\tc.quantity\r\n\t\tFROM ld_salesback a\r\n\t\tLEFT JOIN ld_salesbackdetail c ON c.id=a.salesbackid\r\n\t\tLEFT JOIN ld_products p ON p.productid=c.productid\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.salesbackstatus<>'中止'\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{productname}'='' THEN 1=1\r\n\t\t\t\t\tELSE LOCATE('{productname}',p.productname)>0\r\n\t\t\t\tEND)\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{pici}'='' THEN 1=1\r\n\t\t\t\t\tELSE LOCATE('{pici}',c.batchtext)>0\r\n\t\t\t\tEND)\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{warename}'='0' THEN 1=1\r\n\t\t\t\t\tELSE a.wareid='{warename}'\r\n\t\t\t\tEND)\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{shenpi}'='1' THEN 1=1\r\n\t\t\t\t\tELSE a.approvestatus='已批准'\r\n\t\t\t\tEND)\r\n\t\tUNION ALL\r\n\t\tSELECT\r\n\t\t\tc.wareid,\r\n\t\t\tc.productid,\r\n\t\t\tc.batchtext,\r\n\t\t\t0-c.quantity\r\n\t\tFROM ld_outboundorder a\r\n\t\tLEFT JOIN ld_outboundordercf b ON a.out_id=b.out_id\r\n\t\tLEFT JOIN ld_outboundorderdetail c ON c.id=a.out_id\r\n\t\tLEFT JOIN ld_outboundorderdetailscf d ON d.lineitem_id=c.lineitem_id\r\n\t\tLEFT JOIN ld_products p ON p.productid=c.productid\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{productname}'='' THEN 1=1\r\n\t\t\t\t\tELSE LOCATE('{productname}',p.productname)>0\r\n\t\t\t\tEND)\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{pici}'='' THEN 1=1\r\n\t\t\t\t\tELSE LOCATE('{pici}',c.batchtext)>0\r\n\t\t\t\tEND)\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{warename}'='0' THEN 1=1\r\n\t\t\t\t\tELSE c.wareid='{warename}'\r\n\t\t\t\tEND)\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{shenpi}'='1' THEN 1=1\r\n\t\t\t\t\tELSE a.approvestatus='已批准'\r\n\t\t\t\tEND)\r\n\t\tUNION ALL\r\n\t\tSELECT\r\n\t\t\ta.wareid,\r\n\t\t\tc.productid,\r\n\t\t\tc.batchtext,\r\n\t\t\t0-c.quantity\r\n\t\tFROM ld_purchaseback a\r\n\t\tLEFT JOIN ld_purchasebackdetail c ON c.id=a.purchasebackid\r\n\t\tLEFT JOIN ld_products p ON p.productid=c.productid\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.purchasebackstatus<>'中止'\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{productname}'='' THEN 1=1\r\n\t\t\t\t\tELSE LOCATE('{productname}',p.productname)>0\r\n\t\t\t\tEND)\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{pici}'='' THEN 1=1\r\n\t\t\t\t\tELSE LOCATE('{pici}',c.batchtext)>0\r\n\t\t\t\tEND)\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{warename}'='0' THEN 1=1\r\n\t\t\t\t\tELSE a.wareid='{warename}'\r\n\t\t\t\tEND)\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{shenpi}'='1' THEN 1=1\r\n\t\t\t\t\tELSE a.purchasebackstatus='结束'\r\n\t\t\t\tEND)\r\n\t\tUNION ALL\r\n\t\tSELECT\r\n\t\t\ta.inwarehouse,\r\n\t\t\tc.productid,\r\n\t\t\tc.batchtext,\r\n\t\t\tc.quantity\r\n\t\tFROM ld_warehousetransfer a\r\n\t\tLEFT JOIN ld_warehousetransferdetail c ON c.id=a.warehousetransferid\r\n\t\tLEFT JOIN ld_products p ON p.productid=c.productid\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{productname}'='' THEN 1=1\r\n\t\t\t\t\tELSE LOCATE('{productname}',p.productname)>0\r\n\t\t\t\tEND)\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{pici}'='' THEN 1=1\r\n\t\t\t\t\tELSE LOCATE('{pici}',c.batchtext)>0\r\n\t\t\t\tEND)\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{warename}'='0' THEN 1=1\r\n\t\t\t\t\tELSE a.inwarehouse='{warename}'\r\n\t\t\t\tEND)\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{shenpi}'='1' THEN 1=1\r\n\t\t\t\t\tELSE a.transferstatus='已审核'\r\n\t\t\t\tEND)\r\n\t\tUNION ALL\r\n\t\tSELECT\r\n\t\t\ta.outwarehouse,\r\n\t\t\tc.productid,\r\n\t\t\tc.batchtext,\r\n\t\t\t0-c.quantity\r\n\t\tFROM ld_warehousetransfer a\r\n\t\tLEFT JOIN ld_warehousetransferdetail c ON c.id=a.warehousetransferid\r\n\t\tLEFT JOIN ld_products p ON p.productid=c.productid\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{productname}'='' THEN 1=1\r\n\t\t\t\t\tELSE LOCATE('{productname}',p.productname)>0\r\n\t\t\t\tEND)\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{pici}'='' THEN 1=1\r\n\t\t\t\t\tELSE LOCATE('{pici}',c.batchtext)>0\r\n\t\t\t\tEND)\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{warename}'='0' THEN 1=1\r\n\t\t\t\t\tELSE a.outwarehouse='{warename}'\r\n\t\t\t\tEND)\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{shenpi}'='1' THEN 1=1\r\n\t\t\t\t\tELSE a.transferstatus='已审核'\r\n\t\t\t\tEND)\r\n\t\tUNION ALL\r\n\t\tSELECT\r\n\t\t\ta.wareid,\r\n\t\t\tc.productid,\r\n\t\t\tc.batchtext,\r\n\t\t\tc.profitloss\r\n\t\tFROM ld_checks a\r\n\t\tLEFT JOIN ld_checksdetail c ON c.id=a.id\r\n\t\tLEFT JOIN ld_products p ON p.productid=c.productid\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{productname}'='' THEN 1=1\r\n\t\t\t\t\tELSE LOCATE('{productname}',p.productname)>0\r\n\t\t\t\tEND)\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{pici}'='' THEN 1=1\r\n\t\t\t\t\tELSE LOCATE('{pici}',c.batchtext)>0\r\n\t\t\t\tEND)\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{warename}'='0' THEN 1=1\r\n\t\t\t\t\tELSE a.wareid='{warename}'\r\n\t\t\t\tEND)\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{shenpi}'='1' THEN 1=1\r\n\t\t\t\t\tELSE a.presence='盘点结束'\r\n\t\t\t\tEND)\r\n\t) a\r\n\tWHERE a.productid>0\r\n\tGROUP BY a.wareid,a.productid,IFNULL(a.batchtext,'')\r\n) a ON p.productid=a.productid\r\nLEFT JOIN ld_warehouse w ON w.id=a.wareid\r\nWHERE p.productid='{this[\"id\"]}'\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{qty_range}'='true' THEN inventory_qty>0\r\n\t\t\t\tELSE 1=1\r\n\t\t\tEND)\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{this[\"issubtotal\"]}'=0 THEN IFNULL(a.batchtext,'')='{this[\"picihao\"]}'\r\n\t\t\tELSE 1=1\r\n\t\tEND)\r\nGROUP BY a.wareid,IFNULL(a.batchtext,'')\r\nORDER BY w.id,batchtext"
      },
      "5": {
        "Ident": "StiMySqlSource",
        "Name": "purchase_data",
        "Alias": "purchase_data",
        "Columns": {
          "0": {
            "Name": "json_products",
            "Index": -1,
            "NameInSource": "json_products",
            "Alias": "json_products",
            "Type": "System.String"
          }
        },
        "NameInSource": "ldcrm",
        "SqlCommand": "SELECT\r\n\tCONCAT('[',GROUP_CONCAT(CONCAT(s1,'\"productid\":',productid,',\"quantity\":',REPLACE(cha_qty_show,',',''),s2)),']') AS json_products\r\nFROM (\r\n\tSELECT\r\n\t\tp.productid,\r\n\t\t(select symbol from tmp_symbol where id=1) AS s1,\r\n\t\t(select symbol from tmp_symbol where id=2) AS s2,\r\n\t\tIFNULL(a.inventory_qty,0) AS inventory_qty,\r\n\t\tIFNULL(a.inventory_qty,0)-IFNULL(b.qty_locked,0)+IFNULL(c.qty_way,0)-IFNULL(p.qtyearly,0) AS cha_qty,\r\n\t\tFORMAT(ABS(IFNULL(a.inventory_qty,0)-IFNULL(b.qty_locked,0)+IFNULL(c.qty_way,0)-IFNULL(p.qtyearly,0)),(SELECT deploy_value FROM ld_systems_deploy WHERE deploy_type=49 LIMIT 1)) AS cha_qty_show\r\n\tFROM ld_products p\r\n\tINNER JOIN (\r\n\t\tSELECT\r\n\t\t\ta.productid,\r\n\t\t\ta.batchtext,\r\n\t\t\tSUM(a.inventory_qty) AS inventory_qty\r\n\t\tFROM (\r\n\t\t\tSELECT\r\n\t\t\t\ta.warehouseid AS wareid,\r\n\t\t\t\ta.productid,\r\n\t\t\t\ta.batchtext,\r\n\t\t\t\ta.lastqty AS inventory_qty\r\n\t\t\tFROM ld_warehousecondtions a\r\n\t\t\tLEFT JOIN ld_products c ON c.productid=a.productid\r\n\t\t\tWHERE a.modulename='库存初始化'\r\n\t\t\t\tAND a.type='确认初始库存'\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{productname}'='' THEN 1=1\r\n\t\t\t\t\t\tELSE LOCATE('{productname}',c.productname)>0\r\n\t\t\t\t\tEND)\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{pici}'='' THEN 1=1\r\n\t\t\t\t\t\tELSE LOCATE('{pici}',a.batchtext)>0\r\n\t\t\t\t\tEND)\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{warename}'='0' THEN 1=1\r\n\t\t\t\t\t\tELSE a.warehouseid='{warename}'\r\n\t\t\t\t\tEND)\r\n\t\t\tUNION ALL\r\n\t\t\tSELECT\r\n\t\t\t\ta.wareid,\r\n\t\t\t\tc.productid,\r\n\t\t\t\tc.batchtext,\r\n\t\t\t\tc.quantity\r\n\t\t\tFROM ld_stock a\r\n\t\t\tLEFT JOIN ld_stockdetail c ON c.id=a.stock_id\r\n\t\t\tLEFT JOIN ld_products p ON p.productid=c.productid\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{productname}'='' THEN 1=1\r\n\t\t\t\t\t\tELSE LOCATE('{productname}',p.productname)>0\r\n\t\t\t\t\tEND)\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{pici}'='' THEN 1=1\r\n\t\t\t\t\t\tELSE LOCATE('{pici}',c.batchtext)>0\r\n\t\t\t\t\tEND)\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{warename}'='0' THEN 1=1\r\n\t\t\t\t\t\tELSE a.wareid='{warename}'\r\n\t\t\t\t\tEND)\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{shenpi}'='1' THEN 1=1\r\n\t\t\t\t\t\tELSE a.approvestatus='已批准'\r\n\t\t\t\t\tEND)\r\n\t\t\tUNION ALL\r\n\t\t\tSELECT\r\n\t\t\t\ta.wareid,\r\n\t\t\t\tc.productid,\r\n\t\t\t\tc.batchtext,\r\n\t\t\t\tc.quantity\r\n\t\t\tFROM ld_salesback a\r\n\t\t\tLEFT JOIN ld_salesbackdetail c ON c.id=a.salesbackid\r\n\t\t\tLEFT JOIN ld_products p ON p.productid=c.productid\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.salesbackstatus<>'中止'\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{productname}'='' THEN 1=1\r\n\t\t\t\t\t\tELSE LOCATE('{productname}',p.productname)>0\r\n\t\t\t\t\tEND)\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{pici}'='' THEN 1=1\r\n\t\t\t\t\t\tELSE LOCATE('{pici}',c.batchtext)>0\r\n\t\t\t\t\tEND)\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{warename}'='0' THEN 1=1\r\n\t\t\t\t\t\tELSE a.wareid='{warename}'\r\n\t\t\t\t\tEND)\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{shenpi}'='1' THEN 1=1\r\n\t\t\t\t\t\tELSE a.approvestatus='已批准'\r\n\t\t\t\t\tEND)\r\n\t\t\tUNION ALL\r\n\t\t\tSELECT\r\n\t\t\t\tc.wareid,\r\n\t\t\t\tc.productid,\r\n\t\t\t\tc.batchtext,\r\n\t\t\t\t0-c.quantity\r\n\t\t\tFROM ld_outboundorder a\r\n\t\t\tLEFT JOIN ld_outboundordercf b ON a.out_id=b.out_id\r\n\t\t\tLEFT JOIN ld_outboundorderdetail c ON c.id=a.out_id\r\n\t\t\tLEFT JOIN ld_outboundorderdetailscf d ON d.lineitem_id=c.lineitem_id\r\n\t\t\tLEFT JOIN ld_products p ON p.productid=c.productid\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{productname}'='' THEN 1=1\r\n\t\t\t\t\t\tELSE LOCATE('{productname}',p.productname)>0\r\n\t\t\t\t\tEND)\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{pici}'='' THEN 1=1\r\n\t\t\t\t\t\tELSE LOCATE('{pici}',c.batchtext)>0\r\n\t\t\t\t\tEND)\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{warename}'='0' THEN 1=1\r\n\t\t\t\t\t\tELSE c.wareid='{warename}'\r\n\t\t\t\t\tEND)\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{shenpi}'='1' THEN 1=1\r\n\t\t\t\t\t\tELSE a.approvestatus='已批准'\r\n\t\t\t\t\tEND)\r\n\t\t\tUNION ALL\r\n\t\t\tSELECT\r\n\t\t\t\ta.wareid,\r\n\t\t\t\tc.productid,\r\n\t\t\t\tc.batchtext,\r\n\t\t\t\t0-c.quantity\r\n\t\t\tFROM ld_purchaseback a\r\n\t\t\tLEFT JOIN ld_purchasebackdetail c ON c.id=a.purchasebackid\r\n\t\t\tLEFT JOIN ld_products p ON p.productid=c.productid\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND a.purchasebackstatus<>'中止'\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{productname}'='' THEN 1=1\r\n\t\t\t\t\t\tELSE LOCATE('{productname}',p.productname)>0\r\n\t\t\t\t\tEND)\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{pici}'='' THEN 1=1\r\n\t\t\t\t\t\tELSE LOCATE('{pici}',c.batchtext)>0\r\n\t\t\t\t\tEND)\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{warename}'='0' THEN 1=1\r\n\t\t\t\t\t\tELSE a.wareid='{warename}'\r\n\t\t\t\t\tEND)\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{shenpi}'='1' THEN 1=1\r\n\t\t\t\t\t\tELSE a.purchasebackstatus='结束'\r\n\t\t\t\t\tEND)\r\n\t\t\tUNION ALL\r\n\t\t\tSELECT\r\n\t\t\t\ta.inwarehouse,\r\n\t\t\t\tc.productid,\r\n\t\t\t\tc.batchtext,\r\n\t\t\t\tc.quantity\r\n\t\t\tFROM ld_warehousetransfer a\r\n\t\t\tLEFT JOIN ld_warehousetransferdetail c ON c.id=a.warehousetransferid\r\n\t\t\tLEFT JOIN ld_products p ON p.productid=c.productid\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{productname}'='' THEN 1=1\r\n\t\t\t\t\t\tELSE LOCATE('{productname}',p.productname)>0\r\n\t\t\t\t\tEND)\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{pici}'='' THEN 1=1\r\n\t\t\t\t\t\tELSE LOCATE('{pici}',c.batchtext)>0\r\n\t\t\t\t\tEND)\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{warename}'='0' THEN 1=1\r\n\t\t\t\t\t\tELSE a.inwarehouse='{warename}'\r\n\t\t\t\t\tEND)\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{shenpi}'='1' THEN 1=1\r\n\t\t\t\t\t\tELSE a.transferstatus='已审核'\r\n\t\t\t\t\tEND)\r\n\t\t\tUNION ALL\r\n\t\t\tSELECT\r\n\t\t\t\ta.outwarehouse,\r\n\t\t\t\tc.productid,\r\n\t\t\t\tc.batchtext,\r\n\t\t\t\t0-c.quantity\r\n\t\t\tFROM ld_warehousetransfer a\r\n\t\t\tLEFT JOIN ld_warehousetransferdetail c ON c.id=a.warehousetransferid\r\n\t\t\tLEFT JOIN ld_products p ON p.productid=c.productid\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{productname}'='' THEN 1=1\r\n\t\t\t\t\t\tELSE LOCATE('{productname}',p.productname)>0\r\n\t\t\t\t\tEND)\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{pici}'='' THEN 1=1\r\n\t\t\t\t\t\tELSE LOCATE('{pici}',c.batchtext)>0\r\n\t\t\t\t\tEND)\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{warename}'='0' THEN 1=1\r\n\t\t\t\t\t\tELSE a.outwarehouse='{warename}'\r\n\t\t\t\t\tEND)\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{shenpi}'='1' THEN 1=1\r\n\t\t\t\t\t\tELSE a.transferstatus='已审核'\r\n\t\t\t\t\tEND)\r\n\t\t\tUNION ALL\r\n\t\t\tSELECT\r\n\t\t\t\ta.wareid,\r\n\t\t\t\tc.productid,\r\n\t\t\t\tc.batchtext,\r\n\t\t\t\tc.profitloss\r\n\t\t\tFROM ld_checks a\r\n\t\t\tLEFT JOIN ld_checksdetail c ON c.id=a.id\r\n\t\t\tLEFT JOIN ld_products p ON p.productid=c.productid\r\n\t\t\tWHERE a.deleted=0\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{productname}'='' THEN 1=1\r\n\t\t\t\t\t\tELSE LOCATE('{productname}',p.productname)>0\r\n\t\t\t\t\tEND)\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{pici}'='' THEN 1=1\r\n\t\t\t\t\t\tELSE LOCATE('{pici}',c.batchtext)>0\r\n\t\t\t\t\tEND)\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{warename}'='0' THEN 1=1\r\n\t\t\t\t\t\tELSE a.wareid='{warename}'\r\n\t\t\t\t\tEND)\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{shenpi}'='1' THEN 1=1\r\n\t\t\t\t\t\tELSE a.presence='盘点结束'\r\n\t\t\t\t\tEND)\r\n\t\t) a\r\n\t\tWHERE a.productid>0\r\n\t\tGROUP BY a.productid\r\n\t) a ON p.productid=a.productid\r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\tb.productid,\r\n\t\t\tSUM(b.balanceoutproductcount) AS qty_locked\r\n\t\tFROM (\r\n\t\t\tSELECT \r\n\t\t\t\ta.salesorderid AS order_id\r\n\t\t\tFROM ld_salesorder a \r\n\t\t\tWHERE a.deleted=0 \r\n\t\t\t\tAND a.approvestatus<>'已拒绝' \r\n\t\t\t\tAND IFNULL(a.sostatus,'')<>'已作废'\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{shenpi}'='1' THEN 1=1\r\n\t\t\t\t\t\tELSE a.approvestatus='已批准'\r\n\t\t\t\t\tEND)\r\n\t\t\tUNION ALL\r\n\t\t\tSELECT \r\n\t\t\t\ta.servicecontractsid\r\n\t\t\tFROM ld_servicecontracts a \r\n\t\t\tWHERE a.deleted=0 \r\n\t\t\t\tAND a.approvestatus<>'已拒绝' \r\n\t\t\t\tAND IFNULL(a.contract_status,'')<>'已作废'\r\n\t\t\t\tAND (\r\n\t\t\t\t\tCASE\r\n\t\t\t\t\t\tWHEN '{shenpi}'='1' THEN 1=1\r\n\t\t\t\t\t\tELSE a.approvestatus='已批准'\r\n\t\t\t\t\tEND)\r\n\t\t) a\r\n\t\tLEFT JOIN (\r\n\t\t\tSELECT id,productid,balanceoutproductcount FROM ld_salesorderdetail\r\n\t\t\tUNION ALL\r\n\t\t\tSELECT id,productid,balanceoutproductcount FROM ld_servicecontractsdetail\r\n\t\t) b ON a.order_id=b.id\r\n\t\tWHERE b.balanceoutproductcount>0\r\n\t\tGROUP BY b.productid\r\n\t) b ON a.productid=b.productid\r\n\tLEFT JOIN (\r\n\t\tSELECT\r\n\t\t\tb.productid,\r\n\t\t\tSUM(b.balancepurchasecount) AS qty_way\r\n\t\tFROM ld_purchaseorder a\r\n\t\tLEFT JOIN ld_purchaseorderdetail b ON a.purchaseorderid=b.id\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\tAND IFNULL(a.postatus,'')<>'已作废'\r\n\t\t\tAND b.balancepurchasecount>0\r\n\t\t\tAND (\r\n\t\t\t\tCASE\r\n\t\t\t\t\tWHEN '{shenpi}'='1' THEN 1=1\r\n\t\t\t\t\tELSE a.approvestatus='已批准'\r\n\t\t\t\tEND)\r\n\t\tGROUP BY b.productid\r\n\t) c ON c.productid=a.productid\r\n) tmp\r\nWHERE (\r\n\t\tCASE\r\n\t\t\tWHEN '{qty_range}'='true' THEN inventory_qty>0\r\n\t\t\tELSE 1=1\r\n\t\tEND)\r\n\tAND cha_qty<0"
      },
