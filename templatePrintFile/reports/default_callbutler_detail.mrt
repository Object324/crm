        "NameInSource": "crm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\t*\r\nFROM (\r\n\tSELECT\r\n\t\tj.last_name,\r\n\t\ta.begintime AS Starttime, \r\n\t\ta.id AS indexid, \r\n\t\tb.accountname, b.lastservicedate,\r\n\t\tc.lastname AS lxr_name, \r\n\t\td.contactrecord_no AS contactrecord_no, \r\n\t\te.ticket_no, \r\n\t\tf.vendorname, \r\n\t\tg.Lastname AS vendor_lastname, \r\n\t\th.contactrecord_no AS vendor_subject,\r\n\t\ti.potential_no,\r\n\t\ta.calltype,\r\n\t\ta.phone AS callnum,\r\n\t\ta.time AS Talktime,\r\n\t\tREPLACE(soundrecordingfile,'；','%EF%BC%9B') as mp3path\r\n\tFROM ld_callbutler a \r\n\tLEFT JOIN ld_account b ON b.accountid=a.accountid AND b.deleted=0\r\n\tLEFT JOIN ld_contactdetails c ON c.contactid=a.contactid  AND c.deleted=0\r\n\tLEFT JOIN ld_contactrecords d ON d.contactrecordID=a.contactrecordsid  AND d.deleted=0\r\n\tLEFT JOIN ld_troubletickets e ON e.ticketid=a.ticketid  AND e.deleted=0\r\n\tLEFT JOIN ld_vendor f ON f.vendorid=a.vendorid  AND f.deleted=0\r\n\tLEFT JOIN ld_vendorcontacts g ON g.vendorcontactsid=a.vendorcontactid  AND g.deleted=0\r\n\tLEFT JOIN ld_vendorcontactrecords h ON h.contactRecordsid=a.vendorcontactrecordsid AND h.deleted=0\r\n\tLEFT JOIN ld_potential i ON i.potentialid=a.potentialid\r\n\tLEFT JOIN ld_users j on j.id=a.userid\r\n\tWHERE 1=1\r\n\t\tANd a.begintime>=concat(DATE_FORMAT('{begindate}','%Y-%m-%d'),' ','00:00:00') AND a.endtime<=concat(DATE_FORMAT('{enddate}','%Y-%m-%d'),' ','23:59:59')\r\n\t\tAND (\r\n\t\t\tCASE \r\n\t\t\t\tWHEN '{calltype}'='全部' THEN 1=1\r\n\t\t\t\tELSE a.calltype='{calltype}'\r\n\t\t\tEND)\r\n\t\tAND (\r\n\t\t\tCASE \r\n\t\t\t\tWHEN '{iszero}'='false' THEN IFNULL(a.time, 0)>0 \r\n\t\t\t\tELSE 1=1\r\n\t\t\tEND)\r\n\t\tAND (\r\n\t\t\tCASE \r\n\t\t\t\tWHEN '{calltime_from}'='' THEN 1=1\r\n\t\t\t\tELSE a.time>='{calltime_from}'\r\n\t\t\tEND)\r\n\t\tAND (\r\n\t\t\tCASE \r\n\t\t\t\tWHEN '{calltime_to}'='' THEN 1=1\r\n\t\t\t\tELSE a.time<='{calltime_to}'\r\n\t\t\tEND)\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{userid}'='' THEN \r\n\t\t\t\t\tFIND_IN_SET(a.userid,(\r\n\t\t\t\t\t\tSELECT\r\n\t\t\t\t\t\t\tGROUP_CONCAT(userid)\r\n\t\t\t\t\t\tFROM (\r\n\t\t\t\t\t\t\tSELECT DISTINCT\r\n\t\t\t\t\t\t\t\tuserid \r\n\t\t\t\t\t\t\tFROM (\r\n\t\t\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\t\t\tld_users.id as userid \r\n\t\t\t\t\t\t\t\tFROM ld_users\r\n\t\t\t\t\t\t\t\tWHERE EXISTS(select 1 from ld_setscoperhigher where modulename='ReportAnalysis' and scopeauthority=1 and userid='[uuid]')\r\n\t\t\t\t\t\t\t\tUNION\r\n\t\t\t\t\t\t\t\tselect \r\n\t\t\t\t\t\t\t\t\tviewid as userid \r\n\t\t\t\t\t\t\t\tfrom ld_scoperhigher\r\n\t\t\t\t\t\t\t\twhere userid='[uuid]' and modulename='ReportAnalysis' and EXISTS(select 1 from ld_setscoperhigher where userid='[uuid]' and scopeauthority=2 and modulename='ReportAnalysis')\t\t\t\r\n\t\t\t\t\t\t\t\tUNION\r\n\t\t\t\t\t\t\t\tselect DISTINCT \r\n\t\t\t\t\t\t\t\t\tld_users2group.userid as userid \r\n\t\t\t\t\t\t\t\tfrom ld_scoperhigher \r\n\t\t\t\t\t\t\t\tINNER JOIN ld_groups on ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\t\t\t\t\t\t\tINNER JOIN ld_users2group on ld_users2group.groupid=ld_groups.groupid\r\n\t\t\t\t\t\t\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\t\t\t\t\t\t\tand ld_scoperhigher.modulename='ReportAnalysis'\r\n\t\t\t\t\t\t\t\t\tand ld_scoperhigher.scopeauthority=3 \r\n\t\t\t\t\t\t\t\t\tand EXISTS(select 1 from ld_setscoperhigher where modulename='ReportAnalysis' and scopeauthority=3 and userid='[uuid]')\r\n\t\t\t\t\t\t\t\tUNION \r\n\t\t\t\t\t\t\t\tselect \r\n\t\t\t\t\t\t\t\t\tid as userid \r\n\t\t\t\t\t\t\t\tfrom ld_users  \r\n\t\t\t\t\t\t\t\twhere exists(select 1 from ld_users where id='[uuid]' and is_admin='on')\r\n\t\t\t\t\t\t\t\tUNION\r\n\t\t\t\t\t\t\t\tselect '[uuid]')as vw_users\r\n\t\t\t\t\t\t) as tmp_users)) OR a.userid IS NULL\r\n\t\t\t\tELSE FIND_IN_SET(a.userid,'{userid}') OR a.userid IS NULL\r\n\t\t\tEND)\r\n) t\r\nWHERE 1=1\r\nAND \r\n(\r\n\t\tCASE \r\n\t\t\tWHEN '{telnum}'='' THEN 1=1\r\n\t\t\tELSE callnum like '%{telnum}%'\r\n\tEND)\r\nAND \r\n(\r\n\t\tCASE \r\n\t\t\tWHEN '{AcountName}'='' THEN 1=1\r\n\t\t\tELSE accountname like '%{AcountName}%'\r\n\tEND)\r\nORDER BY CONVERT(last_name USING GBK),Starttime"
      },
