            "Type": "System.String"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\t(SELECT \r\n\t\tb.fieldlabel \r\n\tFROM ld_tab a \r\n\tLEFT JOIN ld_tranlabel b ON b.Relateid=a.tabid AND b.trantable='ld_tab' AND languagetype='zh' \r\n\tWHERE a.tabid =6 \r\n\tLIMIT 1) AS lab01_kh,\r\n\t(SELECT \r\n\t\tb.fieldlabel \r\n\tFROM ld_field a \r\n\tLEFT JOIN ld_tranlabel b ON b.Relateid=a.fieldid AND b.trantable='ld_field' AND languagetype='zh' \r\n\tWHERE a.tabid =6 and columnname=\"lastservicedate\"\r\n\tlimit 1)as lastservicedate,\r\n        (SELECT \r\n\t\tb.fieldlabel \r\n\tFROM ld_tab a \r\n\tLEFT JOIN ld_tranlabel b ON b.Relateid=a.tabid AND b.trantable='ld_tab' AND languagetype='zh' \r\n\tWHERE a.tabid =4 \r\n\tLIMIT 1) AS lab02_lxr,\r\n\t(SELECT \r\n\t\tb.fieldlabel \r\n\tFROM ld_tab a \r\n\tLEFT JOIN ld_tranlabel b ON b.Relateid=a.tabid AND b.trantable='ld_tab' AND languagetype='zh' \r\n\tWHERE a.tabid =2 \r\n\tLIMIT 1) AS lab03_jh,\r\n\t(SELECT \r\n\t\tb.fieldlabel \r\n\tFROM ld_tab a \r\n\tLEFT JOIN ld_tranlabel b ON b.Relateid=a.tabid AND b.trantable='ld_tab' AND languagetype='zh' \r\n\tWHERE a.tabid =18 \r\n\tLIMIT 1) AS lab04_gys,\r\n\t(SELECT \r\n\t\tb.fieldlabel \r\n\tFROM ld_tab a \r\n\tLEFT JOIN ld_tranlabel b ON b.Relateid=a.tabid AND b.trantable='ld_tab' AND languagetype='zh' \r\n\tWHERE a.`name` ='VendorContact' \r\n\tLIMIT 1) AS lab05_gyslxr,\r\n\t(SELECT \r\n\t\tb.fieldlabel \r\n\tFROM ld_tab a \r\n\tLEFT JOIN ld_tranlabel b ON b.Relateid=a.tabid AND b.trantable='ld_tab' AND languagetype='zh' \r\n\tWHERE a.`name` ='VendorContactRecords' \r\n\tLIMIT 1) AS lab06_gyslxjl,\r\n\t(SELECT \r\n\t\tb.fieldlabel \r\n\tFROM ld_tab a \r\n\tLEFT JOIN ld_tranlabel b ON b.Relateid=a.tabid AND b.trantable='ld_tab' AND languagetype='zh' \r\n\tWHERE a.`name` ='ContactRecords' \r\n\tLIMIT 1) AS lab07_lxjl,\r\n\t(SELECT \r\n\t\tb.fieldlabel \r\n\tFROM ld_tab a \r\n\tLEFT JOIN ld_tranlabel b ON b.Relateid=a.tabid AND b.trantable='ld_tab' AND languagetype='zh' \r\n\tWHERE a.tabid =13 \r\n\tLIMIT 1) AS lab08_fud\r\n"
      }
    },
