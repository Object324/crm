        "Columns": {
          "0": {
            "Name": "LAB1",
            "Index": -1,
            "NameInSource": "LAB1",
            "Alias": "LAB1",
            "Type": "System.String"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\tCASE\r\n\t\tWHEN '{smowner}'='' THEN\r\n\t\t\t(\r\n\t\t\t\tSELECT\r\n\t\t\t\t\tb.last_name\r\n\t\t\t\tFROM (\r\n\t\t\t\t\tSELECT\r\n\t\t\t\t\t\ta.smownerid\r\n\t\t\t\t\tFROM ld_contactrecords a\r\n\t\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\t\tGROUP BY a.smownerid\r\n\t\t\t\t) a\r\n\t\t\t\tLEFT JOIN ld_users b ON a.smownerid=b.id\r\n\t\t\t\tORDER BY CONVERT(b.last_name USING GBK) LIMIT 1\r\n\t\t\t)\r\n\t\tELSE (SELECT last_name FROM ld_users WHERE id='{smowner}')\r\n\tEND AS LAB1"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "list_users",
        "Alias": "list_users",
        "Columns": {
          "0": {
            "Name": "listid",
            "Index": -1,
            "NameInSource": "listid",
            "Alias": "listid",
            "Type": "System.Int32"
          },
          "1": {
            "Name": "listvalue",
            "Index": -1,
            "NameInSource": "listvalue",
            "Alias": "listvalue",
            "Type": "System.String"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\ta.smownerid AS listid,\r\n\tb.last_name AS listvalue\r\nFROM (\r\n\tSELECT\r\n\t\ta.smownerid\r\n\tFROM ld_contactrecords a\r\n\tWHERE a.deleted=0\r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\tGROUP BY a.smownerid\r\n) a\r\nLEFT JOIN ld_users b ON a.smownerid=b.id\r\nORDER BY CONVERT(b.last_name USING GBK)"
      },
      "2": {
        "Ident": "StiMySqlSource",
        "Name": "t",
        "Alias": "t",
        "Columns": {
          "0": {
            "Name": "argument",
            "Index": -1,
            "NameInSource": "argument",
            "Alias": "argument",
            "Type": "System.String"
          },
          "1": {
            "Name": "last_name",
            "Index": -1,
            "NameInSource": "last_name",
            "Alias": "last_name",
            "Type": "System.String"
          },
          "2": {
            "Name": "qty",
            "Index": -1,
            "NameInSource": "qty",
            "Alias": "qty",
            "Type": "System.Int32"
          },
          "3": {
            "Name": "qty_rate",
            "Index": -1,
            "NameInSource": "qty_rate",
            "Alias": "qty_rate",
            "Type": "System.String"
          }
        },
        "NameInSource": "crm",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\t(SELECT last_name FROM ld_users WHERE id='{smowner}') AS last_name,\r\n\targument,\r\n\tqty AS qty,\r\n\tROUND(qty*100/b.total) AS qty_rate\r\nFROM (\r\n\tSELECT\r\n\t\t'主动开发型' AS argument,\r\n\t\tCOUNT(b.contactrecordid) AS qty\r\n\tFROM ld_contactrecords a \r\n\tLEFT JOIN ld_contactrecordscf b ON b.contactrecordid=a.contactrecordID \r\n\tWHERE a.deleted=0 \r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND a.contactdate BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\t\tAND a.follow_type='主动开发型'\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{smowner}'='' THEN\r\n\t\t\t\t\ta.smownerid=(\r\n\t\t\t\t\t\tSELECT\r\n\t\t\t\t\t\t\ta.smownerid\r\n\t\t\t\t\t\tFROM (\r\n\t\t\t\t\t\t\tSELECT\r\n\t\t\t\t\t\t\t\ta.smownerid\r\n\t\t\t\t\t\t\tFROM ld_contactrecords a\r\n\t\t\t\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\t\t\t\tGROUP BY a.smownerid\r\n\t\t\t\t\t\t) a\r\n\t\t\t\t\t\tLEFT JOIN ld_users b ON a.smownerid=b.id\r\n\t\t\t\t\t\tORDER BY CONVERT(b.last_name USING GBK) LIMIT 1\r\n\t\t\t\t\t)\r\n\t\t\t\tELSE a.smownerid='{smowner}'\r\n\t\t\tEND)\r\n\tUNION ALL\r\n\tSELECT\r\n\t\t'被动开发型' AS argument,\r\n\t\tCOUNT(b.contactrecordid) AS qty\r\n\tFROM ld_contactrecords a \r\n\tLEFT JOIN ld_contactrecordscf b ON b.contactrecordid=a.contactrecordID \r\n\tWHERE a.deleted=0 \r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND a.contactdate BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\t\tAND a.follow_type='被动开发型'\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{smowner}'='' THEN\r\n\t\t\t\t\ta.smownerid=(\r\n\t\t\t\t\t\tSELECT\r\n\t\t\t\t\t\t\ta.smownerid\r\n\t\t\t\t\t\tFROM (\r\n\t\t\t\t\t\t\tSELECT\r\n\t\t\t\t\t\t\t\ta.smownerid\r\n\t\t\t\t\t\t\tFROM ld_contactrecords a\r\n\t\t\t\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\t\t\t\tGROUP BY a.smownerid\r\n\t\t\t\t\t\t) a\r\n\t\t\t\t\t\tLEFT JOIN ld_users b ON a.smownerid=b.id\r\n\t\t\t\t\t\tORDER BY CONVERT(b.last_name USING GBK) LIMIT 1\r\n\t\t\t\t\t)\r\n\t\t\t\tELSE a.smownerid='{smowner}'\r\n\t\t\tEND)\r\n\tUNION ALL\r\n\tSELECT\r\n\t\t'主动事务型' AS argument,\r\n\t\tCOUNT(b.contactrecordid) AS qty\r\n\tFROM ld_contactrecords a \r\n\tLEFT JOIN ld_contactrecordscf b ON b.contactrecordid=a.contactrecordID \r\n\tWHERE a.deleted=0 \r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND a.contactdate BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\t\tAND a.follow_type='主动事务型'\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{smowner}'='' THEN\r\n\t\t\t\t\ta.smownerid=(\r\n\t\t\t\t\t\tSELECT\r\n\t\t\t\t\t\t\ta.smownerid\r\n\t\t\t\t\t\tFROM (\r\n\t\t\t\t\t\t\tSELECT\r\n\t\t\t\t\t\t\t\ta.smownerid\r\n\t\t\t\t\t\t\tFROM ld_contactrecords a\r\n\t\t\t\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\t\t\t\tGROUP BY a.smownerid\r\n\t\t\t\t\t\t) a\r\n\t\t\t\t\t\tLEFT JOIN ld_users b ON a.smownerid=b.id\r\n\t\t\t\t\t\tORDER BY CONVERT(b.last_name USING GBK) LIMIT 1\r\n\t\t\t\t\t)\r\n\t\t\t\tELSE a.smownerid='{smowner}'\r\n\t\t\tEND)\r\n\tUNION ALL\r\n\tSELECT\r\n\t\t'被动事务型' AS argument,\r\n\t\tCOUNT(b.contactrecordid) AS qty\r\n\tFROM ld_contactrecords a \r\n\tLEFT JOIN ld_contactrecordscf b ON b.contactrecordid=a.contactrecordID \r\n\tWHERE a.deleted=0 \r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND a.contactdate BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\t\tAND a.follow_type='被动事务型'\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{smowner}'='' THEN\r\n\t\t\t\t\ta.smownerid=(\r\n\t\t\t\t\t\tSELECT\r\n\t\t\t\t\t\t\ta.smownerid\r\n\t\t\t\t\t\tFROM (\r\n\t\t\t\t\t\t\tSELECT\r\n\t\t\t\t\t\t\t\ta.smownerid\r\n\t\t\t\t\t\t\tFROM ld_contactrecords a\r\n\t\t\t\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\t\t\t\tGROUP BY a.smownerid\r\n\t\t\t\t\t\t) a\r\n\t\t\t\t\t\tLEFT JOIN ld_users b ON a.smownerid=b.id\r\n\t\t\t\t\t\tORDER BY CONVERT(b.last_name USING GBK) LIMIT 1\r\n\t\t\t\t\t)\r\n\t\t\t\tELSE a.smownerid='{smowner}'\r\n\t\t\tEND)\r\n) a\r\nCROSS JOIN (\r\n\tSELECT\r\n\t\tCOUNT(b.contactrecordid) AS total\r\n\tFROM ld_contactrecords a \r\n\tLEFT JOIN ld_contactrecordscf b ON b.contactrecordid=a.contactrecordID \r\n\tWHERE a.deleted=0 \r\n\t\tAND a.approvestatus<>'已拒绝'\r\n\t\tAND a.contactdate BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\t\tAND a.follow_type IN ('主动开发型','被动开发型','主动事务型','被动事务型')\r\n\t\tAND (\r\n\t\t\tCASE\r\n\t\t\t\tWHEN '{smowner}'='' THEN\r\n\t\t\t\t\ta.smownerid=(\r\n\t\t\t\t\t\tSELECT\r\n\t\t\t\t\t\t\ta.smownerid\r\n\t\t\t\t\t\tFROM (\r\n\t\t\t\t\t\t\tSELECT\r\n\t\t\t\t\t\t\t\ta.smownerid\r\n\t\t\t\t\t\t\tFROM ld_contactrecords a\r\n\t\t\t\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\t\t\t\tGROUP BY a.smownerid\r\n\t\t\t\t\t\t) a\r\n\t\t\t\t\t\tLEFT JOIN ld_users b ON a.smownerid=b.id\r\n\t\t\t\t\t\tORDER BY CONVERT(b.last_name USING GBK) LIMIT 1\r\n\t\t\t\t\t)\r\n\t\t\t\tELSE a.smownerid='{smowner}'\r\n\t\t\tEND)\r\n) b\r\nORDER BY FIELD(argument,'主动开发型','被动开发型','被动事务型','主动事务型')"
      },
      "3": {
        "Ident": "StiMySqlSource",
        "Name": "t1",
        "Alias": "t1",
        "Columns": {
          "0": {
