        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\t'主动开发型' AS argument,\r\n\ta.contactrecord_no AS coninfo,\r\n\tc.accountname,\r\n\ta.content\r\nFROM ld_contactrecords a \r\nLEFT JOIN ld_contactrecordscf b ON b.contactrecordid=a.contactrecordID\r\nLEFT JOIN ld_account c ON c.accountid=a.accountid\r\nWHERE a.deleted=0 \r\n\tAND a.approvestatus<>'已拒绝'\r\n\tAND a.contactdate BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\tAND a.follow_type='主动开发型'\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{smowner}'='' THEN\r\n\t\t\t\ta.smownerid=(\r\n\t\t\t\t\tSELECT\r\n\t\t\t\t\t\ta.smownerid\r\n\t\t\t\t\tFROM (\r\n\t\t\t\t\t\tSELECT\r\n\t\t\t\t\t\t\ta.smownerid\r\n\t\t\t\t\t\tFROM ld_contactrecords a\r\n\t\t\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\t\t\tGROUP BY a.smownerid\r\n\t\t\t\t\t) a\r\n\t\t\t\t\tLEFT JOIN ld_users b ON a.smownerid=b.id\r\n\t\t\t\t\tORDER BY CONVERT(b.last_name USING GBK) LIMIT 1\r\n\t\t\t\t)\r\n\t\t\tELSE a.smownerid='{smowner}'\r\n\t\tEND)\r\nUNION ALL\r\nSELECT\r\n\t'被动开发型' AS argument,\r\n\ta.contactrecord_no AS coninfo,\r\n\tc.accountname,\r\n\ta.content\r\nFROM ld_contactrecords a \r\nLEFT JOIN ld_contactrecordscf b ON b.contactrecordid=a.contactrecordID\r\nLEFT JOIN ld_account c ON c.accountid=a.accountid\r\nWHERE a.deleted=0 \r\n\tAND a.approvestatus<>'已拒绝'\r\n\tAND a.contactdate BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\tAND a.follow_type='被动开发型'\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{smowner}'='' THEN\r\n\t\t\t\ta.smownerid=(\r\n\t\t\t\t\tSELECT\r\n\t\t\t\t\t\ta.smownerid\r\n\t\t\t\t\tFROM (\r\n\t\t\t\t\t\tSELECT\r\n\t\t\t\t\t\t\ta.smownerid\r\n\t\t\t\t\t\tFROM ld_contactrecords a\r\n\t\t\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\t\t\tGROUP BY a.smownerid\r\n\t\t\t\t\t) a\r\n\t\t\t\t\tLEFT JOIN ld_users b ON a.smownerid=b.id\r\n\t\t\t\t\tORDER BY CONVERT(b.last_name USING GBK) LIMIT 1\r\n\t\t\t\t)\r\n\t\t\tELSE a.smownerid='{smowner}'\r\n\t\tEND)\r\nUNION ALL\r\nSELECT\r\n\t'主动事务型' AS argument,\r\n\ta.contactrecord_no AS coninfo,\r\n\tc.accountname,\r\n\ta.content\r\nFROM ld_contactrecords a \r\nLEFT JOIN ld_contactrecordscf b ON b.contactrecordid=a.contactrecordID\r\nLEFT JOIN ld_account c ON c.accountid=a.accountid\r\nWHERE a.deleted=0 \r\n\tAND a.approvestatus<>'已拒绝'\r\n\tAND a.contactdate BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\tAND a.follow_type='主动事务型'\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{smowner}'='' THEN\r\n\t\t\t\ta.smownerid=(\r\n\t\t\t\t\tSELECT\r\n\t\t\t\t\t\ta.smownerid\r\n\t\t\t\t\tFROM (\r\n\t\t\t\t\t\tSELECT\r\n\t\t\t\t\t\t\ta.smownerid\r\n\t\t\t\t\t\tFROM ld_contactrecords a\r\n\t\t\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\t\t\tGROUP BY a.smownerid\r\n\t\t\t\t\t) a\r\n\t\t\t\t\tLEFT JOIN ld_users b ON a.smownerid=b.id\r\n\t\t\t\t\tORDER BY CONVERT(b.last_name USING GBK) LIMIT 1\r\n\t\t\t\t)\r\n\t\t\tELSE a.smownerid='{smowner}'\r\n\t\tEND)\r\nUNION ALL\r\nSELECT\r\n\t'被动事务型' AS argument,\r\n\ta.contactrecord_no AS coninfo,\r\n\tc.accountname,\r\n\ta.content\r\nFROM ld_contactrecords a \r\nLEFT JOIN ld_contactrecordscf b ON b.contactrecordid=a.contactrecordID\r\nLEFT JOIN ld_account c ON c.accountid=a.accountid\r\nWHERE a.deleted=0 \r\n\tAND a.approvestatus<>'已拒绝'\r\n\tAND a.contactdate BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\tAND a.follow_type='被动事务型'\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN '{smowner}'='' THEN\r\n\t\t\t\ta.smownerid=(\r\n\t\t\t\t\tSELECT\r\n\t\t\t\t\t\ta.smownerid\r\n\t\t\t\t\tFROM (\r\n\t\t\t\t\t\tSELECT\r\n\t\t\t\t\t\t\ta.smownerid\r\n\t\t\t\t\t\tFROM ld_contactrecords a\r\n\t\t\t\t\t\tWHERE a.deleted=0\r\n\t\t\t\t\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\t\t\t\tGROUP BY a.smownerid\r\n\t\t\t\t\t) a\r\n\t\t\t\t\tLEFT JOIN ld_users b ON a.smownerid=b.id\r\n\t\t\t\t\tORDER BY CONVERT(b.last_name USING GBK) LIMIT 1\r\n\t\t\t\t)\r\n\t\t\tELSE a.smownerid='{smowner}'\r\n\t\tEND)"
      }
