          "13": {
            "Name": "smownerid",
            "Index": -1,
            "NameInSource": "smownerid",
            "Alias": "smownerid",
            "Type": "System.Int32"
          },
          "14": {
            "Name": "total_order",
            "Index": -1,
            "NameInSource": "total_order",
            "Alias": "total_order",
            "Type": "System.Decimal"
          },
          "15": {
            "Name": "unreceived_amount",
            "Index": -1,
            "NameInSource": "unreceived_amount",
            "Alias": "unreceived_amount",
            "Type": "System.Decimal"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT\r\n\ta.smownerid,\r\n\tk.accountid,\r\n\ta.salesorderid,\r\n\ta.salesorder_no,\r\n\tu.last_name,\r\n\tk.accountname,\r\n\ta.signed_data,\r\n\r\n\tROUND(a.total/IFNULL(a.conversion_rate,1),2) AS total_order,\r\n\tROUND(c.out_total/IFNULL(a.conversion_rate,1),2) AS out_total,\r\n\tROUND(a.have_invoicetotal/IFNULL(a.conversion_rate,1),2) AS have_invoicetotal,\r\n\tROUND(a.nothave_invoicetotal/IFNULL(a.conversion_rate,1),2) AS nothave_invoicetotal,\r\n\r\n\td.received_amount,\r\n\tROUND(a.total/IFNULL(a.conversion_rate,1),2)-d.received_amount AS unreceived_amount,\r\n\t\r\n\td.fapiaoyingshou_30,\r\n\td.fapiaoyingshou_60,\r\n\td.fapiaoyingshou_90\r\nFROM ld_salesorder a\r\nLEFT JOIN ld_account k ON k.accountid=a.accountid\r\nLEFT JOIN ld_users u ON u.id=a.smownerid\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\tid,\r\n\t\tROUND(SUM(taxprice*haveoutproductcount),2) AS out_total\r\n\tFROM ld_salesorderdetail \r\n\tWHERE id>0\r\n\tGROUP BY id\r\n) c ON c.id=a.salesorderid\r\nLEFT JOIN (\r\n\tSELECT\r\n\t\tentitytypeid,\r\n\t\tSUM(fapiaoyingshou_30) AS fapiaoyingshou_30,\r\n\t\tSUM(fapiaoyingshou_60) AS fapiaoyingshou_60,\r\n\t\tSUM(fapiaoyingshou_90) AS fapiaoyingshou_90,\r\n\t\tSUM(received_amount) AS received_amount\r\n\tFROM (\r\n\t\tSELECT\r\n\t\t\tMIN(b.entitytypeid) AS entitytypeid,\r\n\t\t\tROUND(a.received_amount/IFNULL(a.conversion_rate,1),2)  AS received_amount,\r\n\t\t\tCASE\r\n\t\t\t\tWHEN DATEDIFF(NOW(),DATE_ADD(a.invoicedate,INTERVAL c.cf_3478 DAY))>30 AND DATEDIFF(NOW(),DATE_ADD(a.invoicedate,INTERVAL c.cf_3478 DAY))<=60 THEN\r\n\t\t\t\t\tROUND(a.receivable_balance/IFNULL(a.conversion_rate,1),2)\r\n\t\t\t\tELSE 0\r\n\t\t\tEND AS fapiaoyingshou_30,\r\n\t\t\tCASE\r\n\t\t\t\tWHEN DATEDIFF(NOW(),DATE_ADD(a.invoicedate,INTERVAL c.cf_3478 DAY))>60 AND DATEDIFF(NOW(),DATE_ADD(a.invoicedate,INTERVAL c.cf_3478 DAY))<=90 THEN\r\n\t\t\t\t\tROUND(a.receivable_balance/IFNULL(a.conversion_rate,1),2)\r\n\t\t\t\tELSE 0\r\n\t\t\tEND AS fapiaoyingshou_60,\r\n\t\t\tCASE\r\n\t\t\t\tWHEN DATEDIFF(NOW(),DATE_ADD(a.invoicedate,INTERVAL c.cf_3478 DAY))>90 THEN\r\n\t\t\t\t\tROUND(a.receivable_balance/IFNULL(a.conversion_rate,1),2)\r\n\t\t\t\tELSE 0\r\n\t\t\tEND AS fapiaoyingshou_90\r\n\t\tFROM ld_invoice a\r\n\t\tLEFT JOIN ld_invoicecf c ON c.invoiceid=a.invoiceid\r\n\t\tLEFT JOIN ld_invoicedetail b ON b.id=a.invoiceid\r\n\t\tLEFT JOIN ld_salesorder s ON s.salesorderid=b.entitytypeid\r\n\t\tWHERE a.deleted=0\r\n\t\t\tAND a.approvestatus<>'已拒绝'\r\n\t\t\tAND b.entitytypeid>0\r\n\t\t\tAND s.deleted=0\r\n\t\t\tAND s.approvestatus<>'已拒绝'\r\n\t\t\tAND s.signed_data BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\t\tGROUP BY a.invoiceid,b.entitytypeid\r\n\t) t\r\n) d ON d.entitytypeid=a.salesorderid\r\nINNER JOIN (\r\n\tSELECT DISTINCT\r\n\t\tuserid \r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\tld_users.id AS userid \r\n\t\tFROM ld_users\r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='SalesOrder' and scopeauthority=1 AND userid='[uuid]')\r\n\t\tUNION\r\n\t\tSELECT \r\n\t\t\tviewid AS userid \r\n\t\tFROM ld_scoperhigher\r\n\t\tWHERE userid='[uuid]' AND modulename ='SalesOrder' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename ='SalesOrder')\t\t\t\r\n\t\tUNION\r\n\t\tSELECT DISTINCT \r\n\t\t\tld_users2group.userid AS userid \r\n\t\tFROM ld_scoperhigher \r\n\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\tAND ld_scoperhigher.modulename ='SalesOrder'\r\n\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='SalesOrder' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\tUNION \r\n\t\tSELECT \r\n\t\t\tid AS userid \r\n\t\tFROM ld_users  \r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\tUNION\r\n\t\tSELECT '[uuid]') AS vw_users\r\n) AS tmp_users ON tmp_users.userid=a.smownerid\r\nWHERE a.deleted=0\r\n\tAND a.approvestatus<>'已拒绝'\r\n\tAND a.signed_data BETWEEN DATE_FORMAT('{start_date}','%Y-%m-%d') AND DATE_FORMAT('{end_date}','%Y-%m-%d')\r\n\tAND (\r\n\t\tCASE\r\n\t\t\tWHEN TRIM('{custname}')='' THEN 1=1\r\n\t\t\tELSE LOCATE(TRIM('{custname}'),k.accountname)>0\r\n\t\tEND) \r\n\tAND(\r\n\t\tCASE\r\n\t\t\tWHEN FIND_IN_SET(1,'{data_range}') OR '{data_range}'='' THEN 1=1\r\n\t\t\tWHEN FIND_IN_SET(2,'{data_range}') THEN a.smownerid='[uuid]'\r\n\t\t\tELSE \r\n\t\t\t\t\t\ta.smownerid IN (\r\n\t\t\t\t\t\t\t\tSELECT\r\n\t\t\t\t\t\t\t\t\ta.userid\r\n\t\t\t\t\t\t\t\tFROM ld_users2group a\r\n\t\t\t\t\t\t\t\tINNER JOIN (\r\n\t\t\t\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\t\t\t\tsubstring_index(substring_index(a.splitsting,',',b.seq+1),',',-1)-200000 AS groupid\r\n\t\t\t\t\t\t\t\t\tFROM (SELECT '{data_range}' AS splitsting) a \r\n\t\t\t\t\t\t\t\t\tLEFT JOIN sequence b ON b.seq < (length(a.splitsting) - length(replace(a.splitsting,',',''))+1) \r\n\t\t\t\t\t\t\t\t\tWHERE substring_index(substring_index(a.splitsting,',',b.seq+1),',',-1) BETWEEN 200000 AND 300000\r\n\t\t\t\t\t\t\t\t) b ON b.groupid=a.groupid\r\n\t\t\t\t\t\t\t\tGROUP BY a.userid\r\n\t\t\t\t\t\t\t\tUNION \r\n\t\t\t\t\t\t\t\tSELECT \r\n\t\t\t\t\t\t\t\t\tsubstring_index(substring_index(a.splitsting,',',b.seq+1),',',-1)-300000 AS groupid\r\n\t\t\t\t\t\t\t\tFROM (SELECT '{data_range}' AS splitsting) a \r\n\t\t\t\t\t\t\t\tLEFT JOIN sequence b ON b.seq < (length(a.splitsting) - length(replace(a.splitsting,',',''))+1) \r\n\t\t\t\t\t\t\t\tWHERE substring_index(substring_index(a.splitsting,',',b.seq+1),',',-1)>300000\r\n\t\t\t\t\t\t)\r\n\t\tEND)\r\nORDER BY CONVERT(u.last_name USING GBK)"
      },
      "1": {
        "Ident": "StiMySqlSource",
        "Name": "list_users",
        "Alias": "list_users",
        "Columns": {
          "0": {
            "Name": "listid",
            "Index": -1,
            "NameInSource": "listid",
            "Alias": "listid",
            "Type": "System.Int32"
          },
          "1": {
            "Name": "listvalue",
            "Index": -1,
            "NameInSource": "listvalue",
            "Alias": "listvalue",
            "Type": "System.String"
          }
        },
        "NameInSource": "crm",
        "SqlCommand": "SELECT 1 AS listid,'全部' AS listvalue\r\nUNION\r\nSELECT 2, '我负责的'\r\nUNION\r\n(SELECT\r\n\ta.groupid+200000,\r\n\tCONCAT('部门::',IFNULL(a.groupname,''))\r\nFROM (\r\n\tSELECT \r\n\t\ta.groupid, \r\n\t\ta.groupname, \r\n\t\tLPAD(substring_index(substring_index(a.splitsting,',',b.seq+1),',',-1),8,'0') AS splitsting\r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\ta.groupid,\r\n\t\t\ta.groupname, \r\n\t\t\tREPLACE(a.parentgroup,'::',',') AS splitsting \r\n\t\tFROM ld_groups a\r\n\t\tLEFT JOIN ld_users2group b ON b.groupid=a.groupid\r\n\t\tGROUP BY a.groupid\r\n\t) a \r\n\tLEFT JOIN sequence b ON b.seq < (length(a.splitsting) - length(replace(a.splitsting,',',''))+1)\r\n) a\r\nGROUP BY a.groupid\r\nORDER BY GROUP_CONCAT(IFNULL(a.splitsting,'') ORDER BY a.splitsting SEPARATOR '::'))\r\nUNION \r\n(SELECT\r\n\ta.id+300000,\r\n\tCONCAT('用户::',IFNULL(a.last_name,''))\r\nFROM ld_users a\r\nINNER JOIN (\r\n\tSELECT DISTINCT\r\n\t\tuserid \r\n\tFROM (\r\n\t\tSELECT \r\n\t\t\tld_users.id AS userid \r\n\t\tFROM ld_users\r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Accounts' and scopeauthority=1 AND userid='[uuid]')\r\n\t\tUNION\r\n\t\tSELECT \r\n\t\t\tviewid AS userid \r\n\t\tFROM ld_scoperhigher\r\n\t\tWHERE userid='[uuid]' AND modulename ='Accounts' AND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE userid='[uuid]' AND scopeauthority=2 AND modulename ='Accounts')\t\t\t\r\n\t\tUNION\r\n\t\tSELECT DISTINCT \r\n\t\t\tld_users2group.userid AS userid \r\n\t\tFROM ld_scoperhigher \r\n\t\tINNER JOIN ld_groups ON ld_groups.groupid=ld_scoperhigher.viewid\r\n\t\tINNER JOIN ld_users2group ON ld_users2group.groupid=ld_groups.groupid\r\n\t\tWHERE ld_scoperhigher.userid='[uuid]' \r\n\t\t\tAND ld_scoperhigher.modulename ='Accounts'\r\n\t\t\tAND ld_scoperhigher.scopeauthority=3 \r\n\t\t\tAND EXISTS(SELECT 1 FROM ld_setscoperhigher WHERE modulename ='Accounts' AND scopeauthority=3 AND userid='[uuid]')\r\n\t\tUNION \r\n\t\tSELECT \r\n\t\t\tid AS userid \r\n\t\tFROM ld_users  \r\n\t\tWHERE EXISTS(SELECT 1 FROM ld_users WHERE id='[uuid]' AND is_admin='on')\r\n\t\tUNION\r\n\t\tSELECT '[uuid]') AS vw_users\r\n) AS tmp_users ON tmp_users.userid=a.id\r\nWHERE a.deleted=0\r\n\tAND a.`status`='Active'\r\nORDER BY CONVERT(a.last_name USING gbk))"
      }
    },
